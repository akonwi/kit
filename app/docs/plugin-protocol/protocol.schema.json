				{
					"if": {
						"properties": {
							"method": {
								"enum": [
									"kit/commands/unregister",
									"kit/header/clear",
									"kit/header/click",
									"kit/footer/clear",
									"kit/footer/click",
									"kit/subagents/unregister"
								]
							}
						}
					},
					"then": {
						"required": ["params"],
						"properties": {
							"params": {
								"$ref": "#/$defs/LocalIdParams"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"method": {
								"const": "kit/commands/execute"
							}
						}
					},
					"then": {
						"required": ["params"],
						"properties": {
							"params": {
								"$ref": "#/$defs/CommandExecuteParams"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"method": {
								"const": "kit/tools/register"
							}
						}
					},
					"then": {
						"required": ["params"],
						"properties": {
							"params": {
								"$ref": "#/$defs/ToolRegisterParams"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"method": {
								"const": "kit/tools/unregister"
							}
						}
					},
					"then": {
						"required": ["params"],
						"properties": {
							"params": {
								"$ref": "#/$defs/ToolLocalIdParams"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"method": {
								"const": "kit/tools/execute"
							}
						}
					},
					"then": {
						"required": ["params"],
						"properties": {
							"params": {
								"$ref": "#/$defs/ToolExecuteParams"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"method": {
								"const": "kit/tool-calls/before-execute"
							}
						}
					},
					"then": {
						"required": ["params"],
						"properties": {
							"params": {
								"$ref": "#/$defs/BeforeExecuteParams"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"method": {
								"const": "kit/ui/confirm"
							}
						}
					},
					"then": {
						"required": ["params"],
						"properties": {
							"params": {
								"$ref": "#/$defs/ConfirmParams"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"method": {
								"const": "kit/ui/input"
							}
						}
					},
					"then": {
						"required": ["params"],
						"properties": {
							"params": {
								"$ref": "#/$defs/InputParams"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"method": {
								"const": "kit/ui/select"
							}
						}
					},
					"then": {
						"required": ["params"],
						"properties": {
							"params": {
								"$ref": "#/$defs/SelectParams"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"method": {
								"enum": ["kit/header/set", "kit/footer/set"]
							}
						}
					},
					"then": {
						"required": ["params"],
