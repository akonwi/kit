				},
				{
					"if": {
						"properties": {
							"method": {
								"const": "kit/subagents/register"
							}
						}
					},
					"then": {
						"required": ["params"],
						"properties": {
							"params": {
								"$ref": "#/$defs/SubagentRegisterParams"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"method": {
								"const": "kit/system-prompt/set"
