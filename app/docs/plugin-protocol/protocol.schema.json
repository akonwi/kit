		"KnownRequest": {
			"type": "object",
			"required": ["jsonrpc", "id", "method"],
			"properties": {
				"jsonrpc": {
					"const": "2.0"
				},
				"id": {
					"$ref": "#/$defs/RequestId"
				},
				"method": {
					"$ref": "#/$defs/RequestMethodName"
				},
				"params": {
					"$ref": "#/$defs/JsonRpcParams"
				}
			},
			"additionalProperties": false,
			"allOf": [
				{
					"if": {
						"properties": {
							"method": {
								"const": "initialize"
							}
						}
					},
					"then": {
						"required": ["params"],
						"properties": {
							"params": {
								"$ref": "#/$defs/InitializeParams"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"method": {
								"enum": [
									"shutdown",
									"kit/tool-calls/register-interceptor",
									"kit/tool-calls/unregister-interceptor",
									"kit/system-prompt/clear"
								]
							}
						}
					},
					"then": {
						"properties": {
							"params": false
						}
					}
				},
				{
					"if": {
						"properties": {
							"method": {
								"const": "kit/commands/register"
							}
						}
					},
					"then": {
						"required": ["params"],
						"properties": {
							"params": {
								"$ref": "#/$defs/CommandRegisterParams"
							}
