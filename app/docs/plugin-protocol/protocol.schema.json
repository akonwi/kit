		"UnknownRequest": {
			"type": "object",
			"required": ["jsonrpc", "id", "method"],
			"properties": {
				"jsonrpc": {
					"const": "2.0"
				},
				"id": {
					"$ref": "#/$defs/RequestId"
				},
				"method": {
					"type": "string",
					"not": {
						"$ref": "#/$defs/KnownMethodName"
					}
				},
				"params": {
					"$ref": "#/$defs/JsonRpcParams"
				}
			},
			"additionalProperties": false
		},
		"UnknownNotification": {
			"type": "object",
			"required": ["jsonrpc", "method"],
			"properties": {
				"jsonrpc": {
					"const": "2.0"
				},
				"method": {
					"type": "string",
					"not": {
						"$ref": "#/$defs/KnownMethodName"
					}
				},
				"params": {
					"$ref": "#/$defs/JsonRpcParams"
				}
			},
			"additionalProperties": false
		},
		"SuccessResponse": {
			"type": "object",
			"required": ["jsonrpc", "id", "result"],
			"properties": {
				"jsonrpc": {
					"const": "2.0"
				},
				"id": {
					"$ref": "#/$defs/RequestId"
				},
				"result": {
					"$ref": "#/$defs/JsonValue"
				}
			},
			"additionalProperties": false
		},
		"ErrorObject": {
			"type": "object",
			"required": ["code", "message"],
			"properties": {
				"code": {
					"type": "integer"
				},
				"message": {
					"type": "string"
				},
				"data": {
					"$ref": "#/$defs/JsonValue"
				}
			},
			"additionalProperties": false
		},
		"ErrorResponse": {
			"type": "object",
			"required": ["jsonrpc", "id", "error"],
			"properties": {
				"jsonrpc": {
					"const": "2.0"
				},
				"id": {
					"$ref": "#/$defs/ResponseId"
				},
				"error": {
					"$ref": "#/$defs/ErrorObject"
				}
			},
			"additionalProperties": false
		},
		"SingleMessage": {
			"oneOf": [
				{
					"$ref": "#/$defs/KnownRequest"
				},
				{
					"$ref": "#/$defs/KnownNotification"
				},
				{
					"$ref": "#/$defs/UnknownRequest"
				},
				{
					"$ref": "#/$defs/UnknownNotification"
				},
				{
					"$ref": "#/$defs/SuccessResponse"
				},
				{
					"$ref": "#/$defs/ErrorResponse"
				}
			]
		},
		"BatchMessage": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/SingleMessage"
			}
		}
	}
