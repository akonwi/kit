{
	"name": "@akonwi/kit",
	"version": "0.29.0",
	"author": "Akonwi Ngoh <akonwi@gmail.com>",
	"description": "A TUI coding agent",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/akonwi/kit.git"
	},
	"homepage": "https://akonwi.io/kit",
	"bugs": {
		"url": "https://github.com/akonwi/kit/issues"
	},
	"bin": {
		"kit": "dist/kit"
	},
	"files": [
		"dist/",
		"docs/features/plugins.md",
		"docs/plugin-protocol/",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "biome check --write .",
		"lint:staged": "biome check --write --staged --unsafe .",
		"dev": "bun --preload=@opentui/solid/preload src/app/main.tsx",
		"start": "bun --preload=@opentui/solid/preload src/app/main.tsx",
		"build": "bun run script/build.ts",
		"smoke:print-mode": "bun run script/smoke-print-mode.ts",
		"pack:dry": "npm pack --dry-run",
		"prepack": "bun run build",
		"prepublishOnly": "bun run typecheck && bun test",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@akonwi/mica": "0.8.0",
		"@earendil-works/pi-agent-core": "0.83.0",
		"@earendil-works/pi-ai": "0.83.0",
		"@fontsource-variable/inter": "5.3.0",
		"@mermanjs/web": "0.8.0-alpha.3",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@opentui/core": "0.5.1",
		"@opentui/keymap": "0.5.1",
		"@opentui/solid": "0.5.1",
		"@pierre/diffs": "^1.1.16",
		"@resvg/resvg-wasm": "2.6.2",
		"diff": "^9.0.0",
		"dompurify": "^3.4.13",
		"glob": "^13.0.6",
		"ignore": "^7.0.5",
		"marked": "17.0.1",
		"proper-lockfile": "^4.1.2",
		"solid-js": "1.9.12",
		"typebox": "1.3.7",
		"web-tree-sitter": "0.25.10",
		"yaml": "^2.8.3"
	},
	"devDependencies": {
		"@babel/core": "7.28.0",
		"@babel/preset-typescript": "7.27.1",
		"@biomejs/biome": "2.3.14",
		"@types/babel__core": "7.20.5",
		"@types/bun": "latest",
		"@types/diff": "^8.0.0",
		"@types/proper-lockfile": "^4.1.4",
		"babel-preset-solid": "1.9.12",
		"typescript": "^5.9.0"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
