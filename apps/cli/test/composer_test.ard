  try testing::assert(
    rows(terminal).at(3).or("") == "│ Bash                          Not in context │",
    "got {rows(terminal).at(3).or("")}",
  )
  terminal.click(40, 3)
  terminal.flush()
  try testing::assert(
    rows(terminal).at(3).or("") == "│ Bash                              In context │",
    "got {rows(terminal).at(3).or("")}",
  )
  // The field keeps focus.
  terminal.key(character(" -P"))
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(value.submitted == "!pwd -P", "got {value.submitted}")
}

fn commands() [composer::HistoryEntry] {
  [
    composer::HistoryEntry{id: "bash_3", text: "!git status"},
    composer::HistoryEntry{id: "bash_2", text: "!!make test"},
    composer::HistoryEntry{id: "bash_1", text: "!ls"},
  ]
}

fn page(entries: [composer::HistoryEntry], more: Bool, before: Int) composer::BashPage? {
  Maybe::new(
    composer::BashPage{
      entries: entries,
      more: more,
      before: Int64::from(before),
    },
  )
}

test fn up_and_down_in_bash_mode_ask_for_earlier_commands() Void!Str {
  let terminal = headless::new(56, 10)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("!"))
  terminal.flush()
  terminal.key(key("up"))
  terminal.flush()
  terminal.key(key("down"))
  terminal.flush()
  try testing::assert(value.bash_recalls == 2 and value.recalls == 0, "both keys recall commands")

  let context = value.context.expect("mounted host")
  let _ = context.dispatch(fn() {
    value.follow_ups = 1
  })
  terminal.flush()
  terminal.key(key("up"))
  terminal.key(key("down"))
  terminal.flush()
  testing::assert(
    value.restores == 1 and value.bash_recalls == 3,
    "queued follow-ups keep Up; Down still recalls commands",
  )
}

test fn command_history_rests_above_the_caret_and_filters_by_command() Void!Str {
  let terminal = headless::new(56, 10)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("!"))
  terminal.flush()
  let _ = value.control.open_bash_history(commands())
  terminal.flush()
  // The list sits on the row above the caret's line, from the caret's
  // column, over the panel's header. Rows keep their `!` or `!!`.
  try expect_rows(
    rows(terminal),
    [
      "",
      "",
      "  ┌──────────────────────────────────────────────┐",
      "  │ !ls                                          │",
      "┌─│ !!make test                                  │─────┐",
      "│ │▌!git status                                  │text │",
      "├─└──────────────────────────────────────────────┘─────┤",
      "│ Run a command…                                       │",
      "└──────────────────────────────────────────────────────┘",
      "",
    ],
  )
  // The command after `!` is the query, and the list follows the caret.
  terminal.key(character("ma"))
  terminal.flush()
  try expect_rows(
    rows(terminal),
    [
      "",
      "",
      "",
      "",
      "┌───┌──────────────────────────────────────────────┐───┐",
      "│ Ba│▌!!make test                                  │xt │",
      "├───└──────────────────────────────────────────────┘───┤",
      "│ ma                                                   │",
      "└──────────────────────────────────────────────────────┘",
      "",
    ],
  )
  // Choosing a command sets its mode.
  terminal.key(key("return"))
  terminal.flush()
  try testing::assert(
    rows(terminal).at(5).or("") == "│ Bash                                  Not in context │" and rows(terminal).at(7).or("") == "│ make test                                            │",
    "got {rows(terminal).at(5).or("")} / {rows(terminal).at(7).or("")}",
  )
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(value.submitted == "!!make test", "the command keeps its mode: {value.submitted}")
}

test fn the_sessions_commands_replace_the_known_ones_as_they_load() Void!Str {
  let terminal = headless::new(56, 10)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("!zz"))
  terminal.flush()
  let _ = value.control.open_bash_history(commands())
  terminal.flush()
  try testing::assert(
    rows(terminal).at(5).or("") == "│ Ba│ Loading history…                             │xt │",
    "nothing known matches while history loads",
  )
  let _ = value.control.answer_bash_history(
    page([composer::HistoryEntry{id: "bash_9", text: "!zz top"}], false, 0),
    false,
  )
  terminal.flush()
  try testing::assert(
    rows(terminal).at(5).or("") == "│ Ba│▌!zz top                                      │xt │",
    "got {rows(terminal).at(5).or("")}",
  )
  // Leaving the Bash panel closes the picker.
  terminal.key(key("backspace"))
  terminal.key(key("backspace"))
  terminal.key(key("backspace"))
  terminal.flush()
  expect_rows(rows(terminal), ["", "", "", "", "", "", "", "", " Ask kit to do something…", ""])
}

test fn moving_up_past_the_oldest_command_reads_older_pages() Void!Str {
  let terminal = headless::new(56, 12)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("!"))
  terminal.flush()
  let _ = value.control.open_bash_history([])
  terminal.flush()
  let _ = value.control.answer_bash_history(page(commands(), true, 40), false)
  terminal.flush()
  terminal.key(key("up"))
  terminal.key(key("up"))
  terminal.flush()
  try testing::assert(value.older.size() == 0, "the newest commands come first")
  terminal.key(key("up"))
  terminal.key(key("up"))
  terminal.flush()
  try testing::assert(
    value.older.size() == 1 and value.older.at(0).or(Int64::from(0)) == Int64::from(40),
    "one read of the page before the cursor: {value.older.size()}",
  )
  let _ = value.control.answer_bash_history(
    page([composer::HistoryEntry{id: "bash_0", text: "!pwd"}], false, 0),
    true,
  )
  terminal.flush()
  try testing::assert(
    rows(terminal).at(4).or("") == "  │ !pwd                                         │" and rows(terminal).at(5).or("") == "  │▌!ls                                          │",
    "the older page goes above the selection, which stays",
  )
  // With no older page left, Up wraps.
  terminal.key(key("up"))
  terminal.key(key("up"))
  terminal.flush()
  testing::assert(
    value.older.size() == 1 and rows(terminal).at(7).or("") == "│ │▌!git status                                  │text │",
    "got {rows(terminal).at(7).or("")}",
  )
}

test fn a_failed_older_page_ends_paging() Void!Str {
  let terminal = headless::new(56, 12)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("!"))
  terminal.flush()
  let _ = value.control.open_bash_history([])
  let _ = value.control.answer_bash_history(page(commands(), true, 40), false)
  terminal.flush()
  terminal.key(key("down"))
  terminal.flush()
  terminal.key(key("up"))
  terminal.flush()
  try testing::assert(value.older.size() == 1, "the oldest asks for more")
  let _ = value.control.answer_bash_history(Maybe::new<composer::BashPage>(), true)
  terminal.flush()
  terminal.key(key("up"))
  terminal.flush()
  testing::assert(
    value.older.size() == 1 and rows(terminal).at(7).or("") == "│ │▌!git status                                  │text │",
    "Up wraps instead: {rows(terminal).at(7).or("")}",
  )
}

// Types text one key at a time, as a person does.
fn type_text(terminal: headless::TestApp, text: Str) {
  for letter in strings::Split(text, "") {
    terminal.key(character(letter))
  }
  terminal.flush()
}

fn indexed(paths: [Str]) file_index::Index {
  file_index::Index{
    paths: paths,
    loading: false,
    failure: "",
    truncated: false,
    generation: 1,
  }
}

fn set_files(value: mut Model, files: file_index::Index) {
  let context = value.context.expect("mounted host")
  let _ = context.dispatch(fn() {
    value.files = files
  })
}

fn project() [Str] {
  ["docs/", "internal/tui/app.go", "internal/tui/shell.go", "go.mod"]
}

test fn typing_at_after_a_space_asks_for_files_and_lists_them_above_it() Void!Str {
  let terminal = headless::new(56, 9)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  type_text(terminal, "mail@")
  try testing::assert(value.file_loads == 0, "an @ inside a word is text")
  type_text(terminal, " see @")
  try testing::assert(value.file_loads == 1, "the mention asks for the index")
  try expect_rows(
    rows(terminal),
    [
      "",
      "",
      "",
      "",
      "        ┌──────────────────────────────────────────────┐",
      "        │ Loading files…                               │",
      "        └──────────────────────────────────────────────┘",
      " mail@ see @",
      "",
    ],
  )
  set_files(value, indexed(project()))
  terminal.flush()
  // The picker rests on the line above the @, moved left only as far as the
  // terminal requires, with the first path selected.
  expect_rows(
    rows(terminal),
    [
      "",
      "        ┌──────────────────────────────────────────────┐",
      "        │▌docs/                                        │",
      "        │ internal/tui/app.go                          │",
      "        │ internal/tui/shell.go                        │",
      "        │ go.mod                                       │",
      "        └──────────────────────────────────────────────┘",
      " mail@ see @",
      "",
    ],
  )
}

test fn the_query_ranks_paths_and_enter_mentions_the_selection_at_the_caret() Void!Str {
  let terminal = headless::new(56, 9)
  defer terminal.destroy()
  let value = model()
  value.files = indexed(project())
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  // The mention is typed before existing text.
  type_text(terminal, "x")
  terminal.key(chord("a", false, true))
  type_text(terminal, "@tui")
  try expect_rows(
    rows(terminal),
    [
      "",
      "",
      "",
      " ┌──────────────────────────────────────────────┐",
      " │▌internal/tui/app.go                          │",
      " │ internal/tui/shell.go                        │",
      " └──────────────────────────────────────────────┘",
      " @tuix",
      "",
    ],
  )
  // Moving wraps, so Up from the first selects the last.
  terminal.key(key("up"))
  terminal.key(key("return"))
  terminal.flush()
  try testing::assert(value.submissions == 0, "Enter mentions instead of sending")
  // The caret keeps following what is typed after the mention.
  type_text(terminal, "yz")
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(
    value.submitted == "@internal/tui/shell.go yzx",
    "the path replaces the query and the caret follows it: {value.submitted}",
  )
}

test fn escape_and_whitespace_close_a_mention_and_keep_the_text() Void!Str {
  let terminal = headless::new(56, 9)
  defer terminal.destroy()
  let value = model()
  value.files = indexed(project())
  let renderer = mount(terminal, value)
  defer renderer.destroy()
