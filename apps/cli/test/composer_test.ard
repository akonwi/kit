}

test fn the_index_reports_failures_and_partial_lists() Void!Str {
  let terminal = headless::new(56, 9)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  type_text(terminal, "@")
  set_files(
    value,
    file_index::Index{
      paths: [],
      loading: false,
      failure: "connection refused",
      truncated: false,
      generation: 0,
    },
  )
  terminal.flush()
  try testing::assert(
    rows(terminal).at(5).or("") == " │ Could not load files: connection refused     │",
    "an index that never loaded explains why",
  )
  set_files(
    value,
    file_index::Index{
      paths: ["internal/very/long/directory/structure/with/levels/tui/inline_picker.go", "go.mod"],
      loading: false,
      failure: "",
      truncated: true,
      generation: 2,
    },
  )
  terminal.flush()
  // A long path keeps its file name, and a partial index says so.
  expect_rows(
    rows(terminal),
    [
      "",
      " ┌──────────────────────────────────────────────┐",
      " │▌…/structure/with/levels/tui/inline_picker.go │",
      " │ go.mod                                       │",
      " ├──────────────────────────────────────────────┤",
      " │ Showing first 4,000 indexed paths            │",
      " └──────────────────────────────────────────────┘",
      " @",
      "",
    ],
  )
}

// Lists sessions as a finished load does, with the attached one excluded.
fn list_sessions(value: mut Model, listed: [protocol::SessionInfo]!Str) {
  let context = value.context.expect("mounted host")
  let _ = context.dispatch(fn() {
    value.sessions = session_mentions::finish(
      value.sessions,
      value.sessions.generation,
      listed,
      "attached",
    )
  })
}

fn other_sessions() [protocol::SessionInfo] {
  [
    protocol::SessionInfo{
      ID: "attached",
      Name: "This session",
      CWD: "/srv/kit",
    },
    protocol::SessionInfo{
      ID: "ses_release",
      Name: "Release notes",
      CWD: "/srv/kit",
    },
    protocol::SessionInfo{
      ID: "ses_flaky",
      Name: "",
      CWD: "/srv/api",
    },
  ]
}

test fn typing_hash_after_a_space_lists_the_other_sessions_above_it() Void!Str {
  let terminal = headless::new(72, 9)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  type_text(terminal, "issue#")
  try testing::assert(value.session_loads == 0, "a # inside a word is text")
  type_text(terminal, " see #")
  try testing::assert(value.session_loads == 1, "the mention asks for sessions")
  try expect_rows(
    rows(terminal),
    [
      "",
      "",
      "",
      "",
      "            ┌───────────────────────────────────────────────────────┐",
      "            │ Loading sessions…                                     │",
      "            └───────────────────────────────────────────────────────┘",
      " issue# see #",
      "",
    ],
  )
  list_sessions(value, Result::ok(other_sessions()))
  terminal.flush()
  // Each session shows its name, then its directory and age, with the first
  // selected.
  expect_rows(
    rows(terminal),
    [
      "",
      "",
      "",
      "            ┌───────────────────────────────────────────────────────┐",
      "            │▌Release notes    /srv/kit                     unknown │",
      "            │ Unnamed session  /srv/api                     unknown │",
      "            └───────────────────────────────────────────────────────┘",
      " issue# see #",
      "",
    ],
  )
}

test fn a_session_id_matches_and_enter_inserts_a_session_reference() Void!Str {
  let terminal = headless::new(72, 9)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  type_text(terminal, "compare #")
  list_sessions(value, Result::ok(other_sessions()))
  terminal.flush()
  type_text(terminal, "flaky")
  try testing::assert(
    rows(terminal).at(5).or("") == "         │▌Unnamed session  /srv/api                     unknown │",
    "the ID matches: {rows(terminal).at(5).or("")}",
  )
  terminal.key(key("return"))
  terminal.flush()
  try testing::assert(value.submissions == 0, "Enter mentions instead of sending")
  type_text(terminal, "now")
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(
    value.submitted == "compare #[session:ses_flaky] now",
    "the reference replaces the query and the caret follows it: {value.submitted}",
  )
}

test fn a_failed_session_load_is_shown_in_the_picker() Void!Str {
  let terminal = headless::new(72, 9)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  type_text(terminal, "#")
  list_sessions(value, Result::err("connection refused"))
  terminal.flush()
  try testing::assert(
    rows(terminal).at(5).or("") == " │ Could not load sessions: connection refused           │",
    rows(terminal).at(5).or(""),
  )
  // Escape closes it; a new mention lists sessions afresh.
  terminal.key(key("escape"))
  type_text(terminal, " #")
  testing::assert(value.session_loads == 2, "each mention lists sessions again")
}
