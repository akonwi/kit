  terminal.click(5, 4)
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(value.submitted == "explain the repo", "got {value.submitted}")
}

test fn a_disabled_composer_closes_message_history() Void!Str {
  let terminal = headless::new(56, 10)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  let _ = value.control.open_history(history())
  terminal.flush()
  let context = value.context.expect("mounted host")
  let _ = context.dispatch(fn() {
    value.enabled = false
  })
  terminal.flush()
  let _ = context.dispatch(fn() {
    value.enabled = true
  })
  terminal.flush()
  expect_rows(rows(terminal), ["", "", "", "", "", "", "", "", " Ask kit to do something…", ""])
}

test fn typing_bang_opens_the_bash_panel_with_the_prefix_out_of_the_field() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("!"))
  terminal.flush()
  try testing::assert(value.bash, "the composer reports the Bash panel")
  try expect_rows(
    rows(terminal),
    [
      "",
      "",
      "┌──────────────────────────────────────────────┐",
      "│ Bash                              In context │",
      "├──────────────────────────────────────────────┤",
      "│ Run a command…                               │",
      "└──────────────────────────────────────────────┘",
      "",
    ],
  )
  terminal.key(character("ls"))
  terminal.flush()
  try testing::assert(
    rows(terminal).at(5).or("") == "│ ls                                           │",
    "got {rows(terminal).at(5).or("")}",
  )
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(
    value.submitted == "!ls" and not value.bash,
    "the command runs with its prefix: {value.submitted}",
  )
}

test fn a_bang_at_the_start_keeps_the_result_out_of_context_until_backspace() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("!ls"))
  terminal.key(key("home"))
  terminal.key(character("!"))
  terminal.flush()
  try expect_rows(
    rows(terminal),
    [
      "",
      "",
      "┌──────────────────────────────────────────────┐",
      "│ Bash                          Not in context │",
      "├──────────────────────────────────────────────┤",
      "│ ls                                           │",
      "└──────────────────────────────────────────────┘",
      "",
    ],
  )
  // The caret stays before the command, so Backspace puts it back in
  // context, and what is typed next goes before it.
  terminal.key(key("backspace"))
  terminal.key(character("x"))
  terminal.flush()
  try testing::assert(
    rows(terminal).at(3).or("") == "│ Bash                              In context │" and rows(terminal).at(5).or("") == "│ xls                                          │",
    "got {rows(terminal).at(3).or("")} / {rows(terminal).at(5).or("")}",
  )
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(value.submitted == "!xls", "got {value.submitted}")
}

test fn backspace_edits_the_command_and_leaves_the_panel_once_it_is_empty() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("!!l"))
  terminal.flush()
  terminal.key(key("backspace"))
  terminal.flush()
  try testing::assert(
    value.bash and rows(terminal).at(3).or("") == "│ Bash                          Not in context │",
    "deleting the command keeps the panel and its mode",
  )
  terminal.key(key("backspace"))
  terminal.flush()
  try testing::assert(
    value.bash and rows(terminal).at(3).or("") == "│ Bash                              In context │",
    "the first Backspace at the start puts the result in context",
  )
  terminal.key(key("backspace"))
  terminal.flush()
  try testing::assert(not value.bash, "the next one leaves the panel")
  expect_rows(rows(terminal), ["", "", "", "", "", "", " Ask kit to do something…", ""])
}

test fn escape_leaves_the_panel_keeping_the_command_as_a_prompt() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("!!git log"))
  terminal.flush()
  terminal.key(key("escape"))
  terminal.flush()
  try testing::assert(not value.bash and value.aborts == 0, "Escape leaves the panel first")
  try expect_rows(rows(terminal), ["", "", "", "", "", "", " git log", ""])
  // Typing continues the prompt.
  terminal.key(character("!"))
  terminal.key(key("escape"))
  terminal.flush()
  try testing::assert(value.aborts == 1, "an ordinary draft passes Escape on")
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(value.submitted == "git log!", "got {value.submitted}")
}

test fn escape_closes_command_history_then_the_panel_then_reaches_the_turn() Void!Str {
  let terminal = headless::new(56, 10)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("!ls"))
  terminal.flush()
  let _ = value.control.open_bash_history(commands())
  terminal.flush()
  terminal.key(key("escape"))
  terminal.flush()
  try expect_rows(
    rows(terminal),
    [
      "",
      "",
      "",
      "",
      "┌──────────────────────────────────────────────────────┐",
      "│ Bash                                      In context │",
      "├──────────────────────────────────────────────────────┤",
      "│ ls                                                   │",
      "└──────────────────────────────────────────────────────┘",
      "",
    ],
  )
  terminal.key(key("escape"))
  terminal.flush()
  try testing::assert(not value.bash and value.aborts == 0, "the second Escape leaves the panel")
  terminal.key(key("escape"))
  terminal.flush()
  testing::assert(value.aborts == 1, "the third reaches the application")
}

fn same(left: ui::Color?, right: ui::Color) Bool {
  match left {
    color => color.red == right.red and color.green == right.green and color.blue == right.blue,
    _ => false,
  }
}

test fn the_context_switch_is_muted_meta_that_fills_on_hover() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()
  let colors = theme::context(theme::store(theme::system())).current()

  terminal.key(character("!"))
  terminal.flush()
  // It was once underlined like a URL; underlines are only for navigable
  // links.
  let resting = terminal.frame().cell(40, 3).expect("context label").style
  try testing::assert(
    same(resting.foreground, colors.muted) and same(resting.background, colors.background) and (not resting.underline),
    "the label rests as plain muted meta",
  )
  terminal.mouse_move(40, 3)
  terminal.flush()
  let hovered = terminal.frame().cell(40, 3).expect("context label").style
  try testing::assert(
    same(hovered.foreground, colors.primary_text) and same(hovered.background, colors.surface_hovered),
    "hovering shows the control fill",
  )
  terminal.mouse_move(10, 3)
  terminal.flush()
  let left = terminal.frame().cell(40, 3).expect("context label").style
  testing::assert(same(left.foreground, colors.muted), "leaving restores the rest style")
}

test fn clicking_the_context_switches_where_the_result_goes() Void!Str {
