  type_text(terminal, "@go")
  terminal.key(key("escape"))
  terminal.flush()
  try expect_rows(rows(terminal), ["", "", "", "", "", "", "", " @go", ""])
  try testing::assert(value.aborts == 0, "Escape closes the picker without aborting the turn")
  type_text(terminal, " @")
  try testing::assert(rows(terminal).at(7).or("") == " @go @", "a second mention opens")
  type_text(terminal, "do ")
  try expect_rows(rows(terminal), ["", "", "", "", "", "", "", " @go @do", ""])
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(value.submitted == "@go @do", "Enter sends once the mention closed")
}

test fn clicking_a_path_mentions_it() Void!Str {
  let terminal = headless::new(56, 9)
