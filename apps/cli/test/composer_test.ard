use ard/testing

use cooper
use cooper/cui
use cooper/event
use cooper/keymap
use cooper/testing as headless
use cooper/ui
use kit/tui/attachments
use kit/tui/composer
use kit/tui/theme
use go:os
use go:path/filepath
use go:strings

struct Model {
  enabled: Bool,
  focus_eligible: Bool,
  submitted: Str,
  accept_submission: Bool,
  other: Str,
  mode: Str,
  palette_opens: Int,
  follow_ups: Int,
  restores: Int,
  recalls: Int,
  // Escapes reaching the application, as the Shell's turn abort does.
  aborts: Int,
  submissions: Int,
  // Whether pasted paths are accepted, and those accepted.
  accept_attachments: Bool,
  attached: [Str],
  context: cui::Context?,
  control: mut composer::Ref,
  other_input: mut cui::InputRef,
}

struct Props {
  model: mut Model,
  themes: theme::Context,
}

struct Host {
  props: mut Props,
}

fn host(props: mut Props) mut Host {
  (mut Host{props: props})
}

impl cui::Lifecycle for Host {
  fn mut mounted(context: cui::Context) {
    self.props.model.context = Maybe::new(context)
  }

  fn mut unmounting(context: cui::Context) {}
}

impl cui::Component for Host {
  fn mut render() cui::View {
    let model = self.props.model
    let abort = keymap::simple_command("test.abort", "Abort", fn() Bool {
      model.aborts =+ 1
      true
    })
    // The composer rests at the bottom, as in the Shell, so pickers that grow
    // upward from it are on screen.
    cui::box(
      [
        cui::box([], styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0))),
        composer::view(
          composer::Props{
            themes: self.props.themes,
            enabled: model.enabled,
            focus_eligible: model.focus_eligible,
            control: model.control,
            submit: fn(text: Str) Bool {
              model.submissions =+ 1
              if model.accept_submission {
                model.submitted = text
              }
              model.accept_submission
            },
            follow_ups: model.follow_ups,
            attach: fn(paths: [Str]) Bool {
              if model.accept_attachments {
                for path in paths {
                  model.attached.push(path)
                }
              }
              model.accept_attachments
            },
            restore_follow_ups: fn() {
              model.restores =+ 1
            },
            recall_history: fn() {
              model.recalls =+ 1
            },
            open_palette: fn() {
              model.palette_opens =+ 1
            },
            mode_changed: fn(mode: Str) {
              model.mode = mode
            },
          },
        ),
        cui::input(
          model.other,
          key: "other",
          ref: model.other_input,
          styles: ui::style(flex_shrink: 0.0),
          on_input: fn(value: Str, context: cui::Context) {
            model.other = value
          },
        ),
      ],
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        flex_direction: ui::FlexDirection::column,
      ),
      commands: [abort],
      bindings: [keymap::binding(keymap::key("escape"), abort.with())],
      binding_scope: keymap::ScopeMode::application,
    )
  }
}

fn model() mut Model {
  (mut Model{
    enabled: true,
    focus_eligible: true,
    submitted: "",
    accept_submission: true,
    other: "",
    mode: "",
    palette_opens: 0,
    follow_ups: 0,
    restores: 0,
    recalls: 0,
    aborts: 0,
    submissions: 0,
    accept_attachments: true,
    attached: [],
    context: Maybe::new<cui::Context>(),
    control: composer::ref(),
    other_input: cui::input_ref(),
  })
}

fn mount(terminal: headless::TestApp, value: mut Model) cui::Renderer {
  cui::mount(
    cooper::App{context: terminal.context, root: terminal.root},
    cui::child(host, Props{model: value, themes: theme::context(theme::store(theme::system()))}),
  )
}

fn key(name: Str, text: Str?) mut event::KeyEvent {
  event::key(
    name,
    text.or(""),
    event::KeyEventType::press,
    event::Modifiers{
      shift: false,
      ctrl: false,
      alt: false,
      super: false,
    },
  )
}

fn character(value: Str) mut event::KeyEvent {
  key(value, text: value)
}

fn chord(name: Str, shift: Bool, ctrl: Bool) mut event::KeyEvent {
  event::key(
    name,
    "",
    event::KeyEventType::press,
    event::Modifiers{
      shift: shift,
      ctrl: ctrl,
      alt: false,
      super: false,
    },
  )
}

test fn ctrl_w_and_ctrl_shift_w_delete_the_word_before_and_after_the_cursor() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("one two three"))
  terminal.flush()
  terminal.key(chord("w", false, true))
  terminal.flush()
  terminal.key(chord("a", false, true))
  terminal.flush()
  terminal.key(chord("w", true, true))
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  // Submission trims the spaces left around the remaining word.
  testing::assert(value.submitted == "two", "got \"{value.submitted}\"")
}

test fn parent_renders_do_not_make_the_composer_reclaim_focus() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  let context = value.context.expect("mounted host")
  let _ = value.other_input.focus(context)
  let _ = context.dispatch(fn() {
    value.enabled = true
  })
  terminal.flush()
  terminal.key(character("a"))
  terminal.flush()
  terminal.key(character("b"))
  terminal.flush()

  try testing::assert(value.other == "ab", "the explicitly focused input keeps keyboard ownership")
  testing::assert(value.submitted == "", "the composer remains idle")
}

test fn enabling_the_composer_does_not_focus_it_without_an_explicit_request() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  let context = value.context.expect("mounted host")
  let _ = value.other_input.focus(context)
  let _ = context.dispatch(fn() {
    value.enabled = false
  })
  terminal.flush()
  let _ = context.dispatch(fn() {
    value.enabled = true
  })
  terminal.flush()
  terminal.key(character("x"))
  terminal.flush()
  try testing::assert(value.other == "x", "an enabled transition does not steal focus")

  try testing::assert(value.control.focus(), "the mounted composer accepts an explicit focus request")
  terminal.flush()
  terminal.flush()
  terminal.key(character("y"))
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()

  testing::assert(
    value.submitted == "y",
    "explicit focus routes input and submission to the composer",
  )
}

test fn the_retained_composer_preserves_drafts_across_parent_updates() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("a"))
  terminal.flush()
  let context = value.context.expect("mounted host")
  let _ = context.dispatch(fn() {
    value.enabled = true
  })
  terminal.flush()
  terminal.key(character("b"))
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()

  testing::assert(value.submitted == "ab", "parent reconciliation preserves the child-owned draft")
}

test fn clear_and_restore_mutate_the_draft_through_the_composer_owner() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("!"))
  terminal.flush()
  try testing::assert(value.mode != "", "draft mode is reported to Shell chrome")
  try testing::assert(value.control.clear(), "clear handles a non-empty draft")
  terminal.flush()
  try testing::assert(value.mode == "", "clear resets the reported mode")
  try testing::assert(
    value.control.restore_if_empty("restored"),
    "restore is scheduled through the owner",
  )
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  try testing::assert(value.submitted == "restored", "a failed submission can restore an empty draft")

  terminal.key(character("old session"))
  terminal.flush()
  let _ = value.control.reset()
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(value.submitted == "", "session reset clears the child-owned draft")
}

test fn rejected_submission_keeps_the_draft_until_shell_can_accept_it() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  value.accept_submission = false
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("draft"))
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  try testing::assert(
    value.submitted == "",
    "Shell can reject a submission without accepting responsibility",
  )

  value.accept_submission = true
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(
    value.submitted == "draft",
    "the rejected draft remains available for a later submission",
  )
}

test fn parent_can_enable_and_focus_the_composer_in_one_transition() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  value.enabled = false
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  let context = value.context.expect("mounted host")
  let _ = value.other_input.focus(context)
  terminal.flush()
  let _ = context.dispatch(fn() {
    value.enabled = true
    let _ = value.control.focus()
  })
  terminal.flush()
  terminal.flush()
  terminal.key(character("x"))
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()

  try testing::assert(value.other == "", "the previous input releases focus")
  testing::assert(
    value.submitted == "x",
    "the newly enabled composer receives the explicit focus request",
  )
}

test fn a_focus_request_does_not_override_the_parent_transitions_final_disabled_state() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  let context = value.context.expect("mounted host")
  let _ = value.other_input.focus(context)
  terminal.flush()
  let _ = context.dispatch(fn() {
    value.enabled = true
    let _ = value.control.focus()
    value.enabled = false
  })
  terminal.flush()
  terminal.flush()
  terminal.key(character("x"))
  terminal.flush()

  try testing::assert(value.submitted == "", "the disabled composer does not receive input")
  testing::assert(value.other == "x", "the prior focus owner remains active")
}

test fn a_focus_request_does_not_override_a_new_workspace_focus_owner() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  let context = value.context.expect("mounted host")
  let _ = value.other_input.focus(context)
  terminal.flush()
  let _ = context.dispatch(fn() {
    let _ = value.control.focus()
    // Composer remains editable, but another workspace owns default focus.
    value.focus_eligible = false
  })
  terminal.flush()
  terminal.flush()
  terminal.key(character("x"))
  terminal.flush()

  try testing::assert(value.submitted == "", "the composer does not take the workspace's focus")
  testing::assert(value.other == "x", "the workspace focus owner remains active")
}

test fn up_restores_queued_follow_ups_only_while_any_are_queued() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("ab"))
  terminal.flush()
  terminal.key(
    event::key(
      "return",
      "",
      event::KeyEventType::press,
      event::Modifiers{
        shift: true,
        ctrl: false,
        alt: false,
        super: false,
      },
    ),
  )
  terminal.key(character("cd"))
  terminal.flush()
  terminal.key(key("up"))
  terminal.flush()
  terminal.key(character("X"))
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  try testing::assert(
    value.restores == 0 and value.submitted == "abX\ncd",
    "without a queue Up moves the cursor: {value.submitted}",
  )

  let context = value.context.expect("mounted host")
  let _ = context.dispatch(fn() {
    value.follow_ups = 2
  })
  terminal.flush()
  terminal.key(character("draft"))
  terminal.flush()
  terminal.key(key("up"))
  terminal.flush()
  testing::assert(value.restores == 1, "Up restores the queue, even with a draft")
}

test fn enter_offers_a_blank_draft_as_empty() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  value.submitted = "unchanged"
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character(" "))
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(
    value.submissions == 1 and value.submitted == "",
    "the shell decides what an empty draft sends",
  )
}

test fn a_pasted_file_list_is_attached_instead_of_typed() Void!Str {
  let directory = attachments::fixtures()
  defer os::RemoveAll(directory)
  let notes = filepath::Join(directory, "notes.txt")
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("see "))
  terminal.flush()
  terminal.paste(event::paste("{notes}\n"))
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  try testing::assert(
    value.attached.size() == 1 and value.attached.at(0).or("") == notes,
    "the file is attached",
  )
  try testing::assert(value.submitted == "see", "the path stays out of the draft: {value.submitted}")

  terminal.paste(event::paste("look at {notes}"))
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  try testing::assert(value.attached.size() == 1, "prose is not attached")
  try testing::assert(value.submitted == "look at {notes}", "prose is typed: {value.submitted}")

  value.accept_attachments = false
  terminal.paste(event::paste(notes))
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(value.submitted == notes, "a refused attachment stays text: {value.submitted}")
}

test fn restored_text_goes_before_the_draft_with_the_cursor_at_the_end() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("draft"))
  terminal.flush()
  try testing::assert(value.control.prepend("first\n\nsecond"), "prepend is scheduled")
  terminal.flush()
  terminal.key(character("!"))
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  try testing::assert(
    value.submitted == "first\n\nsecond\n\ndraft!",
    "the queue comes first: {value.submitted}",
  )

  let _ = value.control.prepend("only")
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(value.submitted == "only", "an empty draft takes the text alone")
}

test fn a_file_list_inserted_as_text_is_attached() Void!Str {
  let directory = attachments::fixtures()
  defer os::RemoveAll(directory)
  let notes = filepath::Join(directory, "notes.txt")
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("see "))
  terminal.flush()
  // A terminal that does not mark pastes inserts the text as one change.
  terminal.key(character(notes))
  terminal.flush()
  terminal.key(character("!"))
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  try testing::assert(
    value.attached.size() == 1 and value.attached.at(0).or("") == notes,
    "the file is attached",
  )
  testing::assert(value.submitted == "see !", "the path leaves the draft: {value.submitted}")
}

test fn a_path_completed_across_changes_is_attached() Void!Str {
  let directory = attachments::fixtures()
  defer os::RemoveAll(directory)
  let notes = filepath::Join(directory, "notes.txt")
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  for part in [filepath::Dir(notes), "/notes", ".txt"] {
    terminal.key(character(part))
    terminal.flush()
  }
  try testing::assert(value.attached.size() == 1, "the completed path is attached")
  terminal.key(character("hi"))
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(value.submitted == "hi", "the draft is cleared of the path: {value.submitted}")
}

fn rows(terminal: headless::TestApp) [Str] {
  let trimmed = mut List::new<Str>()
  for row in strings::Split(terminal.frame().text(), "\n") {
    trimmed.push(strings::TrimRight(row, " "))
  }
  trimmed.@
}

fn expect_rows(actual: [Str], expected: [Str]) Void!Str {
  let shown = strings::Join(mut actual, "|\n")
  try testing::assert(actual.size() == expected.size(), "row count {actual.size()}:\n{shown}|")
  mut index = 0
  while index < expected.size() {
    let want = expected.at(index).or("")
    let got = actual.at(index).or("")
    try testing::assert(got == want, "row {index}: got {got}|, want {want}|\n{shown}|")
    index =+ 1
  }
  testing::pass()
}

fn history() [composer::HistoryEntry] {
  [
    composer::HistoryEntry{id: "3", text: "run the tests"},
    composer::HistoryEntry{id: "2", text: "fix the\n  flaky test"},
    composer::HistoryEntry{id: "1", text: "explain the repo"},
  ]
}

test fn up_on_a_blank_draft_asks_for_message_history() Void!Str {
  let terminal = headless::new(56, 10)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character(" "))
  terminal.key(key("up"))
  terminal.flush()
  try testing::assert(value.recalls == 1, "a blank draft recalls history")

  terminal.key(character("draft"))
  terminal.key(key("up"))
  terminal.flush()
  try testing::assert(value.recalls == 1, "a draft keeps Up for the cursor")

  let context = value.context.expect("mounted host")
  let _ = context.dispatch(fn() {
    value.follow_ups = 1
  })
  terminal.flush()
  let _ = value.control.clear()
  terminal.flush()
  terminal.key(key("up"))
  terminal.flush()
  testing::assert(
    value.recalls == 1 and value.restores == 1,
    "queued follow-ups are restored first",
  )
}

test fn message_history_lists_prompts_oldest_first_above_the_composer() Void!Str {
  let terminal = headless::new(56, 10)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  try testing::assert(value.control.open_history(history()), "history is scheduled")
  terminal.flush()
  // The newest prompt sits nearest the composer, selected; a multi-line
  // prompt shows on one line.
  expect_rows(
    rows(terminal),
    [
      "",
      "",
      "",
      " ┌──────────────────────────────────────────────┐",
      " │ explain the repo                             │",
      " │ fix the flaky test                           │",
      " │▌run the tests                                │",
      " └──────────────────────────────────────────────┘",
      " Ask kit to do something…",
      "",
    ],
  )
}

test fn the_draft_filters_message_history_and_enter_recalls_the_selection() Void!Str {
  let terminal = headless::new(56, 10)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  let _ = value.control.open_history(history())
  terminal.flush()
  terminal.key(character("ts"))
  terminal.flush()
  terminal.key(key("up"))
  terminal.flush()
  try expect_rows(
    rows(terminal),
    [
      "",
      "",
      "",
      "",
      " ┌──────────────────────────────────────────────┐",
      " │▌fix the flaky test                           │",
      " │ run the tests                                │",
      " └──────────────────────────────────────────────┘",
      " ts",
      "",
    ],
  )
  // Moving wraps at both ends: down to the last, past it to the first, and
  // back up past the first to the last.
  terminal.key(key("down"))
  terminal.key(key("down"))
  terminal.key(key("up"))
  terminal.key(key("up"))
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  try testing::assert(value.submissions == 0, "Enter recalls instead of sending")
  terminal.key(character("!"))
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(
    value.submitted == "fix the\n  flaky test!",
    "the whole prompt is recalled with the cursor at its end: {value.submitted}",
  )
}

test fn escape_closes_message_history_and_keeps_the_draft() Void!Str {
  let terminal = headless::new(56, 10)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  let _ = value.control.open_history(history())
  terminal.flush()
  terminal.key(character("zzz"))
  terminal.flush()
  try testing::assert(
    rows(terminal).at(6).or("") == " │ No results                                   │",
    "nothing matches",
  )
  // Enter with nothing selected does nothing.
  terminal.key(key("return"))
  terminal.key(key("escape"))
  terminal.flush()
  try expect_rows(rows(terminal), ["", "", "", "", "", "", "", "", " zzz", ""])
  try testing::assert(value.aborts == 0, "Escape closes the picker without aborting the turn")
  terminal.key(key("escape"))
  terminal.flush()
  try testing::assert(value.aborts == 1, "without the picker Escape aborts again")
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(value.submitted == "zzz", "Enter sends again")
}

test fn clicking_a_prompt_recalls_it() Void!Str {
  let terminal = headless::new(56, 10)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  let _ = value.control.open_history(history())
  terminal.flush()
  terminal.click(5, 4)
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(value.submitted == "explain the repo", "got {value.submitted}")
}

test fn a_disabled_composer_closes_message_history() Void!Str {
  let terminal = headless::new(56, 10)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  let _ = value.control.open_history(history())
  terminal.flush()
  let context = value.context.expect("mounted host")
  let _ = context.dispatch(fn() {
    value.enabled = false
  })
  terminal.flush()
  let _ = context.dispatch(fn() {
    value.enabled = true
  })
  terminal.flush()
  expect_rows(rows(terminal), ["", "", "", "", "", "", "", "", " Ask kit to do something…", ""])
}

test fn bash_drafts_report_whether_the_result_joins_the_context() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let value = model()
  let renderer = mount(terminal, value)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("!ls"))
  terminal.flush()
  try testing::assert(value.mode == "bash · in context", "got {value.mode}")
  terminal.key(key("home"))
  terminal.key(character("!"))
  terminal.flush()
  try testing::assert(value.mode == "bash · not in context", "got {value.mode}")
  let _ = value.control.clear()
  terminal.flush()
  testing::assert(value.mode == "", "an ordinary draft has no mode")
}
