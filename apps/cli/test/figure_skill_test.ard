use ard/testing

use go:bytes
use kit/tui/figure
use go:os
use go:strings

// The built-in `kit-figures` skill teaches models the figure grammar. Every
// figure fence in it must draw, and every figure kind must have an example,
// so a grammar change can't leave the skill teaching what isn't drawn.

let skill = "../../internal/skills/kit-figures.md"

let kinds = [
  "stat",
  "bars",
  "meter",
  "timeline",
  "steps",
  "decision",
  "delta",
  "spec",
  "tree",
  "compare",
  "score",
  "stack",
]

test fn every_figure_in_the_skill_draws() Void!Str {
  let content = match os::ReadFile(skill) {
    ok(data) => bytes::NewBuffer(mut data).String(),
    err(failure) => try Result::err("{skill}: {failure.error()}"),
  }
  let lines = strings::Split(content, "\n")
  let failures = mut List::new<Str>()
  let drawn = mut List::new<Str>()
  mut index = 0
  while index < lines.size() {
    let line = lines.at(index).or("")
    let info = strings::TrimPrefix(line, "```")
    index =+ 1
    if line != info and figure::is_figure(info) {
      let body = mut List::new<Str>()
      mut open = true
      while open {
        let next = lines.at(index).or("```")
        index =+ 1
        if next == "```" {
          open = false
        } else {
          body.push(next)
        }
      }
      match figure::parse(info, strings::Join(body, "\n") + "\n") {
        ok(parsed) => drawn.push(parsed.kind),
        err(reason) => failures.push("`{info}`: {reason}"),
      }
    }
  }
  for kind in kinds {
    mut found = false
    for name in drawn {
      if name == kind {
        found = true
      }
    }
    if not found {
      failures.push("no `{kind}` example")
    }
  }
  testing::assert(
    failures.size() == 0,
    "the kit-figures skill is out of date:\n{strings::Join(failures, "\n")}",
  )
}
