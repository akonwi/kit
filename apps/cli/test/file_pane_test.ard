use ard/testing

use go:api/contract as protocol
use cooper
use cooper/cui
use cooper/event
use cooper/testing as headless
use cooper/ui
use go:kit/ffi/attachmentbridge
use go:kit/ffi/hostfilebridge
use go:kit/ffi/sessionbridge
use kit/tui/annotations
use kit/tui/file_pane
use kit/tui/theme
use kit/tui/workspace
use go:strings
use go:time

fn rows(terminal: headless::TestApp) [Str] {
  let trimmed = mut List::new<Str>()
  for row in strings::Split(terminal.frame().text(), "\n") {
    trimmed.push(strings::TrimRight(row, " "))
  }
  trimmed.@
}

fn expect_rows(actual: [Str], expected: [Str]) Void!Str {
  let shown = strings::Join(mut actual, "|\n")
  try testing::assert(actual.size() == expected.size(), "row count {actual.size()}:\n{shown}|")
  mut index = 0
  while index < expected.size() {
    let want = expected.at(index).or("")
    let got = actual.at(index).or("")
    try testing::assert(got == want, "row {index}: got {got}|, want {want}|\n{shown}|")
    index =+ 1
  }
  testing::pass()
}

fn same_color(left: ui::Color?, right: ui::Color) Bool {
  match left {
    color => color.red == right.red and color.green == right.green and color.blue == right.blue,
    _ => false,
  }
}

struct Shown {
  terminal: headless::TestApp,
  renderer: cui::Renderer,
}

// Mounts a shown File pane for notes.txt, which reads as content, and waits
// for it to load.
fn show(width: Int, height: Int, content: Str, line: Int) Shown {
  let terminal = headless::new(width, height)
  let tabs = workspace::tabs()
  let _ = tabs.open(workspace::file("workspace_a", "notes.txt", line))
  let renderer = cui::mount(
    cooper::App{context: terminal.context, root: terminal.root},
    file_pane::view(
      file_pane::Props{
        themes: theme::context(theme::store(theme::system())),
        tab: tabs.current().expect("the file tab"),
        stale: false,
        shown: true,
        read: Maybe::new(fn(input: protocol::ReadWorkspaceFileInput) protocol::WorkspaceFileRead!Error {
          Result::ok(
            protocol::WorkspaceFileRead{
              Path: input.Path,
              Content: content,
              Size: Int64::from(content.size()),
            },
          )
        }),
        annotations: [],
        remove_annotation: fn(id: Uint64) {},
        release_focus: fn() {},
      },
    ),
  )
  terminal.flush()
  mut attempts = 0
  while attempts < 100 and strings::Contains(terminal.frame().text(), "Loading file") {
    terminal.flush()
    time::Sleep(time::Millisecond * 5)
    attempts =+ 1
  }
  terminal.flush()
  terminal.flush()
  Shown{terminal: terminal, renderer: renderer}
}

test fn a_file_shows_numbered_lines_under_its_path() Void!Str {
  let shown = show(40, 8, "alpha\nbeta\ngamma\n", 2)
  defer shown.terminal.destroy()
  defer shown.renderer.destroy()
  try expect_rows(
    rows(shown.terminal),
    [
      " notes.txt        Ln 2 · 3 lines · 17 B",
      "────────────────────────────────────────",
      "   1 alpha",
      "   2 beta",
      "   3 gamma",
      "",
      "",
      "",
    ],
  )
  let colors = theme::system()
  let cursor = shown.terminal.frame().cell(20, 3).expect("cursor line")
  try testing::assert(
    same_color(cursor.style.background, colors.surface_pressed),
    "the cursor line is filled",
  )
  shown.terminal.click(8, 4)
  shown.terminal.flush()
  let header = rows(shown.terminal).at(0).or("")
  try testing::assert(
    header == " notes.txt        Ln 3 · 3 lines · 17 B",
    "a click moves the cursor: {header}|",
  )
  let moved = shown.terminal.frame().cell(20, 4).expect("clicked line")
  testing::assert(
    same_color(moved.style.background, colors.surface_pressed),
    "the clicked line is filled",
  )
}

test fn long_lines_scroll_sideways_beside_fixed_numbers() Void!Str {
  let shown = show(24, 6, "0123456789abcdefghijklmnop\nshort\n", 0)
  defer shown.terminal.destroy()
  defer shown.renderer.destroy()
  try testing::assert(
    rows(shown.terminal).at(2).or("") == "   1 0123456789abcdefgh",
    "a long line is cut at the edge: {strings::Join(mut rows(shown.terminal), "|\n")}",
  )
  shown.terminal.scroll(10, 2, 0, delta_x: 1)
  shown.terminal.flush()
  let body = rows(shown.terminal)
  try testing::assert(body.at(2).or("") == "   1 456789abcdefghijkl", "a sideways swipe scrolls the text")
  testing::assert(body.at(3).or("") == "   2 t", "every line scrolls together")
}

// What an annotated File pane asked of the session.
struct Calls {
  saved: [Str],
  removed: [Uint64],
  bodies: Int,
  released: Int,
}

// Mounts a shown File pane for notes.txt at revision rev-1, with the given
// annotations and a session that records what it is asked.
fn annotated(
  width: Int,
  height: Int,
  content: Str,
  notes: [sessionbridge::Annotation],
  calls: mut Calls,
  full_body: Str,
) Shown {
  let terminal = headless::new(width, height)
  let tabs = workspace::tabs()
  let _ = tabs.open(workspace::file("workspace_a", "notes.txt", 0))
  let renderer = cui::mount(
    cooper::App{context: terminal.context, root: terminal.root},
    file_pane::view(
      file_pane::Props{
        themes: theme::context(theme::store(theme::system())),
        tab: tabs.current().expect("the file tab"),
        stale: false,
        shown: true,
        read: Maybe::new(fn(input: protocol::ReadWorkspaceFileInput) protocol::WorkspaceFileRead!Error {
          Result::ok(
            protocol::WorkspaceFileRead{
              Workspace: protocol::WorkspaceRef{WorkspaceID: "workspace_a"},
              Path: input.Path,
              Revision: "rev-1",
              Content: content,
              Size: Int64::from(content.size()),
            },
          )
        }),
        annotations: notes,
        annotate: Maybe::new(
          annotations::Service{
            create: fn(anchor: protocol::AnnotationAnchor, body: Str) Str {
              let file = anchor.WorkspaceFile.@
              calls.saved.push(
                "create {file.WorkspaceID} {file.Path}@{file.FileRevision} {file.StartLine}-{file.EndLine}: {body}",
              )
              ""
            },
            update: fn(id: Uint64, body: Str) Str {
              calls.saved.push("update {id}: {body}")
              ""
            },
            remove: fn(id: Uint64) Str {
              ""
            },
            body: fn(id: Uint64) Str!Str {
              calls.bodies =+ 1
              Result::ok(full_body)
            },
          },
        ),
        remove_annotation: fn(id: Uint64) {
          calls.removed.push(id)
        },
        release_focus: fn() {
          calls.released =+ 1
        },
      },
    ),
  )
  settle(terminal, "Loading file")
  Shown{terminal: terminal, renderer: renderer}
}

// Flushes until the frame no longer shows `pending`.
fn settle(terminal: headless::TestApp, pending: Str) {
  terminal.flush()
  mut attempts = 0
  while attempts < 100 and strings::Contains(terminal.frame().text(), pending) {
    terminal.flush()
    time::Sleep(time::Millisecond * 5)
    attempts =+ 1
  }
  terminal.flush()
  terminal.flush()
}

// Flushes until `done` holds.
fn wait_until(terminal: headless::TestApp, done: fn() Bool) {
  mut attempts = 0
  while attempts < 100 and not done() {
    terminal.flush()
    time::Sleep(time::Millisecond * 5)
    attempts =+ 1
  }
  terminal.flush()
}

fn calls() mut Calls {
  (mut Calls{
    saved: [],
    removed: [],
    bodies: 0,
    released: 0,
  })
}

fn note(id: Int, start: Int, end: Int, body: Str) sessionbridge::Annotation {
  sessionbridge::Annotation{
    ID: Uint64::fit(id),
    Kind: "file",
    WorkspaceID: "workspace_a",
    Path: "notes.txt",
    FileRevision: "rev-1",
    StartLine: start,
    EndLine: end,
    Body: body,
  }
}

fn typed(terminal: headless::TestApp, text: Str) {
  for character in strings::Split(text, "") {
    terminal.key(
      event::key(
        character,
        character,
        event::KeyEventType::press,
        event::Modifiers{
          shift: false,
          ctrl: false,
          alt: false,
          super: false,
        },
      ),
    )
  }
  terminal.flush()
}

fn press(terminal: headless::TestApp, name: Str) {
  terminal.key(
    event::key(
      name,
      "",
      event::KeyEventType::press,
      event::Modifiers{
        shift: false,
        ctrl: false,
        alt: false,
        super: false,
      },
    ),
  )
  terminal.flush()
}

test fn the_hovered_line_offers_a_plus_that_annotates_it() Void!Str {
  let recorded = calls()
  let shown = annotated(40, 14, "alpha\nbeta\ngamma\n", [], recorded, "")
  defer shown.terminal.destroy()
  defer shown.renderer.destroy()
  shown.terminal.mouse_move(10, 3)
  shown.terminal.flush()
  try expect_rows(
    rows(shown.terminal),
    [
      " notes.txt        Ln 2 · 3 lines · 17 B",
      "────────────────────────────────────────",
      "   1 alpha",
      "   + beta",
      "   3 gamma",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
    ],
  )
  let colors = theme::system()
  let plus = shown.terminal.frame().cell(3, 3).expect("the +")
  try testing::assert(same_color(plus.style.background, colors.primary), "the + is filled")
  shown.terminal.click(3, 3)
  shown.terminal.flush()
  try expect_rows(
    rows(shown.terminal),
    [
      " notes.txt        Ln 2 · 3 lines · 17 B",
      "────────────────────────────────────────",
      "   1 alpha",
      "   2 beta",
      "     ┌───────────────────────────────┐",
      "     │                               │",
      "     │                               │",
      "     │                               │",
      "     │         Cancel      Comment   │",
      "     └───────────────────────────────┘",
      "   3 gamma",
      "",
      "",
      "",
    ],
  )
  typed(shown.terminal, "tighten")
  press(shown.terminal, "return")
  wait_until(shown.terminal, fn() Bool {
    recorded.saved.size() > 0
  })
  try testing::assert(
    recorded.saved.at(0).or("") == "create workspace_a notes.txt@rev-1 2-2: tighten",
    "the note anchors to the line it was opened on: {recorded.saved.at(0).or("")}",
  )
  wait_until(shown.terminal, fn() Bool {
    recorded.released > 0
  })
  testing::assert(
    rows(shown.terminal).at(4).or("") == "   3 gamma",
    "saving closes the editor: {strings::Join(mut rows(shown.terminal), "|\n")}",
  )
}

test fn dragging_down_the_gutter_annotates_a_range() Void!Str {
  let recorded = calls()
  let shown = annotated(40, 14, "alpha\nbeta\ngamma\ndelta\n", [], recorded, "")
  defer shown.terminal.destroy()
  defer shown.renderer.destroy()
  shown.terminal.mouse_move(10, 2)
  shown.terminal.flush()
  shown.terminal.mouse_down(3, 2)
  shown.terminal.mouse(
    event::mouse(
      event::MouseEventType::drag,
      event::MouseButton::left,
      3,
      3,
      event::Modifiers{
        shift: false,
        ctrl: false,
        alt: false,
        super: false,
      },
    ),
  )
  shown.terminal.mouse(
    event::mouse(
      event::MouseEventType::drag,
      event::MouseButton::left,
      12,
      4,
      event::Modifiers{
        shift: false,
        ctrl: false,
        alt: false,
        super: false,
      },
    ),
  )
  shown.terminal.flush()
  let colors = theme::system()
  let picked = shown.terminal.frame().cell(20, 3).expect("a picked line")
  try testing::assert(
    same_color(picked.style.background, colors.surface_hovered),
    "the picked lines are filled",
  )
  shown.terminal.mouse_up(12, 4)
  shown.terminal.flush()
  try testing::assert(
    rows(shown.terminal).at(5).or("") == "     ┌───────────────────────────────┐",
    "release opens the editor under the lines: {strings::Join(mut rows(shown.terminal), "|\n")}",
  )
  let first = shown.terminal.frame().cell(20, 2).expect("the first line")
  try testing::assert(same_color(first.style.background, colors.surface_hovered), "the lines stay filled")
  typed(shown.terminal, "why")
  shown.terminal.click(30, 9)
  wait_until(shown.terminal, fn() Bool {
    recorded.saved.size() > 0
  })
  testing::assert(
    recorded.saved.at(0).or("") == "create workspace_a notes.txt@rev-1 1-3: why",
    "Comment saves the range: {recorded.saved.at(0).or("")}",
  )
}

test fn saved_notes_sit_under_their_lines() Void!Str {
  let recorded = calls()
  let shown = annotated(40, 8, "alpha\nbeta\ngamma\n", [note(4, 1, 2, "check this")], recorded, "")
  defer shown.terminal.destroy()
  defer shown.renderer.destroy()
  try expect_rows(
    rows(shown.terminal),
    [
      " notes.txt        Ln 1 · 3 lines · 17 B",
      "────────────────────────────────────────",
      "   + alpha",
      "   2 beta",
      "   ×  🗨️ check this",
      "   3 gamma",
      "",
      "",
    ],
  )
  let colors = theme::system()
  let number = shown.terminal.frame().cell(3, 3).expect("an annotated line's number")
  try testing::assert(
    same_color(number.style.background, colors.primary) and same_color(number.style.foreground, colors.foreground),
    "annotated lines' numbers are filled like the +",
  )
  let edge = shown.terminal.frame().cell(0, 3).expect("the gutter's first cell")
  try testing::assert(same_color(edge.style.background, colors.primary), "across the whole gutter")
  let fill = shown.terminal.frame().cell(30, 4).expect("the note")
  try testing::assert(same_color(fill.style.background, colors.surface), "the note is on the surface")
  shown.terminal.click(3, 4)
  shown.terminal.flush()
  testing::assert(
    recorded.removed.size() == 1 and recorded.removed.at(0).or(Uint64::from(0)) == Uint64::from(4),
    "its × removes it",
  )
}

test fn clicking_a_note_edits_it_in_place() Void!Str {
  let recorded = calls()
  let shown = annotated(40, 14, "alpha\nbeta\ngamma\n", [note(4, 1, 2, "check this")], recorded, "")
  defer shown.terminal.destroy()
  defer shown.renderer.destroy()
  shown.terminal.click(12, 4)
  shown.terminal.flush()
  try expect_rows(
    rows(shown.terminal),
    [
      " notes.txt        Ln 1 · 3 lines · 17 B",
      "────────────────────────────────────────",
      "   1 alpha",
      "   2 beta",
      "     ┌───────────────────────────────┐",
      "     │ check this                    │",
      "     │                               │",
      "     │                               │",
      "     │            Cancel      Save   │",
      "     └───────────────────────────────┘",
      "   3 gamma",
      "",
      "",
      "",
    ],
  )
  typed(shown.terminal, "!")
  press(shown.terminal, "return")
  wait_until(shown.terminal, fn() Bool {
    recorded.saved.size() > 0
  })
  testing::assert(
    recorded.saved.at(0).or("") == "update 4: check this!",
    "Enter saves the edit: {recorded.saved.at(0).or("")}",
  )
}

test fn escape_cancels_a_note() Void!Str {
  let recorded = calls()
  let shown = annotated(40, 14, "alpha\nbeta\n", [], recorded, "")
  defer shown.terminal.destroy()
  defer shown.renderer.destroy()
  shown.terminal.mouse_move(10, 2)
  shown.terminal.flush()
  shown.terminal.click(3, 2)
  shown.terminal.flush()
  typed(shown.terminal, "draft")
  press(shown.terminal, "escape")
  try testing::assert(rows(shown.terminal).at(3).or("") == "   2 beta", "the editor closes")
  testing::assert(
    recorded.saved.size() == 0 and recorded.released == 1,
    "nothing is saved and the keyboard goes back",
  )
}

test fn editing_a_long_note_loads_its_whole_body() Void!Str {
  let recorded = calls()
  let preview = strings::Repeat("a", 256)
  let shown = annotated(40, 20, "alpha\n", [note(4, 1, 1, preview)], recorded, "the whole note")
  defer shown.terminal.destroy()
  defer shown.renderer.destroy()
  shown.terminal.click(12, 3)
  wait_until(shown.terminal, fn() Bool {
    recorded.bodies > 0 and strings::Contains(shown.terminal.frame().text(), "the whole note")
  })
  testing::assert(
    strings::Contains(shown.terminal.frame().text(), "│ the whole note"),
    "the editor holds the whole body: {strings::Join(mut rows(shown.terminal), "|\n")}",
  )
}

// Mounts a shown host File tab for path, which reads as `read` returns, and
// waits for it to load.
fn show_host(
  width: Int,
  height: Int,
  file_path: Str,
  read: fn(Str, Int, Int) hostfilebridge::File!Error,
) Shown {
  let terminal = headless::new(width, height)
  let tabs = workspace::tabs()
  let _ = tabs.open(workspace::host_file(file_path, 0))
  let renderer = cui::mount(
    cooper::App{context: terminal.context, root: terminal.root},
    file_pane::view(
      file_pane::Props{
        themes: theme::context(theme::store(theme::system())),
        tab: tabs.current().expect("the host file tab"),
        stale: false,
        shown: true,
        read_host: Maybe::new(read),
        annotations: [],
        annotate: Maybe::new(
          annotations::Service{
            create: fn(anchor: protocol::AnnotationAnchor, body: Str) Str {
              ""
            },
            update: fn(id: Uint64, body: Str) Str {
              ""
            },
            remove: fn(id: Uint64) Str {
              ""
            },
            body: fn(id: Uint64) Str!Str {
              Result::ok("")
            },
          },
        ),
        remove_annotation: fn(id: Uint64) {},
        release_focus: fn() {},
      },
    ),
  )
  settle(terminal, "Loading file")
  Shown{terminal: terminal, renderer: renderer}
}

test fn a_host_file_shows_its_text_by_absolute_path_without_annotations() Void!Str {
  let shown = show_host(
    48,
    6,
    "/etc/hosts",
    fn(file_path: Str, width: Int, height: Int) hostfilebridge::File!Error {
      let content = "127.0.0.1 localhost\n::1 localhost\n"
      Result::ok(
        hostfilebridge::File{
          Text: protocol::WorkspaceFileRead{
            Path: file_path,
            Content: content,
            Size: Int64::from(content.size()),
          },
        },
      )
    },
  )
  defer shown.terminal.destroy()
  defer shown.renderer.destroy()
  shown.terminal.mouse_move(10, 3)
  shown.terminal.flush()
  expect_rows(
    rows(shown.terminal),
    [
      " /etc/hosts               Ln 2 · 2 lines · 34 B",
      "────────────────────────────────────────────────",
      "   1 127.0.0.1 localhost",
      "   2 ::1 localhost",
      "",
      "",
    ],
  )
}

test fn a_host_image_fills_the_pane_keeping_its_proportions() Void!Str {
  let shown = show_host(
    48,
    8,
    "/Users/me/shot.png",
    fn(file_path: Str, width: Int, height: Int) hostfilebridge::File!Error {
      let pixels = mut List::new<Byte>()
      for index in 1..32 {
        pixels.push(Byte::from(255))
        pixels.push(Byte::from(0))
        pixels.push(Byte::from(0))
        pixels.push(Byte::from(255))
      }
      Result::ok(
        hostfilebridge::File{
          Text: protocol::WorkspaceFileRead{Path: file_path, Size: Int64::from(2048)},
          Image: true,
          MediaType: "image/png",
          Width: 800,
          Height: 400,
          Pixels: attachmentbridge::Pixels{
            Width: 8,
            Height: 4,
            RGBA: pixels.@,
          },
        },
      )
    },
  )
  defer shown.terminal.destroy()
  defer shown.renderer.destroy()
  let shown_rows = rows(shown.terminal)
  try testing::assert(
    shown_rows.at(0).or("") == " /Users/me/shot.png         800 × 400 · 2.0 KiB",
    "the header describes the image: {shown_rows.at(0).or("")}|",
  )
  // Six rows of body: a 2:1 image in cells twice as tall as wide is 24
  // cells wide in six rows, centred in the 48.
  let top_left = shown.terminal.frame().cell(12, 2).expect("image top left")
  let bottom_right = shown.terminal.frame().cell(35, 7).expect("image bottom right")
  try testing::assert(
    top_left.grapheme == "▀" and bottom_right.grapheme == "▀",
    "the image spans 24 cells by 6 rows",
  )
  try testing::assert(
    shown.terminal.frame().cell(11, 2).expect("left of the image").grapheme != "▀",
    "centred: nothing to its left",
  )
  testing::assert(
    shown.terminal.frame().cell(36, 2).expect("right of the image").grapheme != "▀",
    "nor to its right",
  )
}

test fn a_host_file_that_cannot_be_shown_says_why() Void!Str {
  let shown = show_host(
    64,
    5,
    "/bin/ls",
    fn(file_path: Str, width: Int, height: Int) hostfilebridge::File!Error {
      Result::err(Error::new("context canceled"))
    },
  )
  defer shown.terminal.destroy()
  defer shown.renderer.destroy()
  expect_rows(
    rows(shown.terminal),
    [
      " /bin/ls",
      "────────────────────────────────────────────────────────────────",
      "",
      " Load canceled",
      " It loads again when this tab is next shown.",
    ],
  )
}

test fn host_images_fit_their_cells() Void!Str {
  try testing::assert(
    file_pane::image_cells(800, 400, 40, 6).columns == 24,
    "a short pane limits the rows",
  )
  try testing::assert(
    file_pane::image_cells(800, 400, 40, 20).rows == 10,
    "a wide pane limits the columns",
  )
  try testing::assert(file_pane::image_cells(800, 400, 40, 20).columns == 40, "at its full width")
  testing::assert(file_pane::image_cells(1, 1000, 40, 6).columns == 1, "a sliver keeps a cell")
}
