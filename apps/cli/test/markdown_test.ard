use ard/testing

use cooper
use cooper/cui
use cooper/testing as headless
use cooper/theme as ctheme
use cooper/ui
use go:github.com/akonwi/kit/internal/theme as kittheme
use kit/tui/markdown
use kit/tui/theme
use go:strings
use go:time

struct SourceModel {
  source: Str,
}

struct SourceProps {
  model: mut SourceModel,
  themes: theme::Context,
}

struct SourceHost {
  props: mut SourceProps,
}

struct InlineSourceHost {
  props: mut SourceProps,
}

fn source_host(props: mut SourceProps) mut SourceHost {
  (mut SourceHost{props: props})
}

impl cui::Component for SourceHost {
  fn mut render() cui::View {
    markdown::view(self.props.themes, "retained", self.props.model.source)
  }
}

fn inline_source_host(props: mut SourceProps) mut InlineSourceHost {
  (mut InlineSourceHost{props: props})
}

impl cui::Component for InlineSourceHost {
  fn mut render() cui::View {
    markdown::inline_view(self.props.themes, "retained-inline", self.props.model.source)
  }
}

fn mount(source: Str, width: Int, height: Int) headless::TestApp {
  let terminal = headless::new(width, height)
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let _ = cui::mount(
    app,
    markdown::view(theme::context(theme::store(theme::system())), "document", source),
  )
  terminal.flush()
  terminal
}

fn mount_inline(source: Str, width: Int, base: ui::TextStyle?) headless::TestApp {
  let terminal = headless::new(width, 2)
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let _ = cui::mount(
    app,
    markdown::inline_view(
      theme::context(theme::store(theme::system())),
      "inline",
      source,
      base: base,
      semantic: false,
    ),
  )
  terminal.flush()
  terminal
}

fn position(text: Str, needle: Str) [Int] {
  let rows = strings::Split(text, "\n")
  mut found_x = -1
  mut found_y = -1
  mut row = 0
  for value in rows {
    let column = strings::Index(value, needle)
    if found_x < 0 and column >= 0 {
      found_x = column
      found_y = row
    }
    row =+ 1
  }
  [found_x, found_y]
}

fn wait_for_color(terminal: headless::TestApp, needle: Str, expected: ui::Color) Bool {
  mut matched = false
  mut attempts = 0
  while not matched and attempts < 100 {
    terminal.flush()
    let point = position(terminal.frame().text(), needle)
    if point.at(0).or(-1) >= 0 {
      match terminal.frame().cell(point.at(0).or(-1), point.at(1).or(-1)).expect("syntax cell").style.foreground {
        color => {
          matched = color.red == expected.red and color.green == expected.green and color.blue == expected.blue
        },
        _ => (),
      }
    }
    if not matched {
      time::Sleep(time::Millisecond * 5)
    }
    attempts =+ 1
  }
  matched
}

test fn markdown_renders_semantic_blocks_and_inline_attributes() Void!Str {
  let terminal = mount(
    "# Heading\n\nNormal **bold** *italic* ~~gone~~ and `code`.\n\n- first item\n- [x] done\n\n> quoted\n\n```go\nfmt.Println(1)\n```",
    48,
    18,
  )
  defer terminal.destroy()
  let painted = terminal.frame().text()
  for expected in [
    "Heading",
    "Normal bold italic gone and code.",
    "• first item",
    "☑ done",
    "│ quoted",
    "fmt.Println(1)",
  ] {
    try testing::assert(painted.contains(expected), "Markdown output contains {expected}:\n{painted}")
  }
  try testing::assert(not painted.contains("# Heading"), "heading marker is hidden")
  try testing::assert(not painted.contains("**bold**"), "bold markers are hidden")

  let heading = position(painted, "Heading")
  let bold = position(painted, "bold")
  let italic = position(painted, "italic")
  let gone = position(painted, "gone")
  let code = position(painted, "code")
  try testing::assert(
    terminal.frame().cell(heading.at(0).or(-1), heading.at(1).or(-1)).expect("heading").style.bold,
    "heading is bold",
  )
  try testing::assert(
    terminal.frame().cell(bold.at(0).or(-1), bold.at(1).or(-1)).expect("bold").style.bold,
    "strong text is bold",
  )
  try testing::assert(
    terminal.frame().cell(italic.at(0).or(-1), italic.at(1).or(-1)).expect("italic").style.italic,
    "emphasis is italic",
  )
  try testing::assert(
    terminal.frame().cell(gone.at(0).or(-1), gone.at(1).or(-1)).expect("strike").style.strike,
    "deleted text is struck",
  )
  testing::assert(
    terminal.frame().cell(
      code.at(0).or(-1),
      code.at(1).or(-1),
    ).expect("code").style.background.is_some(),
    "inline code has a surface",
  )
}

test fn markdown_uses_hanging_indent_and_aligned_ordered_markers() Void!Str {
  let terminal = mount("9. first item with enough text to wrap at the edge\n10. second", 24, 6)
  defer terminal.destroy()
  let painted = terminal.frame().text()
  try testing::assert(
    painted.contains(" 9. first item"),
    "short ordered marker is right aligned:\n{painted}",
  )
  try testing::assert(painted.contains("10. second"), "wide ordered marker is visible:\n{painted}")
  testing::assert(
    painted.contains("    enough text"),
    "wrapped list content uses a hanging indent:\n{painted}",
  )
}

test fn markdown_reparses_changed_source_in_the_retained_component() Void!Str {
  let terminal = headless::new(24, 3)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let model = mut SourceModel{source: "**first**"}
  let renderer = cui::mount(
    app,
    cui::child(
      source_host,
      SourceProps{model: model, themes: theme::context(theme::store(theme::system()))},
    ),
  )
  defer renderer.destroy()
  terminal.flush()
  try testing::assert(terminal.frame().text().contains("first"), "initial parsed source is visible")
  renderer.update(fn() {
    model.source = "*second*"
  })
  terminal.flush()
  let painted = terminal.frame().text()
  let second = position(painted, "second")
  try testing::assert(
    not painted.contains("first") and painted.contains("second"),
    "changed source replaces cached document",
  )
  testing::assert(
    terminal.frame().cell(
      second.at(0).or(-1),
      second.at(1).or(-1),
    ).expect("updated emphasis").style.italic,
    "changed source is reparsed with semantic styling",
  )
}

test fn fenced_code_uses_renderer_neutral_syntax_roles() Void!Str {
  let terminal = mount("```go\nconst café = \"héllo\"\n```", 48, 4)
  defer terminal.destroy()
  let expected = theme::system().syntax(kittheme::SyntaxKeyword)
  try testing::assert(
    wait_for_color(terminal, "const", expected),
    "fenced Go keyword uses the shared syntax role",
  )
  testing::assert(
    terminal.frame().text().contains("const café = \"héllo\""),
    "byte-range syntax spans preserve Unicode source",
  )
}

test fn fenced_code_source_changes_ignore_stale_highlights() Void!Str {
  let terminal = headless::new(48, 4)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let model = mut SourceModel{source: "```go\nconst old = 1\n```"}
  let themes = theme::context(theme::store(theme::system()))
  let renderer = cui::mount(app, cui::child(source_host, SourceProps{model: model, themes: themes}))
  defer renderer.destroy()
  terminal.flush()
  renderer.update(fn() {
    model.source = "```python\nreturn \"new\"\n```"
  })
  let expected = themes.current().syntax(kittheme::SyntaxKeyword)
  try testing::assert(wait_for_color(terminal, "return", expected), "replacement source is highlighted")
  testing::assert(
    terminal.frame().text().contains("return \"new\"") and not terminal.frame().text().contains("const old"),
    "stale highlight completion cannot restore replaced source",
  )
}

test fn fenced_code_cancels_cleanly_when_unmounted() Void!Str {
  let terminal = headless::new(48, 4)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let renderer = cui::mount(
    app,
    markdown::view(
      theme::context(theme::store(theme::system())),
      "unmounted-code",
      "```typescript\nconst value = \"gone\"\n```",
    ),
  )
  terminal.flush()
  renderer.destroy()
  time::Sleep(time::Millisecond * 20)
  terminal.flush()
  testing::assert(
    not terminal.frame().text().contains("gone"),
    "unmounted code ignores async completion",
  )
}

test fn fenced_code_repaints_user_syntax_overrides() Void!Str {
  let terminal = headless::new(48, 4)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let themes = mut theme::context(theme::store(theme::system()))
  let renderer = cui::mount(
    app,
    markdown::view(themes.@, "themed-code", "```go\nconst value = 1\n```"),
  )
  defer renderer.destroy()
  let original = themes.current().syntax(kittheme::SyntaxKeyword)
  try testing::assert(wait_for_color(terminal, "const", original), "initial syntax result arrives")

  let syntax = mut Map::new<kittheme::Color>()
  syntax.set(
    kittheme::SyntaxKeyword,
    kittheme::Color{
      R: 17,
      G: 29,
      B: 211,
      A: 255,
    },
  )
  let resolved = theme::resolve(kittheme::Definition{SyntaxPalette: syntax.@}, ctheme::default())
  let expected = resolved.syntax(kittheme::SyntaxKeyword)
  renderer.update(fn() {
    themes.replace(resolved)
  })
  terminal.flush()
  testing::assert(
    wait_for_color(terminal, "const", expected),
    "cached syntax roles repaint from the user theme without changing source",
  )
}

test fn markdown_links_show_labels_and_only_activate_safe_targets() Void!Str {
  let terminal = mount("[docs](https://example.com/path) and [private](file:///tmp/private)", 48, 3)
  defer terminal.destroy()
  let painted = terminal.frame().text()
  try testing::assert(painted.contains("docs and private"), "links show labels only: {painted}")
  let docs = position(painted, "docs")
  let private_link = position(painted, "private")
  let safe = terminal.frame().cell(docs.at(0).or(-1), docs.at(1).or(-1)).expect("safe link")
  let plain = terminal.frame().cell(
    private_link.at(0).or(-1),
    private_link.at(1).or(-1),
  ).expect("unsafe link")
  try testing::assert(
    safe.hyperlink.or("") == "https://example.com/path" and safe.style.underline,
    "safe link retains OSC 8 metadata",
  )
  testing::assert(
    plain.hyperlink.is_none() and not plain.style.underline,
    "unsafe link is plain text",
  )
}

test fn markdown_table_renders_natural_grid_alignment_bands_and_contiguous_header_rule() Void!Str {
  let terminal = mount(
    "| Name | Qty | Link |\n| :--- | ---: | :---: |\n| café | 2 | [docs](https://example.com) |\n| 你 | 11 | plain |",
    32,
    6,
  )
  defer terminal.destroy()
  let rows = strings::Split(terminal.frame().text(), "\n")
  try testing::assert(
    rows.at(0).or("").starts_with("Name  Qty  Link "),
    "header uses shared natural column widths",
  )
  try testing::assert(
    rows.at(1).or("").starts_with("────────────────"),
    "header divider is contiguous across the complete grid",
  )
  try testing::assert(
    rows.at(2).or("").starts_with("café    2  docs "),
    "right and center alignment are padded",
  )
  try testing::assert(
    rows.at(3).or("").starts_with("你     11  plain"),
    "wide glyphs use display-cell widths",
  )

  try testing::assert(
    terminal.frame().cell(0, 0).expect("header text").style.bold,
    "table headers are bold",
  )
  let body_style = terminal.frame().cell(0, 2).expect("body text").style
  try testing::assert(not body_style.bold, "ordinary table body text is not bold")
  let expected_text = theme::system().foreground
  let body_text = body_style.foreground.expect("body foreground")
  try testing::assert(
    body_text.red == expected_text.red and body_text.green == expected_text.green and body_text.blue == expected_text.blue,
    "body rows use normal transcript text rather than muted text",
  )
  let band = terminal.frame().cell(
    4,
    2,
  ).expect("band gap").style.background.expect("band background")
  let expected_band = theme::system().surface
  try testing::assert(
    band.red == expected_band.red and band.green == expected_band.green and band.blue == expected_band.blue,
    "first body row paints one contiguous semantic band",
  )
  let docs = terminal.frame().cell(11, 2).expect("table link")
  testing::assert(
    docs.hyperlink.or("") == "https://example.com" and docs.style.underline,
    "table links retain safe OSC 8 metadata",
  )
}

test fn markdown_table_scrolls_horizontally_with_pointer_input_and_survives_resize() Void!Str {
  let terminal = mount(
    "| Name | Description |\n| --- | --- |\n| parser | renderer-neutral semantic blocks |",
    14,
    5,
  )
  defer terminal.destroy()
  let initial = terminal.frame().text()
  try testing::assert(
    initial.contains("Name    Descri"),
    "narrow grid begins at its natural left edge: {initial}",
  )

  mut attempts = 0
  while attempts < 10 {
    terminal.scroll(2, 2, 0, delta_x: 1)
    terminal.flush()
    attempts =+ 1
  }
  let shifted = terminal.frame().text()
  try testing::assert(
    shifted.contains("emantic blocks"),
    "horizontal pointer scrolling reveals trailing columns: {shifted}",
  )

  terminal.resize(42, 5)
  terminal.flush()
  let resized = terminal.frame().text()
  testing::assert(
    resized.contains("parser  renderer-neutral semantic blocks"),
    "resizing wider keeps the complete natural grid accessible: {resized}",
  )
}

test fn markdown_table_selection_exposes_the_entire_table_as_tsv() Void!Str {
  let terminal = mount("| Name | Count |\n| --- | ---: |\n| parser | 12 |\n\nAfter table", 32, 8)
  defer terminal.destroy()
  terminal.drag(0, 0, 2, 2)
  terminal.flush()
  let local = terminal.selection().expect("table selection")
  try testing::assert(
    local.copy_text.or("") == "Name\tCount\nparser\t12",
    "a table-local selection supplies the complete semantic TSV payload",
  )

  terminal.drag(0, 0, 2, 4)
  terminal.flush()
  let mixed = terminal.selection().expect("mixed selection")
  try testing::assert(
    mixed.copy_text.is_none(),
    "a mixed table and prose selection keeps ordinary painted-text copying",
  )
  testing::assert(
    mixed.selected_text.contains("Name    Count") and mixed.selected_text.contains("parser     12"),
    "painted fallback copying preserves visible column gaps: {mixed.selected_text}",
  )
}

test fn inline_markdown_renders_activity_emphasis_without_markers() Void!Str {
  let colors = theme::system()
  let terminal = mount_inline(
    "Checking **retries** and *status*",
    48,
    ui::text_style(foreground: colors.muted),
  )
  defer terminal.destroy()
  let painted = terminal.frame().text()
  try testing::assert(
    painted.contains("Checking retries and status") and not painted.contains("**") and not painted.contains("*status*"),
    "inline activity renders Markdown without source markers: {painted}",
  )
  let retries = position(painted, "retries")
  let status = position(painted, "status")
  try testing::assert(
    terminal.frame().cell(
      retries.at(0).or(-1),
      retries.at(1).or(-1),
    ).expect("strong activity").style.bold,
    "strong activity text is bold",
  )
  let status_style = terminal.frame().cell(
    status.at(0).or(-1),
    status.at(1).or(-1),
  ).expect("emphasized activity").style
  let muted = status_style.foreground.expect("muted activity foreground")
  testing::assert(
    status_style.italic and muted.red == colors.muted.red and muted.green == colors.muted.green and muted.blue == colors.muted.blue,
    "activity emphasis retains the muted base tone",
  )
}

test fn inline_markdown_preserves_an_italic_thinking_base_and_one_row_overflow() Void!Str {
  let colors = theme::system()
  let terminal = mount_inline(
    "Plain **strong** thinking that extends well beyond the slot",
    18,
    ui::text_style(foreground: colors.muted, italic: true),
  )
  defer terminal.destroy()
  let painted = terminal.frame().text()
  let plain = position(painted, "Plain")
  let strong = position(painted, "strong")
  try testing::assert(
    terminal.frame().cell(
      plain.at(0).or(-1),
      plain.at(1).or(-1),
    ).expect("plain thinking").style.italic,
    "plain Markdown runs preserve an italic thinking base",
  )
  let strong_style = terminal.frame().cell(
    strong.at(0).or(-1),
    strong.at(1).or(-1),
  ).expect("strong thinking").style
  try testing::assert(
    strong_style.italic and strong_style.bold,
    "strong thinking composes with the italic base",
  )
  testing::assert(
    strings::Split(painted, "\n").at(1).or("") == "                  ",
    "inline Markdown stays in one clipped row: {painted}",
  )
}

test fn inline_markdown_keeps_compact_block_markers() Void!Str {
  for example in [
    ["- checking files", "• checking files"],
    ["3. retrying", "3. retrying"],
    ["- [x] verified", "☑ verified"],
    ["> note", "│ note"],
  ] {
    let source = example.at(0).or("")
    let expected = example.at(1).or("")
    let terminal = mount_inline(source, 30, Maybe::new<ui::TextStyle>())
    let painted = terminal.frame().text()
    terminal.destroy()
    try testing::assert(
      painted.contains(expected),
      "inline Markdown keeps the compact marker for {source}: {painted}",
    )
  }
  testing::pass()
}

test fn inline_markdown_reparses_changed_source_in_the_retained_component() Void!Str {
  let terminal = headless::new(32, 2)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let model = mut SourceModel{source: "**first** activity"}
  let themes = theme::context(theme::store(theme::system()))
  let renderer = cui::mount(
    app,
    cui::child(inline_source_host, SourceProps{model: model, themes: themes}),
  )
  defer renderer.destroy()
  terminal.flush()
  let first = position(terminal.frame().text(), "first")
  try testing::assert(
    terminal.frame().cell(first.at(0).or(-1), first.at(1).or(-1)).expect("first activity").style.bold,
    "initial retained activity is rendered",
  )

  renderer.update(fn() {
    model.source = "*second* activity"
  })
  terminal.flush()
  let painted = terminal.frame().text()
  let second = position(painted, "second")
  try testing::assert(
    painted.contains("second activity") and not painted.contains("first"),
    "changed activity replaces the retained inline source: {painted}",
  )
  testing::assert(
    terminal.frame().cell(
      second.at(0).or(-1),
      second.at(1).or(-1),
    ).expect("second activity").style.italic,
    "changed inline activity is reparsed",
  )
}
