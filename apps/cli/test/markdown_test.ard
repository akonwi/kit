use ard/testing

use cooper
use cooper/cui
use cooper/testing as headless
use cooper/theme as ctheme
use cooper/ui
use go:github.com/akonwi/kit/internal/theme as kittheme
use kit/tui/markdown
use kit/tui/theme
use go:strings
use go:time

struct SourceModel {
  source: Str,
}

struct SourceProps {
  model: mut SourceModel,
  themes: theme::Context,
}

struct SourceHost {
  props: mut SourceProps,
}

fn source_host(props: mut SourceProps) mut SourceHost {
  (mut SourceHost{props: props})
}

impl cui::Component for SourceHost {
  fn mut render() cui::View {
    markdown::view(self.props.themes, "retained", self.props.model.source)
  }
}

fn mount(source: Str, width: Int, height: Int) headless::TestApp {
  let terminal = headless::new(width, height)
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let _ = cui::mount(
    app,
    markdown::view(theme::context(theme::store(theme::system())), "document", source),
  )
  terminal.flush()
  terminal
}

fn position(text: Str, needle: Str) [Int] {
  let rows = strings::Split(text, "\n")
  mut found_x = -1
  mut found_y = -1
  mut row = 0
  for value in rows {
    let column = strings::Index(value, needle)
    if found_x < 0 and column >= 0 {
      found_x = column
      found_y = row
    }
    row =+ 1
  }
  [found_x, found_y]
}

fn wait_for_color(terminal: headless::TestApp, needle: Str, expected: ui::Color) Bool {
  mut matched = false
  mut attempts = 0
  while not matched and attempts < 100 {
    terminal.flush()
    let point = position(terminal.frame().text(), needle)
    if point.at(0).or(-1) >= 0 {
      match terminal.frame().cell(point.at(0).or(-1), point.at(1).or(-1)).expect("syntax cell").style.foreground {
        color => {
          matched = color.red == expected.red and color.green == expected.green and color.blue == expected.blue
        },
        _ => (),
      }
    }
    if not matched {
      time::Sleep(time::Millisecond * 5)
    }
    attempts =+ 1
  }
  matched
}

test fn markdown_renders_semantic_blocks_and_inline_attributes() Void!Str {
  let terminal = mount(
    "# Heading\n\nNormal **bold** *italic* ~~gone~~ and `code`.\n\n- first item\n- [x] done\n\n> quoted\n\n```go\nfmt.Println(1)\n```",
    48,
    18,
  )
  defer terminal.destroy()
  let painted = terminal.frame().text()
  for expected in [
    "Heading",
    "Normal bold italic gone and code.",
    "• first item",
    "☑ done",
    "│ quoted",
    "fmt.Println(1)",
  ] {
    try testing::assert(painted.contains(expected), "Markdown output contains {expected}:\n{painted}")
  }
  try testing::assert(not painted.contains("# Heading"), "heading marker is hidden")
  try testing::assert(not painted.contains("**bold**"), "bold markers are hidden")

  let heading = position(painted, "Heading")
  let bold = position(painted, "bold")
  let italic = position(painted, "italic")
  let gone = position(painted, "gone")
  let code = position(painted, "code")
  try testing::assert(
    terminal.frame().cell(heading.at(0).or(-1), heading.at(1).or(-1)).expect("heading").style.bold,
    "heading is bold",
  )
  try testing::assert(
    terminal.frame().cell(bold.at(0).or(-1), bold.at(1).or(-1)).expect("bold").style.bold,
    "strong text is bold",
  )
  try testing::assert(
    terminal.frame().cell(italic.at(0).or(-1), italic.at(1).or(-1)).expect("italic").style.italic,
    "emphasis is italic",
  )
  try testing::assert(
    terminal.frame().cell(gone.at(0).or(-1), gone.at(1).or(-1)).expect("strike").style.strike,
    "deleted text is struck",
  )
  testing::assert(
    terminal.frame().cell(
      code.at(0).or(-1),
      code.at(1).or(-1),
    ).expect("code").style.background.is_some(),
    "inline code has a surface",
  )
}

test fn markdown_uses_hanging_indent_and_aligned_ordered_markers() Void!Str {
  let terminal = mount("9. first item with enough text to wrap at the edge\n10. second", 24, 6)
  defer terminal.destroy()
  let painted = terminal.frame().text()
  try testing::assert(
    painted.contains(" 9. first item"),
    "short ordered marker is right aligned:\n{painted}",
  )
  try testing::assert(painted.contains("10. second"), "wide ordered marker is visible:\n{painted}")
  testing::assert(
    painted.contains("    enough text"),
    "wrapped list content uses a hanging indent:\n{painted}",
  )
}

test fn markdown_reparses_changed_source_in_the_retained_component() Void!Str {
  let terminal = headless::new(24, 3)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let model = mut SourceModel{source: "**first**"}
  let renderer = cui::mount(
    app,
    cui::child(
      source_host,
      SourceProps{model: model, themes: theme::context(theme::store(theme::system()))},
    ),
  )
  defer renderer.destroy()
  terminal.flush()
  try testing::assert(terminal.frame().text().contains("first"), "initial parsed source is visible")
  renderer.update(fn() {
    model.source = "*second*"
  })
  terminal.flush()
  let painted = terminal.frame().text()
  let second = position(painted, "second")
  try testing::assert(
    not painted.contains("first") and painted.contains("second"),
    "changed source replaces cached document",
  )
  testing::assert(
    terminal.frame().cell(
      second.at(0).or(-1),
      second.at(1).or(-1),
    ).expect("updated emphasis").style.italic,
    "changed source is reparsed with semantic styling",
  )
}

test fn fenced_code_uses_renderer_neutral_syntax_roles() Void!Str {
  let terminal = mount("```go\nconst café = \"héllo\"\n```", 48, 4)
  defer terminal.destroy()
  let expected = theme::system().syntax(kittheme::SyntaxKeyword)
  try testing::assert(
    wait_for_color(terminal, "const", expected),
    "fenced Go keyword uses the shared syntax role",
  )
  testing::assert(
    terminal.frame().text().contains("const café = \"héllo\""),
    "byte-range syntax spans preserve Unicode source",
  )
}

test fn fenced_code_source_changes_ignore_stale_highlights() Void!Str {
  let terminal = headless::new(48, 4)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let model = mut SourceModel{source: "```go\nconst old = 1\n```"}
  let themes = theme::context(theme::store(theme::system()))
  let renderer = cui::mount(app, cui::child(source_host, SourceProps{model: model, themes: themes}))
  defer renderer.destroy()
  terminal.flush()
  renderer.update(fn() {
    model.source = "```python\nreturn \"new\"\n```"
  })
  let expected = themes.current().syntax(kittheme::SyntaxKeyword)
  try testing::assert(wait_for_color(terminal, "return", expected), "replacement source is highlighted")
  testing::assert(
    terminal.frame().text().contains("return \"new\"") and not terminal.frame().text().contains("const old"),
    "stale highlight completion cannot restore replaced source",
  )
}

test fn fenced_code_cancels_cleanly_when_unmounted() Void!Str {
  let terminal = headless::new(48, 4)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let renderer = cui::mount(
    app,
    markdown::view(
      theme::context(theme::store(theme::system())),
      "unmounted-code",
      "```typescript\nconst value = \"gone\"\n```",
    ),
  )
  terminal.flush()
  renderer.destroy()
  time::Sleep(time::Millisecond * 20)
  terminal.flush()
  testing::assert(
    not terminal.frame().text().contains("gone"),
    "unmounted code ignores async completion",
  )
}

test fn fenced_code_repaints_user_syntax_overrides() Void!Str {
  let terminal = headless::new(48, 4)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let themes = mut theme::context(theme::store(theme::system()))
  let renderer = cui::mount(
    app,
    markdown::view(themes.@, "themed-code", "```go\nconst value = 1\n```"),
  )
  defer renderer.destroy()
  let original = themes.current().syntax(kittheme::SyntaxKeyword)
  try testing::assert(wait_for_color(terminal, "const", original), "initial syntax result arrives")

  let syntax = mut Map::new<kittheme::Color>()
  syntax.set(
    kittheme::SyntaxKeyword,
    kittheme::Color{
      R: 17,
      G: 29,
      B: 211,
      A: 255,
    },
  )
  let resolved = theme::resolve(kittheme::Definition{SyntaxPalette: syntax.@}, ctheme::default())
  let expected = resolved.syntax(kittheme::SyntaxKeyword)
  renderer.update(fn() {
    themes.replace(resolved)
  })
  terminal.flush()
  testing::assert(
    wait_for_color(terminal, "const", expected),
    "cached syntax roles repaint from the user theme without changing source",
  )
}

test fn markdown_links_show_labels_and_only_activate_safe_targets() Void!Str {
  let terminal = mount("[docs](https://example.com/path) and [private](file:///tmp/private)", 48, 3)
  defer terminal.destroy()
  let painted = terminal.frame().text()
  try testing::assert(painted.contains("docs and private"), "links show labels only: {painted}")
  let docs = position(painted, "docs")
  let private_link = position(painted, "private")
  let safe = terminal.frame().cell(docs.at(0).or(-1), docs.at(1).or(-1)).expect("safe link")
  let plain = terminal.frame().cell(
    private_link.at(0).or(-1),
    private_link.at(1).or(-1),
  ).expect("unsafe link")
  try testing::assert(
    safe.hyperlink.or("") == "https://example.com/path" and safe.style.underline,
    "safe link retains OSC 8 metadata",
  )
  testing::assert(
    plain.hyperlink.is_none() and not plain.style.underline,
    "unsafe link is plain text",
  )
}
