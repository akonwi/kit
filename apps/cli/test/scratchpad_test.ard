use ard/testing

use go:api/contract as protocol
use cooper
use cooper/cui
use cooper/event
use cooper/testing as headless
use cooper/ui
use kit/tui/scratchpad
use kit/tui/theme
use go:strings

struct Model {
  record: protocol::Scratchpad?,
  loading: Bool,
  failure: Str,
  retries: Int,
  other: Str,
}

struct Props {
  model: mut Model,
  themes: theme::Context,
}

struct Host {
  props: mut Props,
}

fn host(props: mut Props) mut Host {
  (mut Host{props: props})
}

impl cui::Component for Host {
  fn mut render() cui::View {
    let model = self.props.model
    cui::box(
      [
        scratchpad::pane(
          scratchpad::Props{
            themes: self.props.themes,
            record: model.record,
            loading: model.loading,
            failure: model.failure,
            retry: fn() Bool {
              model.retries =+ 1
              true
            },
          },
        ),
        cui::input(
          model.other,
          key: "other-input",
          styles: ui::style(flex_shrink: 0.0),
          autofocus: true,
          on_input: fn(value: Str, context: cui::Context) {
            model.other = value
          },
        ),
      ],
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        flex_direction: ui::FlexDirection::column,
      ),
    )
  }
}

fn character(value: Str) mut event::KeyEvent {
  event::key(
    value,
    value,
    event::KeyEventType::press,
    event::Modifiers{
      shift: false,
      ctrl: false,
      alt: false,
      super: false,
    },
  )
}

fn mount(terminal: headless::TestApp, model: mut Model) cui::Renderer {
  cui::mount(
    cooper::App{context: terminal.context, root: terminal.root},
    cui::child(host, Props{model: model, themes: theme::context(theme::store(theme::system()))}),
  )
}

test fn scratchpad_is_a_selectable_read_only_document() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let model = mut Model{
    record: Maybe::new(protocol::Scratchpad{Content: "shared notes"}),
    loading: false,
    failure: "",
    retries: 0,
    other: "",
  }
  let renderer = mount(terminal, model)
  defer renderer.destroy()
  terminal.flush()

  try testing::assert(strings::Contains(terminal.frame().text(), "shared notes"), "content is visible")
  testing::assert(
    strings::Contains(terminal.frame().text(), "Read-only"),
    "the surface identifies its read-only behavior",
  )
}

test fn scratchpad_does_not_reclaim_focus_from_the_composer() Void!Str {
  let terminal = headless::new(48, 8)
  defer terminal.destroy()
  let model = mut Model{
    record: Maybe::new(protocol::Scratchpad{Content: "shared notes"}),
    loading: false,
    failure: "",
    retries: 0,
    other: "",
  }
  let renderer = mount(terminal, model)
  defer renderer.destroy()
  terminal.flush()

  terminal.key(character("a"))
  terminal.flush()
  terminal.key(character("b"))
  terminal.flush()

  testing::assert(model.other == "ab", "the composer keeps keyboard focus: {model.other}")
}

test fn scratchpad_loading_state_is_explicit() Void!Str {
  let terminal = headless::new(72, 8)
  defer terminal.destroy()
  let model = mut Model{
    record: Maybe::new<protocol::Scratchpad>(),
    loading: true,
    failure: "",
    retries: 0,
    other: "",
  }
  let renderer = mount(terminal, model)
  defer renderer.destroy()
  terminal.flush()
  testing::assert(
    strings::Contains(terminal.frame().text(), "Loading scratchpad"),
    "loading is visible",
  )
}

test fn scratchpad_failure_invokes_retry() Void!Str {
  let terminal = headless::new(72, 8)
  defer terminal.destroy()
  let model = mut Model{
    record: Maybe::new<protocol::Scratchpad>(),
    loading: false,
    failure: "temporarily unavailable",
    retries: 0,
    other: "",
  }
  let renderer = mount(terminal, model)
  defer renderer.destroy()
  terminal.flush()
  try testing::assert(strings::Contains(terminal.frame().text(), "Load failed"), "failure is visible")
  terminal.mouse_move(1, 1)
  terminal.mouse_down(1, 1)
  terminal.mouse_up(1, 1)
  terminal.flush()
  testing::assert(model.retries == 1, "the failure surface invokes retry")
}
