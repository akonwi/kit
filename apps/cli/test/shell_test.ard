use ard/testing

use go:context
use cooper
use cooper/cui
use cooper/event
use cooper/terminal_progress
use cooper/testing as headless
use go:kit/ffi/cli
use kit/tui/bootstrap
use kit/tui/chrome
use kit/tui/shell
use kit/tui/terminal_status
use kit/tui/theme
use go:strings
use go:time

fn modifiers(ctrl: Bool) event::Modifiers {
  event::Modifiers{
    shift: false,
    ctrl: ctrl,
    alt: false,
    super: false,
  }
}

fn ctrl(name: Str) mut event::KeyEvent {
  event::key(name, "", event::KeyEventType::press, modifiers(true))
}

fn key(name: Str) mut event::KeyEvent {
  event::key(name, "", event::KeyEventType::press, modifiers(false))
}

struct Quits {
  count: Int,
}

fn rows(terminal: headless::TestApp) [Str] {
  let trimmed = mut List::new<Str>()
  for row in strings::Split(terminal.frame().text(), "\n") {
    trimmed.push(strings::TrimRight(row, " "))
  }
  trimmed.@
}

fn expect_rows(actual: [Str], expected: [Str]) Void!Str {
  let shown = strings::Join(mut actual, "|\n")
  try testing::assert(actual.size() == expected.size(), "row count {actual.size()}:\n{shown}|")
  mut index = 0
  while index < expected.size() {
    let want = expected.at(index).or("")
    let got = actual.at(index).or("")
    try testing::assert(got == want, "row {index}: got {got}|, want {want}|\n{shown}|")
    index =+ 1
  }
  testing::pass()
}

fn mount_signed_out(terminal: headless::TestApp, quits: mut Quits) cui::Renderer {
  mount(terminal, quits, false, Chan::new<Int>(8))
}

// Mounts the shell. Each start attempt reports on `attempts` and fails the
// way an unreachable server does.
fn mount(terminal: headless::TestApp, quits: mut Quits, authenticated: Bool, attempts: Chan<Int>) cui::Renderer {
  let props = shell::Props{
    options: cli::TUIOptions{
      Context: context::Background(),
      CWD: "/private/tmp",
      Location: "/private/tmp",
      Authenticated: authenticated,
    },
    themes: theme::context(theme::store(theme::system())),
    quit: fn() {
      quits.count =+ 1
    },
    attach: fn(ctx: context::Context, options: cli::TUIOptions) bootstrap::Attached!Str {
      attempts.send(1)
      Result::err("list sessions: connection refused")
    },
    terminal: terminal_status::Terminal{
      set_title: fn(value: Str) Bool {
        terminal.context.set_title(value)
      },
      progress: fn(state: terminal_progress::State) Bool {
        terminal.context.progress(state, Maybe::new<Int>())
      },
    },
    open_url: fn(target: Str) Void!Error {
      Result::ok(())
    },
  }
  let app = cooper::App{context: terminal.context, root: terminal.root}
  cui::mount(app, cui::child(shell::new, props))
}

// Waits for the next start attempt, then for its failure to render.
fn await_attempt(terminal: headless::TestApp, attempts: Chan<Int>) Void!Str {
  mut attempted = false
  select {
    attempts.recv() => { attempted = true },
    time::After(2 * time::Second).recv() => (),
  }
  try testing::assert(attempted, "a start attempt was made")
  mut tries = 0
  while not terminal.frame().text().contains("Kit could not start") and tries < 100 {
    time::Sleep(5 * time::Millisecond)
    terminal.flush()
    tries =+ 1
  }
  testing::pass()
}

test fn signed_out_shell_matches_the_vaxis_layout() Void!Str {
  let terminal = headless::new(60, 12)
  defer terminal.destroy()
  let quits = mut Quits{count: 0}
  let renderer = mount_signed_out(terminal, quits)
  defer renderer.destroy()
  terminal.flush()
  // Odd-width centered rows sit one cell right of the vaxis client: Cooper
  // rounds half-cell edges up (Cooper ADR 0020) where vaxis floors them.
  expect_rows(
    rows(terminal),
    [
      " kit",
      "────────────────────────────────────────────────────────────",
      "",
      "                            k i t",
      "                         ━━━━━━━━━━━",
      "",
      "           Connect an AI provider to get started.",
      "",
      "                     Connect a provider",
      "",
      "────────────────────────────────────────────────────────────",
      "                                               /private/tmp",
    ],
  )
}

test fn the_terminal_title_names_the_startup_directory_before_a_session() Void!Str {
  let terminal = headless::new(60, 12)
  defer terminal.destroy()
  let quits = mut Quits{count: 0}
  let renderer = mount_signed_out(terminal, quits)
  defer renderer.destroy()
  terminal.flush()
  let titles = terminal.terminal_titles()
  try testing::assert(
    titles.size() == 1 and titles.at(0).or("") == "kit - tmp",
    "titles: {strings::Join(mut titles, " | ")}",
  )
  let progress = terminal.terminal_progress_reports()
  testing::assert(
    progress.size() == 1 and progress.at(0).expect("progress").state == terminal_progress::State::remove,
    "{progress.size()} progress reports",
  )
}

test fn signed_out_connect_opens_and_esc_closes_the_provider_modal() Void!Str {
  let terminal = headless::new(60, 32)
  defer terminal.destroy()
  let quits = mut Quits{count: 0}
  let renderer = mount_signed_out(terminal, quits)
  defer renderer.destroy()
  terminal.flush()

  // The initial action takes focus, so Return is equivalent to activating its
  // visible Connect button without a separate screen-level key binding.
  terminal.key(key("return"))
  terminal.flush()
  try testing::assert(
    terminal.frame().text().contains("OpenAI Codex"),
    "Connect action opens the provider modal",
  )
  let rendered = rows(terminal)
  // The search field's text sits in the label column, one cell past the
  // gutter, as in the vaxis picker search field.
  mut search_column = -1
  mut search_row = -1
  for row, index in rendered {
    if row.contains("Search providers") {
      search_row = index
      mut column = 0
      for character in strings::Split(row, "") {
        if character != " " {
          search_column = column
          break
        }
        column =+ 1
      }
    }
  }
  mut label_column = -1
  mut codex_row = -1
  for row, index in rendered {
    if row.contains("OpenAI Codex") {
      codex_row = index
      mut column = 0
      for character in strings::Split(row, "") {
        if character != " " and character != "▌" {
          label_column = column
          break
        }
        column =+ 1
      }
    }
  }
  try testing::assert(
    search_row >= 0 and codex_row == search_row + 2,
    "the search field sits one divider row above the provider rows",
  )
  try testing::assert(
    search_column == label_column,
    "search text aligns with item labels: search column {search_column}, label column {label_column}",
  )
  // With no hint footer, the body ends at the bottom border without a
  // divider, and no fundamental-primitive hints are shown.
  mut shows_hint_footer = false
  for row in rendered {
    if row.contains("esc close") or row.contains("Esc close") {
      shows_hint_footer = true
    }
  }
  try testing::assert(not shows_hint_footer, "intuitive primitives are not shown as footer hints")
  terminal.key(key("escape"))
  terminal.flush()
  try testing::assert(
    not terminal.frame().text().contains("OpenAI Codex"),
    "Escape closes the provider modal",
  )
  // Dismissal restores the signed-out action rather than leaving focus in an
  // unmounted dialog.
  terminal.key(key("return"))
  terminal.flush()
  testing::assert(
    terminal.frame().text().contains("OpenAI Codex"),
    "Dismissal restores focus to Connect a provider",
  )
}

test fn provider_picker_centers_after_its_width_cap() Void!Str {
  let terminal = headless::new(140, 32)
  defer terminal.destroy()
  let quits = mut Quits{count: 0}
  let renderer = mount_signed_out(terminal, quits)
  defer renderer.destroy()
  terminal.flush()
  terminal.key(key("return"))
  terminal.flush()

  mut left = -1
  for row in rows(terminal) {
    let candidate = strings::Index(row, "┌")
    if candidate >= 0 {
      left = candidate
    }
  }
  // The capped 96-cell picker centers in a 140-cell viewport.
  testing::assert(left == 22, "picker left border {left}, want 22")
}

test fn a_failed_start_explains_the_error_and_r_retries() Void!Str {
  let terminal = headless::new(60, 12)
  defer terminal.destroy()
  let quits = mut Quits{count: 0}
  let attempts = Chan::new<Int>(8)
  let renderer = mount(terminal, quits, true, attempts)
  defer renderer.destroy()
  terminal.flush()
  try await_attempt(terminal, attempts)
  let failed = [
    " kit",
    "────────────────────────────────────────────────────────────",
    "",
    "",
    "                     Kit could not start",
    "",
    "              list sessions: connection refused",
    "",
    "                    r retry · ctrl+c quit",
    "",
    "────────────────────────────────────────────────────────────",
    "                                               /private/tmp",
  ]
  try expect_rows(rows(terminal), failed)

  terminal.key(key("r"))
  terminal.flush()
  try await_attempt(terminal, attempts)
  try expect_rows(rows(terminal), failed)
  testing::assert(quits.count == 0, "retrying does not quit")
}

test fn ctrl_c_quits_when_there_is_no_draft() Void!Str {
  let terminal = headless::new(60, 12)
  defer terminal.destroy()
  let quits = mut Quits{count: 0}
  let renderer = mount_signed_out(terminal, quits)
  defer renderer.destroy()
  terminal.flush()
  terminal.key(ctrl("c"))
  terminal.flush()
  try testing::assert(quits.count == 1, "Ctrl+C quit {quits.count} times")
  testing::assert(
    not terminal.frame().text().contains("OpenAI Codex"),
    "Ctrl+C does not activate the focused Connect button",
  )
}

test fn pending_activity_renders_markdown_in_one_muted_row() Void!Str {
  let terminal = headless::new(20, 3)
  defer terminal.destroy()
  let themes = theme::context(theme::store(theme::system()))
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let renderer = cui::mount(
    app,
    chrome::pending_activity(themes, "**Checking** a very long activity status"),
  )
  defer renderer.destroy()
  terminal.flush()
  let painted = terminal.frame().text()
  let checking = strings::Index(rows(terminal).at(0).or(""), "Checking")
  try testing::assert(
    painted.contains("Checking") and not painted.contains("**Checking**"),
    "pending activity renders Markdown markers: {painted}",
  )
  let style = terminal.frame().cell(checking, 0).expect("pending activity text").style
  let foreground = style.foreground.expect("pending activity foreground")
  let muted = themes.current().muted
  try testing::assert(style.bold, "pending activity preserves strong emphasis")
  try testing::assert(
    foreground.red == muted.red and foreground.green == muted.green and foreground.blue == muted.blue,
    "pending activity remains muted",
  )
  testing::assert(
    strings::TrimSpace(rows(terminal).at(1).or("")) == "",
    "long pending Markdown stays in one row: {painted}",
  )
}
