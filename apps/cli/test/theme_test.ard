use ard/testing

use cooper/theme as ctheme
use cooper/ui
use go:github.com/akonwi/kit/internal/theme as kittheme
use kit/tui/theme

// Expected values follow the vaxis client's theme adapter: Kit's linear wash
// for user turns (tintUIColor) and its token projection (projectColor).

fn dark() ctheme::Theme {
  ctheme::from_terminal(
    ctheme::TerminalColors{
      foreground: Maybe::new(ui::rgb(216, 222, 233)),
      background: Maybe::new(ui::rgb(40, 44, 52)),
      palette: [
        Maybe::new<ui::Color>(),
        Maybe::new(ui::rgb(224, 108, 117)),
        Maybe::new(ui::rgb(152, 195, 121)),
        Maybe::new(ui::rgb(229, 192, 123)),
        Maybe::new(ui::rgb(97, 175, 239)),
        Maybe::new(ui::rgb(198, 120, 221)),
        Maybe::new(ui::rgb(86, 182, 194)),
        Maybe::new<ui::Color>(),
      ],
    },
  )
}

fn check(name: Str, got: ui::Color, want: ui::Color) Void!Str {
  testing::assert(
    got.red == want.red and got.green == want.green and got.blue == want.blue and got.terminal_default == want.terminal_default,
    "{name}: got rgb({got.red}, {got.green}, {got.blue}) default={got.terminal_default}, want rgb({want.red}, {want.green}, {want.blue}) default={want.terminal_default}",
  )
}

test fn the_system_theme_paints_terminal_defaults_and_derived_tones() Void!Str {
  let colors = theme::resolve(kittheme::Definition{}, dark())
  try check("background", colors.background, ui::terminal_default())
  try check("foreground", colors.foreground, ui::terminal_default())
  try check("border", colors.border, ui::rgb(96, 101, 110))
  try check("muted", colors.muted, ui::rgb(122, 127, 137))
  try check("disabled", colors.disabled, ui::rgb(96, 101, 110))
  try check("primary_text", colors.primary_text, ui::rgb(118, 187, 245))
  try check("surface", colors.surface, ui::rgb(47, 52, 60))
  try check("surface_raised", colors.surface_raised, ui::rgb(58, 63, 71))
  try check("surface_hovered", colors.surface_hovered, ui::rgb(58, 63, 71))
  try check("surface_pressed", colors.surface_pressed, ui::rgb(40, 44, 52))
  // 18% of the primary text color over the surface in a dark theme.
  check("user_fill", colors.user_fill, ui::rgb(60, 76, 93))
}

test fn translucent_tokens_blend_over_the_background() Void!Str {
  let tokens = mut Map::new<kittheme::Color>()
  tokens.set(
    kittheme::TokenBorderDefault,
    kittheme::Color{
      R: 255,
      G: 255,
      B: 255,
      A: 128,
    },
  )
  tokens.set(
    kittheme::TokenTextMuted,
    kittheme::Color{
      R: 10,
      G: 20,
      B: 30,
      A: 255,
    },
  )
  let colors = theme::resolve(kittheme::Definition{Tokens: tokens.@}, dark())
  try check("border", colors.border, ui::rgb(148, 150, 154))
  try check("muted", colors.muted, ui::rgb(10, 20, 30))
  check("disabled", colors.disabled, ui::rgb(96, 101, 110))
}
