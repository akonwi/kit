  let painted = "   " + strings::Repeat("▀", 33)
  try testing::assert(
    image_rows.at(5).or("") == painted and image_rows.at(12).or("") == painted and image_rows.at(4).or("") == "" and image_rows.at(13).or("") == "",
    "a 2:1 image narrowed to the wash keeps its shape, centred in the reserved rows:\n{strings::Join(mut image_rows, "|\n")}",
  )
  try testing::assert(
    terminal.frame().text().contains("📎 other.png"),
    "loading does not move the next row",
  )

  terminal.click(4, 8)
  terminal.flush()
  terminal.click(8, 15)
  terminal.flush()
  testing::assert(
    model.opened.size() == 1 and model.opened.at(0).or("") == "attachment-1" and model.toggled.size() == 1 and model.toggled.at(0).or("") == "attachment-2",
    "clicking the image opens it and clicking a row toggles it",
  )
}

fn bash_row(id: Str, command: Str, status: Str, exit_code: Int, output: Str) transcript::Message {
  transcript::bash_message(
    sessionbridge::Bash{
      ID: id,
      Command: command,
      Status: status,
      ExitCode: exit_code,
      HasExitCode: status == "completed",
      TimedOut: false,
      Exclude: false,
      Output: output,
    },
  )
}

fn bash_model(messages: [transcript::Message]) mut Model {
  (mut Model{
    messages: messages,
    scope_id: 1,
    control: transcript_pane::control(),
    history: complete(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
    folded: [:],
    expanded_plugins: [:],
    open_work: [:],
    selected_tool: "",
    open_output: [:],
    requested: [],
  })
}

fn same_color(left: ui::Color?, right: ui::Color) Bool {
  match left {
    color => color.red == right.red and color.green == right.green and color.blue == right.blue,
    _ => false,
  }
}

test fn bash_runs_show_their_outcome_command_and_output_beside_a_rule() Void!Str {
  let terminal = headless::new(32, 12)
  defer terminal.destroy()
  let model = bash_model(
    [
      bash_row("bash_1", "ls", "completed", 0, "a.txt\nb.txt"),
      bash_row("bash_2", "false", "completed", 1, ""),
      bash_row("bash_3", "make", "aborted", 0, "aborted by user"),
    ],
  )
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  try expect_rows(
    rows(terminal),
    [
      "",
      "",
      "",
      " │ ✓ ls                      ▾",
      " │   a.txt",
      " │   b.txt",
      "",
      " │ ✗ false",
      "",
      " │ ⊘ make                    ▾",
      " │   aborted by user",
      "",
    ],
  )
  let colors = theme::context(theme::store(theme::system())).current()
  let frame = terminal.frame()
  try testing::assert(
    same_color(frame.cell(1, 5).expect("rule").style.foreground, colors.success_text),
    "the rule spans the run in the success color",
  )
  try testing::assert(
    same_color(frame.cell(3, 3).expect("check").style.foreground, colors.success_text),
    "exit code zero succeeds",
  )
  try testing::assert(
    same_color(frame.cell(3, 7).expect("cross").style.foreground, colors.danger_text),
    "another exit code fails",
  )
  try testing::assert(
    same_color(frame.cell(3, 9).expect("stopped").style.foreground, colors.muted),
    "a stopped run is muted",
  )
  testing::assert(
    same_color(frame.cell(5, 3).expect("command").style.foreground, colors.foreground) and same_color(frame.cell(5, 4).expect("output").style.foreground, colors.muted),
    "the command is plain and its output muted",
  )
}

test fn a_running_command_shows_a_spinner_and_no_output() Void!Str {
  let terminal = headless::new(32, 4)
