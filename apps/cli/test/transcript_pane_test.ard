test fn user_messages_list_their_attachments_inside_the_wash() Void!Str {
  let terminal = headless::new(30, 11)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let with_text = mut identified_message("user-1", transcript::Role::user, "look at these", false)
  with_text.attachments = [
    transcript::Attachment{
      id: "attachment-1",
      image: true,
      filename: "shot.png",
    },
    transcript::Attachment{
      id: "attachment-2",
      image: false,
      filename: "notes.txt",
    },
  ]
  let only_file = mut identified_message("user-2", transcript::Role::user, "", false)
  only_file.attachments = [
    transcript::Attachment{
      id: "attachment-3",
      image: false,
      filename: "only.txt",
    },
  ]
  let model = mut Model{
    messages: [with_text.@, only_file.@],
    scope_id: 1,
    control: transcript_pane::control(),
    history: complete(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
    folded: [:],
    expanded_plugins: [:],
    open_work: [:],
    selected_tool: "",
    open_output: [:],
    requested: [],
  }
  let renderer = cui::mount(
    app,
    cui::child(
      host,
      HostProps{model: model, themes: theme::context(theme::store(theme::system()))},
    ),
  )
  defer renderer.destroy()
  terminal.flush()
  try expect_rows(
    rows(terminal),
    [
      " ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄ │",
      "   look at these             ┃",
      "                             ┃",
      "   📎 shot.png               ┃",
      "   📎 notes.txt              ┃",
      " ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀ ┃",
      "                             ┃",
      " ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄ ┃",
      "   📎 only.txt               ┃",
      " ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀ ┃",
      "                             ┃",
    ],
  )
  let colors = theme::context(theme::store(theme::system())).current()
  let glyph = terminal.frame().cell(3, 3).expect("glyph")
  let name = terminal.frame().cell(6, 3).expect("name")
  let same = fn(left: ui::Color?, right: ui::Color) Bool {
    match left {
      color => color.red == right.red and color.green == right.green and color.blue == right.blue,
      _ => false,
    }
  }
  try testing::assert(glyph.grapheme == attachments::glyph, "each file is marked like its chip")
  testing::assert(
    name.grapheme == "s" and same(name.style.foreground, colors.primary_text) and same(name.style.background, colors.user_fill),
    "the name is primary text on the wash",
  )
}

fn image_message() transcript::Message {
  let message = mut identified_message("user-1", transcript::Role::user, "", false)
  message.attachments = [
    transcript::Attachment{
      id: "attachment-1",
      image: true,
      filename: "shot.png",
    },
    transcript::Attachment{
      id: "attachment-2",
      image: true,
      filename: "other.png",
    },
  ]
  message.@
}

fn red_preview() image_preview::Preview {
  let bytes = mut List::new<Byte>()
  mut index = 0
  while index < 32 {
    bytes.push(Byte::from(255))
    bytes.push(Byte::from(0))
    bytes.push(Byte::from(0))
    bytes.push(Byte::from(255))
    index =+ 1
  }
  image_preview::Preview{
    stage: image_preview::Stage::ready,
    image: Maybe::new(ui::image_rgba(8, 4, bytes.@, Maybe::new<ui::Color>())),
    failure: "",
  }
}

