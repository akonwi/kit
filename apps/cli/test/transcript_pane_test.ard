      "     Read file                         a.go:1–1",
      "     Reconcile Every Pending Workspac  kit",
      "",
    ],
  )
}

fn shown_image_run(caption: Str) [transcript::Message] {
  let reply = mut transcript::message("t1-reply", "t1", transcript::Role::assistant)
  let call = mut transcript::tool_call("c0", "show_image")
  call.arguments = "{{\"path\":\"shots/home.png\"}}"
  reply.tool_calls = [call.@]
  let result = mut transcript::message("t1-result-0", "t1", transcript::Role::tool)
  result.tool_call_id = "c0"
  result.tool_name = "show_image"
  result.tool_state = transcript::ToolState::completed
  result.text = "Image displayed successfully."
  result.details = "{{\"presentation\":\"transcript-image\",\"attachmentId\":\"attachment_home\",\"filename\":\"home.png\",\"mediaType\":\"image/png\",\"width\":800,\"height\":600,\"caption\":\"{caption}\"}}"
  [reply.@, result.@]
}

test fn a_shown_image_loads_below_its_closed_chip_with_its_caption() Void!Str {
  let terminal = headless::new(60, 18)
  defer terminal.destroy()
  let model = bash_model(shown_image_run("Home screen after the redesign"))
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  // The preview's 12 rows are reserved while it loads.
  let expected = mut List::new<Str>()
  for row in ["", "", " ▸ 1 tool call", "", "   loading preview…"] {
    expected.push(row)
  }
  for _ in 1..11 {
    expected.push("")
  }
  expected.push("   Home screen after the redesign")
  expected.push("")
  try expect_rows(rows(terminal), expected.@)
  let requested = strings::Join(mut model.requested, ",")
  testing::assert(
    requested == "attachment_home",
    "the preview is requested once shown: {requested}",
  )
}

test fn a_loaded_shown_image_paints_and_opens_when_clicked() Void!Str {
  let terminal = headless::new(60, 18)
  defer terminal.destroy()
  let model = bash_model(shown_image_run(""))
  model.previews = ["attachment_home": red_preview()]
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  let shown = rows(terminal)
  // Without a caption, the image ends the run.
  let painted = "   " + strings::Repeat("▀", 48)
  try testing::assert(
    shown.at(3).or("") == " ▸ 1 tool call" and shown.at(4).or("") == "" and shown.at(5).or("") == painted and shown.at(16).or("") == painted and shown.at(17).or("") == "",
    "the image fills its rows below the chip:\n{strings::Join(mut shown, "|\n")}",
  )
  terminal.click(10, 8)
  settle(terminal)
  testing::assert(
    model.opened.size() == 1 and model.opened.at(0).or("") == "attachment_home",
    "clicking the image opens it",
  )
}

test fn thinking_no_run_takes_in_shows_muted_and_italic() Void!Str {
  let terminal = headless::new(40, 4)
  defer terminal.destroy()
  let thought = mut transcript::message("a0", "t1", transcript::Role::assistant)
  thought.thinking = "Nothing *left* to change."
  let model = bash_model([thought.@])
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  try expect_rows(rows(terminal), ["", "", " Nothing left to change.", ""])
  let colors = theme::context(theme::store(theme::system())).current()
  let cell = terminal.frame().cell(1, 2).expect("thinking")
  testing::assert(
    same_color(cell.style.foreground, colors.muted) and cell.style.italic,
    "thinking is muted italic",
  )
}
