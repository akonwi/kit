    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
    folded: [:],
    expanded_plugins: [:],
    open_work: [:],
    selected_tool: "",
    open_output: [:],
    requested: [],
  }
  let renderer = cui::mount(
    app,
    cui::child(
