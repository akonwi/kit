// A reply that calls tools and the calls' results, in turn turn_id.
fn tool_run(turn_id: Str, states: [transcript::ToolState]) [transcript::Message] {
  let messages = mut List::new<transcript::Message>()
  let calls = mut List::new<transcript::ToolCall>()
  for state, index in states {
    let call = mut transcript::tool_call("{turn_id}-call-{index}", "read")
    call.arguments = "{{\"path\":\"src/{index}.go\"}}"
    calls.push(call.@)
  }
  let reply = mut transcript::message("{turn_id}-reply", turn_id, transcript::Role::assistant)
  reply.tool_calls = calls.@
  messages.push(reply.@)
  for state, index in states {
    let result = mut transcript::message(
      "{turn_id}-result-{index}",
      turn_id,
      transcript::Role::tool,
    )
    result.tool_call_id = "{turn_id}-call-{index}"
    result.tool_name = "read"
    result.tool_state = state
    result.text = "one\ntwo"
    messages.push(result.@)
  }
  messages.@
}

fn states(state: transcript::ToolState, count: Int) [transcript::ToolState] {
  let result = mut List::new<transcript::ToolState>()
  mut index = 0
  while index < count {
    result.push(state)
    index =+ 1
  }
  result.@
}

test fn a_finished_run_of_tool_calls_is_one_chip_counting_failures() Void!Str {
  let terminal = headless::new(40, 4)
  defer terminal.destroy()
  let model = bash_model(
    tool_run(
      "t1",
      [
        transcript::ToolState::completed,
        transcript::ToolState::failed,
        transcript::ToolState::completed,
      ],
    ),
  )
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  try expect_rows(rows(terminal), ["", "", " ▸ 3 tool calls · 1 failed", ""])
  let colors = theme::context(theme::store(theme::system())).current()
  try testing::assert(
    same_color(terminal.frame().cell(1, 2).expect("glyph").style.foreground, colors.muted),
    "the chip is muted",
  )
  testing::assert(
    same_color(
      terminal.frame().cell(18, 2).expect("failures").style.foreground,
      colors.danger_text,
    ),
    "failures use the danger color",
  )
}

test fn clicking_a_chip_opens_its_tool_rows_and_closes_the_other_chip() Void!Str {
  let terminal = headless::new(70, 8)
  defer terminal.destroy()
  let first = tool_run("t1", [transcript::ToolState::completed])
  let second = tool_run("t2", states(transcript::ToolState::completed, 2))
  let model = bash_model(join(first, second))
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  try expect_rows(rows(terminal), ["", "", "", "", " ▸ 1 tool call", "", " ▸ 2 tool calls", ""])
  terminal.click(3, 4)
  settle(terminal)
  try expect_rows(
    rows(terminal),
    [
      "",
      "",
      "",
      " ▾ 1 tool call",
      "     Read file           src/0.go:1–2",
      "",
      " ▸ 2 tool calls",
      "",
    ],
  )
  terminal.click(3, 6)
  settle(terminal)
  try expect_rows(
    rows(terminal),
    [
      "",
      "",
      " ▸ 1 tool call",
      "",
      " ▾ 2 tool calls",
      "     Read file           src/0.go:1–2",
      "     Read file           src/1.go:1–2",
      "",
    ],
  )
  terminal.click(3, 4)
  settle(terminal)
  expect_rows(rows(terminal), ["", "", "", "", " ▸ 1 tool call", "", " ▸ 2 tool calls", ""])
}

test fn a_running_run_opens_on_its_own_until_it_has_six_calls() Void!Str {
  let terminal = headless::new(70, 12)
  defer terminal.destroy()
  let model = bash_model(
    tool_run("t1", [transcript::ToolState::completed, transcript::ToolState::running]),
  )
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  try expect_rows(
    rows(terminal),
    [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      " ▾ 2 tool calls",
      "     Read file           src/0.go:1–2",
      "   ⠋ Read file           src/1.go",
      "",
    ],
  )
  // A sixth call closes it; the spinner shows the run working.
  renderer.update(fn() {
    let calls = states(transcript::ToolState::completed, 5)
    let running = mut calls
    running.push(transcript::ToolState::running)
    model.messages = tool_run("t1", running.@)
  })
  settle(terminal)
  try expect_rows(rows(terminal), ["", "", "", "", "", "", "", "", "", "", " ⠋ 6 tool calls", ""])
  // A click overrides opening on its own, either way.
  terminal.click(3, 10)
  settle(terminal)
  try expect_rows(
    rows(terminal),
    [
      "",
      "",
      "",
      "",
      " ▾ 6 tool calls",
      "     Read file           src/0.go:1–2",
      "     Read file           src/1.go:1–2",
      "     Read file           src/2.go:1–2",
      "     Read file           src/3.go:1–2",
      "     Read file           src/4.go:1–2",
      "   ⠋ Read file           src/5.go",
      "",
    ],
  )
  terminal.click(3, 4)
  settle(terminal)
  expect_rows(rows(terminal), ["", "", "", "", "", "", "", "", "", "", " ⠋ 6 tool calls", ""])
}

test fn an_open_chip_lists_thinking_before_each_messages_tool_rows() Void!Str {
  let terminal = headless::new(70, 10)
  defer terminal.destroy()
  let reply = mut transcript::message("t1-reply", "t1", transcript::Role::assistant)
  reply.thinking = "Read the *parser* first."
  reply.tool_calls = [transcript::tool_call("c1", "read"), transcript::tool_call("c2", "grep")]
  let read = mut reply.tool_calls.at(0).expect("read")
  read.arguments = "{{\"path\":\"tokenize.go\"}}"
  let search = mut reply.tool_calls.at(1).expect("search")
  search.arguments = "{{\"pattern\":\"Token\"}}"
  reply.tool_calls = [read.@, search.@]
  let result = mut transcript::message("t1-result", "t1", transcript::Role::tool)
  result.tool_call_id = "c1"
  result.tool_name = "read"
  result.tool_state = transcript::ToolState::completed
  result.text = "package parser"
  let model = bash_model([reply.@, result.@])
  model.open_work = ["work:t1:c1": true]
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  try expect_rows(
    rows(terminal),
    [
      "",
      "",
      "",
      "",
      "",
      " ▾ 2 tool calls",
      "   Read the parser first.",
      "     Read file           tokenize.go:1–1",
      "   ⠋ Search              Token in .",
      "",
    ],
  )
  let colors = theme::context(theme::store(theme::system())).current()
  let cell = terminal.frame().cell(3, 6).expect("thinking")
  testing::assert(
    same_color(cell.style.foreground, colors.muted) and cell.style.italic,
    "thinking is muted italic",
  )
}

test fn clicking_a_tool_row_selects_it_and_shows_or_hides_its_output() Void!Str {
  let terminal = headless::new(70, 9)
  defer terminal.destroy()
  let model = bash_model(tool_run("t1", states(transcript::ToolState::completed, 2)))
  model.open_work = ["work:t1:t1-call-0": true]
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  let first = "     Read file           src/0.go:1–2"
  let second = "     Read file           src/1.go:1–2"
  try expect_rows(rows(terminal), ["", "", "", "", "", " ▾ 2 tool calls", first, second, ""])
  let colors = theme::context(theme::store(theme::system())).current()
  let filled = fn(column: Int, row: Int, color: ui::Color) Bool {
    same_color(terminal.frame().cell(column, row).expect("cell").style.background, color)
  }
  // Nothing is selected until a row is clicked.
  try testing::assert(not filled(5, 6, colors.surface_pressed), "no row starts selected")
  // A click selects the row and shows its output.
  terminal.click(5, 7)
  settle(terminal)
  try expect_rows(
    rows(terminal),
    ["", "", "", " ▾ 2 tool calls", first, second, "      one", "      two", ""],
  )
  try testing::assert(model.selected_tool == "t1:t1-call-1", "selected {model.selected_tool}")
  // The selected row is filled across, around its summary chip.
  try testing::assert(filled(3, 5, colors.surface_pressed), "the row's start is filled")
  try testing::assert(filled(5, 5, colors.surface_pressed), "the title is filled")
  try testing::assert(filled(60, 5, colors.surface_pressed), "the row's end is filled")
  try testing::assert(filled(25, 5, colors.surface), "the summary keeps its chip")
  try testing::assert(not filled(5, 4, colors.surface_pressed), "the other row is not")
  // The output is on the surface fill, under the title.
  try testing::assert(filled(5, 6, colors.surface), "the well starts under the title")
  // Clicking another row moves the selection and shows its output too.
  terminal.click(5, 4)
  settle(terminal)
  try expect_rows(
    rows(terminal),
    ["", " ▾ 2 tool calls", first, "      one", "      two", second, "      one", "      two", ""],
  )
  try testing::assert(filled(5, 2, colors.surface_pressed), "a click moves the selection")
  try testing::assert(not filled(5, 5, colors.surface_pressed), "from the row selected before")
  // Clicking it again hides its output; it stays selected.
  terminal.click(5, 2)
  settle(terminal)
  try expect_rows(
    rows(terminal),
    ["", "", "", " ▾ 2 tool calls", first, second, "      one", "      two", ""],
  )
  try testing::assert(filled(5, 4, colors.surface_pressed), "the row stays selected")
  // Closing the chip clears the selection and closes every well.
  terminal.click(3, 3)
  settle(terminal)
  try expect_rows(rows(terminal), ["", "", "", "", "", "", "", " ▸ 2 tool calls", ""])
  terminal.click(3, 7)
  settle(terminal)
  try expect_rows(rows(terminal), ["", "", "", "", "", " ▾ 2 tool calls", first, second, ""])
  try testing::assert(not filled(5, 6, colors.surface_pressed), "the reopened chip has no selection")
  testing::assert(model.selected_tool == "", "selected {model.selected_tool}")
}

fn numbered(count: Int) Str {
  let lines = mut List::new<Str>()
  mut index = 1
  while index <= count {
    lines.push("line {index}")
    index =+ 1
  }
  strings::Join(lines, "\n")
}

test fn long_output_scrolls_in_its_well_and_counts_its_lines() Void!Str {
  let terminal = headless::new(70, 20)
  defer terminal.destroy()
  let messages = mut tool_run("t1", [transcript::ToolState::completed])
  let result = mut messages.at(1).expect("result")
  result.text = numbered(30)
  result.output_truncated = true
  messages.set(1, result.@)
  let model = bash_model(messages.@)
  model.open_work = ["work:t1:t1-call-0": true]
  model.selected_tool = "t1:t1-call-0"
  model.open_output = ["t1:t1-call-0": true]
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  let shown = rows(terminal)
  try expect_rows(
    shown,
    [
      "",
      "",
      " ▾ 1 tool call",
      "     Read file           src/0.go:1–30",
      "      line 1                                                       ┃",
      "      line 2                                                       ┃",
      "      line 3                                                       ┃",
      "      line 4                                                       ┃",
      "      line 5                                                       ┃",
      "      line 6                                                       ┃",
      "      line 7                                                       │",
      "      line 8                                                       │",
      "      line 9                                                       │",
      "      line 10                                                      │",
      "      line 11                                                      │",
      "      line 12                                                      │",
      "      line 13                                                      │",
      "      line 14                                                      │",
      "                                        30 lines · output truncated",
      "",
    ],
  )
  // The wheel scrolls the well.
  terminal.scroll(10, 8, 3)
  settle(terminal)
  let scrolled = rows(terminal)
  try testing::assert(
    strings::HasPrefix(scrolled.at(4).or(""), "      line 4 "),
    "the well scrolled: {scrolled.at(4).or("")}",
  )
  testing::assert(scrolled.at(3).or("") == shown.at(3).or(""), "the transcript stayed")
}

test fn the_wheel_scrolls_the_transcript_at_a_wells_edge() Void!Str {
  let terminal = headless::new(70, 10)
  defer terminal.destroy()
  let messages = mut tool_run("t1", [transcript::ToolState::completed])
  let result = mut messages.at(1).expect("result")
  result.text = numbered(30)
  messages.set(1, result.@)
  let model = bash_model(messages.@)
  model.open_work = ["work:t1:t1-call-0": true]
  model.selected_tool = "t1:t1-call-0"
  model.open_output = ["t1:t1-call-0": true]
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  // The transcript ends at the well's footer, whose start is above the view.
  let shown = rows(terminal)
  try testing::assert(
    strings::HasPrefix(shown.at(0).or(""), "      line 7 "),
    "top: {shown.at(0).or("")}",
  )
  try testing::assert(strings::Contains(shown.at(8).or(""), "30 lines"), "footer: {shown.at(8).or("")}")
  // Already at its start, the well passes the wheel up to the transcript.
  terminal.scroll(10, 3, -3)
  settle(terminal)
  let scrolled = rows(terminal)
  testing::assert(
    strings::HasPrefix(scrolled.at(3).or(""), "      line 7 "),
    "the transcript scrolled:\n{strings::Join(mut scrolled, "|\n")}",
  )
  testing::pass()
}

test fn a_running_calls_output_follows_its_end_as_it_streams() Void!Str {
  let terminal = headless::new(70, 20)
  defer terminal.destroy()
  let messages = mut tool_run("t1", [transcript::ToolState::running])
  let result = mut messages.at(1).expect("result")
  result.text = numbered(20)
  messages.set(1, result.@)
  let model = bash_model(messages.@)
  model.open_work = ["work:t1:t1-call-0": true]
  model.selected_tool = "t1:t1-call-0"
  model.open_output = ["t1:t1-call-0": true]
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  let first = rows(terminal)
  try testing::assert(
    strings::HasPrefix(first.at(4).or(""), "      line 7 "),
    "top: {first.at(4).or("")}",
  )
  try testing::assert(
    strings::HasPrefix(first.at(17).or(""), "      line 20 "),
    "end: {first.at(17).or("")}",
  )
  renderer.update(fn() {
    let grown = mut model.messages
    let streaming = mut grown.at(1).expect("result")
    streaming.text = numbered(25)
    grown.set(1, streaming.@)
    model.messages = grown.@
  })
  settle(terminal)
  let later = rows(terminal)
  testing::assert(
    strings::HasPrefix(later.at(17).or(""), "      line 25 "),
    "end: {later.at(17).or("")}",
  )
}

test fn a_well_without_output_says_so() Void!Str {
  let terminal = headless::new(70, 8)
  defer terminal.destroy()
  let messages = mut tool_run(
    "t1",
    [transcript::ToolState::completed, transcript::ToolState::running],
  )
  for index in [1, 2] {
    let result = mut messages.at(index).expect("result")
    result.text = ""
    messages.set(index, result.@)
  }
  let model = bash_model(messages.@)
  model.open_work = ["work:t1:t1-call-0": true]
  model.open_output = ["t1:t1-call-0": true, "t1:t1-call-1": true]
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  expect_rows(
    rows(terminal),
    [
      "",
      "",
      " ▾ 2 tool calls",
      "     Read file           src/0.go · empty",
      "      No output",
      "   ⠋ Read file           src/1.go",
      "      Waiting for output…",
      "",
    ],
  )
}

fn titled_run(names: [Str]) [transcript::Message] {
  let reply = mut transcript::message("t1-reply", "t1", transcript::Role::assistant)
  let calls = mut List::new<transcript::ToolCall>()
  let messages = mut List::new<transcript::Message>()
  for name, index in names {
    let call = mut transcript::tool_call("c{index}", name)
    call.arguments = "{{\"path\":\"a.go\"}}"
    calls.push(call.@)
  }
  reply.tool_calls = calls.@
  messages.push(reply.@)
  for name, index in names {
    let result = mut transcript::message("t1-result-{index}", "t1", transcript::Role::tool)
    result.tool_call_id = "c{index}"
    result.tool_name = name
    result.tool_state = transcript::ToolState::completed
    result.text = "done"
    messages.push(result.@)
  }
  messages.@
}

test fn a_chips_rows_share_a_title_column_as_wide_as_their_longest_title() Void!Str {
  let terminal = headless::new(80, 5)
  defer terminal.destroy()
  let model = bash_model(titled_run(["read", "kit__inspect_workspace_state"]))
  model.open_work = ["work:t1:c0": true]
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  expect_rows(
    rows(terminal),
    [
      "",
      " ▾ 2 tool calls",
      "     Read file                a.go:1–1",
      "     Inspect Workspace State  kit",
      "",
    ],
  )
}

test fn a_title_column_stops_growing_at_its_widest() Void!Str {
  let terminal = headless::new(80, 5)
  defer terminal.destroy()
  let model = bash_model(titled_run(["read", "kit__reconcile_every_pending_workspace_change"]))
