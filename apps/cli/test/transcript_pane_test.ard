      "                             │",
      " reply 8                     │",
      "                             │",
      " reply 9                     │",
      "                             ┃",
    ],
  )
}

// The reply fits when it arrives, so the transcript follows it. Reflow that
// later makes it taller than the viewport is growth, not an arrival, and keeps
// following its end.
test fn sticky_tail_follows_markdown_height_changes_and_resize() Void!Str {
  let terminal = headless::new(42, 12)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let messages = mut List::new<transcript::Message>()
  for item in replies(5) {
    messages.push(item)
  }
  messages.push(
    identified_message(
      "growing-tail",
      transcript::Role::assistant,
      "**Final reply** starts here and has enough prose to wrap repeatedly when the transcript becomes narrow.\n\n- first detail\n- second detail\n\nTAIL sentinel",
      false,
    ),
  )
  let model = mut Model{
    messages: messages.@,
    scope_id: 1,
    control: transcript_pane::control(),
    history: complete(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = cui::mount(
    app,
    cui::child(
      host,
      HostProps{model: model, themes: theme::context(theme::store(theme::system()))},
    ),
  )
  defer renderer.destroy()
  terminal.flush()
  let list = model.control.list.current.expect("transcript list")
  settle(terminal)
  try testing::assert(list.is_following_edge(), "transcript initially follows its tail")
  try testing::assert(terminal.frame().text().contains("TAIL sentinel"), "wide tail is visible")

  terminal.resize(20, 12)
  terminal.flush()
  try testing::assert(list.is_following_edge(), "Markdown reflow preserves sticky following")
  try testing::assert(list.last_item_visible(), "committed state keeps latest visible")
  try testing::assert(
    terminal.frame().text().contains("TAIL sentinel"),
    "narrow reflow stays pinned to the final content",
  )

  terminal.resize(42, 12)
  terminal.flush()
  testing::assert(
    list.is_following_edge() and list.last_item_visible() and terminal.frame().text().contains("TAIL sentinel"),
    "wider reflow remains pinned to the same tail",
  )
}

test fn scrolled_transcript_preserves_its_keyed_reading_anchor_during_reflow() Void!Str {
  let terminal = headless::new(44, 8)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let messages = mut List::new<transcript::Message>()
  mut index = 1
  while index <= 16 {
    messages.push(
      identified_message(
        "anchored-{index}",
        transcript::Role::assistant,
        "**reply {index}** carries a long explanation that changes height when the viewport narrows.",
        false,
      ),
    )
    index =+ 1
  }
  let model = mut Model{
    messages: messages.@,
    scope_id: 1,
    control: transcript_pane::control(),
    history: complete(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = cui::mount(
    app,
    cui::child(
      host,
      HostProps{model: model, themes: theme::context(theme::store(theme::system()))},
    ),
  )
  defer renderer.destroy()
  terminal.flush()
  let list = model.control.list.current.expect("transcript list")
  renderer.update(fn() {
    list.stop_following()
    let _ = list.scroll_to_key("anchored-8", cui::ScrollAlignment::start)
  })
  terminal.flush()
  let wide_position = position(terminal.frame().text(), "reply 8")
  try testing::assert(wide_position.at(1).or(-1) == 1, "keyed row begins at the reading anchor")

  terminal.resize(22, 8)
  terminal.flush()
  let narrow_position = position(terminal.frame().text(), "reply 8")
  try testing::assert(not list.is_following_edge(), "reflow does not repin a scrolled transcript")
  try testing::assert(
    narrow_position.at(1).or(-1) == 1,
    "narrow reflow preserves the keyed intra-row anchor",
  )
  try testing::assert(
    terminal.frame().text().contains("↓ Latest"),
    "committed latest state remains out of view",
  )

  terminal.resize(44, 8)
  terminal.flush()
  testing::assert(
    position(terminal.frame().text(), "reply 8").at(1).or(-1) == 1,
    "wide reflow restores the same keyed reading anchor",
  )
}

test fn markdown_selection_survives_transcript_reflow() Void!Str {
  let terminal = headless::new(42, 7)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let model = mut Model{
    messages: [
      identified_message(
        "selected-markdown",
        transcript::Role::assistant,
        "A **selectable** phrase remains stable while this surrounding sentence wraps.",
        false,
      ),
    ],
    scope_id: 1,
    control: transcript_pane::control(),
    history: complete(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = cui::mount(
    app,
    cui::child(
      host,
      HostProps{model: model, themes: theme::context(theme::store(theme::system()))},
    ),
  )
  defer renderer.destroy()
  terminal.flush()
  let target = position(terminal.frame().text(), "selectable")
  terminal.double_click(target.at(0).or(-1), target.at(1).or(-1))
  terminal.flush()
  try testing::assert(
    terminal.selection().expect("wide Markdown selection").selected_text == "selectable",
    "selection uses rendered Markdown text",
  )

  terminal.resize(20, 7)
  terminal.flush()
  try testing::assert(
    terminal.selection().expect("narrow Markdown selection").selected_text == "selectable",
    "selection source range survives narrow reflow",
  )

  terminal.resize(42, 7)
  terminal.flush()
  testing::assert(
    terminal.selection().expect("restored Markdown selection").selected_text == "selectable",
    "selection survives restoring the original width",
  )
}

test fn selected_transcript_row_remains_retained_when_height_growth_moves_it_offscreen() Void!Str {
  let terminal = headless::new(30, 6)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let model = mut Model{
    messages: replies(12),
    scope_id: 1,
    control: transcript_pane::control(),
    history: complete(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = cui::mount(
    app,
    cui::child(
      host,
      HostProps{model: model, themes: theme::context(theme::store(theme::system()))},
    ),
  )
  defer renderer.destroy()
  terminal.flush()
  let list = model.control.list.current.expect("transcript list")
  renderer.update(fn() {
    list.stop_following()
    let _ = list.scroll_to_key("reply-5", cui::ScrollAlignment::start)
  })
  terminal.flush()
  let selected = position(terminal.frame().text(), "reply 7")
  terminal.double_click(selected.at(0).or(-1), selected.at(1).or(-1))
  terminal.flush()
  try testing::assert(
    terminal.selection().expect("selected reply").selected_text == "reply",
    "reply is selected",
  )

  renderer.update(fn() {
    let changed = mut model.messages.at(4).expect("reply 5")
    changed.text = "Expanded anchor\n\nline two\n\nline three\n\nline four\n\nline five\n\nline six"
    model.messages.set(4, changed.@)
  })
  terminal.flush()
  try testing::assert(list.mounted_count() < 10, "selected endpoint pin keeps virtualization bounded")
  try testing::assert(
    terminal.selection().expect("offscreen retained reply").selected_text == "",
    "offscreen selected row contributes no clipped text",
  )

  renderer.update(fn() {
    let _ = list.scroll_to_key("reply-7", cui::ScrollAlignment::start)
  })
  terminal.flush()
  testing::assert(
    terminal.selection().expect("restored selected reply").selected_text == "reply",
    "returning to the retained transcript row restores selection",
  )
}

test fn the_latest_control_returns_a_scrolled_transcript_to_its_tail() Void!Str {
  let terminal = headless::new(30, 6)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let model = mut Model{
    messages: replies(8),
    scope_id: 1,
    control: transcript_pane::control(),
    history: complete(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = cui::mount(
    app,
    cui::child(
      host,
      HostProps{model: model, themes: theme::context(theme::store(theme::system()))},
    ),
  )
  defer renderer.destroy()
  terminal.flush()
  let list = model.control.list.current.expect("transcript list")
  renderer.update(fn() {
    list.stop_following()
    let _ = list.scroll_to_edge(cui::ScrollEdge::start, sticky: false)
  })
  terminal.flush()
  terminal.flush()
  let button = position(terminal.frame().text(), "↓ Latest")
  try testing::assert(button.at(1).or(-1) >= 0, "a scrolled transcript offers the latest reply")

  terminal.mouse_move(button.at(0).or(-1) + 1, button.at(1).or(-1))
  terminal.mouse_down(button.at(0).or(-1) + 1, button.at(1).or(-1))
  terminal.mouse_up(button.at(0).or(-1) + 1, button.at(1).or(-1))
  terminal.flush()
  terminal.flush()
  try testing::assert(list.is_following_edge(), "returning to the latest reply resumes following")
  // Every row has now been measured, so the thumb reflects exact content height.
  expect_rows(
    rows(terminal),
    [
      " reply 6                     │",
      "                             │",
      " reply 7                     │",
      "                             │",
      " reply 8                     ┃",
      "                             ┃",
    ],
  )
}

test fn a_new_attachment_scope_remounts_the_transcript_at_its_tail() Void!Str {
  let terminal = headless::new(30, 6)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let model = mut Model{
    messages: replies(8),
    scope_id: 1,
    control: transcript_pane::control(),
    history: complete(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = cui::mount(
    app,
    cui::child(
      host,
      HostProps{model: model, themes: theme::context(theme::store(theme::system()))},
    ),
  )
  defer renderer.destroy()
  terminal.flush()
  let first = model.control.list.current.expect("first transcript list")
  renderer.update(fn() {
    first.stop_following()
    let _ = first.scroll_to_edge(cui::ScrollEdge::start, sticky: false)
  })
  terminal.flush()

  renderer.update(fn() {
    model.scope_id = 2
    model.control = transcript_pane::control()
  })
  terminal.flush()
  terminal.flush()
  let second = model.control.list.current.expect("second transcript list")
  try testing::assert(second.is_following_edge(), "the reattached transcript follows its tail")
  expect_rows(
    rows(terminal),
    [
      " reply 6                     │",
      "                             │",
      " reply 7                     │",
      "                             │",
      " reply 8                     │",
      "                             ┃",
    ],
  )
}

// A reply of `count` numbered paragraphs, each one row with a gap row between.
fn tall_reply(id: Str, count: Int) transcript::Message {
  let paragraphs = mut List::new<Str>()
  mut index = 1
  while index <= count {
    paragraphs.push("{id} line {index}")
    index =+ 1
  }
  let source = paragraphs.@
  identified_message(id, transcript::Role::assistant, strings::Join(mut source, "\n\n"), false)
}

fn mount_messages(terminal: headless::TestApp, model: mut Model) cui::Renderer {
  let app = cooper::App{context: terminal.context, root: terminal.root}
  cui::mount(
    app,
    cui::child(
      host,
      HostProps{model: model, themes: theme::context(theme::store(theme::system()))},
    ),
  )
}

// Settles the reply's one-frame alignment: its tail paints, the committed
// update aligns it, and the next update confirms whether it fits.
fn settle(terminal: headless::TestApp) {
  terminal.flush()
  terminal.flush()
  terminal.flush()
}

test fn attaching_opens_a_tall_final_reply_at_its_start() Void!Str {
  let terminal = headless::new(30, 6)
  defer terminal.destroy()
  let model = mut Model{
    messages: [message(transcript::Role::user, "Explain", false), tall_reply("answer", 5)],
    scope_id: 1,
    control: transcript_pane::control(),
    history: complete(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  try expect_rows(
    rows(terminal),
    [
      "                             │",
      " answer line 1               │",
      "                             ┃",
      " answer line 2               ┃",
      "                             │",
      " answer line 3               │",
    ],
  )
  testing::assert(
    not model.control.list.current.expect("transcript list").is_following_edge(),
    "reading the reply's start stops following the end",
  )
}

test fn a_tall_reply_arriving_at_the_end_opens_at_its_start() Void!Str {
  let terminal = headless::new(30, 6)
  defer terminal.destroy()
  let model = mut Model{
    messages: replies(4),
    scope_id: 1,
    control: transcript_pane::control(),
    history: complete(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  renderer.update(fn() {
    let next = mut List::new<transcript::Message>()
    for item in replies(4) {
      next.push(item)
    }
    next.push(message(transcript::Role::user, "Explain", false))
    next.push(tall_reply("answer", 5))
    model.messages = next.@
  })
  settle(terminal)
  let shown = rows(terminal)
  try testing::assert(
    shown.at(1).or("").starts_with(" answer line 1"),
    "the reply's first line is at the top:\n{strings::Join(mut shown, "\n")}",
  )
  testing::assert(
    not model.control.list.current.expect("transcript list").is_following_edge(),
    "reading the reply's start stops following the end",
  )
}

test fn a_reply_that_fits_keeps_following_the_end() Void!Str {
  let terminal = headless::new(30, 6)
  defer terminal.destroy()
  let model = mut Model{
    messages: replies(4),
    scope_id: 1,
    control: transcript_pane::control(),
    history: complete(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  renderer.update(fn() {
    model.messages = replies(5)
  })
  settle(terminal)
  try expect_rows(
    rows(terminal),
    [
      " reply 3                     │",
      "                             │",
      " reply 4                     │",
      "                             ┃",
      " reply 5                     ┃",
      "                             ┃",
    ],
  )
  testing::assert(
    model.control.list.current.expect("transcript list").is_following_edge(),
    "a reply that fits resumes following",
  )
}

test fn a_tall_reply_arriving_while_scrolled_away_leaves_the_view_alone() Void!Str {
  let terminal = headless::new(30, 6)
  defer terminal.destroy()
  let model = mut Model{
    messages: replies(8),
    scope_id: 1,
    control: transcript_pane::control(),
    history: complete(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  let list = model.control.list.current.expect("transcript list")
  renderer.update(fn() {
    list.stop_following()
    let _ = list.scroll_to_key("reply-2", cui::ScrollAlignment::start)
  })
  settle(terminal)
  let before = rows(terminal)
  renderer.update(fn() {
    let next = mut List::new<transcript::Message>()
    for item in replies(8) {
      next.push(item)
    }
    next.push(tall_reply("answer", 5))
    model.messages = next.@
  })
  settle(terminal)
  let after = rows(terminal)
  testing::assert(
    after.at(1).or("") == before.at(1).or("") and after.at(1).or("").starts_with(" reply 2"),
    "the reading position is kept:\n{strings::Join(mut after, "\n")}",
  )
}

test fn a_tall_prompt_follows_the_end() Void!Str {
  let terminal = headless::new(30, 6)
  defer terminal.destroy()
  let model = mut Model{
    messages: replies(2),
    scope_id: 1,
    control: transcript_pane::control(),
    history: complete(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  renderer.update(fn() {
    let next = mut List::new<transcript::Message>()
    for item in replies(2) {
      next.push(item)
    }
    next.push(
      message(
        transcript::Role::user,
        "first prompt line\nsecond\nthird\nfourth\nfifth\nsixth\nPROMPT END",
        false,
      ),
    )
    model.messages = next.@
  })
  settle(terminal)
  let shown = rows(terminal)
  try testing::assert(
    strings::Join(mut shown, "\n").contains("PROMPT END"),
    "a submitted prompt shows its end:\n{strings::Join(mut shown, "\n")}",
  )
  testing::assert(
    model.control.list.current.expect("transcript list").is_following_edge(),
    "the transcript keeps following",
  )
}

// Replies numbered first through last, as one transcript page.
fn reply_range(first: Int, last: Int) [transcript::Message] {
  let messages = mut List::new<protocol::TranscriptMessage>()
  mut index = first
  while index <= last {
    messages.push(
      protocol::TranscriptMessage{
        ID: "reply-{index}",
        Role: "assistant",
        Content: [protocol::TextBlock("reply {index}")],
      },
    )
    index =+ 1
  }
  transcript::project(messages.@)
}

fn join(head: [transcript::Message], tail: [transcript::Message]) [transcript::Message] {
  let joined = mut List::new<transcript::Message>()
  for message in head {
    joined.push(message)
  }
  for message in tail {
    joined.push(message)
  }
  joined.@
}

fn mount_history(terminal: headless::TestApp, model: mut Model) cui::Renderer {
  let app = cooper::App{context: terminal.context, root: terminal.root}
  cui::mount(
    app,
    cui::child(
      host,
      HostProps{model: model, themes: theme::context(theme::store(theme::system()))},
    ),
  )
}

test fn a_first_page_too_short_to_fill_the_view_loads_earlier_history() Void!Str {
  let terminal = headless::new(36, 8)
  defer terminal.destroy()
  let model = mut Model{
    messages: reply_range(9, 10),
    scope_id: 1,
    control: transcript_pane::control(),
    history: more_history(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = mount_history(terminal, model)
  defer renderer.destroy()
  terminal.flush()
  terminal.flush()
  try testing::assert(model.requests == 1, "{model.requests} requests")
  try expect_rows(
    rows(terminal),
    ["", "", " ⠋ Loading earlier messages…", "", " reply 9", "", " reply 10", ""],
  )

  // The final page arrives: the status row is gone once nothing is left.
  renderer.update(fn() {
    model.messages = join(reply_range(7, 8), model.messages)
    model.history = complete()
  })
  terminal.flush()
  // The page fills the view, so the scrollbar appears beside it.
  expect_rows(
    content_rows(terminal),
    [" reply 7", "", " reply 8", "", " reply 9", "", " reply 10", ""],
  )
}

test fn earlier_history_loads_within_forty_rows_of_the_top() Void!Str {
  let terminal = headless::new(36, 10)
  defer terminal.destroy()
  // Thirty two-row replies under a two-row status. Rows not yet measured
  // count at the list's four-row estimate, so each position below lands on
  // the same side of the 40-row threshold whether or not it is measured.
  let model = mut Model{
    messages: reply_range(1, 30),
    scope_id: 1,
    control: transcript_pane::control(),
    history: more_history(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = mount_history(terminal, model)
  defer renderer.destroy()
  terminal.flush()
  terminal.flush()
  try testing::assert(model.requests == 0, "at the end: {model.requests} requests")

  let list = model.control.list.current.expect("transcript list")
  // reply-25 starts between 50 and 98 rows from the top.
  renderer.update(fn() {
    list.stop_following()
    let _ = list.scroll_to_key("reply-25", alignment: cui::ScrollAlignment::start)
  })
  terminal.flush()
  terminal.flush()
  try testing::assert(model.requests == 0, "well below the top: {model.requests} requests")
  // reply-10 starts between 20 and 38 rows from the top.
  renderer.update(fn() {
    let _ = list.scroll_to_key("reply-10", alignment: cui::ScrollAlignment::start)
  })
  terminal.flush()
  terminal.flush()
  testing::assert(model.requests == 1, "near the top: {model.requests} requests")
}

test fn a_prepended_page_keeps_the_reading_position() Void!Str {
  let terminal = headless::new(36, 6)
  defer terminal.destroy()
  let model = mut Model{
    messages: reply_range(11, 40),
    scope_id: 1,
    control: transcript_pane::control(),
    history: more_history(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = mount_history(terminal, model)
  defer renderer.destroy()
  terminal.flush()
  let list = model.control.list.current.expect("transcript list")
  renderer.update(fn() {
    list.stop_following()
    let _ = list.scroll_to_key("reply-20", alignment: cui::ScrollAlignment::start)
  })
  terminal.flush()
  terminal.flush()
  let before = content_rows(terminal)
  try testing::assert(
    before.at(1).or("") == " reply 20",
    "reading from reply 20:\n{strings::Join(mut before, "\n")}",
  )

  renderer.update(fn() {
    model.messages = join(reply_range(1, 10), model.messages)
    model.history = complete()
  })
  terminal.flush()
  terminal.flush()
  expect_rows(content_rows(terminal), before)
}

// Rows without the scrollbar column, whose thumb moves as content is added.
fn content_rows(terminal: headless::TestApp) [Str] {
  let trimmed = mut List::new<Str>()
  for row in strings::Split(terminal.frame().text(), "\n") {
    let without_track = strings::TrimSuffix(strings::TrimRight(row, " "), "│")
    trimmed.push(strings::TrimRight(strings::TrimSuffix(without_track, "┃"), " "))
  }
  trimmed.@
}

test fn a_failed_page_pauses_loading_until_retried() Void!Str {
  let terminal = headless::new(48, 6)
  defer terminal.destroy()
  let model = mut Model{
    messages: reply_range(9, 10),
    scope_id: 1,
    control: transcript_pane::control(),
    history: transcript_pane::History{
      more: true,
      loading: false,
      failure: "connection refused",
    },
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = mount_history(terminal, model)
  defer renderer.destroy()
  terminal.flush()
  terminal.flush()
  try testing::assert(model.requests == 0, "a failure pauses loading: {model.requests} requests")
  let text = terminal.frame().text()
  let retry = position(text, "Could not load earlier messages · retry")
  try testing::assert(retry.at(1).or(-1) >= 0, "the status offers a retry:\n{text}")

  terminal.mouse_move(retry.at(0).or(-1) + 2, retry.at(1).or(-1))
  terminal.mouse_down(retry.at(0).or(-1) + 2, retry.at(1).or(-1))
  terminal.mouse_up(retry.at(0).or(-1) + 2, retry.at(1).or(-1))
  terminal.flush()
  testing::assert(model.requests == 1, "retry requests the page: {model.requests} requests")
}

test fn a_page_prepended_at_the_very_top_keeps_the_oldest_message_in_place() Void!Str {
  let terminal = headless::new(36, 6)
  defer terminal.destroy()
  let model = mut Model{
    messages: reply_range(11, 40),
    scope_id: 1,
    control: transcript_pane::control(),
    history: transcript_pane::History{
      more: true,
      loading: true,
      failure: "",
    },
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = mount_history(terminal, model)
  defer renderer.destroy()
  terminal.flush()
  let list = model.control.list.current.expect("transcript list")
  renderer.update(fn() {
    let _ = list.scroll_to_edge(cui::ScrollEdge::start, sticky: false)
  })
  terminal.flush()
  terminal.flush()
  try expect_rows(
    content_rows(terminal),
    [
      "",
      " ⠋ Loading earlier messages…",
      "",
      " reply 11",
      "                          ↓ Latest",
      " reply 12",
    ],
  )

  // More history remains, so the status row stays above the new page.
  renderer.update(fn() {
    model.messages = join(reply_range(1, 10), model.messages)
    model.history = transcript_pane::History{
      more: true,
      loading: true,
      failure: "",
    }
  })
  terminal.flush()
  terminal.flush()
  expect_rows(
    content_rows(terminal),
    ["", " reply 11", "", " reply 12", "                          ↓ Latest", " reply 13"],
  )
}

test fn user_messages_list_their_attachments_inside_the_wash() Void!Str {
  let terminal = headless::new(30, 11)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let with_text = mut identified_message("user-1", transcript::Role::user, "look at these", false)
  with_text.attachments = [
    transcript::Attachment{
      id: "attachment-1",
      image: true,
      filename: "shot.png",
    },
    transcript::Attachment{
      id: "attachment-2",
      image: false,
      filename: "notes.txt",
    },
  ]
  let only_file = mut identified_message("user-2", transcript::Role::user, "", false)
  only_file.attachments = [
    transcript::Attachment{
      id: "attachment-3",
      image: false,
      filename: "only.txt",
    },
  ]
  let model = mut Model{
    messages: [with_text.@, only_file.@],
    scope_id: 1,
    control: transcript_pane::control(),
    history: complete(),
    requests: 0,
    expanded: "",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = cui::mount(
    app,
    cui::child(
      host,
      HostProps{model: model, themes: theme::context(theme::store(theme::system()))},
    ),
  )
  defer renderer.destroy()
  terminal.flush()
  try expect_rows(
    rows(terminal),
    [
      " ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄ │",
      "   look at these             ┃",
      "                             ┃",
      "   📎 shot.png               ┃",
      "   📎 notes.txt              ┃",
      " ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀ ┃",
      "                             ┃",
      " ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄ ┃",
      "   📎 only.txt               ┃",
      " ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀ ┃",
      "                             ┃",
    ],
  )
  let colors = theme::context(theme::store(theme::system())).current()
  let glyph = terminal.frame().cell(3, 3).expect("glyph")
  let name = terminal.frame().cell(6, 3).expect("name")
  let same = fn(left: ui::Color?, right: ui::Color) Bool {
    match left {
      color => color.red == right.red and color.green == right.green and color.blue == right.blue,
      _ => false,
    }
  }
  try testing::assert(glyph.grapheme == attachments::glyph, "each file is marked like its chip")
  testing::assert(
    name.grapheme == "s" and same(name.style.foreground, colors.primary_text) and same(name.style.background, colors.user_fill),
    "the name is primary text on the wash",
  )
}

fn image_message() transcript::Message {
  let message = mut identified_message("user-1", transcript::Role::user, "", false)
  message.attachments = [
    transcript::Attachment{
      id: "attachment-1",
      image: true,
      filename: "shot.png",
    },
    transcript::Attachment{
      id: "attachment-2",
      image: true,
      filename: "other.png",
    },
  ]
  message.@
}

fn red_preview() image_preview::Preview {
  let bytes = mut List::new<Byte>()
  mut index = 0
  while index < 32 {
    bytes.push(Byte::from(255))
    bytes.push(Byte::from(0))
    bytes.push(Byte::from(0))
    bytes.push(Byte::from(255))
    index =+ 1
  }
  image_preview::Preview{
    stage: image_preview::Stage::ready,
    image: Maybe::new(ui::image_rgba(8, 4, bytes.@, Maybe::new<ui::Color>())),
    failure: "",
  }
}

test fn an_expanded_image_shows_its_preview_below_its_row() Void!Str {
  let terminal = headless::new(40, 18)
  defer terminal.destroy()
  let app = cooper::App{context: terminal.context, root: terminal.root}
  let model = mut Model{
    messages: [image_message()],
    scope_id: 1,
    control: transcript_pane::control(),
    history: complete(),
    requests: 0,
    expanded: "attachment-1",
    previews: [:],
    toggled: [],
    opened: [],
  }
  let renderer = cui::mount(
    app,
    cui::child(
      host,
      HostProps{model: model, themes: theme::context(theme::store(theme::system()))},
    ),
  )
  defer renderer.destroy()
  terminal.flush()
  try expect_rows(
    rows(terminal),
    [
      "",
      " ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄",
      "   📎 shot.png",
      "   loading preview…",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "   📎 other.png",
      " ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀",
      "",
    ],
  )

  renderer.update(fn() {
    model.previews.set("attachment-1", red_preview())
  })
  terminal.flush()
  let image_rows = rows(terminal)
  let painted = "   " + strings::Repeat("▀", 33)
  try testing::assert(
    image_rows.at(5).or("") == painted and image_rows.at(12).or("") == painted and image_rows.at(4).or("") == "" and image_rows.at(13).or("") == "",
    "a 2:1 image narrowed to the wash keeps its shape, centred in the reserved rows:\n{strings::Join(mut image_rows, "|\n")}",
  )
  try testing::assert(
    terminal.frame().text().contains("📎 other.png"),
    "loading does not move the next row",
  )

  terminal.click(4, 8)
  terminal.flush()
  terminal.click(8, 15)
  terminal.flush()
  testing::assert(
    model.opened.size() == 1 and model.opened.at(0).or("") == "attachment-1" and model.toggled.size() == 1 and model.toggled.at(0).or("") == "attachment-2",
    "clicking the image opens it and clicking a row toggles it",
  )
}
