    toggled: [],
    opened: [],
    folded: [:],
    expanded_plugins: [:],
    open_work: [:],
    selected_tool: "",
    open_output: [:],
    requested: [],
  }
  let renderer = mount_history(terminal, model)
  defer renderer.destroy()
  terminal.flush()
  let list = model.control.list.current.expect("transcript list")
  renderer.update(fn() {
    list.stop_following()
