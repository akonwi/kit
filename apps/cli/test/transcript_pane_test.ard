  testing::assert(
    same_color(terminal.frame().cell(3, 2).expect("spinner").style.foreground, colors.success_text),
    "the spinner uses the success color",
  )
}

test fn clicking_a_finished_command_folds_its_output() Void!Str {
  let terminal = headless::new(32, 6)
  defer terminal.destroy()
  let model = bash_model([bash_row("bash_1", "ls", "completed", 0, "a.txt\nb.txt")])
  let renderer = mount_messages(terminal, model)
