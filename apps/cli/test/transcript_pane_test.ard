test fn long_output_shows_its_first_lines_and_counts_the_rest() Void!Str {
  let terminal = headless::new(32, 24)
  defer terminal.destroy()
  let lines = mut List::new<Str>()
  mut index = 1
  while index <= 25 {
    lines.push("line {index}")
    index =+ 1
  }
  let model = bash_model([bash_row("bash_1", "seq 25", "completed", 0, strings::Join(lines, "\n"))])
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  let expected = mut List::new<Str>()
  for row in ["", "", "", " │ ✓ seq 25                  ▾"] {
    expected.push(row)
  }
  mut line = 1
  while line <= 18 {
    expected.push(" │   line {line}")
    line =+ 1
  }
  expected.push(" │   … (7 more lines)")
  expected.push("")
  expect_rows(rows(terminal), expected.@)
}

fn plugin_message(text: Str) [transcript::Message] {
  transcript::project(
    [
      protocol::TranscriptMessage{
        ID: "pluginmsg_1",
        TurnID: "turn_1",
        Sequence: Int64::from(1),
        Role: "context",
        BoundaryID: "pluginmsg_1",
        BoundaryKind: protocol::PluginMessageBoundaryKind,
        BoundarySource: "autoresearch",
        Content: [protocol::TextBlock(text)],
      },
    ],
  )
}

let plugin_text = "Continue the experiment loop.\n\nLog each result before the next run."

test fn a_plugin_message_collapses_to_one_row_naming_its_plugin() Void!Str {
  let terminal = headless::new(60, 3)
  defer terminal.destroy()
  let model = bash_model(plugin_message(plugin_text))
  let renderer = mount_messages(terminal, model)
  defer renderer.destroy()
  settle(terminal)
  try expect_rows(rows(terminal), ["", " ◆ autoresearch · Continue the experiment loop. ▸", ""])
  let colors = theme::context(theme::store(theme::system())).current()
  let frame = terminal.frame()
  try testing::assert(
    same_color(frame.cell(1, 1).expect("diamond").style.foreground, colors.accent_text) and same_color(frame.cell(3, 1).expect("plugin").style.foreground, colors.accent_text),
    "the plugin is named in the accent color",
  )
  testing::assert(
    same_color(frame.cell(16, 1).expect("separator").style.foreground, colors.muted) and same_color(frame.cell(18, 1).expect("summary").style.foreground, colors.muted) and same_color(frame.cell(48, 1).expect("indicator").style.foreground, colors.muted),
    "the summary is muted",
  )
}

