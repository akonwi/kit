use ard/testing

use go:api/contract as protocol
use go:kit/ffi/sessionbridge
use kit/tui/transcript

// Numbers events 1, 2, 3, … in order, as one server stream would.
fn sequenced(events: [sessionbridge::Event]) [sessionbridge::Event] {
  let numbered = mut List::new<sessionbridge::Event>()
  mut next: Int64 = 1
  for event in events {
    let copy = mut event
    copy.Sequence = next
    numbered.push(copy.@)
    next =+ 1
  }
  numbered.@
}

fn event(kind: Str) sessionbridge::Event {
  sessionbridge::Event{Kind: kind, TurnID: "turn-1"}
}

fn text_delta(delta: Str) sessionbridge::Event {
  sessionbridge::Event{
    Kind: "assistant.text.delta",
    TurnID: "turn-1",
    MessageID: "assistant-1",
    ContentIndex: 0,
    Delta: delta,
  }
}

fn assistant_started() sessionbridge::Event {
  sessionbridge::Event{
    Kind: "assistant.started",
    TurnID: "turn-1",
    MessageID: "assistant-1",
  }
}

fn describe(messages: [transcript::Message]) Str {
  mut out = ""
  for message in messages {
    let role = match message.role {
      transcript::Role::user => "user",
      transcript::Role::assistant => "assistant",
      transcript::Role::tool => "tool",
      transcript::Role::bash => "bash",
      transcript::Role::other => "other",
    }
    out = out + "[{role} {message.id} {message.text}]"
  }
  out
}

test fn a_streamed_reply_replaces_the_submitted_prompt_and_settles() Void!Str {
  let live = mut transcript::live()
  live.submit("hi", [])
  try testing::assert(live.activity == "Working…", "submission shows activity")
  let stream = sequenced(
    [
      event("turn.started"),
      sessionbridge::Event{
        Kind: "user.message.added",
        TurnID: "turn-1",
        Text: "hi",
      },
      assistant_started(),
      text_delta("Hel"),
      text_delta("lo"),
      sessionbridge::Event{
        Kind: "assistant.completed",
        TurnID: "turn-1",
        MessageID: "assistant-1",
        Text: "Hello!",
      },
      event("turn.completed"),
    ],
  )
  let _ = live.apply(stream.slice(end: 5).expect("streaming prefix").to_list())
  try testing::assert(
    describe(live.messages) == "[user live-user:turn-1 hi][assistant assistant-1 Hello]",
    describe(live.messages),
  )
  try testing::assert(live.messages.at(1).expect("assistant").pending, "streaming reply is pending")
  let follow = live.apply(stream)
  try testing::assert(follow, "completion asks a pinned view to follow")
  try testing::assert(
    describe(live.messages) == "[user live-user:turn-1 hi][assistant assistant-1 Hello!]",
    describe(live.messages),
  )
  try testing::assert(not live.messages.at(1).expect("assistant").pending, "completed reply settles")
  testing::assert(live.activity == "", "finished run clears activity")
}

test fn a_watched_turn_from_another_client_shows_its_prompt_and_thinking() Void!Str {
  let live = mut transcript::live()
  let batch = sequenced(
    [
      event("turn.started"),
      sessionbridge::Event{
        Kind: "user.message.added",
        TurnID: "turn-1",
        Text: "commit",
      },
      sessionbridge::Event{
        Kind: "assistant.thinking.delta",
        TurnID: "turn-1",
        MessageID: "assistant-1",
        ContentIndex: 0,
        Delta: "Reviewing changes\nCreating the commit",
      },
    ],
  )
  let _ = live.apply(batch)
  try testing::assert(
    describe(live.messages) == "[user live-user:turn-1 commit][assistant assistant-1 ]",
    describe(live.messages),
  )
  testing::assert(
    live.activity == "Creating the commit",
    "remote thinking updates the shared working UX",
  )
}

test fn watched_batches_reconcile_the_user_of_a_queued_successor() Void!Str {
  let live = mut transcript::live()
  let _ = live.apply(
    sequenced(
      [
        event("turn.started"),
        sessionbridge::Event{
          Kind: "user.message.added",
          TurnID: "turn-1",
          Text: "first",
        },
        event("turn.completed"),
        sessionbridge::Event{Kind: "turn.started", TurnID: "turn-2"},
        sessionbridge::Event{
          Kind: "user.message.added",
          TurnID: "turn-2",
          Text: "next",
        },
      ],
    ),
  )
  try testing::assert(
    describe(live.messages) == "[user live-user:turn-1 first][user live-user:turn-2 next]",
    describe(live.messages),
  )
  testing::assert(live.activity == "Working…", "the queued successor remains active")
}

test fn active_turn_blocks_snapshots_after_the_user_event_claims_the_prompt() Void!Str {
  let live = mut transcript::live()
  live.submit("hi", [])
  try testing::assert(live.blocks_snapshot_replacement(), "new local prompt blocks stale snapshots")
  let _ = live.apply(
    sequenced(
      [
        sessionbridge::Event{
          Kind: "user.message.added",
          TurnID: "turn-1",
          Text: "hi",
        },
      ],
    ),
  )
  testing::assert(
    live.blocks_snapshot_replacement(),
    "durable user identity must not let an active snapshot erase the live tail",
  )
}

test fn a_submitted_prompt_keeps_its_attachments_when_the_server_confirms_it() Void!Str {
  let live = mut transcript::live()
  live.submit(
    "look",
    [
      transcript::Attachment{
        id: "attachment-1",
        image: true,
        filename: "shot.png",
      },
    ],
  )
  let _ = live.apply(
    sequenced(
      [
        sessionbridge::Event{
          Kind: "user.message.added",
          TurnID: "turn-1",
          Text: "look",
        },
      ],
    ),
  )
  let user = live.messages.at(0).expect("user")
  testing::assert(
    user.turn_id == "turn-1" and user.attachments.size() == 1 and user.attachments.at(0).expect("file").filename == "shot.png",
    "the confirmed prompt still lists its file",
  )
}

test fn replayed_events_are_ignored() Void!Str {
  let live = mut transcript::live()
  let stream = sequenced([assistant_started(), text_delta("one"), text_delta(" two")])
  let _ = live.apply(stream.slice(end: 2).expect("first batch").to_list())
  let _ = live.apply(stream.slice(start: 1).expect("overlapping batch").to_list())
  let text = live.messages.at(0).expect("assistant").text
  testing::assert(text == "one two", text)
}

// Places events on one server stream from `start`.
fn on_stream(stream_id: Str, start: Int, events: [sessionbridge::Event]) [sessionbridge::Event] {
  let placed = mut List::new<sessionbridge::Event>()
  mut next = Int64::from(start)
  for event in events {
    let copy = mut event
    copy.StreamID = stream_id
    copy.Sequence = next
    placed.push(copy.@)
    next =+ 1
  }
  placed.@
}

test fn a_replacement_stream_continues_the_live_turn_and_ignores_the_replaced_one() Void!Str {
  let live = mut transcript::live()
  let _ = live.apply(
    on_stream("stream-a", 1, [event("turn.started"), assistant_started(), text_delta("one")]),
  )
  live.adopt_stream(
    protocol::SessionSnapshot{
      ActiveTurnID: "turn-1",
      EventStreamID: "stream-b",
      EventCursor: 0,
      EventReplayAvailable: false,
    },
  )
  // The replaced stream's in-flight delta must not land after the switch.
  let _ = live.apply(on_stream("stream-a", 4, [text_delta(" stale")]))
  let _ = live.apply(on_stream("stream-b", 1, [text_delta(" two")]))
  let text = live.messages.at(0).expect("assistant").text
  try testing::assert(text == "one two", "renumbered events continue the reply: {text}")
  testing::assert(live.activity != "", "the turn remains active")
}

test fn streamed_thinking_shows_its_latest_line_as_activity() Void!Str {
  let live = mut transcript::live()
  let thinking = sessionbridge::Event{
    Kind: "assistant.thinking.delta",
    TurnID: "turn-1",
    MessageID: "assistant-1",
    ContentIndex: 0,
    Delta: "Reading files\nPlanning the change\n",
  }
  let follow = live.apply(sequenced([thinking]))
  try testing::assert(follow, "thinking asks a pinned view to follow")
  try testing::assert(live.activity == "Planning the change", live.activity)
  testing::assert(
    live.messages.at(0).expect("assistant").thinking == "Reading files\nPlanning the change\n",
    "thinking is kept",
  )
}

test fn tools_attach_to_their_turn_and_unrun_plans_settle_at_run_end() Void!Str {
  let live = mut transcript::live()
  let _ = live.apply(
    sequenced(
      [
        sessionbridge::Event{
          Kind: "tool.planned",
          TurnID: "turn-1",
          ToolCallID: "call-1",
          ToolName: "read",
        },
        sessionbridge::Event{
          Kind: "tool.planned",
          TurnID: "turn-1",
          ToolCallID: "call-2",
          ToolName: "bash",
        },
        sessionbridge::Event{
          Kind: "tool.completed",
          TurnID: "turn-1",
          ToolCallID: "call-1",
          ToolName: "read",
          Content: [sessionbridge::Content{Kind: "text", Text: "file body"}],
        },
        event("turn.completed"),
      ],
    ),
  )
  try testing::assert(
    describe(live.messages) == "[assistant live-assistant:call-1 ][tool live-tool:call-1 file body][tool live-tool:call-2 ]",
    describe(live.messages),
  )
  try testing::assert(
    live.messages.at(0).expect("assistant").tool_calls.size() == 2,
    "both calls belong to the turn's assistant",
  )
  try testing::assert(
    live.messages.at(1).expect("read").tool_state == transcript::ToolState::completed,
    "completed tool",
  )
  testing::assert(
    live.messages.at(2).expect("bash").tool_state == transcript::ToolState::not_run,
    "unrun plan settles",
  )
}

test fn projection_skips_empty_messages_and_marks_tool_results() Void!Str {
  let projected = transcript::project(
    [
      protocol::TranscriptMessage{ID: "empty", Role: "assistant"},
      protocol::TranscriptMessage{
        ID: "user-1",
        Role: "user",
        Content: [protocol::TextBlock("question")],
      },
      protocol::TranscriptMessage{
        ID: "failed",
        Role: "assistant",
        ErrorMessage: "provider unavailable",
      },
      protocol::TranscriptMessage{
        ID: "tool-1",
        Role: "tool",
        ToolName: "bash",
        IsError: true,
      },
    ],
  )
  try testing::assert(
    describe(projected) == "[user user-1 question][assistant failed provider unavailable][tool tool-1 ]",
    describe(projected),
  )
  testing::assert(
    projected.at(2).expect("tool").tool_state == transcript::ToolState::failed,
    "failed tool result",
  )
}

test fn user_attachments_project_as_labels() Void!Str {
  let projected = transcript::project(
    [
      protocol::TranscriptMessage{
        ID: "user-1",
        Role: "user",
        Content: [
          protocol::TextBlock("look"),
          protocol::NewTranscriptContent(
            protocol::ImageContent{
              Filename: "shot.png",
              MediaType: "image/png",
              AttachmentID: "attachment-1",
            },
          ),
          protocol::NewTranscriptContent(
            protocol::FileContent{
              Filename: "notes.txt",
              MediaType: "text/plain",
              AttachmentID: "attachment-2",
            },
          ),
        ],
      },
      protocol::TranscriptMessage{
        ID: "user-2",
        Role: "user",
        Content: [
          protocol::NewTranscriptContent(
            protocol::FileContent{
              Filename: "only.txt",
              MediaType: "text/plain",
              AttachmentID: "attachment-3",
            },
          ),
        ],
      },
    ],
  )
  let first = projected.at(0).expect("first")
  try testing::assert(first.text == "look" and first.attachments.size() == 2, "text and two files")
  try testing::assert(
    first.attachments.at(0).expect("image").image and first.attachments.at(0).expect("image").filename == "shot.png" and first.attachments.at(0).expect("image").id == "attachment-1",
    "the image",
  )
  try testing::assert(
    (not first.attachments.at(1).expect("file").image) and first.attachments.at(1).expect("file").filename == "notes.txt",
    "the file",
  )
  testing::assert(
    projected.size() == 2 and projected.at(1).expect("second").attachments.size() == 1,
    "a message of only attachments is kept",
  )
}

// Persisted user messages named by ID at the given session sequences.
fn persisted(ids: [Str], sequences: [Int]) [transcript::Message] {
  let source = mut List::new<protocol::TranscriptMessage>()
  mut index = 0
  while index < ids.size() {
    let id = ids.at(index).expect("message id")
    source.push(
      protocol::TranscriptMessage{
        ID: id,
        TurnID: "turn-{id}",
        Sequence: Int64::from(sequences.at(index).expect("message sequence")),
        Role: "user",
        Content: [protocol::TextBlock(id)],
      },
    )
    index =+ 1
  }
  transcript::project(source.@)
}

fn ids(messages: [transcript::Message]) Str {
  let result = mut List::new<Str>()
  for message in messages {
    result.push("{message.id}@{message.sequence}")
  }
  mut joined = ""
  for value in result {
    joined = match joined == "" {
      true => value,
      false => "{joined} {value}",
    }
  }
  joined
}

test fn an_overlapping_snapshot_keeps_loaded_history_in_front() Void!Str {
  let loaded = persisted(["a", "b", "c", "d"], [1, 2, 3, 4])
  let merged = transcript::merge_snapshot(loaded, persisted(["c", "d", "e"], [3, 4, 5]))
  try testing::assert(merged.preserved, "history is preserved")
  testing::assert(ids(merged.messages) == "a@1 b@2 c@3 d@4 e@5", ids(merged.messages))
}

test fn a_snapshot_that_does_not_line_up_replaces_loaded_history() Void!Str {
  let loaded = persisted(["a", "b", "c"], [1, 2, 3])
  // After compaction, a new message reuses a sequence that held another ID.
  let compacted = transcript::merge_snapshot(loaded, persisted(["summary", "c"], [2, 3]))
  try testing::assert(not compacted.preserved, "conflicting sequence replaces")
  try testing::assert(ids(compacted.messages) == "summary@2 c@3", ids(compacted.messages))
  let unrelated = transcript::merge_snapshot(loaded, persisted(["x", "y"], [7, 8]))
  try testing::assert(not unrelated.preserved, "no overlap replaces")
  testing::assert(ids(unrelated.messages) == "x@7 y@8", ids(unrelated.messages))
}

test fn earlier_pages_prepend_and_reject_overlap() Void!Str {
  let shown = persisted(["c", "d"], [3, 4])
  let merged = try transcript::prepend_history(persisted(["a", "b"], [1, 2]), shown) -> failure {
    Result::err("unexpected rejection: {failure}")
  }
  try testing::assert(ids(merged) == "a@1 b@2 c@3 d@4", ids(merged))
  let repeated = transcript::prepend_history(persisted(["b", "c"], [2, 3]), shown)
  testing::assert(repeated.is_err(), "a repeated message is rejected")
}
