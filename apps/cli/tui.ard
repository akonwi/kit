use ard/testing

use go:api
use go:api/contract as protocol
use go:context
use cooper
use cooper/cui
use cooper/event
use cooper/keymap
use cooper/program_status
use cooper/screen
use cooper/terminal_progress
use cooper/ui
use go:github.com/akonwi/kit/internal/theme as kittheme
use go:kit/ffi/cli
use go:kit/ffi/contextbridge
use kit/tui/bootstrap
use kit/tui/modal
use kit/tui/palette
use kit/tui/sessions
use kit/tui/shell
use kit/tui/terminal_status
use kit/tui/theme

// Kit's terminal client, built with Cooper.

// Runs the terminal client attached to the session selected by `options` and
// blocks until it exits.
fn run(options: cli::TUIOptions) Void!Error {
  let application = try cooper::app(exit_on_ctrl_c: false)
  let system = application.theme()
  defer application.destroy()
  let themes = theme::context(theme::store(theme::resolve(options.ThemeDefinition, system)))
  let props = shell::Props{
    options: options,
    themes: themes,
    quit: fn() {
      application.context.destroy_live()
    },
    attach: bootstrap::attach,
    terminal: terminal_status::Terminal{
      set_title: fn(value: Str) Bool {
        application.context.set_title(value)
      },
      progress: fn(state: terminal_progress::State) Bool {
        application.context.progress(state, Maybe::new<Int>())
      },
      bell: fn() Bool {
        application.context.bell()
      },
      notify: fn(message: Str, title: Str) Bool {
        application.context.notify(message, title: title)
      },
      program_status: fn(report: program_status::Report) Bool {
        application.context.program_status(report)
      },
      program_status_supported: fn() Bool {
        application.context.program_status_supported()
      },
      focused: fn() Bool {
        match application.context.terminal_focus() {
          focus => focus == event::TerminalFocus::gained,
          _ => false,
        }
      },
    },
    open_url: fn(target: Str) Void!Error {
      application.context.open_url(target)
    },
  }
  let renderer = cui::mount(application, cui::child(shell::new, props))
  defer renderer.destroy()
  application.run()
}

let picker_min_rows = 10
let picker_max_rows = 20
// The picker frame: borders, title, search field, footer, and their rules.
let picker_chrome_rows = 8

// The inline session picker's height: a row per session and the frame, between
// 10 and 20 rows. A failed list uses the minimum.
fn picker_height(listed: [protocol::SessionInfo]?) Int {
  let rows = match listed {
    sessions => sessions.size() + picker_chrome_rows,
    _ => picker_min_rows,
  }
  match {
    rows < picker_min_rows => picker_min_rows,
    rows > picker_max_rows => picker_max_rows,
    _ => rows,
  }
}

private struct Choice {
  id: Str,
}

// Presents saved sessions in a picker drawn below the shell prompt rather
// than full screen, and returns the chosen session's ID, or an empty ID when
// it is dismissed. The picker's rows are cleared when it closes. A Cooper
// inline app keeps its height, so the sessions are listed first to size it.
fn pick_session(
  ctx: context::Context,
  client: mut api::Client,
  home: Str,
  definition: kittheme::Definition,
) Str!Error {
  let listed = match client.ListSessions(ctx, api::ListSessionsOptions{CWD: ""}) {
    ok(found) => Maybe::new(found),
    err(_) => Maybe::new<[protocol::SessionInfo]>(),
  }
  // Activity is optional; without it the picker tries again once it opens.
  let activity = match client.SessionActivity(ctx) {
    ok(found) => Maybe::new(found),
    err(_) => Maybe::new<[protocol::SessionActivityEntry]>(),
  }
  let application = try cooper::app(
    // Inline screens keep their last frame by default; the picker's rows are
    // erased instead, leaving the cursor where they began.
    exit_on_ctrl_c: false,
    screen: screen::config(screen::Mode::inline, height: picker_height(listed), clear_on_exit: true),
  )
  defer application.destroy()
  let themes = theme::context(theme::store(theme::resolve(definition, application.theme())))
  let lifetime = contextbridge::WithCancel(ctx)
  defer lifetime.Cancel()
  let choice = mut Choice{id: ""}
  let close = keymap::simple_command("sessions.dismiss", "Close", fn() Bool {
    application.context.destroy_live()
    true
  })
  let props = sessions::Props{
    themes: themes,
    client: client,
    lifetime: lifetime,
    current_session_id: "",
    home: home,
    dismiss: close,
    renamed: fn(session: protocol::SessionInfo) {},
    applied: fn(session: mut api::Session, snapshot: protocol::SessionSnapshot) {},
    choose: fn(id: Str) {
      choice.id = id
      application.context.destroy_live()
    },
    listed: listed,
    activity: activity,
    placement: modal::Placement::region,
  }
  // Ctrl+C closes the picker from anywhere.
  let root = cui::box(
    [cui::child(sessions::new, props)],
    key: "session-picker",
    styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
    commands: [close],
    bindings: [keymap::binding(keymap::key("c", ctrl: true), close.with())],
    binding_scope: keymap::ScopeMode::application,
  )
  let renderer = cui::mount(application, root)
  defer renderer.destroy()
  try application.run()
  Result::ok(choice.id)
}

// The server picker's frame: borders, title, search field, footer, and their
// rules, as the session picker's.
let server_picker_chrome_rows = 8

// The attach picker's rows: one per server, offering every server that can be
// attached. This home's own server and an SSH server are started when needed;
// another saved server that is not running cannot be picked, and shows why.
fn server_items(servers: [cli::ServerChoice]) [palette::Item] {
  let items = mut List::new<palette::Item>()
  for server in servers {
    let attachable = server.Status == "running" or server.Starts and server.Status == "not running"
    items.push(
      palette::Item{
        key: server.Name,
        label: server.Name,
        hint: "",
        description: server.Location,
        meta: match attachable {
          true => server.Status,
          false => "",
        },
        search_terms: [server.Location],
        disabled_reason: match attachable {
          true => "",
          false => server.Status,
        },
      },
    )
  }
  items.@
}

// Presents the servers `kit attach` can attach to in a picker drawn below the
// shell prompt, and returns the chosen server's name, or an empty name when it
// is dismissed. The picker's rows are cleared when it closes.
fn pick_server(servers: [cli::ServerChoice], definition: kittheme::Definition) Str!Error {
  let rows = servers.size() + server_picker_chrome_rows
  let application = try cooper::app(
    exit_on_ctrl_c: false,
    screen: screen::config(
      screen::Mode::inline,
      height: match {
        rows < picker_min_rows => picker_min_rows,
        rows > picker_max_rows => picker_max_rows,
        _ => rows,
      },
      clear_on_exit: true,
    ),
  )
  defer application.destroy()
  let themes = theme::context(theme::store(theme::resolve(definition, application.theme())))
  let choice = mut Choice{id: ""}
  let close = keymap::simple_command("servers.dismiss", "Close", fn() Bool {
    application.context.destroy_live()
    true
  })
  let props = palette::PickerProps{
    themes: themes,
    catalog: server_items(servers),
    placeholder: "Search servers…",
    initial_selection: "",
    title: "Attach to server",
    footer: "",
    error: "",
    dismiss: close,
    placement: Maybe::new(modal::Placement::region),
    on_query_change: fn(query: Str) {},
    on_selection_change: fn(selected: Str) {},
    on_activate: fn(item: palette::Item) {
      choice.id = item.key
      application.context.destroy_live()
    },
  }
  // Ctrl+C closes the picker from anywhere.
  let root = cui::box(
    [cui::child(palette::new_picker, props)],
    key: "server-picker",
    styles: ui::style(width: ui::percent(100.0), height: ui::percent(100.0)),
    commands: [close],
    bindings: [keymap::binding(keymap::key("c", ctrl: true), close.with())],
    binding_scope: keymap::ScopeMode::application,
  )
  let renderer = cui::mount(application, root)
  defer renderer.destroy()
  try application.run()
  Result::ok(choice.id)
}

test fn only_running_servers_and_servers_attaching_starts_can_be_picked() Void!Str {
  let rows = server_items(
    [
      cli::ServerChoice{
        Name: "local",
        Location: "~/.kit",
        Status: "not running",
        Starts: true,
      },
      cli::ServerChoice{
        Name: "devbox",
        Location: "me@devbox",
        Status: "not running",
        Starts: true,
      },
      cli::ServerChoice{
        Name: "stopped",
        Location: "/tmp/kit-stopped",
        Status: "not running",
      },
      cli::ServerChoice{
        Name: "dev",
        Location: "/tmp/kit-dev",
        Status: "running",
      },
      cli::ServerChoice{
        Name: "old",
        Location: "~/.kit-old",
        Status: "incompatible",
      },
    ],
  )
  mut shown = ""
  for row in rows {
    shown = shown + "{row.label}|{row.description}|{row.meta}|{row.disabled_reason}\n"
  }
  let expected = "local|~/.kit|not running|\ndevbox|me@devbox|not running|\nstopped|/tmp/kit-stopped||not running\ndev|/tmp/kit-dev|running|\nold|~/.kit-old||incompatible\n"
  testing::assert(shown == expected, shown)
}
