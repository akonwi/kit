use cooper/cui

// Work that must wait for the pending commit, such as revealing a row once
// its list has laid out or focusing a control once it has mounted. Cooper's
// commit hooks run after every commit until removed, so one-time work removes
// its hook when it runs.

private struct Once {
  done: Bool,
  cancel: fn(),
}

// once runs work after the pending commit, and only then. The returned
// function cancels it if it has not run.
fn once(context: cui::Context, work: fn()) fn() {
  let state = mut Once{done: false, cancel: fn() {}}
  let cancel = (context.internal_commit)(
    fn() {
      if not state.done {
        state.done = true
        state.cancel()
        work()
      }
    },
  )
  state.cancel = cancel
  fn() {
    state.done = true
    cancel()
  }
}
