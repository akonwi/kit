use ard/async
use ard/testing
use ard/unsafe

use go:api
use go:api/contract as protocol
use go:context
use cooper/event
use go:errors
use go:fmt
use go:github.com/akonwi/kit/internal/identifier
use go:kit/ffi/cli
use go:kit/ffi/contextbridge
use go:kit/ffi/sessionbridge
use kit/tui/bootstrap
use kit/tui/toast
use kit/tui/transcript
use kit/tui/turn_follower
use go:strings

// The attached-session owner. One Controller represents one client-side
// attachment lifetime: its session handle and cancellation, authoritative
// snapshot projections, live turn transcript, and session-scoped operations.
//
// Shell renders this state, so every mutation is scheduled through the host's
// dispatch. Replacing an attachment disposes the old Controller; completions
// that arrive afterward observe `active == false` and are discarded, which
// also rejects stale `A₁ → B → A₂` callbacks for the same durable session.
//
// Shell reads Controller fields for presentation but mutates them only through
// Controller methods.

// Host lists the root-owned effects an attachment may request. All callbacks
// run on the UI thread inside `dispatch`.
struct Host {
  // Schedules a mutation through the component that renders the attachment.
  dispatch: fn(fn()) Void!event::DispatchError,
  toast: fn(Str, Str, toast::Variant, Bool),
  // Replaces this attachment with a newly created session.
  attach: fn(bootstrap::Attached, Str),
  // Returns a failed prompt to the composer when it has not been reused.
  restore_draft: fn(Str),
  // Returns the transcript to its end after a local submission.
  show_latest: fn(),
}

struct Controller {
  options: cli::TUIOptions,
  host: Host,
  // Identifies this attachment for keyed retained presentation.
  scope_id: Int,
  active: Bool,
  lifetime: contextbridge::Cancellation?,
  session: (mut api::Session)?,
  info: protocol::SessionInfo?,
  location: Str,
  prompt_commands: [protocol::PromptCommand],
  plugin_commands: [protocol::PluginCommand],
  follow_ups: protocol::FollowUpQueue,
  messages: [transcript::Message],
  // Earlier transcript pages. The cursor is the oldest loaded message;
  // `history_scope` advances whenever the cursor is replaced so an in-flight
  // page for a superseded cursor is ignored.
  history_initialized: Bool,
  history_cursor: Str,
  history_more: Bool,
  history_loading: Bool,
  history_failure: Str,
  history_scope: Int,
  live: transcript::Live,
  run_id: Str,
  // How the stream of `recovering_run` is being recovered. It is shown only
  // while that turn is the active one.
  recovery: turn_follower::Recovery,
  recovering_run: Str,
  context_tokens: Int,
  context_window: Int,
  usage: protocol::SessionUsage,
  mcp_servers: [protocol::MCPServerStatus],
  mcp_warnings: [Str],
  shown_mcp_warnings: [Str],
  notice: Str,
  start_pending: Bool,
  new_session_pending: Bool,
  reload_pending: Bool,
  compact_pending: Bool,
  compact_operation_id: Str,
  abort_pending: Bool,
  abort_after_start: Bool,
  scratchpad_record: protocol::Scratchpad?,
  scratchpad_loading: Bool,
  scratchpad_failure: Str,
  // The server's explanation once it can no longer serve this client. The
  // attachment is then frozen: its transcript and draft stay visible, but it
  // makes no further requests.
  incompatible: Str,
  // Pending model and plugin requests in arrival order. The oldest is
  // presented.
  interactions: [protocol::InteractionRequest],
  // Recently settled request IDs. The session watch and a turn stream can
  // each deliver a request, so a late copy must not reopen it.
  settled_interactions: [Str],
  // The request whose response is being submitted, if any.
  interaction_responding: Str,
}

// The result of one earlier-transcript request: a page, a fresh snapshot
// after the cursor expired, or a failure.
private struct HistoryOutcome {
  page: protocol::TranscriptPage?,
  snapshot: protocol::SessionSnapshot?,
  failure: Str,
  incompatible: Bool,
}

private fn empty_usage() protocol::SessionUsage {
  protocol::SessionUsage{
    Input: 0,
    Output: 0,
    CacheRead: 0,
    CacheWrite: 0,
    Reasoning: 0,
    TotalTokens: 0,
    Cost: protocol::SessionUsageCost{
      Input: 0.0,
      Output: 0.0,
      CacheRead: 0.0,
      CacheWrite: 0.0,
      Total: 0.0,
    },
  }
}

private fn controller(options: cli::TUIOptions, host: Host, scope_id: Int, location: Str) mut Controller {
  (mut Controller{
    options: options,
    host: host,
    scope_id: scope_id,
    active: false,
    lifetime: Maybe::new<contextbridge::Cancellation>(),
    session: Maybe::new<mut api::Session>(),
    info: Maybe::new<protocol::SessionInfo>(),
    location: location,
    prompt_commands: [],
    plugin_commands: [],
    follow_ups: protocol::FollowUpQueue{
      Count: 0,
      Previews: [],
      AnnotationIDs: [],
    },
    messages: [],
    history_initialized: false,
    history_cursor: "",
    history_more: false,
    history_loading: false,
    history_failure: "",
    history_scope: 0,
    live: transcript::live(),
    run_id: "",
    recovery: turn_follower::Recovery::healthy,
    recovering_run: "",
    context_tokens: 0,
    context_window: 0,
    usage: empty_usage(),
    mcp_servers: [],
    mcp_warnings: [],
    shown_mcp_warnings: [],
    notice: "",
    start_pending: false,
    new_session_pending: false,
    reload_pending: false,
    compact_pending: false,
    compact_operation_id: "",
    abort_pending: false,
    abort_after_start: false,
    interactions: [],
    settled_interactions: [],
    interaction_responding: "",
    scratchpad_record: Maybe::new<protocol::Scratchpad>(),
    scratchpad_loading: false,
    scratchpad_failure: "",
    incompatible: "",
  })
}

// detached is the inert attachment shown before bootstrap completes. It owns
// no session and ignores every operation.
fn detached(options: cli::TUIOptions, host: Host) mut Controller {
  controller(options, host, 0, options.Location)
}

// attach adopts an attached session under a new cancellation scope derived
// from `parent`. Call `start` once the Controller is installed.
fn attach(
  options: cli::TUIOptions,
  host: Host,
  scope_id: Int,
  parent: contextbridge::Cancellation,
  attached: bootstrap::Attached,
  location: Str,
) mut Controller {
  let result = controller(options, host, scope_id, location)
  result.active = true
  result.lifetime = Maybe::new(contextbridge::WithCancel(parent.Context))
  result.session = Maybe::new(attached.session)
  result.apply_snapshot(attached.snapshot)
  match attached.failed_first_message {
    failure => result.present_failed_first_message(failure),
    _ => (),
  }
  result
}

// Attaches a session this client just created or forked and reads its
// snapshot. It runs on a worker under the request's deadline.
private fn attach_new_session(
  client: mut api::Client,
  ctx: context::Context,
  info: protocol::SessionInfo,
  failed_first_message: bootstrap::FailedFirstMessage?,
) bootstrap::Attached!Str {
  match client.Attach(ctx, info.ID) {
    ok(session) => {
      match session.Snapshot(ctx) {
        ok(snapshot) => {
          Result::ok(
            bootstrap::Attached{
              info: info,
              session: session,
              snapshot: snapshot,
              failed_first_message: failed_first_message,
            },
          )
        },
        err(failure) => Result::err(failure.error()),
      }
    },
    err(failure) => Result::err(failure.error()),
  }
}

// The fork's first message when the server published the child without
// starting it.
private fn failed_first_message(message: Str, forked: protocol::ForkSessionResult) bootstrap::FailedFirstMessage? {
  match message == "" or unsafe::is_nil(forked.FirstTurnError) {
    true => Maybe::new<bootstrap::FailedFirstMessage>(),
    false => {
      Maybe::new(
        bootstrap::FailedFirstMessage{text: message, reason: forked.FirstTurnError.Message},
      )
    },
  }
}

impl Controller {
  // start opens the session watches and follows a turn already in progress.
  fn mut start(active_turn_id: Str) {
    self.watch()
    self.watch_plugin_toasts()
    self.follow_run(active_turn_id)
  }

  // dispose cancels this attachment's requests and streams. Queued
  // completions become no-ops.
  fn mut dispose() {
    self.active = false
    match self.lifetime {
      lifetime => lifetime.Cancel(),
      _ => (),
    }
  }

  // Whether a prompt can be submitted to this attachment.
  fn can_submit() Bool {
    self.active and self.connected() and self.session.is_some() and self.lifetime.is_some()
  }

  // Whether the server can still serve this attachment.
  fn connected() Bool {
    self.incompatible == ""
  }

  // Decides how a failed session operation is presented. A server that can
  // no longer serve this client freezes the attachment instead of reporting
  // the operation; once frozen, failures of the cancelled work are expected.
  // Returns true when the caller should report nothing.
  private fn mut absorbs(failure: Error) Bool {
    if sessionbridge::Incompatible(failure) {
      self.freeze(failure.error())
    }
    not self.connected()
  }

  // Stops this attachment's streams and requests while keeping what it shows.
  // Restarting Kit is the recovery: the replacement server serves another
  // release, so rechecking from this client cannot succeed.
  private fn mut freeze(reason: Str) {
    if self.active and self.connected() {
      self.incompatible = reason
      match self.lifetime {
        lifetime => lifetime.Cancel(),
        _ => (),
      }
      self.run_id = ""
      self.recovery = turn_follower::Recovery::healthy
      self.start_pending = false
      self.abort_pending = false
      self.abort_after_start = false
      self.compact_pending = false
      self.compact_operation_id = ""
      self.reload_pending = false
      self.new_session_pending = false
      self.history_loading = false
      self.interactions = []
      self.interaction_responding = ""
      self.live.activity = ""
      self.live.thinking = ""
      (self.host.toast)("Server compatibility changed", reason, toast::Variant::error, true)
    }
  }

  // Whether idle-only commands must wait for active session work.
  fn busy() Bool {
    self.run_id != "" or self.start_pending or self.compact_pending
  }

  // The oldest pending request that this client presents.
  fn interaction() protocol::InteractionRequest? {
    self.interactions.at(0)
  }

  // Whether the agent is waiting for an answer from the user.
  fn feedback_pending() Bool {
    self.active and self.interactions.size() > 0
  }

  // The current pending-row activity, if any.
  fn activity() Str {
    match {
      self.feedback_pending() => "Waiting for feedback…",
      self.live.activity != "" => self.live.activity,
      self.compact_pending => "Compacting session…",
      _ => "",
    }
  }

  fn session_id() Str {
    match self.info {
      info => info.ID,
      _ => "",
    }
  }

  // The settled transcript followed by the active turn's live messages.
  fn transcript_messages() [transcript::Message] {
    let messages = mut List::new<transcript::Message>()
    for message in self.messages {
      messages.push(message)
    }
    for message in self.live.messages {
      messages.push(message)
    }
    messages.@
  }

  // Adopts an authoritative session record returned by a child request.
  // Records for another session are ignored.
  fn mut apply_info(session: protocol::SessionInfo) {
    if self.active and session.ID == self.session_id() {
      self.info = Maybe::new(session)
    }
  }

  // request_info schedules an authoritative record reported by a dialog that
  // configured this session. It is ignored once this attachment is replaced.
  fn mut request_info(session: protocol::SessionInfo) {
    let _ = (self.host.dispatch)(
      fn() {
        self.apply_info(session)
      },
    )
  }

  // Replaces the transcript with a server snapshot unless live events have
  // already moved past it.
  fn mut apply_snapshot(snapshot: protocol::SessionSnapshot) {
    if not self.live.supersedes(snapshot) {
      self.info = Maybe::new(snapshot.Session)
      self.prompt_commands = snapshot.PromptCommands
      self.plugin_commands = snapshot.PluginCommands
      self.follow_ups = snapshot.FollowUps
      self.context_tokens = snapshot.ContextTokens
      self.context_window = snapshot.ContextWindow
      self.usage = snapshot.Usage
      // The attached session snapshot already carries the authoritative
      // Scratchpad. Reuse it instead of issuing a second request when the pane
      // opens; that request mutates the public Session cache while its watch is
      // active and adds avoidable renderer work to a workspace transition.
      if unsafe::is_nil(snapshot.Scratchpad) {
        self.scratchpad_record = Maybe::new<protocol::Scratchpad>()
      } else {
        self.scratchpad_record = Maybe::new(snapshot.Scratchpad.@)
      }
      self.scratchpad_loading = false
      self.scratchpad_failure = ""
      // A settled authoritative snapshot releases idle-only palette commands
      // even when a terminal stream event was missed during reconnection.
      if snapshot.ActiveTurnID == "" and self.live.activity == "" {
        self.run_id = ""
        self.abort_pending = false
        self.abort_after_start = false
      }
      self.interactions = []
      for request in snapshot.PendingInteractions {
        self.add_interaction(request)
      }
      self.mcp_servers = snapshot.MCPServers
      self.mcp_warnings = snapshot.MCPWarnings
      for warning in snapshot.MCPWarnings {
        mut already_shown = false
        for shown in self.shown_mcp_warnings {
          if shown == warning {
            already_shown = true
          }
        }
        if not already_shown {
          self.shown_mcp_warnings.push(warning)
          (self.host.toast)("MCP configuration warning", warning, toast::Variant::warning, true)
        }
      }
      // Watch snapshots can lag the active turn. Keep its complete live tail
      // (including the optimistic user row) until turn settlement; a snapshot
      // that happens to include the user event can still omit later live
      // content and must not replace it.
      if snapshot.ActiveTurnID == "" or not self.live.blocks_snapshot_replacement() {
        let merged = transcript::merge_snapshot(
          self.messages,
          transcript::project(snapshot.Messages),
        )
        self.messages = merged.messages
        if not merged.preserved {
          self.reset_history(snapshot)
        }
        self.live.reset()
      } else {
        self.live.adopt_stream(snapshot)
      }
      if not self.history_initialized {
        self.reset_history(snapshot)
      }
    }
  }

  // Applies the authoritative batch already delivered by Session.Watch.
  fn mut apply_watched_events(batch: [protocol::SessionEvent]) {
    self.apply_events(sessionbridge::Events(mut batch))
  }

  // A remote client can start the turn, and one session batch can finish a
  // turn before starting its queued successor, so lifecycle and transcript
  // updates are reduced together in wire order.
  fn mut apply_events(events: [sessionbridge::Event]) {
    for event in events {
      let kind = transcript::classify(event.Kind)
      if event.Kind == "scratchpad.changed" and not unsafe::is_nil(event.Scratchpad) {
        self.scratchpad_record = Maybe::new(event.Scratchpad.@)
        self.scratchpad_failure = ""
      }
      if kind == transcript::Event::run_started {
        self.claim_run(event.TurnID)
      }
      if event.Kind == "interaction.requested" and not unsafe::is_nil(event.Interaction) {
        self.add_interaction(event.Interaction.@)
      }
      if event.Kind == "interaction.resolved" {
        self.remove_interaction(event.InteractionID)
      }
      // A transcript pinned to its end follows new content on its own.
      let _ = self.live.apply_event(event)
      if kind == transcript::Event::run_finished and event.TurnID == self.run_id {
        self.run_id = ""
        self.abort_pending = false
        self.abort_after_start = false
      }
    }
    if self.live.context_window > 0 {
      self.context_tokens = self.live.context_tokens
      self.context_window = self.live.context_window
    }
    if self.live.activity == "" {
      self.abort_pending = false
    }
  }

  // Streams server-owned plugin notifications through the reconnecting public
  // session handle. The stream remains fresh-only across reconnects.
  private fn mut watch_plugin_toasts() {
    match self.lifetime {
      lifetime => {
        match self.session {
          session => {
            let ctx = lifetime.Context
            let dispatch = self.host.dispatch
            async::start(fn() {
              match session.WatchPluginToasts(ctx) {
                ok(stream) => {
                  let updates = stream.Updates()
                  mut open = true
                  while open {
                    match updates.recv() {
                      notification => {
                        let _ = dispatch(fn() {
                          if self.active {
                            let variant = match notification.Variant.to_str() {
                              "warning" => toast::Variant::warning,
                              "error" => toast::Variant::error,
                              _ => toast::Variant::info,
                            }
                            let detail = match notification.Subtitle == "" {
                              true => "",
                              false => "{notification.PluginID} · {notification.Subtitle}",
                            }
                            (self.host.toast)(
                              notification.Title,
                              detail,
                              variant,
                              notification.Persistent,
                            )
                          }
                        })
                      },
                      _ => { open = false },
                    }
                  }
                  match stream.Err() {
                    err(failure) => {
                      let _ = dispatch(fn() {
                        if self.active and not self.absorbs(failure) {
                          (self.host.toast)(
                            "Plugin notifications unavailable",
                            failure.error(),
                            toast::Variant::error,
                            true,
                          )
                        }
                      })
                    },
                    ok(_) => (),
                  }
                },
                err(failure) => {
                  let _ = dispatch(fn() {
                    if self.active and not self.absorbs(failure) {
                      (self.host.toast)(
                        "Plugin notifications unavailable",
                        failure.error(),
                        toast::Variant::error,
                        true,
                      )
                    }
                  })
                },
              }
            })
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  // Watches the attached session through the public client's reconnecting
  // stream. Initial and replay-gap updates carry authoritative snapshots.
  private fn mut watch() {
    match self.lifetime {
      lifetime => {
        match self.session {
          session => {
            let ctx = lifetime.Context
            let dispatch = self.host.dispatch
            async::start(fn() {
              match session.Watch(ctx) {
                ok(stream) => {
                  let updates = stream.Updates()
                  mut open = true
                  while open {
                    match updates.recv() {
                      update => {
                        if unsafe::is_nil(update.Snapshot) {
                          mut finished = false
                          for event in update.Events {
                            if transcript::classify(event.Kind().to_str()) == transcript::Event::run_finished {
                              finished = true
                            }
                          }
                          let batch = update.Events
                          let _ = dispatch(fn() {
                            if self.active {
                              self.apply_watched_events(batch)
                            }
                          })
                          if finished {
                            match session.Snapshot(ctx) {
                              ok(settled) => {
                                let _ = dispatch(fn() {
                                  if self.active {
                                    self.apply_snapshot(settled)
                                  }
                                })
                              },
                              err(_) => (),
                            }
                          }
                        } else {
                          let snapshot = update.Snapshot.@
                          let _ = dispatch(fn() {
                            if self.active {
                              self.apply_snapshot(snapshot)
                            }
                          })
                        }
                      },
                      _ => { open = false },
                    }
                  }
                  match stream.Err() {
                    err(failure) => {
                      let _ = dispatch(fn() {
                        if self.active and not self.absorbs(failure) {
                          (self.host.toast)(
                            "Session connection lost",
                            failure.error(),
                            toast::Variant::error,
                            true,
                          )
                        }
                      })
                    },
                    ok(_) => (),
                  }
                },
                err(failure) => {
                  let _ = dispatch(fn() {
                    if self.active and not self.absorbs(failure) {
                      (self.host.toast)(
                        "Session connection failed",
                        failure.error(),
                        toast::Variant::error,
                        true,
                      )
                    }
                  })
                },
              }
            })
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  // Records a turn discovered by the session-wide watch without opening a
  // competing stream or consuming an abort queued for a local submission.
  private fn mut claim_run(run_id: Str) {
    if run_id != "" {
      self.run_id = run_id
    }
  }

  // Follows turns initiated locally or found in the attachment snapshot. The
  // session-wide watch also applies every live batch, while this turn stream
  // supplies replay needed when attaching in the middle of an active turn. A
  // lost stream is recovered by `turn_follower::follow`.
  private fn mut follow_run(run_id: Str) {
    if run_id != "" {
      if run_id == self.run_id {
        if self.abort_after_start {
          self.abort_after_start = false
          self.abort_run()
        }
      } else {
        self.run_id = run_id
        if self.abort_after_start {
          self.abort_after_start = false
          self.abort_run()
        }
        match self.lifetime {
          lifetime => {
            match self.session {
              session => {
                let follower = self.turn_follower(session, lifetime.Context)
                async::start(fn() {
                  turn_follower::follow(follower, run_id)
                })
              },
              _ => (),
            }
          },
          _ => (),
        }
      }
    }
  }

  // The session requests a turn follower makes and the attachment updates it
  // schedules. Updates apply only while their turn is still the active one.
  private fn mut turn_follower(session: mut api::Session, ctx: context::Context) turn_follower::Follower {
    let dispatch = self.host.dispatch
    turn_follower::Follower{
      stream: fn(run_id: Str, received: fn()) Void!Error {
        match session.Stream(ctx, run_id) {
          ok(stream) => {
            let updates = stream.Updates()
            mut open = true
            while open {
              match updates.recv() {
                batch => {
                  received()
                  let _ = dispatch(fn() {
                    if self.active and self.run_id == run_id {
                      self.show_recovery(run_id, turn_follower::Recovery::healthy)
                      self.apply_watched_events(batch)
                    }
                  })
                },
                _ => { open = false },
              }
            }
            stream.Err()
          },
          err(failure) => Result::err(failure),
        }
      },
      snapshot: fn() protocol::SessionSnapshot!Error {
        session.Snapshot(ctx)
      },
      status: fn(run_id: Str) protocol::TurnInfo!Error {
        session.Turn(ctx, run_id)
      },
      wait: fn(milliseconds: Int64) Bool {
        contextbridge::Wait(ctx, milliseconds)
      },
      ended: fn() Bool {
        contextbridge::Done(ctx)
      },
      rebase: fn(run_id: Str, snapshot: protocol::SessionSnapshot) {
        let _ = dispatch(fn() {
          if self.active and self.run_id == run_id {
            self.apply_snapshot(snapshot)
          }
        })
      },
      recover: fn(run_id: Str, recovery: turn_follower::Recovery) {
        let _ = dispatch(fn() {
          if self.active {
            self.show_recovery(run_id, recovery)
          }
        })
      },
      settle: fn(info: protocol::TurnInfo, snapshot: protocol::SessionSnapshot) {
        let _ = dispatch(fn() {
          if self.active {
            self.settle_run(info, snapshot)
          }
        })
      },
      abandon: fn(info: protocol::TurnInfo, failure: Error) {
        let _ = dispatch(fn() {
          if self.active {
            self.abandon_run(info, failure)
          }
        })
      },
      incompatible: fn(failure: Error) {
        let _ = dispatch(fn() {
          if self.active {
            let _ = self.absorbs(failure)
          }
        })
      },
    }
  }

  // The footer text for the active turn's stream recovery, if any.
  fn recovery_status() Str {
    match self.run_id != "" and self.recovering_run == self.run_id {
      true => turn_follower::recovery_text(self.recovery),
      false => "",
    }
  }

  // Shows how the active turn's stream is being recovered. Seeing the turn
  // run again clears only reconnection; a final transcript sync is resolved by
  // the snapshot that settles the turn.
  fn mut show_recovery(run_id: Str, recovery: turn_follower::Recovery) {
    if self.run_id == run_id {
      if recovery != turn_follower::Recovery::healthy or self.recovery == turn_follower::Recovery::reconnecting {
        self.recovery = recovery
        self.recovering_run = run_id
      }
      // A turn whose final transcript is syncing no longer runs.
      if recovery == turn_follower::Recovery::syncing {
        self.live.activity = ""
        self.live.thinking = ""
      }
    }
  }

  // Settles a turn that finished while its stream was lost, from the final
  // snapshot. The snapshot may report a successor, which becomes active.
  fn mut settle_run(info: protocol::TurnInfo, snapshot: protocol::SessionSnapshot) {
    if self.run_id == info.TurnID {
      self.release_run()
      self.apply_snapshot(snapshot)
      mut persisted = false
      for message in snapshot.Messages {
        if message.TurnID == info.TurnID and message.IsError {
          persisted = true
        }
      }
      if not persisted {
        self.report_unsuccessful(info)
      }
      self.run_id = snapshot.ActiveTurnID
    }
  }

  // Settles a turn that finished while its stream was lost when its final
  // snapshot could not be fetched. The next snapshot replaces what is shown.
  fn mut abandon_run(info: protocol::TurnInfo, failure: Error) {
    if self.run_id == info.TurnID {
      self.live.settle()
      for message in self.live.messages {
        self.messages.push(message)
      }
      self.release_run()
      self.report_unsuccessful(info)
      (self.host.toast)(
        "Transcript refresh failed",
        "The next turn will retry. {failure.error()}",
        toast::Variant::error,
        true,
      )
    }
  }

  private fn mut release_run() {
    self.live.reset()
    self.run_id = ""
    self.abort_pending = false
    self.abort_after_start = false
    self.recovery = turn_follower::Recovery::healthy
    self.recovering_run = ""
  }

  // Adds an error row for a turn that did not complete.
  private fn mut report_unsuccessful(info: protocol::TurnInfo) {
    let status = info.Status.to_str()
    if status != "completed" {
      let row = mut transcript::message("", info.TurnID, transcript::Role::assistant)
      row.text = match info.ErrorMessage == "" {
        true => "Run {status}",
        false => info.ErrorMessage,
      }
      row.error_message = info.ErrorMessage
      row.is_error = true
      self.messages.push(row.@)
    }
  }

  // Whether Escape should target the current active droid turn.
  fn can_abort() Bool {
    self.active and (self.run_id != "" or self.start_pending) and self.live.activity != "" and (not self.abort_pending) and (not self.abort_after_start)
  }

  // Requests cancellation without changing the composer or adding transient
  // status UI. The streamed run-finished event remains authoritative.
  fn mut abort_run() Bool {
    if self.can_abort() {
      if self.run_id == "" {
        self.abort_after_start = true
      } else {
        match self.lifetime {
          lifetime => {
            match self.session {
              session => {
                let run_id = self.run_id
                let dispatch = self.host.dispatch
                self.abort_pending = true
                async::start(fn() {
                  let result = session.Abort(lifetime.Context, run_id)
                  let _ = dispatch(fn() {
                    match result {
                      err(failure) => {
                        let _ = self.absorbs(failure)
                      },
                      ok(_) => (),
                    }
                    if self.active and self.run_id == run_id {
                      self.abort_pending = false
                    }
                  })
                })
              },
              _ => (),
            }
          },
          _ => (),
        }
      }
    }
    true
  }

  // Compacts the session through its idempotent API and then refreshes the
  // snapshot. Its local activity is rendered in the reasoning slot, while only
  // failures produce persistent feedback.
  fn mut compact() {
    if self.active and not self.compact_pending {
      match identifier::New("compact_") {
        ok(operation_id) => {
          match self.lifetime {
            lifetime => {
              match self.session {
                session => {
                  let attempt = contextbridge::WithTimeout(lifetime.Context, Int64::from(120000))
                  let dispatch = self.host.dispatch
                  self.compact_pending = true
                  self.compact_operation_id = operation_id
                  async::start(fn() {
                    let result = session.Compact(
                      attempt.Context,
                      protocol::CompactSessionInput{OperationID: operation_id},
                    )
                    match result {
                      ok(_) => {
                        let snapshot = session.Snapshot(attempt.Context)
                        attempt.Cancel()
                        let _ = dispatch(fn() {
                          if self.active and self.compact_operation_id == operation_id {
                            self.compact_pending = false
                            self.compact_operation_id = ""
                            match snapshot {
                              ok(current) => self.apply_snapshot(current),
                              err(failure) => {
                                if not self.absorbs(failure) {
                                  (self.host.toast)(
                                    "Session compacted",
                                    "Session context was compacted. {failure}",
                                    toast::Variant::warning,
                                    true,
                                  )
                                }
                              },
                            }
                          }
                        })
                      },
                      err(failure) => {
                        attempt.Cancel()
                        let _ = dispatch(fn() {
                          if self.active and self.compact_operation_id == operation_id {
                            self.compact_pending = false
                            self.compact_operation_id = ""
                            if not self.absorbs(failure) {
                              (self.host.toast)(
                                "Compaction failed",
                                failure.error(),
                                toast::Variant::error,
                                true,
                              )
                            }
                          }
                        })
                      },
                    }
                  })
                },
                _ => (),
              }
            },
            _ => (),
          }
        },
        err(failure) => (self.host.toast)("Compaction failed", failure.error(), toast::Variant::error, true),
      }
    }
  }

  // Queues a request once, unless it has already settled.
  private fn mut add_interaction(request: protocol::InteractionRequest) {
    mut known = false
    for pending in self.interactions {
      if pending.ID == request.ID {
        known = true
      }
    }
    for settled in self.settled_interactions {
      if settled == request.ID {
        known = true
      }
    }
    if not known {
      self.interactions.push(request)
    }
  }

  // Settles a request, remembering a bounded number of settled IDs.
  private fn mut remove_interaction(id: Str) {
    let remembered = mut List::new<Str>()
    for settled in self.settled_interactions {
      if settled != id {
        remembered.push(settled)
      }
    }
    remembered.push(id)
    let recent = remembered.@
    self.settled_interactions = match recent.size() > 64 {
      true => recent.slice(start: recent.size() - 64).expect("recent settled requests").to_list(),
      false => recent,
    }
    let remaining = mut List::new<protocol::InteractionRequest>()
    for pending in self.interactions {
      if pending.ID != id {
        remaining.push(pending)
      }
    }
    self.interactions = remaining.@
    if self.interaction_responding == id {
      self.interaction_responding = ""
    }
  }

  // Earlier history continues from the snapshot's oldest message.
  private fn mut reset_history(snapshot: protocol::SessionSnapshot) {
    self.history_initialized = true
    self.history_cursor = snapshot.PreviousMessageCursor
    self.history_more = snapshot.HasMoreMessages and snapshot.PreviousMessageCursor != ""
    self.history_loading = false
    self.history_failure = ""
    self.history_scope = self.history_scope + 1
  }

  // Whether an earlier page can be requested now.
  fn can_load_older() Bool {
    self.active and self.history_more and (not self.history_loading) and self.history_cursor != "" and self.session.is_some() and self.lifetime.is_some()
  }

  // Loads the page of messages before the oldest one shown. One page is in
  // flight at a time. A cursor that is no longer valid, as after compaction,
  // is recovered from a fresh snapshot.
  fn mut load_older() {
    if self.can_load_older() {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              let dispatch = self.host.dispatch
              let cursor = self.history_cursor
              let scope = self.history_scope
              self.history_loading = true
              self.history_failure = ""
              async::start(fn() {
                let attempt = contextbridge::WithTimeout(lifetime.Context, Int64::from(30000))
                let outcome = mut HistoryOutcome{
                  page: Maybe::new<protocol::TranscriptPage>(),
                  snapshot: Maybe::new<protocol::SessionSnapshot>(),
                  failure: "",
                  incompatible: false,
                }
                match session.TranscriptPage(attempt.Context, cursor) {
                  ok(page) => { outcome.page = Maybe::new(page) },
                  err(failure) => {
                    match sessionbridge::CursorUnavailable(failure) {
                      true => {
                        match session.Snapshot(attempt.Context) {
                          ok(snapshot) => { outcome.snapshot = Maybe::new(snapshot) },
                          err(refresh_failure) => {
                            outcome.failure = refresh_failure.error()
                            outcome.incompatible = sessionbridge::Incompatible(refresh_failure)
                          },
                        }
                      },
                      false => {
                        outcome.failure = failure.error()
                        outcome.incompatible = sessionbridge::Incompatible(failure)
                      },
                    }
                  },
                }
                attempt.Cancel()
                let _ = dispatch(fn() {
                  if self.active and self.history_loading and self.history_scope == scope {
                    self.history_loading = false
                    match outcome.page {
                      page => self.prepend_page(page),
                      _ => {
                        match outcome.snapshot {
                          snapshot => self.recover_history(snapshot),
                          _ => {
                            match outcome.incompatible {
                              true => self.freeze(outcome.failure),
                              false => { self.history_failure = outcome.failure },
                            }
                          },
                        }
                      },
                    }
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  private fn mut prepend_page(page: protocol::TranscriptPage) {
    match transcript::prepend_history(transcript::project(page.Messages), self.messages) {
      ok(merged) => {
        self.messages = merged
        self.history_cursor = page.PreviousMessageCursor
        self.history_more = page.HasMoreMessages and page.PreviousMessageCursor != ""
      },
      err(failure) => { self.history_failure = failure },
    }
  }

  // The fresh snapshot restarts history from its own cursor. Its durable
  // messages replace those shown; a turn still streaming keeps its live tail.
  private fn mut recover_history(snapshot: protocol::SessionSnapshot) {
    self.messages = transcript::project(snapshot.Messages)
    self.reset_history(snapshot)
    self.apply_snapshot(snapshot)
  }

  // Submits an answer or cancellation for a pending request. A request settles
  // once; while its response is in flight further responses are ignored. A
  // failed submission keeps the request so it can be answered again.
  fn mut respond_interaction(response: protocol::InteractionResponse) {
    if self.active and self.interaction_responding == "" {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              let dispatch = self.host.dispatch
              let id = response.RequestID
              self.interaction_responding = id
              async::start(fn() {
                let attempt = contextbridge::WithTimeout(lifetime.Context, Int64::from(30000))
                let result = session.RespondInteraction(attempt.Context, response)
                attempt.Cancel()
                let _ = dispatch(fn() {
                  if self.active and self.interaction_responding == id {
                    self.interaction_responding = ""
                    match result {
                      ok(_) => self.remove_interaction(id),
                      err(failure) => {
                        if not self.absorbs(failure) {
                          (self.host.toast)(
                            "Could not submit response",
                            failure.error(),
                            toast::Variant::error,
                            false,
                          )
                        }
                      },
                    }
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Adopts a record persisted by the Scratchpad editor.
  fn mut apply_scratchpad_saved(record: protocol::Scratchpad) {
    if self.active {
      self.scratchpad_record = Maybe::new(record)
      self.scratchpad_failure = ""
    }
  }

  // scratchpad_updater binds the editor's persistence to this attachment's
  // session and cancellation. It runs on the editor's save worker, so it
  // captures only those immutable handles.
  fn scratchpad_updater() (fn(protocol::UpdateScratchpadInput) protocol::Scratchpad!Error)? {
    match self.lifetime {
      lifetime => {
        match self.session {
          session => {
            Maybe::new(fn(input: protocol::UpdateScratchpadInput) protocol::Scratchpad!Error {
              session.UpdateScratchpad(lifetime.Context, input)
            })
          },
          _ => Maybe::new<fn(protocol::UpdateScratchpadInput) protocol::Scratchpad!Error>(),
        }
      },
      _ => Maybe::new<fn(protocol::UpdateScratchpadInput) protocol::Scratchpad!Error>(),
    }
  }

  // The editor's reports re-enter through the host's dispatch and are ignored
  // once this attachment is replaced.
  fn mut request_scratchpad_saved(record: protocol::Scratchpad) {
    let _ = (self.host.dispatch)(
      fn() {
        self.apply_scratchpad_saved(record)
      },
    )
  }

  fn mut request_scratchpad_retry() Bool {
    let _ = (self.host.dispatch)(
      fn() {
        if self.active {
          self.retry_scratchpad()
        }
      },
    )
    true
  }

  fn mut request_scratchpad_notice(title: Str, detail: Str) {
    let _ = (self.host.dispatch)(
      fn() {
        if self.active {
          (self.host.toast)(title, detail, toast::Variant::error, true)
        }
      },
    )
  }

  fn mut retry_scratchpad() {
    self.scratchpad_record = Maybe::new<protocol::Scratchpad>()
    self.scratchpad_failure = ""
    self.load_scratchpad()
  }

  // Loads the authoritative Scratchpad when the snapshot did not supply one.
  fn mut load_scratchpad() {
    if self.active and not self.scratchpad_loading and self.scratchpad_record.is_none() {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              self.scratchpad_loading = true
              let dispatch = self.host.dispatch
              async::start(fn() {
                let result = session.Scratchpad(lifetime.Context)
                let _ = dispatch(fn() {
                  if self.active {
                    self.scratchpad_loading = false
                    match result {
                      ok(record) => {
                        self.scratchpad_record = Maybe::new(record)
                        self.scratchpad_failure = ""
                      },
                      err(failure) => {
                        if not self.absorbs(failure) {
                          self.scratchpad_failure = failure.error()
                          (self.host.toast)(
                            "Could not open scratchpad",
                            failure.error(),
                            toast::Variant::error,
                            true,
                          )
                        }
                      },
                    }
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Reloads the session's prompt and tool context, then adopts its fresh snapshot.
  fn mut reload() {
    if not self.active {
      ()
    } else if self.reload_pending {
      (self.host.toast)(
        "Session reload unavailable",
        "Session reload is already in progress.",
        toast::Variant::warning,
        false,
      )
    } else {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              let attempt = contextbridge::WithTimeout(lifetime.Context, Int64::from(15000))
              let dispatch = self.host.dispatch
              self.reload_pending = true
              async::start(fn() {
                let result = session.Reload(attempt.Context)
                match result {
                  ok(reloaded) => {
                    let snapshot = session.Snapshot(attempt.Context)
                    attempt.Cancel()
                    let _ = dispatch(fn() {
                      if self.active {
                        self.reload_pending = false
                        match snapshot {
                          ok(current) => {
                            self.apply_snapshot(current)
                            let detail = match reloaded.Warnings.size() > 0 {
                              true => reloaded.Warnings.at(0).or(""),
                              false => "",
                            }
                            (self.host.toast)(
                              "Session context reloaded",
                              detail,
                              toast::Variant::info,
                              false,
                            )
                          },
                          err(failure) => {
                            if not self.absorbs(failure) {
                              (self.host.toast)(
                                "Session reload failed",
                                "Session reloaded, but refresh failed: {failure}",
                                toast::Variant::error,
                                true,
                              )
                            }
                          },
                        }
                      }
                    })
                  },
                  err(failure) => {
                    attempt.Cancel()
                    let _ = dispatch(fn() {
                      if self.active {
                        self.reload_pending = false
                        if not self.absorbs(failure) {
                          (self.host.toast)(
                            "Session reload failed",
                            failure.error(),
                            toast::Variant::error,
                            true,
                          )
                        }
                      }
                    })
                  },
                }
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Creates and attaches a sibling session using the current session's
  // workspace and configuration. Creation is serialized locally to avoid
  // replacing the attached session with a stale completion.
  fn mut create_sibling() {
    if not self.active {
      ()
    } else if self.new_session_pending {
      (self.host.toast)(
        "New session unavailable",
        "Session creation is already in progress.",
        toast::Variant::warning,
        false,
      )
    } else {
      match self.info {
        info => {
          match self.lifetime {
            lifetime => {
              let attempt = contextbridge::WithTimeout(lifetime.Context, Int64::from(8000))
              let client = self.options.Client
              let resolve_location = self.options.ResolveLocation
              let dispatch = self.host.dispatch
              let input = protocol::CreateSessionInput{
                CWD: info.CWD,
                Model: info.Model,
                ThinkingLevel: info.ThinkingLevel,
                Temporary: false,
              }
              self.new_session_pending = true
              async::start(fn() {
                let created = client.CreateSession(attempt.Context, input)
                match created {
                  ok(info) => {
                    let attached = attach_new_session(
                      client,
                      attempt.Context,
                      info,
                      Maybe::new<bootstrap::FailedFirstMessage>(),
                    )
                    let location = match attached {
                      ok(next) => resolve_location(lifetime.Context, next.info.CWD),
                      err(_) => "",
                    }
                    attempt.Cancel()
                    let _ = dispatch(fn() {
                      if self.active {
                        self.new_session_pending = false
                        match attached {
                          ok(next) => (self.host.attach)(next, location),
                          err(failure) => (self.host.toast)("New session failed", failure, toast::Variant::error, true),
                        }
                      }
                    })
                  },
                  err(failure) => {
                    attempt.Cancel()
                    let _ = dispatch(fn() {
                      if self.active {
                        self.new_session_pending = false
                        if not self.absorbs(failure) {
                          (self.host.toast)(
                            "New session failed",
                            failure.error(),
                            toast::Variant::error,
                            true,
                          )
                        }
                      }
                    })
                  },
                }
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Forks the attached session from its latest settled boundary and installs
  // the linked child. Forking stays available while a turn runs; it only waits
  // for work that would replace this attachment. A non-empty message becomes
  // the child's first prompt, which the server admits as part of the fork so it
  // cannot be lost between forking and submitting.
  fn mut fork(message: Str) {
    let source_id = self.session_id()
    if self.active and source_id != "" and (not self.new_session_pending and not self.reload_pending) {
      match self.lifetime {
        lifetime => {
          let request = mut protocol::ForkSessionInput{}
          if message != "" {
            request.Prompt = mut protocol::PromptInput{Text: message}
          }
          let input = request.@
          let attempt = contextbridge::WithTimeout(lifetime.Context, Int64::from(30000))
          let client = self.options.Client
          let resolve_location = self.options.ResolveLocation
          let dispatch = self.host.dispatch
          self.new_session_pending = true
          async::start(fn() {
            let attached = match client.ForkSession(attempt.Context, source_id, input) {
              ok(forked) => {
                attach_new_session(
                  client,
                  attempt.Context,
                  forked.Session,
                  failed_first_message(message, forked),
                )
              },
              err(failure) => Result::err(failure.error()),
            }
            let location = match attached {
              ok(next) => resolve_location(lifetime.Context, next.info.CWD),
              err(_) => "",
            }
            attempt.Cancel()
            let _ = dispatch(fn() {
              if self.active {
                self.new_session_pending = false
                match attached {
                  ok(next) => (self.host.attach)(next, location),
                  err(failure) => (self.host.toast)("Fork failed", failure, toast::Variant::error, true),
                }
              }
            })
          })
        },
        _ => (),
      }
    }
  }

  // Presents a first message that did not start a turn like any failed prompt
  // submission: the message returns to an empty composer and its reason is
  // shown as the attachment's notice.
  fn mut present_failed_first_message(failure: bootstrap::FailedFirstMessage) {
    (self.host.restore_draft)(failure.text)
    self.notice = failure.reason
  }

  // Changes the attached session's directory through the canonical session
  // mutation endpoint. The server resolves relative paths from its current cwd.
  fn mut change_working_directory(path: Str) {
    if self.active {
      match self.lifetime {
        lifetime => {
          match self.info {
            info => {
              match self.session {
                session => {
                  let previous = info.CWD
                  let ctx = lifetime.Context
                  let resolve_location = self.options.ResolveLocation
                  let dispatch = self.host.dispatch
                  async::start(fn() {
                    let result = session.ChangeCWD(ctx, path)
                    let location = match result {
                      ok(changed) => resolve_location(ctx, changed.CWD),
                      err(_) => "",
                    }
                    let _ = dispatch(fn() {
                      if self.active {
                        match result {
                          ok(changed) => {
                            self.info = Maybe::new(changed)
                            self.location = location
                            match changed.CWD == previous {
                              true => (self.host.toast)("Already in directory", changed.CWD, toast::Variant::info, false),
                              false => {
                                (self.host.toast)(
                                  "Working directory changed",
                                  "Now {changed.CWD} · run /reload to refresh agent context",
                                  toast::Variant::warning,
                                  false,
                                )
                              },
                            }
                          },
                          err(failure) => {
                            if not self.absorbs(failure) {
                              (self.host.toast)(
                                "Failed to change directory",
                                failure.error(),
                                toast::Variant::error,
                                true,
                              )
                            }
                          },
                        }
                      }
                    })
                  })
                },
                _ => (),
              }
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Starts the optimistic live turn for a local submission when no other turn
  // is active. Returns whether the live transcript must be rolled back on
  // rejection.
  private fn mut begin_submission(display: Str) Bool {
    self.notice = ""
    let optimistic = self.live.activity == "" and not self.start_pending
    if optimistic {
      self.live.submit(display)
      self.start_pending = true
      (self.host.show_latest)()
    }
    optimistic
  }

  // Applies the server's response to a prompt or prompt-command submission.
  private fn mut accept_submission(
    submission: api::PromptSubmission,
    optimistic: Bool,
    unstarted: Str,
  ) {
    self.follow_ups = submission.Queue
    if submission.Queued {
      if optimistic {
        self.live.reset()
        self.start_pending = false
      }
    } else if not unsafe::is_nil(submission.Turn) {
      self.start_pending = false
      self.follow_run(submission.Turn.ID())
    } else {
      self.live.reset()
      self.start_pending = false
      self.notice = unstarted
    }
  }

  private fn mut reject_submission(optimistic: Bool, failure: Error) {
    if optimistic {
      self.live.reset()
      self.start_pending = false
      self.abort_after_start = false
    }
    if not self.absorbs(failure) {
      self.notice = failure.error()
    }
  }

  // Submits a discovered prompt command. The server queues it behind active
  // work and retains the /command invocation as the follow-up preview.
  fn mut submit_prompt_command(name: Str, args: Str) {
    if self.active {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              let suffix = match args != "" {
                true => " {args}",
                false => "",
              }
              let optimistic = self.begin_submission("/{name}{suffix}")
              let ctx = lifetime.Context
              let dispatch = self.host.dispatch
              async::start(fn() {
                let result = session.SubmitPromptCommand(ctx, name, args)
                let _ = dispatch(fn() {
                  if self.active {
                    match result {
                      ok(submission) => {
                        self.accept_submission(
                          submission,
                          optimistic,
                          "Prompt command did not start a turn",
                        )
                      },
                      err(failure) => self.reject_submission(optimistic, failure),
                    }
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Executes a plugin-owned command without creating an agent turn or
  // changing the composer draft. The server validates the generation-owned
  // instance so stale palette entries cannot run a replacement plugin.
  fn mut execute_plugin_command(command: protocol::PluginCommand, args: Str) {
    if self.active {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              let ctx = lifetime.Context
              let dispatch = self.host.dispatch
              async::start(fn() {
                let result = session.ExecutePluginCommand(
                  ctx,
                  protocol::PluginCommandInput{
                    ID: command.ID,
                    Instance: command.Instance,
                    Args: args,
                  },
                )
                let _ = dispatch(fn() {
                  if self.active {
                    match result {
                      // Plugins own successful user-facing feedback through
                      // their server notification stream. Do not duplicate it
                      // with a client-generated completion toast.
                      ok(_) => (),
                      err(failure) => {
                        if not self.absorbs(failure) {
                          (self.host.toast)(
                            "Plugin command failed",
                            failure.error(),
                            toast::Variant::error,
                            false,
                          )
                        }
                      },
                    }
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Submits a prompt, queuing it when another turn is active.
  fn mut submit(text: Str) {
    if self.can_submit() and text != "" {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              let optimistic = self.begin_submission(text)
              let ctx = lifetime.Context
              let dispatch = self.host.dispatch
              async::start(fn() {
                let result = session.SubmitPromptInput(ctx, protocol::PromptInput{Text: text})
                let _ = dispatch(fn() {
                  if self.active {
                    match result {
                      ok(submission) => self.accept_submission(submission, optimistic, "Prompt did not start a turn"),
                      err(failure) => {
                        (self.host.restore_draft)(text)
                        self.reject_submission(optimistic, failure)
                      },
                    }
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }
}

struct Effects {
  toasts: [Str],
}

private fn test_host(effects: mut Effects) Host {
  Host{
    dispatch: fn(action: fn()) Void!event::DispatchError {
      action()
      Result::ok(())
    },
    toast: fn(title: Str, detail: Str, variant: toast::Variant, persistent: Bool) {
      effects.toasts.push("{title}: {detail}")
    },
    attach: fn(attached: bootstrap::Attached, location: Str) {},
    restore_draft: fn(text: Str) {},
    show_latest: fn() {},
  }
}

private fn active_controller(effects: mut Effects) mut Controller {
  let result = controller(cli::TUIOptions{}, test_host(effects), 1, "")
  result.active = true
  result
}

test fn a_detached_controller_ignores_session_operations() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = detached(cli::TUIOptions{}, test_host(effects))
  subject.submit("hello")
  subject.reload()
  subject.create_sibling()
  subject.fork("try another approach")
  try testing::assert(not subject.can_submit(), "no session can receive prompts")
  try testing::assert(not subject.new_session_pending, "no fork starts")
  try testing::assert(subject.live.messages.size() == 0, "no optimistic prompt is added")
  testing::assert(effects.toasts.size() == 0, "inert operations report nothing")
}

test fn snapshots_project_session_state_and_report_each_mcp_warning_once() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  let snapshot = protocol::SessionSnapshot{
    Session: protocol::SessionInfo{ID: "session-1", Name: "Notes"},
    Messages: [
      protocol::TranscriptMessage{
        ID: "reply-1",
        Role: "assistant",
        Content: [protocol::TextBlock("hello")],
      },
    ],
    ContextTokens: 10,
    ContextWindow: 100,
    MCPWarnings: ["missing server"],
  }
  subject.apply_snapshot(snapshot)
  subject.apply_snapshot(snapshot)

  try testing::assert(subject.session_id() == "session-1", "the session record is adopted")
  try testing::assert(subject.transcript_messages().size() == 1, "the transcript is projected")
  try testing::assert(
    subject.context_tokens == 10 and subject.context_window == 100,
    "context usage is adopted",
  )
  testing::assert(
    strings::Join(mut effects.toasts, "|") == "MCP configuration warning: missing server",
    "each warning is reported once per attachment: {strings::Join(mut effects.toasts, "|")}",
  )
}

test fn session_records_only_update_the_attached_session() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1", Name: "Before"}},
  )
  subject.apply_info(protocol::SessionInfo{ID: "session-2", Name: "Other"})
  try testing::assert(
    subject.info.or(protocol::SessionInfo{}).Name == "Before",
    "other sessions are ignored",
  )
  subject.apply_info(protocol::SessionInfo{ID: "session-1", Name: "After"})
  testing::assert(
    subject.info.or(protocol::SessionInfo{}).Name == "After",
    "the attached record updates",
  )
}

struct Queue {
  actions: [fn()],
}

private fn queued_host(queue: mut Queue) Host {
  Host{
    dispatch: fn(action: fn()) Void!event::DispatchError {
      queue.actions.push(action)
      Result::ok(())
    },
    toast: fn(title: Str, detail: Str, variant: toast::Variant, persistent: Bool) {},
    attach: fn(attached: bootstrap::Attached, location: Str) {},
    restore_draft: fn(text: Str) {},
    show_latest: fn() {},
  }
}

private fn run_queue(queue: mut Queue) {
  let actions = queue.actions
  queue.actions = []
  for action in actions {
    action()
  }
}

test fn dialog_records_apply_through_the_host_and_only_while_attached() Void!Str {
  let queue = mut Queue{actions: []}
  let subject = controller(cli::TUIOptions{}, queued_host(queue), 1, "")
  subject.active = true
  subject.apply_snapshot(
    protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1", Name: "Before"}},
  )

  subject.request_info(protocol::SessionInfo{ID: "session-1", Name: "Renamed"})
  try testing::assert(
    subject.info.or(protocol::SessionInfo{}).Name == "Before",
    "the record waits for the host's dispatch",
  )
  run_queue(queue)
  try testing::assert(
    subject.info.or(protocol::SessionInfo{}).Name == "Renamed",
    "the dispatched record updates the attachment",
  )

  subject.request_info(protocol::SessionInfo{ID: "session-1", Name: "Late"})
  subject.dispose()
  run_queue(queue)
  testing::assert(
    subject.info.or(protocol::SessionInfo{}).Name == "Renamed",
    "a record queued before replacement is discarded",
  )
}

test fn scratchpad_editor_reports_apply_through_the_host_and_only_while_attached() Void!Str {
  let queue = mut Queue{actions: []}
  let effects = mut Effects{toasts: []}
  let host = Host{
    dispatch: fn(action: fn()) Void!event::DispatchError {
      queue.actions.push(action)
      Result::ok(())
    },
    toast: fn(title: Str, detail: Str, variant: toast::Variant, persistent: Bool) {
      effects.toasts.push("{title}: {detail}")
    },
    attach: fn(attached: bootstrap::Attached, location: Str) {},
    restore_draft: fn(text: Str) {},
    show_latest: fn() {},
  }
  let subject = controller(cli::TUIOptions{}, host, 1, "")
  subject.active = true
  subject.scratchpad_failure = "load failed"

  subject.request_scratchpad_saved(protocol::Scratchpad{Content: "saved notes"})
  subject.request_scratchpad_notice("Scratchpad save failed", "offline")
  try testing::assert(
    subject.scratchpad_record.is_none() and effects.toasts.size() == 0,
    "reports wait for the host's dispatch",
  )
  run_queue(queue)
  try testing::assert(
    subject.scratchpad_record.or(protocol::Scratchpad{}).Content == "saved notes",
    "a saved record becomes authoritative",
  )
  try testing::assert(subject.scratchpad_failure == "", "a saved record clears the load failure")
  try testing::assert(
    strings::Join(mut effects.toasts, "|") == "Scratchpad save failed: offline",
    "editor failures are reported once: {strings::Join(mut effects.toasts, "|")}",
  )

  try testing::assert(subject.request_scratchpad_retry(), "retry is accepted for scheduling")
  run_queue(queue)
  try testing::assert(
    subject.scratchpad_record.is_none(),
    "retry discards the cached record to reload it",
  )

  subject.request_scratchpad_saved(protocol::Scratchpad{Content: "late notes"})
  subject.request_scratchpad_notice("Late failure", "")
  subject.dispose()
  run_queue(queue)
  try testing::assert(
    subject.scratchpad_record.is_none(),
    "a save queued before replacement is discarded",
  )
  testing::assert(effects.toasts.size() == 1, "a notice queued before replacement is discarded")
}

test fn watched_turn_lifecycle_tracks_and_releases_the_active_turn() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "turn.started",
        TurnID: "turn-1",
        Sequence: 1,
      },
    ],
  )
  try testing::assert(subject.run_id == "turn-1" and subject.busy(), "a remote turn is claimed")
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "turn.completed",
        TurnID: "turn-1",
        Sequence: 2,
      },
    ],
  )
  testing::assert(
    subject.run_id == "" and not subject.busy(),
    "turn completion releases idle commands",
  )
}

test fn turn_recovery_is_shown_only_for_the_active_turn() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  subject.run_id = "turn-1"
  subject.live.activity = "Working…"
  subject.show_recovery("turn-0", turn_follower::Recovery::reconnecting)
  try testing::assert(subject.recovery_status() == "", "an earlier turn shows nothing")

  subject.show_recovery("turn-1", turn_follower::Recovery::reconnecting)
  try testing::assert(subject.recovery_status() == "Reconnecting activity…", subject.recovery_status())
  subject.show_recovery("turn-1", turn_follower::Recovery::healthy)
  try testing::assert(subject.recovery_status() == "", "a running turn clears reconnection")

  subject.show_recovery("turn-1", turn_follower::Recovery::syncing)
  try testing::assert(
    subject.recovery_status() == "Syncing final transcript…" and subject.activity() == "",
    "a finished turn syncs without activity",
  )
  subject.show_recovery("turn-1", turn_follower::Recovery::healthy)
  try testing::assert(
    subject.recovery_status() == "Syncing final transcript…",
    "only the final snapshot ends syncing",
  )

  subject.run_id = "turn-2"
  testing::assert(subject.recovery_status() == "", "a later turn shows nothing")
}

test fn a_final_snapshot_settles_a_turn_that_finished_while_disconnected() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1"}})
  subject.run_id = "turn-1"
  subject.live.submit("a")
  subject.show_recovery("turn-1", turn_follower::Recovery::syncing)

  subject.settle_run(
    protocol::TurnInfo{
      TurnID: "turn-1",
      Status: protocol::TurnStatusFailed,
      ErrorMessage: "provider failed",
    },
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["a"], 1),
      ActiveTurnID: "turn-2",
    },
  )
  try testing::assert(shown(subject) == "a ", "the snapshot and an error row: {shown(subject)}")
  let error_row = subject.messages.at(1).expect("error row")
  try testing::assert(
    error_row.is_error and error_row.text == "provider failed",
    "the turn's failure is reported",
  )
  try testing::assert(subject.live.messages.size() == 0, "the live turn is replaced")
  try testing::assert(subject.run_id == "turn-2", "the successor becomes active")
  testing::assert(subject.recovery_status() == "", "syncing ends")
}

test fn a_persisted_failure_is_not_reported_twice() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  subject.run_id = "turn-a"
  subject.settle_run(
    protocol::TurnInfo{TurnID: "turn-a", Status: protocol::TurnStatusFailed},
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: [
        protocol::TranscriptMessage{
          ID: "a",
          TurnID: "turn-a",
          Sequence: Int64::from(1),
          Role: "assistant",
          IsError: true,
          ErrorMessage: "provider failed",
        },
      ],
    },
  )
  testing::assert(
    shown(subject) == "a" and subject.run_id == "",
    "only the persisted row: {shown(subject)}",
  )
}

test fn a_turn_without_a_final_snapshot_settles_what_streamed() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  subject.run_id = "turn-1"
  subject.live.submit("hello")
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "tool.started",
        TurnID: "turn-1",
        ToolCallID: "call-1",
        ToolName: "bash",
        Sequence: 1,
      },
    ],
  )
  subject.show_recovery("turn-1", turn_follower::Recovery::syncing)

  subject.abandon_run(
    protocol::TurnInfo{TurnID: "turn-1", Status: protocol::TurnStatusInterrupted},
    Error::new("connection refused"),
  )
  // The prompt, the assistant message that called the tool, the tool, and
  // the error row.
  try testing::assert(subject.messages.size() == 4, "the streamed rows and an error row")
  let tool = subject.messages.at(2).expect("tool row")
  try testing::assert(
    tool.tool_state == transcript::ToolState::completed and not tool.pending,
    "the running tool is settled",
  )
  try testing::assert(
    subject.messages.at(3).expect("error row").text == "Run interrupted",
    "the status explains the turn",
  )
  try testing::assert(
    subject.run_id == "" and subject.live.messages.size() == 0 and subject.recovery_status() == "",
    "the turn is released",
  )
  testing::assert(
    effects.toasts.size() == 1 and effects.toasts.at(0).or("") == "Transcript refresh failed: The next turn will retry. connection refused",
    "the missing transcript is explained: {effects.toasts.size()}",
  )
}

test fn disposal_ends_the_attachment_scope() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1"}})
  subject.dispose()
  subject.apply_info(protocol::SessionInfo{ID: "session-1", Name: "Late"})
  subject.apply_scratchpad_saved(protocol::Scratchpad{Content: "late"})
  try testing::assert(not subject.active and not subject.can_submit(), "a disposed attachment is inert")
  try testing::assert(subject.info.or(protocol::SessionInfo{}).Name == "", "late records are ignored")
  testing::assert(subject.scratchpad_record.is_none(), "late editor completions are ignored")
}

test fn a_fork_waits_only_for_work_that_replaces_the_attachment() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1"}, ActiveTurnID: "turn-1"},
  )
  subject.new_session_pending = true
  subject.fork("")
  subject.new_session_pending = false
  subject.reload_pending = true
  subject.fork("")
  testing::assert(
    effects.toasts.size() == 0 and not subject.new_session_pending,
    "a fork during session creation or reload is ignored without feedback",
  )
}

test fn only_an_unstarted_first_message_is_reported_as_failed() Void!Str {
  let started = protocol::ForkSessionResult{Session: protocol::SessionInfo{ID: "child"}}
  let unstarted = protocol::ForkSessionResult{
    Session: protocol::SessionInfo{ID: "child"},
    FirstTurnError: mut protocol::FirstTurnError{Code: protocol::FirstTurnUnavailable, Message: "session is unavailable"},
  }
  try testing::assert(failed_first_message("", unstarted).is_none(), "a fork without a message has none")
  try testing::assert(
    failed_first_message("explore", started).is_none(),
    "a started first message did not fail",
  )
  let failure = failed_first_message(
    "explore",
    unstarted,
  ).or(bootstrap::FailedFirstMessage{text: "", reason: ""})
  testing::assert(
    failure.text == "explore" and failure.reason == "session is unavailable",
    "the unstarted message keeps its text and reason",
  )
}

test fn a_failed_first_message_is_presented_like_a_failed_prompt() Void!Str {
  let drafts = mut List::new<Str>()
  let host = Host{
    dispatch: fn(action: fn()) Void!event::DispatchError {
      action()
      Result::ok(())
    },
    toast: fn(title: Str, detail: Str, variant: toast::Variant, persistent: Bool) {},
    attach: fn(attached: bootstrap::Attached, location: Str) {},
    restore_draft: fn(text: Str) {
      drafts.push(text)
    },
    show_latest: fn() {},
  }
  let subject = controller(cli::TUIOptions{}, host, 1, "")
  subject.active = true
  subject.present_failed_first_message(
    bootstrap::FailedFirstMessage{text: "explore the other approach", reason: "session is unavailable"},
  )
  try testing::assert(
    drafts.size() == 1 and drafts.at(0).or("") == "explore the other approach",
    "the message returns to the composer",
  )
  testing::assert(subject.notice == "session is unavailable", "the reason is shown as the notice")
}

test fn a_snapshot_after_a_stream_replacement_rebases_the_live_turn() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1"}})
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "turn.started",
        TurnID: "turn-1",
        StreamID: "stream-a",
        Sequence: 1,
      },
      sessionbridge::Event{
        Kind: "assistant.text.delta",
        TurnID: "turn-1",
        StreamID: "stream-a",
        Sequence: 2,
        MessageID: "assistant-1",
        Delta: "one",
      },
    ],
  )
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      ActiveTurnID: "turn-1",
      EventStreamID: "stream-b",
      EventCursor: 0,
    },
  )
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "assistant.text.delta",
        TurnID: "turn-1",
        StreamID: "stream-b",
        Sequence: 1,
        MessageID: "assistant-1",
        Delta: " two",
      },
    ],
  )
  let messages = subject.transcript_messages()
  try testing::assert(subject.run_id == "turn-1", "the turn is still followed")
  testing::assert(
    messages.size() == 1 and messages.at(0).expect("reply").text == "one two",
    "the live reply continues on the replacement stream",
  )
}

private fn model_request(id: Str) protocol::InteractionRequest {
  protocol::InteractionRequest{
    ID: id,
    TurnID: "turn-1",
    ToolCallID: "call-1",
    Kind: protocol::InteractionConfirm,
    Title: "Proceed?",
  }
}

test fn pending_requests_queue_in_order_and_settle_by_id() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  let first = model_request("interaction_1")
  let second = model_request("interaction_2")
  let plugin = protocol::InteractionRequest{
    ID: "interaction_plugin",
    Plugin: mut protocol::PluginInteractionOwner{PluginID: "demo", Instance: "1"},
    Kind: protocol::InteractionConfirm,
    Title: "Plugin",
  }
  subject.apply_events(
    [
      // The session watch and the turn stream both deliver requests.
      sessionbridge::Event{
        Kind: "turn.started",
        TurnID: "turn-1",
        Sequence: 1,
      },
      sessionbridge::Event{
        Kind: "interaction.requested",
        Sequence: 2,
        Interaction: mut first,
        InteractionID: first.ID,
      },
      sessionbridge::Event{
        Kind: "interaction.requested",
        Sequence: 3,
        Interaction: mut second,
        InteractionID: second.ID,
      },
      sessionbridge::Event{
        Kind: "interaction.requested",
        Sequence: 3,
        Interaction: mut first,
        InteractionID: first.ID,
      },
      sessionbridge::Event{
        Kind: "interaction.requested",
        Sequence: 4,
        Interaction: mut plugin,
        InteractionID: plugin.ID,
      },
    ],
  )
  try testing::assert(subject.interactions.size() == 3, "{subject.interactions.size()} pending requests")
  try testing::assert(
    subject.interaction().or(protocol::InteractionRequest{}).ID == "interaction_1",
    "the oldest request is presented",
  )
  try testing::assert(
    subject.feedback_pending() and subject.activity() == "Waiting for feedback…",
    "a pending request reports feedback",
  )

  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "interaction.resolved",
        Sequence: 5,
        InteractionID: "interaction_1",
      },
    ],
  )
  try testing::assert(
    subject.interaction().or(protocol::InteractionRequest{}).ID == "interaction_2",
    "the next request is presented",
  )
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "interaction.resolved",
        Sequence: 6,
        InteractionID: "interaction_2",
      },
    ],
  )
  try testing::assert(
    subject.interaction().or(protocol::InteractionRequest{}).ID == "interaction_plugin",
    "plugin requests queue with model requests",
  )
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "interaction.resolved",
        Sequence: 7,
        InteractionID: "interaction_plugin",
      },
    ],
  )
  testing::assert(
    subject.interaction().is_none() and (not subject.feedback_pending()) and subject.activity() != "Waiting for feedback…",
    "settling every request ends feedback",
  )
}

test fn a_late_copy_of_a_settled_request_does_not_reopen_it() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  let request = model_request("interaction_1")
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "interaction.requested",
        Sequence: 1,
        Interaction: mut request,
        InteractionID: request.ID,
      },
      sessionbridge::Event{
        Kind: "interaction.resolved",
        Sequence: 2,
        InteractionID: request.ID,
      },
    ],
  )
  // The turn stream lags the session watch and delivers the request again.
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "interaction.requested",
        Sequence: 1,
        Interaction: mut request,
        InteractionID: request.ID,
      },
    ],
  )
  try testing::assert(subject.interaction().is_none(), "the event stream copy stays settled")
  subject.apply_snapshot(
    protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1"}, PendingInteractions: [request]},
  )
  testing::assert(subject.interaction().is_none(), "a stale snapshot copy stays settled")
}

test fn snapshots_replace_pending_requests() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      PendingInteractions: [model_request("interaction_1"), model_request("interaction_2")],
    },
  )
  try testing::assert(subject.interactions.size() == 2, "snapshot requests are adopted")
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      PendingInteractions: [model_request("interaction_2")],
    },
  )
  testing::assert(
    subject.interactions.size() == 1 and subject.interaction().or(protocol::InteractionRequest{}).ID == "interaction_2",
    "a later snapshot drops settled requests",
  )
}

private fn transcript_messages(ids: [Str], first: Int) [protocol::TranscriptMessage] {
  let result = mut List::new<protocol::TranscriptMessage>()
  mut sequence = first
  for id in ids {
    result.push(
      protocol::TranscriptMessage{
        ID: id,
        TurnID: "turn-{id}",
        Sequence: Int64::from(sequence),
        Role: "user",
        Content: [protocol::TextBlock(id)],
      },
    )
    sequence =+ 1
  }
  result.@
}

private fn shown(subject: mut Controller) Str {
  mut joined = ""
  for message in subject.messages {
    joined = match joined == "" {
      true => message.id,
      false => "{joined} {message.id}",
    }
  }
  joined
}

test fn earlier_history_continues_from_the_snapshot_and_survives_later_snapshots() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["c", "d"], 3),
      PreviousMessageCursor: "3",
      HasMoreMessages: true,
    },
  )
  try testing::assert(
    subject.history_more and subject.history_cursor == "3",
    "the snapshot's cursor starts history",
  )

  subject.prepend_page(
    protocol::TranscriptPage{
      SessionID: "session-1",
      Messages: transcript_messages(["a", "b"], 1),
      HasMoreMessages: false,
    },
  )
  try testing::assert(shown(subject) == "a b c d", "the page is prepended: {shown(subject)}")
  try testing::assert(not subject.history_more, "the beginning has been reached")

  // A later overlapping snapshot keeps the loaded pages and their cursor.
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["c", "d", "e"], 3),
      PreviousMessageCursor: "3",
      HasMoreMessages: true,
    },
  )
  try testing::assert(shown(subject) == "a b c d e", "loaded history is kept: {shown(subject)}")
  testing::assert(not subject.history_more, "the loaded beginning is retained")
}

test fn a_snapshot_that_replaces_history_restarts_its_cursor() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["a", "b"], 1),
    },
  )
  subject.history_failure = "connection refused"
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["summary", "z"], 9),
      PreviousMessageCursor: "9",
      HasMoreMessages: true,
    },
  )
  try testing::assert(shown(subject) == "summary z", "the snapshot replaces: {shown(subject)}")
  testing::assert(
    subject.history_more and subject.history_cursor == "9" and subject.history_failure == "",
    "history restarts from the new snapshot",
  )
}

test fn a_page_that_overlaps_the_transcript_is_reported_and_not_applied() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["c", "d"], 3),
      PreviousMessageCursor: "3",
      HasMoreMessages: true,
    },
  )
  subject.prepend_page(
    protocol::TranscriptPage{
      SessionID: "session-1",
      Messages: transcript_messages(["b", "c"], 2),
      PreviousMessageCursor: "2",
      HasMoreMessages: true,
    },
  )
  try testing::assert(shown(subject) == "c d", "the transcript is unchanged: {shown(subject)}")
  testing::assert(
    subject.history_failure != "" and subject.history_cursor == "3",
    "the failure pauses loading at the same cursor",
  )
}

test fn an_expired_cursor_recovers_from_a_fresh_snapshot() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["a", "b", "c"], 1),
      PreviousMessageCursor: "1",
      HasMoreMessages: true,
    },
  )
  subject.recover_history(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["summary", "d"], 20),
      PreviousMessageCursor: "20",
      HasMoreMessages: true,
    },
  )
  try testing::assert(shown(subject) == "summary d", "the fresh snapshot is shown: {shown(subject)}")
  testing::assert(subject.history_cursor == "20" and subject.history_more, "history restarts")
}

// The error a Go constructor reports.
private fn reported(result: Void!Error) Error {
  match result {
    err(failure) => failure,
    ok(_) => Error::new("no error was reported"),
  }
}

test fn an_incompatible_server_freezes_the_attachment_once() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["a", "b"], 1),
    },
  )
  subject.run_id = "turn-1"
  subject.live.activity = "Working…"
  subject.interactions = [protocol::InteractionRequest{ID: "interaction_1"}]

  let failure = reported(fmt::Errorf("watch session: %w", api::ErrIncompatibleServer))
  try testing::assert(subject.absorbs(failure), "the failure is not reported by its operation")
  try testing::assert(not subject.connected(), "the attachment is frozen")
  try testing::assert(
    subject.run_id == "" and (not subject.busy()) and subject.activity() == "" and (not subject.feedback_pending()),
    "nothing is shown as running or waiting",
  )
  try testing::assert(shown(subject) == "a b", "the transcript stays: {shown(subject)}")
  try testing::assert(
    effects.toasts.size() == 1 and effects.toasts.at(0).or("").starts_with("Server compatibility changed: "),
    "one explanation: {effects.toasts.size()}",
  )

  // Work cancelled by the freeze fails quietly.
  try testing::assert(
    subject.absorbs(reported(errors::New("context canceled"))),
    "later failures are quiet",
  )
  testing::assert(effects.toasts.size() == 1, "the explanation is shown once")
}

test fn ordinary_failures_are_reported_by_their_operation() Void!Str {
  let effects = mut Effects{toasts: []}
  let subject = active_controller(effects)
  try testing::assert(
    not subject.absorbs(reported(errors::New("connection refused"))),
    "an ordinary failure",
  )
  testing::assert(
    subject.connected() and effects.toasts.size() == 0,
    "the attachment stays connected",
  )
}
