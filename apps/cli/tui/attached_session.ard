// The attached-session owner. One Controller represents one client-side
// attachment lifetime: its session handle and cancellation, authoritative
// snapshot projections, live turn transcript, and session-scoped operations.
//
// Shell renders this state, so every mutation is scheduled through the host's
// dispatch. Replacing an attachment disposes the old Controller; completions
// that arrive afterward observe `active == false` and are discarded, which
// also rejects stale `A₁ → B → A₂` callbacks for the same durable session.
//
// Shell reads Controller fields for presentation but mutates them only through
// Controller methods.

// Host lists the root-owned effects an attachment may request. All callbacks
// run on the UI thread inside `dispatch`.
struct Host {
  // Schedules a mutation through the component that renders the attachment.
  dispatch: fn(fn()) Void!event::DispatchError,
  toast: fn(Str, Str, toast::Variant, Bool),
  // Replaces this attachment with a newly created session.
  attach: fn(bootstrap::Attached, Str),
  // Returns a failed prompt to the composer when it has not been reused.
  restore_draft: fn(Str),
  // Puts restored follow-ups before the composer's draft.
  prepend_draft: fn(Str),
  // Returns the transcript to its end after a local submission.
  show_latest: fn(),
  // Opens a file or URL with the system's default application.
  open_url: fn(Str) Void!Error,
  // The color image previews are composited over where the terminal cannot
  // draw images natively.
  image_matte: fn() ui::Color,
}

struct Controller {
  options: cli::TUIOptions,
  host: Host,
  // Identifies this attachment for keyed retained presentation.
  scope_id: Int,
  active: Bool,
  lifetime: contextbridge::Cancellation?,
  session: (mut api::Session)?,
  info: protocol::SessionInfo?,
  location: Str,
  prompt_commands: [protocol::PromptCommand],
  plugin_commands: [protocol::PluginCommand],
  follow_ups: protocol::FollowUpQueue,
  // Whether the follow-up queue is being restored or sent.
  follow_ups_changing: Bool,
  // Files staged for the next prompt, and the last staged row's token.
  attachments: [attachments::Staged],
  attachment_token: Int,
  // The attachment ID of the image whose preview is expanded, if any, and
  // the most recently expanded previews, newest last.
  expanded_image: Str,
  previews: [Str: image_preview::Preview],
  preview_order: [Str],
  messages: [transcript::Message],
  // Earlier transcript pages. The cursor is the oldest loaded message;
  // `history_scope` advances whenever the cursor is replaced so an in-flight
  // page for a superseded cursor is ignored.
  history_initialized: Bool,
  history_cursor: Str,
  history_more: Bool,
  history_loading: Bool,
  history_failure: Str,
  history_scope: Int,
  live: transcript::Live,
  run_id: Str,
  // The turn whose events come from its own turn stream, which replays it
  // from its start. The session watch skips that turn's events, so a replay
  // that arrives after later watched events is not mistaken for a duplicate.
  followed_run: Str,
  // How the stream of `recovering_run` is being recovered. It is shown only
  // while that turn is the active one.
  recovery: turn_follower::Recovery,
  recovering_run: Str,
  context_tokens: Int,
  context_window: Int,
  usage: protocol::SessionUsage,
  mcp_servers: [protocol::MCPServerStatus],
  mcp_warnings: [Str],
  shown_mcp_warnings: [Str],
  notice: Str,
  start_pending: Bool,
  new_session_pending: Bool,
  reload_pending: Bool,
  compact_pending: Bool,
  compact_operation_id: Str,
  abort_pending: Bool,
  abort_after_start: Bool,
  // Direct shell work, one run at a time: `bash_starting` while the server
  // accepts a run, then `bash_id` until it settles.
  bash_starting: Bool,
  bash_id: Str,
  // The run being started. Retrying the same command after a failed start
  // reuses its execution ID, so a run the server did accept is not repeated.
  bash_admission: Admission?,
  // Escape asked to stop a run that was still starting.
  bash_abort_requested: Bool,
  // The last reported failure to follow a run, so retries do not repeat it.
  bash_failure: Str,
  // Bash rows whose output is folded, by execution ID.
  folded_bash: [Str: Bool],
  // Plugin messages shown in full, by turn ID.
  expanded_plugins: [Str: Bool],
  scratchpad_record: protocol::Scratchpad?,
  scratchpad_loading: Bool,
  scratchpad_failure: Str,
  // The server's explanation once it can no longer serve this client. The
  // attachment is then frozen: its transcript and draft stay visible, but it
  // makes no further requests.
  incompatible: Str,
  // The session's indexed project paths, for file mentions.
  files: file_index::Source,
  // The other sessions, for session mentions, and their running load.
  mentionable: session_mentions::Source,
  mentionable_load: contextbridge::Cancellation?,
  // Pending model and plugin requests in arrival order. The oldest is
  // presented.
  interactions: [protocol::InteractionRequest],
  // Recently settled request IDs. The session watch and a turn stream can
  // each deliver a request, so a late copy must not reopen it.
  settled_interactions: [Str],
  // The request whose response is being submitted, if any.
  interaction_responding: Str,
}

// A direct shell command typed in the composer: `!command` adds its result to
// the model's context, and `!!command` keeps it out.
struct Admission {
  id: Str,
  value: Str,
  command: Str,
  exclude: Bool,
}

// The command a draft runs directly, if it is one. A bare `!` or `!!` is an
// ordinary prompt.
fn parse_bash(value: Str) Admission? {
  let exclude = strings::HasPrefix(value, "!!")
  let command = match {
    exclude => strings::TrimSpace(strings::TrimPrefix(value, "!!")),
    strings::HasPrefix(value, "!") => strings::TrimSpace(strings::TrimPrefix(value, "!")),
    _ => "",
  }
  match command == "" {
    true => Maybe::new<Admission>(),
    false => {
      Maybe::new(
        Admission{
          id: "",
          value: value,
          command: command,
          exclude: exclude,
        },
      )
    },
  }
}

// Whether messages include the bash row of execution id.
private fn lists_bash(messages: [transcript::Message], id: Str) Bool {
  mut found = false
  for message in messages {
    if message.role == transcript::Role::bash and message.id == id {
      found = true
    }
  }
  found
}

// The result of one earlier-transcript request: a page, a fresh snapshot
// after the cursor expired, or a failure.
private struct HistoryOutcome {
  page: protocol::TranscriptPage?,
  snapshot: protocol::SessionSnapshot?,
  failure: Str,
  incompatible: Bool,
}

private fn empty_usage() protocol::SessionUsage {
  protocol::SessionUsage{
    Input: 0,
    Output: 0,
    CacheRead: 0,
    CacheWrite: 0,
    Reasoning: 0,
    TotalTokens: 0,
    Cost: protocol::SessionUsageCost{
      Input: 0.0,
      Output: 0.0,
      CacheRead: 0.0,
      CacheWrite: 0.0,
      Total: 0.0,
    },
  }
}

private fn controller(options: cli::TUIOptions, host: Host, scope_id: Int, location: Str) mut Controller {
  (mut Controller{
    options: options,
    host: host,
    scope_id: scope_id,
    active: false,
    lifetime: Maybe::new<contextbridge::Cancellation>(),
    session: Maybe::new<mut api::Session>(),
    info: Maybe::new<protocol::SessionInfo>(),
    location: location,
    prompt_commands: [],
    plugin_commands: [],
    follow_ups: protocol::FollowUpQueue{
      Count: 0,
      Previews: [],
      AnnotationIDs: [],
    },
    follow_ups_changing: false,
    attachments: [],
    attachment_token: 0,
    expanded_image: "",
    previews: [:],
    preview_order: [],
    messages: [],
    history_initialized: false,
    history_cursor: "",
    history_more: false,
    history_loading: false,
    history_failure: "",
    history_scope: 0,
    live: transcript::live(),
    run_id: "",
    followed_run: "",
    recovery: turn_follower::Recovery::healthy,
    recovering_run: "",
    context_tokens: 0,
    context_window: 0,
    usage: empty_usage(),
    mcp_servers: [],
    mcp_warnings: [],
    shown_mcp_warnings: [],
    notice: "",
    start_pending: false,
    new_session_pending: false,
    reload_pending: false,
    compact_pending: false,
    compact_operation_id: "",
    abort_pending: false,
    abort_after_start: false,
    bash_starting: false,
    bash_id: "",
    bash_admission: Maybe::new<Admission>(),
    bash_abort_requested: false,
    bash_failure: "",
    folded_bash: [:],
    expanded_plugins: [:],
    interactions: [],
    settled_interactions: [],
    interaction_responding: "",
    scratchpad_record: Maybe::new<protocol::Scratchpad>(),
    scratchpad_loading: false,
    scratchpad_failure: "",
    incompatible: "",
    files: file_index::source(),
    mentionable: session_mentions::source(),
    mentionable_load: Maybe::new<contextbridge::Cancellation>(),
  })
}

// detached is the inert attachment shown before bootstrap completes. It owns
// no session and ignores every operation.
fn detached(options: cli::TUIOptions, host: Host) mut Controller {
  controller(options, host, 0, options.Location)
}

// attach adopts an attached session under a new cancellation scope derived
// from `parent`. Call `start` once the Controller is installed.
fn attach(
  options: cli::TUIOptions,
  host: Host,
  scope_id: Int,
  parent: contextbridge::Cancellation,
  attached: bootstrap::Attached,
  location: Str,
) mut Controller {
  let result = controller(options, host, scope_id, location)
  result.active = true
  result.lifetime = Maybe::new(contextbridge::WithCancel(parent.Context))
  result.session = Maybe::new(attached.session)
  result.apply_snapshot(attached.snapshot)
  match attached.failed_first_message {
    failure => result.present_failed_first_message(failure),
    _ => (),
  }
  result
}

// Attaches a session this client just created or forked and reads its
// snapshot. It runs on a worker under the request's deadline.
private fn attach_new_session(
  client: mut api::Client,
  ctx: context::Context,
  info: protocol::SessionInfo,
  failed_first_message: bootstrap::FailedFirstMessage?,
) bootstrap::Attached!Str {
  match client.Attach(ctx, info.ID) {
    ok(session) => {
      match session.Snapshot(ctx) {
        ok(snapshot) => {
          Result::ok(
            bootstrap::Attached{
              info: info,
              session: session,
              snapshot: snapshot,
              failed_first_message: failed_first_message,
            },
          )
        },
        err(failure) => Result::err(failure.error()),
      }
    },
    err(failure) => Result::err(failure.error()),
  }
}

// The fork's first message when the server published the child without
// starting it.
private fn failed_first_message(message: Str, forked: protocol::ForkSessionResult) bootstrap::FailedFirstMessage? {
  match message == "" or unsafe::is_nil(forked.FirstTurnError) {
    true => Maybe::new<bootstrap::FailedFirstMessage>(),
    false => {
      Maybe::new(
        bootstrap::FailedFirstMessage{text: message, reason: forked.FirstTurnError.Message},
      )
    },
  }
}

impl Controller {
  // start opens the session watches and follows a turn and a shell command
  // already in progress.
  fn mut start(active_turn_id: Str, active_bash_id: Str) {
    self.watch()
    self.watch_plugin_toasts()
    self.follow_run(active_turn_id)
    self.resume_bash(active_bash_id)
  }

  // dispose cancels this attachment's requests and streams. Queued
  // completions become no-ops.
  fn mut dispose() {
    self.active = false
    match self.lifetime {
      lifetime => lifetime.Cancel(),
      _ => (),
    }
  }

  // Whether a prompt can be submitted to this attachment.
  fn can_submit() Bool {
    self.active and self.connected() and self.session.is_some() and self.lifetime.is_some()
  }

  // Whether the server can still serve this attachment.
  fn connected() Bool {
    self.incompatible == ""
  }

  // Decides how a failed session operation is presented. A server that can
  // no longer serve this client freezes the attachment instead of reporting
  // the operation; once frozen, failures of the cancelled work are expected.
  // Returns true when the caller should report nothing.
  private fn mut absorbs(failure: Error) Bool {
    if sessionbridge::Incompatible(failure) {
      self.freeze(failure.error())
    }
    not self.connected()
  }

  // Stops this attachment's streams and requests while keeping what it shows.
  // Restarting Kit is the recovery: the replacement server serves another
  // release, so rechecking from this client cannot succeed.
  private fn mut freeze(reason: Str) {
    if self.active and self.connected() {
      self.incompatible = reason
      match self.lifetime {
        lifetime => lifetime.Cancel(),
        _ => (),
      }
      self.run_id = ""
      self.followed_run = ""
      self.recovery = turn_follower::Recovery::healthy
      self.start_pending = false
      self.abort_pending = false
      self.abort_after_start = false
      self.compact_pending = false
      self.compact_operation_id = ""
      self.bash_starting = false
      self.bash_id = ""
      self.bash_abort_requested = false
      self.follow_ups_changing = false
      self.reload_pending = false
      self.new_session_pending = false
      self.history_loading = false
      self.interactions = []
      self.interaction_responding = ""
      self.live.activity = ""
      self.live.thinking = ""
      (self.host.toast)("Server compatibility changed", reason, toast::Variant::error, true)
    }
  }

  // Whether idle-only commands must wait for active session work.
  fn busy() Bool {
    self.run_id != "" or self.start_pending or self.compact_pending
  }

  // Whether any session work is in progress, including a shell command.
  fn working() Bool {
    self.busy() or self.bash_starting or self.bash_id != ""
  }

  // The oldest pending request that this client presents.
  fn interaction() protocol::InteractionRequest? {
    self.interactions.at(0)
  }

  // Whether the agent is waiting for an answer from the user.
  fn feedback_pending() Bool {
    self.active and self.interactions.size() > 0
  }

  // The current pending-row activity, if any.
  fn activity() Str {
    match {
      self.feedback_pending() => "Waiting for feedback…",
      self.live.activity != "" => self.live.activity,
      self.compact_pending => "Compacting session…",
      _ => "",
    }
  }

  fn session_id() Str {
    match self.info {
      info => info.ID,
      _ => "",
    }
  }

  // The settled transcript followed by the active turn's live messages.
  fn transcript_messages() [transcript::Message] {
    let messages = mut List::new<transcript::Message>()
    for message in self.messages {
      messages.push(message)
    }
    for message in self.live.messages {
      messages.push(message)
    }
    messages.@
  }

  // Adopts an authoritative session record returned by a child request.
  // Records for another session are ignored.
  fn mut apply_info(session: protocol::SessionInfo) {
    if self.active and session.ID == self.session_id() {
      self.info = Maybe::new(session)
    }
  }

  // request_info schedules an authoritative record reported by a dialog that
  // configured this session. It is ignored once this attachment is replaced.
  fn mut request_info(session: protocol::SessionInfo) {
    let _ = (self.host.dispatch)(
      fn() {
        self.apply_info(session)
      },
    )
  }

  // Replaces the transcript with a server snapshot unless live events have
  // already moved past it.
  fn mut apply_snapshot(snapshot: protocol::SessionSnapshot) {
    if not self.live.supersedes(snapshot) {
      self.info = Maybe::new(snapshot.Session)
      self.prompt_commands = snapshot.PromptCommands
      self.plugin_commands = snapshot.PluginCommands
      self.follow_ups = snapshot.FollowUps
      self.context_tokens = snapshot.ContextTokens
      self.context_window = snapshot.ContextWindow
      self.usage = snapshot.Usage
      // The attached session snapshot already carries the authoritative
      // Scratchpad. Reuse it instead of issuing a second request when the pane
      // opens; that request mutates the public Session cache while its watch is
      // active and adds avoidable renderer work to a workspace transition.
      if unsafe::is_nil(snapshot.Scratchpad) {
        self.scratchpad_record = Maybe::new<protocol::Scratchpad>()
      } else {
        self.scratchpad_record = Maybe::new(snapshot.Scratchpad.@)
      }
      self.scratchpad_loading = false
      self.scratchpad_failure = ""
      // A settled authoritative snapshot releases idle-only palette commands
      // even when a terminal stream event was missed during reconnection.
      if snapshot.ActiveTurnID == "" and self.live.activity == "" {
        self.run_id = ""
        self.followed_run = ""
        self.abort_pending = false
        self.abort_after_start = false
      }
      self.interactions = []
      for request in snapshot.PendingInteractions {
        self.add_interaction(request)
      }
      self.mcp_servers = snapshot.MCPServers
      self.mcp_warnings = snapshot.MCPWarnings
      for warning in snapshot.MCPWarnings {
        mut already_shown = false
        for shown in self.shown_mcp_warnings {
          if shown == warning {
            already_shown = true
          }
        }
        if not already_shown {
          self.shown_mcp_warnings.push(warning)
          (self.host.toast)("MCP configuration warning", warning, toast::Variant::warning, true)
        }
      }
      // Watch snapshots can lag the active turn. Keep its complete live tail
      // (including the optimistic user row) until turn settlement; a snapshot
      // that happens to include the user event can still omit later live
      // content and must not replace it.
      if snapshot.ActiveTurnID == "" or not self.live.blocks_snapshot_replacement() {
        let running = self.running_bash()
        let projected = mut List::new<transcript::Message>()
        for message in transcript::project(snapshot.Messages) {
          projected.push(message)
        }
        // Finished runs the model has not seen yet follow the transcript.
        for run in sessionbridge::PendingBash(mut snapshot.PendingBoundaries) {
          projected.push(transcript::bash_message(run))
        }
        let merged = transcript::merge_snapshot(self.messages, projected.@)
        self.messages = merged.messages
        // A running command is not in the snapshot until it settles.
        match running {
          row => {
            if not lists_bash(self.messages, row.id) {
              self.messages.push(row)
            }
          },
          _ => (),
        }
        if not merged.preserved {
          self.reset_history(snapshot)
        }
        self.live.reset()
      } else {
        self.live.adopt_stream(snapshot)
      }
      if not self.history_initialized {
        self.reset_history(snapshot)
      }
    }
  }

  // Applies a batch delivered by Session.Watch, except the followed turn's
  // events, which its own stream delivers. A turn started elsewhere is
  // followed so its stream replays it from its start.
  fn mut apply_watched_events(batch: [protocol::SessionEvent]) {
    let kept = mut List::new<sessionbridge::Event>()
    mut started = ""
    for event in sessionbridge::Events(mut batch) {
      if event.TurnID == "" or event.TurnID != self.followed_run {
        kept.push(event)
        if transcript::classify(event.Kind) == transcript::Event::run_started {
          started = event.TurnID
        }
      }
    }
    self.apply_events(kept.@)
    if started != "" and started == self.run_id and (not self.start_pending) {
      self.follow_run(started)
    }
  }

  // Applies a snapshot delivered by Session.Watch. Each turn starts a new
  // event stream, so the watch learns of a turn started elsewhere, such as by
  // a plugin's message, from a snapshot after the turn's first events; the
  // turn is followed so its stream replays them. A submission in flight is
  // followed when the server accepts it.
  fn mut apply_watch_snapshot(snapshot: protocol::SessionSnapshot) {
    self.apply_snapshot(snapshot)
    let active = snapshot.ActiveTurnID
    if active != "" and active != self.followed_run and (not self.start_pending) and (self.run_id == "" or self.run_id == active) {
      self.follow_run(active)
    }
  }

  // Applies a batch from the followed turn's own stream.
  fn mut apply_followed_events(batch: [protocol::SessionEvent]) {
    self.apply_events(sessionbridge::Events(mut batch))
  }

  // A remote client can start the turn, and one session batch can finish a
  // turn before starting its queued successor, so lifecycle and transcript
  // updates are reduced together in wire order.
  fn mut apply_events(events: [sessionbridge::Event]) {
    for event in events {
      let kind = transcript::classify(event.Kind)
      if event.Kind == "scratchpad.changed" and not unsafe::is_nil(event.Scratchpad) {
        self.scratchpad_record = Maybe::new(event.Scratchpad.@)
        self.scratchpad_failure = ""
      }
      if kind == transcript::Event::run_started {
        self.claim_run(event.TurnID)
      }
      if event.Kind == "interaction.requested" and not unsafe::is_nil(event.Interaction) {
        self.add_interaction(event.Interaction.@)
      }
      if event.Kind == "interaction.resolved" {
        self.remove_interaction(event.InteractionID)
      }
      // A transcript pinned to its end follows new content on its own.
      let _ = self.live.apply_event(event)
      if kind == transcript::Event::run_finished and event.TurnID == self.followed_run {
        self.followed_run = ""
      }
      if kind == transcript::Event::run_finished and event.TurnID == self.run_id {
        self.run_id = ""
        self.abort_pending = false
        self.abort_after_start = false
      }
    }
    if self.live.context_window > 0 {
      self.context_tokens = self.live.context_tokens
      self.context_window = self.live.context_window
    }
    if self.live.activity == "" {
      self.abort_pending = false
    }
  }

  // Streams server-owned plugin notifications through the reconnecting public
  // session handle. The stream remains fresh-only across reconnects.
  private fn mut watch_plugin_toasts() {
    match self.lifetime {
      lifetime => {
        match self.session {
          session => {
            let ctx = lifetime.Context
            let dispatch = self.host.dispatch
            async::start(fn() {
              match session.WatchPluginToasts(ctx) {
                ok(stream) => {
                  let updates = stream.Updates()
                  mut open = true
                  while open {
                    match updates.recv() {
                      notification => {
                        let _ = dispatch(fn() {
                          if self.active {
                            let variant = match notification.Variant.to_str() {
                              "warning" => toast::Variant::warning,
                              "error" => toast::Variant::error,
                              _ => toast::Variant::info,
                            }
                            let detail = match notification.Subtitle == "" {
                              true => "",
                              false => "{notification.PluginID} · {notification.Subtitle}",
                            }
                            (self.host.toast)(
                              notification.Title,
                              detail,
                              variant,
                              notification.Persistent,
                            )
                          }
                        })
                      },
                      _ => { open = false },
                    }
                  }
                  match stream.Err() {
                    err(failure) => {
                      let _ = dispatch(fn() {
                        if self.active and not self.absorbs(failure) {
                          (self.host.toast)(
                            "Plugin notifications unavailable",
                            failure.error(),
                            toast::Variant::error,
                            true,
                          )
                        }
                      })
                    },
                    ok(_) => (),
                  }
                },
                err(failure) => {
                  let _ = dispatch(fn() {
                    if self.active and not self.absorbs(failure) {
                      (self.host.toast)(
                        "Plugin notifications unavailable",
                        failure.error(),
                        toast::Variant::error,
                        true,
                      )
                    }
                  })
                },
              }
            })
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  // Watches the attached session through the public client's reconnecting
  // stream. Initial and replay-gap updates carry authoritative snapshots.
  private fn mut watch() {
    match self.lifetime {
      lifetime => {
        match self.session {
          session => {
            let ctx = lifetime.Context
            let dispatch = self.host.dispatch
            async::start(fn() {
              match session.Watch(ctx) {
                ok(stream) => {
                  let updates = stream.Updates()
                  mut open = true
                  while open {
                    match updates.recv() {
                      update => {
                        if unsafe::is_nil(update.Snapshot) {
                          mut finished = false
                          for event in update.Events {
                            if transcript::classify(event.Kind().to_str()) == transcript::Event::run_finished {
                              finished = true
                            }
                          }
                          let batch = update.Events
                          let _ = dispatch(fn() {
                            if self.active {
                              self.apply_watched_events(batch)
                            }
                          })
                          if finished {
                            match session.Snapshot(ctx) {
                              ok(settled) => {
                                let _ = dispatch(fn() {
                                  if self.active {
                                    self.apply_watch_snapshot(settled)
                                  }
                                })
                              },
                              err(_) => (),
                            }
                          }
                        } else {
                          let snapshot = update.Snapshot.@
                          let _ = dispatch(fn() {
                            if self.active {
                              self.apply_watch_snapshot(snapshot)
                            }
                          })
                        }
                      },
                      _ => { open = false },
                    }
                  }
                  match stream.Err() {
                    err(failure) => {
                      let _ = dispatch(fn() {
                        if self.active and not self.absorbs(failure) {
                          (self.host.toast)(
                            "Session connection lost",
                            failure.error(),
                            toast::Variant::error,
                            true,
                          )
                        }
                      })
                    },
                    ok(_) => (),
                  }
                },
                err(failure) => {
                  let _ = dispatch(fn() {
                    if self.active and not self.absorbs(failure) {
                      (self.host.toast)(
                        "Session connection failed",
                        failure.error(),
                        toast::Variant::error,
                        true,
                      )
                    }
                  })
                },
              }
            })
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  // Records a turn discovered by the session-wide watch without opening a
  // competing stream or consuming an abort queued for a local submission.
  private fn mut claim_run(run_id: Str) {
    if run_id != "" {
      self.run_id = run_id
    }
  }

  // Follows a turn through its own stream, which replays it from its start:
  // turns submitted here, found when attaching, or discovered by the session
  // watch. A lost stream is recovered by `turn_follower::follow`.
  private fn mut follow_run(run_id: Str) {
    if run_id != "" {
      if run_id == self.followed_run {
        if self.abort_after_start {
          self.abort_after_start = false
          self.abort_run()
        }
      } else {
        self.run_id = run_id
        self.followed_run = run_id
        if self.abort_after_start {
          self.abort_after_start = false
          self.abort_run()
        }
        match self.lifetime {
          lifetime => {
            match self.session {
              session => {
                let follower = self.turn_follower(session, lifetime.Context)
                async::start(fn() {
                  turn_follower::follow(follower, run_id)
                })
              },
              _ => (),
            }
          },
          _ => (),
        }
      }
    }
  }

  // The session requests a turn follower makes and the attachment updates it
  // schedules. Updates apply only while their turn is still the active one.
  private fn mut turn_follower(session: mut api::Session, ctx: context::Context) turn_follower::Follower {
    let dispatch = self.host.dispatch
    turn_follower::Follower{
      stream: fn(run_id: Str, received: fn()) Void!Error {
        // A successor reported by a final snapshot is followed too.
        let _ = dispatch(fn() {
          if self.active and self.run_id == run_id {
            self.followed_run = run_id
          }
        })
        match session.Stream(ctx, run_id) {
          ok(stream) => {
            let updates = stream.Updates()
            mut open = true
            while open {
              match updates.recv() {
                batch => {
                  received()
                  let _ = dispatch(fn() {
                    if self.active and self.run_id == run_id {
                      self.show_recovery(run_id, turn_follower::Recovery::healthy)
                      self.apply_followed_events(batch)
                    }
                  })
                },
                _ => { open = false },
              }
            }
            stream.Err()
          },
          err(failure) => Result::err(failure),
        }
      },
      snapshot: fn() protocol::SessionSnapshot!Error {
        session.Snapshot(ctx)
      },
      status: fn(run_id: Str) protocol::TurnInfo!Error {
        session.Turn(ctx, run_id)
      },
      wait: fn(milliseconds: Int64) Bool {
        contextbridge::Wait(ctx, milliseconds)
      },
      ended: fn() Bool {
        contextbridge::Done(ctx)
      },
      rebase: fn(run_id: Str, snapshot: protocol::SessionSnapshot) {
        let _ = dispatch(fn() {
          if self.active and self.run_id == run_id {
            self.apply_snapshot(snapshot)
          }
        })
      },
      recover: fn(run_id: Str, recovery: turn_follower::Recovery) {
        let _ = dispatch(fn() {
          if self.active {
            self.show_recovery(run_id, recovery)
          }
        })
      },
      settle: fn(info: protocol::TurnInfo, snapshot: protocol::SessionSnapshot) {
        let _ = dispatch(fn() {
          if self.active {
            self.settle_run(info, snapshot)
          }
        })
      },
      abandon: fn(info: protocol::TurnInfo, failure: Error) {
        let _ = dispatch(fn() {
          if self.active {
            self.abandon_run(info, failure)
          }
        })
      },
      incompatible: fn(failure: Error) {
        let _ = dispatch(fn() {
          if self.active {
            let _ = self.absorbs(failure)
          }
        })
      },
    }
  }

  // The footer text for the active turn's stream recovery, if any.
  fn recovery_status() Str {
    match self.run_id != "" and self.recovering_run == self.run_id {
      true => turn_follower::recovery_text(self.recovery),
      false => "",
    }
  }

  // Shows how the active turn's stream is being recovered. Seeing the turn
  // run again clears only reconnection; a final transcript sync is resolved by
  // the snapshot that settles the turn.
  fn mut show_recovery(run_id: Str, recovery: turn_follower::Recovery) {
    if self.run_id == run_id {
      if recovery != turn_follower::Recovery::healthy or self.recovery == turn_follower::Recovery::reconnecting {
        self.recovery = recovery
        self.recovering_run = run_id
      }
      // A turn whose final transcript is syncing no longer runs.
      if recovery == turn_follower::Recovery::syncing {
        self.live.activity = ""
        self.live.thinking = ""
      }
    }
  }

  // Settles a turn that finished while its stream was lost, from the final
  // snapshot. The snapshot may report a successor, which becomes active.
  fn mut settle_run(info: protocol::TurnInfo, snapshot: protocol::SessionSnapshot) {
    if self.run_id == info.TurnID {
      self.release_run()
      self.apply_snapshot(snapshot)
      mut persisted = false
      for message in snapshot.Messages {
        if message.TurnID == info.TurnID and message.IsError {
          persisted = true
        }
      }
      if not persisted {
        self.report_unsuccessful(info)
      }
      self.run_id = snapshot.ActiveTurnID
      self.followed_run = snapshot.ActiveTurnID
    }
  }

  // Settles a turn that finished while its stream was lost when its final
  // snapshot could not be fetched. The next snapshot replaces what is shown.
  fn mut abandon_run(info: protocol::TurnInfo, failure: Error) {
    if self.run_id == info.TurnID {
      self.live.settle()
      for message in self.live.messages {
        self.messages.push(message)
      }
      self.release_run()
      self.report_unsuccessful(info)
      (self.host.toast)(
        "Transcript refresh failed",
        "The next turn will retry. {failure.error()}",
        toast::Variant::error,
        true,
      )
    }
  }

  private fn mut release_run() {
    self.live.reset()
    self.run_id = ""
    self.followed_run = ""
    self.abort_pending = false
    self.abort_after_start = false
    self.recovery = turn_follower::Recovery::healthy
    self.recovering_run = ""
  }

  // Adds an error row for a turn that did not complete.
  private fn mut report_unsuccessful(info: protocol::TurnInfo) {
    let status = info.Status.to_str()
    if status != "completed" {
      let row = mut transcript::message("", info.TurnID, transcript::Role::assistant)
      row.text = match info.ErrorMessage == "" {
        true => "Run {status}",
        false => info.ErrorMessage,
      }
      row.error_message = info.ErrorMessage
      row.is_error = true
      self.messages.push(row.@)
    }
  }

  // The row of the running shell command, if one is shown.
  private fn running_bash() transcript::Message? {
    mut found = Maybe::new<transcript::Message>()
    if self.bash_id != "" {
      for message in self.transcript_messages() {
        if message.role == transcript::Role::bash and message.id == self.bash_id {
          found = Maybe::new(message)
        }
      }
    }
    found
  }

  // Shows the latest state of a shell command: in place when its row is
  // shown, otherwise after the active turn's rows or the transcript.
  fn mut show_bash(run: sessionbridge::Bash) {
    let row = transcript::bash_message(run)
    mut replaced = false
    for message, index in self.messages {
      if message.role == transcript::Role::bash and message.id == run.ID {
        self.messages.set(index, row)
        replaced = true
      }
    }
    for message, index in self.live.messages {
      if message.role == transcript::Role::bash and message.id == run.ID {
        self.live.messages.set(index, row)
        replaced = true
      }
    }
    if not replaced {
      match self.run_id != "" {
        true => self.live.messages.push(row),
        false => self.messages.push(row),
      }
    }
  }

  // Expands or collapses the plugin message that started turn_id.
  fn mut toggle_plugin_message(turn_id: Str) {
    self.expanded_plugins.set(turn_id, not self.expanded_plugins.get(turn_id).or(false))
  }

  // Folds or unfolds a finished command's output.
  fn mut toggle_bash(id: Str) {
    self.folded_bash.set(id, not self.folded_bash.get(id).or(false))
  }

  // Runs a shell command typed in the composer. One runs at a time; it may
  // run alongside a turn.
  fn mut start_bash(typed: Admission) {
    if self.bash_starting or self.bash_id != "" {
      (self.host.toast)("Bash already running", "", toast::Variant::info, false)
    } else {
      // Retrying a command whose start failed reuses its execution ID.
      let previous = self.bash_admission
      let reused = match previous {
        earlier => {
          match earlier.value == typed.value and earlier.command == typed.command and earlier.exclude == typed.exclude {
            true => earlier.id,
            false => "",
          }
        },
        _ => "",
      }
      let id = match reused != "" {
        true => Result::ok(reused),
        false => identifier::New("bash_"),
      }
      match id {
        err(failure) => (self.host.toast)("Bash failed", failure.error(), toast::Variant::error, true),
        ok(execution_id) => {
          match self.lifetime {
            lifetime => {
              match self.session {
                session => {
                  let admission = Admission{
                    id: execution_id,
                    value: typed.value,
                    command: typed.command,
                    exclude: typed.exclude,
                  }
                  self.bash_admission = Maybe::new(admission)
                  self.bash_starting = true
                  self.bash_abort_requested = false
                  let ctx = lifetime.Context
                  let dispatch = self.host.dispatch
                  async::start(fn() {
                    let started = session.StartBash(
                      ctx,
                      execution_id,
                      admission.command,
                      admission.exclude,
                    )
                    let _ = dispatch(fn() {
                      if self.active {
                        self.bash_starting = false
                        match started {
                          ok(execution) => self.adopt_bash(session, ctx, execution),
                          err(failure) => self.reject_bash(session, ctx, admission, failure),
                        }
                      }
                    })
                  })
                },
                _ => (),
              }
            },
            _ => (),
          }
        },
      }
    }
  }

  // Follows a command the server accepted, stopping it when Escape was
  // pressed while it started.
  private fn mut adopt_bash(
    session: mut api::Session,
    ctx: context::Context,
    execution: mut api::BashExecution,
  ) {
    self.bash_admission = Maybe::new<Admission>()
    let id = execution.ID()
    self.bash_id = id
    self.show_bash(sessionbridge::BashOf(execution.State()))
    if self.bash_abort_requested {
      self.bash_abort_requested = false
      self.abort_bash()
    }
    self.follow_bash(session, ctx, id, Maybe::new(execution))
  }

  // A command that did not start returns to the composer. A start that was
  // being stopped is stopped on the server too, in case it did start.
  private fn mut reject_bash(
    session: mut api::Session,
    ctx: context::Context,
    admission: Admission,
    failure: Error,
  ) {
    if self.bash_abort_requested {
      self.bash_abort_requested = false
      self.bash_admission = Maybe::new<Admission>()
      let id = admission.id
      async::start(fn() {
        mut attempt = 0
        mut stopped = false
        while (not stopped) and attempt < 6 {
          let bounded = contextbridge::WithTimeout(context::Background(), 3000)
          stopped = session.AbortBash(bounded.Context, id).is_ok()
          bounded.Cancel()
          if not stopped {
            let _ = contextbridge::Wait(
              context::Background(),
              turn_follower::retry_delay(attempt + 1) / Int64::from(2),
            )
          }
          attempt = attempt + 1
        }
      })
    } else {
      (self.host.restore_draft)(admission.value)
      if not self.absorbs(failure) {
        (self.host.toast)("Bash failed", failure.error(), toast::Variant::error, true)
      }
    }
  }

  // Picks up a command that was running when this session was attached.
  private fn mut resume_bash(id: Str) {
    if id != "" {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              self.bash_id = id
              self.follow_bash(session, lifetime.Context, id, Maybe::new<mut api::BashExecution>())
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Waits for a command to settle. A lost connection is reported once and the
  // command is looked up again every second until it can be followed.
  private fn mut follow_bash(
    session: mut api::Session,
    ctx: context::Context,
    id: Str,
    known: (mut api::BashExecution)?,
  ) {
    let dispatch = self.host.dispatch
    async::start(fn() {
      mut handle = known
      mut following = true
      while following {
        match handle {
          execution => {
            match execution.Wait(ctx) {
              ok(outcome) => {
                following = false
                let _ = dispatch(fn() {
                  if self.active {
                    self.settle_bash(sessionbridge::BashOf(outcome))
                  }
                })
              },
              err(failure) => {
                handle = Maybe::new<mut api::BashExecution>()
                following = self.keep_following_bash(ctx, id, "Bash update failed", failure)
              },
            }
          },
          _ => {
            match session.Bash(ctx, id) {
              ok(found) => {
                let state = found.State()
                handle = Maybe::new(found)
                let _ = dispatch(fn() {
                  if self.active and self.bash_id == id {
                    self.show_bash(sessionbridge::BashOf(state))
                  }
                })
              },
              err(failure) => { following = self.keep_following_bash(ctx, id, "Could not resume bash", failure) },
            }
          },
        }
      }
    })
  }

  // Reports a failure to follow command id and waits to retry. Returns false
  // when following should stop. Called from a follower's goroutine.
  private fn mut keep_following_bash(ctx: context::Context, id: Str, title: Str, failure: Error) Bool {
    match contextbridge::Done(ctx) {
      true => false,
      false => {
        let _ = (self.host.dispatch)(
          fn() {
            if self.active and self.bash_id == id and (not self.absorbs(failure)) {
              let reported = "{id}: {title}: {failure.error()}"
              if reported != self.bash_failure {
                self.bash_failure = reported
                (self.host.toast)(title, failure.error(), toast::Variant::error, true)
              }
            }
          },
        )
        (not sessionbridge::Incompatible(failure)) and contextbridge::Wait(ctx, 1000)
      },
    }
  }

  // Shows a settled command and releases Escape for the turn.
  fn mut settle_bash(run: sessionbridge::Bash) {
    if self.bash_id == run.ID {
      self.bash_id = ""
      self.bash_failure = ""
    }
    self.show_bash(run)
  }

  // Whether Escape stops a shell command, which takes precedence over a turn.
  fn can_abort_bash() Bool {
    self.active and (self.bash_id != "" or self.bash_starting and (not self.bash_abort_requested))
  }

  // Whether Escape has something to stop.
  fn can_interrupt() Bool {
    self.can_abort_bash() or self.can_abort()
  }

  // Stops the shell command if one runs, otherwise the turn.
  fn mut interrupt() Bool {
    match self.can_abort_bash() {
      true => self.abort_bash(),
      false => self.abort_run(),
    }
  }

  // Asks the server to stop the running command; its settled state reports
  // the outcome. A command still starting is stopped once it starts.
  fn mut abort_bash() Bool {
    if self.bash_starting {
      self.bash_abort_requested = true
      true
    } else if self.bash_id != "" {
      match self.session {
        session => {
          let id = self.bash_id
          async::start(fn() {
            let bounded = contextbridge::WithTimeout(context::Background(), 3000)
            let _ = session.AbortBash(bounded.Context, id)
            bounded.Cancel()
          })
          true
        },
        _ => false,
      }
    } else {
      false
    }
  }

  // Whether Escape should target the current active droid turn.
  fn can_abort() Bool {
    self.active and (self.run_id != "" or self.start_pending) and self.live.activity != "" and (not self.abort_pending) and (not self.abort_after_start)
  }

  // Requests cancellation without changing the composer or adding transient
  // status UI. The streamed run-finished event remains authoritative.
  fn mut abort_run() Bool {
    if self.can_abort() {
      if self.run_id == "" {
        self.abort_after_start = true
      } else {
        match self.lifetime {
          lifetime => {
            match self.session {
              session => {
                let run_id = self.run_id
                let dispatch = self.host.dispatch
                self.abort_pending = true
                async::start(fn() {
                  let result = session.Abort(lifetime.Context, run_id)
                  let _ = dispatch(fn() {
                    match result {
                      err(failure) => {
                        let _ = self.absorbs(failure)
                      },
                      ok(_) => (),
                    }
                    if self.active and self.run_id == run_id {
                      self.abort_pending = false
                    }
                  })
                })
              },
              _ => (),
            }
          },
          _ => (),
        }
      }
    }
    true
  }

  // Compacts the session through its idempotent API and then refreshes the
  // snapshot. Its local activity is rendered in the reasoning slot, while only
  // failures produce persistent feedback.
  fn mut compact() {
    if self.active and not self.compact_pending {
      match identifier::New("compact_") {
        ok(operation_id) => {
          match self.lifetime {
            lifetime => {
              match self.session {
                session => {
                  let attempt = contextbridge::WithTimeout(lifetime.Context, Int64::from(120000))
                  let dispatch = self.host.dispatch
                  self.compact_pending = true
                  self.compact_operation_id = operation_id
                  async::start(fn() {
                    let result = session.Compact(
                      attempt.Context,
                      protocol::CompactSessionInput{OperationID: operation_id},
                    )
                    match result {
                      ok(_) => {
                        let snapshot = session.Snapshot(attempt.Context)
                        attempt.Cancel()
                        let _ = dispatch(fn() {
                          if self.active and self.compact_operation_id == operation_id {
                            self.compact_pending = false
                            self.compact_operation_id = ""
                            match snapshot {
                              ok(current) => self.apply_snapshot(current),
                              err(failure) => {
                                if not self.absorbs(failure) {
                                  (self.host.toast)(
                                    "Session compacted",
                                    "Session context was compacted. {failure}",
                                    toast::Variant::warning,
                                    true,
                                  )
                                }
                              },
                            }
                          }
                        })
                      },
                      err(failure) => {
                        attempt.Cancel()
                        let _ = dispatch(fn() {
                          if self.active and self.compact_operation_id == operation_id {
                            self.compact_pending = false
                            self.compact_operation_id = ""
                            if not self.absorbs(failure) {
                              (self.host.toast)(
                                "Compaction failed",
                                failure.error(),
                                toast::Variant::error,
                                true,
                              )
                            }
                          }
                        })
                      },
                    }
                  })
                },
                _ => (),
              }
            },
            _ => (),
          }
        },
        err(failure) => (self.host.toast)("Compaction failed", failure.error(), toast::Variant::error, true),
      }
    }
  }

  // Queues a request once, unless it has already settled.
  private fn mut add_interaction(request: protocol::InteractionRequest) {
    mut known = false
    for pending in self.interactions {
      if pending.ID == request.ID {
        known = true
      }
    }
    for settled in self.settled_interactions {
      if settled == request.ID {
        known = true
      }
    }
    if not known {
      self.interactions.push(request)
    }
  }

  // Settles a request, remembering a bounded number of settled IDs.
  private fn mut remove_interaction(id: Str) {
    let remembered = mut List::new<Str>()
    for settled in self.settled_interactions {
      if settled != id {
        remembered.push(settled)
      }
    }
    remembered.push(id)
    let recent = remembered.@
    self.settled_interactions = match recent.size() > 64 {
      true => recent.slice(start: recent.size() - 64).expect("recent settled requests").to_list(),
      false => recent,
    }
    let remaining = mut List::new<protocol::InteractionRequest>()
    for pending in self.interactions {
      if pending.ID != id {
        remaining.push(pending)
      }
    }
    self.interactions = remaining.@
    if self.interaction_responding == id {
      self.interaction_responding = ""
    }
  }

  // Earlier history continues from the snapshot's oldest message.
  private fn mut reset_history(snapshot: protocol::SessionSnapshot) {
    self.history_initialized = true
    self.history_cursor = snapshot.PreviousMessageCursor
    self.history_more = snapshot.HasMoreMessages and snapshot.PreviousMessageCursor != ""
    self.history_loading = false
    self.history_failure = ""
    self.history_scope = self.history_scope + 1
  }

  // Whether an earlier page can be requested now.
  fn can_load_older() Bool {
    self.active and self.history_more and (not self.history_loading) and self.history_cursor != "" and self.session.is_some() and self.lifetime.is_some()
  }

  // Loads the page of messages before the oldest one shown. One page is in
  // flight at a time. A cursor that is no longer valid, as after compaction,
  // is recovered from a fresh snapshot.
  fn mut load_older() {
    if self.can_load_older() {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              let dispatch = self.host.dispatch
              let cursor = self.history_cursor
              let scope = self.history_scope
              self.history_loading = true
              self.history_failure = ""
              async::start(fn() {
                let attempt = contextbridge::WithTimeout(lifetime.Context, Int64::from(30000))
                let outcome = mut HistoryOutcome{
                  page: Maybe::new<protocol::TranscriptPage>(),
                  snapshot: Maybe::new<protocol::SessionSnapshot>(),
                  failure: "",
                  incompatible: false,
                }
                match session.TranscriptPage(attempt.Context, cursor) {
                  ok(page) => { outcome.page = Maybe::new(page) },
                  err(failure) => {
                    match sessionbridge::CursorUnavailable(failure) {
                      true => {
                        match session.Snapshot(attempt.Context) {
                          ok(snapshot) => { outcome.snapshot = Maybe::new(snapshot) },
                          err(refresh_failure) => {
                            outcome.failure = refresh_failure.error()
                            outcome.incompatible = sessionbridge::Incompatible(refresh_failure)
                          },
                        }
                      },
                      false => {
                        outcome.failure = failure.error()
                        outcome.incompatible = sessionbridge::Incompatible(failure)
                      },
                    }
                  },
                }
                attempt.Cancel()
                let _ = dispatch(fn() {
                  if self.active and self.history_loading and self.history_scope == scope {
                    self.history_loading = false
                    match outcome.page {
                      page => self.prepend_page(page),
                      _ => {
                        match outcome.snapshot {
                          snapshot => self.recover_history(snapshot),
                          _ => {
                            match outcome.incompatible {
                              true => self.freeze(outcome.failure),
                              false => { self.history_failure = outcome.failure },
                            }
                          },
                        }
                      },
                    }
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  private fn mut prepend_page(page: protocol::TranscriptPage) {
    match transcript::prepend_history(transcript::project(page.Messages), self.messages) {
      ok(merged) => {
        self.messages = merged
        self.history_cursor = page.PreviousMessageCursor
        self.history_more = page.HasMoreMessages and page.PreviousMessageCursor != ""
      },
      err(failure) => { self.history_failure = failure },
    }
  }

  // The fresh snapshot restarts history from its own cursor. Its durable
  // messages replace those shown; a turn still streaming keeps its live tail.
  private fn mut recover_history(snapshot: protocol::SessionSnapshot) {
    self.messages = transcript::project(snapshot.Messages)
    self.reset_history(snapshot)
    self.apply_snapshot(snapshot)
  }

  // Submits an answer or cancellation for a pending request. A request settles
  // once; while its response is in flight further responses are ignored. A
  // failed submission keeps the request so it can be answered again.
  fn mut respond_interaction(response: protocol::InteractionResponse) {
    if self.active and self.interaction_responding == "" {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              let dispatch = self.host.dispatch
              let id = response.RequestID
              self.interaction_responding = id
              async::start(fn() {
                let attempt = contextbridge::WithTimeout(lifetime.Context, Int64::from(30000))
                let result = session.RespondInteraction(attempt.Context, response)
                attempt.Cancel()
                let _ = dispatch(fn() {
                  if self.active and self.interaction_responding == id {
                    self.interaction_responding = ""
                    match result {
                      ok(_) => self.remove_interaction(id),
                      err(failure) => {
                        if not self.absorbs(failure) {
                          (self.host.toast)(
                            "Could not submit response",
                            failure.error(),
                            toast::Variant::error,
                            false,
                          )
                        }
                      },
                    }
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Adopts a record persisted by the Scratchpad editor.
  fn mut apply_scratchpad_saved(record: protocol::Scratchpad) {
    if self.active {
      self.scratchpad_record = Maybe::new(record)
      self.scratchpad_failure = ""
    }
  }

  // scratchpad_updater binds the editor's persistence to this attachment's
  // session and cancellation. It runs on the editor's save worker, so it
  // captures only those immutable handles.
  fn scratchpad_updater() (fn(protocol::UpdateScratchpadInput) protocol::Scratchpad!Error)? {
    match self.lifetime {
      lifetime => {
        match self.session {
          session => {
            Maybe::new(fn(input: protocol::UpdateScratchpadInput) protocol::Scratchpad!Error {
              session.UpdateScratchpad(lifetime.Context, input)
            })
          },
          _ => Maybe::new<fn(protocol::UpdateScratchpadInput) protocol::Scratchpad!Error>(),
        }
      },
      _ => Maybe::new<fn(protocol::UpdateScratchpadInput) protocol::Scratchpad!Error>(),
    }
  }

  // The editor's reports re-enter through the host's dispatch and are ignored
  // once this attachment is replaced.
  fn mut request_scratchpad_saved(record: protocol::Scratchpad) {
    let _ = (self.host.dispatch)(
      fn() {
        self.apply_scratchpad_saved(record)
      },
    )
  }

  fn mut request_scratchpad_retry() Bool {
    let _ = (self.host.dispatch)(
      fn() {
        if self.active {
          self.retry_scratchpad()
        }
      },
    )
    true
  }

  fn mut request_scratchpad_notice(title: Str, detail: Str) {
    let _ = (self.host.dispatch)(
      fn() {
        if self.active {
          (self.host.toast)(title, detail, toast::Variant::error, true)
        }
      },
    )
  }

  fn mut retry_scratchpad() {
    self.scratchpad_record = Maybe::new<protocol::Scratchpad>()
    self.scratchpad_failure = ""
    self.load_scratchpad()
  }

  // Loads the authoritative Scratchpad when the snapshot did not supply one.
  fn mut load_scratchpad() {
    if self.active and not self.scratchpad_loading and self.scratchpad_record.is_none() {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              self.scratchpad_loading = true
              let dispatch = self.host.dispatch
              async::start(fn() {
                let result = session.Scratchpad(lifetime.Context)
                let _ = dispatch(fn() {
                  if self.active {
                    self.scratchpad_loading = false
                    match result {
                      ok(record) => {
                        self.scratchpad_record = Maybe::new(record)
                        self.scratchpad_failure = ""
                      },
                      err(failure) => {
                        if not self.absorbs(failure) {
                          self.scratchpad_failure = failure.error()
                          (self.host.toast)(
                            "Could not open scratchpad",
                            failure.error(),
                            toast::Variant::error,
                            true,
                          )
                        }
                      },
                    }
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Reloads the session's prompt and tool context, then adopts its fresh snapshot.
  fn mut reload() {
    if not self.active {
      ()
    } else if self.reload_pending {
      (self.host.toast)(
        "Session reload unavailable",
        "Session reload is already in progress.",
        toast::Variant::warning,
        false,
      )
    } else {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              let attempt = contextbridge::WithTimeout(lifetime.Context, Int64::from(15000))
              let dispatch = self.host.dispatch
              self.reload_pending = true
              async::start(fn() {
                let result = session.Reload(attempt.Context)
                match result {
                  ok(reloaded) => {
                    let snapshot = session.Snapshot(attempt.Context)
                    attempt.Cancel()
                    let _ = dispatch(fn() {
                      if self.active {
                        self.reload_pending = false
                        match snapshot {
                          ok(current) => {
                            self.apply_snapshot(current)
                            let detail = match reloaded.Warnings.size() > 0 {
                              true => reloaded.Warnings.at(0).or(""),
                              false => "",
                            }
                            (self.host.toast)(
                              "Session context reloaded",
                              detail,
                              toast::Variant::info,
                              false,
                            )
                          },
                          err(failure) => {
                            if not self.absorbs(failure) {
                              (self.host.toast)(
                                "Session reload failed",
                                "Session reloaded, but refresh failed: {failure}",
                                toast::Variant::error,
                                true,
                              )
                            }
                          },
                        }
                      }
                    })
                  },
                  err(failure) => {
                    attempt.Cancel()
                    let _ = dispatch(fn() {
                      if self.active {
                        self.reload_pending = false
                        if not self.absorbs(failure) {
                          (self.host.toast)(
                            "Session reload failed",
                            failure.error(),
                            toast::Variant::error,
                            true,
                          )
                        }
                      }
                    })
                  },
                }
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Creates and attaches a sibling session using the current session's
  // workspace and configuration. Creation is serialized locally to avoid
  // replacing the attached session with a stale completion.
  fn mut create_sibling() {
    if not self.active {
      ()
    } else if self.new_session_pending {
      (self.host.toast)(
        "New session unavailable",
        "Session creation is already in progress.",
        toast::Variant::warning,
        false,
      )
    } else {
      match self.info {
        info => {
          match self.lifetime {
            lifetime => {
              let attempt = contextbridge::WithTimeout(lifetime.Context, Int64::from(8000))
              let client = self.options.Client
              let resolve_location = self.options.ResolveLocation
              let dispatch = self.host.dispatch
              let input = protocol::CreateSessionInput{
                CWD: info.CWD,
                Model: info.Model,
                ThinkingLevel: info.ThinkingLevel,
                Temporary: false,
              }
              self.new_session_pending = true
              async::start(fn() {
                let created = client.CreateSession(attempt.Context, input)
                match created {
                  ok(info) => {
                    let attached = attach_new_session(
                      client,
                      attempt.Context,
                      info,
                      Maybe::new<bootstrap::FailedFirstMessage>(),
                    )
                    let location = match attached {
                      ok(next) => resolve_location(lifetime.Context, next.info.CWD),
                      err(_) => "",
                    }
                    attempt.Cancel()
                    let _ = dispatch(fn() {
                      if self.active {
                        self.new_session_pending = false
                        match attached {
                          ok(next) => (self.host.attach)(next, location),
                          err(failure) => (self.host.toast)("New session failed", failure, toast::Variant::error, true),
                        }
                      }
                    })
                  },
                  err(failure) => {
                    attempt.Cancel()
                    let _ = dispatch(fn() {
                      if self.active {
                        self.new_session_pending = false
                        if not self.absorbs(failure) {
                          (self.host.toast)(
                            "New session failed",
                            failure.error(),
                            toast::Variant::error,
                            true,
                          )
                        }
                      }
                    })
                  },
                }
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Forks the attached session from its latest settled boundary and installs
  // the linked child. Forking stays available while a turn runs; it only waits
  // for work that would replace this attachment. A non-empty message becomes
  // the child's first prompt, which the server admits as part of the fork so it
  // cannot be lost between forking and submitting.
  fn mut fork(message: Str) {
    let source_id = self.session_id()
    if self.active and source_id != "" and (not self.new_session_pending and not self.reload_pending) {
      match self.lifetime {
        lifetime => {
          let request = mut protocol::ForkSessionInput{}
          if message != "" {
            request.Prompt = mut protocol::PromptInput{Text: message}
          }
          let input = request.@
          let attempt = contextbridge::WithTimeout(lifetime.Context, Int64::from(30000))
          let client = self.options.Client
          let resolve_location = self.options.ResolveLocation
          let dispatch = self.host.dispatch
          self.new_session_pending = true
          async::start(fn() {
            let attached = match client.ForkSession(attempt.Context, source_id, input) {
              ok(forked) => {
                attach_new_session(
                  client,
                  attempt.Context,
                  forked.Session,
                  failed_first_message(message, forked),
                )
              },
              err(failure) => Result::err(failure.error()),
            }
            let location = match attached {
              ok(next) => resolve_location(lifetime.Context, next.info.CWD),
              err(_) => "",
            }
            attempt.Cancel()
            let _ = dispatch(fn() {
              if self.active {
                self.new_session_pending = false
                match attached {
                  ok(next) => (self.host.attach)(next, location),
                  err(failure) => (self.host.toast)("Fork failed", failure, toast::Variant::error, true),
                }
              }
            })
          })
        },
        _ => (),
      }
    }
  }

  // Presents a first message that did not start a turn like any failed prompt
  // submission: the message returns to an empty composer and its reason is
  // shown as the attachment's notice.
  fn mut present_failed_first_message(failure: bootstrap::FailedFirstMessage) {
    (self.host.restore_draft)(failure.text)
    self.notice = failure.reason
  }

  // Changes the attached session's directory through the canonical session
  // mutation endpoint. The server resolves relative paths from its current cwd.
  fn mut change_working_directory(path: Str) {
    if self.active {
      match self.lifetime {
        lifetime => {
          match self.info {
            info => {
              match self.session {
                session => {
                  let previous = info.CWD
                  let ctx = lifetime.Context
                  let resolve_location = self.options.ResolveLocation
                  let dispatch = self.host.dispatch
                  async::start(fn() {
                    let result = session.ChangeCWD(ctx, path)
                    let location = match result {
                      ok(changed) => resolve_location(ctx, changed.CWD),
                      err(_) => "",
                    }
                    let _ = dispatch(fn() {
                      if self.active {
                        match result {
                          ok(changed) => {
                            self.info = Maybe::new(changed)
                            self.location = location
                            match changed.CWD == previous {
                              true => (self.host.toast)("Already in directory", changed.CWD, toast::Variant::info, false),
                              false => {
                                (self.host.toast)(
                                  "Working directory changed",
                                  "Now {changed.CWD} · run /reload to refresh agent context",
                                  toast::Variant::warning,
                                  false,
                                )
                              },
                            }
                          },
                          err(failure) => {
                            if not self.absorbs(failure) {
                              (self.host.toast)(
                                "Failed to change directory",
                                failure.error(),
                                toast::Variant::error,
                                true,
                              )
                            }
                          },
                        }
                      }
                    })
                  })
                },
                _ => (),
              }
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // The finished commands shown in the transcript, newest first, which
  // command history lists until the session's history loads.
  fn shown_commands() [sessionbridge::BashHistoryItem] {
    let messages = self.transcript_messages()
    let items = mut List::new<sessionbridge::BashHistoryItem>()
    mut index = messages.size() - 1
    while index >= 0 {
      let message = messages.at(index).expect("message")
      match message.bash {
        run => {
          if (not run.Running()) and strings::TrimSpace(run.Command) != "" {
            items.push(
              sessionbridge::BashHistoryItem{
                ID: run.ID,
                Command: run.Command,
                Exclude: run.Exclude,
              },
            )
          }
        },
        _ => (),
      }
      index = index - 1
    }
    items.@
  }

  // Reads up to limit commands run before the cursor before, newest first,
  // for the composer's command history; a zero cursor reads the newest. A read
  // that fails is reported and answers with nothing; one that times out after
  // three seconds answers with nothing quietly.
  fn mut load_bash_history(before: Int64, limit: Int, answer: fn(sessionbridge::BashHistoryPage?)) {
    match self.lifetime {
      lifetime => {
        match self.session {
          session => {
            let ctx = lifetime.Context
            let dispatch = self.host.dispatch
            async::start(fn() {
              let bounded = contextbridge::WithTimeout(ctx, 3000)
              let result = sessionbridge::BashHistory(bounded.Context, session, before, limit)
              let timed_out = contextbridge::Done(bounded.Context) and not contextbridge::Done(ctx)
              bounded.Cancel()
              let _ = dispatch(fn() {
                if self.active {
                  match result {
                    ok(page) => answer(Maybe::new(page)),
                    err(failure) => {
                      answer(Maybe::new<sessionbridge::BashHistoryPage>())
                      if (not timed_out) and not self.absorbs(failure) {
                        let title = match before == Int64::from(0) {
                          true => "Could not load bash history",
                          false => "Could not load older bash history",
                        }
                        (self.host.toast)(title, failure.error(), toast::Variant::error, true)
                      }
                    },
                  }
                }
              })
            })
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  // Loads the indexed paths of the session's working directory unless they
  // are loading or fresh. A new directory is indexed again by the server.
  fn mut load_files() {
    if self.can_submit() {
      match self.info {
        info => {
          match self.files.begin(info.ID, info.CWD, time::Now().UnixMilli()) {
            load => self.request_files(load),
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  private fn mut request_files(load: file_index::Load) {
    match self.lifetime {
      lifetime => {
        match self.session {
          session => {
            let ctx = lifetime.Context
            let dispatch = self.host.dispatch
            async::start(fn() {
              let result = match load.force {
                true => session.RefreshFileIndex(ctx),
                false => session.FileIndex(ctx),
              }
              let _ = dispatch(fn() {
                if self.active {
                  let listed: protocol::SessionFileIndex!Str = match result {
                    ok(index) => Result::ok(index),
                    err(failure) => {
                      // A frozen attachment keeps what it shows.
                      if self.absorbs(failure) {
                        Result::err("")
                      } else {
                        Result::err(failure.error())
                      }
                    },
                  }
                  self.files.finish(load.request, listed, time::Now().UnixMilli())
                }
              })
            })
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  // Lists the other sessions for a session mention that just opened. Each
  // mention lists them afresh, replacing an earlier load; one that takes
  // more than ten seconds fails.
  fn mut load_mentionable_sessions() {
    if self.can_submit() {
      match self.lifetime {
        lifetime => {
          match self.mentionable_load {
            previous => previous.Cancel(),
            _ => (),
          }
          let load = contextbridge::WithTimeout(lifetime.Context, Int64::from(10000))
          self.mentionable_load = Maybe::new(load)
          self.mentionable = session_mentions::begin(self.mentionable)
          let generation = self.mentionable.generation
          let attached = self.session_id()
          let client = self.options.Client
          let dispatch = self.host.dispatch
          async::start(fn() {
            let result = client.ListSessions(load.Context, api::ListSessionsOptions{CWD: ""})
            load.Cancel()
            let _ = dispatch(fn() {
              if self.active {
                let listed: [protocol::SessionInfo]!Str = match result {
                  ok(sessions) => Result::ok(sessions),
                  err(failure) => {
                    match self.absorbs(failure) {
                      true => Result::err(""),
                      false => Result::err(failure.error()),
                    }
                  },
                }
                self.mentionable = session_mentions::finish(
                  self.mentionable,
                  generation,
                  listed,
                  attached,
                )
              }
            })
          })
        },
        _ => (),
      }
    }
  }

  // Loads the session's earlier prompts, newest first, for the composer's
  // history picker. Nothing opens until they load; a failure or an empty
  // history is reported instead.
  fn mut load_message_history(loaded: fn([sessionbridge::HistoryEntry])) {
    if self.can_submit() {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              let ctx = lifetime.Context
              let dispatch = self.host.dispatch
              async::start(fn() {
                let result = sessionbridge::MessageHistory(ctx, session)
                let _ = dispatch(fn() {
                  if self.active {
                    match result {
                      ok(entries) => {
                        match entries.size() == 0 {
                          true => (self.host.toast)("No message history", "", toast::Variant::info, false),
                          false => loaded(entries),
                        }
                      },
                      err(failure) => {
                        if not self.absorbs(failure) {
                          (self.host.toast)(
                            "Could not load message history",
                            failure.error(),
                            toast::Variant::error,
                            false,
                          )
                        }
                      },
                    }
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Returns queued follow-ups to the composer, before its draft. The server
  // removes them from the queue.
  fn mut restore_follow_ups() {
    if self.can_submit() and self.follow_ups.Count > 0 and (not self.follow_ups_changing) {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              self.follow_ups_changing = true
              let ctx = lifetime.Context
              let dispatch = self.host.dispatch
              async::start(fn() {
                let result = session.RestoreFollowUps(ctx)
                let restored_attachments: [attachments::Staged] = match result {
                  ok(restored) => resolve(session, ctx, restored.Messages),
                  err(_) => [],
                }
                let _ = dispatch(fn() {
                  if self.active {
                    self.follow_ups_changing = false
                    match result {
                      ok(restored) => self.apply_restored_follow_ups(restored, restored_attachments),
                      err(failure) => {
                        if not self.absorbs(failure) {
                          (self.host.toast)(
                            "Could not restore follow-ups",
                            failure.error(),
                            toast::Variant::error,
                            false,
                          )
                        }
                      },
                    }
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  fn mut apply_restored_follow_ups(
    restored: protocol::RestoreFollowUpsResult,
    restored_attachments: [attachments::Staged],
  ) {
    self.follow_ups = restored.Queue
    for item in restored_attachments {
      mut present = false
      for existing in self.attachments {
        present = present or existing.id == item.id
      }
      if not present {
        self.attachments.push(item)
      }
    }
    let texts = mut List::new<Str>()
    for message in restored.Messages {
      if message.Text != "" {
        texts.push(message.Text)
      }
    }
    if texts.size() > 0 {
      (self.host.prepend_draft)(strings::Join(texts, "\n\n"))
    }
  }

  // Sends queued follow-ups to the running turn now instead of after it.
  fn mut promote_follow_ups() {
    if self.can_submit() and self.busy() and self.follow_ups.Count > 0 and (not self.follow_ups_changing) {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              self.follow_ups_changing = true
              let ctx = lifetime.Context
              let dispatch = self.host.dispatch
              async::start(fn() {
                let result = session.PromoteFollowUps(ctx)
                // After a failure the queue may have changed anyway.
                let current = match result {
                  ok(_) => Maybe::new<protocol::FollowUpQueue>(),
                  err(_) => {
                    match session.Snapshot(ctx) {
                      ok(snapshot) => Maybe::new(snapshot.FollowUps),
                      err(_) => Maybe::new<protocol::FollowUpQueue>(),
                    }
                  },
                }
                let _ = dispatch(fn() {
                  if self.active {
                    self.follow_ups_changing = false
                    match result {
                      ok(promoted) => self.apply_promoted_follow_ups(promoted),
                      err(failure) => {
                        match current {
                          queue => { self.follow_ups = queue },
                          _ => (),
                        }
                        if not self.absorbs(failure) {
                          (self.host.toast)(
                            "Could not send follow-ups now",
                            failure.error(),
                            toast::Variant::error,
                            false,
                          )
                        }
                      },
                    }
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  fn mut apply_promoted_follow_ups(promoted: protocol::PromoteFollowUpsResult) {
    self.follow_ups = promoted.Queue
    (self.host.toast)(
      "Follow-ups sent",
      "Promoted {promoted.Promoted} queued messages.",
      toast::Variant::info,
      false,
    )
  }

  // Starts the optimistic live turn for a local submission when no other turn
  // is active. Returns whether the live transcript must be rolled back on
  // rejection.
  private fn mut begin_submission(display: Str, staged: [attachments::Staged]) Bool {
    self.notice = ""
    let optimistic = self.live.activity == "" and not self.start_pending
    if optimistic {
      let shown = mut List::new<transcript::Attachment>()
      for item in staged {
        if item.sendable() {
          shown.push(
            transcript::Attachment{
              id: item.id,
              image: item.is_image(),
              filename: item.filename,
            },
          )
        }
      }
      self.live.submit(display, shown.@)
      self.start_pending = true
      (self.host.show_latest)()
    }
    optimistic
  }

  // Applies the server's response to a prompt or prompt-command submission.
  private fn mut accept_submission(
    submission: api::PromptSubmission,
    optimistic: Bool,
    unstarted: Str,
  ) {
    self.follow_ups = submission.Queue
    if submission.Queued {
      if optimistic {
        self.live.reset()
        self.start_pending = false
      }
    } else if not unsafe::is_nil(submission.Turn) {
      self.start_pending = false
      self.follow_run(submission.Turn.ID())
    } else {
      self.live.reset()
      self.start_pending = false
      self.notice = unstarted
    }
  }

  private fn mut reject_submission(optimistic: Bool, failure: Error) {
    if optimistic {
      self.live.reset()
      self.start_pending = false
      self.abort_after_start = false
    }
    if not self.absorbs(failure) {
      self.notice = failure.error()
    }
  }

  // Submits a discovered prompt command. The server queues it behind active
  // work and retains the /command invocation as the follow-up preview. A
  // command run from the composer returns its draft when it fails; the
  // palette leaves the draft alone and passes an empty one.
  fn mut submit_prompt_command(name: Str, args: Str, draft: Str) {
    if self.active {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              let suffix = match args != "" {
                true => " {args}",
                false => "",
              }
              let optimistic = self.begin_submission("/{name}{suffix}", [])
              let ctx = lifetime.Context
              let dispatch = self.host.dispatch
              async::start(fn() {
                let result = session.SubmitPromptCommand(ctx, name, args)
                let _ = dispatch(fn() {
                  if self.active {
                    match result {
                      ok(submission) => {
                        self.accept_submission(
                          submission,
                          optimistic,
                          "Prompt command did not start a turn",
                        )
                      },
                      err(failure) => {
                        if draft != "" {
                          (self.host.restore_draft)(draft)
                        }
                        self.reject_submission(optimistic, failure)
                      },
                    }
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Executes a plugin-owned command without creating an agent turn or
  // changing the composer draft. The server validates the generation-owned
  // instance so stale palette entries cannot run a replacement plugin.
  fn mut execute_plugin_command(command: protocol::PluginCommand, args: Str) {
    if self.active {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              let ctx = lifetime.Context
              let dispatch = self.host.dispatch
              async::start(fn() {
                let result = session.ExecutePluginCommand(
                  ctx,
                  protocol::PluginCommandInput{
                    ID: command.ID,
                    Instance: command.Instance,
                    Args: args,
                  },
                )
                let _ = dispatch(fn() {
                  if self.active {
                    match result {
                      // Plugins own successful user-facing feedback through
                      // their server notification stream. Do not duplicate it
                      // with a client-generated completion toast.
                      ok(_) => (),
                      err(failure) => {
                        if not self.absorbs(failure) {
                          (self.host.toast)(
                            "Plugin command failed",
                            failure.error(),
                            toast::Variant::error,
                            false,
                          )
                        }
                      },
                    }
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Submits a prompt, queuing it when another turn is active.
  // Submits the composer's text with its staged attachments. Without
  // either, Enter sends queued follow-ups to the running turn.
  fn mut submit(text: Str) {
    if self.can_submit() {
      let ids = attachments::prompt_ids(self.attachments)
      let bash = parse_bash(text)
      if text == "" and ids.size() == 0 {
        self.promote_follow_ups()
      } else if bash.is_some() {
        self.start_bash(bash.expect("bash command"))
      } else if self.prompt_invocation(text).is_some() {
        let invocation = self.prompt_invocation(text).expect("prompt command")
        self.submit_prompt_command(invocation.Name, invocation.Arguments, text)
      } else {
        match self.lifetime {
          lifetime => {
            match self.session {
              session => {
                let staged = self.attachments
                self.attachments = []
                let optimistic = self.begin_submission(text, staged)
                self.expand_sent_image(staged)
                let ctx = lifetime.Context
                let dispatch = self.host.dispatch
                async::start(fn() {
                  let result = session.SubmitPromptInput(
                    ctx,
                    protocol::PromptInput{Text: text, AttachmentIDs: ids},
                  )
                  let _ = dispatch(fn() {
                    if self.active {
                      match result {
                        ok(submission) => self.accept_submission(submission, optimistic, "Prompt did not start a turn"),
                        err(failure) => {
                          (self.host.restore_draft)(text)
                          if self.attachments.size() == 0 {
                            self.attachments = staged
                          }
                          self.reject_submission(optimistic, failure)
                        },
                      }
                    }
                  })
                })
              },
              _ => (),
            }
          },
          _ => (),
        }
      }
    }
  }

  // Why the staged attachments cannot be sent yet, if they cannot.
  fn send_blocker(text: Str) Blocker? {
    mut uploading = false
    mut failed = false
    mut image = false
    for item in self.attachments {
      uploading = uploading or item.uploading
      failed = failed or item.failure != "" and (not item.preserve_id)
      image = image or item.is_image()
    }
    match {
      uploading => {
        Maybe::new(
          Blocker{
            title: "Wait for attachments to upload",
            detail: "",
            variant: toast::Variant::info,
          },
        )
      },
      failed => {
        Maybe::new(
          Blocker{
            title: "Remove failed attachments before sending",
            detail: "",
            variant: toast::Variant::info,
          },
        )
      },
      image and self.rejecting_model() != "" => {
        Maybe::new(
          Blocker{
            title: "Remove images before sending",
            detail: "{self.rejecting_model()} doesn't accept images.",
            variant: toast::Variant::warning,
          },
        )
      },
      self.attachments.size() > 0 and self.prompt_invocation(text).is_some() => {
        Maybe::new(
          Blocker{
            title: "Prompt commands do not accept attachments",
            detail: "",
            variant: toast::Variant::warning,
          },
        )
      },
      _ => Maybe::new<Blocker>(),
    }
  }

  // The prompt command that composer text invokes: "/<name>" for a discovered
  // command, followed by optional arguments. Text recalled from history or
  // restored from the follow-up queue runs the command again.
  fn prompt_invocation(text: Str) promptcommand::Invocation? {
    let parsed = promptcommand::Parse(text)
    mut discovered = false
    for command in self.prompt_commands {
      if command.Name == parsed.Name {
        discovered = true
      }
    }
    match parsed.OK and discovered {
      true => Maybe::new(parsed),
      false => Maybe::new<promptcommand::Invocation>(),
    }
  }

  // The session's model name when it cannot receive images.
  fn rejecting_model() Str {
    match self.info {
      info => {
        match attachments::accepts_images(info.Inputs) {
          true => "",
          false => format::model_name(info.Model),
        }
      },
      _ => "",
    }
  }

  // Uploads pasted files for the next prompt.
  fn mut stage_attachments(paths: [Str]) {
    if self.can_submit() {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              let ctx = lifetime.Context
              let dispatch = self.host.dispatch
              for pending in self.admit_attachments(paths) {
                async::start(fn() {
                  let result = upload(session, ctx, pending.path)
                  let _ = dispatch(fn() {
                    if self.active {
                      self.finish_upload(pending.token, result)
                    }
                  })
                })
              }
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Stages pasted files as uploading rows and returns the uploads to start.
  // Images the model cannot receive are refused, and a paste that would
  // exceed a prompt's limit is rejected.
  fn mut admit_attachments(paths: [Str]) [Upload] {
    let accepted = mut List::new<Str>()
    let types = mut List::new<Str>()
    let refused = mut List::new<Str>()
    let rejecting = self.rejecting_model()
    for path in paths {
      let media_type = attachments::media_type(path).or("")
      if rejecting != "" and media_type.starts_with("image/") {
        refused.push(filepath::Base(path))
      } else {
        accepted.push(path)
        types.push(media_type)
      }
    }
    if refused.size() > 0 {
      (self.host.toast)(
        "Images not attached",
        "{rejecting} doesn't accept images: {strings::Join(refused, ", ")}.",
        toast::Variant::warning,
        false,
      )
    }
    mut staged = 0
    for item in self.attachments {
      if item.failure == "" or item.preserve_id {
        staged = staged + 1
      }
    }
    let uploads = mut List::new<Upload>()
    if staged + accepted.size() > attachments::max_per_prompt {
      (self.host.toast)(
        "Too many attachments",
        "A prompt supports up to {attachments::max_per_prompt} files.",
        toast::Variant::error,
        false,
      )
    } else {
      for path, index in accepted.@ {
        self.attachment_token = self.attachment_token + 1
        self.attachments.push(
          attachments::uploading(self.attachment_token, path, types.at(index).or("")),
        )
        uploads.push(Upload{token: self.attachment_token, path: path})
      }
    }
    uploads.@
  }

  // Records a finished upload on its staged row, unless the row was removed.
  fn mut finish_upload(token: Int, result: protocol::AttachmentInfo!Error) {
    let updated = mut List::new<attachments::Staged>()
    mut failure = Maybe::new<Error>()
    for item in self.attachments {
      if item.token == token and item.uploading {
        match result {
          ok(info) => updated.push(attachments::uploaded(info)),
          err(reason) => {
            let failed = mut item
            failed.uploading = false
            failed.failure = reason.error()
            updated.push(failed.@)
            failure = Maybe::new(reason)
          },
        }
      } else {
        updated.push(item)
      }
    }
    self.attachments = updated.@
    match failure {
      reason => {
        if not self.absorbs(reason) {
          (self.host.toast)("Could not attach file", reason.error(), toast::Variant::error, false)
        }
      },
      _ => (),
    }
  }

  // Removes one staged attachment.
  fn mut remove_attachment(index: Int) {
    let kept = mut List::new<attachments::Staged>()
    for item, position in self.attachments {
      if position != index {
        kept.push(item)
      }
    }
    self.attachments = kept.@
  }

  // Removes every staged attachment. Returns whether there were any.
  fn mut clear_attachments() Bool {
    let any = self.attachments.size() > 0
    self.attachments = []
    any
  }
}

// Previews kept decoded; the expanded one is never evicted.
let kept_previews = 4

impl Controller {
  // The preview of an image, once requested.
  fn preview(attachment_id: Str) image_preview::Preview? {
    self.previews.get(attachment_id)
  }

  // Expands an image's preview, collapsing any other, or collapses it when it
  // is already expanded.
  fn mut toggle_image(attachment_id: Str) {
    match self.expanded_image == attachment_id {
      true => { self.expanded_image = "" },
      false => {
        self.expanded_image = attachment_id
        self.request_preview(attachment_id)
      },
    }
  }

  // A prompt's first image starts expanded; restored history stays collapsed.
  fn mut expand_sent_image(staged: [attachments::Staged]) {
    mut first = ""
    for item in staged {
      if first == "" and item.sendable() and item.is_image() {
        first = item.id
      }
    }
    if first != "" {
      self.expanded_image = first
      self.request_preview(first)
    }
  }

  private fn mut request_preview(attachment_id: Str) {
    self.remember_preview(attachment_id)
    if self.previews.get(attachment_id).is_none() {
      self.previews.set(attachment_id, image_preview::loading())
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              let ctx = lifetime.Context
              let dispatch = self.host.dispatch
              let matte = (self.host.image_matte)()
              async::start(fn() {
                let loaded = image_preview::load(session, ctx, attachment_id, matte)
                let _ = dispatch(fn() {
                  if self.active and self.previews.get(attachment_id).is_some() {
                    self.previews.set(attachment_id, loaded)
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Marks a preview as most recently used and forgets the oldest beyond
  // `kept_previews`, except the expanded one.
  fn mut remember_preview(attachment_id: Str) {
    let order = mut List::new<Str>()
    for id in self.preview_order {
      if id != attachment_id {
        order.push(id)
      }
    }
    order.push(attachment_id)
    let kept = mut List::new<Str>()
    mut excess = order.size() - kept_previews
    for id in order.@ {
      if excess > 0 and id != self.expanded_image {
        self.previews.delete(id)
        excess = excess - 1
      } else {
        kept.push(id)
      }
    }
    self.preview_order = kept.@
  }

  // Opens an image in the system's default application from a private
  // temporary copy.
  fn mut open_image(attachment_id: Str) {
    match self.lifetime {
      lifetime => {
        match self.session {
          session => {
            let ctx = lifetime.Context
            let dispatch = self.host.dispatch
            async::start(fn() {
              let saved = match attachmentbridge::Open(session, ctx, attachment_id) {
                ok(download) => {
                  let path = image_preview::materialize(download)
                  let _ = download.Content.Close()
                  path
                },
                err(failure) => Result::err(failure),
              }
              let _ = dispatch(fn() {
                if self.active {
                  let opened = match saved {
                    ok(path) => (self.host.open_url)(path),
                    err(failure) => Result::err(failure),
                  }
                  match opened {
                    err(failure) => {
                      if not self.absorbs(failure) {
                        (self.host.toast)(
                          "Could not open image",
                          failure.error(),
                          toast::Variant::error,
                          false,
                        )
                      }
                    },
                    ok(_) => (),
                  }
                }
              })
            })
          },
          _ => (),
        }
      },
      _ => (),
    }
  }
}

// A staged file to upload.
struct Upload {
  token: Int,
  path: Str,
}

// Why a prompt cannot be sent yet.
struct Blocker {
  title: Str,
  detail: Str,
  variant: toast::Variant,
}

// Staged rows for the attachments of restored follow-ups.
private fn resolve(
  session: mut api::Session,
  ctx: context::Context,
  messages: [protocol::PromptInput],
) [attachments::Staged] {
  let ids = attachments::restored_ids(messages)
  let rows: [attachments::Staged] = match ids.size() == 0 {
    true => [],
    false => {
      let requested = mut ids
      let resolution: protocol::AttachmentResolution!Str = match session.ResolveAttachments(ctx, requested) {
        ok(resolved) => Result::ok(resolved),
        err(failure) => Result::err(failure.error()),
      }
      attachments::restored(ids, resolution)
    },
  }
  rows
}

// Uploads one file to the session.
private fn upload(session: mut api::Session, ctx: context::Context, path: Str) protocol::AttachmentInfo!Error {
  match os::Open(path) {
    ok(file) => {
      let timeout = contextbridge::WithTimeout(ctx, Int64::from(attachments::upload_timeout))
      let result = session.UploadAttachment(timeout.Context, filepath::Base(path), file)
      timeout.Cancel()
      let _ = file.Close()
      result
    },
    err(failure) => Result::err(failure),
  }
}

struct Effects {
  toasts: [Str],
  drafts: [Str],
}

private fn test_host(effects: mut Effects) Host {
  Host{
    dispatch: fn(action: fn()) Void!event::DispatchError {
      action()
      Result::ok(())
    },
    toast: fn(title: Str, detail: Str, variant: toast::Variant, persistent: Bool) {
      effects.toasts.push("{title}: {detail}")
    },
    attach: fn(attached: bootstrap::Attached, location: Str) {},
    restore_draft: fn(text: Str) {},
    prepend_draft: fn(text: Str) {
      effects.drafts.push(text)
    },
    show_latest: fn() {},
    open_url: fn(target: Str) Void!Error {
      Result::ok(())
    },
    image_matte: fn() ui::Color {
      ui::rgb(0, 0, 0)
    },
  }
}

private fn active_controller(effects: mut Effects) mut Controller {
  let result = controller(cli::TUIOptions{}, test_host(effects), 1, "")
  result.active = true
  result
}

test fn a_detached_controller_ignores_session_operations() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = detached(cli::TUIOptions{}, test_host(effects))
  subject.submit("hello")
  subject.reload()
  subject.create_sibling()
  subject.fork("try another approach")
  try testing::assert(not subject.can_submit(), "no session can receive prompts")
  try testing::assert(not subject.new_session_pending, "no fork starts")
  try testing::assert(subject.live.messages.size() == 0, "no optimistic prompt is added")
  testing::assert(effects.toasts.size() == 0, "inert operations report nothing")
}

test fn snapshots_project_session_state_and_report_each_mcp_warning_once() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  let snapshot = protocol::SessionSnapshot{
    Session: protocol::SessionInfo{ID: "session-1", Name: "Notes"},
    Messages: [
      protocol::TranscriptMessage{
        ID: "reply-1",
        Role: "assistant",
        Content: [protocol::TextBlock("hello")],
      },
    ],
    ContextTokens: 10,
    ContextWindow: 100,
    MCPWarnings: ["missing server"],
  }
  subject.apply_snapshot(snapshot)
  subject.apply_snapshot(snapshot)

  try testing::assert(subject.session_id() == "session-1", "the session record is adopted")
  try testing::assert(subject.transcript_messages().size() == 1, "the transcript is projected")
  try testing::assert(
    subject.context_tokens == 10 and subject.context_window == 100,
    "context usage is adopted",
  )
  testing::assert(
    strings::Join(mut effects.toasts, "|") == "MCP configuration warning: missing server",
    "each warning is reported once per attachment: {strings::Join(mut effects.toasts, "|")}",
  )
}

test fn session_records_only_update_the_attached_session() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1", Name: "Before"}},
  )
  subject.apply_info(protocol::SessionInfo{ID: "session-2", Name: "Other"})
  try testing::assert(
    subject.info.or(protocol::SessionInfo{}).Name == "Before",
    "other sessions are ignored",
  )
  subject.apply_info(protocol::SessionInfo{ID: "session-1", Name: "After"})
  testing::assert(
    subject.info.or(protocol::SessionInfo{}).Name == "After",
    "the attached record updates",
  )
}

struct Queue {
  actions: [fn()],
}

private fn queued_host(queue: mut Queue) Host {
  Host{
    dispatch: fn(action: fn()) Void!event::DispatchError {
      queue.actions.push(action)
      Result::ok(())
    },
    toast: fn(title: Str, detail: Str, variant: toast::Variant, persistent: Bool) {},
    attach: fn(attached: bootstrap::Attached, location: Str) {},
    restore_draft: fn(text: Str) {},
    prepend_draft: fn(text: Str) {},
    show_latest: fn() {},
    open_url: fn(target: Str) Void!Error {
      Result::ok(())
    },
    image_matte: fn() ui::Color {
      ui::rgb(0, 0, 0)
    },
  }
}

private fn run_queue(queue: mut Queue) {
  let actions = queue.actions
  queue.actions = []
  for action in actions {
    action()
  }
}

test fn dialog_records_apply_through_the_host_and_only_while_attached() Void!Str {
  let queue = mut Queue{actions: []}
  let subject = controller(cli::TUIOptions{}, queued_host(queue), 1, "")
  subject.active = true
  subject.apply_snapshot(
    protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1", Name: "Before"}},
  )

  subject.request_info(protocol::SessionInfo{ID: "session-1", Name: "Renamed"})
  try testing::assert(
    subject.info.or(protocol::SessionInfo{}).Name == "Before",
    "the record waits for the host's dispatch",
  )
  run_queue(queue)
  try testing::assert(
    subject.info.or(protocol::SessionInfo{}).Name == "Renamed",
    "the dispatched record updates the attachment",
  )

  subject.request_info(protocol::SessionInfo{ID: "session-1", Name: "Late"})
  subject.dispose()
  run_queue(queue)
  testing::assert(
    subject.info.or(protocol::SessionInfo{}).Name == "Renamed",
    "a record queued before replacement is discarded",
  )
}

test fn scratchpad_editor_reports_apply_through_the_host_and_only_while_attached() Void!Str {
  let queue = mut Queue{actions: []}
  let effects = mut Effects{toasts: [], drafts: []}
  let host = Host{
    dispatch: fn(action: fn()) Void!event::DispatchError {
      queue.actions.push(action)
      Result::ok(())
    },
    toast: fn(title: Str, detail: Str, variant: toast::Variant, persistent: Bool) {
      effects.toasts.push("{title}: {detail}")
    },
    attach: fn(attached: bootstrap::Attached, location: Str) {},
    restore_draft: fn(text: Str) {},
    prepend_draft: fn(text: Str) {},
    show_latest: fn() {},
    open_url: fn(target: Str) Void!Error {
      Result::ok(())
    },
    image_matte: fn() ui::Color {
      ui::rgb(0, 0, 0)
    },
  }
  let subject = controller(cli::TUIOptions{}, host, 1, "")
  subject.active = true
  subject.scratchpad_failure = "load failed"

  subject.request_scratchpad_saved(protocol::Scratchpad{Content: "saved notes"})
  subject.request_scratchpad_notice("Scratchpad save failed", "offline")
  try testing::assert(
    subject.scratchpad_record.is_none() and effects.toasts.size() == 0,
    "reports wait for the host's dispatch",
  )
  run_queue(queue)
  try testing::assert(
    subject.scratchpad_record.or(protocol::Scratchpad{}).Content == "saved notes",
    "a saved record becomes authoritative",
  )
  try testing::assert(subject.scratchpad_failure == "", "a saved record clears the load failure")
  try testing::assert(
    strings::Join(mut effects.toasts, "|") == "Scratchpad save failed: offline",
    "editor failures are reported once: {strings::Join(mut effects.toasts, "|")}",
  )

  try testing::assert(subject.request_scratchpad_retry(), "retry is accepted for scheduling")
  run_queue(queue)
  try testing::assert(
    subject.scratchpad_record.is_none(),
    "retry discards the cached record to reload it",
  )

  subject.request_scratchpad_saved(protocol::Scratchpad{Content: "late notes"})
  subject.request_scratchpad_notice("Late failure", "")
  subject.dispose()
  run_queue(queue)
  try testing::assert(
    subject.scratchpad_record.is_none(),
    "a save queued before replacement is discarded",
  )
  testing::assert(effects.toasts.size() == 1, "a notice queued before replacement is discarded")
}

test fn watched_turn_lifecycle_tracks_and_releases_the_active_turn() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "turn.started",
        TurnID: "turn-1",
        Sequence: 1,
      },
    ],
  )
  try testing::assert(subject.run_id == "turn-1" and subject.busy(), "a remote turn is claimed")
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "turn.completed",
        TurnID: "turn-1",
        Sequence: 2,
      },
    ],
  )
  testing::assert(
    subject.run_id == "" and not subject.busy(),
    "turn completion releases idle commands",
  )
}

private fn run(id: Str, status: Str) sessionbridge::Bash {
  sessionbridge::Bash{
    ID: id,
    Command: "ls",
    Status: status,
    ExitCode: 0,
    HasExitCode: status == "completed",
    TimedOut: false,
    Exclude: false,
    Output: "",
  }
}

private fn bash_ids(messages: [transcript::Message]) Str {
  let ids = mut List::new<Str>()
  for message in messages {
    if message.role == transcript::Role::bash {
      ids.push(message.id)
    }
  }
  strings::Join(ids, " ")
}

test fn only_a_bang_with_a_command_runs_directly() Void!Str {
  let included = parse_bash("!  git status ").expect("!command")
  try testing::assert(
    included.command == "git status" and (not included.exclude) and included.value == "!  git status ",
    "the result is added to context",
  )
  let excluded = parse_bash("!!ls").expect("!!command")
  try testing::assert(excluded.command == "ls" and excluded.exclude, "the result is kept out")
  testing::assert(
    parse_bash("!").is_none() and parse_bash("!! ").is_none() and parse_bash("run !ls").is_none(),
    "anything else is a prompt",
  )
}

test fn a_command_shows_after_the_transcript_or_the_active_turn() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.show_bash(run("bash_1", "running"))
  try testing::assert(bash_ids(subject.messages) == "bash_1", "idle runs follow the transcript")
  subject.show_bash(run("bash_1", "completed"))
  try testing::assert(
    subject.messages.size() == 1 and not subject.messages.at(0).expect("row").pending,
    "a later state replaces the row",
  )

  subject.run_id = "turn-1"
  subject.live.submit("hello", [])
  subject.show_bash(run("bash_2", "running"))
  testing::assert(
    bash_ids(subject.live.messages) == "bash_2" and bash_ids(subject.messages) == "bash_1",
    "a run during a turn follows the turn's rows",
  )
}

test fn a_snapshot_keeps_the_running_command_and_replaces_finished_ones() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.show_bash(run("bash_1", "completed"))
  subject.bash_id = "bash_2"
  subject.show_bash(run("bash_2", "running"))
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["a"], 1),
    },
  )
  // A finished run the server kept returns with the snapshot; one it did not
  // keep, as with `!!`, is gone.
  testing::assert(
    shown(subject) == "a bash_2" and subject.messages.at(1).expect("row").pending,
    "got {shown(subject)}",
  )
}

test fn command_history_starts_from_the_finished_commands_shown() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.show_bash(run("bash_1", "completed"))
  let excluded = mut run("bash_2", "completed")
  excluded.Exclude = true
  subject.show_bash(excluded.@)
  subject.show_bash(run("bash_3", "running"))
  let commands = subject.shown_commands()
  let first = commands.at(0).expect("newest")
  testing::assert(
    commands.size() == 2 and first.ID == "bash_2" and first.Exclude and commands.at(1).expect("older").ID == "bash_1",
    "newest first, without the running command",
  )
}

test fn one_command_runs_at_a_time() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.bash_id = "bash_1"
  subject.start_bash(parse_bash("!ls").expect("command"))
  testing::assert(
    effects.toasts.size() == 1 and effects.toasts.at(0).or("") == "Bash already running: " and subject.bash_id == "bash_1",
    "the second command waits",
  )
}

test fn escape_stops_a_command_before_the_turn() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.run_id = "turn-1"
  subject.live.activity = "Working…"
  subject.bash_starting = true
  try testing::assert(subject.can_interrupt() and subject.can_abort_bash(), "a starting command")
  try testing::assert(subject.interrupt(), "Escape is handled")
  try testing::assert(
    subject.bash_abort_requested and (not subject.abort_pending) and (not subject.can_abort_bash()),
    "the command stops once it starts; the turn keeps running",
  )
  try testing::assert(subject.can_interrupt(), "the next Escape stops the turn")

  subject.bash_starting = false
  subject.bash_abort_requested = false
  subject.settle_bash(run("bash_1", "aborted"))
  testing::assert(
    (not subject.can_abort_bash()) and bash_ids(subject.transcript_messages()) == "bash_1",
    "a settled command releases Escape",
  )
}

test fn a_running_command_counts_as_work() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.bash_id = "bash_1"
  try testing::assert(subject.working() and not subject.busy(), "work, but not a turn")
  subject.settle_bash(run("bash_1", "completed"))
  testing::assert(not subject.working(), "settling ends the work")
}

test fn turn_recovery_is_shown_only_for_the_active_turn() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.run_id = "turn-1"
  subject.live.activity = "Working…"
  subject.show_recovery("turn-0", turn_follower::Recovery::reconnecting)
  try testing::assert(subject.recovery_status() == "", "an earlier turn shows nothing")

  subject.show_recovery("turn-1", turn_follower::Recovery::reconnecting)
  try testing::assert(subject.recovery_status() == "Reconnecting activity…", subject.recovery_status())
  subject.show_recovery("turn-1", turn_follower::Recovery::healthy)
  try testing::assert(subject.recovery_status() == "", "a running turn clears reconnection")

  subject.show_recovery("turn-1", turn_follower::Recovery::syncing)
  try testing::assert(
    subject.recovery_status() == "Syncing final transcript…" and subject.activity() == "",
    "a finished turn syncs without activity",
  )
  subject.show_recovery("turn-1", turn_follower::Recovery::healthy)
  try testing::assert(
    subject.recovery_status() == "Syncing final transcript…",
    "only the final snapshot ends syncing",
  )

  subject.run_id = "turn-2"
  testing::assert(subject.recovery_status() == "", "a later turn shows nothing")
}

test fn a_final_snapshot_settles_a_turn_that_finished_while_disconnected() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1"}})
  subject.run_id = "turn-1"
  subject.live.submit("a", [])
  subject.show_recovery("turn-1", turn_follower::Recovery::syncing)

  subject.settle_run(
    protocol::TurnInfo{
      TurnID: "turn-1",
      Status: protocol::TurnStatusFailed,
      ErrorMessage: "provider failed",
    },
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["a"], 1),
      ActiveTurnID: "turn-2",
    },
  )
  try testing::assert(shown(subject) == "a ", "the snapshot and an error row: {shown(subject)}")
  let error_row = subject.messages.at(1).expect("error row")
  try testing::assert(
    error_row.is_error and error_row.text == "provider failed",
    "the turn's failure is reported",
  )
  try testing::assert(subject.live.messages.size() == 0, "the live turn is replaced")
  try testing::assert(subject.run_id == "turn-2", "the successor becomes active")
  testing::assert(subject.recovery_status() == "", "syncing ends")
}

test fn a_persisted_failure_is_not_reported_twice() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.run_id = "turn-a"
  subject.settle_run(
    protocol::TurnInfo{TurnID: "turn-a", Status: protocol::TurnStatusFailed},
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: [
        protocol::TranscriptMessage{
          ID: "a",
          TurnID: "turn-a",
          Sequence: Int64::from(1),
          Role: "assistant",
          IsError: true,
          ErrorMessage: "provider failed",
        },
      ],
    },
  )
  testing::assert(
    shown(subject) == "a" and subject.run_id == "",
    "only the persisted row: {shown(subject)}",
  )
}

test fn a_turn_without_a_final_snapshot_settles_what_streamed() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.run_id = "turn-1"
  subject.live.submit("hello", [])
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "tool.started",
        TurnID: "turn-1",
        ToolCallID: "call-1",
        ToolName: "bash",
        Sequence: 1,
      },
    ],
  )
  subject.show_recovery("turn-1", turn_follower::Recovery::syncing)

  subject.abandon_run(
    protocol::TurnInfo{TurnID: "turn-1", Status: protocol::TurnStatusInterrupted},
    Error::new("connection refused"),
  )
  // The prompt, the assistant message that called the tool, the tool, and
  // the error row.
  try testing::assert(subject.messages.size() == 4, "the streamed rows and an error row")
  let tool = subject.messages.at(2).expect("tool row")
  try testing::assert(
    tool.tool_state == transcript::ToolState::completed and not tool.pending,
    "the running tool is settled",
  )
  try testing::assert(
    subject.messages.at(3).expect("error row").text == "Run interrupted",
    "the status explains the turn",
  )
  try testing::assert(
    subject.run_id == "" and subject.live.messages.size() == 0 and subject.recovery_status() == "",
    "the turn is released",
  )
  testing::assert(
    effects.toasts.size() == 1 and effects.toasts.at(0).or("") == "Transcript refresh failed: The next turn will retry. connection refused",
    "the missing transcript is explained: {effects.toasts.size()}",
  )
}

test fn restored_follow_ups_go_before_the_draft_and_update_the_queue() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.follow_ups = protocol::FollowUpQueue{Count: 3, Previews: ["a", "b", "c"]}
  subject.attachments = [
    attachments::uploaded(protocol::AttachmentInfo{ID: "attachment-0", Filename: "staged.txt"}),
  ]
  subject.apply_restored_follow_ups(
    protocol::RestoreFollowUpsResult{
      Messages: [
        protocol::PromptInput{Text: "first"},
        protocol::PromptInput{AttachmentIDs: ["attachment-1"]},
        protocol::PromptInput{Text: "second"},
      ],
      Queue: protocol::FollowUpQueue{Count: 0},
    },
    [
      attachments::uploaded(protocol::AttachmentInfo{ID: "attachment-0", Filename: "staged.txt"}),
      attachments::uploaded(protocol::AttachmentInfo{ID: "attachment-1", Filename: "photo.png"}),
    ],
  )
  try testing::assert(subject.follow_ups.Count == 0, "the queue is emptied")
  try testing::assert(
    staged_names(subject) == "staged.txt photo.png",
    "restored files join the staged ones once: {staged_names(subject)}",
  )
  testing::assert(
    effects.drafts.size() == 1 and effects.drafts.at(0).or("") == "first\n\nsecond",
    "the texts are joined by blank lines: {effects.drafts.size()}",
  )
}

test fn promoted_follow_ups_update_the_queue_and_are_acknowledged() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.follow_ups = protocol::FollowUpQueue{Count: 2}
  subject.apply_promoted_follow_ups(
    protocol::PromoteFollowUpsResult{Promoted: 2, Queue: protocol::FollowUpQueue{Count: 0}},
  )
  try testing::assert(subject.follow_ups.Count == 0, "the queue is emptied")
  testing::assert(
    effects.toasts.size() == 1 and effects.toasts.at(0).or("") == "Follow-ups sent: Promoted 2 queued messages.",
    "the promotion is acknowledged",
  )
}

test fn follow_ups_change_only_on_a_connected_session() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.run_id = "turn-1"
  subject.follow_ups = protocol::FollowUpQueue{Count: 1}
  subject.restore_follow_ups()
  subject.promote_follow_ups()
  testing::assert(
    (not subject.follow_ups_changing) and effects.toasts.size() == 0,
    "nothing is requested without a session",
  )
}

private fn uploaded_rows(count: Int) [attachments::Staged] {
  let rows = mut List::new<attachments::Staged>()
  mut index = 0
  while index < count {
    rows.push(
      attachments::uploaded(
        protocol::AttachmentInfo{ID: "attachment-{index}", Filename: "f{index}.txt"},
      ),
    )
    index =+ 1
  }
  rows.@
}

test fn staging_refuses_images_the_model_cannot_receive() Void!Str {
  let directory = attachments::fixtures()
  defer os::RemoveAll(directory)
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.info = Maybe::new(
    protocol::SessionInfo{
      ID: "session-1",
      Model: "openai-codex/gpt-5.6-sol",
      Inputs: [protocol::ModelInputText],
    },
  )
  let uploads = subject.admit_attachments(
    [filepath::Join(directory, "notes.txt"), filepath::Join(directory, "image.png")],
  )
  try testing::assert(
    uploads.size() == 1 and staged_names(subject) == "notes.txt",
    "only the text file uploads: {staged_names(subject)}",
  )
  let row = subject.attachments.at(0).expect("row")
  try testing::assert(
    row.uploading and row.media_type == "text/plain" and row.token == uploads.at(0).expect("upload").token,
    "the row tracks its upload",
  )
  testing::assert(
    effects.toasts.size() == 1 and effects.toasts.at(0).or("") == "Images not attached: GPT 5.6 Sol doesn't accept images: image.png.",
    "the refusal names the model and the files",
  )
}

test fn a_paste_beyond_the_prompt_limit_is_rejected() Void!Str {
  let directory = attachments::fixtures()
  defer os::RemoveAll(directory)
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.attachments = uploaded_rows(7)
  let notes = filepath::Join(directory, "notes.txt")
  let uploads = subject.admit_attachments([notes, notes])
  try testing::assert(uploads.size() == 0 and subject.attachments.size() == 7, "nothing is staged")
  try testing::assert(
    effects.toasts.size() == 1 and effects.toasts.at(0).or("") == "Too many attachments: A prompt supports up to 8 files.",
    "the limit is explained",
  )
  let _ = subject.admit_attachments([notes])
  testing::assert(subject.attachments.size() == 8, "the eighth file is staged")
}

test fn finished_uploads_update_only_their_row() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.attachments = [
    attachments::uploading(1, "/tmp/a.txt", "text/plain"),
    attachments::uploading(2, "/tmp/b.png", "image/png"),
  ]
  subject.finish_upload(
    1,
    Result::ok(
      protocol::AttachmentInfo{
        ID: "attachment-a",
        Filename: "a.txt",
        MediaType: "text/plain",
      },
    ),
  )
  subject.finish_upload(2, Result::err(Error::new("too large")))
  let first = subject.attachments.at(0).expect("first")
  let second = subject.attachments.at(1).expect("second")
  try testing::assert(first.id == "attachment-a" and not first.uploading, "the upload is recorded")
  try testing::assert(
    second.failure == "too large" and not second.uploading and second.id == "",
    "the failure is recorded",
  )
  try testing::assert(
    effects.toasts.size() == 1 and effects.toasts.at(0).or("") == "Could not attach file: too large",
    "the failure is reported",
  )

  subject.remove_attachment(0)
  subject.finish_upload(1, Result::err(Error::new("late")))
  try testing::assert(staged_names(subject) == "b.png", "a removed row stays removed")
  try testing::assert(subject.clear_attachments(), "clearing reports staged files")
  testing::assert(not subject.clear_attachments(), "nothing is left to clear")
}

test fn only_discovered_prompt_commands_are_run_from_composer_text() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.prompt_commands = [
    protocol::PromptCommand{Name: "claude-fix", Source: protocol::PromptCommandSourceClaudeProject},
  ]
  let invoked = fn(subject: mut Controller, text: Str) Str {
    match subject.prompt_invocation(text) {
      invocation => "{invocation.Name}|{invocation.Arguments}",
      _ => "",
    }
  }
  try testing::assert(
    invoked(subject, "/claude-fix\n\"auth module\" now") == "claude-fix|\"auth module\" now",
    "arguments keep their quotes and line breaks",
  )
  try testing::assert(invoked(subject, "/claude-fix") == "claude-fix|", "arguments are optional")
  try testing::assert(invoked(subject, "/unknown 123") == "", "an unknown command is text")
  testing::assert(invoked(subject, "claude-fix 123") == "", "an invocation starts with a slash")
}

test fn a_prompt_command_with_staged_files_is_refused() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.prompt_commands = [
    protocol::PromptCommand{Name: "review", Source: protocol::PromptCommandSourceProject},
  ]
  subject.attachments = [
    attachments::uploaded(
      protocol::AttachmentInfo{
        ID: "attachment-1",
        Filename: "notes.txt",
        MediaType: "text/plain",
      },
    ),
  ]
  let blocked = match subject.send_blocker("/review --staged") {
    blocker => blocker.title,
    _ => "",
  }
  try testing::assert(blocked == "Prompt commands do not accept attachments", blocked)
  testing::assert(subject.send_blocker("review the notes").is_none(), "a prompt can carry them")
}

test fn staged_files_block_sending_until_they_can_be_sent() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.info = Maybe::new(
    protocol::SessionInfo{
      ID: "session-1",
      Model: "openai-codex/gpt-5.6-sol",
      Inputs: [protocol::ModelInputText],
    },
  )
  let blocked = fn(subject: mut Controller) Str {
    match subject.send_blocker("") {
      blocker => "{blocker.title}|{blocker.detail}",
      _ => "",
    }
  }
  try testing::assert(blocked(subject) == "", "nothing is staged")
  subject.attachments = [attachments::uploading(1, "/tmp/a.png", "image/png")]
  try testing::assert(blocked(subject) == "Wait for attachments to upload|", blocked(subject))

  subject.finish_upload(1, Result::err(Error::new("too large")))
  try testing::assert(blocked(subject) == "Remove failed attachments before sending|", blocked(subject))

  subject.attachments = [
    attachments::uploaded(
      protocol::AttachmentInfo{
        ID: "attachment-1",
        Filename: "a.png",
        MediaType: "image/png",
      },
    ),
  ]
  try testing::assert(
    blocked(subject) == "Remove images before sending|GPT 5.6 Sol doesn't accept images.",
    blocked(subject),
  )

  subject.attachments = attachments::restored(["attachment-1"], Result::err("timeout"))
  testing::assert(blocked(subject) == "", "an unresolved restored file is still sent")
}

test fn at_most_one_image_preview_is_expanded() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.toggle_image("attachment-1")
  try testing::assert(
    subject.expanded_image == "attachment-1" and subject.preview("attachment-1").is_some(),
    "expanding requests the preview",
  )
  subject.toggle_image("attachment-2")
  try testing::assert(subject.expanded_image == "attachment-2", "another image replaces it")
  subject.toggle_image("attachment-2")
  testing::assert(subject.expanded_image == "", "toggling again collapses it")
}

test fn a_sent_prompt_expands_its_first_image() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  let failed = mut attachments::uploaded(
    protocol::AttachmentInfo{
      ID: "attachment-0",
      Filename: "bad.png",
      MediaType: "image/png",
    },
  )
  failed.failure = "too large"
  subject.expand_sent_image(
    [
      attachments::uploaded(
        protocol::AttachmentInfo{
          ID: "attachment-1",
          Filename: "a.txt",
          MediaType: "text/plain",
        },
      ),
      failed.@,
      attachments::uploaded(
        protocol::AttachmentInfo{
          ID: "attachment-2",
          Filename: "b.png",
          MediaType: "image/png",
        },
      ),
      attachments::uploaded(
        protocol::AttachmentInfo{
          ID: "attachment-3",
          Filename: "c.png",
          MediaType: "image/png",
        },
      ),
    ],
  )
  testing::assert(
    subject.expanded_image == "attachment-2",
    "the first sent image: {subject.expanded_image}",
  )
}

test fn only_recent_previews_stay_decoded() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.toggle_image("attachment-1")
  for id in ["attachment-2", "attachment-3", "attachment-4", "attachment-5"] {
    subject.remember_preview(id)
    subject.previews.set(id, image_preview::loading())
  }
  try testing::assert(subject.preview("attachment-1").is_some(), "the expanded preview is kept")
  try testing::assert(subject.preview("attachment-2").is_none(), "the oldest other preview is dropped")
  testing::assert(
    subject.preview_order.size() == 4,
    "four previews are kept: {subject.preview_order.size()}",
  )
}

test fn disposal_ends_the_attachment_scope() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1"}})
  subject.dispose()
  subject.apply_info(protocol::SessionInfo{ID: "session-1", Name: "Late"})
  subject.apply_scratchpad_saved(protocol::Scratchpad{Content: "late"})
  try testing::assert(not subject.active and not subject.can_submit(), "a disposed attachment is inert")
  try testing::assert(subject.info.or(protocol::SessionInfo{}).Name == "", "late records are ignored")
  testing::assert(subject.scratchpad_record.is_none(), "late editor completions are ignored")
}

test fn a_fork_waits_only_for_work_that_replaces_the_attachment() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1"}, ActiveTurnID: "turn-1"},
  )
  subject.new_session_pending = true
  subject.fork("")
  subject.new_session_pending = false
  subject.reload_pending = true
  subject.fork("")
  testing::assert(
    effects.toasts.size() == 0 and not subject.new_session_pending,
    "a fork during session creation or reload is ignored without feedback",
  )
}

test fn only_an_unstarted_first_message_is_reported_as_failed() Void!Str {
  let started = protocol::ForkSessionResult{Session: protocol::SessionInfo{ID: "child"}}
  let unstarted = protocol::ForkSessionResult{
    Session: protocol::SessionInfo{ID: "child"},
    FirstTurnError: mut protocol::FirstTurnError{Code: protocol::FirstTurnUnavailable, Message: "session is unavailable"},
  }
  try testing::assert(failed_first_message("", unstarted).is_none(), "a fork without a message has none")
  try testing::assert(
    failed_first_message("explore", started).is_none(),
    "a started first message did not fail",
  )
  let failure = failed_first_message(
    "explore",
    unstarted,
  ).or(bootstrap::FailedFirstMessage{text: "", reason: ""})
  testing::assert(
    failure.text == "explore" and failure.reason == "session is unavailable",
    "the unstarted message keeps its text and reason",
  )
}

test fn a_failed_first_message_is_presented_like_a_failed_prompt() Void!Str {
  let drafts = mut List::new<Str>()
  let host = Host{
    dispatch: fn(action: fn()) Void!event::DispatchError {
      action()
      Result::ok(())
    },
    toast: fn(title: Str, detail: Str, variant: toast::Variant, persistent: Bool) {},
    attach: fn(attached: bootstrap::Attached, location: Str) {},
    restore_draft: fn(text: Str) {
      drafts.push(text)
    },
    prepend_draft: fn(text: Str) {},
    show_latest: fn() {},
    open_url: fn(target: Str) Void!Error {
      Result::ok(())
    },
    image_matte: fn() ui::Color {
      ui::rgb(0, 0, 0)
    },
  }
  let subject = controller(cli::TUIOptions{}, host, 1, "")
  subject.active = true
  subject.present_failed_first_message(
    bootstrap::FailedFirstMessage{text: "explore the other approach", reason: "session is unavailable"},
  )
  try testing::assert(
    drafts.size() == 1 and drafts.at(0).or("") == "explore the other approach",
    "the message returns to the composer",
  )
  testing::assert(subject.notice == "session is unavailable", "the reason is shown as the notice")
}

test fn a_snapshot_after_a_stream_replacement_rebases_the_live_turn() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1"}})
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "turn.started",
        TurnID: "turn-1",
        StreamID: "stream-a",
        Sequence: 1,
      },
      sessionbridge::Event{
        Kind: "assistant.text.delta",
        TurnID: "turn-1",
        StreamID: "stream-a",
        Sequence: 2,
        MessageID: "assistant-1",
        Delta: "one",
      },
    ],
  )
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      ActiveTurnID: "turn-1",
      EventStreamID: "stream-b",
      EventCursor: 0,
    },
  )
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "assistant.text.delta",
        TurnID: "turn-1",
        StreamID: "stream-b",
        Sequence: 1,
        MessageID: "assistant-1",
        Delta: " two",
      },
    ],
  )
  let messages = subject.transcript_messages()
  try testing::assert(subject.run_id == "turn-1", "the turn is still followed")
  testing::assert(
    messages.size() == 1 and messages.at(0).expect("reply").text == "one two",
    "the live reply continues on the replacement stream",
  )
}

private fn model_request(id: Str) protocol::InteractionRequest {
  protocol::InteractionRequest{
    ID: id,
    TurnID: "turn-1",
    ToolCallID: "call-1",
    Kind: protocol::InteractionConfirm,
    Title: "Proceed?",
  }
}

test fn pending_requests_queue_in_order_and_settle_by_id() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  let first = model_request("interaction_1")
  let second = model_request("interaction_2")
  let plugin = protocol::InteractionRequest{
    ID: "interaction_plugin",
    Plugin: mut protocol::PluginInteractionOwner{PluginID: "demo", Instance: "1"},
    Kind: protocol::InteractionConfirm,
    Title: "Plugin",
  }
  subject.apply_events(
    [
      // The session watch and the turn stream both deliver requests.
      sessionbridge::Event{
        Kind: "turn.started",
        TurnID: "turn-1",
        Sequence: 1,
      },
      sessionbridge::Event{
        Kind: "interaction.requested",
        Sequence: 2,
        Interaction: mut first,
        InteractionID: first.ID,
      },
      sessionbridge::Event{
        Kind: "interaction.requested",
        Sequence: 3,
        Interaction: mut second,
        InteractionID: second.ID,
      },
      sessionbridge::Event{
        Kind: "interaction.requested",
        Sequence: 3,
        Interaction: mut first,
        InteractionID: first.ID,
      },
      sessionbridge::Event{
        Kind: "interaction.requested",
        Sequence: 4,
        Interaction: mut plugin,
        InteractionID: plugin.ID,
      },
    ],
  )
  try testing::assert(subject.interactions.size() == 3, "{subject.interactions.size()} pending requests")
  try testing::assert(
    subject.interaction().or(protocol::InteractionRequest{}).ID == "interaction_1",
    "the oldest request is presented",
  )
  try testing::assert(
    subject.feedback_pending() and subject.activity() == "Waiting for feedback…",
    "a pending request reports feedback",
  )

  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "interaction.resolved",
        Sequence: 5,
        InteractionID: "interaction_1",
      },
    ],
  )
  try testing::assert(
    subject.interaction().or(protocol::InteractionRequest{}).ID == "interaction_2",
    "the next request is presented",
  )
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "interaction.resolved",
        Sequence: 6,
        InteractionID: "interaction_2",
      },
    ],
  )
  try testing::assert(
    subject.interaction().or(protocol::InteractionRequest{}).ID == "interaction_plugin",
    "plugin requests queue with model requests",
  )
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "interaction.resolved",
        Sequence: 7,
        InteractionID: "interaction_plugin",
      },
    ],
  )
  testing::assert(
    subject.interaction().is_none() and (not subject.feedback_pending()) and subject.activity() != "Waiting for feedback…",
    "settling every request ends feedback",
  )
}

test fn a_late_copy_of_a_settled_request_does_not_reopen_it() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  let request = model_request("interaction_1")
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "interaction.requested",
        Sequence: 1,
        Interaction: mut request,
        InteractionID: request.ID,
      },
      sessionbridge::Event{
        Kind: "interaction.resolved",
        Sequence: 2,
        InteractionID: request.ID,
      },
    ],
  )
  // The turn stream lags the session watch and delivers the request again.
  subject.apply_events(
    [
      sessionbridge::Event{
        Kind: "interaction.requested",
        Sequence: 1,
        Interaction: mut request,
        InteractionID: request.ID,
      },
    ],
  )
  try testing::assert(subject.interaction().is_none(), "the event stream copy stays settled")
  subject.apply_snapshot(
    protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1"}, PendingInteractions: [request]},
  )
  testing::assert(subject.interaction().is_none(), "a stale snapshot copy stays settled")
}

test fn snapshots_replace_pending_requests() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      PendingInteractions: [model_request("interaction_1"), model_request("interaction_2")],
    },
  )
  try testing::assert(subject.interactions.size() == 2, "snapshot requests are adopted")
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      PendingInteractions: [model_request("interaction_2")],
    },
  )
  testing::assert(
    subject.interactions.size() == 1 and subject.interaction().or(protocol::InteractionRequest{}).ID == "interaction_2",
    "a later snapshot drops settled requests",
  )
}

private fn transcript_messages(ids: [Str], first: Int) [protocol::TranscriptMessage] {
  let result = mut List::new<protocol::TranscriptMessage>()
  mut sequence = first
  for id in ids {
    result.push(
      protocol::TranscriptMessage{
        ID: id,
        TurnID: "turn-{id}",
        Sequence: Int64::from(sequence),
        Role: "user",
        Content: [protocol::TextBlock(id)],
      },
    )
    sequence =+ 1
  }
  result.@
}

private fn staged_names(subject: mut Controller) Str {
  mut joined = ""
  for item in subject.attachments {
    joined = match joined == "" {
      true => item.filename,
      false => "{joined} {item.filename}",
    }
  }
  joined
}

private fn shown(subject: mut Controller) Str {
  mut joined = ""
  for message in subject.messages {
    joined = match joined == "" {
      true => message.id,
      false => "{joined} {message.id}",
    }
  }
  joined
}

test fn earlier_history_continues_from_the_snapshot_and_survives_later_snapshots() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["c", "d"], 3),
      PreviousMessageCursor: "3",
      HasMoreMessages: true,
    },
  )
  try testing::assert(
    subject.history_more and subject.history_cursor == "3",
    "the snapshot's cursor starts history",
  )

  subject.prepend_page(
    protocol::TranscriptPage{
      SessionID: "session-1",
      Messages: transcript_messages(["a", "b"], 1),
      HasMoreMessages: false,
    },
  )
  try testing::assert(shown(subject) == "a b c d", "the page is prepended: {shown(subject)}")
  try testing::assert(not subject.history_more, "the beginning has been reached")

  // A later overlapping snapshot keeps the loaded pages and their cursor.
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["c", "d", "e"], 3),
      PreviousMessageCursor: "3",
      HasMoreMessages: true,
    },
  )
  try testing::assert(shown(subject) == "a b c d e", "loaded history is kept: {shown(subject)}")
  testing::assert(not subject.history_more, "the loaded beginning is retained")
}

test fn a_snapshot_that_replaces_history_restarts_its_cursor() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["a", "b"], 1),
    },
  )
  subject.history_failure = "connection refused"
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["summary", "z"], 9),
      PreviousMessageCursor: "9",
      HasMoreMessages: true,
    },
  )
  try testing::assert(shown(subject) == "summary z", "the snapshot replaces: {shown(subject)}")
  testing::assert(
    subject.history_more and subject.history_cursor == "9" and subject.history_failure == "",
    "history restarts from the new snapshot",
  )
}

test fn a_page_that_overlaps_the_transcript_is_reported_and_not_applied() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["c", "d"], 3),
      PreviousMessageCursor: "3",
      HasMoreMessages: true,
    },
  )
  subject.prepend_page(
    protocol::TranscriptPage{
      SessionID: "session-1",
      Messages: transcript_messages(["b", "c"], 2),
      PreviousMessageCursor: "2",
      HasMoreMessages: true,
    },
  )
  try testing::assert(shown(subject) == "c d", "the transcript is unchanged: {shown(subject)}")
  testing::assert(
    subject.history_failure != "" and subject.history_cursor == "3",
    "the failure pauses loading at the same cursor",
  )
}

test fn an_expired_cursor_recovers_from_a_fresh_snapshot() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["a", "b", "c"], 1),
      PreviousMessageCursor: "1",
      HasMoreMessages: true,
    },
  )
  subject.recover_history(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["summary", "d"], 20),
      PreviousMessageCursor: "20",
      HasMoreMessages: true,
    },
  )
  try testing::assert(shown(subject) == "summary d", "the fresh snapshot is shown: {shown(subject)}")
  testing::assert(subject.history_cursor == "20" and subject.history_more, "history restarts")
}

// The error a Go constructor reports.
private fn reported(result: Void!Error) Error {
  match result {
    err(failure) => failure,
    ok(_) => Error::new("no error was reported"),
  }
}

test fn an_incompatible_server_freezes_the_attachment_once() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      Messages: transcript_messages(["a", "b"], 1),
    },
  )
  subject.run_id = "turn-1"
  subject.live.activity = "Working…"
  subject.interactions = [protocol::InteractionRequest{ID: "interaction_1"}]

  let failure = reported(fmt::Errorf("watch session: %w", api::ErrIncompatibleServer))
  try testing::assert(subject.absorbs(failure), "the failure is not reported by its operation")
  try testing::assert(not subject.connected(), "the attachment is frozen")
  try testing::assert(
    subject.run_id == "" and (not subject.busy()) and subject.activity() == "" and (not subject.feedback_pending()),
    "nothing is shown as running or waiting",
  )
  try testing::assert(shown(subject) == "a b", "the transcript stays: {shown(subject)}")
  try testing::assert(
    effects.toasts.size() == 1 and effects.toasts.at(0).or("").starts_with("Server compatibility changed: "),
    "one explanation: {effects.toasts.size()}",
  )

  // Work cancelled by the freeze fails quietly.
  try testing::assert(
    subject.absorbs(reported(errors::New("context canceled"))),
    "later failures are quiet",
  )
  testing::assert(effects.toasts.size() == 1, "the explanation is shown once")
}

test fn ordinary_failures_are_reported_by_their_operation() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  try testing::assert(
    not subject.absorbs(reported(errors::New("connection refused"))),
    "an ordinary failure",
  )
  testing::assert(
    subject.connected() and effects.toasts.size() == 0,
    "the attachment stays connected",
  )
}

private fn wire(sequence: Int, turn_id: Str, payload: protocol::SessionEventPayload) protocol::SessionEvent {
  protocol::SessionEvent{
    StreamID: "stream-2",
    Sequence: Int64::from(sequence),
    SessionID: "session-1",
    TurnID: turn_id,
    Payload: payload,
  }
}

private fn shown_roles(subject: mut Controller) Str {
  mut joined = ""
  for message in subject.transcript_messages() {
    let role = match message.role {
      transcript::Role::user => "user",
      transcript::Role::assistant => "assistant",
      transcript::Role::tool => "tool",
      transcript::Role::bash => "bash",
      transcript::Role::plugin => "plugin:{message.text}",
      transcript::Role::other => "other",
    }
    joined = match joined == "" {
      true => role,
      false => "{joined} {role}",
    }
  }
  joined
}

// Each turn starts a new event stream, so the watch learns of a turn started
// elsewhere, here by a plugin's message, from a snapshot taken after the
// turn's first events.
test fn a_turn_found_in_a_watch_snapshot_is_followed_from_its_start() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1"}})
  subject.apply_watch_snapshot(
    protocol::SessionSnapshot{
      Session: protocol::SessionInfo{ID: "session-1"},
      ActiveTurnID: "turn-1",
      EventStreamID: "stream-2",
      EventCursor: Int64::from(2),
      EventReplayAvailable: true,
    },
  )
  try testing::assert(
    subject.followed_run == "turn-1" and subject.run_id == "turn-1" and subject.busy(),
    "the turn is claimed and followed",
  )

  // The watch resumes after the snapshot; the followed turn's events are left
  // to its stream, even when they arrive first.
  subject.apply_watched_events(
    [wire(3, "turn-1", protocol::AssistantStartedEvent{MessageID: "assistant-1"})],
  )
  try testing::assert(subject.transcript_messages().size() == 0, "the watch defers to the turn stream")

  // The turn stream replays the turn from its start.
  subject.apply_followed_events(
    [
      wire(1, "turn-1", protocol::TurnStartedEvent{Status: protocol::TurnStatusRunning}),
      wire(2, "turn-1", protocol::PluginMessageAddedEvent{PluginID: "autoresearch", Text: "Continue."}),
      wire(3, "turn-1", protocol::AssistantStartedEvent{MessageID: "assistant-1"}),
    ],
  )
  try testing::assert(
    shown_roles(subject) == "plugin:Continue. assistant",
    "the plugin's message shows while the turn runs: {shown_roles(subject)}",
  )
  try testing::assert(subject.can_abort(), "Escape can stop the turn")

  subject.apply_followed_events(
    [wire(4, "turn-1", protocol::TurnCompletedEvent{Status: protocol::TurnStatusCompleted})],
  )
  testing::assert(
    subject.followed_run == "" and subject.run_id == "" and (not subject.busy()),
    "completion releases the turn",
  )
}

test fn a_submission_in_flight_is_followed_when_accepted() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1"}})
  subject.start_pending = true
  subject.apply_watch_snapshot(
    protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1"}, ActiveTurnID: "turn-1"},
  )
  testing::assert(subject.followed_run == "", "the submission's response follows the turn")
}

test fn another_turn_being_followed_is_not_replaced_by_a_lagging_snapshot() Void!Str {
  let effects = mut Effects{toasts: [], drafts: []}
  let subject = active_controller(effects)
  subject.apply_snapshot(protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1"}})
  subject.follow_run("turn-2")
  subject.apply_watch_snapshot(
    protocol::SessionSnapshot{Session: protocol::SessionInfo{ID: "session-1"}, ActiveTurnID: "turn-1"},
  )
  testing::assert(subject.followed_run == "turn-2", "the newer turn stays followed")
}
