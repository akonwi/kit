use go:api/contract as protocol
use cooper/cui
use cooper/event
use cooper/keymap
use cooper/ui
use kit/tui/attachments
use kit/tui/controls
use kit/tui/format
use kit/tui/layout
use kit/tui/markdown
use kit/tui/spinner
use kit/tui/theme
use go:strings

// Shell chrome: the header, footer, and pending rows around the workspace.
// These are pure projections of their inputs. Actions arrive as commands owned
// by the caller, so chrome never decides which dialog opens.

// Header projects the attached session's identity, configuration, and
// context usage. Without a session it shows the product name.
struct Header {
  session: protocol::SessionInfo?,
  context_tokens: Int,
  context_window: Int,
  rename: keymap::SimpleCommand,
  model: keymap::SimpleCommand,
  thinking: keymap::SimpleCommand,
  debug: keymap::SimpleCommand,
}

fn header(themes: theme::Context, spec: Header) cui::View {
  let colors = themes.current()
  let left = mut List::new<cui::View>()
  let right = mut List::new<cui::View>()
  match spec.session {
    session => {
      left.push(
        controls::button(
          themes,
          format::session_name(session),
          spec.rename,
          variant: controls::ButtonVariant::secondary,
          compact: true,
          focusable: false,
          styles: ui::style(flex_shrink: 0.0),
        ),
      )
      right.push(
        controls::button(
          themes,
          format::model_name(session.Model),
          spec.model,
          variant: controls::ButtonVariant::secondary,
          compact: true,
          focusable: false,
          styles: ui::style(flex_shrink: 0.0),
        ),
      )
      let thinking_level = strings::TrimSpace(session.ThinkingLevel)
      if thinking_level != "" {
        right.push(cui::text(" ", wrap: ui::TextWrap::none))
        right.push(
          controls::button(
            themes,
            "({thinking_level})",
            spec.thinking,
            variant: controls::ButtonVariant::secondary,
            compact: true,
            focusable: false,
            styles: ui::style(flex_shrink: 0.0),
          ),
        )
      }
      match format::context_percentage(spec.context_tokens, spec.context_window) {
        percentage => {
          let tone = match percentage > 90 {
            true => colors.danger_text,
            false => {
              match percentage >= 80 {
                true => colors.warning_text,
                false => colors.muted,
              }
            },
          }
          right.push(cui::text(" · ", text_style: ui::text_style(foreground: colors.muted)))
          right.push(
            controls::button(
              themes,
              "{percentage}%",
              spec.debug,
              variant: controls::ButtonVariant::secondary,
              compact: true,
              focusable: false,
              foreground: tone,
              styles: ui::style(flex_shrink: 0.0),
            ),
          )
        },
        _ => (),
      }
    },
    _ => left.push(layout::line("kit", ui::text_style())),
  }
  cui::box(
    [
      cui::box(left.@, styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0))),
      cui::box(
        right.@,
        styles: ui::style(
          flex_grow: 2.0,
          flex_basis: ui::cells(0),
          flex_direction: ui::FlexDirection::row,
          justify_content: ui::Justify::end,
        ),
      ),
    ],
    styles: ui::style(
      height: ui::cells(1),
      flex_shrink: 0.0,
      flex_direction: ui::FlexDirection::row,
      padding: layout::inset(),
    ),
  )
}

// The footer's session status: the active turn's stream recovery, which
// outranks the queue that turn would drain, else the queued follow-ups.
fn session_status(recovery: Str, follow_ups: Int) Str {
  match {
    recovery != "" => recovery,
    follow_ups > 0 => "{follow_ups} queued · ↑ restore",
    _ => "",
  }
}

// footer shows, on the left, the session's connection problem, else a
// session status such as stream recovery or queued follow-ups, else the
// composer's current mode; the working location is on the right.
fn footer(themes: theme::Context, connection: Str, status: Str, mode: Str, location: Str) cui::View {
  let colors = themes.current()
  let shown = match {
    connection != "" => connection,
    status != "" => status,
    _ => mode,
  }
  let tone = match {
    connection != "" => colors.warning_text,
    status != "" => colors.muted,
    mode != "" => colors.success_text,
    _ => colors.muted,
  }
  cui::box(
    [
      cui::box(
        [layout::line(shown, ui::text_style(foreground: tone))],
        styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0)),
      ),
      cui::box(
        [layout::line(location, ui::text_style(foreground: colors.muted))],
        styles: ui::style(
          flex_grow: 2.0,
          flex_basis: ui::cells(0),
          flex_direction: ui::FlexDirection::row,
          justify_content: ui::Justify::end,
        ),
      ),
    ],
    styles: ui::style(
      height: ui::cells(1),
      flex_shrink: 0.0,
      flex_direction: ui::FlexDirection::row,
      padding: layout::inset(),
    ),
  )
}

// Pending projects the attachment's status line, queued follow-ups, and the
// files staged for the next prompt. A notice takes precedence over activity.
struct Pending {
  notice: Str,
  activity: Str,
  follow_ups: protocol::FollowUpQueue,
  attachments: [attachments::Staged],
  // The session's model name when it cannot receive images.
  rejecting_model: Str,
  // Removes the staged file at an index.
  remove_attachment: fn(Int),
}

// pending_row shows the status line followed by up to three follow-up
// previews (when more are queued, two previews and a remainder line), then
// one row per staged file.
fn pending_row(themes: theme::Context, spec: Pending) cui::View {
  let colors = themes.current()
  let content = match spec.notice != "" {
    true => layout::line(spec.notice, ui::text_style(foreground: colors.danger_text)),
    false => {
      match spec.activity != "" {
        true => pending_activity(themes, spec.activity),
        false => layout::line("", ui::text_style(foreground: colors.muted)),
      }
    },
  }
  let rows = mut List::new<cui::View>()
  rows.push(content)
  let maximum = match spec.follow_ups.Count > 3 {
    true => 2,
    false => 3,
  }
  mut visible = 0
  for preview, index in spec.follow_ups.Previews {
    if index < maximum {
      rows.push(
        layout::line("Follow-up {index + 1}: {preview}", ui::text_style(foreground: colors.muted)),
      )
      visible = visible + 1
    }
  }
  if spec.follow_ups.Count > visible {
    rows.push(
      layout::line(
        "+{spec.follow_ups.Count - visible} more follow-ups",
        ui::text_style(foreground: colors.muted),
      ),
    )
  }
  for item, index in spec.attachments {
    rows.push(attachment_row(colors, item, index, spec.rejecting_model, spec.remove_attachment))
  }
  cui::box(
    rows.@,
    styles: ui::style(
      flex_shrink: 0.0,
      flex_direction: ui::FlexDirection::column,
      padding: layout::inset(),
    ),
  )
}

// One staged file: its name and upload state, and a × that removes it.
private fn attachment_row(
  colors: theme::Theme,
  item: attachments::Staged,
  index: Int,
  rejecting_model: Str,
  remove: fn(Int),
) cui::View {
  let state = match {
    item.failure != "" => "upload failed",
    rejecting_model != "" and item.is_image() => "not supported by {rejecting_model}",
    item.uploading => "uploading…",
    _ => "",
  }
  let tone = match {
    item.failure != "" => colors.danger_text,
    rejecting_model != "" and item.is_image() => colors.warning_text,
    _ => colors.muted,
  }
  cui::box(
    [
      cui::text(
        "attachment ",
        text_style: ui::text_style(foreground: colors.primary_text),
        wrap: ui::TextWrap::none,
        styles: ui::style(flex_shrink: 0.0),
      ),
      cui::box(
        [layout::line(strings::TrimSpace("{item.filename} {state}"), ui::text_style(foreground: tone))],
        styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0)),
      ),
      cui::box(
        [
          cui::text("  ×", text_style: ui::text_style(foreground: colors.muted), wrap: ui::TextWrap::none),
        ],
        key: "remove-attachment-{index}",
        styles: ui::style(flex_shrink: 0.0),
        on_mouse: fn(received: mut event::MouseEvent, ctx: cui::Context) {
          if received.event_type == event::MouseEventType::up and received.button == event::MouseButton::left {
            remove(index)
            received.prevent_default()
          }
        },
      ),
    ],
    styles: ui::style(
      height: ui::cells(1),
      flex_shrink: 0.0,
      flex_direction: ui::FlexDirection::row,
    ),
  )
}

// pending_activity renders the latest thinking line as muted inline Markdown
// while preserving the pending slot's fixed one-row geometry.
fn pending_activity(themes: theme::Context, activity: Str) cui::View {
  let colors = themes.current()
  cui::box(
    [
      spinner::spinner(styles: ui::style(foreground: colors.muted, flex_shrink: 0.0)),
      cui::box(
        [
          markdown::inline_view(
            themes,
            "pending-activity",
            activity,
            base: ui::text_style(foreground: colors.muted),
            semantic: false,
          ),
        ],
        styles: ui::style(
          height: ui::cells(1),
          min_width: ui::cells(0),
          flex_grow: 1.0,
          flex_basis: ui::cells(0),
          overflow: ui::Overflow::hidden,
        ),
      ),
    ],
    styles: ui::style(
      height: ui::cells(1),
      flex_direction: ui::FlexDirection::row,
      gap: ui::cells(1),
    ),
  )
}
