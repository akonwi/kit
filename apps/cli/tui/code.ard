use ard/async

use go:context
use cooper/cui
use cooper/event
use cooper/ui
use go:github.com/akonwi/kit/internal/highlight
use go:kit/ffi/contextbridge
use kit/tui/theme
use go:strings

// Highlighted source: markdown code blocks, and file contents and diffs in
// tool output. It shows the plain source at once and its highlighted form when
// the shared highlighter has it.

// Bound async producers as well as the shared highlighter's workers and queue.
let highlight_slots = Chan::new<Void>(highlight::DefaultWorkers + highlight::DefaultQueueDepth)

struct Props {
  themes: theme::Context,
  // The source's language, or empty to detect it from path.
  language: Str,
  path: Str,
  source: Str,
  base: ui::TextStyle,
  // Whether syntax colors apply. Error and aborted text keeps its tone.
  semantic: Bool,
  // Whether long lines wrap; otherwise they keep their shape.
  wrap: Bool,
  // Shown before each line, such as a diff's `+`, in marker_color.
  marker: Str,
  marker_color: ui::Color?,
  // The fill behind the source and its padding.
  fill: ui::Color,
  // Cells of padding on each side.
  inset: Int,
}

fn view(key: Str, props: Props) cui::View {
  cui::child(new, props, key: key)
}

private fn request(props: Props) highlight::Request {
  source_request(props.language, props.path, props.source)
}

// What the highlighter is asked for: source with tabs as two spaces, in
// language or the language of path.
fn source_request(language: Str, path: Str, source: Str) highlight::Request {
  highlight::Request{
    Language: language,
    Path: path,
    Source: strings::ReplaceAll(source, "\t", "  "),
  }
}

// Highlights request off the UI thread and hands the result to done through
// dispatch. Source without a language is not highlighted. Otherwise the work
// waits in the background for a slot in the shared highlighter, which then
// has room for it, and is skipped if cancelled meanwhile. Returns the
// attempt, to cancel.
fn highlight_later(
  request: highlight::Request,
  dispatch: fn(fn()) Void!event::DispatchError,
  done: fn(highlight::Result),
) contextbridge::Cancellation? {
  match highlight::DetectLanguage(request.Language, request.Path) == "" {
    true => Maybe::new<contextbridge::Cancellation>(),
    false => {
      let attempt = contextbridge::WithCancel(context::Background())
      async::start(fn() {
        highlight_slots.send(())
        defer highlight_slots.recv()
        match attempt.Context.Err() {
          ok(_) => {
            let result = highlight::Default.Highlight(attempt.Context, request)
            attempt.Cancel()
            let _ = dispatch(fn() {
              done(result)
            })
          },
          err(_) => (),
        }
      })
      Maybe::new(attempt)
    },
  }
}

// The source without highlighting.
fn plain(request: highlight::Request) highlight::Result {
  highlight::Result{
    Source: highlight::Sanitize(request.Source),
    Language: highlight::DetectLanguage(request.Language, request.Path),
    Fallback: true,
  }
}

private struct Code {
  props: mut Props,
  request: highlight::Request,
  result: highlight::Result,
  generation: Int,
  context: cui::Context?,
  attempt: contextbridge::Cancellation?,
}

private fn new(props: mut Props) mut Code {
  let current = request(props.@)
  (mut Code{
    props: props,
    request: current,
    result: plain(current),
    generation: 0,
    context: Maybe::new<cui::Context>(),
    attempt: Maybe::new<contextbridge::Cancellation>(),
  })
}

impl cui::Lifecycle for Code {
  fn mut mounted(ctx: cui::Context) {
    self.context = Maybe::new(ctx)
    self.start(ctx)
  }

  fn mut unmounting(ctx: cui::Context) {
    self.cancel()
    self.context = Maybe::new<cui::Context>()
  }
}

impl Code {
  private fn mut cancel() {
    self.generation =+ 1
    match self.attempt {
      attempt => attempt.Cancel(),
      _ => (),
    }
    self.attempt = Maybe::new<contextbridge::Cancellation>()
  }

  private fn mut start(ctx: cui::Context) {
    self.cancel()
    let generation = self.generation
    self.attempt = highlight_later(self.request, ctx.dispatch, fn(result: highlight::Result) {
      if self.generation == generation {
        self.result = result
        self.attempt = Maybe::new<contextbridge::Cancellation>()
      }
    })
  }

  private fn mut refresh() {
    let current = request(self.props.@)
    let changed = current.Language != self.request.Language or current.Path != self.request.Path
    if changed or current.Source != self.request.Source {
      self.request = current
      self.result = plain(current)
      match self.context {
        ctx => self.start(ctx),
        _ => (),
      }
    }
  }
}

impl cui::Component for Code {
  fn mut render() cui::View {
    self.refresh()
    let colors = self.props.themes.current()
    let style = mut self.props.base
    style.background = self.props.fill
    let marker = match self.props.marker == "" {
      true => Maybe::new<Marker>(),
      false => Maybe::new(Marker{text: "{self.props.marker} ", color: self.props.marker_color}),
    }
    cui::box(
      [
        cui::text(
          styled(colors, self.props.semantic, self.result, marker),
          styles: match self.props.wrap {
            true => ui::style(),
            false => ui::style(flex_shrink: 0.0),
          },
          text_style: style.@,
          wrap: match self.props.wrap {
            true => ui::TextWrap::word,
            false => ui::TextWrap::none,
          },
          selectable: true,
          selection_style: theme::selection_style(colors),
        ),
      ],
      styles: ui::style(
        background: self.props.fill,
        flex_shrink: match self.props.wrap {
          true => 1.0,
          false => 0.0,
        },
        padding: ui::Edges{
          top: ui::cells(0),
          right: ui::cells(self.props.inset),
          bottom: ui::cells(0),
          left: ui::cells(self.props.inset),
        },
      ),
    )
  }
}

private struct Marker {
  text: Str,
  color: ui::Color?,
}

// The highlighted source as styled text, with marker before each line.
private fn styled(colors: theme::Theme, semantic: Bool, result: highlight::Result, marker: Marker?) ui::StyledText {
  let spans = mut List::new<ui::Span>()
  let push = fn(text: Str, foreground: ui::Color?) {
    match marker {
      mark => {
        let lines = strings::Split(text, "\n")
        for line, index in lines {
          if index > 0 {
            spans.push(ui::span("\n"))
          }
          if index > 0 or spans.size() == 0 {
            spans.push(ui::span(mark.text, style: ui::span_style(foreground: mark.color)))
          }
          if line != "" {
            spans.push(ui::span(line, style: ui::span_style(foreground: foreground)))
          }
        }
        ()
      },
      _ => {
        spans.push(ui::span(text, style: ui::span_style(foreground: foreground)))
        ()
      },
    }
  }
  mut position = 0
  for capture in result.Spans {
    if capture.Start > position {
      push(result.Source.slice(position, capture.Start).or(""), Maybe::new<ui::Color>())
    }
    let foreground = match semantic {
      true => Maybe::new(colors.syntax(capture.Role.to_str())),
      false => Maybe::new<ui::Color>(),
    }
    push(result.Source.slice(capture.Start, capture.End).or(""), foreground)
    position = capture.End
  }
  if position < result.Source.size() {
    push(result.Source.slice(position, result.Source.size()).or(""), Maybe::new<ui::Color>())
  }
  if spans.size() == 0 {
    push(result.Source, Maybe::new<ui::Color>())
  }
  ui::styled_text(spans.@)
}
