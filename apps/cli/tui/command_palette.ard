use go:api/contract as protocol
use cooper/cui
use cooper/keymap
use cooper/ui
use kit/tui/after_commit
use kit/tui/layout
use kit/tui/modal
use kit/tui/palette
use kit/tui/theme
use go:strings

// The command palette owns command discovery and invocation parsing: its query,
// selection, hover, viewport, search focus, argument semantics, and activation
// validation. Shell supplies live session capabilities and executes resolved
// actions; it does not inspect palette rows or query text.

// command_word extracts the palette's command token; the remaining query is
// literal command input rather than catalog-filter text.
fn command_word(query: Str) Str {
  let trimmed = strings::TrimSpace(query)
  let separator = strings::Index(trimmed, " ")
  match separator < 0 {
    true => trimmed,
    false => trimmed.slice(0, separator).or(""),
  }
}

// command_args removes one command token and one separator, preserving all
// remaining whitespace for plugin argument fidelity.
fn command_args(query: Str) Str {
  let invocation = strings::TrimLeft(query, " \t")
  let leading = query.size() - invocation.size()
  let separator = strings::Index(invocation, " ")
  match separator < 0 {
    true => "",
    false => query.slice(leading + separator + 1, query.size()).or(""),
  }
}

private fn command_item_with_hint(
  key: Str,
  hint: Str,
  description: Str,
  terms: Str,
  disabled_reason: Str,
) palette::Item {
  palette::Item{
    key: key,
    label: key,
    hint: hint,
    description: description,
    meta: "",
    search_terms: strings::Split(terms, " "),
    disabled_reason: disabled_reason,
  }
}

// The palette label of a prompt command source: `user`, `project`, or
// `claude` for Claude Code project commands.
fn source_label(source: Str) Str {
  match source == protocol::PromptCommandSourceClaudeProject {
    true => "claude",
    false => source,
  }
}

private fn command_item(key: Str, description: Str, terms: Str, disabled_reason: Str) palette::Item {
  palette::Item{
    key: key,
    label: key,
    description: description,
    hint: "",
    meta: "",
    search_terms: strings::Split(terms, " "),
    disabled_reason: disabled_reason,
  }
}

// sorted_catalog keeps built-ins and discovered commands in one stable,
// case-insensitive alphabetical catalog.
private fn sorted_catalog(items: [palette::Item]) [palette::Item] {
  let result = mut List::new<palette::Item>()
  let placed = mut List::new<Str>()
  while result.size() < items.size() {
    mut next = Maybe::new<palette::Item>()
    for item in items {
      mut already_placed = false
      for key in placed {
        if key == item.key {
          already_placed = true
        }
      }
      if not already_placed {
        match next {
          current => {
            if strings::Compare(strings::ToLower(item.label), strings::ToLower(current.label)) < 0 {
              next = Maybe::new(item)
            }
          },
          _ => { next = Maybe::new(item) },
        }
      }
    }
    match next {
      item => {
        placed.push(item.key)
        result.push(item)
      },
      _ => (),
    }
  }
  result.@
}

// Commands that need no server: diagnostics and MCP status read the last
// snapshot, login, themes, and quitting are local, and settings keeps this
// terminal's preferences usable while it explains the server's.
let local_commands = ["debug", "login", "mcp", "quit", "settings", "theme"]

// command_catalog preserves the established command vocabulary while this
// client reaches feature parity. Commands whose owning surface is not ported
// yet stay discoverable but cannot be activated. Once the server can no longer
// serve the attachment, only local commands remain.
fn command_catalog(
  running: Bool,
  connected: Bool,
  prompt_commands: [protocol::PromptCommand],
  plugin_commands: [protocol::PluginCommand],
) [palette::Item] {
  match connected {
    true => available_catalog(running, prompt_commands, plugin_commands),
    false => {
      let local = mut List::new<palette::Item>()
      for item in available_catalog(running, [], []) {
        for key in local_commands {
          if item.key == key {
            local.push(item)
          }
        }
      }
      local.@
    },
  }
}

private fn available_catalog(
  running: Bool,
  prompt_commands: [protocol::PromptCommand],
  plugin_commands: [protocol::PluginCommand],
) [palette::Item] {
  let cd_disabled = match running {
    true => "idle only",
    false => "",
  }
  let builtins = [
    command_item_with_hint(
      "cd",
      "[path]",
      "Change working directory",
      "cwd directory folder",
      cd_disabled,
    ),
    command_item(
      "compact",
      "Compact session context",
      "summarize shrink",
      match running {
        true => "idle only",
        false => "",
      },
    ),
    command_item("debug", "Show session diagnostics", "details usage", ""),
    command_item("diff", "Review working-tree changes", "changes working tree", ""),
    command_item("files", "Open a workspace file", "file open browse", ""),
    command_item_with_hint(
      "fork",
      "[message]",
      "Fork the current session into a linked child session",
      "branch",
      "",
    ),
    command_item("login", "Connect another provider", "auth connect provider", ""),
    command_item("mcp", "Show configured MCP servers", "tools connections status", ""),
    command_item("model", "Change session model", "engine", ""),
    command_item_with_hint("name", "[name]", "Rename session", "rename title", ""),
    command_item("new", "Start a new session", "", ""),
    command_item("pair", "Pair another device with this server", "device link remote connect", ""),
    command_item("quit", "Exit Kit", "close exit", ""),
    command_item(
      "refresh-models",
      "Update the provider catalog of models",
      "catalog models",
      match running {
        true => "idle only",
        false => "",
      },
    ),
    command_item("reload", "Reload session context", "agents context refresh", ""),
    command_item("scratchpad", "Open shared working notes", "notes memory", ""),
    command_item("sessions", "Browse sessions", "list resume switch threads", ""),
    command_item("settings", "Change server and terminal settings", "preferences options config", ""),
    command_item("subagents", "Inspect delegated work", "agents delegates children", ""),
    command_item("tabs", "Open a workspace tab", "panes workspace", ""),
    command_item("theme", "Choose UI colors", "appearance colors", ""),
    command_item("thinking", "Change reasoning effort", "reasoning effort", ""),
  ]
  let catalog = mut List::new<palette::Item>()
  for item in builtins {
    catalog.push(item)
  }
  for command in prompt_commands {
    mut shadows_builtin = false
    for builtin in builtins {
      if builtin.label == command.Name {
        shadows_builtin = true
      }
    }
    if not shadows_builtin {
      catalog.push(
        palette::Item{
          // Prompt commands submit as queued follow-ups while a turn is live.
          key: "prompt:{command.Name}",
          label: command.Name,
          description: command.Description,
          hint: command.ArgumentHint,
          meta: source_label(command.Source),
          search_terms: [source_label(command.Source), command.Location],
          disabled_reason: "",
        },
      )
    }
  }
  for command in plugin_commands {
    let hint = match command.ArgName != "" {
      true => "<{command.ArgName}>",
      false => "",
    }
    // Instance-backed keys distinguish same-named contributions from separate
    // plugins. The short command name is visible; plugin metadata disambiguates
    // duplicate names while canonical ID remains the execution identity.
    catalog.push(
      palette::Item{
        key: "plugin:{command.Instance}:{command.ID}",
        label: command.LocalID,
        hint: hint,
        description: command.Description,
        meta: command.PluginID,
        search_terms: [command.ID, command.PluginID, command.Category],
        disabled_reason: "",
      },
    )
  }
  sorted_catalog(catalog.@)
}

// ActionKind identifies one executable command resolved by the palette.
enum ActionKind {
  login,
  quit,
  compact,
  debug,
  mcp,
  model,
  theme,
  thinking,
  rename,
  new_session,
  fork,
  pair,
  refresh_models,
  reload,
  sessions,
  settings,
  scratchpad,
  subagents,
  tabs,
  files,
  diff,
  change_directory,
  prompt_command,
  plugin_command,
}

// Action is a validated invocation. argument is trimmed for built-ins and kept
// literal for prompt and plugin commands.
struct Action {
  kind: ActionKind,
  argument: Str,
  prompt_command: Str,
  plugin_command: protocol::PluginCommand?,
}

// Notice is user-facing feedback for an activation that cannot run. The
// palette remains open so the invocation can be corrected.
struct Notice {
  title: Str,
  detail: Str,
}

// Props contains live Shell-owned capabilities and result callbacks.
struct Props {
  themes: theme::Context,
  busy: Bool,
  // Whether the server can still serve the attachment. Without it, only
  // commands that work locally are offered.
  connected: Bool,
  prompt_commands: [protocol::PromptCommand],
  plugin_commands: [protocol::PluginCommand],
  dismiss: fn() Bool,
  activate: fn(Action),
  notice: fn(Notice),
}

struct Palette {
  // props remains linked to cui::child's mutable slot so catalog capabilities
  // refresh without resetting the local query, selection, or viewport.
  props: mut Props,
  context: cui::Context?,
  search: mut cui::InputRef,
  list: mut cui::VirtualListRef,
  query: Str,
  selection: Str,
  hovered: Str,
  hidden_above: Bool,
  hidden_below: Bool,
  viewport: Int,
  // pending is the command awaiting its required argument. While set, the
  // palette frame shows the argument input instead of the command list, and
  // the list's query and selection are kept for returning to it.
  pending: PendingArgument?,
  argument: Str,
  argument_error: Str,
}

struct PendingArgument {
  key: Str,
  prompt: ArgumentPrompt,
}

// view mounts a fresh palette for each opening.
fn view(props: Props) cui::View {
  cui::child(new, props, key: "command-palette")
}

private fn new(props: mut Props) mut Palette {
  (mut Palette{
    props: props,
    context: Maybe::new<cui::Context>(),
    search: cui::input_ref(),
    list: cui::virtual_list_ref(),
    query: "",
    selection: palette::first_enabled(
      command_catalog(props.busy, props.connected, props.prompt_commands, props.plugin_commands),
    ),
    hovered: "",
    hidden_above: false,
    hidden_below: false,
    viewport: 0,
    pending: Maybe::new<PendingArgument>(),
    argument: "",
    argument_error: "",
  })
}

private fn unavailable(reason: Str) Notice {
  Notice{title: "Command unavailable", detail: reason}
}

// ArgumentPrompt describes the input a built-in command requests when it is
// activated without its required argument. Extension commands do not declare
// whether their argument is required, so they never prompt.
struct ArgumentPrompt {
  title: Str,
  placeholder: Str,
  // missing is the inline error shown when the prompt is submitted empty.
  missing: Str,
}

// argument_prompt returns the input to request before an enabled built-in can
// run, or nothing when the invocation already carries its argument.
fn argument_prompt(item: palette::Item, query: Str) ArgumentPrompt? {
  match item.disabled_reason == "" and strings::TrimSpace(command_args(query)) == "" {
    true => {
      match item.key {
        "cd" => {
          Maybe::new(
            ArgumentPrompt{
              title: "Change working directory",
              placeholder: "Path",
              missing: "Enter a path",
            },
          )
        },
        _ => Maybe::new<ArgumentPrompt>(),
      }
    },
    false => Maybe::new<ArgumentPrompt>(),
  }
}

// resolve validates one activated row against the invocation query, returning
// an executable action or feedback that keeps the palette open.
fn resolve(
  item: palette::Item,
  query: Str,
  prompt_commands: [protocol::PromptCommand],
  plugin_commands: [protocol::PluginCommand],
) Action!Notice {
  resolve_arguments(item, command_args(query), prompt_commands, plugin_commands)
}

// resolve_arguments validates one command against its literal argument text.
private fn resolve_arguments(
  item: palette::Item,
  literal: Str,
  prompt_commands: [protocol::PromptCommand],
  plugin_commands: [protocol::PluginCommand],
) Action!Notice {
  let trimmed = strings::TrimSpace(literal)
  let builtin = fn(kind: ActionKind) Action!Notice {
    Result::ok(
      Action{
        kind: kind,
        argument: trimmed,
        prompt_command: "",
        plugin_command: Maybe::new<protocol::PluginCommand>(),
      },
    )
  }
  if item.disabled_reason != "" {
    Result::err(unavailable(item.disabled_reason))
  } else {
    match item.key {
      "login" => builtin(ActionKind::login),
      "quit" => builtin(ActionKind::quit),
      "compact" => builtin(ActionKind::compact),
      "debug" => builtin(ActionKind::debug),
      "mcp" => builtin(ActionKind::mcp),
      "model" => builtin(ActionKind::model),
      "theme" => builtin(ActionKind::theme),
      "thinking" => builtin(ActionKind::thinking),
      "name" => builtin(ActionKind::rename),
      "new" => builtin(ActionKind::new_session),
      "fork" => builtin(ActionKind::fork),
      "pair" => builtin(ActionKind::pair),
      "refresh-models" => builtin(ActionKind::refresh_models),
      "reload" => builtin(ActionKind::reload),
      "sessions" => builtin(ActionKind::sessions),
      "settings" => builtin(ActionKind::settings),
      "scratchpad" => builtin(ActionKind::scratchpad),
      "subagents" => builtin(ActionKind::subagents),
      "tabs" => builtin(ActionKind::tabs),
      "files" => builtin(ActionKind::files),
      "diff" => builtin(ActionKind::diff),
      "cd" => {
        match trimmed == "" {
          true => Result::err(Notice{title: "Usage: /cd <path>", detail: ""}),
          false => builtin(ActionKind::change_directory),
        }
      },
      _ => {
        mut resolved = Maybe::new<Action>()
        for command in prompt_commands {
          if item.key == "prompt:{command.Name}" {
            resolved = Maybe::new(
              Action{
                kind: ActionKind::prompt_command,
                argument: literal,
                prompt_command: command.Name,
                plugin_command: Maybe::new<protocol::PluginCommand>(),
              },
            )
          }
        }
        for command in plugin_commands {
          if item.key == "plugin:{command.Instance}:{command.ID}" {
            resolved = Maybe::new(
              Action{
                kind: ActionKind::plugin_command,
                argument: literal,
                prompt_command: "",
                plugin_command: Maybe::new(command),
              },
            )
          }
        }
        match resolved {
          action => Result::ok(action),
          _ => Result::err(unavailable("not available yet")),
        }
      },
    }
  }
}

impl cui::Lifecycle for Palette {
  fn mut mounted(context: cui::Context) {
    self.context = Maybe::new(context)
  }

  fn mut unmounting(context: cui::Context) {}
}

impl Palette {
  private fn mut catalog() [palette::Item] {
    command_catalog(
      self.props.busy,
      self.props.connected,
      self.props.prompt_commands,
      self.props.plugin_commands,
    )
  }

  private fn mut visible() [palette::Item] {
    palette::items(self.view_props(self.catalog()))
  }

  private fn mut view_props(catalog: [palette::Item]) palette::Props {
    palette::Props{
      themes: self.props.themes,
      placeholder: "Search commands…",
      catalog: catalog,
      query: self.query,
      filter_query: command_word(self.query),
      tree: Maybe::new<[palette::Branch]>(),
      selection: self.selection,
      hovered: self.hovered,
      hidden_above: self.hidden_above,
      hidden_below: self.hidden_below,
      on_query_change: fn(query: Str) {
        self.change_query(query)
      },
      on_selection_change: fn(selection: Str) {
        self.select(selection)
      },
      on_hover_change: fn(hovered: Str) {
        self.hovered = hovered
      },
      on_activate: fn(item: palette::Item) {
        self.activate(item)
      },
    }
  }

  // Filtering follows only the command word, so typing arguments keeps the
  // selected command stable.
  private fn mut change_query(query: Str) {
    let previous_word = command_word(self.query)
    self.query = query
    self.hovered = ""
    if command_word(query) != previous_word or not self.selection_visible() {
      let next = palette::first_enabled(self.visible())
      if next != "" {
        self.select(next)
      }
    }
  }

  private fn mut selection_visible() Bool {
    mut found = false
    for item in self.visible() {
      if item.key == self.selection {
        found = true
      }
    }
    found
  }

  private fn mut select(selection: Str) {
    self.selection = selection
    match self.context {
      context => {
        let list = self.list
        let _ = after_commit::once(context, fn() {
          let _ = list.current.map(fn(current) {
            current.reveal(selection)
          })
        })
      },
      _ => (),
    }
  }

  // complete turns the selected row into an invocation buffer.
  private fn mut complete() Bool {
    match palette::selected(self.visible(), self.selection) {
      item => {
        self.query = "{item.label} "
        self.hovered = ""
        true
      },
      _ => false,
    }
  }

  private fn mut activate(item: palette::Item) {
    match argument_prompt(item, self.query) {
      prompt => {
        self.pending = Maybe::new(PendingArgument{key: item.key, prompt: prompt})
        self.argument = ""
        self.argument_error = ""
      },
      _ => {
        match resolve(item, self.query, self.props.prompt_commands, self.props.plugin_commands) {
          ok(action) => self.props.activate(action),
          err(notice) => self.props.notice(notice),
        }
      },
    }
  }

  // submit_argument runs the pending command against the live catalog, so a
  // capability lost while prompting is reported rather than bypassed.
  private fn mut submit_argument(pending: PendingArgument) {
    if strings::TrimSpace(self.argument) == "" {
      self.argument_error = pending.prompt.missing
    } else {
      match palette::selected(self.catalog(), pending.key) {
        item => {
          match resolve_arguments(item, self.argument, self.props.prompt_commands, self.props.plugin_commands) {
            ok(action) => self.props.activate(action),
            err(notice) => self.props.notice(notice),
          }
        },
        _ => self.props.notice(unavailable("not available yet")),
      }
    }
  }

  // back returns from the argument input to the command list as it was left.
  private fn mut back() Bool {
    self.pending = Maybe::new<PendingArgument>()
    self.argument = ""
    self.argument_error = ""
    self.select(self.selection)
    true
  }

  // argument_dialog keeps the palette's picker frame while requesting the
  // pending command's argument; Escape returns to the command list.
  private fn mut argument_dialog(pending: PendingArgument) cui::View {
    let colors = self.props.themes.current()
    let back = keymap::simple_command("palette.back", "Back to commands", fn() Bool {
      self.back()
    })
    modal::dialog(
      self.props.themes,
      modal::Dialog{
        placement: modal::Placement::picker,
        title: pending.prompt.title,
        meta: "",
        header: [
          // A one-cell leading spacer aligns the field with the command
          // palette's search text.
          cui::box(
            [
              cui::text(" ", styles: ui::style(width: ui::cells(1), flex_shrink: 0.0)),
              cui::input(
                self.argument,
                key: "command-palette.argument",
                placeholder: pending.prompt.placeholder,
                autofocus: true,
                styles: ui::style(
                  padding: ui::Edges{
                    top: ui::cells(0),
                    right: ui::cells(1),
                    bottom: ui::cells(0),
                    left: ui::cells(0),
                  },
                  background: colors.background,
                  flex_grow: 1.0,
                  flex_basis: ui::cells(0),
                ),
                on_input: fn(value: Str, ctx: cui::Context) {
                  self.argument = value
                  self.argument_error = ""
                },
                on_submit: fn(value: Str, ctx: cui::Context) {
                  self.submit_argument(pending)
                },
              ),
            ],
            styles: ui::style(
              flex_direction: ui::FlexDirection::row,
              flex_shrink: 0.0,
              background: colors.background,
            ),
          ),
          cui::divider(),
        ],
        body: cui::box(
          [
            cui::text(
              self.argument_error,
              styles: ui::style(
                padding: ui::Edges{
                  top: ui::cells(0),
                  right: ui::cells(1),
                  bottom: ui::cells(0),
                  left: ui::cells(1),
                },
              ),
              text_style: ui::text_style(foreground: colors.danger_text),
            ),
          ],
          styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0)),
        ),
        footer: Maybe::new<cui::View>(),
        autofocus: false,
        dismiss: back,
        commands: Maybe::new<[keymap::Command]>(),
        bindings: Maybe::new<[keymap::Binding]>(),
      },
    )
  }

  private fn mut viewport_props() palette::Viewport {
    palette::Viewport{
      list: self.list,
      on_update: fn(update: cui::VirtualListUpdate, context: cui::Context) {
        let count = self.visible().size()
        self.hidden_above = update.state.visible_range.start > 0
        self.hidden_below = update.state.visible_range.end < count
        self.viewport = update.state.viewport_height
      },
      on_page: fn(direction: Int) {
        let step = match self.viewport > 1 {
          true => self.viewport - 1,
          false => 1,
        }
        let _ = self.list.current.map(fn(list) {
          let _ = list.scroll_by(direction * step)
        })
      },
    }
  }
}

impl cui::Component for Palette {
  fn mut render() cui::View {
    match self.pending {
      pending => self.argument_dialog(pending),
      _ => self.command_dialog(),
    }
  }
}

impl Palette {
  private fn mut command_dialog() cui::View {
    let catalog = self.catalog()
    // Capabilities can change while the palette is open. Keep the selected row
    // when it remains visible; otherwise fall back to the first enabled row.
    if not self.selection_visible() {
      self.selection = palette::first_enabled(palette::items(self.view_props(catalog)))
    }
    let picker = self.view_props(catalog)
    let navigation = palette::navigation(picker)
    let complete = keymap::simple_command("palette.complete", "Complete command", fn() Bool {
      self.complete()
    })
    let dismiss = keymap::simple_command("palette.dismiss", "Close", fn() Bool {
      self.props.dismiss()
    })
    modal::dialog(
      self.props.themes,
      modal::Dialog{
        // The palette is the modal's only focus owner while open; controlled
        // focus keeps the search field authoritative across Shell rerenders.
        placement: modal::Placement::picker,
        title: "",
        meta: "",
        header: palette::header(picker, Maybe::new(true), Maybe::new(self.search)),
        body: palette::body(picker, self.viewport_props()),
        footer: Maybe::new(
          cui::box(
            [layout::line("tab complete", ui::text_style(foreground: self.props.themes.current().muted))],
            styles: ui::style(
              padding: ui::Edges{
                top: ui::cells(0),
                right: ui::cells(1),
                bottom: ui::cells(0),
                left: ui::cells(1),
              },
              flex_shrink: 0.0,
            ),
          ),
        ),
        autofocus: false,
        dismiss: dismiss,
        commands: Maybe::new([navigation.up, navigation.down, complete]),
        bindings: Maybe::new(
          [
            keymap::binding(keymap::key("tab"), complete.with()),
            keymap::binding(keymap::key("up"), navigation.up.with(), keymap::Trigger::press_or_repeat),
            keymap::binding(keymap::key("down"), navigation.down.with(), keymap::Trigger::press_or_repeat),
          ],
        ),
      },
    )
  }
}
