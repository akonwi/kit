use cooper/cui
use cooper/event
use cooper/keymap
use cooper/ui
use kit/tui/attachments
use kit/tui/inline_picker
use kit/tui/theme
use go:strings

// Ref is the Shell's narrow control surface for explicit focus and draft
// lifecycle events. Its actions always dispatch through the retained Composer.
struct Ref {
  focus_action: (fn() Bool)?,
  clear_action: (fn() Bool)?,
  reset_action: (fn() Bool)?,
  restore_action: (fn(Str) Bool)?,
  prepend_action: (fn(Str) Bool)?,
  history_action: (fn([HistoryEntry]) Bool)?,
  bash_history_action: (fn([HistoryEntry]) Bool)?,
  bash_page_action: (fn(BashPage?, Bool) Bool)?,
}

// HistoryEntry is one earlier prompt or command that history can recall. Its
// text is what recalling it puts in the composer; a command's starts with `!`
// or `!!`.
struct HistoryEntry {
  id: Str,
  text: Str,
}

fn ref() mut Ref {
  (mut Ref{
    focus_action: Maybe::new<fn() Bool>(),
    clear_action: Maybe::new<fn() Bool>(),
    reset_action: Maybe::new<fn() Bool>(),
    restore_action: Maybe::new<fn(Str) Bool>(),
    prepend_action: Maybe::new<fn(Str) Bool>(),
    history_action: Maybe::new<fn([HistoryEntry]) Bool>(),
    bash_history_action: Maybe::new<fn([HistoryEntry]) Bool>(),
    bash_page_action: Maybe::new<fn(BashPage?, Bool) Bool>(),
  })
}

impl Ref {
  fn mut focus() Bool {
    match self.focus_action {
      action => action(),
      _ => false,
    }
  }

  // clear returns false when the mounted Composer has no draft.
  fn mut clear() Bool {
    match self.clear_action {
      action => action(),
      _ => false,
    }
  }

  fn mut reset() Bool {
    match self.reset_action {
      action => action(),
      _ => false,
    }
  }

  fn mut restore_if_empty(value: Str) Bool {
    match self.restore_action {
      action => action(value),
      _ => false,
    }
  }

  // prepend puts value before the draft, separated by a blank line, with the
  // cursor at the end.
  fn mut prepend(value: Str) Bool {
    match self.prepend_action {
      action => action(value),
      _ => false,
    }
  }

  // open_history lists entries, newest first, above the composer, filtered
  // by the draft with the newest match selected. Enter puts the selected
  // prompt in the composer.
  fn mut open_history(entries: [HistoryEntry]) Bool {
    match self.history_action {
      action => action(entries),
      _ => false,
    }
  }

  // open_bash_history lists the commands already known, newest first, while
  // the session's command history loads. The command after `!` filters it.
  fn mut open_bash_history(entries: [HistoryEntry]) Bool {
    match self.bash_history_action {
      action => action(entries),
      _ => false,
    }
  }

  // answer_bash_history delivers a page of command history, or nothing when
  // it could not be read. The first page replaces the commands already known;
  // an older page is added after them.
  fn mut answer_bash_history(page: BashPage?, older: Bool) Bool {
    match self.bash_page_action {
      action => action(page, older),
      _ => false,
    }
  }
}

// BashPage is one newest-first page of a session's command history.
struct BashPage {
  entries: [HistoryEntry],
  // Whether older commands remain, and the cursor that reads them.
  more: Bool,
  before: Int64,
}

// Which earlier entries the composer's picker lists.
enum Recall {
  none,
  prompts,
  commands,
}

// Older command pages read while the picker is open, as in the vaxis client.
let bash_page_limit = 5

// Props contains live Shell-owned dependencies. Composer owns its draft,
// editor ref, command bindings, and focus lifecycle.
struct Props {
  themes: theme::Context,
  enabled: Bool,
  focus_eligible: Bool,
  control: mut Ref,
  // Enter offers the trimmed draft, which may be empty; accepting it clears
  // the draft.
  submit: fn(Str) Bool,
  // A paste that names files offers their paths; accepting them keeps the
  // paste out of the draft.
  attach: fn([Str]) Bool,
  // The number of queued follow-ups. While any are queued, Up restores them
  // into the draft.
  follow_ups: Int,
  restore_follow_ups: fn(),
  // Up on a blank draft, with nothing queued, asks for earlier prompts; the
  // Shell answers through `Ref.open_history`.
  recall_history: fn(),
  // Up or Down in bash mode asks for earlier commands; the Shell answers
  // through `Ref.open_bash_history` and `Ref.answer_bash_history`.
  recall_bash: fn(),
  // Moving up past the oldest command asks for the page before the cursor.
  older_bash: fn(Int64),
  open_palette: fn(),
  mode_changed: fn(Str),
}

struct Composer {
  props: mut Props,
  context: cui::Context?,
  editor: mut cui::TextAreaRef,
  draft: Str,
  mode: Str,
  // The open history picker's entries, newest first.
  history: [HistoryEntry],
  history_kind: Recall,
  history_selection: Str,
  // Command history paging: a read in flight, and the older pages left.
  bash_loading: Bool,
  bash_more: Bool,
  bash_before: Int64,
  bash_pages: Int,
}

fn view(props: Props) cui::View {
  cui::child(new, props, key: "composer")
}

private fn new(props: mut Props) mut Composer {
  (mut Composer{
    props: props,
    context: Maybe::new<cui::Context>(),
    editor: cui::text_area_ref(),
    draft: "",
    mode: "",
    history: [],
    history_kind: Recall::none,
    history_selection: "",
    bash_loading: false,
    bash_more: false,
    bash_before: Int64::from(0),
    bash_pages: 0,
  })
}

impl cui::Lifecycle for Composer {
  fn mut mounted(context: cui::Context) {
    self.context = Maybe::new(context)
    self.props.control.focus_action = Maybe::new(fn() Bool {
      self.request_focus()
    })
    self.props.control.clear_action = Maybe::new(fn() Bool {
      self.request_clear()
    })
    self.props.control.reset_action = Maybe::new(fn() Bool {
      self.request_reset()
    })
    self.props.control.restore_action = Maybe::new(fn(value: Str) Bool {
      self.request_restore(value)
    })
    self.props.control.prepend_action = Maybe::new(fn(value: Str) Bool {
      self.request_prepend(value)
    })
    self.props.control.history_action = Maybe::new(fn(entries: [HistoryEntry]) Bool {
      self.request_history(entries)
    })
    self.props.control.bash_history_action = Maybe::new(fn(entries: [HistoryEntry]) Bool {
      self.request_bash_history(entries)
    })
    self.props.control.bash_page_action = Maybe::new(fn(page: BashPage?, older: Bool) Bool {
      self.request_bash_page(page, older)
    })
    // Pastes reach this listener before the focused editor inserts them.
    let _ = context.on_paste(fn(paste: mut event::PasteEvent) {
      if self.props.enabled and self.editor_focused() {
        match attachments::pasted_paths(paste.text) {
          paths => {
            if (self.props.attach)(paths) {
              paste.stop_propagation()
            }
          },
          _ => (),
        }
      }
    })
  }

  fn mut unmounting(context: cui::Context) {
    self.props.control.focus_action = Maybe::new<fn() Bool>()
    self.props.control.clear_action = Maybe::new<fn() Bool>()
    self.props.control.reset_action = Maybe::new<fn() Bool>()
    self.props.control.restore_action = Maybe::new<fn(Str) Bool>()
    self.props.control.prepend_action = Maybe::new<fn(Str) Bool>()
    self.props.control.history_action = Maybe::new<fn([HistoryEntry]) Bool>()
    self.props.control.bash_history_action = Maybe::new<fn([HistoryEntry]) Bool>()
    self.props.control.bash_page_action = Maybe::new<fn(BashPage?, Bool) Bool>()
  }
}

impl Composer {
  private fn mut request_focus() Bool {
    match self.context {
      context => {
        let editor = self.editor
        let _ = context.dispatch(fn() {
          // Resolve eligibility after the parent and retained child reconcile:
          // one parent transition may both request focus and replace the
          // Composer with a modal or workspace focus owner.
          context.internal_commit(fn() {
            if self.props.enabled and self.props.focus_eligible {
              editor.focus(context)
            }
          })
        })
        true
      },
      _ => false,
    }
  }

  private fn mut request_clear() Bool {
    if self.draft == "" {
      false
    } else {
      match self.context {
        context => {
          let _ = context.dispatch(fn() {
            self.close_history()
            self.change("")
          })
          true
        },
        _ => false,
      }
    }
  }

  private fn mut request_reset() Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.close_history()
          self.change("")
        })
        true
      },
      _ => false,
    }
  }

  private fn mut request_restore(value: Str) Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          if self.draft == "" {
            self.change(value)
          }
        })
        true
      },
      _ => false,
    }
  }

  private fn mut request_prepend(value: Str) Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          let parts = mut List::new<Str>()
          for part in [value, self.draft] {
            if part != "" {
              parts.push(part)
            }
          }
          self.change(strings::Join(parts, "\n\n"))
        })
        true
      },
      _ => false,
    }
  }

  // Some terminals deliver a paste as an ordinary text change, so a change
  // that names files is offered as attachments too; accepted paths leave the
  // draft.
  private fn mut input(value: Str) {
    match attachments::changed_paths(self.draft, value) {
      found => {
        match (self.props.attach)(found.paths) {
          true => self.change(found.remainder),
          false => self.change(value),
        }
      },
      _ => self.change(value),
    }
  }

  // Opens message history unless a prompt was typed or queued meanwhile; a
  // query typed while it loaded filters it.
  private fn mut request_history(entries: [HistoryEntry]) Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          if self.props.enabled and self.history_kind == Recall::none and self.props.follow_ups == 0 and entries.size() > 0 {
            self.history = entries
            self.history_kind = Recall::prompts
            self.history_selection = inline_picker::last_key(self.history_matches())
          }
        })
        true
      },
      _ => false,
    }
  }

  // Opens command history from the commands already known, unless the draft
  // left bash mode meanwhile. The session's history replaces them as it loads.
  private fn mut request_bash_history(entries: [HistoryEntry]) Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          if self.props.enabled and self.history_kind == Recall::none and strings::HasPrefix(self.draft, "!") {
            self.history = entries
            self.history_kind = Recall::commands
            self.bash_loading = true
            self.bash_more = false
            self.bash_before = Int64::from(0)
            self.bash_pages = 0
            self.history_selection = inline_picker::last_key(self.history_matches())
          }
        })
        true
      },
      _ => false,
    }
  }

  private fn mut request_bash_page(page: BashPage?, older: Bool) Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.apply_bash_page(page, older)
        })
        true
      },
      _ => false,
    }
  }

  // An empty first page keeps the commands already known. A failed older
  // page ends paging.
  private fn mut apply_bash_page(page: BashPage?, older: Bool) {
    if self.history_kind == Recall::commands {
      self.bash_loading = false
      match page {
        loaded => {
          if older {
            let known = mut Map::new<Bool>()
            for entry in self.history {
              known.set(entry.id, true)
            }
            let merged = mut List::new<HistoryEntry>()
            for entry in self.history {
              merged.push(entry)
            }
            for entry in loaded.entries {
              if not known.get(entry.id).or(false) {
                merged.push(entry)
                known.set(entry.id, true)
              }
            }
            self.history = merged.@
            self.bash_pages = self.bash_pages + 1
            if self.history_selection == "" {
              self.history_selection = inline_picker::last_key(self.history_matches())
            }
          } else if loaded.entries.size() > 0 {
            self.history = loaded.entries
            self.history_selection = inline_picker::last_key(self.history_matches())
          }
          if older or loaded.entries.size() > 0 {
            self.bash_more = loaded.more
            self.bash_before = loaded.before
          }
        },
        _ => { self.bash_more = false },
      }
    }
  }

  // History listed oldest first, so the newest entry sits nearest the
  // composer. Multi-line entries show on one line; a command is matched
  // without its `!` or `!!`.
  private fn history_catalog() [inline_picker::Item] {
    let items = mut List::new<inline_picker::Item>()
    mut index = self.history.size() - 1
    while index >= 0 {
      let entry = self.history.at(index).expect("history entry")
      let search = match self.history_kind == Recall::commands {
        true => one_line(bash_query(entry.text)),
        false => "",
      }
      items.push(
        inline_picker::Item{
          key: entry.id,
          label: one_line(entry.text),
          search: search,
        },
      )
      index = index - 1
    }
    items.@
  }

  // Prompts are filtered by the draft, and commands by the draft's command.
  private fn history_matches() [inline_picker::Item] {
    let query = match self.history_kind == Recall::commands {
      true => bash_query(self.draft),
      false => self.draft,
    }
    inline_picker::filter(self.history_catalog(), query)
  }

  private fn mut close_history() {
    self.history_kind = Recall::none
    self.history = []
    self.history_selection = ""
    self.bash_loading = false
    self.bash_more = false
    self.bash_before = Int64::from(0)
    self.bash_pages = 0
  }

  // Whether moving up from the oldest match reads older commands instead of
  // wrapping.
  private fn pages_older() Bool {
    let matches = self.history_matches()
    let oldest = match matches.at(0) {
      first => first.key == self.history_selection,
      _ => true,
    }
    self.history_kind == Recall::commands and oldest and self.bash_more and self.bash_pages < bash_page_limit
  }

  private fn mut move_history(delta: Int) Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          if delta < 0 and self.pages_older() {
            if not self.bash_loading {
              self.bash_loading = true
              (self.props.older_bash)(self.bash_before)
            }
          } else {
            self.history_selection = inline_picker::move(
              self.history_matches(),
              self.history_selection,
              delta,
            )
          }
        })
        true
      },
      _ => false,
    }
  }

  // Puts the entry with id in the composer, from Enter or a click.
  private fn mut choose_history(id: Str) {
    if self.history_kind != Recall::none and inline_picker::contains(self.history_matches(), id) {
      for entry in self.history {
        if entry.id == id {
          self.close_history()
          self.change(entry.text)
        }
      }
    }
  }

  private fn mut request_history_choice() Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.choose_history(self.history_selection)
        })
        true
      },
      _ => false,
    }
  }

  private fn mut request_history_dismissal() Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.close_history()
        })
        true
      },
      _ => false,
    }
  }

  private fn mut request_recall() Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          if self.props.enabled and strings::TrimSpace(self.draft) == "" and self.props.follow_ups == 0 {
            (self.props.recall_history)()
          }
        })
        true
      },
      _ => false,
    }
  }

  private fn mut request_bash_recall() Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          if self.props.enabled and self.history_kind == Recall::none and strings::HasPrefix(self.draft, "!") {
            (self.props.recall_bash)()
          }
        })
        true
      },
      _ => false,
    }
  }

  private fn mut change(value: Str) {
    // An open history picker follows the draft, selecting the newest match.
    // Command history closes when the draft leaves bash mode.
    if self.history_kind == Recall::commands and not strings::HasPrefix(value, "!") {
      self.close_history()
    }
    if self.history_kind != Recall::none {
      self.draft = value
      self.history_selection = inline_picker::last_key(self.history_matches())
    }
    self.draft = value
    let next = mode(value)
    if next != self.mode {
      self.mode = next
      (self.props.mode_changed)(next)
    }
  }

  private fn mut request_submit() Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          let text = strings::TrimSpace(self.draft)
          if self.props.enabled and (self.props.submit)(text) {
            self.change("")
          }
        })
        true
      },
      _ => false,
    }
  }

  private fn editor_focused() Bool {
    match self.editor.current {
      editor => editor.is_focused(),
      _ => false,
    }
  }

  private fn mut request_restore_follow_ups() Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          if self.props.enabled and self.props.follow_ups > 0 {
            (self.props.restore_follow_ups)()
          }
        })
        true
      },
      _ => false,
    }
  }

  private fn mut request_palette() Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          if self.props.enabled and self.draft == "" {
            (self.props.open_palette)()
          }
        })
        true
      },
      _ => false,
    }
  }
}

impl cui::Component for Composer {
  fn mut render() cui::View {
    let colors = self.props.themes.current()
    // A dialog, the interaction dock, or another session takes the composer's
    // input, closing its picker.
    if not self.props.enabled {
      self.close_history()
    }
    // Ctrl+Shift+W deletes the next word, pairing with Ctrl+W, as in the
    // vaxis client.
    let editing = keymap::rebind(
      ui::default_text_area_bindings(),
      ui::TextAreaAction::insert_newline,
      [keymap::key("return", shift: true)],
    ).bind(keymap::key("w", shift: true, ctrl: true), ui::TextAreaAction::delete_word_forward)
    let send = keymap::simple_command("composer.submit", "Send", fn() Bool {
      self.request_submit()
    })
    let open_palette = keymap::simple_command("palette.open", "Open command palette", fn() Bool {
      self.request_palette()
    })
    let restore = keymap::simple_command(
      "composer.restore_follow_ups",
      "Restore queued follow-ups",
      fn() Bool {
        self.request_restore_follow_ups()
      },
    )
    let recall = keymap::simple_command(
      "composer.recall_history",
      "Recall earlier prompts",
      fn() Bool {
        self.request_recall()
      },
    )
    let previous = keymap::simple_command(
      "composer.history.previous",
      "Previous prompt",
      fn() Bool {
        self.move_history(-1)
      },
    )
    let next = keymap::simple_command("composer.history.next", "Next prompt", fn() Bool {
      self.move_history(1)
    })
    let choose = keymap::simple_command("composer.history.choose", "Use prompt", fn() Bool {
      self.request_history_choice()
    })
    let dismiss = keymap::simple_command("composer.history.dismiss", "Close history", fn() Bool {
      self.request_history_dismissal()
    })
    let recall_bash = keymap::simple_command(
      "composer.recall_bash",
      "Recall earlier commands",
      fn() Bool {
        self.request_bash_recall()
      },
    )
    let bindings = mut List::new<keymap::Binding>()
    let bash_mode = strings::HasPrefix(self.draft, "!")
    if self.history_kind != Recall::none {
      // The open picker takes the keys it navigates by; typing still edits
      // the draft, which is its query.
      bindings.push(
        keymap::binding(keymap::key("up"), previous.with(), keymap::Trigger::press_or_repeat),
      )
      bindings.push(
        keymap::binding(keymap::key("down"), next.with(), keymap::Trigger::press_or_repeat),
      )
      bindings.push(keymap::binding(keymap::key("return"), choose.with()))
      bindings.push(keymap::binding(keymap::key("escape"), dismiss.with()))
    } else {
      bindings.push(keymap::binding(keymap::key("return"), send.with()))
      if self.draft == "" {
        bindings.push(keymap::binding(keymap::key("/"), open_palette.with()))
      }
      if self.props.follow_ups > 0 {
        bindings.push(keymap::binding(keymap::key("up"), restore.with()))
      } else if bash_mode {
        bindings.push(keymap::binding(keymap::key("up"), recall_bash.with()))
      } else if strings::TrimSpace(self.draft) == "" {
        bindings.push(keymap::binding(keymap::key("up"), recall.with()))
      }
      if bash_mode {
        bindings.push(keymap::binding(keymap::key("down"), recall_bash.with()))
      }
    }
    let editor = cui::text_area(
      // Autofocus is mount-only. Live renders never assert focused=true, so
      // Shell, dialogs, panes, and pointer interactions keep their focus.
      self.draft,
      key: "composer.editor",
      styles: ui::style(
        flex_shrink: 0.0,
        max_height: ui::cells(10),
        padding: ui::Edges{
          top: ui::cells(0),
          right: ui::cells(1),
          bottom: ui::cells(0),
          left: ui::cells(1),
        },
      ),
      placeholder: "Ask kit to do something…",
      placeholder_style: ui::text_style(foreground: colors.muted),
      selection_style: theme::selection_style(colors),
      autofocus: self.props.enabled and self.props.focus_eligible,
      focused: match self.props.enabled {
        true => Maybe::new<Bool>(),
        false => Maybe::new(false),
      },
      ref: self.editor,
      on_input: fn(value: Str, context: cui::Context) {
        self.input(value)
      },
      key_bindings: editing,
      commands: [send, open_palette, restore, recall, recall_bash, previous, next, choose, dismiss],
      bindings: bindings.@,
    )
    let children = mut List::new<cui::View>()
    children.push(editor)
    if self.history_kind != Recall::none {
      // The session's commands are still loading when none are known yet.
      let empty = match self.bash_loading {
        true => "Loading history…",
        false => "No results",
      }
      children.push(
        inline_picker::view(
          inline_picker::Props{
            themes: self.props.themes,
            items: self.history_matches(),
            selection: self.history_selection,
            empty: empty,
            activate: fn(id: Str) {
              self.choose_history(id)
            },
          },
        ),
      )
    }
    // The picker is positioned against this box and rests on its top edge.
    cui::box(
      children.@,
      key: "composer.surface",
      styles: ui::style(
        position: ui::Position::relative,
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::column,
      ),
    )
  }
}

// The command a bash draft names, without its `!` or `!!` and the spaces
// after it.
fn bash_query(value: Str) Str {
  let command = match strings::HasPrefix(value, "!!") {
    true => strings::TrimPrefix(value, "!!"),
    false => strings::TrimPrefix(value, "!"),
  }
  strings::TrimLeft(command, " \t")
}

// The composer text that runs command again in its context mode.
fn bash_text(command: Str, exclude: Bool) Str {
  match exclude {
    true => "!!{command}",
    false => "!{command}",
  }
}

// value with each run of whitespace, including line breaks, as one space.
private fn one_line(value: Str) Str {
  let words = mut strings::Fields(value)
  strings::Join(words, " ")
}

private fn mode(value: Str) Str {
  match strings::HasPrefix(value, "!!") {
    true => "bash · not in context",
    false => {
      match strings::HasPrefix(value, "!") {
        true => "bash · in context",
        false => "",
      }
    },
  }
}
