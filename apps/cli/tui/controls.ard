use cooper/cui
use cooper/event
use cooper/keymap
use cooper/ui
use kit/tui/theme

// ButtonVariant selects a semantic presentation while retaining the same
// pointer and keyboard interaction contract.
enum ButtonVariant {
  primary,
  secondary,
  danger,
}

struct ButtonProps {
  themes: theme::Context,
  label: Str,
  command: keymap::SimpleCommand,
  variant: ButtonVariant,
  compact: Bool,
  focusable: Bool,
  autofocus: Bool,
  trailing_padding: Int?,
  styles: ui::Style?,
  foreground: ui::Color?,
  control: mut cui::BoxRef,
}

struct Button {
  props: mut ButtonProps,
  hovered: Bool,
  pressed: Bool,
  focused: Bool,
  control: mut cui::BoxRef,
}

// button renders a Kit-styled, focusable action. It owns activation feedback:
// callers provide a command and may only customize its layout through styles.
fn button(
  themes: theme::Context,
  label: Str,
  command: keymap::SimpleCommand,
  variant: ButtonVariant?,
  compact: Bool?,
  focusable: Bool?,
  autofocus: Bool?,
  trailing_padding: Int?,
  styles: ui::Style?,
  foreground: ui::Color?,
  ref: (mut cui::BoxRef)?,
) cui::View {
  cui::child(
    new,
    ButtonProps{
      themes: themes,
      label: label,
      command: command,
      variant: variant.or(ButtonVariant::primary),
      compact: compact.or(false),
      focusable: focusable.or(true),
      autofocus: autofocus.or(false),
      trailing_padding: trailing_padding,
      styles: styles,
      foreground: foreground,
      control: ref.or(cui::box_ref()),
    },
  )
}

private fn new(props: mut ButtonProps) mut Button {
  (mut Button{
    props: props,
    hovered: false,
    pressed: false,
    focused: false,
    control: props.control,
  })
}

impl cui::Lifecycle for Button {
  fn mut mounted(ctx: cui::Context) {
    if self.props.focusable {
      self.control.current.map(fn(control) {
        let _ = control.on_focus(fn() {
          self.focused = true
          (ctx.invalidate_root)()
        })
        let _ = control.on_blur(fn() {
          self.focused = false
          (ctx.invalidate_root)()
        })
      })
    }
  }

  fn mut unmounting(ctx: cui::Context) {}
}

impl Button {
  private fn fill() ui::Color {
    let colors = self.props.themes.current()
    match self.props.variant {
      ButtonVariant::primary => {
        match {
          self.pressed => colors.primary_pressed,
          self.hovered or self.focused => colors.primary_hovered,
          _ => colors.primary,
        }
      },
      ButtonVariant::danger => colors.danger,
      ButtonVariant::secondary => {
        match {
          self.pressed => colors.surface_pressed,
          self.hovered or self.focused => colors.surface_hovered,
          _ => colors.surface,
        }
      },
    }
  }

  private fn focused_state() Bool? {
    match self.props.focusable and not self.props.autofocus {
      true => Maybe::new(self.focused),
      false => Maybe::new<Bool>(),
    }
  }

  private fn foreground() ui::Color {
    self.props.foreground.or(self.props.themes.current().foreground)
  }

  private fn mut mouse(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::over or received.event_type == event::MouseEventType::move {
      self.hovered = true
    } else if received.event_type == event::MouseEventType::out {
      self.hovered = false
      self.pressed = false
    } else if received.event_type == event::MouseEventType::down {
      if received.button == event::MouseButton::left {
        if self.props.focusable {
          self.focused = true
        }
        self.pressed = true
        received.prevent_default()
      }
    } else if received.event_type == event::MouseEventType::up {
      if received.button == event::MouseButton::left and self.pressed {
        self.pressed = false
        let _ = self.props.command.invoke()
        received.prevent_default()
      }
    } else if received.event_type == event::MouseEventType::drag_end {
      self.pressed = false
    }
  }
}

impl cui::Component for Button {
  fn mut render() cui::View {
    let horizontal = match self.props.compact {
      true => 1,
      false => 2,
    }
    let trailing = self.props.trailing_padding.or(horizontal)
    let commands = mut List::new<keymap::Command>()
    let bindings = mut List::new<keymap::Binding>()
    if self.props.focusable {
      commands.push(self.props.command)
      bindings.push(keymap::binding(keymap::key("return"), self.props.command.with()))
      bindings.push(keymap::binding(keymap::key("space"), self.props.command.with()))
    }
    cui::box(
      [
        cui::box(
          [cui::text(self.props.label, text_style: ui::text_style(foreground: self.foreground()))],
          styles: ui::style(
            background: self.fill(),
            padding: ui::Edges{
              top: ui::cells(0),
              right: ui::cells(trailing),
              bottom: ui::cells(0),
              left: ui::cells(horizontal),
            },
          ),
        ),
      ],
      styles: self.props.styles,
      focused: self.focused_state(),
      autofocus: self.props.autofocus and self.props.focusable,
      ref: self.control,
      on_mouse: fn(received: mut event::MouseEvent, ctx: cui::Context) {
        self.mouse(received)
      },
      commands: commands.@,
      bindings: bindings.@,
    )
  }
}
