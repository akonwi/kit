use cooper/ui
use kit/tui/diagram_notes

// A comment on a part of a drawn diagram, opened by clicking the part while
// the diagram is in Annotate mode, or from its chip to edit it. Its box opens
// at the part (`comment_box`); saving adds the comment to those waiting for
// the next message, or replaces the one it edits.

// Request is the part the comment is on: its diagram's source, the part as
// the model's text names it, and where it was clicked.
struct Request {
  source: Str,
  part: diagram_notes::Part,
  summary: Str,
  // The clicked cell, or the chip's when it edits a waiting comment.
  anchor: ui::Rect,
  // The waiting comment it edits, or 0 for a new one.
  editing: Int,
  // The comment the box opens with.
  comment: Str,
}
