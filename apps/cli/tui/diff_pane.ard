// The Diff tab's body: a target's changes as one document, a section per
// changed file. The target is the working tree unless a commit or branch is
// picked from the header; a new workspace returns to its working tree. A
// file's header shows its path, stays pinned while its lines scroll by, and
// collapses or expands the file when clicked. A section loads its changes
// when it scrolls into view. Lines are unified, or split side by side where
// wide enough, and either wrap or scroll sideways with Shift+wheel or a
// horizontal swipe. While the working tree is shown, the pane checks it
// every few seconds and reloads what changed, keeping its place.
//
// Lines are annotated as in a File tab, from the + in the hovered line's
// gutter. A removed line's annotation is on the old side, and an added or
// unchanged line's on the new side; in the split layout, each half is its
// side. A range keeps to one side of one hunk.

// How often a shown pane checks the working tree.
let poll_interval = 5000

// File reads in flight at once.
let max_reads = 4

// Cells a horizontal wheel step moves the text.
let column_step = 4

// The narrowest pane that offers the split layout.
let split_width = 120

// Taller than any wrapped row; the rule between split sides is clipped to
// its row.
let split_glyphs = strings::TrimSuffix(strings::Repeat("│\n", 256), "\n")

struct Props {
  themes: theme::Context,
  // The session's current workspace; a new one starts over.
  workspace_id: Str,
  // Whether the tab is selected.
  shown: Bool,
  observe: (fn(protocol::ObserveWorkingTreeInput) protocol::WorkingTreePage!Error)?,
  observe_target: (fn(protocol::ObserveDiffInput) protocol::WorkingTreePage!Error)?,
  read: (fn(protocol::ReadFileDiffInput) protocol::FileDiffPage!Error)?,
  // Opens the target picker.
  pick_target: fn(TargetRequest),
  // Whether lines wrap, a saved preference the caller owns.
  wrap: Bool,
  set_wrap: fn(Bool),
  // The session's annotations, and what saves them; without it, lines can't
  // be annotated.
  annotations: [sessionbridge::Annotation],
  annotate: annotations::Service?,
  remove_annotation: fn(Uint64),
  // Hands the keyboard back once the note editor closes.
  release_focus: fn(),
  // Lines to show, as an annotation's chip asks.
  reveal: Reveal,
}

// A request to show `line` on `side` of `path` in target `target_id`. Each
// request has a new `opening`; 0 asks for nothing. A working-tree request
// returns the pane to the working tree.
struct Reveal {
  opening: Int,
  target_id: Str,
  working_tree: Bool,
  path: Str,
  side: Str,
  line: Int,
}

fn no_reveal() Reveal {
  Reveal{
    opening: 0,
    target_id: "",
    working_tree: false,
    path: "",
    side: "",
    line: 0,
  }
}

// What the target picker needs: the workspace whose targets to list, the
// current target's id, the targets last listed, which show while the list
// refreshes, where a fresh list is kept, and where the choice goes.
struct TargetRequest {
  workspace_id: Str,
  current: Str,
  cached: [protocol::DiffTargetEntry],
  remember: fn([protocol::DiffTargetEntry]),
  choose: fn(protocol::DiffTargetEntry),
}

// How a target is named in the header and the picker.
fn target_label(target: protocol::DiffTargetEntry) Str {
  match {
    target.Metadata.Label != "" => target.Metadata.Label,
    target.Kind == "working_tree" => "Working tree",
    target.Metadata.Abbreviated != "" => {
      strings::TrimSpace("{target.Metadata.Abbreviated}  {target.Metadata.Subject}")
    },
    _ => "Diff",
  }
}

fn view(props: Props) cui::View {
  cui::child(new, props, key: "diff-pane")
}

// One changed file's loaded changes.
struct Section {
  // The file revision the hunks belong to.
  revision: Str,
  hunks: [protocol::DiffHunk],
  // Where the next page of hunks starts, or "" when all are loaded.
  next: Str,
  // Whether a read is queued or running.
  reading: Bool,
  // Whether the first page has arrived.
  loaded: Bool,
  failure: Str,
  // The old and new side's lines, highlighted once the highlighter answers.
  old_lines: [[file_pane::Segment]],
  new_lines: [[file_pane::Segment]],
  widest: Int,
  // Digits of the widest old and new line number; 0 when a side has none,
  // as for an added or deleted file.
  old_digits: Int,
  new_digits: Int,
  // Counts loads, so a superseded highlight is ignored.
  generation: Int,
}

private fn section(revision: Str) Section {
  Section{
    revision: revision,
    hunks: [],
    next: "",
    reading: false,
    loaded: false,
    failure: "",
    old_lines: [],
    new_lines: [],
    widest: 0,
    old_digits: 0,
    new_digits: 0,
    generation: 0,
  }
}

// The kinds of document row. `border` and `rule` are the rules over and
// under a file's header. The first file has no border, as the pane's own rule
// is there, and a collapsed file has no rule.
enum RowKind {
  // A split row: an old line beside a new one, either of which may be
  // missing.
  // A saved note under the line it ends on, and the note editor.
  header,
  line,
  pair,
  gap,
  note,
  more,
  border,
  rule,
  annotation,
  editor,
}

// A row of the document. `line` rows point at their hunk line, and `pair`
// rows at the old and new lines beside each other, with each line's place
// on its side; other rows carry their text.
struct Row {
  key: Str,
  kind: RowKind,
  file: Int,
  hunk: Int,
  line: Int,
  old_line: Int,
  new_line: Int,
  old_index: Int,
  new_index: Int,
  text: Str,
  // A note row's annotation, and the side a note or the editor is on.
  annotation: Uint64,
  side: Str,
}

private fn row(key: Str, kind: RowKind, file: Int, text: Str) Row {
  Row{
    key: key,
    kind: kind,
    file: file,
    hunk: -1,
    line: -1,
    old_line: -1,
    new_line: -1,
    old_index: -1,
    new_index: -1,
    text: text,
    annotation: Uint64::from(0),
    side: "",
  }
}

// What a file with no textual changes shows instead.
fn content_note(file: protocol::DiffFileSummary) Str {
  match file.ContentState {
    "binary" => "Binary file changed",
    "conflict" => "File has unresolved conflicts",
    "intent_to_add" => "Intent-to-add file has no textual diff",
    "unsupported_transform" => "File uses an unsupported content transform",
    "unsupported_kind" => "File kind is not available for textual diff",
    "too_large" => "File diff exceeds the configured limit",
    "unavailable" => "File diff is unavailable",
    _ => "No textual changes",
  }
}

fn changed_files(count: Int) Str {
  match count {
    0 => "No changed files",
    1 => "1 changed file",
    _ => "{count} changed files",
  }
}

// The document's rows: each file's header between rules, then, unless
// collapsed, its changes as they load, with a gap between hunks. Split rows
// pair each run of removed lines with the added lines after it. The notes
// on a line follow it, with the editor in place of the note it edits or
// after a new one's last line.
fn rows(
  files: [protocol::DiffFileSummary],
  sections: [Str: Section],
  collapsed: [Str: Bool],
  split: Bool,
  notes: [sessionbridge::Annotation],
  editor: annotations::Draft?,
) [Row] {
  let built = mut List::new<Row>()
  for file, index in files {
    let path = file.Path
    if index > 0 {
      built.push(row("b:{path}", RowKind::border, index, ""))
    }
    built.push(row("h:{path}", RowKind::header, index, path))
    // A collapsed file's header has no rule under it; the next header's
    // border alone separates them.
    if not collapsed.get(path).or(false) {
      built.push(row("r:{path}", RowKind::rule, index, ""))
      match file.ContentState == "text" {
        false => built.push(row("n:{path}", RowKind::note, index, content_note(file))),
        true => {
          let current = sections.get(path)
          match current {
            loaded => {
              if loaded.failure != "" and loaded.hunks.size() == 0 {
                built.push(
                  row("n:{path}", RowKind::note, index, "Could not load changes: {loaded.failure}"),
                )
              } else if not loaded.loaded {
                built.push(row("n:{path}", RowKind::note, index, "Loading…"))
              } else if loaded.hunks.size() == 0 {
                built.push(row("n:{path}", RowKind::note, index, "No textual changes"))
              } else {
                mut old_index = 0
                mut new_index = 0
                for hunk, hunk_index in loaded.hunks {
                  if hunk_index > 0 {
                    built.push(row("g:{path}:{hunk_index}", RowKind::gap, index, "⋯"))
                  }
                  if split {
                    let paired = pairs(path, index, hunk_index, hunk, old_index, new_index)
                    for made in paired {
                      built.push(made)
                      follow(
                        built,
                        path,
                        index,
                        side_number(hunk, made.old_line, true),
                        side_number(hunk, made.new_line, false),
                        notes,
                        editor,
                      )
                    }
                    for line in hunk.Lines {
                      if line.Kind != "addition" {
                        old_index =+ 1
                      }
                      if line.Kind != "deletion" {
                        new_index =+ 1
                      }
                    }
                  } else {
                    for line, line_index in hunk.Lines {
                      let made = mut row(
                        "l:{path}:{hunk_index}:{line_index}",
                        RowKind::line,
                        index,
                        "",
                      )
                      made.hunk = hunk_index
                      made.line = line_index
                      if line.Kind != "addition" {
                        made.old_index = old_index
                        old_index =+ 1
                      }
                      if line.Kind != "deletion" {
                        made.new_index = new_index
                        new_index =+ 1
                      }
                      built.push(made.@)
                      follow(
                        built,
                        path,
                        index,
                        side_number(hunk, line_index, true),
                        side_number(hunk, line_index, false),
                        notes,
                        editor,
                      )
                    }
                  }
                }
                if loaded.next != "" {
                  built.push(row("m:{path}", RowKind::more, index, "Loading more…"))
                } else if loaded.failure != "" {
                  built.push(
                    row("n:{path}", RowKind::note, index, "Could not load more: {loaded.failure}"),
                  )
                }
              }
            },
            _ => built.push(row("n:{path}", RowKind::note, index, "Loading…")),
          }
        },
      }
    }
  }
  built.@
}

// A hunk line's number on the old or new side, or 0 without one.
fn side_number(hunk: protocol::DiffHunk, line_index: Int, old: Bool) Int {
  match hunk.Lines.at(line_index) {
    line => {
      let value = match old {
        true => line.OldLine,
        false => line.NewLine,
      }
      match unsafe::is_nil(value) {
        true => 0,
        false => value.@,
      }
    },
    _ => 0,
  }
}

// Pushes the rows that follow a line numbered `old` and `new` (0 without
// one): the notes ending on it, and the editor.
private fn follow(
  built: mut [Row],
  path: Str,
  file: Int,
  old: Int,
  new: Int,
  notes: [sessionbridge::Annotation],
  editor: annotations::Draft?,
) {
  let ends = fn(side: Str, line: Int) Bool {
    side == "old" and old > 0 and line == old or side == "new" and new > 0 and line == new
  }
  let edited = match editor {
    draft => draft.id,
    _ => Uint64::from(0),
  }
  mut listed = false
  for note in notes {
    if note.Path == path and ends(note.Side, note.EndLine) {
      let made = mut row("a:{note.ID}", RowKind::annotation, file, "")
      if note.ID == edited {
        made.key = "e:{path}"
        made.kind = RowKind::editor
      }
      made.annotation = note.ID
      made.side = note.Side
      built.push(made.@)
    }
    listed = listed or note.ID == edited and edited != Uint64::from(0)
  }
  match editor {
    // A new note, or one deleted elsewhere while it was edited.
    draft => {
      if (not listed) and draft.path == path and ends(draft.side, draft.end) {
        let made = mut row("e:{path}", RowKind::editor, file, "")
        made.side = draft.side
        built.push(made.@)
      }
    },
    _ => (),
  }
}

// A hunk's split rows. A context line sits beside itself; a run of changes
// pairs its removed lines, in order, with its added ones, leaving a blank
// opposite any line without a partner. `old_index` and `new_index` are the
// hunk's first places on each side.
fn pairs(
  path: Str,
  file: Int,
  hunk_index: Int,
  hunk: protocol::DiffHunk,
  old_index: Int,
  new_index: Int,
) [Row] {
  let built = mut List::new<Row>()
  mut old_at = old_index
  mut new_at = new_index
  mut removed = mut List::new<Int>()
  mut added = mut List::new<Int>()
  let lines = hunk.Lines
  mut at = 0
  while at <= lines.size() {
    let kind = match lines.at(at) {
      line => line.Kind,
      _ => "end",
    }
    if kind == "deletion" {
      removed.push(at)
    } else if kind == "addition" {
      added.push(at)
    } else {
      // A context line or the hunk's end closes the run of changes.
      mut paired = 0
      while paired < removed.size() or paired < added.size() {
        let made = mut row("p:{path}:{hunk_index}:{built.size()}", RowKind::pair, file, "")
        made.hunk = hunk_index
        match removed.at(paired) {
          line => {
            made.old_line = line
            made.old_index = old_at
            old_at =+ 1
          },
          _ => (),
        }
        match added.at(paired) {
          line => {
            made.new_line = line
            made.new_index = new_at
            new_at =+ 1
          },
          _ => (),
        }
        built.push(made.@)
        paired =+ 1
      }
      removed = mut List::new<Int>()
      added = mut List::new<Int>()
      if kind != "end" {
        let made = mut row("p:{path}:{hunk_index}:{built.size()}", RowKind::pair, file, "")
        made.hunk = hunk_index
        made.old_line = at
        made.new_line = at
        made.old_index = old_at
        made.new_index = new_at
        old_at =+ 1
        new_at =+ 1
        built.push(made.@)
      }
    }
    at =+ 1
  }
  built.@
}

// The text of each side of the hunks, a line per old or new line, for
// highlighting.
fn sides(hunks: [protocol::DiffHunk]) [Str] {
  let old = mut List::new<Str>()
  let new = mut List::new<Str>()
  for hunk in hunks {
    for line in hunk.Lines {
      if line.Kind != "addition" {
        old.push(line.Content)
      }
      if line.Kind != "deletion" {
        new.push(line.Content)
      }
    }
  }
  [strings::Join(old, "\n") + "\n", strings::Join(new, "\n") + "\n"]
}

// What a failed diff request shows.
fn failure_text(error: Error) Str {
  match unsafe::cast<mut protocol::DiffError>(error) {
    diff_error => {
      match "{diff_error.Code}" {
        "not_repository" => "Not a git repository",
        "unsupported_repository" => "This repository is not supported",
        "repository_unavailable" => "The repository is unavailable",
        "permission_denied" => "Permission was denied",
        "capacity_exceeded" => "The workspace is busy",
        "limit_exceeded" => "The diff is too large",
        _ => diff_error.Message,
      }
    },
    _ => error.error(),
  }
}

// Whether a failed read means the working tree moved on, so the files
// should be observed again.
private fn outdated(error: Error) Bool {
  match unsafe::cast<mut protocol::DiffError>(error) {
    diff_error => {
      match "{diff_error.Code}" {
        "stale_target" => true,
        "stale_file" => true,
        "stale_cursor" => true,
        _ => false,
      }
    },
    _ => false,
  }
}

// Where a line sits for annotating: its file and hunk, the side its
// annotations take, and its numbers on each side, 0 for none.
private struct Spot {
  path: Str,
  hunk: Int,
  side: Str,
  old: Int,
  new: Int,
}

impl Spot {
  fn on(side: Str) Int {
    match side == "old" {
      true => self.old,
      false => self.new,
    }
  }

  fn same(other: Spot) Bool {
    self.path == other.path and self.side == other.side and self.on(self.side) == other.on(other.side)
  }
}

private struct Observed {
  observation: protocol::DiffObservation,
  files: [protocol::DiffFileSummary],
}

private struct Pane {
  props: mut Props,
  context: cui::Context?,
  list: mut cui::VirtualListRef,
  frame: mut cui::BoxRef,
  width: Int,
  workspace_id: Str,
  observation: protocol::DiffObservation?,
  files: [protocol::DiffFileSummary],
  sections: [Str: Section],
  collapsed: [Str: Bool],
  // Paths waiting for a read slot, in order.
  queue: [Str],
  reads: Int,
  observing: Bool,
  failure: Str,
  // Counts observations and resets, so a superseded result is ignored.
  generation: Int,
  // The first row in view, for the pinned header.
  top: Int,
  column: Int,
  polling: contextbridge::Cancellation?,
  was_shown: Bool,
  // The picked commit or branch, or none for the working tree.
  target: protocol::DiffTargetEntry?,
  // Whether the split layout is chosen; it shows only where wide enough.
  split: Bool,
  // The workspace's targets as last listed, for the picker to show at once.
  targets: [protocol::DiffTargetEntry],
  // The line under the pointer, which offers a +, and the line a held
  // gutter press started on, with the line it reaches on that side.
  hover: Spot?,
  drag: Spot?,
  drag_to: Int,
  editing: mut annotations::Drafting,
  // The last reveal acted on, and lines still to scroll to.
  reveal_opening: Int,
  pending: Reveal?,
}

private fn new(props: mut Props) mut Pane {
  (mut Pane{
    props: props,
    context: Maybe::new<cui::Context>(),
    list: cui::virtual_list_ref(),
    frame: cui::box_ref(),
    width: 0,
    workspace_id: props.workspace_id,
    observation: Maybe::new<protocol::DiffObservation>(),
    files: [],
    sections: [:],
    collapsed: [:],
    queue: [],
    reads: 0,
    observing: false,
    failure: "",
    generation: 0,
    top: 0,
    column: 0,
    polling: Maybe::new<contextbridge::Cancellation>(),
    was_shown: false,
    target: Maybe::new<protocol::DiffTargetEntry>(),
    split: false,
    targets: [],
    hover: Maybe::new<Spot>(),
    drag: Maybe::new<Spot>(),
    drag_to: 0,
    editing: annotations::drafting(),
    reveal_opening: 0,
    pending: Maybe::new<Reveal>(),
  })
}

impl cui::Lifecycle for Pane {
  fn mut mounted(context: cui::Context) {
    self.context = Maybe::new(context)
    let _ = context.internal_layout(fn() Bool {
      self.measure()
    })
    self.sync()
  }

  fn mut unmounting(context: cui::Context) {
    self.generation =+ 1
    self.editing.close()
    self.stop_polling()
    self.context = Maybe::new<cui::Context>()
  }
}

impl Pane {
  private fn mut measure() Bool {
    match self.frame.current {
      frame => {
        let width = frame.layout().local.width
        let changed = width != self.width
        self.width = width
        changed
      },
      _ => false,
    }
  }

  // Acts on prop changes: a new workspace starts over on its working tree,
  // and being shown again observes the target and resumes polling.
  private fn mut sync() {
    let reveal = self.props.reveal
    if reveal.opening != self.reveal_opening {
      self.reveal_opening = reveal.opening
      if reveal.opening > 0 {
        self.pending = Maybe::new(reveal)
        self.collapsed.set(reveal.path, false)
        // A working-tree annotation's lines aren't in a commit's diff.
        if reveal.working_tree and self.target.is_some() {
          self.target = Maybe::new<protocol::DiffTargetEntry>()
          self.reset()
          if self.context.is_some() and self.was_shown {
            self.observe()
          }
        }
      }
    }
    if self.context.is_some() {
      if self.props.workspace_id != self.workspace_id {
        self.workspace_id = self.props.workspace_id
        self.target = Maybe::new<protocol::DiffTargetEntry>()
        self.targets = []
        self.reset()
        if self.props.shown {
          self.observe()
        }
      }
      if self.props.shown and not self.was_shown {
        self.observe()
        self.start_polling()
      } else if self.was_shown and not self.props.shown {
        self.stop_polling()
      }
      self.was_shown = self.props.shown
    }
  }

  private fn mut reset() {
    self.generation =+ 1
    self.observation = Maybe::new<protocol::DiffObservation>()
    self.files = []
    self.sections = [:]
    self.queue = []
    self.reads = 0
    self.observing = false
    self.failure = ""
    self.column = 0
  }

  private fn mut start_polling() {
    self.stop_polling()
    match self.context {
      context => {
        let attempt = contextbridge::WithCancel(context::Background())
        self.polling = Maybe::new(attempt)
        let dispatch = context.dispatch
        async::start(fn() {
          mut running = true
          while running {
            time::Sleep(time::Millisecond * time::Duration::from(poll_interval))
            match attempt.Context.Err() {
              ok(_) => {
                let _ = dispatch(fn() {
                  // A commit or branch doesn't change, and lines being
                  // annotated stay put.
                  if self.props.shown and self.target.is_none() and (not self.annotating()) {
                    self.observe()
                  }
                })
              },
              err(_) => { running = false },
            }
          }
        })
      },
      _ => (),
    }
  }

  private fn mut stop_polling() {
    match self.polling {
      attempt => attempt.Cancel(),
      _ => (),
    }
    self.polling = Maybe::new<contextbridge::Cancellation>()
  }

  // Lists one page of the target's changed files, from a cursor.
  private fn fetcher() (fn(Str) protocol::WorkingTreePage!Error)? {
    let workspace_id = self.workspace_id
    match self.target {
      target => {
        match self.props.observe_target {
          observe => {
            Maybe::new(fn(cursor: Str) protocol::WorkingTreePage!Error {
              observe(
                protocol::ObserveDiffInput{
                  WorkspaceID: workspace_id,
                  TargetReference: target.Reference,
                  ExpectedTargetID: target.TargetID,
                  Cursor: cursor,
                },
              )
            })
          },
          _ => Maybe::new<fn(Str) protocol::WorkingTreePage!Error>(),
        }
      },
      _ => {
        match self.props.observe {
          observe => {
            Maybe::new(fn(cursor: Str) protocol::WorkingTreePage!Error {
              observe(protocol::ObserveWorkingTreeInput{WorkspaceID: workspace_id, Cursor: cursor})
            })
          },
          _ => Maybe::new<fn(Str) protocol::WorkingTreePage!Error>(),
        }
      },
    }
  }

  // Lists the changed files, every page of them, unless a listing is
  // running. A new revision replaces the files, keeping the loaded changes
  // of files that are unchanged.
  private fn mut observe() {
    match self.context {
      context => {
        match self.fetcher() {
          fetch => {
            if not self.observing and self.workspace_id != "" {
              self.observing = true
              let generation = self.generation
              let dispatch = context.dispatch
              async::start(fn() {
                let result = observe_all(fetch)
                let _ = dispatch(fn() {
                  if self.generation == generation {
                    self.observing = false
                    match result {
                      ok(observed) => self.observed(observed),
                      err(error) => {
                        // A failed check keeps what is shown.
                        if self.observation.is_none() {
                          self.failure = failure_text(error)
                        }
                      },
                    }
                  }
                })
              })
            }
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  private fn mut observed(observed: Observed) {
    let same = match self.observation {
      current => current.Revision == observed.observation.Revision,
      _ => false,
    }
    self.failure = ""
    if not same {
      self.observation = Maybe::new(observed.observation)
      let empty: [Str: Section] = [:]
      let kept = mut empty
      for file in observed.files {
        match self.sections.get(file.Path) {
          previous => {
            if previous.loaded and previous.revision != "" and previous.revision == file.FileRevision {
              kept.set(file.Path, previous)
            }
          },
          _ => (),
        }
      }
      self.files = observed.files
      self.sections = kept.@
      self.queue = []
    }
  }

  // Queues a file's first read, or its next page.
  private fn mut want(path: Str) {
    let current = self.sections.get(path)
    let busy = match current {
      loaded => loaded.reading or loaded.loaded and loaded.next == "",
      _ => false,
    }
    if not busy {
      mut revision = ""
      for file in self.files {
        if file.Path == path {
          revision = file.FileRevision
        }
      }
      let next = mut current.or(section(revision))
      next.reading = true
      self.sections.set(path, next.@)
      let waiting = mut List::new<Str>()
      for queued in self.queue {
        waiting.push(queued)
      }
      waiting.push(path)
      self.queue = waiting.@
      self.pump()
    }
  }

  // Starts queued reads while slots are free.
  private fn mut pump() {
    while self.reads < max_reads and self.queue.size() > 0 {
      let path = self.queue.at(0).expect("a queued path")
      let rest = mut List::new<Str>()
      for queued, index in self.queue {
        if index > 0 {
          rest.push(queued)
        }
      }
      self.queue = rest.@
      self.start_read(path)
    }
  }

  private fn mut start_read(path: Str) {
    match self.context {
      context => {
        match self.props.read {
          read => {
            match self.observation {
              observation => {
                let current = self.sections.get(path).or(section(""))
                self.reads =+ 1
                let generation = self.generation
                let input = protocol::ReadFileDiffInput{
                  TargetID: observation.Target.ID,
                  TargetRevision: observation.Revision,
                  Path: path,
                  ExpectedFileRevision: current.revision,
                  Cursor: current.next,
                }
                let dispatch = context.dispatch
                async::start(fn() {
                  let result = read(input)
                  let _ = dispatch(fn() {
                    if self.generation == generation {
                      self.reads =- 1
                      self.read_done(path, result)
                      self.pump()
                    }
                  })
                })
              },
              _ => (),
            }
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  private fn mut read_done(path: Str, result: protocol::FileDiffPage!Error) {
    match self.sections.get(path) {
      current => {
        let next = mut current
        next.reading = false
        match result {
          ok(page) => {
            let hunks = mut List::new<protocol::DiffHunk>()
            for hunk in current.hunks {
              hunks.push(hunk)
            }
            for hunk in page.Hunks {
              hunks.push(hunk)
            }
            next.hunks = hunks.@
            next.next = page.NextCursor
            next.loaded = true
            next.failure = ""
            next.generation = next.generation + 1
            self.sections.set(path, next.@)
            self.show_lines(path)
          },
          err(error) => {
            // Only the working tree moves on; a commit or branch is fixed.
            if outdated(error) and self.target.is_none() {
              self.sections.delete(path)
              self.observe()
            } else {
              next.loaded = true
              next.next = ""
              next.failure = failure_text(error)
              self.sections.set(path, next.@)
            }
          },
        }
      },
      _ => (),
    }
  }

  // Shows a section's lines plain, then highlighted.
  private fn mut show_lines(path: Str) {
    match self.sections.get(path) {
      current => {
        let texts = sides(current.hunks)
        let old_request = code::source_request("", path, texts.at(0).or(""))
        let new_request = code::source_request("", path, texts.at(1).or(""))
        let next = mut current
        next.old_lines = file_pane::lines(code::plain(old_request))
        next.new_lines = file_pane::lines(code::plain(new_request))
        mut widest = 0
        for line in next.old_lines {
          let width = segments_width(line)
          if width > widest {
            widest = width
          }
        }
        for line in next.new_lines {
          let width = segments_width(line)
          if width > widest {
            widest = width
          }
        }
        next.widest = widest
        next.old_digits = 0
        next.new_digits = 0
        for hunk in current.hunks {
          for line in hunk.Lines {
            if not unsafe::is_nil(line.OldLine) {
              let digits = "{line.OldLine.@}".size()
              if digits > next.old_digits {
                next.old_digits = digits
              }
            }
            if not unsafe::is_nil(line.NewLine) {
              let digits = "{line.NewLine.@}".size()
              if digits > next.new_digits {
                next.new_digits = digits
              }
            }
          }
        }
        self.sections.set(path, next.@)
        match self.context {
          context => {
            let generation = current.generation
            let _ = code::highlight_later(
              old_request,
              context.dispatch,
              fn(result: highlight::Result) {
                self.highlighted(path, generation, true, result)
              },
            )
            let _ = code::highlight_later(
              new_request,
              context.dispatch,
              fn(result: highlight::Result) {
                self.highlighted(path, generation, false, result)
              },
            )
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  private fn mut highlighted(path: Str, generation: Int, old: Bool, result: highlight::Result) {
    match self.sections.get(path) {
      current => {
        if current.generation == generation {
          let next = mut current
          match old {
            true => { next.old_lines = file_pane::lines(result) },
            false => { next.new_lines = file_pane::lines(result) },
          }
          self.sections.set(path, next.@)
        }
      },
      _ => (),
    }
  }

  private fn mut toggle(path: Str) {
    self.collapsed.set(path, not self.collapsed.get(path).or(false))
  }

  // Compares a picked target; the working tree's entry returns to it.
  private fn mut choose(target: protocol::DiffTargetEntry) {
    let current = self.current_target()
    if target.TargetID != current or current == "" {
      self.target = match target.Kind == "working_tree" {
        true => Maybe::new<protocol::DiffTargetEntry>(),
        false => Maybe::new(target),
      }
      self.reset()
      self.observe()
    }
  }

  private fn current_target() Str {
    match self.target {
      target => target.TargetID,
      _ => {
        match self.observation {
          observation => observation.Target.ID,
          _ => "",
        }
      },
    }
  }

  private fn mut pick_target() {
    match self.context {
      context => {
        let dispatch = context.dispatch
        let workspace_id = self.workspace_id
        (self.props.pick_target)(
          TargetRequest{
            workspace_id: workspace_id,
            current: self.current_target(),
            cached: self.targets,
            remember: fn(targets: [protocol::DiffTargetEntry]) {
              let _ = dispatch(fn() {
                // A list from a workspace the pane has left is dropped.
                if self.workspace_id == workspace_id {
                  self.targets = targets
                }
              })
            },
            choose: fn(target: protocol::DiffTargetEntry) {
              let _ = dispatch(fn() {
                self.choose(target)
              })
            },
          },
        )
      },
      _ => (),
    }
  }

  // Whether rows are split: chosen, and the pane is wide enough.
  private fn split_shown() Bool {
    self.split and self.width >= split_width
  }

  // The cells left for a section's text after its padding, gutter and gap.
  private fn text_width(current: Section) Int {
    at_least_one(self.width - gutter(current, "", "", " ").size() - 2)
  }

  // The cells left for a split side's text after its padding, number,
  // marker and gap.
  private fn side_width(digits: Int) Int {
    at_least_one((self.width - 1) / 2 - digits - 4)
  }

  private fn mut scroll_columns(delta: Int) {
    mut most = 0
    for path in self.sections.keys() {
      let current = self.sections.get(path).expect("a section")
      let room = match self.split_shown() {
        true => {
          match current.old_digits > current.new_digits {
            true => self.side_width(current.old_digits),
            false => self.side_width(current.new_digits),
          }
        },
        false => self.text_width(current),
      }
      let overflow = current.widest - room
      if overflow > most {
        most = overflow
      }
    }
    mut next = self.column + delta
    if next > most {
      next = most
    }
    if next < 0 {
      next = 0
    }
    self.column = next
  }

  // Shift+wheel or a horizontal swipe scrolls lines sideways, unless they
  // wrap.
  private fn mut mouse(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::scroll and not self.props.wrap {
      mut delta = received.scroll_x
      if received.modifiers.shift {
        delta = received.scroll_y
      }
      if delta != 0 {
        self.scroll_columns(delta * column_step)
        received.prevent_default()
      }
    }
  }

  // Asks for a section's changes from the render that first shows it.
  private fn mut later_want(path: Str) {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.want(path)
        })
      },
      _ => (),
    }
  }

  // A file's header: a ghost button that collapses or expands the file.
  private fn mut header(file: protocol::DiffFileSummary) cui::View {
    let path = file.Path
    let mark = match self.collapsed.get(path).or(false) {
      true => "▸",
      false => "▾",
    }
    let toggle = keymap::simple_command(
      "diff.toggle:{path}",
      "Collapse or expand {path}",
      fn() Bool {
        self.toggle(path)
        true
      },
    )
    controls::button(
      self.props.themes,
      "{mark} {path}",
      toggle,
      variant: controls::ButtonVariant::ghost,
      compact: true,
      focusable: false,
      stretch: true,
      styles: ui::style(height: ui::cells(1), flex_direction: ui::FlexDirection::row),
    )
  }

  // A line's text, highlighted: clipped to its room and scrolled sideways,
  // or wrapped.
  private fn content(segments: [file_pane::Segment], room: Int) cui::View {
    let colors = self.props.themes.current()
    let shown = match self.props.wrap {
      true => segments,
      false => file_pane::visible(segments, self.column, room),
    }
    let spans = mut List::new<ui::Span>()
    for segment in shown {
      let foreground = match segment.role == "" {
        true => Maybe::new<ui::Color>(),
        false => Maybe::new(colors.syntax(segment.role)),
      }
      spans.push(ui::span(segment.text, style: ui::span_style(foreground: foreground)))
    }
    cui::text(
      ui::styled_text(spans.@),
      styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0)),
      text_style: ui::text_style(foreground: colors.foreground),
      wrap: match self.props.wrap {
        true => ui::TextWrap::word,
        false => ui::TextWrap::none,
      },
      selectable: true,
      selection_style: theme::selection_style(colors),
    )
  }

  // Scrolls to the lines a reveal asked for once they are among the rows,
  // loading their file's changes as needed. A reveal for another target, or
  // for lines the file doesn't show, is dropped.
  private fn mut reveal_pending(built: [Row]) {
    match self.pending {
      reveal => {
        let target = self.current_target()
        if target != "" and target != reveal.target_id and self.observation.is_some() {
          self.pending = Maybe::new<Reveal>()
        } else {
          mut key = ""
          for item in built {
            if key == "" and (item.kind == RowKind::line or item.kind == RowKind::pair) {
              let file = self.files.at(item.file).expect("a changed file")
              if file.Path == reveal.path {
                let current = self.sections.get(file.Path).expect("a loaded section")
                let hunk = current.hunks.at(item.hunk).expect("a hunk")
                let index = match {
                  item.kind == RowKind::line => item.line,
                  reveal.side == "old" => item.old_line,
                  _ => item.new_line,
                }
                if side_number(hunk, index, reveal.side == "old") == reveal.line {
                  key = item.key
                }
              }
            }
          }
          match self.sections.get(reveal.path) {
            loaded => {
              if key == "" and loaded.loaded and loaded.next == "" and (not loaded.reading) {
                self.pending = Maybe::new<Reveal>()
              } else if key == "" {
                self.later_want(reveal.path)
              }
            },
            _ => {
              mut listed = false
              for file in self.files {
                listed = listed or file.Path == reveal.path
              }
              match listed {
                // Not a changed file once the files are known.
                true => self.later_want(reveal.path),
                false => {
                  if self.observation.is_some() {
                    self.pending = Maybe::new<Reveal>()
                  }
                },
              }
            },
          }
          if key != "" {
            match self.context {
              context => {
                let list = self.list
                let _ = after_commit::once(context, fn() {
                  match list.current {
                    current => {
                      if current.scroll_to_key(key, cui::ScrollAlignment::center) {
                        self.pending = Maybe::new<Reveal>()
                      }
                    },
                    _ => (),
                  }
                })
              },
              _ => (),
            }
          }
        }
      },
      _ => (),
    }
  }

  // Whether lines can be annotated: annotations are saved, and the target
  // is observed.
  private fn can_annotate() Bool {
    self.props.annotate.is_some() and self.observation.is_some()
  }

  // Whether lines are being picked or annotated, which holds the document
  // still.
  private fn annotating() Bool {
    self.drag.is_some() or self.editing.is_open()
  }

  // The annotations shown inline: current ones on the observed target's
  // loaded files as they are.
  private fn notes() [sessionbridge::Annotation] {
    match self.observation {
      observation => {
        let shown = mut List::new<sessionbridge::Annotation>()
        for note in self.props.annotations {
          let revision = match self.sections.get(note.Path) {
            loaded => loaded.revision,
            _ => "",
          }
          if note.Kind == "diff" and (not note.Stale) and note.TargetID == observation.Target.ID and note.TargetRevision == observation.Revision and revision != "" and note.FileRevision == revision {
            shown.push(note)
          }
        }
        shown.@
      },
      _ => [],
    }
  }

  // Whether a line is in one of the notes shown.
  private fn annotated(spot: Spot, notes: [sessionbridge::Annotation]) Bool {
    mut found = false
    for note in notes {
      let line = spot.on(note.Side)
      found = found or note.Path == spot.path and line >= note.StartLine and line <= note.EndLine
    }
    found
  }

  // Whether a line is in the range being picked or annotated.
  private fn picked(spot: Spot) Bool {
    match self.editing.current {
      draft => {
        let line = spot.on(draft.side)
        draft.path == spot.path and line >= draft.start and line <= draft.end
      },
      _ => {
        match self.drag {
          from => {
            let line = spot.on(from.side)
            let start = from.on(from.side)
            from.path == spot.path and line > 0 and (line >= start and line <= self.drag_to or line <= start and line >= self.drag_to)
          },
          _ => false,
        }
      },
    }
  }

  // Whether a line's gutter offers a +: it is hovered and nothing else is
  // being annotated.
  private fn offers(spot: Spot) Bool {
    match self.hover {
      hovered => hovered.same(spot) and self.can_annotate() and (not self.annotating()),
      _ => false,
    }
  }

  private fn mut line_mouse(spot: Spot, received: mut event::MouseEvent) {
    let kind = received.event_type
    match self.drag {
      from => {
        // A held press's drags go to the gutter it started in; the lines it
        // crosses learn of it as the pointer enters them.
        if kind == event::MouseEventType::over and spot.path == from.path and spot.hunk == from.hunk and spot.on(from.side) > 0 {
          let start = from.on(from.side)
          mut next = spot.on(from.side)
          if next > start + annotations::max_lines - 1 {
            next = start + annotations::max_lines - 1
          }
          if next < start - annotations::max_lines + 1 {
            next = start - annotations::max_lines + 1
          }
          self.drag_to = next
        }
      },
      _ => {
        if kind == event::MouseEventType::move and received.button == event::MouseButton::none and (not self.editing.is_open()) {
          self.hover = Maybe::new(spot)
        }
      },
    }
  }

  private fn mut gutter_mouse(spot: Spot, received: mut event::MouseEvent) {
    let kind = received.event_type
    if kind == event::MouseEventType::down and received.button == event::MouseButton::left {
      if self.can_annotate() and not self.annotating() {
        self.drag = Maybe::new(spot)
        self.drag_to = spot.on(spot.side)
        self.hover = Maybe::new(spot)
        received.prevent_default()
      }
    } else if kind == event::MouseEventType::up or kind == event::MouseEventType::drag_end {
      self.finish_pick()
    }
  }

  // Ends a gutter press, opening the editor on the lines it covered.
  private fn mut finish_pick() {
    match self.drag {
      from => {
        self.drag = Maybe::new<Spot>()
        let first = from.on(from.side)
        let start = match first < self.drag_to {
          true => first,
          false => self.drag_to,
        }
        let end = match first < self.drag_to {
          true => self.drag_to,
          false => first,
        }
        match self.observation {
          observation => {
            match self.sections.get(from.path) {
              loaded => {
                self.editing.begin(
                  from.path,
                  from.side,
                  start,
                  end,
                  sessionbridge::DiffAnchor(
                    observation.Target.ID,
                    observation.Revision,
                    from.path,
                    loaded.revision,
                    from.side,
                    start,
                    end,
                  ),
                )
              },
              _ => (),
            }
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  private fn mut begin_edit(note: sessionbridge::Annotation) {
    if self.can_annotate() and not self.annotating() {
      match self.context {
        context => {
          match self.props.annotate {
            service => self.editing.edit(note, context, service),
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // A gutter, then a line's text, on its diff fill. A wrapped line continues
  // under its text, beside a blank gutter. The gutter is `numbers`, which
  // end in a space, and the line's marker, between a cell either side; it takes the + button's fill
  // on annotated lines, and the hovered line's offers a + over the marker.
  // Lines being picked or annotated are filled.
  private fn mut numbered(
    spot: Spot,
    numbers: Str,
    marker: Str,
    changed: Bool,
    fill: ui::Color?,
    text: cui::View,
    notes: [sessionbridge::Annotation],
  ) cui::View {
    let colors = self.props.themes.current()
    let style = match {
      self.annotated(spot, notes) => {
        ui::span_style(foreground: colors.foreground, background: colors.primary)
      },
      changed => ui::span_style(foreground: colors.foreground),
      _ => ui::span_style(foreground: colors.muted),
    }
    let spans = match self.offers(spot) {
      true => {
        [
          ui::span(" {strings::TrimSuffix(numbers, " ")}", style: style),
          ui::span(" + ", style: ui::span_style(foreground: colors.foreground, background: colors.primary)),
        ]
      },
      false => [ui::span(" {numbers}{marker} ", style: style)],
    }
    cui::box(
      [
        cui::box(
          [cui::text(ui::styled_text(spans), wrap: ui::TextWrap::none, selectable: false)],
          styles: ui::style(flex_shrink: 0.0),
          on_mouse: fn(received: mut event::MouseEvent, context: cui::Context) {
            self.gutter_mouse(spot, received)
          },
        ),
        text,
      ],
      styles: ui::style(
        flex_grow: 1.0,
        flex_basis: ui::cells(0),
        flex_direction: ui::FlexDirection::row,
        background: match self.picked(spot) {
          true => Maybe::new(colors.surface_hovered),
          false => fill,
        },
      ),
      on_mouse: fn(received: mut event::MouseEvent, context: cui::Context) {
        self.line_mouse(spot, received)
      },
    )
  }

  private fn mut line_view(
    item: Row,
    line: protocol::DiffLine,
    current: Section,
    notes: [sessionbridge::Annotation],
  ) cui::View {
    let removed = line.Kind == "deletion"
    let segments = match removed {
      true => current.old_lines.at(item.old_index).or([]),
      false => current.new_lines.at(item.new_index).or([]),
    }
    let hunk = current.hunks.at(item.hunk).expect("a hunk")
    let spot = Spot{
      path: self.files.at(item.file).expect("a changed file").Path,
      hunk: item.hunk,
      side: match removed {
        true => "old",
        false => "new",
      },
      old: side_number(hunk, item.line, true),
      new: side_number(hunk, item.line, false),
    }
    self.numbered(
      spot,
      gutter(current, number(line.OldLine), number(line.NewLine), ""),
      marker(line),
      line.Kind != "context",
      self.fill(line),
      self.content(segments, self.text_width(current)),
      notes,
    )
  }

  // A split row: the old line on the left and the new one on the right,
  // each with its own number, or a blank where a side has no line.
  private fn mut pair_view(item: Row, current: Section, notes: [sessionbridge::Annotation]) cui::View {
    let hunk = current.hunks.at(item.hunk).expect("a hunk")
    let lines = hunk.Lines
    let path = self.files.at(item.file).expect("a changed file").Path
    let sides = mut List::new<cui::View>()
    match lines.at(item.old_line) {
      line => {
        sides.push(
          self.numbered(
            Spot{
              path: path,
              hunk: item.hunk,
              side: "old",
              old: side_number(hunk, item.old_line, true),
              new: 0,
            },
            "{pad(number(line.OldLine), current.old_digits)} ",
            marker(line),
            line.Kind != "context",
            self.fill(line),
            self.content(
              current.old_lines.at(item.old_index).or([]),
              self.side_width(current.old_digits),
            ),
            notes,
          ),
        )
      },
      _ => sides.push(blank_side()),
    }
    sides.push(self.split_rule())
    match lines.at(item.new_line) {
      line => {
        sides.push(
          self.numbered(
            Spot{
              path: path,
              hunk: item.hunk,
              side: "new",
              old: 0,
              new: side_number(hunk, item.new_line, false),
            },
            "{pad(number(line.NewLine), current.new_digits)} ",
            marker(line),
            line.Kind != "context",
            self.fill(line),
            self.content(
              current.new_lines.at(item.new_index).or([]),
              self.side_width(current.new_digits),
            ),
            notes,
          ),
        )
      },
      _ => sides.push(blank_side()),
    }
    cui::box(sides.@, styles: ui::style(flex_direction: ui::FlexDirection::row))
  }

  // A note or the editor under its line: across the row, indented past the
  // gutter, or in the split layout, in its side's half.
  private fn mut annotation_view(item: Row, current: Section, notes: [sessionbridge::Annotation]) cui::View {
    let split = self.split_shown()
    let gutter_width = match split {
      true => {
        match item.side == "old" {
          true => current.old_digits + 4,
          false => current.new_digits + 4,
        }
      },
      false => gutter(current, "", "", " ").size() + 2,
    }
    let release = self.props.release_focus
    let remove = self.props.remove_annotation
    mut shown = cui::box([])
    match item.kind == RowKind::editor {
      true => {
        shown = self.editing.view(
          self.props.themes,
          gutter_width,
          self.context,
          self.props.annotate,
          fn() {
            release()
          },
        )
      },
      false => {
        for note in notes {
          if note.ID == item.annotation {
            shown = annotations::note_row(
              self.props.themes,
              note,
              gutter_width,
              fn() {
                remove(note.ID)
              },
              fn() {
                self.begin_edit(note)
              },
            )
          }
        }
      },
    }
    match split {
      true => {
        let half = cui::box(
          [shown],
          styles: ui::style(
            flex_grow: 1.0,
            flex_basis: ui::cells(0),
            flex_direction: ui::FlexDirection::column,
          ),
        )
        let sides = match item.side == "old" {
          true => [half, self.split_rule(), blank_side()],
          false => [blank_side(), self.split_rule(), half],
        }
        cui::box(sides, styles: ui::style(flex_direction: ui::FlexDirection::row))
      },
      false => shown,
    }
  }

  // The rule between split sides. It fills a wrapped row's height: its
  // column of glyphs is clipped to the row, and being absolute, it doesn't
  // make the row taller.
  private fn split_rule() cui::View {
    let colors = self.props.themes.current()
    cui::box(
      [
        cui::text(
          split_glyphs,
          styles: ui::style(position: ui::Position::absolute, top: ui::cells(0), left: ui::cells(0)),
          text_style: ui::text_style(foreground: colors.border),
          selectable: false,
        ),
      ],
      styles: ui::style(
        width: ui::cells(1),
        flex_shrink: 0.0,
        position: ui::Position::relative,
        overflow: ui::Overflow::hidden,
      ),
    )
  }

  private fn fill(line: protocol::DiffLine) ui::Color? {
    let colors = self.props.themes.current()
    match line.Kind {
      "addition" => Maybe::new(colors.diff_added),
      "deletion" => Maybe::new(colors.diff_removed),
      _ => Maybe::new<ui::Color>(),
    }
  }

  private fn mut row_view(item: Row, notes: [sessionbridge::Annotation]) cui::View {
    let colors = self.props.themes.current()
    let file = self.files.at(item.file).expect("a changed file")
    match item.kind {
      RowKind::header => self.header(file),
      RowKind::line => {
        let current = self.sections.get(file.Path).expect("a loaded section")
        let line = current.hunks.at(item.hunk).expect("a hunk").Lines.at(item.line).expect("a line")
        self.line_view(item, line, current, notes)
      },
      RowKind::pair => {
        self.pair_view(item, self.sections.get(file.Path).expect("a loaded section"), notes)
      },
      RowKind::annotation => {
        self.annotation_view(item, self.sections.get(file.Path).expect("a loaded section"), notes)
      },
      RowKind::editor => {
        self.annotation_view(item, self.sections.get(file.Path).expect("a loaded section"), notes)
      },
      RowKind::gap => {
        let current = self.sections.get(file.Path).expect("a loaded section")
        let style = ui::text_style(foreground: colors.muted)
        match self.split_shown() {
          true => {
            cui::box(
              [
                cui::box(
                  [layout::line(" {pad("⋯", current.old_digits)}", style)],
                  styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0)),
                ),
                self.split_rule(),
                cui::box(
                  [layout::line(" {pad("⋯", current.new_digits)}", style)],
                  styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0)),
                ),
              ],
              styles: ui::style(flex_direction: ui::FlexDirection::row),
            )
          },
          false => {
            let mark = match current.new_digits > 0 {
              true => gutter(current, "", "⋯", " "),
              false => gutter(current, "⋯", "", " "),
            }
            layout::line(" {mark}", style)
          },
        }
      },
      RowKind::more => {
        self.later_want(file.Path)
        let current = self.sections.get(file.Path).expect("a loaded section")
        let room = match self.split_shown() {
          true => "{pad("", current.old_digits)}  ",
          false => gutter(current, "", "", " "),
        }
        layout::line(" {room} {item.text}", ui::text_style(foreground: colors.muted))
      },
      RowKind::note => {
        if item.text == "Loading…" {
          self.later_want(file.Path)
        }
        layout::line("  {item.text}", ui::text_style(foreground: colors.muted))
      },
      RowKind::border => layout::divider(colors.border),
      RowKind::rule => layout::divider(colors.border),
    }
  }

  // The header of the file whose lines start the view, and its rule,
  // pinned over them. As the next file's header arrives, only the rule is
  // left, so the headers never overlap.
  private fn mut pinned(built: [Row]) cui::View? {
    match built.at(self.top) {
      first => {
        // At a header, or the border over one, nothing needs pinning.
        match first.kind == RowKind::header or first.kind == RowKind::border {
          true => Maybe::new<cui::View>(),
          false => {
            let colors = self.props.themes.current()
            let file = self.files.at(first.file).expect("a changed file")
            let arriving = match built.at(self.top + 1) {
              next => next.kind == RowKind::header,
              _ => false,
            }
            let rows = mut List::new<cui::View>()
            if not arriving {
              rows.push(self.header(file))
            }
            rows.push(layout::divider(colors.border))
            Maybe::new(
              cui::box(
                // Opaque, so the lines it covers don't show through a ghost
                // header.
                rows.@,
                key: "pinned",
                styles: ui::style(
                  background: colors.background,
                  position: ui::Position::absolute,
                  top: ui::cells(0),
                  left: ui::cells(0),
                  right: ui::cells(1),
                  flex_direction: ui::FlexDirection::column,
                ),
              ),
            )
          },
        }
      },
      _ => Maybe::new<cui::View>(),
    }
  }

  private fn summary() Str {
    match self.observation {
      observation => {
        let shown = changed_files(self.files.size())
        match unsafe::is_nil(observation.Truncation) {
          true => shown,
          false => "{shown} · more not shown",
        }
      },
      _ => "",
    }
  }

  private fn mut body() cui::View {
    let colors = self.props.themes.current()
    match self.observation {
      observation => {
        match self.files.size() == 0 {
          true => {
            message(
              match self.target.is_none() {
                true => "No changes in the working tree",
                false => "No changes",
              },
              colors.muted,
            )
          },
          false => {
            let notes = self.notes()
            let built = rows(
              self.files,
              self.sections,
              self.collapsed,
              self.split_shown(),
              notes,
              self.editing.current,
            )
            self.reveal_pending(built)
            // Wrapped rows, notes, and the editor are measured.
            mut measured = self.props.wrap
            for item in built {
              measured = measured or item.kind == RowKind::annotation or item.kind == RowKind::editor
            }
            let children = mut List::new<cui::View>()
            children.push(
              cui::virtual_list(
                built,
                fn(item: Row) Str {
                  item.key
                },
                fn(item: Row) cui::View {
                  self.row_view(item, notes)
                },
                estimated_height: 1,
                row_height: match measured {
                  true => Maybe::new<Int>(),
                  false => Maybe::new(1),
                },
                key: "diff-rows",
                styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0)),
                ref: self.list,
                on_mouse: fn(received: mut event::MouseEvent, context: cui::Context) {
                  self.mouse(received)
                },
                on_update: fn(update: cui::VirtualListUpdate, context: cui::Context) {
                  self.top = update.state.visible_range.start
                },
              ),
            )
            match self.pinned(built) {
              view => children.push(view),
              _ => (),
            }
            cui::box(
              children.@,
              styles: ui::style(
                flex_grow: 1.0,
                flex_basis: ui::cells(0),
                flex_direction: ui::FlexDirection::column,
                position: ui::Position::relative,
              ),
            )
          },
        }
      },
      _ => {
        match self.failure == "" {
          true => loading(colors),
          false => message(self.failure, colors.danger_text),
        }
      },
    }
  }
}

private fn number(value: mut Int) Str {
  match unsafe::is_nil(value) {
    true => "",
    false => "{value.@}",
  }
}

private fn marker(line: protocol::DiffLine) Str {
  match line.Kind {
    "addition" => "+",
    "deletion" => "−",
    _ => " ",
  }
}

private fn at_least_one(cells: Int) Int {
  match cells < 1 {
    true => 1,
    false => cells,
  }
}

// A split side without a line. It's padded like a side with one, so both
// halves share the row evenly.
private fn blank_side() cui::View {
  cui::box(
    [],
    styles: ui::style(
      flex_grow: 1.0,
      flex_basis: ui::cells(0),
      padding: ui::Edges{
        top: ui::cells(0),
        right: ui::cells(0),
        bottom: ui::cells(0),
        left: ui::cells(1),
      },
    ),
  )
}

// A line's gutter: its old and new numbers, each right-aligned to its side's
// widest, then its marker. A side without numbers takes no room.
private fn gutter(current: Section, old: Str, new: Str, marker: Str) Str {
  mut text = ""
  if current.old_digits > 0 {
    text = text + pad(old, current.old_digits) + " "
  }
  if current.new_digits > 0 {
    text = text + pad(new, current.new_digits) + " "
  }
  text + marker
}

private fn pad(value: Str, width: Int) Str {
  let room = width - format::cell_width(value)
  match room > 0 {
    true => strings::Repeat(" ", room) + value,
    false => value,
  }
}

private fn segments_width(segments: [file_pane::Segment]) Int {
  mut width = 0
  for segment in segments {
    width =+ format::cell_width(segment.text)
  }
  width
}

// A whole-pane message, centered.
private fn message(text: Str, color: ui::Color) cui::View {
  layout::centered([cui::text(text, text_style: ui::text_style(foreground: color))])
}

private fn loading(colors: theme::Theme) cui::View {
  layout::centered(
    [
      cui::box(
        [
          spinner::spinner(),
          cui::text("Loading diff…", text_style: ui::text_style(foreground: colors.muted)),
        ],
        styles: ui::style(flex_direction: ui::FlexDirection::row, gap: ui::cells(1)),
      ),
    ],
  )
}

// Lists every page of a target's changed files.
private fn observe_all(fetch: fn(Str) protocol::WorkingTreePage!Error) Observed!Error {
  let first = try fetch("")
  let files = mut List::new<protocol::DiffFileSummary>()
  for file in first.Files {
    files.push(file)
  }
  mut cursor = first.NextCursor
  while cursor != "" {
    let page = try fetch(cursor)
    for file in page.Files {
      files.push(file)
    }
    cursor = page.NextCursor
  }
  Result::ok(Observed{observation: first.Observation, files: files.@})
}

impl Pane {
  // The pane's header: the target, a button that opens the picker, and the
  // file count; then the wrap toggle and, where wide enough, the layout
  // toggle. Each toggle names its current state.
  private fn mut header_row() cui::View {
    let colors = self.props.themes.current()
    let label = match self.target {
      target => target_label(target),
      _ => "Working tree",
    }
    let wrap = self.props.wrap
    let set_wrap = self.props.set_wrap
    let right = mut List::new<cui::View>()
    right.push(
      controls::button(
        self.props.themes,
        match wrap {
          true => "Wrap on",
          false => "Wrap off",
        },
        keymap::simple_command("diff.wrap", "Wrap lines", fn() Bool {
          set_wrap(not wrap)
          true
        }),
        variant: controls::ButtonVariant::ghost,
        compact: true,
        focusable: false,
      ),
    )
    if self.width >= split_width {
      right.push(
        controls::button(
          self.props.themes,
          match self.split {
            true => "Split",
            false => "Unified",
          },
          keymap::simple_command("diff.layout", "Change layout", fn() Bool {
            self.split = not self.split
            self.column = 0
            true
          }),
          variant: controls::ButtonVariant::ghost,
          compact: true,
          focusable: false,
        ),
      )
    }
    cui::box(
      [
        cui::box(
          [
            controls::button(
              self.props.themes,
              "{label} ▾",
              keymap::simple_command("diff.target", "Choose what to compare", fn() Bool {
                self.pick_target()
                true
              }),
              variant: controls::ButtonVariant::ghost,
              compact: true,
              focusable: false,
              styles: ui::style(flex_shrink: 0.0),
            ),
            layout::line(self.summary(), ui::text_style(foreground: colors.muted)),
          ],
          styles: ui::style(
            flex_grow: 1.0,
            flex_basis: ui::cells(0),
            flex_direction: ui::FlexDirection::row,
            gap: ui::cells(1),
            overflow: ui::Overflow::hidden,
          ),
        ),
        cui::box(
          right.@,
          styles: ui::style(flex_shrink: 0.0, flex_direction: ui::FlexDirection::row, gap: ui::cells(1)),
        ),
      ],
      styles: ui::style(
        height: ui::cells(1),
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::row,
      ),
    )
  }
}

impl cui::Component for Pane {
  fn mut render() cui::View {
    self.sync()
    let colors = self.props.themes.current()
    cui::box(
      [
        self.header_row(),
        layout::divider(colors.border),
        cui::box(
          [self.body()],
          ref: self.frame,
          styles: ui::style(
            flex_grow: 1.0,
            flex_basis: ui::cells(0),
            flex_direction: ui::FlexDirection::column,
            overflow: ui::Overflow::hidden,
          ),
        ),
      ],
      styles: ui::style(
        flex_grow: 1.0,
        flex_basis: ui::cells(0),
        flex_direction: ui::FlexDirection::column,
      ),
    )
  }
}

private fn summary(path: Str, state: Str) protocol::DiffFileSummary {
  protocol::DiffFileSummary{
    Path: path,
    ContentState: state,
    FileRevision: "rev",
  }
}

private fn kinds(built: [Row]) Str {
  mut shown = ""
  for item in built {
    let kind = match item.kind {
      RowKind::header => "h",
      RowKind::line => "l",
      RowKind::pair => "p",
      RowKind::gap => "g",
      RowKind::note => "n",
      RowKind::more => "m",
      RowKind::border => "b",
      RowKind::rule => "r",
      RowKind::annotation => "a",
      RowKind::editor => "e",
    }
    shown = "{shown}{kind}"
  }
  shown
}

private fn hunk(kinds: [Str]) protocol::DiffHunk {
  let lines = mut List::new<protocol::DiffLine>()
  for kind in kinds {
    lines.push(protocol::DiffLine{Kind: kind, Content: kind})
  }
  protocol::DiffHunk{Lines: lines.@}
}

test fn rows_follow_each_file_and_its_hunks() Void!Str {
  let files = [
    summary("a.go", "text"),
    summary("b.png", "binary"),
    summary("c.go", "text"),
    summary("d.go", "text"),
  ]
  let loaded = mut section("rev")
  loaded.loaded = true
  loaded.hunks = [hunk(["context", "deletion", "addition"]), hunk(["addition"])]
  let sections: [Str: Section] = ["a.go": loaded.@]
  let collapsed: [Str: Bool] = ["c.go": true]
  let built = rows(files, sections, collapsed, false, [], Maybe::new<annotations::Draft>())
  try testing::assert(kinds(built) == "hrlllglbhrnbhbhrn", kinds(built))
  let removed = built.at(3).expect("the deletion")
  let added = built.at(4).expect("the addition")
  try testing::assert(removed.old_index == 1 and removed.new_index == -1, "a deletion is on the old side")
  try testing::assert(added.new_index == 1 and added.old_index == -1, "an addition is on the new side")
  try testing::assert(
    built.at(10).expect("the binary note").text == "Binary file changed",
    "content states explain themselves",
  )
  testing::assert(
    built.at(16).expect("the unloaded note").text == "Loading…",
    "an unloaded file waits",
  )
}

test fn sides_rebuild_the_old_and_new_text() Void!Str {
  let texts = sides([hunk(["context", "deletion", "addition"])])
  try testing::assert(texts.at(0).or("") == "context\ndeletion\n", "the old side drops additions")
  testing::assert(texts.at(1).or("") == "context\naddition\n", "the new side drops deletions")
}

test fn the_gutter_fits_each_side_and_drops_an_empty_one() Void!Str {
  let changed = mut section("rev")
  changed.old_digits = 2
  changed.new_digits = 3
  try testing::assert(
    gutter(changed.@, "9", "100", "+") == " 9 100 +",
    "each side fits its widest number",
  )
  let added = mut section("rev")
  added.new_digits = 2
  try testing::assert(gutter(added.@, "", "12", "+") == "12 +", "an added file has no old column")
  let deleted = mut section("rev")
  deleted.old_digits = 1
  testing::assert(gutter(deleted.@, "7", "", "−") == "7 −", "a deleted file has no new column")
}

// Each split row as "old/new" hunk line indexes, "-" for a blank side.
private fn sides_of(built: [Row]) Str {
  let shown = mut List::new<Str>()
  for item in built {
    if item.kind == RowKind::pair {
      let old = match item.old_line < 0 {
        true => "-",
        false => "{item.old_line}",
      }
      let new = match item.new_line < 0 {
        true => "-",
        false => "{item.new_line}",
      }
      shown.push("{old}/{new}")
    }
  }
  strings::Join(shown, " ")
}

test fn split_rows_pair_removed_lines_with_added_ones() Void!Str {
  let loaded = mut section("rev")
  loaded.loaded = true
  loaded.hunks = [
    hunk(["context", "deletion", "deletion", "addition", "context", "addition", "deletion"]),
  ]
  let sections: [Str: Section] = ["a.go": loaded.@]
  let collapsed: [Str: Bool] = [:]
  let built = rows(
    [summary("a.go", "text")],
    sections,
    collapsed,
    true,
    [],
    Maybe::new<annotations::Draft>(),
  )
  try testing::assert(kinds(built) == "hrppppp", kinds(built))
  try testing::assert(sides_of(built) == "0/0 1/3 2/- 4/4 6/5", sides_of(built))
  let second = built.at(3).expect("the first changed pair")
  testing::assert(second.old_index == 1 and second.new_index == 1, "each side counts its own lines")
}

// A hunk of lines numbered from `old` and `new` on their sides.
private fn numbered_hunk(kinds: [Str], old: Int, new: Int) protocol::DiffHunk {
  let lines = mut List::new<protocol::DiffLine>()
  mut old_at = old
  mut new_at = new
  for kind in kinds {
    let line = mut protocol::DiffLine{Kind: kind, Content: kind}
    if kind != "addition" {
      let number = old_at
      line.OldLine = mut number
      old_at =+ 1
    }
    if kind != "deletion" {
      let number = new_at
      line.NewLine = mut number
      new_at =+ 1
    }
    lines.push(line.@)
  }
  protocol::DiffHunk{Lines: lines.@}
}

private fn diff_note(id: Int, side: Str, start: Int, end: Int) sessionbridge::Annotation {
  sessionbridge::Annotation{
    ID: Uint64::fit(id),
    Kind: "diff",
    Side: side,
    Path: "a.go",
    StartLine: start,
    EndLine: end,
  }
}

test fn notes_follow_the_line_they_end_on_by_side() Void!Str {
  let loaded = mut section("rev")
  loaded.loaded = true
  // Old 10 context, old 11 removed, new 11 added, old 12 / new 12 context.
  loaded.hunks = [numbered_hunk(["context", "deletion", "addition", "context"], 10, 10)]
  let sections: [Str: Section] = ["a.go": loaded.@]
  let collapsed: [Str: Bool] = [:]
  let notes = [diff_note(1, "old", 11, 11), diff_note(2, "new", 10, 11)]
  let unified = rows(
    [summary("a.go", "text")],
    sections,
    collapsed,
    false,
    notes,
    Maybe::new<annotations::Draft>(),
  )
  try testing::assert(kinds(unified) == "hrllalal", kinds(unified))
  let split = rows(
    [summary("a.go", "text")],
    sections,
    collapsed,
    true,
    notes,
    Maybe::new<annotations::Draft>(),
  )
  try testing::assert(kinds(split) == "hrppaap", kinds(split))
  let draft = annotations::Draft{
    path: "a.go",
    side: "new",
    start: 12,
    end: 12,
    id: Uint64::from(0),
    anchor: protocol::AnnotationAnchor{},
    text: "",
    loading: false,
    saving: false,
    failure: "",
  }
  let editing = rows(
    [summary("a.go", "text")],
    sections,
    collapsed,
    false,
    notes,
    Maybe::new(draft),
  )
  try testing::assert(
    kinds(editing) == "hrllalale",
    "a new note's editor follows its last line: {kinds(editing)}",
  )
  let edited = mut draft
  edited.id = Uint64::from(2)
  edited.start = 10
  edited.end = 11
  let replacing = rows(
    [summary("a.go", "text")],
    sections,
    collapsed,
    false,
    notes,
    Maybe::new(edited.@),
  )
  testing::assert(
    kinds(replacing) == "hrllalel",
    "an edited note's editor takes its place: {kinds(replacing)}",
  )
}
