use ard/testing

use cooper/ui
use kit/tui/figure/drawing
use kit/tui/figure/grammar
use kit/tui/figure/model
use kit/tui/format
use go:math
use go:strings

// `bars`: one labelled bar per row, scaled to the largest value or `max`,
// with each row's share of the first row or of the total when `percent`
// asks (docs/figures.md).

let max_rows = 20

// The cells a bar's track spans.
let track = 24

// The widest label drawn; longer labels end in `…`.
let max_label = 32

private struct Row {
  item: model::Item,
  number: Float64,
}

private fn row(each: grammar::Item) Row!Str {
  match grammar::label_value(each.text) {
    parts => {
      let number = try grammar::number(parts.at(1).or(""))
      let made = mut model::item(parts.at(0).or(""), parts.at(1).or(""))
      made.note = each.note
      made.accent = each.bold
      made.muted = each.italic
      match {
        each.details.size() > 0 => Result::err("a bars row takes no indented lines"),
        number < 0.0 => Result::err("bars can't be negative, got `{grammar::clip(parts.at(1).or(""))}`"),
        _ => Result::ok(Row{item: made.@, number: number}),
      }
    },
    _ => Result::err("a bars row is `label: value`, got `{grammar::clip(each.text)}`"),
  }
}

// The largest share shown; a larger one shows as `>9999%`.
let max_share = 9999

// The share at and above which it rounds past max_share.
let past_max_share = 9999.5

// value's share of whole, as a whole percent.
fn share(value: Float64, whole: Float64) Str {
  let percent = value / whole * 100.0
  match {
    percent == 0.0 => "0%",
    percent < 1.0 => "<1%",
    percent >= past_max_share => ">{max_share}%",
    _ => "{Int::fit(math::Round(percent))}%",
  }
}

private fn scale_max(info: grammar::Info, rows: [Row]) Float64!Str {
  let written = grammar::attribute(info, "max")
  match written == "" {
    true => {
      mut largest = 0.0
      for each in rows {
        if each.number > largest {
          largest = each.number
        }
      }
      Result::ok(largest)
    },
    false => {
      let value = try grammar::number(written)
      match value > 0.0 {
        true => Result::ok(value),
        false => Result::err("`max` must be above zero"),
      }
    },
  }
}

// The whole each row's share is of, or zero for none.
private fn share_whole(info: grammar::Info, rows: [Row]) Float64!Str {
  let percent = grammar::attribute(info, "percent")
  mut total = 0.0
  for each in rows {
    total =+ each.number
  }
  let first = match rows.at(0) {
    each => each.number,
    _ => 0.0,
  }
  match percent {
    "" => Result::ok(0.0),
    "first" => {
      match first > 0.0 {
        true => Result::ok(first),
        false => Result::err("`percent=\"first\"` needs a first row above zero"),
      }
    },
    "total" => {
      match total > 0.0 {
        true => Result::ok(total),
        false => Result::err("`percent=\"total\"` needs a total above zero"),
      }
    },
    _ => Result::err("`percent` is `first` or `total`"),
  }
}

fn parse(info: grammar::Info, body: Str) model::Figure!Str {
  try grammar::check_attributes(info, ["title", "max", "percent"])
  let items = try grammar::items(body)
  try grammar::check_one_bold(items)
  let rows = mut List::new<Row>()
  for each in items {
    rows.push(try row(each))
  }
  let most = try scale_max(info, rows.@)
  let whole = try share_whole(info, rows.@)
  let first_only = grammar::attribute(info, "percent") == "first"
  let made = mut List::new<model::Item>()
  mut index = 0
  for each in rows {
    let item = mut each.item
    item.scale = grammar::permille(each.number, most)
    if whole > 0.0 and not first_only and index == 0 {
      item.share = share(each.number, whole)
    }
    made.push(item.@)
    index =+ 1
  }
  match {
    rows.size() == 0 => Result::err("the figure has no rows"),
    rows.size() > max_rows => Result::err("a bars figure has at most {max_rows} rows"),
    _ => Result::ok(model::figure("bars", grammar::attribute(info, "title"), made.@)),
  }
}

private fn widest(texts: [Str]) Int {
  mut width = 0
  for text in texts {
    let cells = ui::text_width(text)
    if cells > width {
      width = cells
    }
  }
  width
}

// A bar scale thousandths of the track long.
fn bar(scale: Int) [Str] {
  drawing::bar(scale, track)
}

fn draw(figure: model::Figure) drawing::Drawing {
  let labels = mut List::new<Str>()
  let values = mut List::new<Str>()
  let shares = mut List::new<Str>()
  mut emphasized = false
  for each in figure.items {
    labels.push(format::truncate_cells(each.label, max_label))
    values.push(each.value)
    shares.push(each.share)
    if each.accent {
      emphasized = true
    }
  }
  let label_lane = widest(labels.@)
  let value_lane = widest(values.@)
  let share_lane = widest(shares.@)
  let rows = mut List::new<[drawing::Segment]>()
  mut index = 0
  for each in figure.items {
    let quiet = each.muted or emphasized and (not each.accent)
    let label = drawing::pad(labels.at(index).or(""), label_lane, false)
    let lengths = bar(each.scale)
    let line = mut List::new<drawing::Segment>()
    line.push(
      match {
        each.accent => drawing::bold(label, drawing::Role::text),
        each.muted => drawing::segment(label, drawing::Role::muted),
        _ => drawing::segment(label, drawing::Role::text),
      },
    )
    line.push(drawing::segment("  ", drawing::Role::text))
    line.push(
      drawing::segment(
        lengths.at(0).or(""),
        match {
          each.accent => drawing::Role::accent,
          quiet => drawing::Role::muted,
          _ => drawing::Role::text,
        },
      ),
    )
    line.push(drawing::segment(lengths.at(1).or(""), drawing::Role::track))
    let value = "  {drawing::pad(each.value, value_lane, true)}"
    line.push(
      match {
        each.accent => drawing::bold(value, drawing::Role::text),
        quiet => drawing::segment(value, drawing::Role::muted),
        _ => drawing::segment(value, drawing::Role::text),
      },
    )
    if share_lane > 0 {
      line.push(
        drawing::segment("  {drawing::pad(each.share, share_lane, true)}", drawing::Role::muted),
      )
    }
    if each.note != "" {
      line.push(drawing::segment("  {each.note}", drawing::Role::muted))
    }
    rows.push(line.@)
    index =+ 1
  }
  drawing::framed(figure.title, rows.@)
}

test fn bars_are_drawn_in_eighths_of_a_cell() Void!Str {
  try testing::assert(bar(1000).at(0).or("") == strings::Repeat("█", 24), "a full bar fills the track")
  let half = bar(510)
  try testing::assert(half.at(0).or("") == "{strings::Repeat("█", 12)}▏", "got {half.at(0).or("")}")
  testing::assert(bar(1).at(0).or("") == "▏", "a value above zero always shows")
}

test fn shares_round_to_whole_percents() Void!Str {
  try testing::assert(share(4100.0, 12400.0) == "33%", "got {share(4100.0, 12400.0)}")
  try testing::assert(share(1.0, 1000.0) == "<1%", "got {share(1.0, 1000.0)}")
  try testing::assert(share(0.0, 10.0) == "0%", "got {share(0.0, 10.0)}")
  try testing::assert(share(99994.0, 1000.0) == "9999%", "got {share(99994.0, 1000.0)}")
  try testing::assert(share(99995.0, 1000.0) == ">9999%", "got {share(99995.0, 1000.0)}")
  testing::assert(
    share(1000000000000000.0, 0.001) == ">9999%",
    "got {share(1000000000000000.0, 0.001)}",
  )
}
