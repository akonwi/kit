use ard/testing

use cooper/ui
use kit/tui/figure/drawing
use kit/tui/figure/grammar
use kit/tui/figure/model
use kit/tui/format
use go:strings

// `stack`: rows split into the same named segments, each row filling the
// track or, with `scale="shared"`, scaled to the largest total, with a
// legend of the segments under them (docs/figures.md).

let max_rows = 12

// The cells a stack's track spans.
let track = 24

// The widest label drawn; longer labels end in `…`.
let max_label = 32

let min_segments = 2

let max_segments = 4

// The shade each segment is drawn in, in order.
let shades = ["█", "▓", "▒", "░"]

// One `value name` segment of a row.
private struct Segment {
  name: Str,
  written: Str,
  value: Float64,
}

private fn segment(text: Str) Segment!Str {
  let trimmed = strings::TrimSpace(text)
  let space = strings::Index(trimmed, " ")
  let written = trimmed.slice(end: space).or("")
  let name = strings::TrimSpace(trimmed.slice(start: space + 1).or(""))
  match space > 0 and name != "" {
    true => {
      let value = try grammar::number(written)
      match value < 0.0 {
        true => Result::err("stack values can't be negative, got `{grammar::clip(written)}`"),
        false => {
          Result::ok(
            Segment{
              name: name,
              written: written,
              value: value,
            },
          )
        },
      }
    },
    false => Result::err("a stack segment is `value name`, got `{grammar::clip(trimmed)}`"),
  }
}

private struct Row {
  item: model::Item,
  segments: [Segment],
  total: Float64,
}

private fn row(each: grammar::Item) Row!Str {
  match grammar::label_value(each.text) {
    parts => {
      let segments = mut List::new<Segment>()
      for text in strings::Split(parts.at(1).or(""), ", ") {
        segments.push(try segment(text))
      }
      mut total = 0.0
      let shapes = mut List::new<grammar::Shape>()
      for each_segment in segments {
        total =+ each_segment.value
        shapes.push(grammar::shape(each_segment.written))
      }
      let made = mut model::item(
        parts.at(0).or(""),
        grammar::written(total, grammar::common(shapes.@), false),
      )
      made.note = each.note
      made.accent = each.bold
      made.muted = each.italic
      let shares = mut List::new<Int>()
      for each_segment in segments {
        shares.push(grammar::permille(each_segment.value, total))
      }
      made.parts = shares.@
      match {
        each.details.size() > 0 => Result::err("a stack row takes no indented lines"),
        segments.size() < min_segments or segments.size() > max_segments => {
          Result::err(
            "a stack row has {min_segments} to {max_segments} segments, got {segments.size()}",
          )
        },
        _ => {
          Result::ok(
            Row{
              item: made.@,
              segments: segments.@,
              total: total,
            },
          )
        },
      }
    },
    _ => Result::err("a stack row is `label: value name, …`, got `{grammar::clip(each.text)}`"),
  }
}

private fn names(row: Row) [Str] {
  let result = mut List::new<Str>()
  for each in row.segments {
    result.push(each.name)
  }
  result.@
}

fn parse(info: grammar::Info, body: Str) model::Figure!Str {
  try grammar::check_attributes(info, ["title", "scale"])
  let scale = grammar::attribute(info, "scale")
  let items = try grammar::items(body)
  try grammar::check_one_bold(items)
  let rows = mut List::new<Row>()
  for each in items {
    rows.push(try row(each))
  }
  let none: [Str] = []
  let headings = match rows.at(0) {
    first => names(first),
    _ => none,
  }
  mut largest = 0.0
  mut different = ""
  mut unlike = ""
  let first_shape = grammar::shape(
    match rows.at(0) {
      first => first.segments.at(0).expect("a segment").written,
      _ => "",
    },
  )
  for each in rows {
    for part in each.segments {
      if (not grammar::same_unit(grammar::shape(part.written), first_shape)) and unlike == "" {
        unlike = each.item.label
      }
    }
    if each.total > largest {
      largest = each.total
    }
    if strings::Join(mut names(each), ", ") != strings::Join(mut headings, ", ") and different == "" {
      different = each.item.label
    }
  }
  let made = mut List::new<model::Item>()
  for each in rows {
    let item = mut each.item
    item.scale = match scale == "shared" {
      true => grammar::permille(each.total, largest),
      false => {
        match each.total > 0.0 {
          true => 1000,
          false => 0,
        }
      },
    }
    made.push(item.@)
  }
  match {
    scale != "" and scale != "shared" => Result::err("`scale` is `shared`"),
    rows.size() == 0 => Result::err("the figure has no rows"),
    rows.size() > max_rows => Result::err("a stack figure has at most {max_rows} rows"),
    different != "" => {
      Result::err(
        "every stack row has the segments `{grammar::clip(strings::Join(mut headings, ", "))}` in order, unlike `{grammar::clip(different)}`",
      )
    },
    unlike != "" => {
      Result::err("every stack value is in the same unit, unlike `{grammar::clip(unlike)}`")
    },
    _ => {
      let figure = mut model::figure("stack", grammar::attribute(info, "title"), made.@)
      figure.headings = headings
      Result::ok(figure.@)
    },
  }
}

// cells × thousandths, rounded to whole cells.
private fn cells(permille: Int, cells: Int) Int {
  (permille * cells * 2 + 1000) / 2000
}

// The cells each segment of a row takes, the row being length cells long:
// each boundary rounded, so the segments add up to the row.
fn widths(parts: [Int], length: Int) [Int] {
  let result = mut List::new<Int>()
  mut sum = 0
  mut start = 0
  mut index = 0
  for each in parts {
    sum =+ each
    let end = match index == parts.size() - 1 {
      true => length,
      false => cells(sum, length),
    }
    result.push(end - start)
    start = end
    index =+ 1
  }
  result.@
}

// The cells a row of scale thousandths spans; a row above zero always shows.
fn length(scale: Int) Int {
  let rounded = cells(scale, track)
  match rounded == 0 and scale > 0 {
    true => 1,
    false => rounded,
  }
}

private fn widest(texts: [Str]) Int {
  mut width = 0
  for text in texts {
    let cells = ui::text_width(text)
    if cells > width {
      width = cells
    }
  }
  width
}

fn draw(figure: model::Figure) drawing::Drawing {
  let labels = mut List::new<Str>()
  let values = mut List::new<Str>()
  mut emphasized = false
  for each in figure.items {
    labels.push(format::truncate_cells(each.label, max_label))
    values.push(each.value)
    if each.accent {
      emphasized = true
    }
  }
  let label_lane = widest(labels.@)
  let value_lane = widest(values.@)
  let rows = mut List::new<[drawing::Segment]>()
  mut index = 0
  for each in figure.items {
    let quiet = each.muted or emphasized and (not each.accent)
    let label = drawing::pad(labels.at(index).or(""), label_lane, false)
    let line = mut List::new<drawing::Segment>()
    line.push(
      match {
        each.accent => drawing::bold(label, drawing::Role::text),
        each.muted => drawing::segment(label, drawing::Role::muted),
        _ => drawing::segment(label, drawing::Role::text),
      },
    )
    line.push(drawing::segment("  ", drawing::Role::text))
    let role = match {
      each.accent => drawing::Role::accent,
      quiet => drawing::Role::muted,
      _ => drawing::Role::text,
    }
    let span = length(each.scale)
    let none: [Int] = []
    let filled = match each.scale > 0 {
      true => widths(each.parts, span),
      false => none,
    }
    mut shade = 0
    let runs = mut List::new<Str>()
    for width in filled {
      runs.push(strings::Repeat(shades.at(shade).or("░"), width))
      shade =+ 1
    }
    line.push(drawing::segment(strings::Join(runs, ""), role))
    line.push(drawing::segment(strings::Repeat("·", track - span), drawing::Role::track))
    let value = "  {drawing::pad(each.value, value_lane, true)}"
    line.push(
      match {
        each.accent => drawing::bold(value, drawing::Role::text),
        quiet => drawing::segment(value, drawing::Role::muted),
        _ => drawing::segment(value, drawing::Role::text),
      },
    )
    if each.note != "" {
      line.push(drawing::segment("  {each.note}", drawing::Role::muted))
    }
    rows.push(line.@)
    index =+ 1
  }
  rows.push([])
  let legend = mut List::new<Str>()
  mut shade = 0
  for name in figure.headings {
    legend.push("{shades.at(shade).or("░")} {format::truncate_cells(name, max_label)}")
    shade =+ 1
  }
  rows.push([drawing::segment(strings::Join(legend, "   "), drawing::Role::muted)])
  drawing::framed(figure.title, rows.@)
}

test fn segments_round_at_each_boundary_and_fill_the_row() Void!Str {
  let got = widths([480, 220, 300], 24)
  try testing::assert(
    got.at(0).or(0) == 12 and got.at(1).or(0) == 5 and got.at(2).or(0) == 7,
    "got {got.at(0).or(0)} {got.at(1).or(0)} {got.at(2).or(0)}",
  )
  let short = widths([333, 333, 333], 5)
  testing::assert(
    short.at(0).or(0) == 2 and short.at(1).or(0) == 1 and short.at(2).or(0) == 2,
    "got {short.at(0).or(0)} {short.at(1).or(0)} {short.at(2).or(0)}",
  )
}
