use ard/testing

use cooper/cui
use cooper/event
use cooper/keymap
use cooper/ui
use go:github.com/akonwi/kit/internal/textfind
use kit/tui/theme
use go:strings

// Find in a File tab: the matches of a query in the texts the tab shows,
// which is current, and the row under the pane's header that asks for them.
// Matching is internal/textfind's, the reference every Kit client's find bar
// agrees with (testdata/find). The tab supplies its texts as pieces, a
// source's lines or the texts a rendered Markdown file's blocks show, and no
// match spans two. Ranges are byte offsets into a piece.

// A match: a byte range of one piece.
struct Match {
  piece: Int,
  start: Int,
  end: Int,
}

// The matches of a search, in order, and whether more exist past the
// limit.
struct Found {
  matches: [Match],
  capped: Bool,
}

// A place in the pieces: a byte offset into one of them.
struct Position {
  piece: Int,
  offset: Int,
}

// A match drawn in a piece: its byte range and whether it is current.
struct Mark {
  start: Int,
  end: Int,
  current: Bool,
}

// A run of a piece's text, and how find draws it: 0 for a plain run, 1 for
// a match, 2 for the current match.
struct Part {
  text: Str,
  mark: Int,
}

// The matches of query in pieces, counting at most textfind's limit across
// them all.
fn search(pieces: [Str], query: Str, match_case: Bool, whole_word: Bool) Found {
  // Joined by line feeds, which no query holds, pieces can't share a
  // match, and each edge is a word boundary as a piece's own edge is.
  let joined = strings::Join(pieces, "\n")
  let result = textfind::Find(
    joined,
    query,
    textfind::Options{
      MatchCase: match_case,
      WholeWord: whole_word,
      Limit: 0,
    },
  )
  let matches = &mut List::new<Match>()
  mut piece = 0
  mut start = 0
  mut end = pieces.at(0).or("").size()
  for range in result.Matches {
    while range.Start > end and piece < pieces.size() - 1 {
      start = end + 1
      piece =+ 1
      end = start + pieces.at(piece).or("").size()
    }
    matches.push(
      Match{
        piece: piece,
        start: range.Start - start,
        end: range.End - start,
      },
    )
  }
  Found{matches: matches.*, capped: result.Capped}
}

private fn before(hit: Match, position: Position) Bool {
  hit.piece < position.piece or hit.piece == position.piece and hit.start < position.offset
}

// The index of the first match at or after position, the first match when
// none is, or -1 without matches.
fn following(matches: [Match], position: Position) Int {
  match matches.size() == 0 {
    true => -1,
    false => {
      mut low = 0
      mut high = matches.size()
      while low < high {
        let middle = (low + high) / 2
        match before(
          matches.at(
            middle,
          ).or(
            Match{
              piece: 0,
              start: 0,
              end: 0,
            },
          ),
          position,
        ) {
          true => { low = middle + 1 },
          false => { high = middle },
        }
      }
      match low == matches.size() {
        true => 0,
        false => low,
      }
    },
  }
}

// The marks in piece `piece`: its matches, with the one at index `current`
// marked current.
fn marks(matches: [Match], current: Int, piece: Int) [Mark] {
  let found = &mut List::new<Mark>()
  mut index = following(matches, Position{piece: piece, offset: 0})
  if index >= 0 {
    mut more = true
    while more and index < matches.size() {
      let hit = matches.at(
        index,
      ).or(
        Match{
          piece: -1,
          start: 0,
          end: 0,
        },
      )
      match hit.piece == piece {
        true => {
          found.push(
            Mark{
              start: hit.start,
              end: hit.end,
              current: index == current,
            },
          )
          index =+ 1
        },
        false => { more = false },
      }
    }
  }
  found.*
}

// Text that starts `offset` bytes into a piece, cut where marks begin and
// end.
fn split(text: Str, offset: Int, marks: [Mark]) [Part] {
  let parts = &mut List::new<Part>()
  let end = offset + text.size()
  mut at = offset
  for mark in marks {
    if mark.end > at and mark.start < end {
      let from = match mark.start > at {
        true => mark.start,
        false => at,
      }
      let to = match mark.end < end {
        true => mark.end,
        false => end,
      }
      if from > at {
        parts.push(Part{text: text.slice(at - offset, from - offset).or(""), mark: 0})
      }
      parts.push(
        Part{
          text: text.slice(from - offset, to - offset).or(""),
          mark: match mark.current {
            true => 2,
            false => 1,
          },
        },
      )
      at = to
    }
  }
  if at < end {
    parts.push(Part{text: text.slice(at - offset, end - offset).or(""), mark: 0})
  }
  parts.*
}

// The fill a part draws on: the match tint, the accent for the current
// match, or `otherwise` off a match.
fn fill(colors: theme::Theme, mark: Int, otherwise: ui::Color?) ui::Color? {
  match mark {
    1 => Maybe::new(colors.find_match),
    2 => Maybe::new(colors.primary_text),
    _ => otherwise,
  }
}

// The text color of a part on its fill, or `color` off one.
fn ink(colors: theme::Theme, mark: Int, color: ui::Color?) ui::Color? {
  match mark == 2 {
    true => Maybe::new(colors.selection_backdrop),
    false => color,
  }
}

// What a File tab's find holds while open: the query, the options, what it
// found, and which match is current.
struct State {
  open: Bool,
  query: Str,
  match_case: Bool,
  whole_word: Bool,
  matches: [Match],
  capped: Bool,
  // The current match's index, or -1.
  current: Int,
}

fn state() &mut State {
  &mut State{
    open: false,
    query: "",
    match_case: false,
    whole_word: false,
    matches: [],
    capped: false,
    current: -1,
  }
}

impl State {
  fn current_match() Match? {
    match self.current >= 0 {
      true => self.matches.at(self.current),
      false => Maybe::new<Match>(),
    }
  }

  // Opens the row. A search then starts from the top of what's shown.
  fn mut open() {
    self.open = true
    self.current = -1
  }

  // Closes the row, keeping the query for the next opening.
  fn mut close() {
    self.open = false
    self.current = -1
    self.matches = []
    self.capped = false
  }

  // Searches pieces and picks the current match: the first at or after
  // where the current one was, or else at or after `top`.
  fn mut search(pieces: [Str], top: Position) {
    let anchor = match self.current_match() {
      hit => Position{piece: hit.piece, offset: hit.start},
      _ => top,
    }
    let found = search(pieces, self.query, self.match_case, self.whole_word)
    self.matches = found.matches
    self.capped = found.capped
    self.current = following(found.matches, anchor)
  }

  // Moves `by` matches on, wrapping. Returns whether there was one to move
  // to.
  fn mut step(by: Int) Bool {
    let count = self.matches.size()
    match count == 0 or self.current < 0 {
      true => false,
      false => {
        self.current = ((self.current + by) % count + count) % count
        true
      },
    }
  }

  // What the row's count reads: empty with nothing typed. `searched_lines`
  // is how many lines a file that arrived cut short has, or 0.
  fn count(searched_lines: Int) Str {
    match self.query == "" {
      true => "",
      false => textfind::Label(self.current + 1, self.matches.size(), self.capped, searched_lines),
    }
  }

  // The count in a narrow row: "3/12", "1/10,000+", or "No matches".
  fn short_count() Str {
    match self.query == "" {
      true => "",
      false => {
        strings::Replace(
          textfind::Label(self.current + 1, self.matches.size(), self.capped, 0),
          " of ",
          "/",
          1,
        )
      },
    }
  }
}

// The row under a File tab's header while find is open.
struct RowProps {
  themes: theme::Context,
  find: State,
  // The cells the row spans.
  width: Int,
  // How many lines a file that arrived cut short has, or 0.
  searched_lines: Int,
  field: &mut cui::InputRef,
  input: fn(Str),
  step: fn(Int),
  toggle_case: fn(),
  toggle_word: fn(),
  close: fn(),
}

// The cells the field keeps however narrow the row, and the cells it keeps
// beside the label and arrows.
let least_field = 12
let roomy_field = 20

// Whether a row of `width` cells holds the "Find" label, the arrows, and
// `count` beside a field of a comfortable width: a cell either side, gaps
// between, Aa and ab with a cell either side, and ×.
fn roomy(width: Int, count: Str) Bool {
  let counted = match count == "" {
    true => 0,
    false => ui::text_width(count) + 1,
  }
  2 + 4 + 1 + roomy_field + 1 + counted + 4 + 1 + 4 + 1 + 5 + 1 + 1 <= width
}

private fn clickable(view: cui::View, action: fn()) cui::View {
  cui::box(
    [view],
    styles: ui::style(flex_shrink: 0.0),
    on_mouse: fn(received: &mut event::MouseEvent, context: cui::Context) {
      if received.event_type == event::MouseEventType::down and received.button == event::MouseButton::left {
        action()
        received.prevent_default()
      }
    },
  )
}

private fn padded(label: Str, style: ui::TextStyle, fill: ui::Color?) cui::View {
  cui::text(
    " {label} ",
    styles: ui::style(flex_shrink: 0.0, background: fill),
    text_style: style,
    wrap: ui::TextWrap::none,
    selectable: false,
  )
}

// The row: "Find", the field with the query, the count, Aa and ab, the
// arrows, and ×. A narrow row drops the label and arrows and counts
// briefly. Enter or ↓ steps on, Shift+Enter or ↑ back; Alt+C and Alt+W
// toggle the options, and Esc closes the row.
fn row(props: RowProps) cui::View {
  let colors = props.themes.current()
  let muted = ui::text_style(foreground: colors.muted)
  let full = props.find.count(props.searched_lines)
  let wide = roomy(props.width, full)
  let count = match wide {
    true => full,
    false => props.find.short_count(),
  }
  let matched = props.find.matches.size() > 0
  let input = props.input
  let step = props.step
  let toggle_case = props.toggle_case
  let toggle_word = props.toggle_word
  let close = props.close
  let next = keymap::simple_command("find.next", "Next match", fn() Bool {
    step(1)
    true
  })
  let previous = keymap::simple_command("find.previous", "Previous match", fn() Bool {
    step(-1)
    true
  })
  let case_option = keymap::simple_command("find.match_case", "Match case", fn() Bool {
    toggle_case()
    true
  })
  let word = keymap::simple_command("find.whole_word", "Whole word", fn() Bool {
    toggle_word()
    true
  })
  let dismiss = keymap::simple_command("find.close", "Close find", fn() Bool {
    close()
    true
  })
  let children = &mut List::new<cui::View>()
  if wide {
    children.push(
      cui::text(
        "Find",
        styles: ui::style(flex_shrink: 0.0),
        text_style: muted,
        wrap: ui::TextWrap::none,
      ),
    )
  }
  children.push(
    cui::box(
      [
        cui::input(
          props.find.query,
          key: "file.find",
          autofocus: true,
          ref: Maybe::new(props.field),
          styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0), min_width: ui::cells(0)),
          on_input: fn(value: Str, context: cui::Context) {
            input(value)
          },
          commands: [next, previous, case_option, word, dismiss],
          bindings: [
            keymap::binding(keymap::key("return"), next.with()),
            keymap::binding(keymap::key("down"), next.with(), keymap::Trigger::press_or_repeat),
            keymap::binding(keymap::key("return", shift: true), previous.with()),
            keymap::binding(keymap::key("up"), previous.with(), keymap::Trigger::press_or_repeat),
            keymap::binding(keymap::key("c", alt: true), case_option.with()),
            keymap::binding(keymap::key("w", alt: true), word.with()),
            keymap::binding(keymap::key("escape"), dismiss.with()),
          ],
        ),
      ],
      styles: ui::style(
        flex_grow: 1.0,
        flex_basis: ui::cells(0),
        min_width: ui::cells(least_field),
        flex_direction: ui::FlexDirection::row,
        background: colors.surface_hovered,
        padding: ui::Edges{
          top: ui::cells(0),
          right: ui::cells(1),
          bottom: ui::cells(0),
          left: ui::cells(1),
        },
      ),
    ),
  )
  if count != "" {
    let tone = match matched {
      true => colors.muted,
      false => colors.warning_text,
    }
    children.push(
      cui::text(
        count,
        styles: ui::style(flex_shrink: 0.0),
        text_style: ui::text_style(foreground: tone),
        wrap: ui::TextWrap::none,
      ),
    )
  }
  let option = fn(label: Str, on: Bool, action: fn()) cui::View {
    let style = match on {
      true => ui::text_style(foreground: colors.primary_text),
      false => muted,
    }
    let fill = match on {
      true => Maybe::new(colors.surface_hovered),
      false => Maybe::new<ui::Color>(),
    }
    clickable(padded(label, style, fill), action)
  }
  children.push(option("Aa", props.find.match_case, toggle_case))
  children.push(option("ab", props.find.whole_word, toggle_word))
  if wide {
    // The arrows read as text with matches to step through, dim without,
    // and muted before anything is typed.
    let arrows = match {
      matched => ui::text_style(foreground: colors.foreground),
      props.find.query == "" => muted,
      _ => ui::text_style(foreground: colors.border),
    }
    children.push(
      cui::box(
        [
          clickable(padded("‹", arrows, Maybe::new<ui::Color>()), fn() {
            step(-1)
          }),
          clickable(cui::text("› ", text_style: arrows, wrap: ui::TextWrap::none, selectable: false), fn() {
            step(1)
          }),
        ],
        styles: ui::style(flex_shrink: 0.0, flex_direction: ui::FlexDirection::row),
      ),
    )
  }
  children.push(
    clickable(
      cui::text("×", text_style: muted, wrap: ui::TextWrap::none, selectable: false),
      fn() {
        close()
      },
    ),
  )
  cui::box(
    children.*,
    styles: ui::style(
      flex_shrink: 0.0,
      height: ui::cells(1),
      flex_direction: ui::FlexDirection::row,
      gap: ui::cells(1),
      padding: ui::Edges{
        top: ui::cells(0),
        right: ui::cells(1),
        bottom: ui::cells(0),
        left: ui::cells(1),
      },
    ),
  )
}

private fn found_at(found: Found) Str {
  let parts = &mut List::new<Str>()
  for hit in found.matches {
    parts.push("{hit.piece}:{hit.start}-{hit.end}")
  }
  strings::Join(parts, " ")
}

private fn parts_text(parts: [Part]) Str {
  let shown = &mut List::new<Str>()
  for part in parts {
    shown.push("{part.mark}[{part.text}]")
  }
  strings::Join(shown, "")
}

test fn a_search_finds_matches_in_each_piece_by_byte() Void!Str {
  let pieces = ["let cursor = 1", "", "cursor(cursor) é cursor"]
  let found = search(pieces, "cursor", false, false)
  try testing::assert(
    found_at(found) == "0:4-10 2:0-6 2:7-13 2:18-24",
    "matches by piece: {found_at(found)}",
  )
  try testing::assert(not found.capped, "uncapped")
  try testing::assert(found_at(search(pieces, "Cursor", true, false)) == "", "match case")
  try testing::assert(
    found_at(search(["a b", "ab"], "b", false, true)) == "0:2-3",
    "whole word: a piece's edge is a boundary, its inside isn't",
  )
  testing::assert(
    found_at(search(["ab", "c"], "bc", false, false)) == "",
    "no match spans two pieces",
  )
}

test fn the_current_match_follows_a_position_and_wraps() Void!Str {
  let matches = search(["a a", "a"], "a", false, false).matches
  try testing::assert(following(matches, Position{piece: 0, offset: 1}) == 1, "at or after")
  try testing::assert(following(matches, Position{piece: 1, offset: 1}) == 0, "past the last, the first")
  try testing::assert(following([], Position{piece: 0, offset: 0}) == -1, "none")
  let find = state()
  find.open()
  find.query = "a"
  find.search(["a a", "a"], Position{piece: 0, offset: 2})
  try testing::assert(find.current == 1, "from the top of what's shown: {find.current}")
  try testing::assert(find.step(1) and find.current == 2, "next")
  try testing::assert(find.step(1) and find.current == 0, "next wraps")
  try testing::assert(find.step(-1) and find.current == 2, "previous wraps")
  find.query = "a "
  find.search(["a a", "a"], Position{piece: 0, offset: 0})
  try testing::assert(find.current == 0, "typing more keeps the place, wrapping when it's gone")
  testing::assert(find.count(0) == "1 of 1", "count: {find.count(0)}")
}

test fn the_count_says_none_caps_and_how_far_a_cut_file_was_searched() Void!Str {
  let find = state()
  find.query = "zz"
  find.search(["abc"], Position{piece: 0, offset: 0})
  try testing::assert(find.count(0) == "No matches", "none")
  try testing::assert(not find.step(1), "nothing to step to")
  find.query = "b"
  find.search(["b b b"], Position{piece: 0, offset: 0})
  try testing::assert(find.count(5000) == "1 of 3 in the first 5,000 lines", "cut short")
  try testing::assert(find.short_count() == "1/3", "narrow")
  find.query = "zz"
  find.search(["b b b"], Position{piece: 0, offset: 0})
  try testing::assert(find.short_count() == "No matches", "narrow, none")
  find.query = ""
  testing::assert(find.count(0) == "", "nothing typed")
}

test fn marks_cut_text_at_their_edges() Void!Str {
  let matches = search(["xx ab ab", "ab"], "ab", false, false).matches
  let marked = marks(matches, 1, 0)
  try testing::assert(marked.size() == 2, "the piece's own marks")
  try testing::assert(
    parts_text(split("xx ab ab", 0, marked)) == "0[xx ]1[ab]0[ ]2[ab]",
    "whole: {parts_text(split("xx ab ab", 0, marked))}",
  )
  testing::assert(
    parts_text(split("x ab", 4, marked)) == "1[x]0[ ]2[ab]",
    "a run partway in: {parts_text(split("x ab", 4, marked))}",
  )
}

test fn a_narrow_row_drops_the_label_and_arrows() Void!Str {
  try testing::assert(roomy(80, "3 of 12"), "wide")
  testing::assert(not roomy(48, "3 of 12"), "narrow")
}
