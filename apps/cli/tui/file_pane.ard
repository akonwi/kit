use ard/async
use ard/testing
use ard/unsafe

use go:api/contract as protocol
use cooper/cui
use cooper/event
use cooper/keymap
use cooper/ui
use go:fmt
use go:github.com/akonwi/kit/internal/highlight
use go:github.com/akonwi/kit/internal/markdown as parser
use go:kit/ffi/contextbridge
use go:kit/ffi/hostfilebridge
use go:kit/ffi/sessionbridge
use kit/tui/after_commit
use kit/tui/annotations
use kit/tui/code
use kit/tui/controls
use kit/tui/layout
use kit/tui/markdown
use kit/tui/theme
use kit/tui/workspace
use go:path
use go:strings

// A File tab's body: the file as the session's workspace has it, with line
// numbers, highlighting, and a cursor line. Lines don't wrap; the wheel
// scrolls them sideways with Shift or a horizontal swipe, and the line
// numbers stay put. Hovering or clicking a line moves the cursor to it. The
// pane is mouse-only. The file loads when its tab is first shown and again
// each time it is shown. A tab opened in a workspace the session has since
// left is frozen: it keeps what it showed and loads nothing.
//
// The cursor line's gutter offers a +: clicking it annotates the line, and
// dragging from it over more lines annotates them all. A card under the
// lines takes the note. Saved notes sit under their last line, which a bar
// in the gutter ties them to; clicking one edits it and its × deletes it.
//
// A host File tab shows a file on the session's server outside its working
// directory (ADR 0050), by absolute path. Its text can't be annotated, and a
// supported image shows in place of lines, fitted to the pane.
//
// A Markdown file shows rendered, as the transcript renders Markdown, until
// the header's toggle, which names the current view, switches it to its
// source; the tab keeps the choice while it is open. An opening at a line
// shows the source at that line, unless it reveals an annotation, which the
// preview shows in place. Annotations anchor to source lines; the preview
// works on whole blocks. Hovering a block offers a + in its gutter that
// annotates the block's source lines, and dragging down the gutter takes in
// the blocks it crosses. A saved note sits under the block holding its last
// line, and annotated blocks' gutters are filled. The toggle is hidden while
// a note is being written. A file past the parser's budget for files shows
// its source. Links show their labels; web links open as transcript links
// do.

// Cells a horizontal wheel step moves the text.
let column_step = 4

// The preview's gutter, which holds a block's + and a note's ×.
let preview_gutter = 3

// The extensions of files that show rendered: Markdown's common ones.
let markdown_extensions = [".md", ".markdown", ".mdown", ".mdwn", ".mkd", ".mkdn", ".mkdown"]

// Whether a file is Markdown by its name, which shows it rendered. A name
// that is only an extension, such as `.md`, isn't.
fn is_markdown(file_path: Str) Bool {
  let extension = strings::ToLower(path::Ext(file_path))
  mut found = false
  for candidate in markdown_extensions {
    found = found or extension == candidate
  }
  found and path::Base(file_path).size() > extension.size()
}

// A Markdown file's content, parsed, and whether it ends inside a code
// fence, as a truncated preview may.
struct Parsed {
  document: parser::Document,
  fence_open: Bool,
}

// The Markdown parsed from a file's content, for a Markdown file read off
// the UI thread; else none.
private fn parse_if(wanted: Bool, content: Str) Parsed? {
  match wanted {
    true => {
      Maybe::new(
        Parsed{document: markdown::parse_file(content), fence_open: markdown::ends_inside_fence(content)},
      )
    },
    false => Maybe::new<Parsed>(),
  }
}

// A host image is decoded to fit these pixels: twice the cell density of a
// wide terminal pane, beyond which a bigger image only costs memory.
let image_width = 1600
let image_height = 1600

struct Props {
  themes: theme::Context,
  tab: workspace::Tab,
  // Whether the session has left the tab's workspace.
  stale: Bool,
  // Whether the tab is selected.
  shown: Bool,
  // Reads a workspace file; blocks.
  read: (fn(protocol::ReadWorkspaceFileInput) protocol::WorkspaceFileRead!Error)?,
  // Reads a host file within image bounds in pixels; blocks.
  read_host: (fn(Str, Int, Int) hostfilebridge::File!Error)?,
  // The session's annotations, and what saves them; without it, lines can't
  // be annotated.
  annotations: [sessionbridge::Annotation],
  annotate: annotations::Service?,
  remove_annotation: fn(Uint64),
  // Hands the keyboard back once the note editor closes.
  release_focus: fn(),
}

fn view(props: Props) cui::View {
  cui::child(new, props, key: "file-pane:{props.tab.id}")
}

// A run of a line's text and its syntax role, or "" for none.
struct Segment {
  text: Str,
  role: Str,
}

// Why a file shows no content.
struct Failure {
  title: Str,
  detail: Str,
  // Whether the workspace is gone, which freezes the tab.
  stale: Bool,
}

// The lines of highlighted source, split into segments. A final newline
// ends the last line rather than starting another.
fn lines(result: highlight::Result) [[Segment]] {
  let source = result.Source
  let pieces = mut List::new<Segment>()
  mut position = 0
  for capture in result.Spans {
    if capture.Start > position {
      pieces.push(Segment{text: source.slice(position, capture.Start).or(""), role: ""})
    }
    pieces.push(
      Segment{text: source.slice(capture.Start, capture.End).or(""), role: capture.Role.to_str()},
    )
    position = capture.End
  }
  if position < source.size() {
    pieces.push(Segment{text: source.slice(position, source.size()).or(""), role: ""})
  }
  let rows = mut List::new<[Segment]>()
  mut current = mut List::new<Segment>()
  for piece in pieces {
    for part, index in strings::Split(piece.text, "\n") {
      if index > 0 {
        rows.push(current.@)
        current = mut List::new<Segment>()
      }
      if part != "" {
        current.push(Segment{text: part, role: piece.role})
      }
    }
  }
  if source != "" and not strings::HasSuffix(source, "\n") {
    rows.push(current.@)
  }
  rows.@
}

// The cells of segments from column `from`, at most `width` of them. A wide
// character cut by either edge is left out.
fn visible(segments: [Segment], from: Int, width: Int) [Segment] {
  let shown = mut List::new<Segment>()
  mut at = 0
  for segment in segments {
    mut text = ""
    for character in ui::graphemes(segment.text) {
      let start = at
      at =+ character.width
      if start >= from and at <= from + width {
        text = "{text}{character.text}"
      }
    }
    if text != "" {
      shown.push(Segment{text: text, role: segment.role})
    }
  }
  shown.@
}

private fn line_width(segments: [Segment]) Int {
  mut width = 0
  for segment in segments {
    width =+ ui::text_width(segment.text)
  }
  width
}

// The header's right side: the cursor line, line count, and size, losing
// the size and then the count when the path needs the room. Narrower than
// `width`, the path keeps at least a third of the row. Rendered Markdown has
// no cursor line, so a `cursor` of 0 leaves it out, and the count goes last.
fn status(width: Int, file_path: Str, cursor: Int, count: Int, size: Int) Str {
  let full = match cursor > 0 {
    true => "Ln {cursor} · {count} lines · {size_label(size)}",
    false => "{count} lines · {size_label(size)}",
  }
  let shorter = match cursor > 0 {
    true => "Ln {cursor} · {count} lines",
    false => "{count} lines",
  }
  let shortest = match cursor > 0 {
    true => "Ln {cursor}",
    false => "",
  }
  // A cell either side of the header and two between its sides.
  let room = width - 4 - ui::text_width(file_path)
  let least = width / 3
  match {
    width <= 0 or ui::text_width(full) <= room => full,
    width - 4 - ui::text_width(full) >= least => full,
    ui::text_width(shorter) <= room or width - 4 - ui::text_width(shorter) >= least => shorter,
    _ => shortest,
  }
}

// A file size in a compact, human-readable unit.
fn size_label(size: Int) Str {
  match {
    size < 1024 => "{size} B",
    size < 1024 * 1024 => fmt::Sprintf("%.1f KiB", Float64::fit(size) / 1024.0),
    _ => fmt::Sprintf("%.1f MiB", Float64::fit(size) / 1048576.0),
  }
}

// What a failed read shows.
fn failure(error: Error) Failure {
  let canceled = Failure{
    title: "Load canceled",
    detail: "It loads again when this tab is next shown.",
    stale: false,
  }
  match unsafe::cast<mut protocol::WorkspaceError>(error) {
    workspace_error => {
      match "{workspace_error.Code}" {
        "stale_workspace" => {
          Failure{
            title: "Stale workspace",
            detail: "This tab is frozen at its original workspace.",
            stale: true,
          }
        },
        "binary_file" => {
          Failure{
            title: "Binary file",
            detail: "A text preview is not available.",
            stale: false,
          }
        },
        "not_found" => {
          Failure{
            title: "File not found",
            detail: "The file may have moved or been removed.",
            stale: false,
          }
        },
        "not_file" => {
          Failure{
            title: "File not found",
            detail: "The file may have moved or been removed.",
            stale: false,
          }
        },
        "permission_denied" => unreadable(),
        "outside_workspace" => unreadable(),
        "symlink_traversal" => unreadable(),
        "unavailable" => {
          Failure{
            title: "Workspace files unavailable",
            detail: "Try again when the session workspace is available.",
            stale: false,
          }
        },
        "capacity_exceeded" => {
          Failure{
            title: "Workspace is busy",
            detail: "It loads again when this tab is next shown.",
            stale: false,
          }
        },
        "limit_exceeded" => {
          Failure{
            title: "Workspace is busy",
            detail: "It loads again when this tab is next shown.",
            stale: false,
          }
        },
        _ => {
          Failure{
            title: "Could not load file",
            detail: workspace_error.Message,
            stale: false,
          }
        },
      }
    },
    _ => {
      match strings::Contains(error.error(), "context canceled") {
        true => canceled,
        false => {
          Failure{
            title: "Could not load file",
            detail: error.error(),
            stale: false,
          }
        },
      }
    },
  }
}

// What a failed host file read shows.
fn host_failure(error: Error) Failure {
  let problem = hostfilebridge::Describe(error)
  match problem.Title == "" {
    true => failure(error),
    false => {
      Failure{
        title: problem.Title,
        detail: problem.Detail,
        stale: false,
      }
    },
  }
}

// The cells an image of `width` by `height` pixels spans to fit within
// `columns` by `rows` cells, keeping its proportions in cells twice as tall
// as they are wide; at least one cell each way.
fn image_cells(width: Int, height: Int, columns: Int, rows: Int) Cells {
  match width <= 0 or height <= 0 or columns <= 0 or rows <= 0 {
    true => Cells{columns: 1, rows: 1},
    false => {
      // Rows the image needs at the full width, rounded up.
      let tall = (columns * height + 2 * width - 1) / (2 * width)
      match tall <= rows {
        true => Cells{columns: columns, rows: at_least_one(tall)},
        false => Cells{columns: at_least_one((rows * 2 * width + height - 1) / height), rows: rows},
      }
    },
  }
}

private fn at_least_one(value: Int) Int {
  match value < 1 {
    true => 1,
    false => value,
  }
}

struct Cells {
  columns: Int,
  rows: Int,
}

private fn unreadable() Failure {
  Failure{
    title: "File is unreadable",
    detail: "Permission was denied by the workspace host.",
    stale: false,
  }
}

// One virtual row: a line, or in the preview a block, a saved note under
// it, or the note editor.
private enum ItemKind {
  line,
  note,
  editor,
  block,
}

private struct Item {
  kind: ItemKind,
  number: Int,
  note: sessionbridge::Annotation?,
}

private struct Lines {
  start: Int,
  end: Int,
}

private struct Pane {
  props: mut Props,
  context: cui::Context?,
  list: mut cui::VirtualListRef,
  frame: mut cui::BoxRef,
  // The body's width and height as last laid out; zero until then.
  width: Int,
  height: Int,
  // A host image as decoded, and its description for the header.
  image: ui::ImageData?,
  image_label: Str,
  // The latest read, and its lines as currently highlighted.
  read: protocol::WorkspaceFileRead?,
  // Whether a Markdown file shows rendered rather than as source, and the
  // latest read's Markdown, parsed, with whether it ends inside a fence.
  rendered: Bool,
  document: parser::Document?,
  fence_open: Bool,
  blocks: mut cui::VirtualListRef,
  rows: [[Segment]],
  widest: Int,
  loading: Bool,
  failed: Failure?,
  frozen: Bool,
  // Counts loads and highlights, so a superseded one is ignored.
  generation: Int,
  highlighting: contextbridge::Cancellation?,
  cursor: Int,
  column: Int,
  // The opening of the tab last acted on; see `workspace::Tab`.
  opening: Int,
  // Whether the cursor line should be scrolled into view once lines load.
  reveal: Bool,
  was_shown: Bool,
  // The line a gutter press started on, while it is held; else 0.
  drag_from: Int,
  // In the preview: the block under the pointer, and the block a gutter
  // press started on while it is held; else -1. A line an opening asked
  // the preview to reveal, once the file loads; else 0.
  hovered_block: Int,
  drag_block: Int,
  reveal_line: Int,
  editing: mut annotations::Drafting,
}

private fn new(props: mut Props) mut Pane {
  (mut Pane{
    props: props,
    context: Maybe::new<cui::Context>(),
    list: cui::virtual_list_ref(),
    frame: cui::box_ref(),
    width: 0,
    height: 0,
    image: Maybe::new<ui::ImageData>(),
    image_label: "",
    read: Maybe::new<protocol::WorkspaceFileRead>(),
    rendered: is_markdown(props.tab.path),
    document: Maybe::new<parser::Document>(),
    fence_open: false,
    blocks: cui::virtual_list_ref(),
    rows: [],
    widest: 0,
    loading: false,
    failed: Maybe::new<Failure>(),
    frozen: false,
    generation: 0,
    highlighting: Maybe::new<contextbridge::Cancellation>(),
    cursor: 1,
    column: 0,
    opening: 0,
    reveal: false,
    was_shown: false,
    drag_from: 0,
    hovered_block: -1,
    drag_block: -1,
    reveal_line: 0,
    editing: annotations::drafting(),
  })
}

impl cui::Lifecycle for Pane {
  fn mut mounted(context: cui::Context) {
    self.context = Maybe::new(context)
    let _ = context.internal_layout(fn() Bool {
      self.measure()
    })
    self.sync()
  }

  fn mut unmounting(context: cui::Context) {
    self.generation =+ 1
    self.editing.close()
    self.stop_highlight()
    self.context = Maybe::new<cui::Context>()
  }
}

impl Pane {
  private fn mut measure() Bool {
    match self.frame.current {
      frame => {
        let width = frame.layout().local.width
        let height = frame.layout().local.height
        let changed = width != self.width or height != self.height
        self.width = width
        self.height = height
        changed
      },
      _ => false,
    }
  }

  // Acts on prop changes: a new opening's line, being shown again, and
  // gaining the keyboard.
  private fn mut sync() {
    let tab = self.props.tab
    if tab.opening != self.opening {
      self.opening = tab.opening
      if tab.line > 0 and tab.reveals_note and self.rendered and is_markdown(tab.path) {
        // The preview shows a note in place.
        self.cursor = tab.line
        self.reveal_line = tab.line
        self.reveal_note()
      } else if tab.line > 0 {
        // A line is in the source.
        self.rendered = false
        self.cursor = tab.line
        self.reveal = true
        self.reveal_cursor()
      }
    }
    // Rendering precedes mounting; transitions wait for the context.
    if self.context.is_some() {
      if self.props.shown and not self.was_shown {
        self.load()
      }
      self.was_shown = self.props.shown
    }
  }

  private fn locked() Bool {
    self.frozen or self.props.stale
  }

  private fn mut load() {
    if self.props.tab.kind == workspace::Kind::host_file {
      self.load_host()
    } else {
      self.load_workspace()
    }
  }

  private fn mut load_host() {
    match self.context {
      context => {
        match self.props.read_host {
          read => {
            self.generation =+ 1
            let generation = self.generation
            self.loading = true
            let file_path = self.props.tab.path
            let dispatch = context.dispatch
            let matte = self.props.themes.current().background
            let wanted = is_markdown(file_path)
            async::start(fn() {
              let result = read(file_path, image_width, image_height)
              let parsed = match result {
                ok(file) => parse_if(wanted and not file.Image, file.Text.Content),
                err(_) => Maybe::new<Parsed>(),
              }
              let _ = dispatch(fn() {
                if self.generation == generation {
                  self.loading = false
                  match result {
                    ok(file) => {
                      match file.Image {
                        true => self.loaded_image(file, matte),
                        false => {
                          self.image = Maybe::new<ui::ImageData>()
                          self.loaded(file.Text, parsed)
                        },
                      }
                    },
                    err(error) => self.load_failed(host_failure(error)),
                  }
                }
              })
            })
          },
          _ => {
            self.load_failed(
              Failure{
                title: "Files unavailable",
                detail: "This connection can't read files.",
                stale: false,
              },
            )
          },
        }
      },
      _ => (),
    }
  }

  private fn mut loaded_image(file: hostfilebridge::File, matte: ui::Color) {
    let background = match matte.index.is_none() and not matte.terminal_default {
      true => matte,
      false => ui::rgb(0, 0, 0),
    }
    self.read = Maybe::new(file.Text)
    self.rows = []
    self.widest = 0
    self.failed = Maybe::new<Failure>()
    self.image = Maybe::new(
      ui::image_rgba(
        file.Pixels.Width,
        file.Pixels.Height,
        file.Pixels.RGBA,
        Maybe::new(background),
      ),
    )
    self.image_label = "{file.Width} × {file.Height} · {size_label(Int::fit(file.Text.Size))}"
  }

  private fn mut load_workspace() {
    match self.context {
      context => {
        match self.props.read {
          read => {
            if not self.locked() {
              self.generation =+ 1
              let generation = self.generation
              self.loading = true
              let input = protocol::ReadWorkspaceFileInput{WorkspaceID: self.props.tab.workspace_id, Path: self.props.tab.path}
              let dispatch = context.dispatch
              let wanted = is_markdown(self.props.tab.path)
              async::start(fn() {
                let result = read(input)
                let parsed = match result {
                  ok(file) => parse_if(wanted, file.Content),
                  err(_) => Maybe::new<Parsed>(),
                }
                let _ = dispatch(fn() {
                  if self.generation == generation {
                    self.loading = false
                    match result {
                      ok(file) => self.loaded(file, parsed),
                      err(error) => self.load_failed(failure(error)),
                    }
                  }
                })
              })
            }
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  private fn mut load_failed(reason: Failure) {
    self.failed = Maybe::new(reason)
    if reason.stale {
      self.frozen = true
    }
  }

  private fn mut loaded(file: protocol::WorkspaceFileRead, parsed: Parsed?) {
    self.read = Maybe::new(file)
    self.failed = Maybe::new<Failure>()
    match parsed {
      markdown_file => {
        self.document = Maybe::new(markdown_file.document)
        self.fence_open = markdown_file.fence_open
      },
      _ => {
        self.document = Maybe::new<parser::Document>()
        self.fence_open = false
      },
    }
    let request = code::source_request("", file.Path, file.Content)
    self.show(code::plain(request))
    self.stop_highlight()
    let generation = self.generation
    match self.context {
      context => {
        self.highlighting = code::highlight_later(
          request,
          context.dispatch,
          fn(result: highlight::Result) {
            if self.generation == generation {
              self.highlighting = Maybe::new<contextbridge::Cancellation>()
              self.show(result)
            }
          },
        )
      },
      _ => (),
    }
    if self.cursor > self.rows.size() {
      self.cursor = match self.rows.size() > 0 {
        true => self.rows.size(),
        false => 1,
      }
    }
    if self.reveal {
      self.reveal_cursor()
    }
    if self.reveal_line > 0 {
      self.reveal_note()
    }
  }

  // Shows the line a revealed note starts on: in the preview, or, for a
  // file past the parser's budget, in the source. Before the file loads,
  // `loaded` does.
  private fn mut reveal_note() {
    match self.document {
      document => {
        match self.showing_rendered() {
          true => self.reveal_block(),
          false => {
            self.reveal_line = 0
            self.reveal = true
            self.reveal_cursor()
          },
        }
      },
      _ => (),
    }
  }

  private fn mut show(result: highlight::Result) {
    self.rows = lines(result)
    mut widest = 0
    for row in self.rows {
      let width = line_width(row)
      if width > widest {
        widest = width
      }
    }
    self.widest = widest
  }

  private fn mut stop_highlight() {
    match self.highlighting {
      attempt => attempt.Cancel(),
      _ => (),
    }
    self.highlighting = Maybe::new<contextbridge::Cancellation>()
  }

  private fn mut reveal_cursor() {
    match self.context {
      context => {
        let list = self.list
        let key = "{self.cursor}"
        let _ = after_commit::once(context, fn() {
          match list.current {
            current => {
              if current.scroll_to_key(key, cui::ScrollAlignment::center) {
                self.reveal = false
              }
            },
            _ => (),
          }
        })
      },
      _ => (),
    }
  }

  // Scrolls the preview to the note starting on the line an opening asked
  // for, or the block holding the line, once the file has loaded.
  private fn mut reveal_block() {
    match self.context {
      context => {
        let index = self.block_of(self.reveal_line)
        if index >= 0 {
          let list = self.blocks
          mut key = "block:{index}"
          for note in self.notes() {
            if note.StartLine == self.reveal_line and key.starts_with("block:") {
              key = "note:{note.ID}"
            }
          }
          let _ = after_commit::once(context, fn() {
            match list.current {
              current => {
                if current.scroll_to_key(key, cui::ScrollAlignment::center) {
                  self.reveal_line = 0
                }
              },
              _ => (),
            }
          })
        }
      },
      _ => (),
    }
  }

  // The preview's blocks, or none before the file is parsed.
  private fn preview_blocks() [parser::Block] {
    match self.document {
      document => document.Blocks,
      _ => [],
    }
  }

  // The block a source line shows in: the last block starting at or before
  // it, or the first block for a line before them all; -1 without blocks.
  private fn block_of(line: Int) Int {
    let blocks = self.preview_blocks()
    // Blocks with lines start in order; those without, such as rules, sit
    // between them and are passed over.
    mut low = 0
    mut high = blocks.size() - 1
    mut found = -1
    while low <= high {
      let middle = (low + high) / 2
      mut probe = middle
      mut start = 0
      while probe >= low {
        start = blocks.at(probe).or(parser::Block{}).StartLine
        if start > 0 {
          break
        }
        probe = probe - 1
      }
      if probe < low {
        low = middle + 1
      } else if start <= line {
        found = probe
        low = middle + 1
      } else {
        high = probe - 1
      }
    }
    match found < 0 and blocks.size() > 0 {
      true => 0,
      false => found,
    }
  }

  // Whether a block can be annotated whole: it has source lines, no more
  // than one note may cover.
  private fn annotatable(block: parser::Block) Bool {
    block.StartLine > 0 and block.EndLine - block.StartLine < annotations::max_lines
  }

  // The source lines from block `from` through block `to`, either way.
  private fn block_lines(from: Int, to: Int) Lines {
    let blocks = self.preview_blocks()
    let first = blocks.at(from).or(parser::Block{})
    let last = blocks.at(to).or(parser::Block{})
    match first.StartLine <= last.StartLine {
      true => Lines{start: first.StartLine, end: last.EndLine},
      false => Lines{start: last.StartLine, end: first.EndLine},
    }
  }

  // The preview's rows: each block, then the notes whose last line it
  // holds, with the editor in place of the note it edits or after a new
  // one's block.
  private fn mut preview_items() [Item] {
    let notes = self.notes()
    let editing = self.editing.current
    let edited = match editing {
      open => open.id,
      _ => Uint64::from(0),
    }
    // Each note's block, and the blocks holding any.
    let placed = mut List::new<Int>()
    let empty: [Int: Bool] = [:]
    let holding = mut empty
    for note in notes {
      let index = self.block_of(note.EndLine)
      placed.push(index)
      holding.set(index, true)
    }
    let editor_block = match editing {
      open => {
        match self.lists(notes, edited) {
          true => -1,
          false => self.block_of(open.end),
        }
      },
      _ => -1,
    }
    let made = mut List::new<Item>()
    let none = Maybe::new<sessionbridge::Annotation>()
    for block, index in self.preview_blocks() {
      made.push(
        Item{
          kind: ItemKind::block,
          number: index,
          note: none,
        },
      )
      if holding.has(index) {
        for note, at in notes {
          if placed.at(at).or(-1) == index {
            match note.ID == edited {
              true => {
                made.push(
                  Item{
                    kind: ItemKind::editor,
                    number: index,
                    note: none,
                  },
                )
              },
              false => {
                made.push(
                  Item{
                    kind: ItemKind::note,
                    number: index,
                    note: Maybe::new(note),
                  },
                )
              },
            }
          }
        }
      }
      if editor_block == index {
        made.push(
          Item{
            kind: ItemKind::editor,
            number: index,
            note: none,
          },
        )
      }
    }
    made.@
  }

  // Whether a note or the editor follows block `index` in the preview.
  private fn followed(index: Int) Bool {
    mut found = false
    for note in self.notes() {
      found = found or self.block_of(note.EndLine) == index
    }
    match self.editing.current {
      open => found or self.block_of(open.end) == index,
      _ => found,
    }
  }

  // Extends a held preview gutter press to block `index`, within the lines
  // one annotation may cover. A block without source lines, such as a
  // rule, is passed over.
  private fn mut extend_blocks(index: Int) {
    let block = self.preview_blocks().at(index).or(parser::Block{})
    let range = self.block_lines(self.drag_block, index)
    if block.StartLine > 0 and range.end - range.start < annotations::max_lines {
      self.hovered_block = index
    }
  }

  // Ends a preview gutter press, opening the editor on the blocks it
  // covered.
  private fn mut finish_block_pick() {
    if self.drag_block >= 0 {
      let range = self.block_lines(self.drag_block, self.hovered_block)
      self.drag_block = -1
      match self.read {
        file => {
          if self.can_annotate() and not self.editing.is_open() and range.start > 0 {
            self.editing.begin(
              file.Path,
              "",
              range.start,
              range.end,
              sessionbridge::FileAnchor(
                file.Workspace.WorkspaceID,
                file.Path,
                file.Revision,
                range.start,
                range.end,
              ),
            )
          }
        },
        _ => (),
      }
    }
  }

  private fn mut block_mouse(index: Int, received: mut event::MouseEvent) {
    let kind = received.event_type
    if self.drag_block >= 0 and kind == event::MouseEventType::over {
      self.extend_blocks(index)
    } else if (kind == event::MouseEventType::move or kind == event::MouseEventType::over) and received.button == event::MouseButton::none and (not self.editing.is_open()) and self.drag_block < 0 {
      self.hovered_block = index
    } else if kind == event::MouseEventType::out and self.drag_block < 0 and self.hovered_block == index {
      self.hovered_block = -1
    }
  }

  private fn mut block_gutter_mouse(index: Int, received: mut event::MouseEvent) {
    let kind = received.event_type
    if kind == event::MouseEventType::down and received.button == event::MouseButton::left {
      let block = self.preview_blocks().at(index).or(parser::Block{})
      if self.can_annotate() and self.annotatable(block) and (not self.editing.is_open()) {
        self.drag_block = index
        self.hovered_block = index
        received.prevent_default()
      }
    } else if kind == event::MouseEventType::up or kind == event::MouseEventType::drag_end {
      self.finish_block_pick()
    }
  }

  // A block of the preview: a gutter, filled where notes cover the block
  // and offering a + on the hovered block while it can be annotated, then
  // the rendered block. The first and last blocks keep a blank row from the
  // pane's edges.
  private fn mut block_row(index: Int) cui::View {
    let colors = self.props.themes.current()
    let blocks = self.preview_blocks()
    let block = blocks.at(index).or(parser::Block{})
    let top = match index == 0 {
      true => 1,
      false => 0,
    }
    // The last row keeps the blank row: the last block's, unless notes or
    // the editor follow it.
    let bottom = match index == blocks.size() - 1 and not self.followed(index) {
      true => 1,
      false => 0,
    }
    mut annotated = false
    for note in self.notes() {
      annotated = annotated or block.StartLine > 0 and note.StartLine <= block.EndLine and note.EndLine >= block.StartLine
    }
    let picked = match {
      self.drag_block >= 0 => self.block_lines(self.drag_block, self.hovered_block),
      _ => {
        match self.editing.current {
          draft => Lines{start: draft.start, end: draft.end},
          _ => Lines{start: 0, end: 0},
        }
      },
    }
    let in_pick = block.StartLine > 0 and picked.start > 0 and block.StartLine >= picked.start and block.EndLine <= picked.end
    let offers = index == self.hovered_block and self.can_annotate() and self.annotatable(block) and (not self.editing.is_open())
    let mark = match offers {
      true => " + ",
      false => "   ",
    }
    let fill = match {
      offers or annotated => Maybe::new(colors.primary),
      _ => Maybe::new<ui::Color>(),
    }
    let base = ui::text_style(foreground: colors.foreground)
    let document = self.document.or(parser::Document{})
    let gap = match markdown::document_gap(document, index) {
      true => 1,
      false => 0,
    }
    cui::box(
      [
        // The fill starts at the block's first row, after the blank row
        // separating it from the block before.
        cui::box(
          [
            cui::box([], styles: ui::style(height: ui::cells(top + gap), flex_shrink: 0.0)),
            cui::box(
              [
                cui::text(
                  mark,
                  text_style: ui::text_style(foreground: colors.foreground),
                  wrap: ui::TextWrap::none,
                  selectable: false,
                ),
              ],
              styles: ui::style(flex_grow: 1.0, background: fill),
            ),
            cui::box([], styles: ui::style(height: ui::cells(bottom), flex_shrink: 0.0)),
          ],
          styles: ui::style(
            width: ui::cells(preview_gutter),
            flex_shrink: 0.0,
            flex_direction: ui::FlexDirection::column,
          ),
          on_mouse: fn(received: mut event::MouseEvent, context: cui::Context) {
            self.block_gutter_mouse(index, received)
          },
        ),
        cui::box(
          [
            markdown::document_block(
              self.props.themes,
              "file:{self.props.tab.id}",
              base,
              document,
              index,
              self.fence_open,
            ),
          ],
          styles: ui::style(
            flex_grow: 1.0,
            flex_shrink: 1.0,
            min_width: ui::cells(0),
            flex_direction: ui::FlexDirection::column,
            padding: ui::Edges{
              top: ui::cells(top),
              right: ui::cells(2),
              bottom: ui::cells(bottom),
              left: ui::cells(0),
            },
          ),
        ),
      ],
      styles: ui::style(
        flex_direction: ui::FlexDirection::row,
        background: match in_pick {
          true => Maybe::new(colors.surface_hovered),
          false => Maybe::new<ui::Color>(),
        },
      ),
      on_mouse: fn(received: mut event::MouseEvent, context: cui::Context) {
        self.block_mouse(index, received)
      },
    )
  }

  private fn digits() Int {
    let count = "{self.rows.size()}".size()
    match count < 3 {
      true => 3,
      false => count,
    }
  }

  // Cells left for text beside the line numbers: a cell before them, one
  // after, and the list's scrollbar at the end.
  private fn text_width() Int {
    let width = self.width - self.digits() - 3
    match width < 1 {
      true => 1,
      false => width,
    }
  }

  private fn max_column() Int {
    let most = self.widest - self.text_width()
    match most < 0 {
      true => 0,
      false => most,
    }
  }

  private fn mut scroll_columns(delta: Int) Bool {
    mut next = self.column + delta
    if next > self.max_column() {
      next = self.max_column()
    }
    if next < 0 {
      next = 0
    }
    let moved = next != self.column
    self.column = next
    moved
  }

  private fn mut mouse(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::scroll {
      mut delta = received.scroll_x
      if received.modifiers.shift {
        delta = received.scroll_y
      }
      if delta != 0 {
        let _ = self.scroll_columns(delta * column_step)
        received.prevent_default()
      }
    }
  }

  // Whether lines can be annotated: a current file loaded as it is.
  private fn can_annotate() Bool {
    match self.read {
      file => {
        self.props.annotate.is_some() and (not self.locked()) and file.Revision != "" and self.failed.is_none()
      },
      _ => false,
    }
  }

  // The annotations shown on the file as loaded.
  private fn notes() [sessionbridge::Annotation] {
    match self.read {
      file => {
        annotations::on_file(
          self.props.annotations,
          file.Workspace.WorkspaceID,
          file.Path,
          file.Revision,
        )
      },
      _ => [],
    }
  }

  // The lines being picked or annotated, or 0 to 0.
  private fn picked() Lines {
    match self.editing.current {
      draft => Lines{start: draft.start, end: draft.end},
      _ => {
        match {
          self.drag_from == 0 => Lines{start: 0, end: 0},
          self.drag_from < self.cursor => Lines{start: self.drag_from, end: self.cursor},
          _ => Lines{start: self.cursor, end: self.drag_from},
        }
      },
    }
  }

  // The virtual rows: each line, then the notes that end on it, with the
  // editor in place of the note it edits or after a new one's last line.
  private fn mut items() [Item] {
    let notes = self.notes()
    let empty: [Int: Bool] = [:]
    let ends = mut empty
    for note in notes {
      ends.set(note.EndLine, true)
    }
    let editing = self.editing.current
    let edited = match editing {
      open => open.id,
      _ => Uint64::from(0),
    }
    let made = mut List::new<Item>()
    let none = Maybe::new<sessionbridge::Annotation>()
    for number in 1..self.rows.size() {
      made.push(
        Item{
          kind: ItemKind::line,
          number: number,
          note: none,
        },
      )
      if ends.has(number) {
        for note in notes {
          if note.EndLine == number {
            match note.ID == edited {
              true => {
                made.push(
                  Item{
                    kind: ItemKind::editor,
                    number: number,
                    note: none,
                  },
                )
              },
              false => {
                made.push(
                  Item{
                    kind: ItemKind::note,
                    number: number,
                    note: Maybe::new(note),
                  },
                )
              },
            }
          }
        }
      }
      match editing {
        open => {
          // A new note, or one deleted elsewhere while it was edited.
          if open.end == number and not self.lists(notes, edited) {
            made.push(
              Item{
                kind: ItemKind::editor,
                number: number,
                note: none,
              },
            )
          }
        },
        _ => (),
      }
    }
    made.@
  }

  private fn lists(notes: [sessionbridge::Annotation], id: Uint64) Bool {
    mut found = false
    for note in notes {
      found = found or note.ID == id and note.ID != Uint64::from(0)
    }
    found
  }

  private fn mut item_view(item: Item) cui::View {
    match item.kind {
      ItemKind::line => self.row(item.number),
      ItemKind::note => {
        match item.note {
          note => self.note_view(note),
          _ => cui::box([]),
        }
      },
      ItemKind::editor => self.editor_view(),
      ItemKind::block => self.block_row(item.number),
    }
  }

  // Extends a held gutter press to line `number`, within the lines one
  // annotation may cover.
  private fn mut extend(number: Int) {
    mut next = number
    if next > self.drag_from + annotations::max_lines - 1 {
      next = self.drag_from + annotations::max_lines - 1
    }
    if next < self.drag_from - annotations::max_lines + 1 {
      next = self.drag_from - annotations::max_lines + 1
    }
    self.cursor = next
  }

  // Ends a gutter press, opening the editor on the lines it covered.
  private fn mut finish_pick() {
    if self.drag_from > 0 {
      let range = self.picked()
      self.drag_from = 0
      match self.read {
        file => {
          if self.can_annotate() and not self.editing.is_open() {
            self.editing.begin(
              file.Path,
              "",
              range.start,
              range.end,
              sessionbridge::FileAnchor(
                file.Workspace.WorkspaceID,
                file.Path,
                file.Revision,
                range.start,
                range.end,
              ),
            )
          }
        },
        _ => (),
      }
    }
  }

  private fn mut line_mouse(number: Int, received: mut event::MouseEvent) {
    let kind = received.event_type
    if kind == event::MouseEventType::down and received.button == event::MouseButton::left {
      self.cursor = number
    } else if self.drag_from > 0 and kind == event::MouseEventType::over {
      // A held press's drags go to the gutter it started in; the lines it
      // crosses learn of it as the pointer enters them.
      self.extend(number)
    } else if kind == event::MouseEventType::move and received.button == event::MouseButton::none and (not self.editing.is_open()) and self.drag_from == 0 {
      self.cursor = number
    }
  }

  private fn mut gutter_mouse(number: Int, received: mut event::MouseEvent) {
    let kind = received.event_type
    if kind == event::MouseEventType::down and received.button == event::MouseButton::left {
      if self.can_annotate() and not self.editing.is_open() {
        self.drag_from = number
        self.cursor = number
        received.prevent_default()
      }
    } else if kind == event::MouseEventType::up or kind == event::MouseEventType::drag_end {
      self.finish_pick()
    }
  }

  // The gutter: the line number between a cell either side, filled like
  // the + on annotated lines. The cursor line offers a + over its last three
  // cells while lines can be annotated.
  private fn mut gutter(number: Int, annotated: Bool, current: Bool) cui::View {
    let colors = self.props.themes.current()
    let label = "{number}"
    let padded = " {strings::Repeat(" ", self.digits() - label.size())}{label} "
    let style = match {
      annotated => ui::span_style(foreground: colors.foreground, background: colors.primary),
      current => ui::span_style(foreground: colors.foreground),
      _ => ui::span_style(foreground: colors.muted),
    }
    let offers = current and self.can_annotate() and (not self.editing.is_open())
    let spans = match offers {
      true => {
        [
          ui::span(padded.slice(0, padded.size() - 3).or(""), style: style),
          ui::span(" + ", style: ui::span_style(foreground: colors.foreground, background: colors.primary)),
        ]
      },
      false => [ui::span(padded, style: style)],
    }
    cui::box(
      [cui::text(ui::styled_text(spans), wrap: ui::TextWrap::none, selectable: false)],
      styles: ui::style(flex_shrink: 0.0),
      on_mouse: fn(received: mut event::MouseEvent, context: cui::Context) {
        self.gutter_mouse(number, received)
      },
    )
  }

  private fn mut row(number: Int) cui::View {
    let colors = self.props.themes.current()
    let segments = self.rows.at(number - 1).or([])
    let spans = mut List::new<ui::Span>()
    for segment in visible(segments, self.column, self.text_width()) {
      let foreground = match segment.role == "" {
        true => Maybe::new<ui::Color>(),
        false => Maybe::new(colors.syntax(segment.role)),
      }
      spans.push(ui::span(segment.text, style: ui::span_style(foreground: foreground)))
    }
    mut annotated = false
    for note in self.notes() {
      annotated = annotated or number >= note.StartLine and number <= note.EndLine
    }
    let range = self.picked()
    let current = number == self.cursor
    let background = match {
      number >= range.start and number <= range.end => Maybe::new(colors.surface_hovered),
      current => Maybe::new(colors.surface_pressed),
      _ => Maybe::new<ui::Color>(),
    }
    cui::box(
      // The list's scrollbar column ends the row.
      [
        self.gutter(number, annotated, current),
        cui::text(
          ui::styled_text(spans.@),
          styles: ui::style(flex_grow: 1.0),
          text_style: ui::text_style(foreground: colors.foreground),
          wrap: ui::TextWrap::none,
          selectable: true,
          selection_style: theme::selection_style(colors),
        ),
      ],
      styles: ui::style(
        height: ui::cells(1),
        flex_direction: ui::FlexDirection::row,
        background: background,
      ),
      on_mouse: fn(received: mut event::MouseEvent, context: cui::Context) {
        self.line_mouse(number, received)
      },
    )
  }

  // The gutter notes and the editor are indented by: the line numbers', or
  // the preview's.
  private fn note_indent() Int {
    match self.showing_rendered() {
      true => preview_gutter,
      false => self.digits() + 2,
    }
  }

  private fn mut note_view(note: sessionbridge::Annotation) cui::View {
    let remove = self.props.remove_annotation
    annotations::note_row(
      self.props.themes,
      note,
      self.note_indent(),
      fn() {
        remove(note.ID)
      },
      fn() {
        self.begin_edit(note)
      },
    )
  }

  private fn mut editor_view() cui::View {
    let release = self.props.release_focus
    self.editing.view(
      self.props.themes,
      self.note_indent(),
      self.context,
      self.props.annotate,
      fn() {
        release()
      },
    )
  }

  private fn mut begin_edit(note: sessionbridge::Annotation) {
    if (not self.editing.is_open()) and self.can_annotate() {
      match self.context {
        context => {
          match self.props.annotate {
            service => self.editing.edit(note, context, service),
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Whether the file is Markdown with text to show either way.
  private fn togglable() Bool {
    is_markdown(self.props.tab.path) and self.read.is_some() and self.image.is_none()
  }

  // Whether the file shows rendered: Markdown, chosen, and within the
  // parser's budget.
  private fn showing_rendered() Bool {
    match self.document {
      document => self.rendered and self.togglable() and (not document.PlainTextFallback),
      _ => false,
    }
  }

  // Whether rendering was chosen but the file is past the parser's budget.
  private fn too_large() Bool {
    match self.document {
      document => self.rendered and self.togglable() and document.PlainTextFallback,
      _ => false,
    }
  }

  private fn mut toggle() {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          if not self.editing.is_open() {
            self.rendered = not self.rendered
          }
        })
      },
      _ => (),
    }
  }

  // The toggle between rendered Markdown and its source, named for the
  // current view. It is hidden while a note is being written on the source,
  // and for a file too large to render.
  private fn toggle_label() Str {
    match {
      (not self.togglable()) or self.editing.is_open() or self.too_large() => "",
      self.rendered => "Preview",
      _ => "Source",
    }
  }

  private fn mut header() cui::View {
    let colors = self.props.themes.current()
    let label = self.toggle_label()
    // The toggle and the gap before it.
    let toggle_width = match label == "" {
      true => 0,
      false => ui::text_width(label) + 4,
    }
    let cursor = match self.showing_rendered() {
      true => 0,
      false => self.cursor,
    }
    let right = match {
      self.locked() => "stale · frozen",
      self.image.is_some() => self.image_label,
      _ => {
        match self.read {
          file => {
            status(
              self.width - toggle_width,
              self.props.tab.path,
              cursor,
              self.rows.size(),
              Int::fit(file.Size),
            )
          },
          _ => "",
        }
      },
    }
    let parts = mut List::new<cui::View>()
    parts.push(
      cui::text(
        self.props.tab.path,
        styles: ui::style(flex_grow: 1.0, flex_shrink: 1.0),
        text_style: ui::text_style(foreground: colors.muted),
        wrap: ui::TextWrap::none,
        overflow: ui::TextOverflow::ellipsis,
      ),
    )
    if right != "" {
      parts.push(
        cui::text(
          right,
          styles: ui::style(flex_shrink: 0.0),
          text_style: ui::text_style(foreground: colors.muted),
        ),
      )
    }
    if label != "" {
      parts.push(
        controls::button(
          self.props.themes,
          label,
          keymap::simple_command("file.markdown", "Show rendered or source", fn() Bool {
            self.toggle()
            true
          }),
          variant: controls::ButtonVariant::ghost,
          compact: true,
          focusable: false,
          styles: ui::style(flex_shrink: 0.0),
        ),
      )
    }
    cui::box(
      parts.@,
      styles: ui::style(
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::row,
        gap: ui::cells(2),
        padding: ui::Edges{
          top: ui::cells(0),
          right: ui::cells(1),
          bottom: ui::cells(0),
          left: ui::cells(1),
        },
      ),
    )
  }

  // What the footer reports, or "" for no footer.
  private fn footer() Str {
    match {
      self.locked() => "Frozen at its original workspace",
      self.loading and self.read.is_some() => "Refreshing…",
      _ => {
        match self.failed {
          reason => {
            match self.read.is_some() {
              true => "{reason.title}; showing what loaded before",
              false => "",
            }
          },
          _ => {
            match self.read {
              file => {
                let notes = mut List::new<Str>()
                if self.too_large() {
                  notes.push("Too large to render; showing source")
                }
                if file.Truncated {
                  notes.push(
                    "Preview truncated ({strings::ReplaceAll(file.TruncationReason, "_", " ")})",
                  )
                }
                strings::Join(notes, " · ")
              },
              _ => "",
            }
          },
        }
      },
    }
  }

  private fn message(title: Str, detail: Str) cui::View {
    let colors = self.props.themes.current()
    let children = mut List::new<cui::View>()
    children.push(cui::text(title, text_style: ui::text_style(foreground: colors.foreground)))
    if detail != "" {
      children.push(cui::text(detail, text_style: ui::text_style(foreground: colors.muted)))
    }
    cui::box(
      children.@,
      styles: ui::style(
        flex_grow: 1.0,
        flex_basis: ui::cells(0),
        flex_direction: ui::FlexDirection::column,
        padding: ui::Edges{
          top: ui::cells(1),
          right: ui::cells(1),
          bottom: ui::cells(0),
          left: ui::cells(1),
        },
      ),
    )
  }

  private fn mut body() cui::View {
    match {
      self.image.is_some() => self.image_view(self.image.expect("the image")),
      self.showing_rendered() => self.rendered_view(),
      _ => self.lines_view(),
    }
  }

  // The file's Markdown, rendered a block per row so a long file builds
  // only the blocks in view. The first and last rows keep a blank row from
  // the edges, and every row two cells from the sides, as the transcript
  // keeps its messages.
  private fn mut rendered_view() cui::View {
    let count = self.preview_blocks().size()
    match {
      self.rows.size() == 0 => self.message("Empty file", "0 bytes"),
      count == 0 => self.message("Nothing to render", "The file has no Markdown content to show."),
      _ => {
        cui::virtual_list(
          self.preview_items(),
          fn(item: Item) Str {
            match item.kind {
              ItemKind::block => "block:{item.number}",
              ItemKind::note => "note:{item.note.or(sessionbridge::Annotation{}).ID}",
              _ => "editor",
            }
          },
          fn(item: Item) cui::View {
            self.item_view(item)
          },
          estimated_height: 2,
          key: "file-blocks",
          styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0)),
          ref: self.blocks,
        )
      },
    }
  }

  // A host image, fitted to the pane and centred in it.
  private fn image_view(image: ui::ImageData) cui::View {
    let cells = image_cells(image.width, image.height, self.width, self.height)
    cui::box(
      [
        cui::image(
          image,
          "host-file:{self.props.tab.path}",
          styles: ui::style(
            width: ui::cells(cells.columns),
            height: ui::cells(cells.rows),
            flex_shrink: 0.0,
          ),
        ),
      ],
      styles: ui::style(
        flex_grow: 1.0,
        flex_basis: ui::cells(0),
        align_items: ui::Align::center,
        justify_content: ui::Justify::center,
      ),
    )
  }

  private fn mut lines_view() cui::View {
    match self.read {
      file => {
        match self.rows.size() == 0 {
          true => self.message("Empty file", "0 bytes"),
          false => {
            cui::virtual_list(
              self.items(),
              fn(item: Item) Str {
                match item.kind {
                  ItemKind::line => "{item.number}",
                  ItemKind::note => "note:{item.note.or(sessionbridge::Annotation{}).ID}",
                  _ => "editor",
                }
              },
              fn(item: Item) cui::View {
                self.item_view(item)
              },
              estimated_height: 1,
              key: "file-lines",
              styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0)),
              ref: self.list,
              on_mouse: fn(received: mut event::MouseEvent, context: cui::Context) {
                self.mouse(received)
              },
            )
          },
        }
      },
      _ => {
        match self.failed {
          reason => self.message(reason.title, reason.detail),
          _ => {
            match self.locked() {
              true => self.message("Stale workspace", "This tab is frozen at its original workspace."),
              false => self.message("Loading file…", ""),
            }
          },
        }
      },
    }
  }
}

impl cui::Component for Pane {
  fn mut render() cui::View {
    self.sync()
    let colors = self.props.themes.current()
    let children = mut List::new<cui::View>()
    children.push(self.header())
    children.push(layout::divider(colors.border))
    children.push(
      cui::box(
        [self.body()],
        ref: self.frame,
        styles: ui::style(
          flex_grow: 1.0,
          flex_basis: ui::cells(0),
          flex_direction: ui::FlexDirection::column,
          overflow: ui::Overflow::hidden,
        ),
      ),
    )
    // A footer only reports; without news it is gone.
    let report = self.footer()
    if report != "" {
      children.push(layout::divider(colors.border))
      children.push(layout::line(report, ui::text_style(foreground: colors.muted)))
    }
    cui::box(
      children.@,
      styles: ui::style(
        flex_grow: 1.0,
        flex_basis: ui::cells(0),
        flex_direction: ui::FlexDirection::column,
      ),
    )
  }
}

private fn segments(parts: [Str]) [Segment] {
  let made = mut List::new<Segment>()
  for part in parts {
    made.push(Segment{text: part, role: ""})
  }
  made.@
}

private fn texts(row: [Segment]) Str {
  mut joined = ""
  for segment in row {
    joined = "{joined}[{segment.text}]"
  }
  joined
}

test fn source_splits_into_lines_of_segments() Void!Str {
  let split = lines(code::plain(code::source_request("", "notes.txt", "one\ntwo\n\nfour\n")))
  try testing::assert(split.size() == 4, "a final newline ends the last line: {split.size()}")
  try testing::assert(texts(split.at(1).or([])) == "[two]", "each line keeps its text")
  testing::assert(split.at(2).or([]).size() == 0, "an empty line has no segments")
}

test fn visible_text_starts_at_the_column_within_the_width() Void!Str {
  let row = segments(["func ", "main", "() {{"])
  try testing::assert(texts(visible(row, 0, 7)) == "[func ][ma]", "from the start")
  try testing::assert(texts(visible(row, 5, 20)) == "[main][() {{]", "scrolled past the first segment")
  testing::assert(
    texts(visible(segments(["界界"]), 1, 4)) == "[界]",
    "a wide character cut by the edge is left out",
  )
}

test fn sizes_use_binary_units() Void!Str {
  try testing::assert(size_label(512) == "512 B", "bytes")
  try testing::assert(size_label(9385) == "9.2 KiB", "kibibytes")
  testing::assert(size_label(2 * 1048576) == "2.0 MiB", "mebibytes")
}

test fn the_header_status_gives_way_to_the_path() Void!Str {
  try testing::assert(
    status(60, "notes.txt", 2, 3, 17) == "Ln 2 · 3 lines · 17 B",
    "room for everything",
  )
  try testing::assert(status(30, "notes.txt", 2, 3, 17) == "Ln 2 · 3 lines", "the size goes first")
  try testing::assert(status(20, "notes.txt", 2, 3, 17) == "Ln 2", "then the count")
  try testing::assert(
    status(60, "README.md", 0, 3, 17) == "3 lines · 17 B",
    "rendered, without a cursor",
  )
  try testing::assert(status(24, "README.md", 0, 3, 17) == "3 lines", "rendered, the size goes first")
  testing::assert(status(12, "README.md", 0, 3, 17) == "", "then the count")
}
