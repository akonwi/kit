use cooper/cui
use cooper/keymap
use go:github.com/akonwi/kit/internal/protocol
use kit/tui/palette
use kit/tui/theme
use go:strings

// Props is the snapshot-backed MCP status projection shown in the picker.
struct Props {
  themes: theme::Context,
  servers: [protocol::MCPServerStatus],
  warnings: [Str],
  dismiss: keymap::SimpleCommand,
}

struct Status {
  props: Props,
  query: Str,
  selection: Str,
  hover: Str,
  hidden_above: Bool,
  hidden_below: Bool,
  viewport: Int,
  list: mut cui::VirtualListRef,
}

fn new(props: mut Props) mut Status {
  (mut Status{
    props: props.@,
    query: "",
    selection: "",
    hover: "",
    hidden_above: false,
    hidden_below: false,
    viewport: 0,
    list: cui::virtual_list_ref(),
  })
}

private fn status_label(state: Str) Str {
  match state {
    "configured" => "available",
    "error" => "failed",
    _ => state,
  }
}

// source_label keeps configuration provenance concise in the picker metadata column.
private fn source_label(source: Str) Str {
  match source {
    "kit-user" => "global",
    "shared-project" => "project",
    "kit-project" => "project",
    _ => source,
  }
}

private fn catalog(servers: [protocol::MCPServerStatus]) [palette::Item] {
  let result = mut List::new<palette::Item>()
  for server in servers {
    let tools = match server.ToolCount == 1 {
      true => "tool",
      false => "tools",
    }
    result.push(
      palette::Item{
        key: server.Name,
        label: server.Name,
        hint: "",
        meta: source_label(server.Source),
        description: "{status_label(server.State)} · {strings::ToUpper(server.Transport)} · {server.ToolCount} {tools}",
        search_terms: [server.Transport, server.Source, server.Description, server.State],
        disabled_reason: "",
      },
    )
  }
  result.@
}

impl Status {
  private fn mut picker(catalog: [palette::Item]) palette::Props {
    palette::Props{
      // Status remains read-only. Enter is intentionally harmless while rows
      // remain keyboard-navigable and filterable like other palette pickers.
      themes: self.props.themes,
      placeholder: "Search MCP servers…",
      catalog: catalog,
      query: self.query,
      filter_query: "",
      selection: self.selection,
      hovered: self.hover,
      hidden_above: self.hidden_above,
      hidden_below: self.hidden_below,
      on_query_change: fn(query: Str) {
        self.query = query
        self.hover = ""
        let next = palette::first_enabled(
          palette::items(
            palette::Props{
              themes: self.props.themes,
              placeholder: "",
              catalog: catalog,
              query: query,
              filter_query: "",
              selection: "",
              hovered: "",
              hidden_above: false,
              hidden_below: false,
              on_query_change: fn(value: Str) {},
              on_selection_change: fn(value: Str) {},
              on_hover_change: fn(value: Str) {},
              on_activate: fn(item: palette::Item) {},
            },
          ),
        )
        if next != "" {
          self.selection = next
        }
      },
      on_selection_change: fn(selection: Str) {
        self.selection = selection
      },
      on_hover_change: fn(hover: Str) {
        self.hover = hover
      },
      on_activate: fn(item: palette::Item) {},
    }
  }

  private fn mut picker_viewport(catalog: [palette::Item]) palette::Viewport {
    palette::Viewport{
      list: self.list,
      on_update: fn(update: cui::VirtualListUpdate, ctx: cui::Context) {
        let visible = palette::items(self.picker(catalog))
        self.hidden_above = update.state.visible_range.start > 0
        self.hidden_below = update.state.visible_range.end < visible.size()
        self.viewport = update.state.viewport_height
      },
      on_page: fn(direction: Int) {
        let step = match self.viewport > 1 {
          true => self.viewport - 1,
          false => 1,
        }
        let _ = self.list.current.map(fn(list) {
          list.scroll_by(direction * step)
        })
      },
    }
  }
}

impl cui::Component for Status {
  fn mut render() cui::View {
    cui::child(
      palette::new_picker,
      palette::PickerProps{
        themes: self.props.themes,
        catalog: catalog(self.props.servers),
        placeholder: "Search MCP servers…",
        initial_selection: "",
        title: "",
        footer: "",
        dismiss: self.props.dismiss,
        override: Maybe::new<fn(Str)>(),
        on_activate: fn(item: palette::Item) {},
      },
    )
  }
}
