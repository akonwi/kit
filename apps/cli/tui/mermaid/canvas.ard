use ard/testing

use cooper/ui
use go:strings

// A character grid that Mermaid layouts draw on. Line cells record the
// directions they connect, so crossings and junctions resolve to the matching
// box-drawing character no matter the drawing order; text replaces lines.

// What a cell depicts, which the view maps to theme colors.
enum Role {
  // Participant boxes, lifelines, and block frames.
  // Message lines and arrowheads.
  // Participant names.
  // Message text.
  // Note boxes and their text.
  // Block keywords such as `loop` and `alt`.
  // Block conditions.
  frame,
  arrow,
  name,
  label,
  note,
  keyword,
  condition,
  title,
}

let up = 1
let right = 2
let down = 4
let left = 8

// A cell's lines, styles, and role are packed into one number, since a
// drawing can hold a few hundred thousand cells: the low four bits are the
// directions its line connects, then a bit for each style, then its role.
let mask_bits = 16
let dashed_bit = 16
let heavy_bit = 32
let rounded_bit = 64
let covered_bit = 128
let bold_bit = 256
let role_unit = 512

struct Canvas {
  width: Int,
  height: Int,
  // The text a cell shows, where empty is blank. Line cells show their
  // mask's glyph, and a wide character's trailing cells are skipped.
  texts: [Str],
  // Each cell's line directions, styles, and role, packed.
  cells: [Int],
}

// A blank canvas. Its cells start empty in a single allocation each.
fn new(width: Int, height: Int) mut Canvas {
  let size = maximum(width * height, 0)
  (mut Canvas{
    width: width,
    height: height,
    texts: List::new<Str>(size),
    cells: List::new<Int>(size),
  })
}

private fn maximum(a: Int, b: Int) Int {
  match a > b {
    true => a,
    false => b,
  }
}

private fn role_code(role: Role) Int {
  match role {
    Role::frame => 0,
    Role::arrow => 1,
    Role::name => 2,
    Role::label => 3,
    Role::note => 4,
    Role::keyword => 5,
    Role::condition => 6,
    Role::title => 7,
  }
}

private fn role_of(code: Int) Role {
  match code {
    1 => Role::arrow,
    2 => Role::name,
    3 => Role::label,
    4 => Role::note,
    5 => Role::keyword,
    6 => Role::condition,
    7 => Role::title,
    _ => Role::frame,
  }
}

// Whether the style bit flag is set in cell.
private fn flagged(cell: Int, flag: Int) Bool {
  cell / flag % 2 == 1
}

// flag set in cell when on, else cleared.
private fn flag(cell: Int, flag: Int, on: Bool) Int {
  let cleared = match flagged(cell, flag) {
    true => cell - flag,
    false => cell,
  }
  match on {
    true => cleared + flag,
    false => cleared,
  }
}

private fn has(mask: Int, bit: Int) Bool {
  mask / bit % 2 == 1
}

private fn with(mask: Int, bit: Int) Int {
  match has(mask, bit) {
    true => mask,
    false => mask + bit,
  }
}

// The box-drawing character for a set of connected directions.
fn glyph(mask: Int, dashed: Bool, rounded: Bool, heavy: Bool) Str {
  let vertical = mask == up or mask == down or mask == up + down
  let horizontal = mask == left or mask == right or mask == left + right
  match {
    heavy and vertical => "┃",
    heavy and horizontal => "━",
    dashed and vertical => "┊",
    dashed and horizontal => "┈",
    vertical => "│",
    horizontal => "─",
    heavy and mask == right + down => "┏",
    heavy and mask == left + down => "┓",
    heavy and mask == up + right => "┗",
    heavy and mask == up + left => "┛",
    heavy and mask == up + right + down => "┣",
    heavy and mask == up + left + down => "┫",
    heavy and mask == left + right + down => "┳",
    heavy and mask == up + left + right => "┻",
    heavy and mask == up + right + down + left => "╋",
    mask == right + down => {
      match rounded {
        true => "╭",
        false => "┌",
      }
    },
    mask == left + down => {
      match rounded {
        true => "╮",
        false => "┐",
      }
    },
    mask == up + right => {
      match rounded {
        true => "╰",
        false => "└",
      }
    },
    mask == up + left => {
      match rounded {
        true => "╯",
        false => "┘",
      }
    },
    mask == up + right + down => "├",
    mask == up + left + down => "┤",
    mask == left + right + down => "┬",
    mask == up + left + right => "┴",
    mask == up + right + down + left => "┼",
    _ => " ",
  }
}

impl Canvas {
  private fn inside(x: Int, y: Int) Bool {
    x >= 0 and y >= 0 and x < self.width and y < self.height
  }

  // Adds the bits of mask to the line at x, y. A text cell is left alone.
  fn mut connect(x: Int, y: Int, mask: Int, role: Role, dashed: Bool, rounded: Bool) {
    self.connect_styled(x, y, mask, role, dashed, rounded, false)
  }

  // connect with a heavy line, which stays heavy only where every line
  // through the cell is heavy.
  fn mut connect_styled(
    x: Int,
    y: Int,
    mask: Int,
    role: Role,
    dashed: Bool,
    rounded: Bool,
    heavy: Bool,
  ) {
    if self.inside(x, y) {
      let index = y * self.width + x
      let cell = self.cells.at(index).or(0)
      let lines = cell % mask_bits
      let fresh = lines == 0
      let text = self.texts.at(index).or("")
      if (not fresh) or text == "" or text == " " {
        mut next = lines
        for bit in [up, right, down, left] {
          if has(mask, bit) {
            next = with(next, bit)
          }
        }
        // Keep whether the cell is covered or bold; replace the rest.
        mut packed = next + role_code(role) * role_unit
        packed = flag(packed, covered_bit, flagged(cell, covered_bit))
        packed = flag(packed, bold_bit, flagged(cell, bold_bit))
        packed = flag(packed, dashed_bit, dashed and (fresh or flagged(cell, dashed_bit)))
        packed = flag(packed, heavy_bit, heavy and (fresh or flagged(cell, heavy_bit)))
        packed = flag(packed, rounded_bit, rounded and (fresh or flagged(cell, rounded_bit)))
        self.cells.set(index, packed)
      }
    }
  }

  // Draws a horizontal line from x0 to x1 on row y.
  fn mut horizontal(y: Int, x0: Int, x1: Int, role: Role, dashed: Bool) {
    self.horizontal_styled(y, x0, x1, role, dashed, false)
  }

  fn mut horizontal_styled(y: Int, x0: Int, x1: Int, role: Role, dashed: Bool, heavy: Bool) {
    mut x = x0
    while x <= x1 {
      mut mask = 0
      if x > x0 {
        mask =+ left
      }
      if x < x1 {
        mask =+ right
      }
      if mask == 0 {
        mask = left + right
      }
      self.connect_styled(x, y, mask, role, dashed, false, heavy)
      x =+ 1
    }
  }

  // Draws a vertical line from y0 to y1 in column x.
  fn mut vertical(x: Int, y0: Int, y1: Int, role: Role, dashed: Bool) {
    self.vertical_styled(x, y0, y1, role, dashed, false)
  }

  fn mut vertical_styled(x: Int, y0: Int, y1: Int, role: Role, dashed: Bool, heavy: Bool) {
    mut y = y0
    while y <= y1 {
      mut mask = 0
      if y > y0 {
        mask =+ up
      }
      if y < y1 {
        mask =+ down
      }
      if mask == 0 {
        mask = up + down
      }
      self.connect_styled(x, y, mask, role, dashed, false, heavy)
      y =+ 1
    }
  }

  // Draws a box's outline with the given corners.
  fn mut outline(x0: Int, y0: Int, x1: Int, y1: Int, role: Role, rounded: Bool) {
    self.horizontal(y0, x0, x1, role, false)
    self.horizontal(y1, x0, x1, role, false)
    self.vertical(x0, y0, y1, role, false)
    self.vertical(x1, y0, y1, role, false)
    for corner in [[x0, y0], [x1, y0], [x0, y1], [x1, y1]] {
      let x = corner.at(0).or(0)
      let y = corner.at(1).or(0)
      if self.inside(x, y) {
        let index = y * self.width + x
        self.cells.set(index, flag(self.cells.at(index).or(0), rounded_bit, rounded))
      }
    }
  }

  // Writes value from x on row y, replacing what was drawn there. A wide
  // character covers the cells after it; text past the right edge is cut.
  fn mut write(x: Int, y: Int, value: Str, role: Role, bold: Bool) {
    mut column = x
    for part in ui::graphemes(value) {
      if part.width > 0 and column + part.width <= self.width {
        self.put(column, y, part.text, role, bold)
        mut covered = 1
        while covered < part.width {
          self.put(column + covered, y, "", role, bold)
          let index = y * self.width + column + covered
          self.cells.set(index, flag(self.cells.at(index).or(0), covered_bit, true))
          covered =+ 1
        }
      }
      column =+ part.width
    }
  }

  private fn mut put(x: Int, y: Int, value: Str, role: Role, bold: Bool) {
    if self.inside(x, y) {
      let index = y * self.width + x
      // Replacing half of a wide character blanks its other half.
      if flagged(self.cells.at(index).or(0), covered_bit) and x > 0 {
        self.texts.set(index - 1, " ")
      }
      if x + 1 < self.width and flagged(self.cells.at(index + 1).or(0), covered_bit) {
        self.texts.set(index + 1, " ")
        self.cells.set(index + 1, flag(self.cells.at(index + 1).or(0), covered_bit, false))
      }
      self.texts.set(index, value)
      self.cells.set(index, flag(role_code(role) * role_unit, bold_bit, bold))
    }
  }

  // The character shown at a cell; empty for a wide character's trailing half.
  fn shown(x: Int, y: Int) Str {
    let index = y * self.width + x
    let cell = self.cells.at(index).or(0)
    let mask = cell % mask_bits
    match {
      flagged(cell, covered_bit) => "",
      mask > 0 => {
        glyph(mask, flagged(cell, dashed_bit), flagged(cell, rounded_bit), flagged(cell, heavy_bit))
      },
      _ => {
        let text = self.texts.at(index).or("")
        match text == "" {
          true => " ",
          false => text,
        }
      },
    }
  }

  fn role(x: Int, y: Int) Role {
    role_of(self.cells.at(y * self.width + x).or(0) / role_unit)
  }

  fn is_bold(x: Int, y: Int) Bool {
    flagged(self.cells.at(y * self.width + x).or(0), bold_bit)
  }

  // Whether a cell shows nothing, so a run of them needs no style.
  fn blank(x: Int, y: Int) Bool {
    self.shown(x, y) == " "
  }

  // The drawing as plain rows, with trailing spaces removed.
  fn lines() [Str] {
    let rows = mut List::new<Str>()
    mut y = 0
    while y < self.height {
      let row = mut List::new<Str>()
      mut x = 0
      while x < self.width {
        row.push(self.shown(x, y))
        x =+ 1
      }
      rows.push(strings::TrimRight(strings::Join(row, ""), " "))
      y =+ 1
    }
    rows.@
  }
}

test fn crossing_lines_resolve_to_junctions() Void!Str {
  let canvas = new(5, 3)
  canvas.vertical(2, 0, 2, Role::frame, false)
  canvas.horizontal(1, 0, 4, Role::arrow, false)
  canvas.outline(0, 0, 4, 2, Role::frame, false)
  let rows = canvas.lines()
  let shown = strings::Join(mut rows, "|")
  testing::assert(shown == "┌─┬─┐|├─┼─┤|└─┴─┘", "got {shown}")
}

test fn dashed_lines_stay_dashed_only_when_straight() Void!Str {
  let canvas = new(5, 3)
  canvas.horizontal(1, 0, 4, Role::arrow, true)
  canvas.vertical(2, 0, 2, Role::frame, false)
  let rows = canvas.lines()
  let shown = strings::Join(mut rows, "|")
  testing::assert(shown == "  │|┈┈┼┈┈|  │", "got {shown}")
}

test fn rounded_outline_keeps_rounded_corners() Void!Str {
  let canvas = new(4, 3)
  canvas.outline(0, 0, 3, 2, Role::frame, true)
  let rows = canvas.lines()
  let shown = strings::Join(mut rows, "|")
  testing::assert(shown == "╭──╮|│  │|╰──╯", "got {shown}")
}

test fn text_replaces_lines_and_wide_characters_cover_two_cells() Void!Str {
  let canvas = new(6, 1)
  canvas.horizontal(0, 0, 5, Role::arrow, false)
  canvas.write(1, 0, "你a", Role::label, false)
  canvas.connect(2, 0, left + right, Role::arrow, false, false)
  let rows = canvas.lines()
  let shown = strings::Join(mut rows, "|")
  try testing::assert(shown == "─你a──", "got {shown}")
  testing::assert(canvas.shown(2, 0) == "", "trailing half of a wide character shows nothing")
}

test fn writing_over_half_a_wide_character_blanks_the_other_half() Void!Str {
  let canvas = new(4, 1)
  canvas.write(0, 0, "你", Role::label, false)
  canvas.write(1, 0, "a", Role::label, false)
  canvas.write(2, 0, "好", Role::label, false)
  canvas.write(2, 0, "b", Role::label, false)
  let rows = canvas.lines()
  let shown = strings::Join(mut rows, "|")
  testing::assert(shown == " ab", "got {shown}|")
}

// Heavy lines meet in heavy corners; where a light line crosses, the
// junction is light.
test fn heavy_lines_join_heavily_only_with_heavy_lines() Void!Str {
  let canvas = new(5, 3)
  canvas.horizontal_styled(1, 0, 4, Role::arrow, false, true)
  canvas.vertical(2, 0, 2, Role::frame, false)
  canvas.vertical_styled(4, 0, 1, Role::arrow, false, true)
  let rows = canvas.lines()
  let shown = strings::Join(mut rows, "|")
  testing::assert(shown == "  │ ┃|━━┼━┛|  │", "got {shown}")
}
