use ard/testing

use cooper/ui
use kit/tui/mermaid/canvas
use kit/tui/mermaid/layers
use go:strings

// Mermaid flowcharts: a reviewed subset parsed into a graph and drawn with
// the layered layout.
//
// Supported: `flowchart` or `graph` flowing down (`TD` or `TB`), up
// (`BT`), right (`LR`), or left (`RL`); nodes
// written as an id or with text in a box `[]`, round `()`, stadium `([])`,
// circle `(())`, database `[()]`, or decision `{}` shape; solid `-->`,
// dotted `-.->`, and thick `==>` links of any length, ending in an arrow,
// a cross `x`, a circle `o`, or nothing; link text as `-->|text|` or
// `-- text -->`; chains such as `A --> B --> C`; `&` groups such as
// `A & B --> C`; `;` between statements; and `:::class` suffixes. Edges may
// loop back, including from a node to itself.
// `classDef`, `class`, `style`, `linkStyle`, and `click` statements are
// accepted without being drawn. Anything else is rejected so the source is
// shown instead.

let max_nodes = 60
let max_edges = 120
let max_statements = 200
// Node text wider than this is cut short with an ellipsis.
let max_text = 40

struct Flowchart {
  nodes: [layers::Node],
  edges: [layers::Edge],
  flow: layers::Flow,
}

// Text as one line, cut to max_text cells.
fn clean(value: Str) Str {
  mut text = value
  for brk in ["<br/>", "<br />", "<br>", "<BR>", "<BR/>"] {
    text = strings::ReplaceAll(text, brk, " ")
  }
  text = strings::TrimSpace(strings::ReplaceAll(text, "\t", " "))
  match ui::text_width(text) <= max_text {
    true => text,
    false => {
      let kept = mut List::new<Str>()
      mut width = 0
      for part in ui::graphemes(text) {
        if width + part.width <= max_text - 1 {
          kept.push(part.text)
          width =+ part.width
        }
      }
      strings::Join(kept, "") + "…"
    },
  }
}

// Link text as one line, without the quotes it may be written in.
private fn label_text(value: Str) Str {
  let text = strings::TrimSpace(value)
  let quoted = text.size() >= 2 and strings::HasPrefix(text, "\"") and strings::HasSuffix(text, "\"")
  match quoted {
    true => clean(text.slice(start: 1, end: text.size() - 1).or("")),
    false => clean(text),
  }
}

// Whether a link starts anywhere in line outside quoted text.
private fn has_link(line: Str) Bool {
  mut found = false
  mut quoted = false
  mut index = 0
  while index < line.size() {
    if char_at(line, index) == "\"" {
      quoted = not quoted
    }
    if (not quoted) and link_starts(line, index) {
      found = true
    }
    index =+ 1
  }
  found
}

// Fails with reason unless ok.
private fn within(ok: Bool, reason: Str) Void!Str {
  match ok {
    true => Result::ok(()),
    false => Result::err(reason),
  }
}

// Whether edges already holds an edge just like edge.
private fn has_edge(edges: [layers::Edge], edge: layers::Edge) Bool {
  mut found = false
  for other in edges {
    if other.from == edge.from and other.to == edge.to and other.stroke == edge.stroke and other.head == edge.head and other.label == edge.label {
      found = true
    }
  }
  found
}

private fn char_at(line: Str, index: Int) Str {
  line.slice(start: index, end: index + 1).or("")
}

// Whether a link starts at index.
private fn link_starts(line: Str, index: Int) Bool {
  let current = char_at(line, index)
  let next = char_at(line, index + 1)
  current == "-" and (next == "-" or next == ".") or current == "=" and next == "=" or current == "~" and next == "~" or current == "<" and (next == "-" or next == "=")
}

private fn skip_space(line: Str, index: Int) Int {
  mut at = index
  mut going = at < line.size()
  while going {
    let current = char_at(line, at)
    going = current == " " or current == "\t"
    if going {
      at =+ 1
      going = at < line.size()
    }
  }
  at
}

// The end of the name that starts at index: up to whitespace, punctuation
// that opens a shape or separates statements, or the start of a link.
private fn name_end(line: Str, index: Int) Int {
  mut at = index
  mut going = at < line.size()
  while going {
    let current = char_at(line, at)
    going = (not strings::ContainsAny(current, " \t[](){{}}<>&;|\":")) and not link_starts(line, at)
    if going {
      at =+ 1
      going = at < line.size()
    }
  }
  at
}

// Where the scanner is after reading part of a statement.
private struct Scan {
  next: Int,
  // The node indexes of a group.
  nodes: [Int],
  // A link's stroke, head, and label.
  link: Link,
}

private struct Link {
  stroke: layers::Stroke,
  head: layers::Head,
  label: Str,
}

private fn no_link() Link {
  Link{
    stroke: layers::Stroke::solid,
    head: layers::Head::none,
    label: "",
  }
}

// The end of the run of chars characters starting at index.
private fn run_of(line: Str, index: Int, chars: Str) Int {
  mut at = index
  mut going = true
  while going {
    let current = char_at(line, at)
    going = current != "" and strings::ContainsAny(current, chars)
    if going {
      at =+ 1
    }
  }
  at
}

// The end of the link token starting at index: its line, then a head.
private fn link_end(line: Str, index: Int) Int {
  let end = run_of(line, index, "-=.~<")
  let next = char_at(line, end)
  match next != "" and strings::ContainsAny(next, ">xo") {
    true => end + 1,
    false => end,
  }
}

// The stroke and head of a whole link token such as `-->`, `-.-`, or `==>`.
// Longer links, with more of their line characters, mean the same.
private fn classify(token: Str) Link!Str {
  let last = token.slice(start: token.size() - 1).or("")
  let head = match last {
    ">" => layers::Head::arrow,
    "x" => layers::Head::cross,
    "o" => layers::Head::circle,
    _ => layers::Head::none,
  }
  let line = match head == layers::Head::none {
    true => token,
    false => token.slice(end: token.size() - 1).or(""),
  }
  let headed = head != layers::Head::none
  let dashes = line.size() >= 2 and strings::Trim(line, "-") == ""
  let equals = line.size() >= 2 and strings::Trim(line, "=") == ""
  // `-.-` and `-..-`, with or without a head.
  let inner = line.slice(start: 1, end: line.size() - 1).or("")
  let dotted = line.size() >= 3 and strings::HasPrefix(line, "-") and strings::HasSuffix(line, "-") and inner != "" and strings::Trim(inner, ".") == ""
  match {
    dashes and (headed or line.size() >= 3) => {
      Result::ok(
        Link{
          stroke: layers::Stroke::solid,
          head: head,
          label: "",
        },
      )
    },
    equals and (headed or line.size() >= 3) => {
      Result::ok(
        Link{
          stroke: layers::Stroke::thick,
          head: head,
          label: "",
        },
      )
    },
    dotted => {
      Result::ok(
        Link{
          stroke: layers::Stroke::dotted,
          head: head,
          label: "",
        },
      )
    },
    _ => Result::err("`{token}` links aren't drawn yet"),
  }
}

private struct Parser {
  nodes: [layers::Node],
  indexes: [Str: Int],
  edges: [layers::Edge],
  // Statements read so far, counting each one between `;`s.
  statements: Int,
}

impl Parser {
  // The index of node id, declaring it on first use. Text, when given,
  // replaces the node's text.
  fn mut node(id: Str, text: Str?, shape: layers::Shape) Int {
    let index = match self.indexes.get(id) {
      found => found,
      _ => {
        let added = self.nodes.size()
        self.nodes.push(
          layers::Node{
            id: id,
            text: clean(id),
            shape: layers::Shape::box,
          },
        )
        self.indexes.set(id, added)
        added
      },
    }
    match text {
      given => {
        let _ = self.nodes.set(
          index,
          layers::Node{
            id: id,
            text: clean(given),
            shape: shape,
          },
        )
        ()
      },
      _ => (),
    }
    index
  }

  // One node: an id, then optionally a shape with text and a class suffix.
  fn mut one(line: Str, start: Int) Scan!Str {
    let end = name_end(line, start)
    let id = line.slice(start: start, end: end).or("")
    mut at = end
    mut text = Maybe::new<Str>()
    mut shape = layers::Shape::box
    mut failure = ""
    let rest = line.slice(start: at).or("")
    // The opening and closing of each supported shape, longest first.
    let opened = match {
      strings::HasPrefix(rest, "(((") => Maybe::new<Str>(),
      strings::HasPrefix(rest, "((") => Maybe::new("(("),
      strings::HasPrefix(rest, "([") => Maybe::new("(["),
      strings::HasPrefix(rest, "(") => Maybe::new("("),
      strings::HasPrefix(rest, "[(") => Maybe::new("[("),
      strings::HasPrefix(rest, "[[") or strings::HasPrefix(rest, "[/") or strings::HasPrefix(rest, "[\\") => {
        Maybe::new<Str>()
      },
      strings::HasPrefix(rest, "[") => Maybe::new("["),
      strings::HasPrefix(rest, "{{{{") => Maybe::new<Str>(),
      strings::HasPrefix(rest, "{{") => Maybe::new("{{"),
      _ => Maybe::new<Str>(),
    }
    let shaped = strings::ContainsAny(char_at(line, at), "[({{>")
    if id == "" {
      failure = "unsupported line `{line}`"
    } else if shaped and opened.is_none() {
      failure = "`{rest.slice(end: 2).or(rest)}` nodes aren't drawn yet"
    } else {
      match opened {
        open => {
          let close = match open {
            "((" => "))",
            "([" => "])",
            "(" => ")",
            "[(" => ")]",
            "{{" => "}}",
            _ => "]",
          }
          shape = match open {
            "((" => layers::Shape::circle,
            "([" => layers::Shape::stadium,
            "(" => layers::Shape::round,
            "[(" => layers::Shape::database,
            "{{" => layers::Shape::decision,
            _ => layers::Shape::box,
          }
          let content = at + open.size()
          let quoted = char_at(line, content) == "\""
          let closing = match quoted {
            true => {
              let quote = strings::Index(line.slice(start: content + 1).or(""), "\"")
              match quote < 0 {
                true => -1,
                false => {
                  let after = content + 1 + quote + 1
                  match strings::HasPrefix(line.slice(start: after).or(""), close) {
                    true => after,
                    false => -1,
                  }
                },
              }
            },
            false => {
              let found = strings::Index(line.slice(start: content).or(""), close)
              match found < 0 {
                true => -1,
                false => content + found,
              }
            },
          }
          match closing < 0 {
            true => { failure = "unclosed `{open}` in `{line}`" },
            false => {
              mut value = line.slice(start: content, end: closing).or("")
              if quoted {
                value = value.slice(start: 1, end: value.size() - 1).or("")
              }
              text = Maybe::new(value)
              at = closing + close.size()
            },
          }
        },
        _ => (),
      }
    }
    if failure == "" and line.slice(start: at, end: at + 3).or("") == ":::" {
      at = name_end(line, at + 3)
    }
    match failure == "" {
      true => {
        let node = self.node(id, text, shape)
        Result::ok(
          Scan{
            next: at,
            nodes: [node],
            link: no_link(),
          },
        )
      },
      false => Result::err(failure),
    }
  }

  // Nodes joined by `&`.
  fn mut group(line: Str, start: Int) Scan!Str {
    let found = mut List::new<Int>()
    mut at = skip_space(line, start)
    mut more = true
    mut failure = ""
    while more {
      match self.one(line, at) {
        ok(scan) => {
          for node in scan.nodes {
            found.push(node)
          }
          at = skip_space(line, scan.next)
          more = char_at(line, at) == "&"
          if more {
            at = skip_space(line, at + 1)
          }
          if self.nodes.size() > max_nodes {
            failure = "more than {max_nodes} nodes"
            more = false
          }
        },
        err(reason) => {
          failure = reason
          more = false
        },
      }
    }
    match failure == "" {
      true => {
        Result::ok(
          Scan{
            next: at,
            nodes: found.@,
            link: no_link(),
          },
        )
      },
      false => Result::err(failure),
    }
  }

  // A link between groups, with its text when it has one.
  fn mut link(line: Str, start: Int) Scan!Str {
    let run_end = run_of(line, start, "-=.")
    let run = line.slice(start: start, end: run_end).or("")
    let opening = run == "--" or run == "-." or run == "=="
    let spaced = char_at(line, run_end) == " "
    match opening and spaced {
      // `-- text -->`: the text runs up to the closing part of the link.
      true => {
        let closings = match run {
          "-." => [".->", ".-"],
          "==" => ["==>", "==="],
          _ => ["-->", "---", "--x", "--o"],
        }
        let rest = line.slice(start: run_end).or("")
        mut found = -1
        for closing in closings {
          let at = strings::Index(rest, closing)
          if at >= 0 and (found < 0 or at < found) {
            found = at
          }
        }
        match found < 0 {
          true => Result::err("unsupported link in `{line}`"),
          false => {
            let label = strings::TrimSpace(rest.slice(end: found).or(""))
            let close_start = run_end + found
            let close_end = link_end(line, close_start)
            let token = run + line.slice(start: close_start, end: close_end).or("")
            match classify(token) {
              ok(link) => {
                let labeled = mut link
                labeled.label = label_text(label)
                Result::ok(
                  Scan{
                    next: close_end,
                    nodes: [],
                    link: labeled.@,
                  },
                )
              },
              err(reason) => Result::err(reason),
            }
          },
        }
      },
      false => {
        let end = link_end(line, start)
        let token = line.slice(start: start, end: end).or("")
        match classify(token) {
          ok(link) => {
            // `-->|text|`, or `--> |text|`
            let bar = skip_space(line, end)
            match char_at(line, bar) == "|" {
              true => {
                let close = strings::Index(line.slice(start: bar + 1).or(""), "|")
                match close < 0 {
                  true => Result::err("unclosed `|` in `{line}`"),
                  false => {
                    let labeled = mut link
                    labeled.label = label_text(
                      line.slice(start: bar + 1, end: bar + 1 + close).or(""),
                    )
                    Result::ok(
                      Scan{
                        next: bar + 1 + close + 1,
                        nodes: [],
                        link: labeled.@,
                      },
                    )
                  },
                }
              },
              false => {
                Result::ok(
                  Scan{
                    next: end,
                    nodes: [],
                    link: link,
                  },
                )
              },
            }
          },
          err(reason) => Result::err(reason),
        }
      },
    }
  }

  // A statement: groups joined by links. Returns where it ended.
  fn mut statement(line: Str, start: Int) Int!Str {
    self.statements =+ 1
    try within(self.statements <= max_statements, "more than {max_statements} statements")
    let first = try self.group(line, start)
    mut previous = first.nodes
    mut at = skip_space(line, first.next)
    mut failure = ""
    mut going = at < line.size() and char_at(line, at) != ";"
    while going {
      match link_starts(line, at) {
        false => {
          failure = "unsupported line `{line}`"
          going = false
        },
        true => {
          match self.link(line, at) {
            ok(link) => {
              match self.group(line, link.next) {
                ok(next) => {
                  // Checked before adding, since `&` groups multiply edges.
                  match self.edges.size() + previous.size() * next.nodes.size() > max_edges {
                    true => {
                      failure = "more than {max_edges} edges"
                      going = false
                    },
                    false => {
                      for from in previous {
                        for to in next.nodes {
                          let edge = layers::Edge{
                            from: from,
                            to: to,
                            stroke: link.link.stroke,
                            head: link.link.head,
                            label: link.link.label,
                          }
                          // A repeated edge is drawn once.
                          if not has_edge(self.edges, edge) {
                            self.edges.push(edge)
                          }
                        }
                      }
                      previous = next.nodes
                      at = skip_space(line, next.next)
                      going = at < line.size() and char_at(line, at) != ";"
                    },
                  }
                },
                err(reason) => {
                  failure = reason
                  going = false
                },
              }
            },
            err(reason) => {
              failure = reason
              going = false
            },
          }
        },
      }
    }
    match failure == "" {
      true => Result::ok(at + 1),
      false => Result::err(failure),
    }
  }

  fn mut line(line: Str) Void!Str {
    let space = strings::IndexAny(line, " \t")
    // Keywords match exactly, as in Mermaid, so `End` or `Style` can name
    // a node.
    let word = match space >= 0 {
      true => line.slice(end: space).or(line),
      false => line,
    }
    match {
      // Styling is accepted without being drawn, but a link means the line
      // isn't styling.
      word == "subgraph" or word == "end" or word == "direction" => {
        Result::err("subgraphs aren't drawn yet")
      },
      word == "classDef" or word == "class" or word == "style" or word == "linkStyle" or word == "click" => {
        match has_link(line) {
          true => Result::err("unsupported line `{line}`"),
          false => Result::ok(()),
        }
      },
      _ => {
        mut at = 0
        mut failure = ""
        while at < line.size() and failure == "" {
          at = skip_space(line, at)
          if at < line.size() {
            match self.statement(line, at) {
              ok(next) => { at = next },
              err(reason) => { failure = reason },
            }
          }
        }
        match failure == "" {
          true => Result::ok(()),
          false => Result::err(failure),
        }
      },
    }
  }
}

// The flow a header's direction names.
private fn flow(direction: Str) layers::Flow? {
  match direction {
    "TD" => Maybe::new(layers::Flow::down),
    "TB" => Maybe::new(layers::Flow::down),
    "BT" => Maybe::new(layers::Flow::up),
    "LR" => Maybe::new(layers::Flow::right),
    "RL" => Maybe::new(layers::Flow::left),
    _ => Maybe::new<layers::Flow>(),
  }
}

// Parses the statements after a flowchart header.
fn parse(header: Str, lines: [Str]) Flowchart!Str {
  let fields = strings::Fields(header)
  // `graph TD;` ends its header with a `;`.
  let direction = strings::ToUpper(strings::TrimSuffix(fields.at(1).or("TD"), ";"))
  let parser = mut Parser{
    nodes: [],
    indexes: [:],
    edges: [],
    statements: 0,
  }
  mut failure = match {
    fields.size() > 2 => "unexpected text after `{fields.at(0).or("")} {direction}`",
    flow(direction).is_none() => "unknown direction `{direction}`",
    _ => "",
  }
  for raw in lines {
    let line = strings::TrimSpace(raw)
    if failure == "" and line != "" and (not strings::HasPrefix(line, "%%")) {
      match parser.line(line) {
        ok(_) => (),
        err(reason) => { failure = reason },
      }
    }
  }
  match {
    failure != "" => Result::err(failure),
    parser.nodes.size() == 0 => Result::err("the flowchart has no nodes"),
    parser.nodes.size() > max_nodes => Result::err("more than {max_nodes} nodes"),
    parser.edges.size() > max_edges => Result::err("more than {max_edges} edges"),
    _ => {
      Result::ok(
        Flowchart{
          nodes: parser.nodes,
          edges: parser.edges,
          flow: flow(direction).or(layers::Flow::down),
        },
      )
    },
  }
}

// Draws the statements after a flowchart header.
fn render(header: Str, lines: [Str], title: Str) canvas::Canvas!Str {
  let chart = try parse(header, lines)
  layers::draw(layers::Graph{nodes: chart.nodes, edges: chart.edges}, clean(title), chart.flow)
}

fn expect_drawing(source: Str, expected: [Str]) Void!Str {
  let lines = strings::Split(source, "\n")
  let body = mut List::new<Str>()
  mut index = 1
  while index < lines.size() {
    body.push(lines.at(index).or(""))
    index =+ 1
  }
  let drawing = try render(lines.at(0).or(""), body.@, "")
  let actual = drawing.lines()
  let shown = strings::Join(mut actual, "|\n")
  try testing::assert(
    actual.size() == expected.size(),
    "row count {actual.size()}, want {expected.size()}:\n{shown}|",
  )
  index = 0
  while index < expected.size() {
    let got = actual.at(index).or("")
    let want = expected.at(index).or("")
    try testing::assert(got == want, "row {index}: got {got}|, want {want}|\n{shown}|")
    index =+ 1
  }
  testing::pass()
}

fn expect_rejected(source: Str, reason: Str) Void!Str {
  let lines = strings::Split(source, "\n")
  let body = mut List::new<Str>()
  mut index = 1
  while index < lines.size() {
    body.push(lines.at(index).or(""))
    index =+ 1
  }
  match render(lines.at(0).or(""), body.@, "") {
    ok(_) => Result::err("rendered, want rejection: {reason}"),
    err(got) => testing::assert(got == reason, "got reason {got}, want {reason}"),
  }
}

test fn a_chain_flows_straight_down() Void!Str {
  expect_drawing(
    "flowchart TD\nA[Start] --> B[Middle] --> C[End]",
    [
      " ┌───────┐",
      " │ Start │",
      " └───┬───┘",
      "     │",
      "     ▼",
      "┌────────┐",
      "│ Middle │",
      "└────┬───┘",
      "     │",
      "     ▼",
      "  ┌─────┐",
      "  │ End │",
      "  └─────┘",
    ],
  )
}

test fn edges_from_one_node_branch_on_a_shared_track() Void!Str {
  expect_drawing(
    "flowchart TD\nA[Prompt] --> B[Tool] & C[Reply]",
    [
      "     ┌────────┐",
      "     │ Prompt │",
      "     └────┬───┘",
      "    ┌─────┴────┐",
      "    ▼          ▼",
      "┌──────┐   ┌───────┐",
      "│ Tool │   │ Reply │",
      "└──────┘   └───────┘",
    ],
  )
}

test fn edges_into_one_node_merge_into_one_arrow() Void!Str {
  expect_drawing(
    "flowchart TD\nA[Parse] --> C[Draw]\nB[Layout] --> C",
    [
      "┌───────┐   ┌────────┐",
      "│ Parse │   │ Layout │",
      "└───┬───┘   └────┬───┘",
      "    └──────┬─────┘",
      "           ▼",
      "       ┌──────┐",
      "       │ Draw │",
      "       └──────┘",
    ],
  )
}

test fn an_edge_skipping_a_layer_runs_beside_it() Void!Str {
  expect_drawing(
    "flowchart TD\nA --> B --> C\nA --> C",
    [
      "   ┌───┐",
      "   │ A │",
      "   └─┬─┘",
      "  ┌──┴─┐",
      "  ▼    │",
      "┌───┐  │",
      "│ B │  │",
      "└─┬─┘  │",
      "  └─┐ ┌┘",
      "    ▼ ▼",
      "   ┌───┐",
