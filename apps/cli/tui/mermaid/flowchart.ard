// Edges share a line only when it shows each of them truly: different ends
// or strokes, parallel edges, and sources that don't reach all of a shared
// line's targets get lines of their own.
test fn edges_share_lines_only_when_each_is_drawn_truly() Void!Str {
  try expect_drawing(
    "flowchart TD\nA --> C\nB --x C",
    [
      "┌───┐   ┌───┐",
      "│ A │   │ B │",
      "└─┬─┘   └─┬─┘",
      "  └──┐ ┌──┘",
      "     ▼ ×",
      "    ┌───┐",
      "    │ C │",
      "    └───┘",
    ],
  )

  try expect_drawing(
    "flowchart TD\nA --> B\nA -.-> B",
    [
      "┌───┐",
      "│ A │",
      "└┬─┬┘",
      " │ ┊",
      " ▼ ▼",
      "┌───┐",
      "│ B │",
      "└───┘",
    ],
  )

  try expect_drawing(
    "flowchart TD\nA --> C & D\nB --> D",
    [
      "  ┌───┐   ┌───┐",
      "  │ A │   │ B │",
      "  └─┬─┘   └─┬─┘",
      "  ┌─┴────┐ ┌┘",
      "  ▼      ▼ ▼",
      "┌───┐   ┌───┐",
      "│ C │   │ D │",
      "└───┘   └───┘",
    ],
  )

  expect_drawing(
    "flowchart LR\nA --> C\nB --o C",
    [
      "┌───┐",
      "│ A ├─┐  ┌───┐",
      "└───┘ └─►│   │",
      "         │ C │",
      "┌───┐ ┌─○│   │",
      "│ B ├─┘  └───┘",
      "└───┘",
    ],
  )
}

// A loop takes its column once vertices stop moving, so nothing moved aside
// lands on it.
test fn loops_run_outside_vertices_moved_aside() Void!Str {
  expect_drawing(
    "flowchart LR\nA --o E\nB -->|go| D\nC --> E\nB ==> D\nE ==>|again| E",
    [
      "┌───┐",
      "│ A ├───┐  ┌───┐",
      "└───┘   └─○│   │",
      "           │   │",
      "┌───┐   ┌─►│ E ├━━━━┓",
      "│ C ├───┘  │   │    ┃",
      "└───┘  ┏━━►│   │    ┃",
      "       ┃   └───┘    ┃",
      "       ┃            ┃",
      "┌───┐  ┃            ┃  ┌───┐",
      "│   ├──┼┐         ┌─┼─►│   │",
      "│ B │  ┃│         │ ┃  │ D │",
      "│   ├━┓┃│         │┏╋━►│   │",
      "└───┘ ┃┃└─── go ──┘┃┃  └───┘",
      "      ┃┃           ┃┃",
      "      ┗╋━━━━━━━━━━━┛┃",
      "       ┃            ┃",
      "       ┗━━ again ━━━┛",
    ],
  )
}

test fn edges_skipping_layers_keep_their_stroke() Void!Str {
  expect_drawing(
    "flowchart TD\nA --> B --> C\nA -.-> C\nA ==> D --> E\nA ==> E",
    [
      "       ┌─────┐",
      "       │  A  │",
      "       └┬─┬─┬┘",
      "  ┌─────┘ ┊ ┗━━┳━━━━┓",
      "  ▼       ┊    ▼    ┃",
      "┌───┐     ┊  ┌───┐  ┃",
      "│ B │     ┊  │ D │  ┃",
      "└─┬─┘     ┊  └─┬─┘  ┃",
      "  │       ┊    │┏━━━┛",
      "  └─┐ ┌┈┈┈┘   ┌┘┃",
      "    ▼ ▼       ▼ ▼",
      "   ┌───┐     ┌───┐",
      "   │ C │     │ E │",
      "   └───┘     └───┘",
    ],
  )
}

test fn unsupported_flowchart_syntax_is_rejected() Void!Str {
  try expect_rejected("flowchart XY\nA --> B", "unknown direction `XY`")
  try expect_rejected("flowchart TD\nA{{{{hex}}}} --> B", "`{{{{` nodes aren't drawn yet")
  try expect_rejected("flowchart TD\nA[[sub]] --> B", "`[[` nodes aren't drawn yet")
  try expect_rejected("flowchart TD\nA <--> B", "`<-->` links aren't drawn yet")
  try expect_rejected("flowchart TD\nA -->|open B", "unclosed `|` in `A -->|open B`")
  try expect_rejected("flowchart TD\nA -- open B", "unsupported link in `A -- open B`")
  try expect_rejected("flowchart TD\nsubgraph one\nA --> B\nend", "subgraphs aren't drawn yet")
  try expect_rejected("flowchart TD\nA -->\nB", "unsupported line `A -->`")
  try expect_rejected("flowchart TD\nA --> B\nstyle --> C", "unsupported line `style --> C`")
  // A link inside quotes, as in a URL, is part of the styling.
  let clicked = try render("flowchart TD", ["A --> B", "click A href \"https://example.com/a--b\""], "")
  try testing::assert(clicked.lines().size() == 8, "a quoted `--` in a click statement still draws")
  try expect_rejected("flowchart TD\nA[open --> B", "unclosed `[` in `A[open --> B`")
  expect_rejected("flowchart TD\n%% nothing", "the flowchart has no nodes")
}

test fn flowcharts_past_the_limits_are_rejected() Void!Str {
  let nodes = mut ["flowchart TD"]
  mut index = 0
  while index <= max_nodes {
    nodes.push("N{index}")
    index =+ 1
  }
  try expect_rejected(strings::Join(nodes, "\n"), "more than {max_nodes} nodes")
  let edges = mut ["flowchart TD"]
  index = 0
  while index <= max_edges {
    edges.push("N{index % 12} --> M{index / 12}")
    index =+ 1
  }
  try expect_rejected(strings::Join(edges, "\n"), "more than {max_edges} edges")
  // `&` groups are checked before their edges are made.
  let many = strings::Repeat("a&", 2000) + "a"
  try expect_rejected("flowchart TD\n{many} --> {many}", "more than {max_edges} edges")
  let names = mut List::new<Str>()
  index = 0
  while index <= max_nodes {
    names.push("N{index}")
    index =+ 1
  }
  try expect_rejected("flowchart TD\n{strings::Join(names, " & ")} --> A", "more than {max_nodes} nodes")
  // Statements count between `;`s, not by line.
  try expect_rejected(
    "flowchart TD\n{strings::Repeat("A --> B;", max_statements + 1)}",
    "more than {max_statements} statements",
  )
  let wide = mut ["flowchart TD"]
  index = 0
  while index < 12 {
    wide.push("N{index}[{strings::Repeat("w", 40)}]")
    index =+ 1
  }
  expect_rejected(strings::Join(wide, "\n"), "the flowchart is wider than 480 columns")
}

// `graph TD;`, link text after a space or in quotes, capitalized keywords
// as node names, and a repeated edge drawn once.
test fn common_spellings_are_read_as_mermaid_reads_them() Void!Str {
  expect_drawing(
    "graph TD;\nA --> |yes| B\nA -->|\"no\"| End\nEnd --> Style\nA --> |yes| B",
    [
      "      ┌───┐",
      "      │ A │",
      "      └─┬─┘",
      "   ┌────┴────┐",
      "  yes       no",
      "   ▼         ▼",
      " ┌───┐    ┌─────┐",
      " │ B │    │ End │",
      " └───┘    └──┬──┘",
      "             │",
      "             ▼",
      "         ┌───────┐",
      "         │ Style │",
      "         └───────┘",
    ],
  )
}
