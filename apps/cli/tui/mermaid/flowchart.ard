use ard/testing

use cooper/ui
use kit/tui/mermaid/canvas
use kit/tui/mermaid/layers
use go:strings

// Mermaid flowcharts: a reviewed subset parsed into a graph and drawn with
// the layered layout.
//
// Supported: `flowchart` or `graph` flowing top down (`TD` or `TB`), nodes
// written as an id or as `id[text]`, `-->` arrows and `---` lines of any
// length, chains such as `A --> B --> C`, `&` groups such as `A & B --> C`,
// `;` between statements, and `:::class` suffixes. `classDef`, `class`,
// `style`, `linkStyle`, and `click` statements are accepted without being
// drawn. Anything else is rejected so the source is shown instead.

let max_nodes = 60
let max_edges = 120
let max_statements = 200
// Node text wider than this is cut short with an ellipsis.
let max_text = 40

struct Flowchart {
  nodes: [layers::Node],
  edges: [layers::Edge],
}

// Text as one line, cut to max_text cells.
fn clean(value: Str) Str {
  mut text = value
  for brk in ["<br/>", "<br />", "<br>", "<BR>", "<BR/>"] {
    text = strings::ReplaceAll(text, brk, " ")
  }
  text = strings::TrimSpace(strings::ReplaceAll(text, "\t", " "))
  match ui::text_width(text) <= max_text {
    true => text,
    false => {
      let kept = mut List::new<Str>()
      mut width = 0
      for part in ui::graphemes(text) {
        if width + part.width <= max_text - 1 {
          kept.push(part.text)
          width =+ part.width
        }
      }
      strings::Join(kept, "") + "…"
    },
  }
}

private fn char_at(line: Str, index: Int) Str {
  line.slice(start: index, end: index + 1).or("")
}

// Whether a link starts at index.
private fn link_starts(line: Str, index: Int) Bool {
  let current = char_at(line, index)
  let next = char_at(line, index + 1)
  current == "-" and (next == "-" or next == ".") or current == "=" and next == "=" or current == "~" and next == "~" or current == "<" and (next == "-" or next == "=")
}

private fn skip_space(line: Str, index: Int) Int {
  mut at = index
  mut going = at < line.size()
  while going {
    let current = char_at(line, at)
    going = current == " " or current == "\t"
    if going {
      at =+ 1
      going = at < line.size()
    }
  }
  at
}

// The end of the name that starts at index: up to whitespace, punctuation
// that opens a shape or separates statements, or the start of a link.
private fn name_end(line: Str, index: Int) Int {
  mut at = index
  mut going = at < line.size()
  while going {
    let current = char_at(line, at)
    going = (not strings::ContainsAny(current, " \t[](){{}}<>&;|\":")) and not link_starts(line, at)
    if going {
      at =+ 1
      going = at < line.size()
    }
  }
  at
}

// Where the scanner is after reading part of a statement.
private struct Scan {
  next: Int,
  // The node indexes of a group.
  nodes: [Int],
  // A link's line and head.
  head: Bool,
}

private struct Parser {
  nodes: [layers::Node],
  indexes: [Str: Int],
  edges: [layers::Edge],
}

impl Parser {
  // The index of node id, declaring it on first use. Text, when given,
  // replaces the node's text.
  fn mut node(id: Str, text: Str?) Int {
    let index = match self.indexes.get(id) {
      found => found,
      _ => {
        let added = self.nodes.size()
        self.nodes.push(layers::Node{id: id, text: clean(id)})
        self.indexes.set(id, added)
        added
      },
    }
    match text {
      given => {
        let _ = self.nodes.set(index, layers::Node{id: id, text: clean(given)})
        ()
      },
      _ => (),
    }
    index
  }

  // One node: an id, then optionally a shape with text and a class suffix.
  fn mut one(line: Str, start: Int) Scan!Str {
    let end = name_end(line, start)
    let id = line.slice(start: start, end: end).or("")
    mut at = end
    mut text = Maybe::new<Str>()
    mut failure = ""
    let opener = char_at(line, at)
    if id == "" {
      failure = "unsupported line `{line}`"
    } else if opener == "[" {
      let inner = char_at(line, at + 1)
      if inner == "(" or inner == "[" or inner == "/" or inner == "\\" {
        failure = "`[{inner}` nodes aren't drawn yet"
      } else {
        let content = at + 1
        let quoted = char_at(line, content) == "\""
        let closing = match quoted {
          true => {
            let quote = strings::Index(line.slice(start: content + 1).or(""), "\"")
            match quote < 0 {
              true => -1,
              false => {
                let after = content + 1 + quote + 1
                match char_at(line, after) == "]" {
                  true => after,
                  false => -1,
                }
              },
            }
          },
          false => {
            let found = strings::Index(line.slice(start: content).or(""), "]")
            match found < 0 {
              true => -1,
              false => content + found,
            }
          },
        }
        match closing < 0 {
          true => { failure = "unclosed `[` in `{line}`" },
          false => {
            mut value = line.slice(start: content, end: closing).or("")
            if quoted {
              value = value.slice(start: 1, end: value.size() - 1).or("")
            }
            text = Maybe::new(value)
            at = closing + 1
          },
        }
      }
    } else if opener == "(" or opener == "{{" or opener == ">" {
      failure = "`{opener}` nodes aren't drawn yet"
    }
    if failure == "" and line.slice(start: at, end: at + 3).or("") == ":::" {
      at = name_end(line, at + 3)
    }
    match failure == "" {
      true => {
        let node = self.node(id, text)
        Result::ok(
          Scan{
            next: at,
            nodes: [node],
            head: false,
          },
        )
      },
      false => Result::err(failure),
    }
  }

  // Nodes joined by `&`.
  fn mut group(line: Str, start: Int) Scan!Str {
    let found = mut List::new<Int>()
    mut at = skip_space(line, start)
    mut more = true
    mut failure = ""
    while more {
      match self.one(line, at) {
        ok(scan) => {
          for node in scan.nodes {
            found.push(node)
          }
          at = skip_space(line, scan.next)
          more = char_at(line, at) == "&"
          if more {
            at = skip_space(line, at + 1)
          }
        },
        err(reason) => {
          failure = reason
          more = false
        },
      }
    }
    match failure == "" {
      true => {
        Result::ok(
          Scan{
            next: at,
            nodes: found.@,
            head: false,
          },
        )
      },
      false => Result::err(failure),
    }
  }

  // A link between groups.
  fn mut link(line: Str, start: Int) Scan!Str {
    mut at = start
    mut going = true
    while going {
      going = strings::ContainsAny(char_at(line, at), "-=.~<")
      if going {
        at =+ 1
      }
    }
    let run = line.slice(start: start, end: at).or("")
    let head = char_at(line, at)
    let has_head = head == ">" or head == "x" or head == "o"
    if has_head {
      at =+ 1
    }
    let token = line.slice(start: start, end: at).or("")
    let dashes = strings::Trim(run, "-") == ""
    match {
      char_at(line, at) == "|" => Result::err("edge labels aren't drawn yet"),
      dashes and run.size() >= 2 and head == ">" => {
        Result::ok(
          Scan{
            next: at,
            nodes: [],
            head: true,
          },
        )
      },
      dashes and run.size() >= 3 and (not has_head) => {
        Result::ok(
          Scan{
            next: at,
            nodes: [],
            head: false,
          },
        )
      },
      run == "--" and not has_head => Result::err("edge labels aren't drawn yet"),
      _ => Result::err("`{token}` links aren't drawn yet"),
    }
  }

  // A statement: groups joined by links. Returns where it ended.
  fn mut statement(line: Str, start: Int) Int!Str {
    let first = try self.group(line, start)
    mut previous = first.nodes
    mut at = skip_space(line, first.next)
    mut failure = ""
    mut going = at < line.size() and char_at(line, at) != ";"
    while going {
      match link_starts(line, at) {
        false => {
          failure = "unsupported line `{line}`"
          going = false
        },
        true => {
          match self.link(line, at) {
            ok(link) => {
              match self.group(line, link.next) {
                ok(next) => {
                  for from in previous {
                    for to in next.nodes {
                      self.edges.push(
                        layers::Edge{
                          from: from,
                          to: to,
                          stroke: layers::Stroke::solid,
                          head: link.head,
                        },
                      )
                    }
                  }
                  previous = next.nodes
                  at = skip_space(line, next.next)
                  going = at < line.size() and char_at(line, at) != ";"
                },
                err(reason) => {
                  failure = reason
                  going = false
                },
              }
            },
            err(reason) => {
              failure = reason
              going = false
            },
          }
        },
      }
    }
    match failure == "" {
      true => Result::ok(at + 1),
      false => Result::err(failure),
    }
  }

  fn mut line(line: Str) Void!Str {
    let space = strings::IndexAny(line, " \t")
    let word = strings::ToLower(
      match space >= 0 {
        true => line.slice(end: space).or(line),
        false => line,
      },
    )
    match {
      word == "subgraph" or word == "end" or word == "direction" => {
        Result::err("subgraphs aren't drawn yet")
      },
      word == "classdef" or word == "class" or word == "style" or word == "linkstyle" or word == "click" => {
        Result::ok(())
      },
      _ => {
        mut at = 0
        mut failure = ""
        while at < line.size() and failure == "" {
          at = skip_space(line, at)
          if at < line.size() {
            match self.statement(line, at) {
              ok(next) => { at = next },
              err(reason) => { failure = reason },
            }
          }
        }
        match failure == "" {
          true => Result::ok(()),
          false => Result::err(failure),
        }
      },
    }
  }
}

// Parses the statements after a flowchart header.
fn parse(header: Str, lines: [Str]) Flowchart!Str {
  let fields = strings::Fields(header)
  let direction = strings::ToUpper(fields.at(1).or("TD"))
  let parser = mut Parser{
    nodes: [],
    indexes: [:],
    edges: [],
  }
  mut statements = 0
  mut failure = match {
    fields.size() > 2 => "unexpected text after `{fields.at(0).or("")} {direction}`",
    direction == "LR" or direction == "RL" or direction == "BT" => {
      "`{direction}` flowcharts aren't drawn yet"
    },
    direction != "TD" and direction != "TB" => "unknown direction `{direction}`",
    _ => "",
  }
  for raw in lines {
    let line = strings::TrimSpace(raw)
    if failure == "" and line != "" and (not strings::HasPrefix(line, "%%")) {
      statements =+ 1
      match parser.line(line) {
        ok(_) => (),
        err(reason) => { failure = reason },
      }
    }
  }
  match {
    failure != "" => Result::err(failure),
    parser.nodes.size() == 0 => Result::err("the flowchart has no nodes"),
    parser.nodes.size() > max_nodes => Result::err("more than {max_nodes} nodes"),
    parser.edges.size() > max_edges => Result::err("more than {max_edges} edges"),
    statements > max_statements => Result::err("more than {max_statements} statements"),
    _ => Result::ok(Flowchart{nodes: parser.nodes, edges: parser.edges}),
  }
}

// Draws the statements after a flowchart header.
fn render(header: Str, lines: [Str], title: Str) canvas::Canvas!Str {
  let chart = try parse(header, lines)
  layers::draw(layers::Graph{nodes: chart.nodes, edges: chart.edges}, clean(title))
}

fn expect_drawing(source: Str, expected: [Str]) Void!Str {
  let lines = strings::Split(source, "\n")
  let body = mut List::new<Str>()
  mut index = 1
  while index < lines.size() {
    body.push(lines.at(index).or(""))
    index =+ 1
  }
  let drawing = try render(lines.at(0).or(""), body.@, "")
  let actual = drawing.lines()
  let shown = strings::Join(mut actual, "|\n")
  try testing::assert(
    actual.size() == expected.size(),
    "row count {actual.size()}, want {expected.size()}:\n{shown}|",
  )
  index = 0
  while index < expected.size() {
    let got = actual.at(index).or("")
    let want = expected.at(index).or("")
    try testing::assert(got == want, "row {index}: got {got}|, want {want}|\n{shown}|")
    index =+ 1
  }
  testing::pass()
}

fn expect_rejected(source: Str, reason: Str) Void!Str {
  let lines = strings::Split(source, "\n")
  let body = mut List::new<Str>()
  mut index = 1
  while index < lines.size() {
    body.push(lines.at(index).or(""))
    index =+ 1
  }
  match render(lines.at(0).or(""), body.@, "") {
    ok(_) => Result::err("rendered, want rejection: {reason}"),
    err(got) => testing::assert(got == reason, "got reason {got}, want {reason}"),
  }
}

test fn a_chain_flows_straight_down() Void!Str {
  expect_drawing(
    "flowchart TD\nA[Start] --> B[Middle] --> C[End]",
    [
      " ┌───────┐",
      " │ Start │",
      " └───┬───┘",
      "     │",
      "     ▼",
      "┌────────┐",
      "│ Middle │",
      "└────┬───┘",
      "     │",
      "     ▼",
      "  ┌─────┐",
      "  │ End │",
      "  └─────┘",
    ],
  )
}

test fn edges_from_one_node_branch_on_a_shared_track() Void!Str {
  expect_drawing(
    "flowchart TD\nA[Prompt] --> B[Tool] & C[Reply]",
    [
      "     ┌────────┐",
      "     │ Prompt │",
      "     └────┬───┘",
      "    ┌─────┴────┐",
      "    ▼          ▼",
      "┌──────┐   ┌───────┐",
      "│ Tool │   │ Reply │",
      "└──────┘   └───────┘",
    ],
  )
}

test fn edges_into_one_node_merge_into_one_arrow() Void!Str {
  expect_drawing(
    "flowchart TD\nA[Parse] --> C[Draw]\nB[Layout] --> C",
    [
      "┌───────┐   ┌────────┐",
      "│ Parse │   │ Layout │",
      "└───┬───┘   └────┬───┘",
      "    └──────┬─────┘",
      "           ▼",
      "       ┌──────┐",
      "       │ Draw │",
      "       └──────┘",
    ],
  )
}

test fn an_edge_skipping_a_layer_runs_beside_it() Void!Str {
  expect_drawing(
    "flowchart TD\nA --> B --> C\nA --> C",
    [
      "   ┌───┐",
      "   │ A │",
      "   └─┬─┘",
      "  ┌──┴─┐",
      "  ▼    │",
      "┌───┐  │",
      "│ B │  │",
      "└─┬─┘  │",
      "  └──┬─┘",
      "     ▼",
      "   ┌───┐",
      "   │ C │",
      "   └───┘",
    ],
  )
}

test fn crossing_branches_and_merges_read_as_a_grid() Void!Str {
  expect_drawing(
    "flowchart TD\nA --> C & D\nB --> C & D",
    [
      "┌───┐   ┌───┐",
      "│ A │   │ B │",
      "└─┬─┘   └─┬─┘",
      "  ├───────┤",
      "  ├───────┤",
      "  ▼       ▼",
      "┌───┐   ┌───┐",
      "│ C │   │ D │",
      "└───┘   └───┘",
    ],
  )
}

test fn long_edges_stay_straight() Void!Str {
  expect_drawing(
    "flowchart TD\nPush --> Lint & Test & Build\nLint --> Gate\nTest --> Gate\nBuild --> Package --> Gate\nGate --> Release",
    [
      "           ┌──────┐",
      "           │ Push │",
      "           └───┬──┘",
      "    ┌──────────┼──────────┐",
      "    ▼          ▼          ▼",
      "┌──────┐   ┌──────┐   ┌───────┐",
      "│ Lint │   │ Test │   │ Build │",
      "└───┬──┘   └───┬──┘   └───┬───┘",
      "    │          │          │",
      "    │          │          ▼",
      "    │          │  ┌─────────┐",
      "    │          │  │ Package │",
      "    │          │  └────┬────┘",
      "    └──────────┼───────┘",
      "               ▼",
      "           ┌──────┐",
      "           │ Gate │",
      "           └───┬──┘",
      "               │",
      "               ▼",
      "          ┌─────────┐",
      "          │ Release │",
      "          └─────────┘",
    ],
  )
}

test fn lines_without_heads_join_the_border() Void!Str {
  expect_drawing(
    "flowchart TD\nA --- B",
    [
      "┌───┐",
      "│ A │",
      "└─┬─┘",
      "  │",
      "  │",
      "┌─┴─┐",
      "│ B │",
      "└───┘",
    ],
  )
}

test fn quoted_text_classes_and_styling_statements() Void!Str {
  expect_drawing(
    "graph\nA[\"Quoted [text]\"]:::hot --> B;B --> C[Done]\nclassDef hot fill:#f00\nstyle A stroke:#333\n%% comment",
    [
      "┌───────────────┐",
      "│ Quoted [text] │",
      "└───────┬───────┘",
      "        │",
      "        ▼",
      "      ┌───┐",
      "      │ B │",
      "      └─┬─┘",
      "        │",
      "        ▼",
      "    ┌──────┐",
      "    │ Done │",
      "    └──────┘",
    ],
  )
}

test fn unsupported_flowchart_syntax_is_rejected() Void!Str {
  try expect_rejected("flowchart TD\nA --> B\nB --> A", "flowcharts with loops aren't drawn yet")
  try expect_rejected("flowchart LR\nA --> B", "`LR` flowcharts aren't drawn yet")
  try expect_rejected("flowchart XY\nA --> B", "unknown direction `XY`")
  try expect_rejected("flowchart TD\nA -->|yes| B", "edge labels aren't drawn yet")
  try expect_rejected("flowchart TD\nA -- yes --> B", "edge labels aren't drawn yet")
  try expect_rejected("flowchart TD\nA -.-> B", "`-.->` links aren't drawn yet")
  try expect_rejected("flowchart TD\nA(round) --> B", "`(` nodes aren't drawn yet")
  try expect_rejected("flowchart TD\nsubgraph one\nA --> B\nend", "subgraphs aren't drawn yet")
  try expect_rejected("flowchart TD\nA -->\nB", "unsupported line `A -->`")
  try expect_rejected("flowchart TD\nA[open --> B", "unclosed `[` in `A[open --> B`")
  expect_rejected("flowchart TD\n%% nothing", "the flowchart has no nodes")
}

test fn flowcharts_past_the_limits_are_rejected() Void!Str {
  let nodes = mut ["flowchart TD"]
  mut index = 0
  while index <= max_nodes {
    nodes.push("N{index}")
    index =+ 1
  }
  try expect_rejected(strings::Join(nodes, "\n"), "more than {max_nodes} nodes")
  let edges = mut ["flowchart TD"]
  index = 0
  while index <= max_edges {
    edges.push("A --> B")
    index =+ 1
  }
  try expect_rejected(strings::Join(edges, "\n"), "more than {max_edges} edges")
  let wide = mut ["flowchart TD"]
  index = 0
  while index < 12 {
    wide.push("N{index}[{strings::Repeat("w", 40)}]")
    index =+ 1
  }
  expect_rejected(strings::Join(wide, "\n"), "the flowchart is wider than 480 columns")
}
