use cooper/ui
use kit/tui/mermaid/canvas

// Layered drawings of directed graphs, flowing top to bottom.
//
// Edges that close a loop are set aside first. Each later climbs its own
// column past the right edge, leaving its source and entering its target
// through the channels below and above them.
//
// Nodes are assigned layers by their longest path from a source, and an edge
// that spans several layers passes through a placeholder in each layer
// between. Each layer is reordered by its neighbors' positions to reduce
// crossings, and nodes slide toward their neighbors without overlapping.
// Between two layers runs a channel: an edge leaves its node's bottom border,
// runs sideways on a track, and drops into its target's top border. Edges
// that share a source or a target share a track, so they branch or merge;
// others take tracks whose spans don't touch.

let max_vertices = 400
let max_width = 480
let max_height = 800

// Cells kept clear between neighboring boxes, and beside a passing line.
let box_gap = 3
let line_gap = 2
// Ordering and placement passes.
let sweeps = 4
let placement_passes = 8

// The direction a graph flows: layers stack down, up, right, or left.
enum Flow {
  down,
  up,
  right,
  left,
}

enum Shape {
  box,
  round,
  stadium,
  circle,
  database,
  decision,
}

enum Stroke {
  solid,
  dotted,
  thick,
}

enum Head {
  none,
  arrow,
  cross,
  circle,
}

struct Node {
  id: Str,
  text: Str,
  shape: Shape,
}

struct Edge {
  from: Int,
  to: Int,
  stroke: Stroke,
  head: Head,
  // Text drawn on the edge, or empty.
  label: Str,
}

// Where an edge's label is drawn: on its drop into a target no other edge
// enters, on its stem from a source no other edge leaves, or else on the
// first placeholder of an edge that skips layers; a labeled edge with both
// ends shared always skips one. A loop's label goes `back`, beside its outer
// column.
enum Spot {
  none,
  drop,
  stem,
  middle,
  back,
}

// Cells a label leaves around itself on a node's border.
let label_room = 4

struct Graph {
  nodes: [Node],
  edges: [Edge],
}

// One hop of an edge between adjacent layers.
private struct Segment {
  from: Int,
  to: Int,
  edge: Int,
}

// Edges that share a track: those from one source, those into one target,
// or a single edge.
private struct Star {
  key: Str,
  left: Int,
  right: Int,
  // Whether the star is one edge running straight down, needing no track.
  straight: Bool,
  track: Int,
  // The columns of its stems and drops, and its set of joined lines.
  stems: [Int],
  drops: [Int],
  group: Int,
}

private fn maximum(left: Int, right: Int) Int {
  match left > right {
    true => left,
    false => right,
  }
}

private fn minimum(left: Int, right: Int) Int {
  match left < right {
    true => left,
    false => right,
  }
}

private fn fill(size: Int, value: Int) [Int] {
  let values = mut List::new<Int>(maximum(size, 0))
  if value != 0 {
    mut index = 0
    while index < size {
      values.set(index, value)
      index =+ 1
    }
  }
  values.@
}

// An independent copy of values; `.@` would share their storage.
private fn copy(values: [Int]) [Int] {
  let copied = mut List::new<Int>()
  for value in values {
    copied.push(value)
  }
  copied.@
}

private fn get(values: [Int], index: Int) Int {
  values.at(index).or(0)
}

// Marks with 1 each edge that closes a loop: a depth-first walk from each
// node in declaration order finds the edges that return to a node still being
// walked, including an edge from a node to itself.
fn back_edges(graph: Graph) [Int] {
  let state = mut fill(graph.nodes.size(), 0)
  let back = mut fill(graph.edges.size(), 0)
  mut node = 0
  while node < graph.nodes.size() {
    if get(state.@, node) == 0 {
      visit(graph, node, state, back)
    }
    node =+ 1
  }
  back.@
}

private fn visit(graph: Graph, node: Int, state: mut [Int], back: mut [Int]) {
  state.set(node, 1)
  mut index = 0
  for edge in graph.edges {
    if edge.from == node {
      match get(state.@, edge.to) {
        0 => visit(graph, edge.to, state, back),
        1 => {
          let _ = back.set(index, 1)
          ()
        },
        _ => (),
      }
    }
    index =+ 1
  }
  state.set(node, 2)
}

// The nodes in an order where every edge points forward, preferring earlier
// declarations; an error when the edges form a loop.
fn topological(graph: Graph) [Int]!Str {
  let count = graph.nodes.size()
  let incoming = mut fill(count, 0)
  for edge in graph.edges {
    incoming.set(edge.to, get(incoming.@, edge.to) + 1)
  }
  let done = mut fill(count, 0)
  let order = mut List::new<Int>()
  mut progress = true
  while progress {
    progress = false
    mut picked = -1
    mut node = 0
    while node < count {
      if picked < 0 and get(done.@, node) == 0 and get(incoming.@, node) == 0 {
        picked = node
      }
      node =+ 1
    }
    if picked >= 0 {
      done.set(picked, 1)
      order.push(picked)
      progress = true
      for edge in graph.edges {
        if edge.from == picked {
          incoming.set(edge.to, get(incoming.@, edge.to) - 1)
        }
      }
    }
  }
  match order.size() == count {
    true => Result::ok(order.@),
    false => Result::err("the flowchart couldn't be laid out"),
  }
}

// Each node's layer: one past its deepest predecessor. A source moves down to
// sit just above its nearest successor.
fn layers(graph: Graph, order: [Int], lengths: [Int]) [Int] {
  let layer = mut fill(graph.nodes.size(), 0)
  for node in order {
    mut index = 0
    for edge in graph.edges {
      if edge.from == node {
        layer.set(edge.to, maximum(get(layer.@, edge.to), get(layer.@, node) + get(lengths, index)))
      }
      index =+ 1
    }
  }
  mut index = order.size() - 1
  while index >= 0 {
    let node = get(order, index)
    mut has_incoming = false
    mut nearest = -1
    mut edge_index = 0
    for edge in graph.edges {
      if edge.to == node {
        has_incoming = true
      }
      let length = get(lengths, edge_index)
      edge_index =+ 1
      if edge.from == node {
        let below = get(layer.@, edge.to) - length
        nearest = match nearest < 0 {
          true => below,
          false => minimum(nearest, below),
        }
      }
    }
    if (not has_incoming) and nearest > get(layer.@, node) {
      layer.set(node, nearest)
    }
    index =- 1
  }
  layer.@
}

// The vertices of layer k, ordered by position.
private fn members(layer: [Int], pos: [Int], k: Int) [Int] {
  let found = mut List::new<Int>()
  mut vertex = 0
  while vertex < layer.size() {
    if get(layer, vertex) == k {
      found.push(vertex)
    }
    vertex =+ 1
  }
  sort_by(found.@, pos)
}

// values ordered by their keys, keeping the given order among equal keys.
private fn sort_by(values: [Int], keys: [Int]) [Int] {
  mut sorted = mut copy(values)
  mut width = 1
  while width < sorted.size() {
    let merged = mut List::new<Int>()
    mut start = 0
    while start < sorted.size() {
      let middle = minimum(start + width, sorted.size())
      let end = minimum(start + 2 * width, sorted.size())
      mut left = start
      mut right = middle
      while left < middle or right < end {
        let take_left = right >= end or left < middle and get(keys, get(sorted.@, left)) <= get(keys, get(sorted.@, right))
        match take_left {
          true => {
            merged.push(get(sorted.@, left))
            left =+ 1
          },
          false => {
            merged.push(get(sorted.@, right))
            right =+ 1
          },
        }
      }
      start = end
    }
    sorted = merged
    width = width * 2
  }
  sorted.@
}

// Reorders layer k by the mean position of each vertex's neighbors.
private fn reorder(layer: [Int], pos: mut [Int], neighbors: [[Int]], k: Int) {
  let current = members(layer, pos.@, k)
  let keys = mut fill(layer.size(), 0)
  for vertex in current {
    let near = neighbors.at(vertex).or([])
    mut total = 0
    for other in near {
      total =+ get(pos.@, other)
    }
    let key = match near.size() > 0 {
      true => total * 1000 / near.size(),
      false => get(pos.@, vertex) * 1000,
    }
    keys.set(vertex, key)
  }
  let reordered = sort_by(current, keys.@)
  mut index = 0
  for vertex in reordered {
    pos.set(vertex, index)
    index =+ 1
  }
}

private fn crossings(layer: [Int], pos: [Int], segments: [Segment]) Int {
  // Only segments leaving the same layer can cross.
  mut depth = 0
  for k in layer {
    depth = maximum(depth, k + 1)
  }
  let tops = mut List::new<[Int]>()
  let bottoms = mut List::new<[Int]>()
  mut k = 0
  while k < depth {
    tops.push([])
    bottoms.push([])
    k =+ 1
  }
  for segment in segments {
    let k = get(layer, segment.from)
    let top = mut tops.at(k).or([])
    let bottom = mut bottoms.at(k).or([])
    top.push(get(pos, segment.from))
    bottom.push(get(pos, segment.to))
    tops.set(k, top.@)
    bottoms.set(k, bottom.@)
  }
  mut total = 0
  k = 0
  while k < depth {
    let top = tops.at(k).or([])
    let bottom = bottoms.at(k).or([])
    mut first = 0
    while first < top.size() {
      mut second = first + 1
      while second < top.size() {
        let above = get(top, first) - get(top, second)
        let below = get(bottom, first) - get(bottom, second)
        if above < 0 and below > 0 or above > 0 and below < 0 {
          total =+ 1
        }
        second =+ 1
      }
      first =+ 1
    }
    k =+ 1
  }
  total
}

// The least distance between the centers of neighboring vertices a and b.
// Across the flow, neighbors are rows apart rather than columns, so a single
// blank row keeps them apart.
private fn separation(across: Bool, widths: [Int], a: Int, b: Int) Int {
  let left = get(widths, a)
  let right = get(widths, b)
  let gap = match {
    across => 1,
    left == 1 or right == 1 => line_gap,
    _ => box_gap,
  }
  left - left / 2 + gap + right / 2
}

// Moves the vertices of a layer toward desired centers while keeping them
// apart, balancing pushes from the left and the right.
private fn settle(across: Bool, row: [Int], widths: [Int], desired: [Int], center: mut [Int]) {
  let count = row.size()
  let from_left = mut fill(count, 0)
  let from_right = mut fill(count, 0)
  mut index = 0
  while index < count {
    let vertex = get(row, index)
    let want = get(desired, vertex)
    from_left.set(
      index,
      match index == 0 {
        true => want,
        false => {
          maximum(
            want,
            get(from_left.@, index - 1) + separation(across, widths, get(row, index - 1), vertex),
          )
        },
      },
    )
    index =+ 1
  }
  index = count - 1
  while index >= 0 {
    let vertex = get(row, index)
    let want = get(desired, vertex)
    from_right.set(
      index,
      match index == count - 1 {
        true => want,
        false => {
          minimum(
            want,
            get(from_right.@, index + 1) - separation(across, widths, vertex, get(row, index + 1)),
          )
        },
      },
    )
    index =- 1
  }
  index = 0
  mut previous = 0
  while index < count {
    let vertex = get(row, index)
    mut x = (get(from_left.@, index) + get(from_right.@, index)) / 2
    if index > 0 {
      x = maximum(x, previous + separation(across, widths, get(row, index - 1), vertex))
    }
    center.set(vertex, x)
    previous = x
    index =+ 1
  }
}

// Where segments leave and enter their vertices. Segments sharing a port
// share the line at it: edges from one node branch from one stem, and edges
// into one node merge into one arrow. Lines that join this way must not
// suggest edges that don't exist, so a set of joined lines is kept only when
// each of its stems reaches each of its drops.
private struct Ports {
  // Each segment's stem port and drop port.
  stem: [Int],
  drop: [Int],
  // Each segment's set of joined lines.
  group: [Int],
}

private fn stroke_code(stroke: Stroke) Int {
  match stroke {
    Stroke::solid => 0,
    Stroke::dotted => 1,
    Stroke::thick => 2,
  }
}

private fn head_code(head: Head) Int {
  match head {
    Head::arrow => 0,
    Head::cross => 1,
    Head::circle => 2,
    Head::none => 3,
  }
}

private fn root(parent: [Int], port: Int) Int {
  mut at = port
  while get(parent, at) != at {
    at = get(parent, at)
  }
  at
}

// The set of joined lines each segment belongs to: segments sharing a stem
// or drop port are joined.
private fn join(stem: [Int], drop: [Int], ports: Int) [Int] {
  let parent = mut List::new<Int>()
  mut port = 0
  while port < ports {
    parent.push(port)
    port =+ 1
  }
  mut index = 0
  while index < stem.size() {
    let a = root(parent.@, get(stem, index))
    let b = root(parent.@, get(drop, index))
    if a != b {
      parent.set(a, b)
    }
    index =+ 1
  }
  let groups = mut List::new<Int>()
  for each in stem {
    groups.push(root(parent.@, each))
  }
  groups.@
}

// Gives each segment its ports. Edges share a stem when they leave one
// vertex with the same stroke, and a drop when they enter one vertex with
// the same stroke and head, so every shared line is drawn as all its edges
// are. A set
// of joined lines missing one of its stem-to-drop edges gives each of its
// segments its own drop, or its own stem when that takes fewer ports.
private fn assign_ports(graph: Graph, segments: [Segment], spots: [Spot]) Ports {
  let ids = mut Map::new<Int>()
  mut total = 0
  let stem = mut List::new<Int>()
  let drop = mut List::new<Int>()
  for segment in segments {
    let edge = graph.edges.at(segment.edge).expect("edge")
    let stem_key = "s{segment.from}:{stroke_code(edge.stroke)}"
    let drop_key = match segment.to == edge.to {
      true => "d{segment.to}:{stroke_code(edge.stroke)}:{head_code(edge.head)}",
      false => "d{segment.to}",
    }
    for key in [stem_key, drop_key] {
      if ids.get(key).is_none() {
        ids.set(key, total)
        total =+ 1
      }
    }
    stem.push(ids.get(stem_key).or(0))
    drop.push(ids.get(drop_key).or(0))
  }
  let groups = join(stem.@, drop.@, total)
  // Count each set's segments, stems, and drops.
  let lines = mut fill(total, 0)
  let stems = mut fill(total, 0)
  let drops = mut fill(total, 0)
  let seen = mut fill(total, 0)
  mut index = 0
  for group in groups {
    lines.set(group, get(lines.@, group) + 1)
    let a = get(stem.@, index)
    let b = get(drop.@, index)
    if get(seen.@, a) == 0 {
      seen.set(a, 1)
      stems.set(group, get(stems.@, group) + 1)
    }
    if get(seen.@, b) == 0 {
      seen.set(b, 1)
      drops.set(group, get(drops.@, group) + 1)
    }
    index =+ 1
  }
  index = 0
  for group in groups {
    let n = get(lines.@, group)
    let s = get(stems.@, group)
    let d = get(drops.@, group)
    if n != s * d {
      match d >= s {
        true => drop.set(index, total),
        false => stem.set(index, total),
      }
      total =+ 1
    }
    index =+ 1
  }
  // A chain of segments, an edge skipping layers or a loop, joins the lines
  // at its two ends across channels, so it shares a port at one end only:
  // when both are shared, its last drop gets its own.
  let stem_uses = mut fill(total, 0)
  let drop_uses = mut fill(total, 0)
  for port in stem {
    stem_uses.set(port, get(stem_uses.@, port) + 1)
  }
  for port in drop {
    drop_uses.set(port, get(drop_uses.@, port) + 1)
  }
  let firsts = mut fill(graph.edges.size(), -1)
  let lasts = mut fill(graph.edges.size(), -1)
  index = 0
  for segment in segments {
    if get(firsts.@, segment.edge) < 0 {
      firsts.set(segment.edge, index)
    }
    lasts.set(segment.edge, index)
    index =+ 1
  }
  mut edge_number = 0
  while edge_number < graph.edges.size() {
    let first = get(firsts.@, edge_number)
    let last = get(lasts.@, edge_number)
    let chained = first >= 0 and last != first
    if chained and get(stem_uses.@, get(stem.@, first)) > 1 and get(drop_uses.@, get(drop.@, last)) > 1 {
      let old = get(drop.@, last)
      drop_uses.set(old, get(drop_uses.@, old) - 1)
      drop.set(last, total)
      drop_uses.push(1)
      stem_uses.push(0)
      total =+ 1
    }
    edge_number =+ 1
  }
  Ports{
    stem: stem.@,
    drop: drop.@,
    group: join(stem.@, drop.@, total),
  }
}

// Each vertex's number of ports, where vertices holds the vertex each
// segment's port belongs to.
private fn port_counts(ports: [Int], vertices: [Int], count: Int) [Int] {
  mut top = 0
  for port in ports {
    top = maximum(top, port + 1)
  }
  let seen = mut fill(top, 0)
  let counts = mut fill(count, 0)
  mut index = 0
  for port in ports {
    if get(seen.@, port) == 0 {
      seen.set(port, 1)
      let vertex = get(vertices, index)
      counts.set(vertex, get(counts.@, vertex) + 1)
    }
    index =+ 1
  }
  counts.@
}

// Draws graph, with title above it when given.
fn draw(graph: Graph, title: Str, flow: Flow) canvas::Canvas!Str {
  // Flowing across, nodes are three rows tall side by side, and as thick as
  // their text along the flow.
  let across = flow == Flow::right or flow == Flow::left
  // Edges that close a loop are set aside; the rest flow forward.
  let back = back_edges(graph)
  let forward_edges = mut List::new<Edge>()
  // A labeled edge whose ends are both shared has no line of its own
  // between adjacent layers, so it spans two, with a placeholder for its
  // label.
  let lengths = mut List::new<Int>()
  mut edge_number = 0
  for edge in graph.edges {
    if get(back, edge_number) == 0 {
      forward_edges.push(edge)
      let shared = edges_into(graph, edge.to) > 1 and edges_from(graph, edge.from) > 1
      lengths.push(
        match edge.label != "" and shared {
          true => 2,
          false => 1,
        },
      )
    }
    edge_number =+ 1
  }
  let forward = Graph{nodes: graph.nodes, edges: forward_edges.@}
  let order = try topological(forward)
  let node_layers = layers(forward, order, lengths.@)
  let real = graph.nodes.size()

  // Vertices: the nodes, then a placeholder for each layer an edge skips.
  let layer = mut List::new<Int>()
  // Box widths, and the widths vertices are spaced by: a node with a label
  // on its border makes room for it.
  let boxes = mut List::new<Int>()
  let widths = mut List::new<Int>()
  // Each vertex's extent along the flow.
  let thick = mut List::new<Int>()
  for node, index in graph.nodes {
    let size = match across {
      true => 3,
      false => ui::text_width(node.text) + 4,
    }
    layer.push(get(node_layers, index))
    boxes.push(size)
    widths.push(size)
    thick.push(
      match across {
        true => ui::text_width(node.text) + 4,
        false => 3,
      },
    )
  }
  let spots = mut List::new<Spot>()
  for edge in graph.edges {
    let label = ui::text_width(edge.label)
    let looped = get(back, spots.size()) == 1
    let spot = match {
      edge.label == "" => Spot::none,
      looped => Spot::back,
      edges_into(graph, edge.to) == 1 => Spot::drop,
      edges_from(graph, edge.from) == 1 => Spot::stem,
      get(node_layers, edge.to) - get(node_layers, edge.from) > 1 => Spot::middle,
      _ => Spot::middle,
    }
    // Labels lie along their lines when flowing across, needing no room
    // beside them.
    if spot == Spot::drop and not across {
      widths.set(edge.to, maximum(get(widths.@, edge.to), label + label_room))
    }
    if spot == Spot::stem and not across {
      widths.set(edge.from, maximum(get(widths.@, edge.from), label + label_room))
    }
    spots.push(spot)
  }
  let segments = mut List::new<Segment>()
  mut edge_index = 0
  for edge in graph.edges {
    let looped = get(back, edge_index) == 1
    mut from = edge.from
    mut k = match looped {
      true => get(layer.@, edge.to),
      false => get(layer.@, edge.from) + 1,
    }
    while k < get(layer.@, edge.to) {
      let placeholder = layer.size()
      layer.push(k)
      boxes.push(1)
      // The first placeholder of an edge labeled there makes room for it.
      let middle = spots.at(edge_index).or(Spot::none) == Spot::middle and from == edge.from
      let room = match middle {
        true => ui::text_width(edge.label) + label_room,
        false => 1,
      }
      widths.push(
        match across {
          true => 1,
          false => room,
        },
      )
      thick.push(
        match across {
          true => room,
          false => 3,
        },
      )
      segments.push(
        Segment{
          from: from,
          to: placeholder,
          edge: edge_index,
        },
      )
      from = placeholder
      k =+ 1
    }
    if not looped {
      segments.push(
        Segment{
          from: from,
          to: edge.to,
          edge: edge_index,
        },
      )
    }
    edge_index =+ 1
  }
  let count = layer.size()
  mut depth = 0
  for k in layer {
    depth = maximum(depth, k + 1)
  }
  // Each loop leaves through an exit and enters through an entry, two
  // vertices added after the rest once loops have their columns.
  let loops = mut List::new<Int>()
  let all_segments = mut List::new<Segment>()
  for segment in segments {
    all_segments.push(segment)
  }
  edge_index = 0
  for edge in graph.edges {
    if get(back, edge_index) == 1 {
      let exit = count + 2 * loops.size()
      all_segments.push(
        Segment{
          from: edge.from,
          to: exit,
          edge: edge_index,
        },
      )
      all_segments.push(
        Segment{
          from: exit + 1,
          to: edge.to,
          edge: edge_index,
        },
      )
      loops.push(edge_index)
    }
    edge_index =+ 1
  }
  let ports = assign_ports(graph, all_segments.@, spots.@)
  // A node is long enough across the flow for its ports, two cells apart.
  let froms = mut List::new<Int>()
  let tos = mut List::new<Int>()
  for segment in all_segments {
    froms.push(segment.from)
    tos.push(segment.to)
  }
  let vertex_count = count + 2 * loops.size()
  let stem_counts = port_counts(ports.stem, froms.@, vertex_count)
  let drop_counts = port_counts(ports.drop, tos.@, vertex_count)
  mut node = 0
  while node < real {
    let needed = 2 * maximum(get(stem_counts, node), get(drop_counts, node)) + 1
    if needed > get(boxes.@, node) {
      boxes.set(node, needed)
      widths.set(node, maximum(get(widths.@, node), needed))
    }
    node =+ 1
  }
  match count > max_vertices {
    true => Result::err("the flowchart is too large"),
    false => {
      let preds = mut List::new<[Int]>()
      let succs = mut List::new<[Int]>()
      mut vertex = 0
      while vertex < count {
        let before = mut List::new<Int>()
        let after = mut List::new<Int>()
        for segment in segments {
          if segment.to == vertex {
            before.push(segment.from)
          }
          if segment.from == vertex {
            after.push(segment.to)
          }
        }
        preds.push(before.@)
        succs.push(after.@)
        vertex =+ 1
      }

      // Order each layer, keeping the order with the fewest crossings.
      let pos = mut fill(count, 0)
      let filled = mut fill(depth, 0)
      vertex = 0
      while vertex < count {
        let k = get(layer.@, vertex)
        pos.set(vertex, get(filled.@, k))
        filled.set(k, get(filled.@, k) + 1)
        vertex =+ 1
      }
      mut best = copy(pos.@)
      mut fewest = crossings(layer.@, pos.@, segments.@)
      mut sweep = 0
      while sweep < sweeps and fewest > 0 {
        mut k = 1
        while k < depth {
          reorder(layer.@, pos, preds.@, k)
          k =+ 1
        }
        k = depth - 2
        while k >= 0 {
          reorder(layer.@, pos, succs.@, k)
          k =- 1
        }
        let found = crossings(layer.@, pos.@, segments.@)
        if found < fewest {
          fewest = found
          best = copy(pos.@)
        }
        sweep =+ 1
      }

      // Place each layer, then pull vertices toward their neighbors.
      let center = mut fill(count, 0)
      let rows = mut List::new<[Int]>()
      mut k = 0
      while k < depth {
        let row = members(layer.@, best, k)
        rows.push(row)
        mut x = 0
        mut index = 0
        for member in row {
          x = match index == 0 {
            true => get(widths.@, member) / 2,
            false => x + separation(across, widths.@, get(row, index - 1), member),
          }
          center.set(member, x)
          index =+ 1
        }
        k =+ 1
      }
      mut pass = 0
      while pass < placement_passes {
        let downward = pass % 2 == 0
        mut step = 0
        while step < depth {
          let current = match downward {
            true => step,
            false => depth - 1 - step,
          }
          let row = rows.at(current).or([])
          let desired = mut copy(center.@)
          for member in row {
            let near = match downward {
              true => preds.at(member).or([]),
              false => succs.at(member).or([]),
            }
            if near.size() > 0 {
              mut total = 0
              for other in near {
                total =+ get(center.@, other)
              }
              desired.set(member, (2 * total + near.size()) / (2 * near.size()))
            }
          }
          settle(across, row, widths.@, desired.@, center)
          step =+ 1
        }
        pass =+ 1
      }
      // Straighten long edges: line each edge's placeholders up under its
      // source, or over its target, where their neighbors leave room.
      let chain_pos = mut copy(best)
      edge_index = 0
      for edge in graph.edges {
        let chain = mut List::new<Int>()
        for segment in segments {
          if segment.edge == edge_index and segment.to >= real {
            chain.push(segment.to)
          }
        }
        if chain.size() > 0 {
          mut placed = false
          // Failing both, the rightmost column the chain already reaches
          // always has room on the left.
          mut rightmost = 0
          for member in chain {
            rightmost = maximum(rightmost, get(center.@, member))
          }
          for x in [get(center.@, edge.from), get(center.@, edge.to), rightmost] {
            if not placed {
              // The left side must already have room; the right side is
              // pushed over to make it.
              mut fits = true
              for member in chain {
                let row = rows.at(get(layer.@, member)).or([])
                match row.at(get(chain_pos.@, member) - 1) {
                  before => {
                    if x < get(center.@, before) + separation(across, widths.@, before, member) {
                      fits = false
                    }
                  },
                  _ => (),
                }
              }
              if fits {
                for member in chain {
                  center.set(member, x)
                  let row = rows.at(get(layer.@, member)).or([])
                  mut index = get(chain_pos.@, member) + 1
                  while index < row.size() {
                    let previous = get(row, index - 1)
                    let next = get(row, index)
                    let least = get(center.@, previous) + separation(across, widths.@, previous, next)
                    if get(center.@, next) < least {
                      center.set(next, least)
                    }
                    index =+ 1
                  }
                }
                placed = true
              }
            }
          }
        }
        edge_index =+ 1
      }
      mut left = 0
      vertex = 0
      while vertex < count {
        let edge_left = get(center.@, vertex) - get(widths.@, vertex) / 2
        if vertex == 0 or edge_left < left {
          left = edge_left
        }
        vertex =+ 1
      }
      vertex = 0
      while vertex < count {
        center.set(vertex, get(center.@, vertex) - left)
        vertex =+ 1
      }
      // Loops: each edge that loops back climbs its own column past the right
      // edge, shorter loops inside longer ones. It leaves its source through
      // an exit in the channel below and enters its target through an entry
      // in the channel above, adding a channel at either end when needed.
      mut right = 0
      vertex = 0
      while vertex < count {
        let room = get(widths.@, vertex)
        right = maximum(right, get(center.@, vertex) - room / 2 + room)
        vertex =+ 1
      }
      let spans = mut fill(graph.edges.size(), 0)
      for looped in loops {
        let edge = graph.edges.at(looped).expect("edge")
        spans.set(looped, get(layer.@, edge.from) - get(layer.@, edge.to))
      }
      let columns = mut fill(graph.edges.size(), -1)
      mut column = right + 1
      for looped in sort_by(loops.@, spans.@) {
        let edge = graph.edges.at(looped).expect("edge")
        columns.set(looped, column)
        column =+ 2
        if edge.label != "" and not across {
          column =+ ui::text_width(edge.label) + 2
        }
      }
      mut above = false
      mut below = false
      for looped in loops {
        let edge = graph.edges.at(looped).expect("edge")
        if get(layer.@, edge.to) == 0 {
          above = true
        }
        if get(layer.@, edge.from) == depth - 1 {
          below = true
        }
      }
      if above {
        vertex = 0
        while vertex < count {
          layer.set(vertex, get(layer.@, vertex) + 1)
          vertex =+ 1
        }
      }
      let all_rows = mut List::new<[Int]>()
      if above {
        all_rows.push([])
      }
      for row in rows {
        all_rows.push(row)
      }
      if below {
        all_rows.push([])
      }
      let virtual_start = layer.size()
      for looped in loops {
        let edge = graph.edges.at(looped).expect("edge")
        let x = get(columns.@, looped)
        let exit = layer.size()
        layer.push(get(layer.@, edge.from) + 1)
        boxes.push(1)
        widths.push(1)
        thick.push(0)
        center.push(x)
        segments.push(
          Segment{
            from: edge.from,
            to: exit,
            edge: looped,
          },
        )
        let entry = layer.size()
        layer.push(get(layer.@, edge.to) - 1)
        boxes.push(1)
        widths.push(1)
        thick.push(0)
        center.push(x)
        segments.push(
          Segment{
            from: entry,
            to: edge.to,
            edge: looped,
          },
        )
      }
      route(
        graph,
        title,
        layer.@,
        boxes.@,
        widths.@,
        spots.@,
        center.@,
        segments.@,
        all_rows.@,
        real,
        virtual_start,
        columns.@,
        thick.@,
        flow,
        ports,
      )
    },
  }
}

// Ports, tracks, rows, and the drawing.
private fn route(
  graph: Graph,
  title: Str,
  layer: [Int],
  boxes: [Int],
  widths: [Int],
  spots: [Spot],
  centers: [Int],
  segments: [Segment],
  rows: [[Int]],
  real: Int,
  virtual_start: Int,
  outer: [Int],
  thick: [Int],
  flow: Flow,
  ports: Ports,
) canvas::Canvas!Str {
  let count = layer.size()
  let depth = rows.size()
  let center = mut copy(centers)
  // A stem leaving one vertex must not share a column with a drop into an
  // unrelated vertex below, or the two would read as one edge. Drops shift
  // within their box, stems within theirs; placeholders move aside.
  let stem_shift = mut fill(count, 0)
  let drop_shift = mut fill(count, 0)
  // Ports sit two cells apart across a vertex, in the order of where their
  // other ends lie.
  let stem_offset = port_offsets(segments, ports.stem, center.@, true)
  let drop_offset = port_offsets(segments, ports.drop, center.@, false)
  let froms = mut List::new<Int>()
  let tos = mut List::new<Int>()
  for segment in segments {
    froms.push(segment.from)
    tos.push(segment.to)
  }
  // The cells each vertex's ports reach past their middle one.
  let stem_reach = mut List::new<Int>()
  let drop_reach = mut List::new<Int>()
  let stem_counts = port_counts(ports.stem, froms.@, count)
  let drop_counts = port_counts(ports.drop, tos.@, count)
  mut vertex = 0
  while vertex < count {
    stem_reach.push(get(stem_counts, vertex) - 1)
    drop_reach.push(get(drop_counts, vertex) - 1)
    vertex =+ 1
  }
  // A vertex's drops shift to line one up with its predecessor's stem when
  // they all stay inside its box, so that edge runs straight; the smallest
  // shift wins.
  vertex = 0
  while vertex < real {
    let box = get(boxes, vertex)
    let x = get(center.@, vertex)
    let reach = get(drop_reach.@, vertex)
    let low = x - box / 2 + 1 + reach
    let high = x - box / 2 + box - 2 - reach
    mut best = 0
    mut found = false
    mut index = 0
    for segment in segments {
      let stem = get(center.@, segment.from) + get(stem_offset, index)
      let shift = stem - x - get(drop_offset, index)
      if segment.to == vertex and x + shift >= low and x + shift <= high {
        if (not found) or distance(shift, 0) < distance(best, 0) {
          best = shift
          found = true
        }
      }
      index =+ 1
    }
    if found and not has_drop_label(graph, spots, vertex) {
      drop_shift.set(vertex, best)
    }
    vertex =+ 1
  }
  let stem_at = fn(index: Int) Int {
    let from = segments.at(index).expect("segment").from
    get(center.@, from) + get(stem_shift.@, from) + get(stem_offset, index)
  }
  let drop_at = fn(index: Int) Int {
    let to = segments.at(index).expect("segment").to
    get(center.@, to) + get(drop_shift.@, to) + get(drop_offset, index)
  }
  // Each channel's segments, since only those can meet.
  let channels = mut List::new<[Int]>()
  for _ in rows {
    channels.push([])
  }
  mut numbered = 0
  for segment in segments {
    let k = get(layer, segment.from)
    let grown = mut channels.at(k).or([])
    grown.push(numbered)
    channels.set(k, grown.@)
    numbered =+ 1
  }
  mut changed = true
  mut rounds = 0
  while changed and rounds < 64 {
    changed = false
    // Cheap tests first: only a stem and drop that meet need the search for
    // a path between them.
    for a, ai in segments {
      for bi in channels.at(get(layer, a.from)).or([]) {
        let b = segments.at(bi).expect("segment")
        // A loop's entry has no stem and its exit no drop.
        let drawn = a.from < virtual_start and b.to < virtual_start
        let meet = drawn and stem_at(ai) == drop_at(bi)
        // Lines in one set are joined anyway.
        let related = get(ports.group, ai) == get(ports.group, bi)
        if meet and not related {
          let target = get(boxes, b.to)
          let source = get(boxes, a.from)
          let drop_room = target - target / 2 - 2 - get(drop_reach.@, b.to)
          let stem_room = 1 - source / 2 + get(stem_reach.@, a.from)
          if b.to < real and get(drop_shift.@, b.to) < drop_room {
            drop_shift.set(b.to, get(drop_shift.@, b.to) + 1)
          } else if a.from < real and get(stem_shift.@, a.from) > stem_room {
            stem_shift.set(a.from, get(stem_shift.@, a.from) - 1)
          } else {
            // Move the placeholder and everything after it in its layer.
            let row = rows.at(get(layer, b.to)).or([])
            mut moving = false
            for member in row {
              if member == b.to {
                moving = true
              }
              if moving {
                center.set(member, get(center.@, member) + 1)
              }
            }
          }
          changed = true
        }
      }
    }
    rounds =+ 1
  }
  // Moving vertices aside may leave room before the first; close it, with
  // the loops' columns.
  mut least = -1
  vertex = 0
  while vertex < virtual_start {
    let edge_left = get(center.@, vertex) - get(widths, vertex) / 2
    if least < 0 or edge_left < least {
      least = edge_left
    }
    vertex =+ 1
  }
  let gap = maximum(least, 0)
  vertex = 0
  while vertex < count {
    center.set(vertex, get(center.@, vertex) - gap)
    vertex =+ 1
  }
  // Loops take their columns past the right edge only now that nothing
  // moves: in the order chosen for them, shorter loops inside.
  let across = flow == Flow::right or flow == Flow::left
  mut right = 0
  vertex = 0
  while vertex < virtual_start {
    let room = get(widths, vertex)
    right = maximum(right, get(center.@, vertex) - room / 2 + room)
    vertex =+ 1
  }
  let looped = mut List::new<Int>()
  let numbers = mut List::new<Int>()
  mut edge_index = 0
  for x in outer {
    if x >= 0 {
      numbers.push(looped.size())
      looped.push(edge_index)
    } else {
      numbers.push(-1)
    }
    edge_index =+ 1
  }
  let columns = mut fill(outer.size(), -1)
  mut column = right + 1
  for edge_number in sort_by(looped.@, outer) {
    let edge = graph.edges.at(edge_number).expect("edge")
    columns.set(edge_number, column)
    // The loop's exit and entry stand in its column.
    let exit = virtual_start + 2 * get(numbers.@, edge_number)
    center.set(exit, column)
    center.set(exit + 1, column)
    column =+ 2
    if edge.label != "" and not across {
      column =+ ui::text_width(edge.label) + 2
    }
  }
  let stem_x = stem_at
  let drop_x = drop_at
  match changed {
    true => Result::err("the flowchart couldn't be laid out"),
    false => {
      // Group each channel's segments into stars and give them tracks.
      let stem_uses = uses(ports.stem)
      let drop_uses = uses(ports.drop)
      let star_of = mut fill(segments.size(), 0)
      let stars = mut List::new<Star>()
      let tracks = mut fill(depth, 0)
      mut k = 0
      while k + 1 < depth {
        let found = mut List::new<Int>()
        let first = stars.size()
        mut index = 0
        for segment in segments {
          if get(layer, segment.from) == k {
            let stem_port = get(ports.stem, index)
            let drop_port = get(ports.drop, index)
            let fan_out = get(stem_uses, stem_port) > 1
            let fan_in = get(drop_uses, drop_port) > 1
            let key = match {
              fan_out => "from:{stem_port}",
              fan_in => "into:{drop_port}",
              _ => "edge:{index}",
            }
            let low = minimum(stem_x(index), drop_x(index))
            let high = maximum(stem_x(index), drop_x(index))
            mut star = -1
            mut search = first
            while search < stars.size() {
              if stars.at(search).expect("star").key == key {
                star = search
              }
              search =+ 1
            }
            match star < 0 {
              true => {
                star_of.set(index, stars.size())
                found.push(stars.size())
                let _ = stars.push(
                  Star{
                    key: key,
                    left: low,
                    right: high,
                    straight: low == high and key == "edge:{index}",
                    track: -1,
                    stems: [stem_x(index)],
                    drops: [drop_x(index)],
                    group: get(ports.group, index),
                  },
                )
                ()
              },
              false => {
                star_of.set(index, star)
                let grown = mut stars.at(star).expect("star")
                grown.left = minimum(grown.left, low)
                grown.right = maximum(grown.right, high)
                grown.stems.push(stem_x(index))
                grown.drops.push(drop_x(index))
                let _ = stars.set(star, grown.@)
                ()
              },
            }
          }
          index =+ 1
        }
        // Tracks: taking stars from the left, each joins the track, or
        // opens a new one at the place among them, where it crosses the
        // fewest lines, preferring to join and then the topmost. Stars share
        // a track only when they stay clear of each other.
        let lefts = mut fill(stars.size(), 0)
        for star in found {
          lefts.set(star, stars.at(star).expect("star").left)
        }
        let level = mut fill(stars.size(), -1)
        let placed = mut List::new<Int>()
        mut used = 0
        for star in sort_by(found.@, lefts.@) {
          let current = stars.at(star).expect("star")
          if not current.straight {
            // Candidates: joining track t is 2t + 1; opening a track before
            // track t is 2t.
            mut best = 2 * used
            mut fewest = -1
            mut candidate = 0
            while candidate <= 2 * used {
              let joining = candidate % 2 == 1
              let at = candidate / 2
              mut cost = 0
              for other in placed {
                let them = stars.at(other).expect("star")
                let track = get(level.@, other)
                let clear = them.right + 1 < current.left or current.right + 1 < them.left
                cost = match {
                  cost < 0 => cost,
                  joining and track == at and (not clear) => -1,
                  joining and track == at => cost,
                  track < at => cost + crossings_above(them, current),
                  _ => cost + crossings_above(current, them),
                }
              }
              let better = fewest < 0 or cost < fewest or cost == fewest and joining and best % 2 == 0
              if cost >= 0 and better {
                fewest = cost
                best = candidate
              }
              candidate =+ 1
            }
            let at = best / 2
            if best % 2 == 0 {
              // Open a track: those from here on move down one.
              for other in placed {
                if get(level.@, other) >= at {
                  level.set(other, get(level.@, other) + 1)
                }
              }
              used =+ 1
            }
            level.set(star, at)
            placed.push(star)
          }
        }
        for star in placed {
          let current = mut stars.at(star).expect("star")
          current.track = get(level.@, star)
          stars.set(star, current.@)
        }
        tracks.set(k, used)
        k =+ 1
      }

      // Bands along the flow: each layer as thick as its thickest member,
      // then its channel: stem labels, tracks, drop labels, and arrows.
      // Flowing across, labels lie along their lines, so their bands are as
      // long as the labels, and lines get a cell of lead at each end.
      let lead = match across {
        true => 1,
        false => 0,
      }
      let stem_rows = mut fill(depth, lead)
      let drop_rows = mut fill(depth, lead)
      for segment in segments {
        let edge = graph.edges.at(segment.edge).expect("edge")
        let spot = spots.at(segment.edge).or(Spot::none)
        let k = get(layer, segment.from)
        let size = match across {
          true => ui::text_width(edge.label) + 2 + 2 * lead,
          false => 1,
        }
        if spot == Spot::stem and segment.from == edge.from {
          stem_rows.set(k, maximum(get(stem_rows.@, k), size))
        }
        if spot == Spot::drop and segment.to == edge.to {
          drop_rows.set(k, maximum(get(drop_rows.@, k), size))
        }
      }
      // A layer added only to carry loops is empty and takes no room.
      let heights = mut List::new<Int>()
      for row in rows {
        mut band = 0
        for member in row {
          band = maximum(band, get(thick, member))
        }
        heights.push(band)
      }
      let tops = mut List::new<Int>()
      mut y = 0
      k = 0
      while k < depth {
        tops.push(y)
        y =+ get(heights.@, k) + get(stem_rows.@, k) + maximum(get(tracks.@, k), 1) + get(drop_rows.@, k) + 1
        k =+ 1
      }
      // A channel added after the last layer ends with its tracks.
      let last = depth - 1
      let span = match get(heights.@, last) == 0 {
        true => {
          get(tops.@, last - 1) + get(heights.@, last - 1) + get(stem_rows.@, last - 1) + maximum(get(tracks.@, last - 1), 1)
        },
        false => get(tops.@, last) + get(heights.@, last),
      }
      mut cross = 0
      edge_index = 0
      for edge in graph.edges {
        let x = get(columns.@, edge_index)
        if x >= 0 {
          cross = maximum(cross, x + 1)
          if edge.label != "" and not across {
            cross = maximum(cross, x + ui::text_width(edge.label) + 3)
          }
        }
        edge_index =+ 1
      }
      mut vertex = 0
      while vertex < count {
        let room = get(widths, vertex)
        cross = maximum(cross, get(center.@, vertex) - room / 2 + room)
        vertex =+ 1
      }
      let offset = match title == "" {
        true => 0,
        false => 2,
      }
      let pen = Pen{
        flow: flow,
        span: span,
        offset: offset,
      }
      let width = maximum(
        ui::text_width(title),
        match across {
          true => span,
          false => cross,
        },
      )
      let tall = match across {
        true => cross,
        false => span,
      }
      let height = offset + tall
      match {
        width > max_width => Result::err("the flowchart is wider than {max_width} columns"),
        height > max_height => Result::err("the flowchart is taller than {max_height} rows"),
        _ => {
          let drawing = canvas::new(width, height)
          if title != "" {
            drawing.write(0, 0, title, canvas::Role::title, true)
          }
          vertex = 0
          while vertex < count {
            let k = get(layer, vertex)
            let top = get(tops.@, k)
            let c = get(center.@, vertex)
            match {
              // A placeholder carries its edge's line through the layer.
              vertex < real => {
                let node = graph.nodes.at(vertex).expect("node")
                let box = get(boxes, vertex)
                match across {
                  true => {
                    let x0 = minimum(pen.x(c, top), pen.x(c, top + get(thick, vertex) - 1))
                    draw_node(drawing, node, x0, pen.y(c, top) - box / 2, get(thick, vertex), box)
                  },
                  false => {
                    let y0 = minimum(pen.y(c, top), pen.y(c, top + 2))
                    draw_node(drawing, node, c - box / 2, y0, box, 3)
                  },
                }
              },
              vertex < virtual_start => {
                let stroke = stroke_into(graph, segments, vertex)
                pen.along(
                  drawing,
                  c,
                  top,
                  top + get(heights.@, k) - 1,
                  stroke == Stroke::dotted,
                  stroke == Stroke::thick,
                )
              },
              _ => (),
            }
            vertex =+ 1
          }
          let heads = mut List::new<Int>()
          let head_glyphs = mut List::new<Str>()
          // Labels: edge, first column, row, and the column of the label's
          // own line beside it, or -1 when it lies along its line.
          let labels = mut List::new<Int>()
          let exit_rows = mut fill(graph.edges.size(), 0)
          let entry_rows = mut fill(graph.edges.size(), 0)
          // Loops' runs beneath a diagram flowing sideways, for their labels:
          // edge, start, end, and row on the drawing.
          let runs = mut List::new<Int>()
          // Loops' climbs beside a diagram flowing down or up, for their
          // labels: edge, column, top, bottom, and the label's first column.
          let climbs = mut List::new<Int>()
          // Places a label across the band from a0 to a1 on the line at
          // cross; flowing down or up, on the band's middle row.
          let place = fn(edge: Int, c: Int, a0: Int, a1: Int) {
            let text = " {graph.edges.at(edge).expect("edge").label} "
            let size = ui::text_width(text)
            labels.push(edge)
            match across {
              true => {
                let x0 = minimum(pen.x(c, a0), pen.x(c, a1))
                let x1 = maximum(pen.x(c, a0), pen.x(c, a1))
                labels.push((x0 + x1 + 1 - size) / 2)
                labels.push(pen.y(c, a0))
                labels.push(-1)
              },
              false => {
                labels.push(c - size / 2)
                labels.push(pen.y(c, (a0 + a1) / 2))
                labels.push(c)
              },
            }
          }
          mut index = 0
          for segment in segments {
            let edge = graph.edges.at(segment.edge).expect("edge")
            let spot = spots.at(segment.edge).or(Spot::none)
            let k = get(layer, segment.from)
            let band_end = get(tops.@, k) + get(heights.@, k) - 1
            // A line leaves its node's far border; a placeholder's band.
            let start = match segment.from < real {
              true => get(tops.@, k) + get(thick, segment.from) - 1,
              false => band_end,
            }
            let below = get(tops.@, k + 1)
            let target = segment.to == edge.to
            let head = target and edge.head != Head::none
            let end = match head {
              true => below - 1,
              false => below,
            }
            let dashed = edge.stroke == Stroke::dotted
            let heavy = edge.stroke == Stroke::thick
            let star = stars.at(get(star_of.@, index)).expect("star")
            let from = stem_x(index)
            let to = drop_x(index)
            let row = band_end + 1 + get(stem_rows.@, k) + star.track
            match {
              // A loop leaves its source for its outer column, and enters
              // its target from it.
              segment.to >= virtual_start => {
                pen.along(drawing, from, start, row, dashed, heavy)
                pen.side(drawing, row, from, to, dashed, heavy)
                exit_rows.set(segment.edge, row)
              },
              segment.from >= virtual_start => {
                pen.side(drawing, row, to, from, dashed, heavy)
                pen.along(drawing, to, row, end, dashed, heavy)
                entry_rows.set(segment.edge, row)
              },
              star.straight => pen.along(drawing, from, start, end, dashed, heavy),
              _ => {
                pen.along(drawing, from, start, row, dashed, heavy)
                if from != to {
                  pen.side(drawing, row, from, to, dashed, heavy)
                }
                pen.along(drawing, to, row, end, dashed, heavy)
              },
            }
            if head {
              heads.push(pen.x(to, below - 1))
              heads.push(pen.y(to, below - 1))
              head_glyphs.push(pen.head(edge.head))
            }
            let first = segment.from == edge.from
            if spot == Spot::drop and target {
              place(segment.edge, to, below - 1 - get(drop_rows.@, k), below - 2)
            }
            if spot == Spot::stem and first {
              place(segment.edge, from, band_end + 1, band_end + get(stem_rows.@, k))
            }
            if spot == Spot::middle and first {
              place(segment.edge, to, below, below + get(heights.@, k + 1) - 1)
            }
            index =+ 1
          }
          index = 0
          while index < heads.size() {
            drawing.write(
              get(heads.@, index),
              get(heads.@, index + 1),
              head_glyphs.at(index / 2).or("▼"),
              canvas::Role::arrow,
              false,
            )
            index =+ 2
          }
          // Each loop climbs its outer column from its exit to its entry.
          // Its label sits beside the climb, or along it when flowing across.
          edge_index = 0
          for edge in graph.edges {
            let x = get(columns.@, edge_index)
            if x >= 0 {
              let top = get(entry_rows.@, edge_index)
              let bottom = get(exit_rows.@, edge_index)
              pen.along(
                drawing,
                x,
                top,
                bottom,
                edge.stroke == Stroke::dotted,
                edge.stroke == Stroke::thick,
              )
              let x0 = minimum(pen.x(x, top), pen.x(x, bottom))
              let x1 = maximum(pen.x(x, top), pen.x(x, bottom))
              let y0 = minimum(pen.y(x, top), pen.y(x, bottom))
              let y1 = maximum(pen.y(x, top), pen.y(x, bottom))
              if edge.label != "" {
                match across {
                  true => {
                    runs.push(edge_index)
                    runs.push(x0)
                    runs.push(x1)
                    runs.push(y0)
                  },
                  false => {
                    climbs.push(edge_index)
                    climbs.push(x0)
                    climbs.push(y0)
                    climbs.push(y1)
                    climbs.push(x0 + 1)
                  },
                }
              }
            }
            edge_index =+ 1
          }
          // A loop's label takes the clearest stretch of its run, once every
          // line is drawn.
          index = 0
          while index < runs.size() {
            let edge = graph.edges.at(get(runs.@, index)).expect("edge")
            let row = get(runs.@, index + 3)
            let size = ui::text_width(" {edge.label} ")
            let x = clear_run(drawing.@, row, get(runs.@, index + 1), get(runs.@, index + 2), size)
            if x >= 0 {
              labels.push(get(runs.@, index))
              labels.push(x - size / 2)
              labels.push(row)
              labels.push(-1)
            }
            index =+ 4
          }
          // A loop's label takes the clearest row beside its climb.
          index = 0
          while index < climbs.size() {
            let edge = graph.edges.at(get(climbs.@, index)).expect("edge")
            let line = get(climbs.@, index + 1)
            let left = get(climbs.@, index + 4)
            let size = ui::text_width(" {edge.label} ")
            let y = clear_rows(
              drawing.@,
              line,
              get(climbs.@, index + 2),
              get(climbs.@, index + 3),
              left,
              size,
            )
            if y >= 0 {
              labels.push(get(climbs.@, index))
              labels.push(left)
              labels.push(y)
              labels.push(line)
            }
            index =+ 5
          }
          // Labels go last, each over its own line and nothing else.
          mut fits = true
          let placed = mut fill(graph.edges.size(), 0)
          index = 0
          while index < labels.size() {
            let edge = graph.edges.at(get(labels.@, index)).expect("edge")
            let x0 = get(labels.@, index + 1)
            let y = get(labels.@, index + 2)
            let line = get(labels.@, index + 3)
            let text = " {edge.label} "
            let x1 = x0 + ui::text_width(text) - 1
            mut column = x0
            while column <= x1 {
              let shown = match column >= 0 and column < width {
                true => drawing.shown(column, y),
                false => "",
              }
              let clear = match line < 0 {
                true => shown == "─" or shown == "┈" or shown == "━",
                false => shown == " " or column == line,
              }
              if not clear {
                fits = false
              }
              column =+ 1
            }
            if fits {
              drawing.write(x0, y, text, canvas::Role::label, false)
              placed.set(get(labels.@, index), 1)
            }
            index =+ 4
          }
          edge_index = 0
          for edge in graph.edges {
            if edge.label != "" and get(placed.@, edge_index) == 0 {
              fits = false
            }
            edge_index =+ 1
          }
          match fits {
            true => Result::ok(drawing.@),
            false => Result::err("the edge labels don't fit"),
          }
        },
      }
    },
  }
}

// Maps layout coordinates onto the drawing. Layout stacks layers down the
// `along` axis and places each layer's members along the `cross` axis; the
// drawing flows down, up, right, or left. `span` is the layout's extent
// along the flow, and `offset` the rows above it for a title.
private struct Pen {
  flow: Flow,
  span: Int,
  offset: Int,
}

impl Pen {
  fn x(cross: Int, along: Int) Int {
    match self.flow {
      Flow::down => cross,
      Flow::up => cross,
      Flow::right => along,
      Flow::left => self.span - 1 - along,
    }
  }

  fn y(cross: Int, along: Int) Int {
    match self.flow {
      Flow::down => self.offset + along,
      Flow::up => self.offset + self.span - 1 - along,
      Flow::right => self.offset + cross,
      Flow::left => self.offset + cross,
    }
  }

  // Draws a line along the flow, at cross from a0 to a1.
  fn along(drawing: mut canvas::Canvas, c: Int, a0: Int, a1: Int, dashed: Bool, heavy: Bool) {
    let x0 = self.x(c, a0)
    let x1 = self.x(c, a1)
    let y0 = self.y(c, a0)
    let y1 = self.y(c, a1)
    match self.flow == Flow::down or self.flow == Flow::up {
      true => {
        drawing.vertical_styled(
          x0,
          minimum(y0, y1),
          maximum(y0, y1),
          canvas::Role::arrow,
          dashed,
          heavy,
        )
      },
      false => {
        drawing.horizontal_styled(
          y0,
          minimum(x0, x1),
          maximum(x0, x1),
          canvas::Role::arrow,
          dashed,
          heavy,
        )
      },
    }
  }

  // Draws a line across the flow, at along from c0 to c1.
  fn side(drawing: mut canvas::Canvas, a: Int, c0: Int, c1: Int, dashed: Bool, heavy: Bool) {
    let x0 = self.x(c0, a)
    let x1 = self.x(c1, a)
    let y0 = self.y(c0, a)
    let y1 = self.y(c1, a)
    match self.flow == Flow::down or self.flow == Flow::up {
      true => {
        drawing.horizontal_styled(
          y0,
          minimum(x0, x1),
          maximum(x0, x1),
          canvas::Role::arrow,
          dashed,
          heavy,
        )
      },
      false => {
        drawing.vertical_styled(
          x0,
          minimum(y0, y1),
          maximum(y0, y1),
          canvas::Role::arrow,
          dashed,
          heavy,
        )
      },
    }
  }

  // The arrowhead pointing along the flow.
  fn head(head: Head) Str {
    match head {
      Head::arrow => {
        match self.flow {
          Flow::down => "▼",
          Flow::up => "▲",
          Flow::right => "►",
          Flow::left => "◄",
        }
      },
      Head::cross => "×",
      Head::circle => "○",
      Head::none => "",
    }
  }
}

// The center of the window of width cells on row y, strictly between x0 and
// x1, that covers only a plain sideways line, nearest the middle; or -1.
private fn clear_run(drawing: canvas::Canvas, y: Int, x0: Int, x1: Int, width: Int) Int {
  let middle = (x0 + x1) / 2
  mut best = -1
  mut start = x0 + 1
  while start + width - 1 <= x1 - 1 {
    mut clear = true
    mut column = start
    while column < start + width {
      let shown = drawing.shown(column, y)
      if shown != "─" and shown != "┈" and shown != "━" {
        clear = false
      }
      column =+ 1
    }
    let x = start + width / 2
    if clear and (best < 0 or distance(x, middle) < distance(best, middle)) {
      best = x
    }
    start =+ 1
  }
  best
}

// The row strictly between y0 and y1, nearest the middle, where the upright
// line at column line runs plainly and the width cells from left are blank
// but for that line; or -1.
private fn clear_rows(drawing: canvas::Canvas, line: Int, y0: Int, y1: Int, left: Int, width: Int) Int {
  let middle = (y0 + y1) / 2
  mut best = -1
  mut y = y0 + 1
  while y < y1 {
    let upright = drawing.shown(line, y)
    mut clear = upright == "│" or upright == "┊" or upright == "┃"
    mut column = left
    while column < left + width {
      let outside = column < 0 or column >= drawing.width
      if outside or column != line and drawing.shown(column, y) != " " {
        clear = false
      }
      column =+ 1
    }
    if clear and (best < 0 or distance(y, middle) < distance(best, middle)) {
      best = y
    }
    y =+ 1
  }
  best
}

private fn edges_into(graph: Graph, node: Int) Int {
  mut total = 0
  for edge in graph.edges {
    if edge.to == node {
      total =+ 1
    }
  }
  total
}

private fn edges_from(graph: Graph, node: Int) Int {
  mut total = 0
  for edge in graph.edges {
    if edge.from == node {
      total =+ 1
    }
  }
  total
}

// Whether an edge into node carries a label on its drop, so the drop stays
// centered under the label.
private fn has_drop_label(graph: Graph, spots: [Spot], node: Int) Bool {
  mut found = false
  mut index = 0
  for edge in graph.edges {
    let spot = spots.at(index).or(Spot::none)
    if edge.to == node and spot == Spot::drop {
      found = true
    }
    index =+ 1
  }
  found
}

// Draws a node's outline in its shape, with its text inside.
private fn draw_node(
  drawing: mut canvas::Canvas,
  node: Node,
  x0: Int,
  top: Int,
  box: Int,
  height: Int,
) {
  let x1 = x0 + box - 1
  let bottom = top + height - 1
  let middle = top + height / 2
  let rounded = node.shape == Shape::round or node.shape == Shape::stadium or node.shape == Shape::circle
  drawing.outline(x0, top, x1, bottom, canvas::Role::frame, rounded)
  match node.shape {
    Shape::stadium => {
      drawing.write(x0, middle, "(", canvas::Role::frame, false)
      drawing.write(x1, middle, ")", canvas::Role::frame, false)
    },
    Shape::database => {
      drawing.write(x0, top, "╓", canvas::Role::frame, false)
      drawing.write(x1, top, "╖", canvas::Role::frame, false)
      mut y = top + 1
      while y < bottom {
        drawing.write(x0, y, "║", canvas::Role::frame, false)
        drawing.write(x1, y, "║", canvas::Role::frame, false)
        y =+ 1
      }
      drawing.write(x0, bottom, "╙", canvas::Role::frame, false)
      drawing.write(x1, bottom, "╜", canvas::Role::frame, false)
    },
    Shape::decision => {
      drawing.write(x0, top, "╱", canvas::Role::frame, false)
      drawing.write(x1, top, "╲", canvas::Role::frame, false)
      drawing.write(x0, bottom, "╲", canvas::Role::frame, false)
      drawing.write(x1, bottom, "╱", canvas::Role::frame, false)
    },
    _ => (),
  }
  drawing.write(
    x0 + (box - ui::text_width(node.text)) / 2,
    middle,
    node.text,
    canvas::Role::label,
    false,
  )
}

private fn distance(a: Int, b: Int) Int {
  match a > b {
    true => a - b,
    false => b - a,
  }
}

// The lines that cross a run when star a runs on a track above star b: b's
// stems pass down through a's run, and a's drops through b's, except where
// they are the run's own stem or drop.
private fn crossings_above(a: Star, b: Star) Int {
  mut total = 0
  for x in b.stems {
    if x >= a.left and x <= a.right and (not has(a.stems, x)) {
      total =+ 1
    }
  }
  for x in a.drops {
    if x >= b.left and x <= b.right and (not has(b.drops, x)) {
      total =+ 1
    }
  }
  total
}

private fn has(values: [Int], value: Int) Bool {
  mut found = false
  for each in values {
    if each == value {
      found = true
    }
  }
  found
}

// The stroke of the edge whose segment enters vertex.
private fn stroke_into(graph: Graph, segments: [Segment], vertex: Int) Stroke {
  mut stroke = Stroke::solid
  for segment in segments {
    if segment.to == vertex {
      stroke = graph.edges.at(segment.edge).expect("edge").stroke
    }
  }
  stroke
}

// The number of segments using each port.
private fn uses(ports: [Int]) [Int] {
  mut top = 0
  for port in ports {
    top = maximum(top, port + 1)
  }
  let counts = mut fill(top, 0)
  for port in ports {
    counts.set(port, get(counts.@, port) + 1)
  }
  counts.@
}

// Each segment's port offset from its vertex's middle: a vertex's ports sit
// two cells apart, ordered by the mean position of the vertices at their
// lines' other ends, then by port.
private fn port_offsets(segments: [Segment], ports: [Int], center: [Int], stems: Bool) [Int] {
  mut top = 0
  for port in ports {
    top = maximum(top, port + 1)
  }
  let owner = mut fill(top, -1)
  let sums = mut fill(top, 0)
  let counts = mut fill(top, 0)
  mut vertices = 0
  mut index = 0
  for segment in segments {
    let port = get(ports, index)
    let vertex = match stems {
      true => segment.from,
      false => segment.to,
    }
    let far = match stems {
      true => get(center, segment.to),
      false => get(center, segment.from),
    }
    owner.set(port, vertex)
    sums.set(port, get(sums.@, port) + far)
    counts.set(port, get(counts.@, port) + 1)
    vertices = maximum(vertices, vertex + 1)
    index =+ 1
  }
  let lists = mut List::new<[Int]>()
  mut vertex = 0
  while vertex < vertices {
    lists.push([])
    vertex =+ 1
  }
  mut port = 0
  while port < top {
    let vertex = get(owner.@, port)
    if vertex >= 0 {
      let grown = mut lists.at(vertex).or([])
      grown.push(port)
      lists.set(vertex, grown.@)
    }
    port =+ 1
  }
  let offset_of = mut fill(top, 0)
  for list in lists {
    for mine in list {
      mut rank = 0
      for other in list {
        let before = get(sums.@, other) * get(counts.@, mine) < get(sums.@, mine) * get(counts.@, other)
        let tied = get(sums.@, other) * get(counts.@, mine) == get(sums.@, mine) * get(counts.@, other)
        if before or tied and other < mine {
          rank =+ 1
        }
      }
      offset_of.set(mine, 2 * rank - (list.size() - 1))
    }
  }
  let offsets = mut List::new<Int>()
  for each in ports {
    offsets.push(get(offset_of.@, each))
  }
  offsets.@
}
