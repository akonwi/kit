test fn misread_names_are_rejected_instead_of_invented() Void!Str {
  try expect_rejected("client-xhr->>server: x", "`hr->>server` isn't a participant name")
  try expect_rejected("Alice: says ->> Bob", "`Alice: says` isn't a participant name")
  try expect_rejected("Note over A,: x", "a participant needs a name")
  try expect_rejected("participant A as", "`A as` needs a label after `as`")
  try expect_rejected("Note left of A,B: x", "`A,B` isn't a participant name")
  try expect_rejected("A->>B: x\nloop\nend loop", "unexpected text after `end`")
  expect_rejected("autonumber ten", "`autonumber` takes whole numbers")
}

test fn keywords_match_in_any_case() Void!Str {
  expect_drawing(
    "Participant A\nLOOP\nA->>A\nEnd",
    [
      "┌───┐",
      "│ A │",
      "└─┬─┘",
      "  │",
      "┌ loop ─┐",
      "│ ├──┐  │",
      "│ │  │  │",
      "│ │◄─┘  │",
      "│ │     │",
      "└─┼─────┘",
      "  │",
    ],
  )
}

test fn diagrams_past_the_limits_are_rejected() Void!Str {
  let crowd = mut List::new<Str>()
  mut index = 0
  while index <= max_participants {
    crowd.push("participant P{index}")
    index =+ 1
  }
  try expect_rejected(strings::Join(crowd, "\n"), "more than {max_participants} participants")
  let chatter = mut List::new<Str>()
  index = 0
  while index <= max_statements {
    chatter.push("A->>B: {index}")
    index =+ 1
  }
  try expect_rejected(strings::Join(chatter, "\n"), "more than {max_statements} statements")
  let wide = mut List::new<Str>()
  index = 0
  while index < 12 {
    wide.push("participant P{index} as {strings::Repeat("w", 40)}")
    index =+ 1
  }
  expect_rejected(strings::Join(wide, "\n"), "the diagram is wider than {max_width} columns")
}

test fn long_text_is_cut_short() Void!Str {
  let text = clean(strings::Repeat("word ", 20))
  try testing::assert(ui::text_width(text) == max_text, "cut text is {ui::text_width(text)} cells")
  testing::assert(strings::HasSuffix(text, "…"), "cut text ends with an ellipsis: {text}")
}
