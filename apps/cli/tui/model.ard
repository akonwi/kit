use ard/async

use cooper/cui
use cooper/keymap
use cooper/ui
use go:github.com/akonwi/kit/internal/httpapi
use go:github.com/akonwi/kit/internal/protocol
use go:kit/ffi/contextbridge
use kit/tui/format
use kit/tui/modal
use kit/tui/palette
use kit/tui/spinner
use kit/tui/theme

// Props contains the server-authoritative catalog and shell-owned transition
// callbacks for the model picker.
struct Props {
  themes: theme::Context,
  transport: httpapi::Transport,
  lifetime: contextbridge::Cancellation,
  session: protocol::SessionInfo,
  dismiss: keymap::SimpleCommand,
  applied: fn(protocol::ConfigureSessionResult),
}

struct Picker {
  props: Props,
  models: [protocol::ModelCapability],
  loading: Bool,
  pending: Bool,
  error: Str,
  generation: Int,
  context: cui::Context?,
  query: Str,
  selection: Str,
  hover: Str,
  hidden_above: Bool,
  hidden_below: Bool,
  viewport: Int,
  list: mut cui::VirtualListRef,
}

fn new(props: mut Props) mut Picker {
  (mut Picker{
    props: props.@,
    models: [],
    loading: true,
    pending: false,
    error: "",
    generation: 0,
    context: Maybe::new<cui::Context>(),
    query: "",
    selection: props.session.Model,
    hover: "",
    hidden_above: false,
    hidden_below: false,
    viewport: 0,
    list: cui::virtual_list_ref(),
  })
}

private fn catalog(models: [protocol::ModelCapability], pending: Bool) [palette::Item] {
  let result = mut List::new<palette::Item>()
  for model in models {
    let unavailable = match model.Available and not pending {
      true => "",
      false => "unavailable",
    }
    result.push(
      palette::Item{
        key: model.ID,
        label: model.Name,
        hint: model.ID,
        meta: "{format::usage_integer(model.ContextWindow)} context",
        description: "",
        search_terms: [model.Provider, model.API],
        disabled_reason: unavailable,
      },
    )
  }
  result.@
}

impl cui::Lifecycle for Picker {
  fn mut mounted(ctx: cui::Context) {
    self.context = Maybe::new(ctx)
    self.load(ctx)
  }

  fn mut unmounting(ctx: cui::Context) {
    self.generation =+ 1
  }
}

impl Picker {
  private fn mut load(ctx: cui::Context) {
    self.generation =+ 1
    let generation = self.generation
    let transport = self.props.transport
    let lifetime = self.props.lifetime
    let dispatch = ctx.dispatch
    async::start(fn() {
      let result = httpapi::Call<httpapi::ServerPath, httpapi::NoBody, protocol::ModelCatalog>(
        lifetime.Context,
        transport,
        httpapi::ListModels,
        httpapi::ServerPath{},
        httpapi::NoBody{},
      )
      let _ = dispatch(fn() {
        if self.generation == generation {
          self.loading = false
          match result {
            ok(catalog) => { self.models = catalog.Models },
            err(failure) => { self.error = failure.error() },
          }
        }
      })
    })
  }

  private fn mut apply(model: Str, ctx: cui::Context) {
    if self.pending {
      ()
    } else {
      self.pending = true
      self.error = ""
      self.generation =+ 1
      let generation = self.generation
      let transport = self.props.transport
      let lifetime = self.props.lifetime
      let session = self.props.session
      let dispatch = ctx.dispatch
      async::start(fn() {
        let result = httpapi::Call<httpapi::SessionPath, protocol::ConfigureSessionInput, protocol::ConfigureSessionResult>(
          lifetime.Context,
          transport,
          httpapi::ConfigureSession,
          httpapi::SessionPath{SessionID: session.ID},
          protocol::ConfigureSessionInput{ExpectedRevision: session.ConfigurationRevision, Model: model},
        )
        let _ = dispatch(fn() {
          if self.generation == generation {
            self.pending = false
            match result {
              ok(applied) => self.props.applied(applied),
              err(failure) => { self.error = failure.error() },
            }
          }
        })
      })
    }
  }

  private fn mut picker(catalog: [palette::Item]) palette::Props {
    palette::Props{
      themes: self.props.themes,
      placeholder: "Search models…",
      catalog: catalog,
      query: self.query,
      filter_query: "",
      selection: self.selection,
      hovered: self.hover,
      hidden_above: self.hidden_above,
      hidden_below: self.hidden_below,
      on_query_change: fn(query: Str) {
        self.query = query
        self.hover = ""
        let next = palette::first_enabled(
          palette::items(
            palette::Props{
              themes: self.props.themes,
              placeholder: "",
              catalog: catalog,
              query: query,
              filter_query: "",
              selection: "",
              hovered: "",
              hidden_above: false,
              hidden_below: false,
              on_query_change: fn(value: Str) {},
              on_selection_change: fn(value: Str) {},
              on_hover_change: fn(value: Str) {},
              on_activate: fn(item: palette::Item) {},
            },
          ),
        )
        if next != "" {
          self.selection = next
        }
      },
      on_selection_change: fn(selection: Str) {
        self.selection = selection
      },
      on_hover_change: fn(hover: Str) {
        self.hover = hover
      },
      on_activate: fn(item: palette::Item) {
        if item.disabled_reason == "" {
          match self.context {
            context => self.apply(item.key, context),
            _ => (),
          }
        }
      },
    }
  }

  private fn mut viewport(catalog: [palette::Item]) palette::Viewport {
    palette::Viewport{
      list: self.list,
      on_update: fn(update: cui::VirtualListUpdate, ctx: cui::Context) {
        let visible = palette::items(self.picker(catalog))
        self.hidden_above = update.state.visible_range.start > 0
        self.hidden_below = update.state.visible_range.end < visible.size()
        self.viewport = update.state.viewport_height
      },
      on_page: fn(direction: Int) {
        let step = match self.viewport > 1 {
          true => self.viewport - 1,
          false => 1,
        }
        let _ = self.list.current.map(fn(list) {
          list.scroll_by(direction * step)
        })
      },
    }
  }
}

impl cui::Component for Picker {
  fn mut render() cui::View {
    match self.loading {
      true => {
        modal::dialog(
          self.props.themes,
          modal::Dialog{
            placement: modal::Placement::picker,
            title: "",
            meta: "",
            header: [],
            body: cui::box(
              [spinner::spinner()],
              styles: ui::style(
                padding: ui::Edges{
                  top: ui::cells(1),
                  right: ui::cells(1),
                  bottom: ui::cells(1),
                  left: ui::cells(1),
                },
              ),
            ),
            footer: Maybe::new<cui::View>(),
            autofocus: true,
            dismiss: self.props.dismiss,
            commands: Maybe::new<[keymap::Command]>(),
            bindings: Maybe::new<[keymap::Binding]>(),
          },
        )
      },
      false => {
        match self.error != "" {
          true => {
            modal::dialog(
              self.props.themes,
              modal::Dialog{
                placement: modal::Placement::centered,
                title: "Models",
                meta: "",
                header: [],
                body: cui::text(
                  self.error,
                  styles: ui::style(
                    padding: ui::Edges{
                      top: ui::cells(1),
                      right: ui::cells(1),
                      bottom: ui::cells(1),
                      left: ui::cells(1),
                    },
                  ),
                  text_style: ui::text_style(foreground: self.props.themes.current().danger_text),
                ),
                footer: Maybe::new<cui::View>(),
                autofocus: true,
                dismiss: self.props.dismiss,
                commands: Maybe::new<[keymap::Command]>(),
                bindings: Maybe::new<[keymap::Binding]>(),
              },
            )
          },
          false => {
            let catalog = catalog(self.models, self.pending)
            let picker = self.picker(catalog)
            let navigation = palette::navigation(picker)
            modal::dialog(
              self.props.themes,
              modal::Dialog{
                placement: modal::Placement::picker,
                title: "Select model",
                meta: "",
                header: palette::header(picker),
                body: palette::body(picker, self.viewport(catalog)),
                footer: Maybe::new(
                  cui::box(
                    [
                      cui::text(
                        "↑↓ move · enter apply · esc close",
                        text_style: ui::text_style(foreground: self.props.themes.current().muted),
                      ),
                    ],
                    styles: ui::style(
                      padding: ui::Edges{
                        top: ui::cells(0),
                        right: ui::cells(1),
                        bottom: ui::cells(0),
                        left: ui::cells(1),
                      },
                    ),
                  ),
                ),
                autofocus: false,
                dismiss: self.props.dismiss,
                commands: Maybe::new([navigation.up, navigation.down]),
                bindings: Maybe::new(
                  [
                    keymap::binding(keymap::key("up"), navigation.up.with()),
                    keymap::binding(keymap::key("down"), navigation.down.with()),
                  ],
                ),
              },
            )
          },
        }
      },
    }
  }
}
