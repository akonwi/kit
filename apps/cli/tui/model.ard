use ard/async

use cooper/cui
use cooper/keymap
use cooper/ui
use go:github.com/akonwi/kit/internal/httpapi
use go:github.com/akonwi/kit/internal/protocol
use go:kit/ffi/contextbridge
use kit/tui/format
use kit/tui/modal
use kit/tui/palette
use kit/tui/spinner
use kit/tui/theme

// Props contains the server-authoritative catalog and shell-owned transition
// callbacks for the model picker.
struct Props {
  themes: theme::Context,
  transport: httpapi::Transport,
  lifetime: contextbridge::Cancellation,
  session: protocol::SessionInfo,
  dismiss: keymap::SimpleCommand,
  applied: fn(protocol::ConfigureSessionResult),
}

struct Picker {
  props: Props,
  models: [protocol::ModelCapability],
  loading: Bool,
  pending: Bool,
  error: Str,
  generation: Int,
  context: cui::Context?,
}

fn new(props: mut Props) mut Picker {
  (mut Picker{
    props: props.@,
    models: [],
    loading: true,
    pending: false,
    error: "",
    generation: 0,
    context: Maybe::new<cui::Context>(),
  })
}

private fn catalog(models: [protocol::ModelCapability], pending: Bool) [palette::Item] {
  let result = mut List::new<palette::Item>()
  for model in models {
    let unavailable = match model.Available and not pending {
      true => "",
      false => "unavailable",
    }
    result.push(
      palette::Item{
        key: model.ID,
        label: model.Name,
        hint: model.ID,
        meta: "{format::context_window(model.ContextWindow)} context",
        description: "",
        search_terms: [model.Provider, model.API],
        disabled_reason: unavailable,
      },
    )
  }
  result.@
}

impl cui::Lifecycle for Picker {
  fn mut mounted(ctx: cui::Context) {
    self.context = Maybe::new(ctx)
    self.load(ctx)
  }

  fn mut unmounting(ctx: cui::Context) {
    self.generation =+ 1
  }
}

impl Picker {
  private fn mut load(ctx: cui::Context) {
    self.generation =+ 1
    let generation = self.generation
    let transport = self.props.transport
    let lifetime = self.props.lifetime
    let dispatch = ctx.dispatch
    async::start(fn() {
      let result = httpapi::Call<httpapi::ServerPath, httpapi::NoBody, protocol::ModelCatalog>(
        lifetime.Context,
        transport,
        httpapi::ListModels,
        httpapi::ServerPath{},
        httpapi::NoBody{},
      )
      let _ = dispatch(fn() {
        if self.generation == generation {
          self.loading = false
          match result {
            ok(catalog) => { self.models = catalog.Models },
            err(failure) => { self.error = failure.error() },
          }
        }
      })
    })
  }

  private fn mut apply(model: Str, ctx: cui::Context) {
    if self.pending {
      ()
    } else {
      self.pending = true
      self.error = ""
      self.generation =+ 1
      let generation = self.generation
      let transport = self.props.transport
      let lifetime = self.props.lifetime
      let session = self.props.session
      let dispatch = ctx.dispatch
      async::start(fn() {
        let result = httpapi::Call<httpapi::SessionPath, protocol::ConfigureSessionInput, protocol::ConfigureSessionResult>(
          lifetime.Context,
          transport,
          httpapi::ConfigureSession,
          httpapi::SessionPath{SessionID: session.ID},
          protocol::ConfigureSessionInput{ExpectedRevision: session.ConfigurationRevision, Model: model},
        )
        let _ = dispatch(fn() {
          if self.generation == generation {
            self.pending = false
            match result {
              ok(applied) => self.props.applied(applied),
              err(failure) => { self.error = failure.error() },
            }
          }
        })
      })
    }
  }
}

impl cui::Component for Picker {
  fn mut render() cui::View {
    match self.loading {
      true => {
        modal::dialog(
          self.props.themes,
          modal::Dialog{
            placement: modal::Placement::picker,
            title: "",
            meta: "",
            header: [],
            body: cui::box(
              [spinner::spinner()],
              styles: ui::style(
                padding: ui::Edges{
                  top: ui::cells(1),
                  right: ui::cells(1),
                  bottom: ui::cells(1),
                  left: ui::cells(1),
                },
              ),
            ),
            footer: Maybe::new<cui::View>(),
            autofocus: true,
            dismiss: self.props.dismiss,
            commands: Maybe::new<[keymap::Command]>(),
            bindings: Maybe::new<[keymap::Binding]>(),
          },
        )
      },
      false => {
        match self.error != "" {
          true => {
            modal::dialog(
              self.props.themes,
              modal::Dialog{
                placement: modal::Placement::centered,
                title: "Models",
                meta: "",
                header: [],
                body: cui::text(
                  self.error,
                  styles: ui::style(
                    padding: ui::Edges{
                      top: ui::cells(1),
                      right: ui::cells(1),
                      bottom: ui::cells(1),
                      left: ui::cells(1),
                    },
                  ),
                  text_style: ui::text_style(foreground: self.props.themes.current().danger_text),
                ),
                footer: Maybe::new<cui::View>(),
                autofocus: true,
                dismiss: self.props.dismiss,
                commands: Maybe::new<[keymap::Command]>(),
                bindings: Maybe::new<[keymap::Binding]>(),
              },
            )
          },
          false => {
            cui::child(
              palette::new_picker,
              palette::PickerProps{
                themes: self.props.themes,
                catalog: catalog(self.models, self.pending),
                placeholder: "Search models…",
                initial_selection: self.props.session.Model,
                title: "Select model",
                footer: "↑↓ move · enter apply · esc close",
                dismiss: self.props.dismiss,
                on_activate: fn(item: palette::Item) {
                  match self.context {
                    context => self.apply(item.key, context),
                    _ => (),
                  }
                },
              },
            )
          },
        }
      },
    }
  }
}
