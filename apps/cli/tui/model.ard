use cooper/cui
use cooper/keymap
use cooper/ui
use go:github.com/akonwi/kit/internal/protocol
use kit/tui/format
use kit/tui/modal
use kit/tui/palette
use kit/tui/spinner
use kit/tui/theme

// Props contains the server-authoritative catalog and shell-owned transition
// callbacks for the model picker.
struct Props {
  themes: theme::Context,
  models: [protocol::ModelCapability],
  current_model: Str,
  loading: Bool,
  pending: Bool,
  error: Str,
  dismiss: keymap::SimpleCommand,
  choose: fn(Str),
}

struct Picker {
  props: Props,
  query: Str,
  selection: Str,
  hover: Str,
  hidden_above: Bool,
  hidden_below: Bool,
  viewport: Int,
  list: mut cui::VirtualListRef,
}

fn new(props: mut Props) mut Picker {
  (mut Picker{
    props: props.@,
    query: "",
    selection: props.current_model,
    hover: "",
    hidden_above: false,
    hidden_below: false,
    viewport: 0,
    list: cui::virtual_list_ref(),
  })
}

private fn catalog(props: Props) [palette::Item] {
  let result = mut List::new<palette::Item>()
  for model in props.models {
    let current = match model.ID == props.current_model {
      true => "current",
      false => "",
    }
    let unavailable = match model.Available and not props.pending {
      true => "",
      false => "unavailable",
    }
    result.push(
      palette::Item{
        key: model.ID,
        label: model.Name,
        hint: "",
        meta: current,
        description: "{model.Provider} · {format::usage_integer(model.ContextWindow)} token context",
        search_terms: [model.ID, model.Provider, model.API],
        disabled_reason: unavailable,
      },
    )
  }
  result.@
}

impl Picker {
  private fn mut picker(catalog: [palette::Item]) palette::Props {
    palette::Props{
      themes: self.props.themes,
      placeholder: "Search models…",
      catalog: catalog,
      query: self.query,
      filter_query: "",
      selection: self.selection,
      hovered: self.hover,
      hidden_above: self.hidden_above,
      hidden_below: self.hidden_below,
      on_query_change: fn(query: Str) {
        self.query = query
        self.hover = ""
        let next = palette::first_enabled(
          palette::items(
            palette::Props{
              themes: self.props.themes,
              placeholder: "",
              catalog: catalog,
              query: query,
              filter_query: "",
              selection: "",
              hovered: "",
              hidden_above: false,
              hidden_below: false,
              on_query_change: fn(value: Str) {},
              on_selection_change: fn(value: Str) {},
              on_hover_change: fn(value: Str) {},
              on_activate: fn(item: palette::Item) {},
            },
          ),
        )
        if next != "" {
          self.selection = next
        }
      },
      on_selection_change: fn(selection: Str) {
        self.selection = selection
      },
      on_hover_change: fn(hover: Str) {
        self.hover = hover
      },
      on_activate: fn(item: palette::Item) {
        if item.disabled_reason == "" {
          self.props.choose(item.key)
        }
      },
    }
  }

  private fn mut viewport(catalog: [palette::Item]) palette::Viewport {
    palette::Viewport{
      list: self.list,
      on_update: fn(update: cui::VirtualListUpdate, ctx: cui::Context) {
        let visible = palette::items(self.picker(catalog))
        self.hidden_above = update.state.visible_range.start > 0
        self.hidden_below = update.state.visible_range.end < visible.size()
        self.viewport = update.state.viewport_height
      },
      on_page: fn(direction: Int) {
        let step = match self.viewport > 1 {
          true => self.viewport - 1,
          false => 1,
        }
        let _ = self.list.current.map(fn(list) {
          list.scroll_by(direction * step)
        })
      },
    }
  }
}

impl cui::Component for Picker {
  fn mut render() cui::View {
    match self.props.loading {
      true => {
        modal::dialog(
          self.props.themes,
          modal::Dialog{
            placement: modal::Placement::picker,
            title: "",
            meta: "",
            header: [],
            body: cui::box(
              [spinner::spinner()],
              styles: ui::style(
                padding: ui::Edges{
                  top: ui::cells(1),
                  right: ui::cells(1),
                  bottom: ui::cells(1),
                  left: ui::cells(1),
                },
              ),
            ),
            footer: Maybe::new<cui::View>(),
            autofocus: true,
            dismiss: self.props.dismiss,
            commands: Maybe::new<[keymap::Command]>(),
            bindings: Maybe::new<[keymap::Binding]>(),
          },
        )
      },
      false => {
        match self.props.error != "" {
          true => {
            modal::dialog(
              self.props.themes,
              modal::Dialog{
                placement: modal::Placement::centered,
                title: "Models",
                meta: "",
                header: [],
                body: cui::text(
                  self.props.error,
                  styles: ui::style(
                    padding: ui::Edges{
                      top: ui::cells(1),
                      right: ui::cells(1),
                      bottom: ui::cells(1),
                      left: ui::cells(1),
                    },
                  ),
                  text_style: ui::text_style(foreground: self.props.themes.current().danger_text),
                ),
                footer: Maybe::new<cui::View>(),
                autofocus: true,
                dismiss: self.props.dismiss,
                commands: Maybe::new<[keymap::Command]>(),
                bindings: Maybe::new<[keymap::Binding]>(),
              },
            )
          },
          false => {
            let catalog = catalog(self.props)
            let picker = self.picker(catalog)
            let navigation = palette::navigation(picker)
            modal::dialog(
              self.props.themes,
              modal::Dialog{
                placement: modal::Placement::picker,
                title: "",
                meta: "",
                header: palette::header(picker),
                body: palette::body(picker, self.viewport(catalog)),
                footer: Maybe::new<cui::View>(),
                autofocus: false,
                dismiss: self.props.dismiss,
                commands: Maybe::new([navigation.up, navigation.down]),
                bindings: Maybe::new(
                  [
                    keymap::binding(keymap::key("up"), navigation.up.with()),
                    keymap::binding(keymap::key("down"), navigation.down.with()),
                  ],
                ),
              },
            )
          },
        }
      },
    }
  }
}
