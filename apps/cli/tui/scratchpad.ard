use go:api/contract as protocol
use cooper/cui
use cooper/event
use cooper/ui
use kit/tui/theme

// Props projects the Shell's session-scoped read-only snapshot into a purely
// presentational pane. No Scratchpad component remains mounted while inactive.
struct Props {
  themes: theme::Context,
  record: protocol::Scratchpad?,
  loading: Bool,
  failure: Str,
  retry: fn() Bool,
}

fn pane(props: Props) cui::View {
  let colors = props.themes.current()
  if props.loading {
    cui::box(
      [cui::text("Loading scratchpad…", text_style: ui::text_style(foreground: colors.muted))],
      styles: ui::style(
        flex_grow: 1.0,
        padding: ui::Edges{
          top: ui::cells(1),
          right: ui::cells(1),
          bottom: ui::cells(1),
          left: ui::cells(1),
        },
      ),
    )
  } else {
    match props.record {
      record => {
        cui::box(
          [
            cui::scroll_box(
              // Scratchpad is pointer-scrollable but never participates in
              // keyboard focus; the Composer remains the sole input owner.
              [
                cui::text(
                  record.Content,
                  selectable: true,
                  selection_style: theme::selection_style(colors),
                  styles: ui::style(width: ui::percent(100.0), flex_shrink: 0.0),
                ),
              ],
              key: "scratchpad-scroll",
              focusable: false,
              styles: ui::style(
                width: ui::percent(100.0),
                flex_grow: 1.0,
                flex_basis: ui::cells(0),
                padding: ui::Edges{
                  top: ui::cells(0),
                  right: ui::cells(1),
                  bottom: ui::cells(0),
                  left: ui::cells(1),
                },
              ),
            ),
            cui::text(
              "Read-only",
              styles: ui::style(
                flex_shrink: 0.0,
                padding: ui::Edges{
                  top: ui::cells(0),
                  right: ui::cells(1),
                  bottom: ui::cells(0),
                  left: ui::cells(1),
                },
              ),
              text_style: ui::text_style(foreground: colors.muted),
            ),
          ],
          styles: ui::style(
            width: ui::percent(100.0),
            flex_grow: 1.0,
            flex_direction: ui::FlexDirection::column,
            overflow: ui::Overflow::hidden,
          ),
        )
      },
      _ => {
        cui::box(
          [
            cui::text(
              "Load failed: {props.failure}",
              text_style: ui::text_style(foreground: colors.danger_text),
            ),
            cui::text("Retry", text_style: ui::text_style(foreground: colors.foreground, bold: true)),
          ],
          styles: ui::style(
            flex_grow: 1.0,
            flex_direction: ui::FlexDirection::column,
            padding: ui::Edges{
              top: ui::cells(1),
              right: ui::cells(1),
              bottom: ui::cells(1),
              left: ui::cells(1),
            },
          ),
          on_mouse: fn(mouse: mut event::MouseEvent, context: cui::Context) {
            if mouse.event_type == event::MouseEventType::up and mouse.button == event::MouseButton::left {
              let _ = props.retry()
              mouse.prevent_default()
            }
          },
        )
      },
    }
  }
}
