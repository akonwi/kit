// The root terminal-client component: session bootstrap, shell chrome, and
// the composer.

// Fills the viewport width; text beyond it is clipped.
let rule = strings::Repeat("─", 1024)

enum Phase {
  loading,
  auth,
  ready,
  failed,
}

enum ActiveModal {
  none,
  provider_picker,
}

private fn provider_catalog() [palette::Item] {
  [
    palette::Item{
      key: "codex",
      label: "OpenAI Codex",
      description: "ChatGPT plan · device code",
      search_terms: ["openai", "device"],
      disabled_reason: "",
    },
    palette::Item{
      key: "anthropic",
      label: "Anthropic",
      description: "API key",
      search_terms: ["api key"],
      disabled_reason: "",
    },
    palette::Item{
      key: "openai",
      label: "OpenAI",
      description: "API key",
      search_terms: ["api key"],
      disabled_reason: "",
    },
    palette::Item{
      key: "opencode",
      label: "OpenCode Go",
      description: "API key",
      search_terms: ["api key"],
      disabled_reason: "",
    },
    palette::Item{
      key: "claude",
      label: "Claude",
      description: "Pro or Max plan · browser",
      search_terms: ["browser", "oauth"],
      disabled_reason: "",
    },
  ]
}

struct Props {
  options: cli::TUIOptions,
  theme: theme::Theme,
  quit: fn(),
}

struct Shell {
  props: mut Props,
  phase: Phase,
  error: Str,
  context: cui::Context?,
  lifetime: contextbridge::Cancellation?,
  session: sessionclient::Session?,
  info: protocol::SessionInfo?,
  location: Str,
  messages: [transcript::Message],
  live: transcript::Live,
  run_id: Str,
  context_tokens: Int,
  context_window: Int,
  notice: Str,
  composer: Str,
  latest_out_of_view: Bool,
  active_modal: ActiveModal,
  picker_query: Str,
  picker_selection: Str,
  picker_hover: Str,
  picker_hidden_above: Bool,
  picker_hidden_below: Bool,
  picker_viewport: Int,
  picker_list: mut cui::VirtualListRef,
  connect_button: mut cui::BoxRef,
  list: mut cui::VirtualListRef,
}

fn new(props: mut Props) mut Shell {
  let phase = match props.options.Authenticated {
    true => Phase::loading,
    false => Phase::auth,
  }
  (mut Shell{
    props: props,
    phase: phase,
    error: "",
    context: Maybe::new<cui::Context>(),
    lifetime: Maybe::new<contextbridge::Cancellation>(),
    session: Maybe::new<sessionclient::Session>(),
    info: Maybe::new<protocol::SessionInfo>(),
    location: props.options.Location,
    messages: [],
    live: transcript::live(),
    run_id: "",
    context_tokens: 0,
    context_window: 0,
    notice: "",
    composer: "",
    latest_out_of_view: false,
    active_modal: ActiveModal::none,
    picker_query: "",
    picker_selection: "codex",
    picker_hover: "",
    picker_hidden_above: false,
    picker_hidden_below: false,
    picker_viewport: 0,
    picker_list: cui::virtual_list_ref(),
    connect_button: cui::box_ref(),
    list: cui::virtual_list_ref(),
  })
}

impl cui::Lifecycle for Shell {
  fn mut mounted(ctx: cui::Context) {
    let lifetime = contextbridge::WithCancel(self.props.options.Context)
    self.lifetime = Maybe::new(lifetime)
    self.context = Maybe::new(ctx)
    let definition = self.props.options.ThemeDefinition
    let _ = ctx.on_theme_changed(fn(next: cooper::Theme) {
      self.props.theme = theme::resolve(definition, next)
    })
    if self.phase == Phase::loading {
      self.bootstrap(ctx, lifetime)
    }
  }

  fn mut unmounting(ctx: cui::Context) {
    match self.lifetime {
      lifetime => lifetime.Cancel(),
      _ => (),
    }
  }
}

impl Shell {
  // Attaches in the background and applies the outcome on the UI thread.
  fn mut bootstrap(ctx: cui::Context, lifetime: contextbridge::Cancellation) {
    let options = self.props.options
    let dispatch = ctx.dispatch
    async::start(fn() {
      let result = bootstrap::attach(lifetime.Context, options)
      let location = match result {
        ok => options.ResolveLocation(lifetime.Context, ok.snapshot.Session.CWD),
        err => options.Location,
      }
      let _ = dispatch(fn() {
        match result {
          ok => self.attach(ok, location),
          err => {
            self.error = err
            self.phase = Phase::failed
          },
        }
      })
    })
  }

  // Ctrl+C clears a non-empty composer; otherwise it detaches.
  fn mut interrupt() Bool {
    match self.phase == Phase::ready and self.composer != "" {
      true => { self.composer = "" },
      false => (self.props.quit)(),
    }
    true
  }
}

// One transcript row: a message and its stable virtual-list key.
struct Entry {
  key: Str,
  message: transcript::Message,
  last: Bool,
}

// The conversation transcript. It opens at, and follows, its latest message
// until the user scrolls away; returning to the end resumes following. Short
// transcripts rest on the composer, as in the vaxis client.
fn transcript_pane(
  colors: theme::Theme,
  messages: [transcript::Message],
  session_id: Str,
  list: mut cui::VirtualListRef,
  on_update: fn(cui::VirtualListUpdate, cui::Context),
) cui::View {
  let shown = mut List::new<transcript::Message>()
  for message in messages {
    if renders(message) {
      shown.push(message)
    }
  }
  match shown.size() == 0 {
    true => empty_state(colors, "Ask a question or give a task."),
    false => {
      let entries = mut List::new<Entry>()
      for message in shown {
        let key = match message.id == "" {
          true => "pending:{entries.size()}",
          false => message.id,
        }
        entries.push(
          Entry{
            key: key,
            message: message,
            last: entries.size() == shown.size() - 1,
          },
        )
      }
      cui::virtual_list(
        entries.@,
        item_key: fn(entry: Entry) Str {
          entry.key
        },
        render_item: fn(entry: Entry) cui::View {
          transcript_row(colors, entry)
        },
        estimated_height: 4,
        overscan: 2,
        key: "transcript:{session_id}",
        ref: list,
        sticky_scroll: cui::ScrollEdge::end,
        on_update: on_update,
        styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0)),
      )
    },
  }
}

// Each row keeps a blank row above it; the last also keeps one below.
fn transcript_row(colors: theme::Theme, entry: Entry) cui::View {
  let bottom = match entry.last {
    true => 1,
    false => 0,
  }
  cui::box(
    [entry_view(colors, entry.message).or(blank())],
    styles: ui::style(
      flex_direction: ui::FlexDirection::column,
      padding: ui::Edges{
        top: ui::cells(1),
        right: ui::cells(1),
        bottom: ui::cells(bottom),
        left: ui::cells(1),
      },
    ),
  )
}

// Whether a message has visible transcript content.
fn renders(message: transcript::Message) Bool {
  match message.role {
    transcript::Role::user => message.text != "",
    transcript::Role::assistant => message.text != "",
    transcript::Role::tool => true,
    transcript::Role::bash => true,
    transcript::Role::other => false,
  }
}

fn entry_view(colors: theme::Theme, message: transcript::Message) cui::View? {
  match message.role {
    transcript::Role::user => user_entry(colors, message),
    transcript::Role::assistant => {
      let tone = match {
        message.aborted => colors.muted,
        message.is_error => colors.danger_text,
        _ => colors.foreground,
      }
      match message.text == "" {
        true => Maybe::new<cui::View>(),
        false => Maybe::new(cui::text(message.text, text_style: ui::text_style(foreground: tone))),
      }
    },
    transcript::Role::tool => Maybe::new(tool_entry(colors, message)),
    transcript::Role::bash => {
      Maybe::new(
        cui::text("$ {message.text}", text_style: ui::text_style(foreground: colors.muted)),
      )
    },
    transcript::Role::other => Maybe::new<cui::View>(),
  }
}

// A user turn: a tinted wash with half-block edges and two-cell padding.
fn user_entry(colors: theme::Theme, message: transcript::Message) cui::View? {
  match message.text == "" {
    true => Maybe::new<cui::View>(),
    false => {
      let edge = fn(glyph: Str) cui::View {
        cui::text(
          strings::Repeat(glyph, 1024),
          styles: ui::style(height: ui::cells(1), flex_shrink: 0.0),
          text_style: ui::text_style(foreground: colors.user_fill),
          wrap: ui::TextWrap::none,
        )
      }
      Maybe::new(
        cui::box(
          [
            edge("▄"),
            cui::box(
              [
                cui::text(
                  message.text,
                  text_style: ui::text_style(foreground: colors.foreground, background: colors.user_fill),
                ),
              ],
              styles: ui::style(
                background: colors.user_fill,
                padding: ui::Edges{
                  top: ui::cells(0),
                  right: ui::cells(2),
                  bottom: ui::cells(0),
                  left: ui::cells(2),
                },
              ),
            ),
            edge("▀"),
          ],
          styles: ui::style(flex_direction: ui::FlexDirection::column, flex_shrink: 0.0),
        ),
      )
    },
  }
}

fn tool_entry(colors: theme::Theme, message: transcript::Message) cui::View {
  let state = match message.tool_state {
    transcript::ToolState::planned => "planned",
    transcript::ToolState::running => "running…",
    transcript::ToolState::completed => "done",
    transcript::ToolState::failed => "failed",
    transcript::ToolState::not_run => "not run",
    transcript::ToolState::none => "",
  }
  let tone = match message.tool_state == transcript::ToolState::failed {
    true => colors.danger_text,
    false => colors.muted,
  }
  line("• {message.tool_name} {state}", ui::text_style(foreground: tone))
}

// Horizontal padding of one cell, as used by the header and footer rows.
fn inset() ui::Edges {
  ui::Edges{
    top: ui::cells(0),
    right: ui::cells(1),
    bottom: ui::cells(0),
    left: ui::cells(1),
  }
}

fn divider(color: ui::Color) cui::View {
  cui::text(
    rule,
    styles: ui::style(height: ui::cells(1), flex_shrink: 0.0),
    text_style: ui::text_style(foreground: color),
    wrap: ui::TextWrap::none,
  )
}

fn line(content: Str, style: ui::TextStyle) cui::View {
  cui::text(
    content,
    text_style: style,
    wrap: ui::TextWrap::none,
    overflow: ui::TextOverflow::ellipsis,
  )
}

fn blank() cui::View {
  cui::box([], styles: ui::style(height: ui::cells(1), flex_shrink: 0.0))
}

fn wordmark(colors: theme::Theme) [cui::View] {
  [
    line("k i t", ui::text_style(bold: true)),
    line("━━━━━━━━━━━", ui::text_style(foreground: colors.primary_text)),
  ]
}

// Centers content in the region that remains after the chrome.
fn centered(children: [cui::View]) cui::View {
  cui::box(
    children,
    styles: ui::style(
      flex_grow: 1.0,
      flex_direction: ui::FlexDirection::column,
      justify_content: ui::Justify::center,
      align_items: ui::Align::center,
    ),
  )
}

fn empty_state(colors: theme::Theme, instruction: Str) cui::View {
  let children = mut List::new<cui::View>()
  for view in wordmark(colors) {
    children.push(view)
  }
  children.push(blank())
  children.push(line(instruction, ui::text_style(foreground: colors.muted)))
  centered(children.@)
}

impl Shell {
  fn header() cui::View {
    let colors = self.props.theme
    let left = mut List::new<cui::View>()
    let right = mut List::new<ui::Span>()
    match self.info {
      session => {
        left.push(line(format::session_name(session), ui::text_style()))
        right.push(ui::span(format::model_name(session.Model)))
        let thinking = strings::TrimSpace(session.ThinkingLevel)
        if thinking != "" {
          right.push(ui::span(" ({thinking})"))
        }
        match format::context_percentage(self.context_tokens, self.context_window) {
          percentage => {
            let tone = match percentage > 90 {
              true => colors.danger_text,
              false => {
                match percentage >= 80 {
                  true => colors.warning_text,
                  false => colors.muted,
                }
              },
            }
            right.push(ui::span(" · ", style: ui::span_style(foreground: colors.muted)))
            right.push(ui::span("{percentage}%", style: ui::span_style(foreground: tone)))
          },
          _ => (),
        }
      },
      _ => left.push(line("kit", ui::text_style())),
    }
    cui::box(
      [
        cui::box(left.@, styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0))),
        cui::box(
          [cui::text(ui::styled_text(right.@), wrap: ui::TextWrap::none)],
          styles: ui::style(
            flex_grow: 2.0,
            flex_basis: ui::cells(0),
            flex_direction: ui::FlexDirection::row,
            justify_content: ui::Justify::end,
          ),
        ),
      ],
      styles: ui::style(
        height: ui::cells(1),
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::row,
        padding: inset(),
      ),
    )
  }

  fn footer() cui::View {
    let colors = self.props.theme
    let bash = strings::HasPrefix(self.composer, "!")
    let state = match strings::HasPrefix(self.composer, "!!") {
      true => "bash command · result excluded from context",
      false => {
        match bash {
          true => "bash command · result will be added to context",
          false => "",
        }
      },
    }
    let tone = match bash {
      true => colors.success_text,
      false => colors.muted,
    }
    cui::box(
      [
        cui::box(
          [line(state, ui::text_style(foreground: tone))],
          styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0)),
        ),
        cui::box(
          [line(self.location, ui::text_style(foreground: colors.muted))],
          styles: ui::style(
            flex_grow: 2.0,
            flex_basis: ui::cells(0),
            flex_direction: ui::FlexDirection::row,
            justify_content: ui::Justify::end,
          ),
        ),
      ],
      styles: ui::style(
        height: ui::cells(1),
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::row,
        padding: inset(),
      ),
    )
  }
}

impl Shell {
  fn mut body() cui::View {
    let colors = self.props.theme
    match self.phase {
      Phase::loading => empty_state(colors, "Starting Kit…"),
      Phase::auth => {
        let children = mut List::new<cui::View>()
        for view in wordmark(colors) {
          children.push(view)
        }
        children.push(blank())
        children.push(
          line("Connect an AI provider to get started.", ui::text_style(foreground: colors.muted)),
        )
        children.push(blank())
        let connect = keymap::simple_command("auth.connect", "Connect a provider", fn() Bool {
          self.active_modal = ActiveModal::provider_picker
          true
        })
        children.push(
          controls::button(
            colors,
            "Connect a provider",
            connect,
            variant: controls::ButtonVariant::primary,
            ref: self.connect_button,
          ),
        )
        centered(children.@)
      },
      Phase::failed => {
        centered(
          [
            line("Kit could not start", ui::text_style(foreground: colors.danger_text, bold: true)),
            blank(),
            cui::text(
              self.error,
              styles: ui::style(max_width: ui::cells(72)),
              text_style: ui::text_style(foreground: colors.muted),
            ),
            blank(),
            line("r retry · ctrl+c quit", ui::text_style(foreground: colors.muted)),
          ],
        )
      },
      Phase::ready => self.conversation(),
    }
  }

  fn mut conversation() cui::View {
    let colors = self.props.theme
    cui::box(
      [self.transcript_region(), self.pending_row(), divider(colors.border), self.composer_view()],
      styles: ui::style(flex_grow: 1.0, flex_direction: ui::FlexDirection::column),
    )
  }

  fn mut transcript_view() cui::View {
    let messages = mut List::new<transcript::Message>()
    for message in self.messages {
      messages.push(message)
    }
    for message in self.live.messages {
      messages.push(message)
    }
    let session_id = match self.info {
      info => info.ID,
      _ => "",
    }
    transcript_pane(
      self.props.theme,
      messages.@,
      session_id,
      self.list,
      fn(update: cui::VirtualListUpdate, ctx: cui::Context) {
        self.latest_out_of_view = not update.state.last_item_visible
      },
    )
  }

  // The latest shortcut is based on the VirtualList's committed visibility,
  // rather than estimates from its pre-layout rows. It remains hidden while
  // any portion of a tall latest reply is visible.
  fn mut transcript_region() cui::View {
    let children = mut List::new<cui::View>()
    children.push(self.transcript_view())
    if self.latest_out_of_view {
      children.push(self.latest_button())
    }
    cui::box(
      children.@,
      styles: ui::style(
        flex_grow: 1.0,
        flex_basis: ui::cells(0),
        position: ui::Position::relative,
        overflow: ui::Overflow::visible,
      ),
    )
  }

  fn latest_button() cui::View {
    let latest = keymap::simple_command("transcript.latest", "Show latest", fn() Bool {
      self.request_end()
      true
    })
    controls::button(
      self.props.theme,
      "↓ Latest",
      latest,
      variant: controls::ButtonVariant::secondary,
      compact: true,
      focusable: false,
      styles: ui::style(
        position: ui::Position::absolute,
        right: ui::cells(1),
        bottom: ui::cells(1),
        z_index: 1,
      ),
    )
  }

  fn pending_row() cui::View {
    let colors = self.props.theme
    let content = match self.notice != "" {
      true => line(self.notice, ui::text_style(foreground: colors.danger_text)),
      false => {
        match self.live.activity != "" {
          true => {
            cui::box(
              [
                spinner::spinner(styles: ui::style(foreground: colors.muted, flex_shrink: 0.0)),
                line(self.live.activity, ui::text_style(foreground: colors.muted)),
              ],
              styles: ui::style(flex_direction: ui::FlexDirection::row, gap: ui::cells(1)),
            )
          },
          false => line("", ui::text_style(foreground: colors.muted)),
        }
      },
    }
    cui::box([content], styles: ui::style(height: ui::cells(1), flex_shrink: 0.0, padding: inset()))
  }

  fn mut composer_view() cui::View {
    let colors = self.props.theme
    let editing = keymap::rebind(
      ui::default_text_area_bindings(),
      ui::TextAreaAction::insert_newline,
      [keymap::key("return", shift: true)],
    )
    let send = keymap::simple_command("composer.submit", "Send", fn() Bool {
      self.submit()
    })
    cui::text_area(
      self.composer,
      key: "composer",
      styles: ui::style(flex_shrink: 0.0, max_height: ui::cells(10), padding: inset()),
      placeholder: "Ask kit to do something…",
      placeholder_style: ui::text_style(foreground: colors.muted),
      autofocus: true,
      on_input: fn(value: Str, ctx: cui::Context) {
        self.composer = value
      },
      key_bindings: editing,
      commands: [send],
      bindings: [keymap::binding(keymap::key("return"), send.with())],
    )
  }
}

impl cui::Component for Shell {
  fn mut render() cui::View {
    let colors = self.props.theme
    let interrupt = keymap::simple_command("app.interrupt", "Clear or quit", fn() Bool {
      match self.active_modal {
        ActiveModal::none => self.interrupt(),
        _ => true,
      }
    })
    let shell = cui::box(
      [self.header(), divider(colors.border), self.body(), divider(colors.border), self.footer()],
      key: "shell.surface",
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        flex_direction: ui::FlexDirection::column,
        background: colors.background,
        foreground: colors.foreground,
      ),
      commands: [interrupt],
      bindings: [keymap::binding(keymap::key("c", ctrl: true), interrupt.with())],
      binding_scope: keymap::ScopeMode::application,
    )
    let layers = mut List::new<cui::View>()
    layers.push(shell)
    match self.active_modal {
      ActiveModal::provider_picker => layers.push(self.provider_picker_modal()),
      _ => (),
    }
    cui::box(
      layers.@,
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        position: ui::Position::relative,
        background: colors.background,
      ),
    )
  }
}

impl Shell {
  fn mut dismiss_modal() Bool {
    self.active_modal = ActiveModal::none
    match self.context {
      ctx => self.connect_button.focus(ctx),
      _ => (),
    }
    true
  }

  fn mut provider_picker_modal() cui::View {
    let catalog = provider_catalog()
    let picker = palette::Props{
      colors: self.props.theme,
      placeholder: "Search providers…",
      catalog: catalog,
      query: self.picker_query,
      selection: self.picker_selection,
      hovered: self.picker_hover,
      hidden_above: self.picker_hidden_above,
      hidden_below: self.picker_hidden_below,
      on_query_change: fn(query: Str) {
        self.picker_query = query
        self.picker_hover = ""
        let next = palette::first_enabled(
          palette::items(
            palette::Props{
              colors: self.props.theme,
              placeholder: "",
              catalog: catalog,
              query: query,
              selection: "",
              hovered: "",
              hidden_above: false,
              hidden_below: false,
              on_query_change: fn(value: Str) {},
              on_selection_change: fn(value: Str) {},
              on_hover_change: fn(value: Str) {},
              on_activate: fn(item: palette::Item) {},
            },
          ),
        )
        if next != "" {
          self.picker_selection = next
        }
        let selection = self.picker_selection
        let _ = self.picker_list.current.map(fn(list) {
          let _ = list.reveal(selection)
        })
      },
      on_selection_change: fn(selection: Str) {
        self.picker_selection = selection
        let _ = self.picker_list.current.map(fn(list) {
          let _ = list.reveal(selection)
        })
      },
      on_hover_change: fn(hovered: Str) {
        self.picker_hover = hovered
      },
      on_activate: fn(item: palette::Item) {},
    }
    let navigation = palette::navigation(picker)
    let dismiss = keymap::simple_command("auth.dismiss", "Close", fn() Bool {
      self.dismiss_modal()
    })
    modal::dialog(
      self.props.theme,
      modal::Dialog{
        // No hint footer: arrows, Enter, and Esc are intuitive primitives and
        // the provider picker has no custom bindings to teach yet.
        placement: modal::Placement::picker,
        title: "Connect a provider",
        meta: "",
        header: palette::header(picker),
        body: palette::body(picker, self.picker_viewport()),
        footer: Maybe::new<cui::View>(),
        autofocus: false,
        dismiss: dismiss,
        commands: palette::commands(navigation),
        bindings: palette::bindings(navigation),
      },
    )
  }

  // The picker list viewport: the virtual list plus its committed-visibility
  // overflow state and page controls.
  fn mut picker_viewport() palette::Viewport {
    palette::Viewport{
      list: self.picker_list,
      on_update: fn(update: cui::VirtualListUpdate, ctx: cui::Context) {
        let visible = palette::items(
          palette::Props{
            colors: self.props.theme,
            placeholder: "",
            catalog: provider_catalog(),
            query: self.picker_query,
            selection: "",
            hovered: "",
            hidden_above: false,
            hidden_below: false,
            on_query_change: fn(value: Str) {},
            on_selection_change: fn(value: Str) {},
            on_hover_change: fn(value: Str) {},
            on_activate: fn(item: palette::Item) {},
          },
        )
        self.picker_hidden_above = update.state.visible_range.start > 0
        self.picker_hidden_below = update.state.visible_range.end < visible.size()
        self.picker_viewport = update.state.viewport_height
      },
      on_page: fn(direction: Int) {
        self.page_picker(direction)
      },
    }
  }

  fn mut page_picker(direction: Int) {
    let step = match self.picker_viewport > 1 {
      true => self.picker_viewport - 1,
      false => 1,
    }
    let _ = self.picker_list.current.map(fn(list) {
      let _ = list.scroll_by(direction * step)
    })
  }
}

// Session synchronization. Workers only dispatch; every state change runs on
// the UI thread.
impl Shell {
  fn mut attach(attached: bootstrap::Attached, location: Str) {
    self.session = Maybe::new(attached.session)
    self.location = location
    self.phase = Phase::ready
    self.apply_snapshot(attached.snapshot)
    self.watch()
    self.follow_run(attached.snapshot.ActiveRunID)
  }

  // Replaces the transcript with a server snapshot unless live events have
  // already moved past it.
  fn mut apply_snapshot(snapshot: protocol::SessionSnapshot) {
    if not self.live.supersedes(snapshot) {
      self.info = Maybe::new(snapshot.Session)
      self.messages = transcript::project(snapshot.Messages)
      self.live.reset()
      self.context_tokens = snapshot.ContextTokens
      self.context_window = snapshot.ContextWindow
    }
  }

  // Watches the attached session: run starts open the run stream, and run
  // completions reconcile the transcript from a fresh snapshot. The watch
  // reconnects until the client detaches.
  fn mut watch() {
    match self.lifetime {
      lifetime => {
        match self.session {
          session => {
            match self.context {
              context => {
                let ctx = lifetime.Context
                let dispatch = context.dispatch
                async::start(fn() {
                  mut attached = true
                  while attached {
                    match sessionbridge::WatchSession(ctx, session) {
                      ok(watching) => {
                        let baseline = watching.Snapshot
                        let _ = dispatch(fn() {
                          self.apply_snapshot(baseline)
                        })
                        let updates = watching.Stream.Updates()
                        mut open = true
                        while open {
                          match updates.recv() {
                            batch => {
                              for event in batch {
                                let kind = transcript::classify(event.Kind)
                                if kind == transcript::Event::run_started {
                                  let run_id = event.RunID
                                  let _ = dispatch(fn() {
                                    self.follow_run(run_id)
                                  })
                                }
                                if kind == transcript::Event::run_finished {
                                  match session.Snapshot(ctx) {
                                    ok(settled) => {
                                      let _ = dispatch(fn() {
                                        self.apply_snapshot(settled)
                                      })
                                    },
                                    err(_) => (),
                                  }
                                }
                              }
                            },
                            _ => { open = false },
                          }
                        }
                      },
                      err(_) => (),
                    }
                    if ctx.Err().is_ok() {
                      time::Sleep(time::Millisecond * 250)
                    }
                  }
                })
              },
              _ => (),
            }
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  // Streams the events of `run_id` into the live transcript.
  fn mut follow_run(run_id: Str) {
    if run_id != "" and run_id != self.run_id {
      self.run_id = run_id
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              match self.context {
                context => {
                  let ctx = lifetime.Context
                  let dispatch = context.dispatch
                  async::start(fn() {
                    match session.Stream(ctx, run_id) {
                      ok(stream) => {
                        let updates = stream.Updates()
                        mut open = true
                        while open {
                          match updates.recv() {
                            batch => {
                              let _ = dispatch(fn() {
                                self.apply_events(run_id, batch)
                              })
                            },
                            _ => { open = false },
                          }
                        }
                      },
                      err(_) => (),
                    }
                  })
                },
                _ => (),
              }
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  fn mut apply_events(run_id: Str, batch: [protocol::SessionEvent]) {
    if run_id == self.run_id {
      // A transcript pinned to its end follows new content on its own.
      let _ = self.live.apply(batch)
      if self.live.context_window > 0 {
        self.context_tokens = self.live.context_tokens
        self.context_window = self.live.context_window
      }
    }
  }

  // Submits the composer as a prompt when no run is active.
  fn mut submit() Bool {
    let text = strings::TrimSpace(self.composer)
    if self.phase == Phase::ready and text != "" and self.live.activity == "" {
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              match self.context {
                context => {
                  self.composer = ""
                  self.notice = ""
                  self.live.submit(text)
                  self.request_end()
                  let ctx = lifetime.Context
                  let dispatch = context.dispatch
                  async::start(fn() {
                    match session.StartPrompt(ctx, text) {
                      ok(run) => {
                        let run_id = run.ID()
                        let _ = dispatch(fn() {
                          self.follow_run(run_id)
                        })
                      },
                      err(failure) => {
                        let message = failure.error()
                        let _ = dispatch(fn() {
                          if self.composer == "" {
                            self.composer = text
                          }
                          self.live.reset()
                          self.notice = message
                        })
                      },
                    }
                  })
                },
                _ => (),
              }
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
    true
  }

  // Sending a prompt returns the transcript to its end and resumes following.
  fn request_end() {
    let _ = self.list.current.map(fn(list) {
      let _ = list.scroll_to_edge(cui::ScrollEdge::end, sticky: true)
    })
  }
}
