  fn mut start_browser_login() {
    self.cancel_auth_attempt()
    match self.lifetime {
      lifetime => {
        let attempt = contextbridge::WithCancel(lifetime.Context)
        let generation = self.auth_generation
        let ui_context = self.context.expect("mounted auth shell")
        let dispatch = ui_context.dispatch
        let login = self.props.options.BrowserLogin
        let manual = Chan::new<Str>(1)
        self.active_modal = ActiveModal::browser_login
        self.auth_attempt = Maybe::new(attempt)
        self.browser_manual = Maybe::new(manual)
        self.browser_url = ""
        self.browser_code = ""
        self.auth_error = ""
        self.auth_pending = true
        async::start(fn() {
          let result = authbridge::RunBrowser(
            attempt.Context,
            login,
            manual.receiver(),
            fn(instructions: authbridge::BrowserInstructions) {
              let _ = dispatch(fn() {
                if generation == self.auth_generation {
                  self.browser_url = instructions.AuthorizationURL
                }
              })
            },
          )
          let _ = dispatch(fn() {
            if generation == self.auth_generation {
              self.auth_attempt = Maybe::new<contextbridge::Cancellation>()
              self.browser_manual = Maybe::new<Chan<Str>>()
              self.auth_pending = false
              match result {
                ok(_) => {
                  self.active_modal = ActiveModal::none
                  self.phase = Phase::loading
                  self.bootstrap(ui_context, lifetime)
                },
                err(error) => { self.auth_error = "{error}" },
              }
            }
          })
        })
      },
      _ => {
        self.active_modal = ActiveModal::browser_login
        self.auth_error = "Claude subscription login is unavailable"
      },
    }
  }

  fn mut submit_browser_code(value: Str) {
    if value != "" and self.auth_pending {
      match self.browser_manual {
        manual => {
          manual.send(value)
          self.browser_code = ""
        },
        _ => (),
      }
    }
  }

  fn mut api_key_modal() cui::View {
    let dismiss = keymap::simple_command("auth.back", "Back", fn() Bool {
      self.dismiss_modal()
    })
    let body = mut List::new<cui::View>()
    body.push(
      cui::input(
        self.auth_api_key,
        key: "auth.api-key",
        styles: ui::style(width: ui::percent(100.0)),
        placeholder: "Paste API key…",
        autofocus: not self.auth_pending,
        on_input: fn(value: Str, ctx: cui::Context) {
          if not self.auth_pending {
            self.auth_api_key = value
            self.auth_error = ""
          }
        },
        on_submit: fn(value: Str, ctx: cui::Context) {
          self.submit_api_key(value)
        },
      ),
    )
    if self.auth_error != "" {
      body.push(layout::blank())
      body.push(
        layout::line(
          self.auth_error,
          ui::text_style(foreground: self.props.themes.current().danger_text),
        ),
      )
    }
    match self.auth_pending {
      true => {
        body.push(layout::blank())
        body.push(spinner::spinner())
        body.push(
          layout::line(
            "Saving API key…",
            ui::text_style(foreground: self.props.themes.current().muted),
          ),
        )
      },
      false => (),
    }
    modal::dialog(
      self.props.themes,
      modal::Dialog{
        placement: modal::Placement::centered,
        title: "Connect {self.auth_provider_label()}",
        meta: "",
        header: [],
        body: cui::box(body.@, styles: ui::style(flex_grow: 1.0, padding: inset())),
        footer: Maybe::new<cui::View>(),
        autofocus: false,
        dismiss: dismiss,
        commands: Maybe::new<[keymap::Command]>(),
        bindings: Maybe::new<[keymap::Binding]>(),
      },
    )
  }

  fn mut submit_api_key(value: Str) {
    if self.auth_pending or value == "" {
      ()
    } else {
      match self.lifetime {
        lifetime => {
          let attempt = contextbridge::WithCancel(lifetime.Context)
          let generation = self.auth_generation
          let ui_context = self.context.expect("mounted auth shell")
          let dispatch = ui_context.dispatch
          let login = self.props.options.APIKeyLogin
          let provider = self.auth_provider_id()
          self.auth_attempt = Maybe::new(attempt)
          self.auth_pending = true
          self.auth_error = ""
          async::start(fn() {
            let result = authbridge::RunAPIKey(attempt.Context, login, provider, value)
            let _ = dispatch(fn() {
              if generation == self.auth_generation {
                self.auth_attempt = Maybe::new<contextbridge::Cancellation>()
                self.auth_pending = false
                match result {
                  ok(_) => {
                    self.auth_api_key = ""
                    self.active_modal = ActiveModal::none
                    self.phase = Phase::loading
                    self.bootstrap(ui_context, lifetime)
                  },
                  err(error) => { self.auth_error = "{error}" },
                }
              }
            })
          })
        },
        _ => { self.auth_error = "Authentication is unavailable" },
      }
    }
  }

  // complete_palette_command turns the current selected catalog row into an
  // invocation buffer. Filtering stays on its command word while arguments are
  // typed, so the selection remains stable until that word is edited.
  fn mut complete_palette_command(catalog: [palette::Item]) Bool {
    mut completed = false
    for item in catalog {
      if item.key == self.command_selection and not completed {
        self.command_query = "{item.label} "
        self.command_hover = ""
        completed = true
      }
    }
    completed
  }

  fn mut command_palette_modal() cui::View {
    let catalog = command_catalog(
      self.attached.busy(),
      self.attached.prompt_commands,
      self.attached.plugin_commands,
    )
    let picker = palette::Props{
      themes: self.props.themes,
      placeholder: "Search commands…",
      catalog: catalog,
      query: self.command_query,
      filter_query: command_word(self.command_query),
      selection: self.command_selection,
      hovered: self.command_hover,
      hidden_above: self.command_hidden_above,
      hidden_below: self.command_hidden_below,
      on_query_change: fn(query: Str) {
        self.command_query = query
        self.command_hover = ""
        let next = palette::first_enabled(
          palette::items(
            palette::Props{
              themes: self.props.themes,
              placeholder: "",
              catalog: catalog,
              query: query,
              filter_query: command_word(query),
              selection: "",
              hovered: "",
              hidden_above: false,
              hidden_below: false,
              on_query_change: fn(value: Str) {},
              on_selection_change: fn(value: Str) {},
              on_hover_change: fn(value: Str) {},
              on_activate: fn(item: palette::Item) {},
            },
          ),
        )
        if next != "" {
          self.command_selection = next
        }
        let selection = self.command_selection
        let _ = self.picker_list.current.map(fn(list) {
          let _ = list.reveal(selection)
        })
      },
      on_selection_change: fn(selection: Str) {
        self.command_selection = selection
        let _ = self.picker_list.current.map(fn(list) {
          let _ = list.reveal(selection)
        })
      },
      on_hover_change: fn(hovered: Str) {
        self.command_hover = hovered
      },
      on_activate: fn(item: palette::Item) {
        if item.disabled_reason != "" {
          self.show_toast("Command unavailable", item.disabled_reason, toast::Variant::warning, false)
        } else if item.key == "login" {
          self.finish_modal()
          self.open_provider_picker()
        } else if item.key == "quit" {
          self.props.quit()
        } else if item.key == "compact" {
          self.finish_modal()
          self.attached.compact()
        } else if item.key == "debug" {
          self.active_modal = ActiveModal::session_debug
        } else if item.key == "mcp" {
          self.active_modal = ActiveModal::mcp_status
        } else if item.key == "model" {
          self.active_modal = ActiveModal::model_picker
        } else if item.key == "theme" {
          self.active_modal = ActiveModal::theme_picker
        } else if item.key == "thinking" {
          self.active_modal = ActiveModal::thinking_picker
        } else if item.key == "name" {
          let value = strings::TrimSpace(command_args(self.command_query))
          self.rename_initial = match value == "" {
            true => self.attached.info.or(protocol::SessionInfo{}).Name,
            false => value,
          }
          self.rename_submit_immediately = value != ""
          self.active_modal = ActiveModal::rename_session
        } else if item.key == "new" {
          self.finish_modal()
          self.attached.create_sibling()
        } else if item.key == "refresh-models" {
          self.finish_modal()
          self.refresh_models()
        } else if item.key == "reload" {
          self.finish_modal()
          self.attached.reload()
        } else if item.key == "sessions" {
          self.active_modal = ActiveModal::sessions
        } else if item.key == "scratchpad" {
          self.finish_modal()
          self.open_scratchpad()
        } else if item.key == "cd" {
          let target = strings::TrimSpace(command_args(self.command_query))
          if target == "" {
            self.show_toast("Usage: /cd <path>", "", toast::Variant::warning, false)
          } else {
            self.finish_modal()
            self.attached.change_working_directory(target)
          }
        } else {
          for command in self.attached.prompt_commands {
            if item.key == "prompt:{command.Name}" {
              self.finish_modal()
              self.attached.submit_prompt_command(command.Name, command_args(self.command_query))
            }
          }
          for command in self.attached.plugin_commands {
            if item.key == "plugin:{command.Instance}:{command.ID}" {
              self.finish_modal()
              self.attached.execute_plugin_command(command, command_args(self.command_query))
            }
          }
        }
      },
    }
    let navigation = palette::navigation(picker)
    let complete = keymap::simple_command("palette.complete", "Complete command", fn() Bool {
      self.complete_palette_command(catalog)
    })
    let dismiss = keymap::simple_command("palette.dismiss", "Close", fn() Bool {
      self.dismiss_modal()
    })
    modal::dialog(
      self.props.themes,
      modal::Dialog{
        placement: modal::Placement::picker,
        title: "",
        meta: "",
        header: palette::header(picker, Maybe::new(true), Maybe::new(self.command_search)),
        body: palette::body(picker, self.command_picker_viewport()),
        footer: Maybe::new(
          cui::box(
            [
              layout::line(
                "↑↓ move · enter run · esc close",
                ui::text_style(foreground: self.props.themes.current().muted),
              ),
            ],
            styles: ui::style(padding: inset(), flex_shrink: 0.0),
          ),
        ),
        autofocus: false,
        dismiss: dismiss,
        commands: Maybe::new([navigation.up, navigation.down, complete]),
        bindings: Maybe::new(
          [
            keymap::binding(keymap::key("tab"), complete.with()),
            keymap::binding(keymap::key("up"), navigation.up.with(), keymap::Trigger::press_or_repeat),
            keymap::binding(keymap::key("down"), navigation.down.with(), keymap::Trigger::press_or_repeat),
          ],
        ),
      },
    )
  }

  fn mut command_picker_viewport() palette::Viewport {
    palette::Viewport{
      list: self.picker_list,
      on_update: fn(update: cui::VirtualListUpdate, ctx: cui::Context) {
        let visible = palette::items(
          palette::Props{
            themes: self.props.themes,
            placeholder: "",
            catalog: command_catalog(self.attached.busy(), self.attached.prompt_commands, self.attached.plugin_commands),
            query: self.command_query,
            filter_query: command_word(self.command_query),
            selection: "",
            hovered: "",
            hidden_above: false,
            hidden_below: false,
            on_query_change: fn(value: Str) {},
            on_selection_change: fn(value: Str) {},
            on_hover_change: fn(value: Str) {},
            on_activate: fn(item: palette::Item) {},
          },
        )
        self.command_hidden_above = update.state.visible_range.start > 0
        self.command_hidden_below = update.state.visible_range.end < visible.size()
        self.command_viewport = update.state.viewport_height
      },
      on_page: fn(direction: Int) {
        let step = match self.command_viewport > 1 {
          true => self.command_viewport - 1,
          false => 1,
        }
        let _ = self.picker_list.current.map(fn(list) {
          let _ = list.scroll_by(direction * step)
        })
      },
    }
  }

  fn mut provider_picker_modal() cui::View {
    let catalog = provider_catalog()
    let picker = palette::Props{
      themes: self.props.themes,
      placeholder: "Search providers…",
      catalog: catalog,
      query: self.picker_query,
      filter_query: "",
      selection: self.picker_selection,
      hovered: self.picker_hover,
      hidden_above: self.picker_hidden_above,
      hidden_below: self.picker_hidden_below,
      on_query_change: fn(query: Str) {
        self.picker_query = query
        self.picker_hover = ""
        let next = palette::first_enabled(
          palette::items(
            palette::Props{
              themes: self.props.themes,
              placeholder: "",
              catalog: catalog,
              query: query,
              filter_query: "",
              selection: "",
              hovered: "",
              hidden_above: false,
              hidden_below: false,
              on_query_change: fn(value: Str) {},
              on_selection_change: fn(value: Str) {},
              on_hover_change: fn(value: Str) {},
              on_activate: fn(item: palette::Item) {},
            },
          ),
        )
        if next != "" {
          self.picker_selection = next
        }
        let selection = self.picker_selection
        let _ = self.picker_list.current.map(fn(list) {
          let _ = list.reveal(selection)
        })
      },
      on_selection_change: fn(selection: Str) {
        self.picker_selection = selection
        let _ = self.picker_list.current.map(fn(list) {
          let _ = list.reveal(selection)
        })
      },
      on_hover_change: fn(hovered: Str) {
        self.picker_hover = hovered
      },
      on_activate: fn(item: palette::Item) {
        self.select_auth_provider(item.key)
      },
    }
    let navigation = palette::navigation(picker)
    let dismiss = keymap::simple_command("auth.dismiss", "Close", fn() Bool {
      self.dismiss_modal()
    })
    let footer = match self.auth_error != "" {
      true => {
        Maybe::new(
          cui::box(
            [
              layout::line(self.auth_error, ui::text_style(foreground: self.props.themes.current().danger_text)),
            ],
            styles: ui::style(padding: inset(), flex_shrink: 0.0),
          ),
        )
      },
      false => Maybe::new<cui::View>(),
    }
    modal::dialog(
      self.props.themes,
      modal::Dialog{
        // No hint footer: arrows, Enter, and Esc are intuitive primitives and
        // the provider picker has no custom bindings to teach yet.
        placement: modal::Placement::picker,
        title: "Connect a provider",
        meta: "",
        header: palette::header(picker, Maybe::new<Bool>(), Maybe::new<mut cui::InputRef>()),
        body: palette::body(picker, self.picker_viewport()),
        footer: footer,
        autofocus: false,
        dismiss: dismiss,
        commands: palette::commands(navigation),
        bindings: palette::bindings(navigation),
      },
    )
  }

  // The picker list viewport: the virtual list plus its committed-visibility
  // overflow state and page controls.
  fn mut picker_viewport() palette::Viewport {
    palette::Viewport{
      list: self.picker_list,
      on_update: fn(update: cui::VirtualListUpdate, ctx: cui::Context) {
        let visible = palette::items(
          palette::Props{
            themes: self.props.themes,
            placeholder: "",
            catalog: provider_catalog(),
            query: self.picker_query,
            filter_query: "",
            selection: "",
            hovered: "",
            hidden_above: false,
            hidden_below: false,
            on_query_change: fn(value: Str) {},
            on_selection_change: fn(value: Str) {},
            on_hover_change: fn(value: Str) {},
            on_activate: fn(item: palette::Item) {},
          },
        )
        self.picker_hidden_above = update.state.visible_range.start > 0
        self.picker_hidden_below = update.state.visible_range.end < visible.size()
        self.picker_viewport = update.state.viewport_height
      },
      on_page: fn(direction: Int) {
        self.page_picker(direction)
      },
    }
  }

  fn mut page_picker(direction: Int) {
    let step = match self.picker_viewport > 1 {
      true => self.picker_viewport - 1,
      false => 1,
    }
    let _ = self.picker_list.current.map(fn(list) {
      let _ = list.scroll_by(direction * step)
    })
  }
}

// Session synchronization. Workers only dispatch; every state change runs on
// the UI thread.
impl Shell {
  fn mut attach(attached: bootstrap::Attached, location: Str) {
    if self.workspace == WorkspacePane::scratchpad and self.scratchpad_control.close(false) {
      self.pending_attachment = Maybe::new(attached)
      self.pending_attachment_location = location
    } else {
      self.attach_now(attached, location)
    }
  }

  private fn mut attach_now(attached: bootstrap::Attached, location: Str) {
    self.begin_session_scope()
    self.attached = attached_session::attach(
      self.props.options,
      self.attachment_host(),
      self.session_scope_id,
      self.lifetime.expect("mounted shell"),
      attached,
      location,
    )
    self.phase = Phase::ready
    self.attached.start(attached.snapshot.ActiveTurnID)
  }

  // The root effects an attachment may request. Each callback runs inside the
  // attachment's dispatch through Shell's context.
  private fn mut attachment_host() attached_session::Host {
    let context = self.context.expect("mounted shell")
    attached_session::Host{
      dispatch: context.dispatch,
      toast: fn(title: Str, detail: Str, variant: toast::Variant, persistent: Bool) {
        self.show_toast(title, detail, variant, persistent)
      },
      attach: fn(attached: bootstrap::Attached, location: Str) {
        self.attach(attached, location)
      },
      restore_draft: fn(text: Str) {
        let _ = self.composer_control.restore_if_empty(text)
      },
      show_latest: fn() {
        let _ = self.transcript_control.show_latest()
      },
    }
  }

  // Ends the current attachment and resets the root presentation it owned.
  // A new scope invalidates queued work even when the same durable session is
  // reattached.
  private fn mut begin_session_scope() {
    self.attached.dispose()
    self.pending_attachment = Maybe::new<bootstrap::Attached>()
    self.pending_attachment_location = ""
    self.session_scope_id = self.session_scope_id + 1
    self.transcript_control = transcript_pane::control()
    self.composer_mode = ""
    let _ = self.composer_control.reset()
    self.toasts = []
    self.workspace = WorkspacePane::agent
    self.scratchpad_open = false
    self.scratchpad_control = scratchpad::pane_ref()
  }

  // Cache the authoritative record in Shell while the active pane owns its
  // draft, serialized autosave worker, and save-before-unmount handshake.
  fn mut open_scratchpad() {
    self.scratchpad_open = true
    self.show_scratchpad_workspace()
  }

  fn mut show_agent_workspace() {
    if self.workspace != WorkspacePane::scratchpad or not self.scratchpad_control.close(false) {
      self.workspace = WorkspacePane::agent
      self.focus_composer()
    }
  }

  fn mut show_scratchpad_workspace() {
    self.workspace = WorkspacePane::scratchpad
    self.attached.load_scratchpad()
  }

  fn mut close_scratchpad() {
    if self.workspace != WorkspacePane::scratchpad or not self.scratchpad_control.close(true) {
      self.workspace = WorkspacePane::agent
      self.scratchpad_open = false
      self.focus_composer()
    }
  }

  private fn mut focus_composer() {
    let _ = self.composer_control.focus()
  }

  fn mut apply_scratchpad_saved(record: protocol::Scratchpad) {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.attached.apply_scratchpad_saved(record)
        })
      },
      _ => (),
    }
  }

  fn mut apply_scratchpad_closed(close_tab: Bool) {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          match self.pending_attachment {
            attached => {
              let location = self.pending_attachment_location
              self.attach_now(attached, location)
            },
            _ => {
              self.workspace = WorkspacePane::agent
              if close_tab {
                self.scratchpad_open = false
              }
              self.focus_composer()
            },
          }
        })
      },
      _ => (),
    }
  }

  fn mut request_scratchpad_retry() Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.attached.retry_scratchpad()
        })
        true
      },
      _ => false,
    }
  }

  fn mut apply_scratchpad_notice(title: Str, detail: Str) {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.show_toast(title, detail, toast::Variant::error, true)
        })
      },
      _ => (),
    }
  }

  // Refreshes the server-authoritative provider model catalog.
  fn mut refresh_models() {
    if self.model_refresh_pending {
      self.show_toast(
        "Model refresh unavailable",
        "Model refresh is already in progress.",
        toast::Variant::warning,
        false,
      )
    } else {
      // Model discovery is client-wide, so switching attached sessions must
      // neither cancel it nor reinterpret its completion as session-local.
      match self.lifetime {
        lifetime => {
          match self.context {
            context => {
              let attempt = contextbridge::WithTimeout(lifetime.Context, Int64::from(30000))
              let client = self.props.options.Client
              let dispatch = context.dispatch
              self.model_refresh_pending = true
              async::start(fn() {
                let result = client.RefreshModels(attempt.Context)
                attempt.Cancel()
                let _ = dispatch(fn() {
                  self.model_refresh_pending = false
                  match result {
                    ok(catalog) => {
                      self.show_toast(
                        "Model catalog refreshed",
                        "{catalog.Models.size()} models available",
                        toast::Variant::info,
                        false,
                      )
                    },
                    err(failure) => {
                      self.show_toast(
                        "Model refresh failed",
                        failure.error(),
                        toast::Variant::error,
                        true,
                      )
                    },
                  }
                })
              })
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }
}

test fn a_new_session_scope_disposes_the_attachment_and_resets_root_presentation() Void!Str {
  let subject = new(
    mut Props{
      options: cli::TUIOptions{},
      themes: theme::context(theme::store(theme::system())),
      quit: fn() {},
    },
  )
  let previous = subject.attached
  previous.active = true
  let first_scope = subject.session_scope_id
  subject.composer_mode = "old mode"
  subject.toasts = [
    toast::Item{
      id: 1,
      title: "Old session warning",
      detail: "",
      variant: toast::Variant::warning,
      persistent: true,
    },
  ]
  subject.workspace = WorkspacePane::scratchpad
  subject.scratchpad_open = true

  subject.begin_session_scope()

  try testing::assert(subject.session_scope_id != first_scope, "reattachment starts a new scope")
  try testing::assert(not previous.active, "the previous attachment rejects late completions")
  try testing::assert(subject.composer_mode == "", "the previous composer mode resets")
  try testing::assert(subject.toasts.size() == 0, "session notifications reset")
  testing::assert(
    subject.workspace == WorkspacePane::agent and not subject.scratchpad_open,
    "workspace state resets",
  )
}
