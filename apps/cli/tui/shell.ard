struct Props {
  options: cli::TUIOptions,
  themes: theme::Context,
  quit: fn(),
}

struct Shell {
  props: mut Props,
  phase: Phase,
  error: Str,
  context: cui::Context?,
  lifetime: contextbridge::Cancellation?,
  session: sessionclient::Session?,
  info: protocol::SessionInfo?,
  prompt_commands: [protocol::PromptCommand],
  plugin_commands: [protocol::PluginCommand],
  follow_ups: protocol::FollowUpQueue,
  location: Str,
  messages: [transcript::Message],
  live: transcript::Live,
  run_id: Str,
  context_tokens: Int,
  context_window: Int,
  usage: protocol::SessionUsage,
  notice: Str,
  composer: Str,
  // 1 at the start of copy feedback, fading to 0 over 350ms.
  selection_copy_pulse: Float64,
  selection_copy_base: ui::Color,
  latest_out_of_view: Bool,
  start_pending: Bool,
  compact_pending: Bool,
  compact_operation_id: Str,
  abort_pending: Bool,
  abort_after_start: Bool,
  active_modal: ActiveModal,
  auth_provider: Str,
  auth_api_key: Str,
  auth_error: Str,
  auth_pending: Bool,
  auth_generation: Int,
  auth_attempt: contextbridge::Cancellation?,
  device_url: Str,
  device_code: Str,
  device_remaining_seconds: Int64,
  browser_code: Str,
  browser_manual: Chan<Str>?,
  browser_url: Str,
  picker_query: Str,
  picker_selection: Str,
  picker_hover: Str,
  picker_hidden_above: Bool,
  picker_hidden_below: Bool,
  picker_viewport: Int,
  command_query: Str,
  command_selection: Str,
  command_hover: Str,
  command_hidden_above: Bool,
  command_hidden_below: Bool,
  command_viewport: Int,
  toasts: [toast::Item],
  toast_next_id: Int,
  picker_list: mut cui::VirtualListRef,
  composer_area: mut cui::TextAreaRef,
  connect_button: mut cui::BoxRef,
  list: mut cui::VirtualListRef,
}

fn new(props: mut Props) mut Shell {
  let phase = match props.options.Authenticated {
    true => Phase::loading,
    false => Phase::auth,
  }
  (mut Shell{
    props: props,
    phase: phase,
    error: "",
    context: Maybe::new<cui::Context>(),
    lifetime: Maybe::new<contextbridge::Cancellation>(),
    session: Maybe::new<sessionclient::Session>(),
    info: Maybe::new<protocol::SessionInfo>(),
    prompt_commands: [],
    plugin_commands: [],
    follow_ups: protocol::FollowUpQueue{
      Count: 0,
      Previews: [],
      AnnotationIDs: [],
    },
    location: props.options.Location,
    messages: [],
    live: transcript::live(),
    run_id: "",
    context_tokens: 0,
    context_window: 0,
    usage: protocol::SessionUsage{
      Input: 0,
      Output: 0,
      CacheRead: 0,
      CacheWrite: 0,
      Reasoning: 0,
      TotalTokens: 0,
      Cost: protocol::SessionUsageCost{
        Input: 0.0,
        Output: 0.0,
        CacheRead: 0.0,
        CacheWrite: 0.0,
        Total: 0.0,
      },
    },
    notice: "",
    composer: "",
    selection_copy_pulse: 0.0,
    selection_copy_base: ui::rgb(0, 0, 0),
    latest_out_of_view: false,
    start_pending: false,
    compact_pending: false,
    compact_operation_id: "",
    abort_pending: false,
    abort_after_start: false,
    active_modal: ActiveModal::none,
    auth_provider: "",
    auth_api_key: "",
    auth_error: "",
    auth_pending: false,
    auth_generation: 0,
    auth_attempt: Maybe::new<contextbridge::Cancellation>(),
    device_url: "",
    device_code: "",
    device_remaining_seconds: Int64::from(0),
    browser_code: "",
    browser_manual: Maybe::new<Chan<Str>>(),
    browser_url: "",
    picker_query: "",
    picker_selection: "codex",
    picker_hover: "",
    picker_hidden_above: false,
    picker_hidden_below: false,
    picker_viewport: 0,
    command_query: "",
    command_selection: "cd",
    command_hover: "",
    command_hidden_above: false,
    command_hidden_below: false,
    command_viewport: 0,
    toasts: [],
    toast_next_id: 0,
    picker_list: cui::virtual_list_ref(),
    composer_area: cui::text_area_ref(),
    connect_button: cui::box_ref(),
    list: cui::virtual_list_ref(),
  })
}

impl cui::Lifecycle for Shell {
  fn mut mounted(ctx: cui::Context) {
    let lifetime = contextbridge::WithCancel(self.props.options.Context)
    self.lifetime = Maybe::new(lifetime)
    self.context = Maybe::new(ctx)
    let definition = self.props.options.ThemeDefinition
    let _ = ctx.on_theme_changed(fn(next: cooper::Theme) {
      self.props.themes.replace(theme::resolve(definition, next))
    })
    if self.phase == Phase::loading {
      self.bootstrap(ctx, lifetime)
    }
  }

  fn mut unmounting(ctx: cui::Context) {
    match self.lifetime {
      lifetime => lifetime.Cancel(),
      _ => (),
    }
  }
}

impl Shell {
  // Attaches in the background and applies the outcome on the UI thread.
  fn mut bootstrap(ctx: cui::Context, lifetime: contextbridge::Cancellation) {
    let options = self.props.options
    let dispatch = ctx.dispatch
    async::start(fn() {
      let result = bootstrap::attach(lifetime.Context, options)
      let location = match result {
        ok => options.ResolveLocation(lifetime.Context, ok.snapshot.Session.CWD),
        err => options.Location,
      }
      let _ = dispatch(fn() {
        match result {
          ok => self.attach(ok, location),
          err => {
            self.error = err
            self.phase = Phase::failed
          },
        }
      })
    })
  }

  // Ctrl+C clears a non-empty composer; otherwise it detaches.
  fn mut interrupt() Bool {
    match self.phase == Phase::ready and self.composer != "" {
      true => { self.composer = "" },
      false => (self.props.quit)(),
    }
    true
  }
}

// One transcript row: a message and its stable virtual-list key.
struct Entry {
  key: Str,
  message: transcript::Message,
  last: Bool,
}

// The conversation transcript. It opens at, and follows, its latest message
// until the user scrolls away; returning to the end resumes following. Short
// transcripts rest on the composer, as in the vaxis client.
fn transcript_pane(
  themes: theme::Context,
  messages: [transcript::Message],
  session_id: Str,
  list: mut cui::VirtualListRef,
  on_update: fn(cui::VirtualListUpdate, cui::Context),
) cui::View {
  let colors = themes.current()
  let shown = mut List::new<transcript::Message>()
  for message in messages {
    if renders(message) {
      shown.push(message)
    }
  }
  match shown.size() == 0 {
    true => empty_state(colors, "Ask a question or give a task."),
    false => {
      let entries = mut List::new<Entry>()
      for message in shown {
        let key = match message.id == "" {
          true => "pending:{entries.size()}",
          false => message.id,
        }
        entries.push(
          Entry{
            key: key,
            message: message,
            last: entries.size() == shown.size() - 1,
          },
        )
      }
      cui::virtual_list(
        entries.@,
        item_key: fn(entry: Entry) Str {
          entry.key
        },
        render_item: fn(entry: Entry) cui::View {
          transcript_row(themes.current(), entry)
        },
        estimated_height: 4,
        overscan: 2,
        key: "transcript:{session_id}",
        ref: list,
        sticky_scroll: cui::ScrollEdge::end,
        on_update: on_update,
        styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0)),
      )
    },
  }
}

// Each row keeps a blank row above it; the last also keeps one below.
fn transcript_row(colors: theme::Theme, entry: Entry) cui::View {
  let bottom = match entry.last {
    true => 1,
    false => 0,
  }
  cui::box(
    [entry_view(colors, entry.message).or(blank())],
    styles: ui::style(
      flex_direction: ui::FlexDirection::column,
      padding: ui::Edges{
        top: ui::cells(1),
        right: ui::cells(1),
        bottom: ui::cells(bottom),
        left: ui::cells(1),
      },
    ),
  )
}

// Whether a message has visible transcript content.
fn renders(message: transcript::Message) Bool {
  match message.role {
    transcript::Role::user => message.text != "",
    transcript::Role::assistant => message.text != "",
    transcript::Role::tool => true,
    transcript::Role::bash => true,
    transcript::Role::other => false,
  }
}

fn entry_view(colors: theme::Theme, message: transcript::Message) cui::View? {
  match message.role {
    transcript::Role::user => user_entry(colors, message),
    transcript::Role::assistant => {
      let tone = match {
        message.aborted => colors.muted,
        message.is_error => colors.danger_text,
        _ => colors.foreground,
      }
      match message.text == "" {
        true => Maybe::new<cui::View>(),
        false => {
          Maybe::new(
            cui::text(
              message.text,
              text_style: ui::text_style(foreground: tone),
              selectable: true,
              selection_style: theme::selection_style(colors),
            ),
          )
        },
      }
    },
    transcript::Role::tool => Maybe::new(tool_entry(colors, message)),
    transcript::Role::bash => {
      Maybe::new(
        cui::text(
          "$ {message.text}",
          text_style: ui::text_style(foreground: colors.muted),
          selectable: true,
          selection_style: theme::selection_style(colors),
        ),
      )
    },
    transcript::Role::other => Maybe::new<cui::View>(),
  }
}

// A user turn: a tinted wash with half-block edges and two-cell padding.
fn user_entry(colors: theme::Theme, message: transcript::Message) cui::View? {
  match message.text == "" {
    true => Maybe::new<cui::View>(),
    false => {
      let edge = fn(glyph: Str) cui::View {
        cui::text(
          strings::Repeat(glyph, 1024),
          styles: ui::style(height: ui::cells(1), flex_shrink: 0.0),
          text_style: ui::text_style(foreground: colors.user_fill),
          wrap: ui::TextWrap::none,
        )
      }
      Maybe::new(
        cui::box(
          [
            edge("▄"),
            cui::box(
              [
                cui::text(
                  message.text,
                  text_style: ui::text_style(foreground: colors.foreground, background: colors.user_fill),
                  selectable: true,
                  selection_style: theme::selection_style(colors),
                ),
              ],
              styles: ui::style(
                background: colors.user_fill,
                padding: ui::Edges{
                  top: ui::cells(0),
                  right: ui::cells(2),
                  bottom: ui::cells(0),
                  left: ui::cells(2),
                },
              ),
            ),
            edge("▀"),
          ],
          styles: ui::style(flex_direction: ui::FlexDirection::column, flex_shrink: 0.0),
        ),
      )
    },
  }
}

fn tool_entry(colors: theme::Theme, message: transcript::Message) cui::View {
  let state = match message.tool_state {
    transcript::ToolState::planned => "planned",
    transcript::ToolState::running => "running…",
    transcript::ToolState::completed => "done",
    transcript::ToolState::failed => "failed",
    transcript::ToolState::not_run => "not run",
    transcript::ToolState::none => "",
  }
  let tone = match message.tool_state == transcript::ToolState::failed {
    true => colors.danger_text,
    false => colors.muted,
  }
  line("• {message.tool_name} {state}", ui::text_style(foreground: tone))
}

// Horizontal padding of one cell, as used by the header and footer rows.
fn inset() ui::Edges {
  ui::Edges{
    top: ui::cells(0),
    right: ui::cells(1),
    bottom: ui::cells(0),
    left: ui::cells(1),
  }
}

fn divider(color: ui::Color) cui::View {
  cui::text(
    rule,
    styles: ui::style(height: ui::cells(1), flex_shrink: 0.0),
    text_style: ui::text_style(foreground: color),
    wrap: ui::TextWrap::none,
  )
}

fn line(content: Str, style: ui::TextStyle) cui::View {
  cui::text(
    content,
    text_style: style,
    wrap: ui::TextWrap::none,
    overflow: ui::TextOverflow::ellipsis,
  )
}

fn link_line(url: Str, colors: theme::Theme) cui::View {
  cui::text(
    ui::styled_text(
      [
        ui::span(url, link: url, style: ui::span_style(foreground: colors.primary_text, underline: true)),
      ],
    ),
    wrap: ui::TextWrap::none,
    overflow: ui::TextOverflow::ellipsis,
    selectable: true,
    selection_style: theme::selection_style(colors),
  )
}

fn blank() cui::View {
  cui::box([], styles: ui::style(height: ui::cells(1), flex_shrink: 0.0))
}

fn wordmark(colors: theme::Theme) [cui::View] {
  [
    line("k i t", ui::text_style(bold: true)),
    line("━━━━━━━━━━━", ui::text_style(foreground: colors.primary_text)),
  ]
}

// Centers content in the region that remains after the chrome.
fn centered(children: [cui::View]) cui::View {
  cui::box(
    children,
    styles: ui::style(
      flex_grow: 1.0,
      flex_direction: ui::FlexDirection::column,
      justify_content: ui::Justify::center,
      align_items: ui::Align::center,
    ),
  )
}

fn empty_state(colors: theme::Theme, instruction: Str) cui::View {
  let children = mut List::new<cui::View>()
  for view in wordmark(colors) {
    children.push(view)
  }
  children.push(blank())
  children.push(line(instruction, ui::text_style(foreground: colors.muted)))
  centered(children.@)
}

impl Shell {
  fn header() cui::View {
    let colors = self.props.themes.current()
    let left = mut List::new<cui::View>()
    let right = mut List::new<ui::Span>()
    match self.info {
      session => {
        left.push(line(format::session_name(session), ui::text_style()))
        right.push(ui::span(format::model_name(session.Model)))
        let thinking = strings::TrimSpace(session.ThinkingLevel)
        if thinking != "" {
          right.push(ui::span(" ({thinking})"))
        }
        match format::context_percentage(self.context_tokens, self.context_window) {
          percentage => {
            let tone = match percentage > 90 {
              true => colors.danger_text,
              false => {
                match percentage >= 80 {
                  true => colors.warning_text,
                  false => colors.muted,
                }
              },
            }
            right.push(ui::span(" · ", style: ui::span_style(foreground: colors.muted)))
            right.push(ui::span("{percentage}%", style: ui::span_style(foreground: tone)))
          },
          _ => (),
        }
      },
      _ => left.push(line("kit", ui::text_style())),
    }
    cui::box(
      [
        cui::box(left.@, styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0))),
        cui::box(
          [cui::text(ui::styled_text(right.@), wrap: ui::TextWrap::none)],
          styles: ui::style(
            flex_grow: 2.0,
            flex_basis: ui::cells(0),
            flex_direction: ui::FlexDirection::row,
            justify_content: ui::Justify::end,
          ),
        ),
      ],
      styles: ui::style(
        height: ui::cells(1),
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::row,
        padding: inset(),
      ),
    )
  }

  fn footer() cui::View {
    let colors = self.props.themes.current()
    let bash = strings::HasPrefix(self.composer, "!")
    let state = match strings::HasPrefix(self.composer, "!!") {
      true => "bash command · result excluded from context",
      false => {
        match bash {
          true => "bash command · result will be added to context",
          false => "",
        }
      },
    }
    let tone = match bash {
      true => colors.success_text,
      false => colors.muted,
    }
    cui::box(
      [
        cui::box(
          [line(state, ui::text_style(foreground: tone))],
          styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0)),
        ),
        cui::box(
          [line(self.location, ui::text_style(foreground: colors.muted))],
          styles: ui::style(
            flex_grow: 2.0,
            flex_basis: ui::cells(0),
            flex_direction: ui::FlexDirection::row,
            justify_content: ui::Justify::end,
          ),
        ),
      ],
      styles: ui::style(
        height: ui::cells(1),
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::row,
        padding: inset(),
      ),
    )
  }
}

impl Shell {
  fn mut body() cui::View {
    let colors = self.props.themes.current()
    match self.phase {
      Phase::loading => empty_state(colors, "Starting Kit…"),
      Phase::auth => {
        let children = mut List::new<cui::View>()
        for view in wordmark(colors) {
          children.push(view)
        }
        children.push(blank())
        children.push(
          line("Connect an AI provider to get started.", ui::text_style(foreground: colors.muted)),
        )
        children.push(blank())
        let connect = keymap::simple_command("auth.connect", "Connect a provider", fn() Bool {
          self.open_provider_picker()
        })
        children.push(
          controls::button(
            self.props.themes,
            "Connect a provider",
            connect,
            variant: controls::ButtonVariant::primary,
            autofocus: true,
            ref: self.connect_button,
          ),
        )
        centered(children.@)
      },
      Phase::failed => {
        centered(
          [
            line("Kit could not start", ui::text_style(foreground: colors.danger_text, bold: true)),
            blank(),
            cui::text(
              self.error,
              styles: ui::style(max_width: ui::cells(72)),
              text_style: ui::text_style(foreground: colors.muted),
            ),
            blank(),
            line("r retry · ctrl+c quit", ui::text_style(foreground: colors.muted)),
          ],
        )
      },
      Phase::ready => self.conversation(),
    }
  }

  fn mut conversation() cui::View {
    let colors = self.props.themes.current()
    cui::box(
      [self.transcript_region(), self.pending_row(), divider(colors.border), self.composer_view()],
      styles: ui::style(flex_grow: 1.0, flex_direction: ui::FlexDirection::column),
    )
  }

  fn mut transcript_view() cui::View {
    let messages = mut List::new<transcript::Message>()
    for message in self.messages {
      messages.push(message)
    }
    for message in self.live.messages {
      messages.push(message)
    }
    let session_id = match self.info {
      info => info.ID,
      _ => "",
    }
    transcript_pane(
      self.props.themes,
      messages.@,
      session_id,
      self.list,
      fn(update: cui::VirtualListUpdate, ctx: cui::Context) {
        self.latest_out_of_view = not update.state.last_item_visible
      },
    )
  }

  // The latest shortcut is based on the VirtualList's committed visibility,
  // rather than estimates from its pre-layout rows. It remains hidden while
  // any portion of a tall latest reply is visible.
  fn mut transcript_region() cui::View {
    let children = mut List::new<cui::View>()
    children.push(self.transcript_view())
    if self.latest_out_of_view {
      children.push(self.latest_button())
    }
    cui::box(
      children.@,
      styles: ui::style(
        flex_grow: 1.0,
        flex_basis: ui::cells(0),
        position: ui::Position::relative,
        overflow: ui::Overflow::visible,
      ),
    )
  }

  fn latest_button() cui::View {
    let latest = keymap::simple_command("transcript.latest", "Show latest", fn() Bool {
      self.request_end()
      true
    })
    controls::button(
      self.props.themes,
      "↓ Latest",
      latest,
      variant: controls::ButtonVariant::secondary,
      compact: true,
      focusable: false,
      styles: ui::style(
        position: ui::Position::absolute,
        right: ui::cells(1),
        bottom: ui::cells(1),
        z_index: 1,
      ),
    )
  }

  fn pending_row() cui::View {
    let colors = self.props.themes.current()
    let content = match self.notice != "" {
      true => line(self.notice, ui::text_style(foreground: colors.danger_text)),
      false => {
        let activity = match self.live.activity != "" {
          true => self.live.activity,
          false => {
            match self.compact_pending {
              true => "Compacting session…",
              false => "",
            }
          },
        }
        match activity != "" {
          true => {
            cui::box(
              [
                spinner::spinner(styles: ui::style(foreground: colors.muted, flex_shrink: 0.0)),
                line(activity, ui::text_style(foreground: colors.muted)),
              ],
              styles: ui::style(flex_direction: ui::FlexDirection::row, gap: ui::cells(1)),
            )
          },
          false => line("", ui::text_style(foreground: colors.muted)),
        }
      },
    }
    let rows = mut List::new<cui::View>()
    rows.push(content)
    let maximum = match self.follow_ups.Count > 3 {
      true => 2,
      false => 3,
    }
    mut visible = 0
    for preview, index in self.follow_ups.Previews {
      if index < maximum {
        rows.push(
          line("Follow-up {index + 1}: {preview}", ui::text_style(foreground: colors.muted)),
        )
        visible = visible + 1
      }
    }
    if self.follow_ups.Count > visible {
      rows.push(
        line(
          "+{self.follow_ups.Count - visible} more follow-ups",
          ui::text_style(foreground: colors.muted),
        ),
      )
    }
    cui::box(
      rows.@,
      styles: ui::style(
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::column,
        padding: inset(),
      ),
    )
  }

  fn mut composer_view() cui::View {
    let colors = self.props.themes.current()
    let editing = keymap::rebind(
      ui::default_text_area_bindings(),
      ui::TextAreaAction::insert_newline,
      [keymap::key("return", shift: true)],
    )
    let send = keymap::simple_command("composer.submit", "Send", fn() Bool {
      self.submit()
    })
    let open_palette = keymap::simple_command("palette.open", "Open command palette", fn() Bool {
      self.open_command_palette()
    })
    let composer_bindings = mut List::new<keymap::Binding>()
    composer_bindings.push(keymap::binding(keymap::key("return"), send.with()))
    if self.composer == "" {
      composer_bindings.push(keymap::binding(keymap::key("/"), open_palette.with()))
    }
    cui::text_area(
      self.composer,
      key: "composer",
      styles: ui::style(flex_shrink: 0.0, max_height: ui::cells(10), padding: inset()),
      placeholder: "Ask kit to do something…",
      placeholder_style: ui::text_style(foreground: colors.muted),
      selection_style: theme::selection_style(colors),
      autofocus: true,
      ref: self.composer_area,
      on_input: fn(value: Str, ctx: cui::Context) {
        self.composer = value
      },
      key_bindings: editing,
      commands: [send, open_palette],
      bindings: composer_bindings.@,
    )
  }
}

impl cui::Component for Shell {
  fn mut render() cui::View {
    let colors = self.props.themes.current()
    let interrupt = keymap::simple_command("app.interrupt", "Clear or quit", fn() Bool {
      match self.active_modal {
        ActiveModal::none => self.interrupt(),
        _ => true,
      }
    })
    let commands = mut List::new<keymap::Command>()
    let bindings = mut List::new<keymap::Binding>()
    commands.push(interrupt)
    bindings.push(keymap::binding(keymap::key("c", ctrl: true), interrupt.with()))
    if self.phase == Phase::ready and self.active_modal == ActiveModal::none {
      let open_palette = keymap::simple_command("palette.open", "Open command palette", fn() Bool {
        self.open_command_palette()
      })
      commands.push(open_palette)
      bindings.push(keymap::binding(keymap::key("p", ctrl: true), open_palette.with()))
    }
    if self.phase == Phase::ready and self.active_modal == ActiveModal::none and self.can_abort() {
      let abort = keymap::simple_command("run.abort", "Abort run", fn() Bool {
        self.abort_run()
      })
      commands.push(abort)
      bindings.push(keymap::binding(keymap::key("escape"), abort.with()))
    }
    if self.phase == Phase::auth and self.active_modal == ActiveModal::none {
      let connect = keymap::simple_command("auth.connect", "Connect a provider", fn() Bool {
        self.open_provider_picker()
      })
      commands.push(connect)
      bindings.push(keymap::binding(keymap::key("return"), connect.with()))
      bindings.push(keymap::binding(keymap::key("space"), connect.with()))
    }
    let shell = cui::box(
      // Keep the application key layer attached to a focusable shell owner;
      // terminal key routing otherwise has no initial target before deferred
      // child autofocus settles.
      // Let focused controls handle Cmd+C first. This application fallback
      // copies the active cross-control selection without changing focus.
      [self.header(), divider(colors.border), self.body(), divider(colors.border), self.footer()],
      key: "shell.surface",
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        flex_direction: ui::FlexDirection::column,
        background: colors.background,
        foreground: colors.foreground,
      ),
      commands: commands.@,
      bindings: bindings.@,
      binding_scope: keymap::ScopeMode::application,
      on_key: fn(received: mut event::KeyEvent, ctx: cui::Context) {
        if received.event_type == event::KeyEventType::press and received.modifiers.super and received.name == "c" {
          match (ctx.current_selection)() {
            selection => {
              if selection.selected_text != "" {
                (ctx.copy)(selection.selected_text)
                if self.selection_copy_pulse == 0.0 {
                  self.selection_copy_base = self.props.themes.current().selection
                }
                self.selection_copy_pulse = 1.0
                self.update_selection_copy_pulse(1.0)
                let _ = ctx.animate(
                  350,
                  fn(frame: animation::Frame) {
                    self.selection_copy_pulse = 1.0 - frame.progress
                    self.update_selection_copy_pulse(self.selection_copy_pulse)
                  },
                  ease: animation::in_out_sine,
                )
                received.prevent_default()
                received.stop_propagation()
              }
            },
            _ => (),
          }
        }
      },
    )
    let layers = mut List::new<cui::View>()
    layers.push(shell)
    match self.active_modal {
      ActiveModal::command_palette => layers.push(self.command_palette_modal()),
      ActiveModal::provider_picker => layers.push(self.provider_picker_modal()),
      ActiveModal::api_key => layers.push(self.api_key_modal()),
      ActiveModal::device_login => layers.push(self.device_login_modal()),
      ActiveModal::browser_login => layers.push(self.browser_login_modal()),
      ActiveModal::session_debug => layers.push(self.session_debug_modal()),
      _ => (),
    }
    if self.toasts.size() > 0 {
      layers.push(
        toast::stack(self.props.themes, self.toasts, fn(id: Int) {
          self.dismiss_toast(id)
        }),
      )
    }
    cui::box(
      layers.@,
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        position: ui::Position::relative,
        background: colors.background,
      ),
    )
  }
}

impl Shell {
  // update_selection_copy_pulse updates the shared presentation token so
  // VirtualList rows and other independently retained subtrees repaint too.
  fn mut update_selection_copy_pulse(progress: Float64) {
    let colors = mut self.props.themes.current()
    colors.selection = theme::selection_pulse_color(
      self.selection_copy_base,
      colors.selection_backdrop,
      progress,
    )
    self.props.themes.replace(colors.@)
  }

  // show_toast adds a bounded notification. Persistent notices remain until dismissed.
  fn mut show_toast(title: Str, detail: Str, variant: toast::Variant, persistent: Bool) {
    let normalized_title = strings::TrimSpace(title)
    if normalized_title != "" {
      self.toast_next_id = self.toast_next_id + 1
      let id = self.toast_next_id
      self.toasts.push(
        toast::Item{
          id: id,
          title: normalized_title,
          detail: strings::TrimSpace(detail),
          variant: variant,
          persistent: persistent,
        },
      )
      if self.toasts.size() > 5 {
        mut victim = self.toasts.at(0).expect("toast")
        for item in self.toasts {
          if not victim.persistent {
            ()
          } else if not item.persistent {
            victim = item
          }
        }
        self.dismiss_toast(victim.id)
      }
      if not persistent {
        match self.context {
          ctx => {
            let dispatch = ctx.dispatch
            async::start(fn() {
              time::After(time::Second * 10).recv()
              let _ = dispatch(fn() {
                self.dismiss_toast(id)
              })
            })
          },
          _ => (),
        }
      }
    }
  }

  fn mut dismiss_toast(id: Int) {
    let retained = mut List::new<toast::Item>()
    for item in self.toasts {
      if item.id != id {
        retained.push(item)
      }
    }
    self.toasts = retained.@
  }

  fn mut open_command_palette() Bool {
    if self.phase == Phase::ready and self.active_modal == ActiveModal::none {
      self.command_query = ""
      self.command_selection = palette::first_enabled(
        command_catalog(
          self.run_id != "" or self.start_pending or self.compact_pending,
          self.prompt_commands,
          self.plugin_commands,
        ),
      )
      self.command_hover = ""
      self.command_hidden_above = false
      self.command_hidden_below = false
      self.active_modal = ActiveModal::command_palette
    }
    true
  }

  fn mut open_provider_picker() Bool {
    self.auth_error = ""
    self.active_modal = ActiveModal::provider_picker
    true
  }

  fn mut select_auth_provider(key: Str) {
    if self.auth_pending {
      ()
    } else if key == "codex" {
      self.auth_provider = key
      self.start_device_login()
    } else if key == "claude" {
      self.auth_provider = key
      self.start_browser_login()
    } else {
      self.auth_provider = key
      self.auth_api_key = ""
      self.auth_error = ""
      self.active_modal = ActiveModal::api_key
    }
  }

  fn mut dismiss_modal() Bool {
    let dismissed = self.active_modal
    self.cancel_auth_attempt()
    match dismissed {
      ActiveModal::api_key => { self.active_modal = ActiveModal::provider_picker },
      ActiveModal::device_login => { self.active_modal = ActiveModal::provider_picker },
      ActiveModal::browser_login => { self.active_modal = ActiveModal::provider_picker },
      _ => {
        self.active_modal = ActiveModal::none
        match self.context {
          ctx => {
            if self.phase == Phase::auth {
              self.connect_button.focus(ctx)
            } else if dismissed == ActiveModal::command_palette {
              self.composer_area.focus(ctx)
            }
          },
          _ => (),
        }
      },
    }
    true
  }

  fn mut cancel_auth_attempt() {
    self.auth_generation =+ 1
    match self.auth_attempt {
      attempt => attempt.Cancel(),
      _ => (),
    }
    self.auth_attempt = Maybe::new<contextbridge::Cancellation>()
    self.auth_pending = false
  }

  fn auth_provider_label() Str {
    match self.auth_provider {
      "anthropic" => "Anthropic",
      "openai" => "OpenAI",
      "opencode" => "OpenCode Go",
      "codex" => "OpenAI Codex",
      "claude" => "Claude",
      _ => "provider",
    }
  }

  fn auth_provider_id() Str {
    match self.auth_provider {
      "opencode" => "opencode-go",
      _ => self.auth_provider,
    }
  }

  // session_debug_modal presents the server snapshot's configuration and
  // cumulative provider usage without interrupting an active turn.
  fn mut session_debug_modal() cui::View {
    let dismiss = keymap::simple_command("debug.dismiss", "Close", fn() Bool {
      self.dismiss_modal()
    })
    let context = match self.context_window > 0 {
      true => {
        "{format::usage_integer(self.context_tokens)} / {format::usage_integer(self.context_window)} tokens"
      },
      false => "Unavailable",
    }
    let session = self.info.or(protocol::SessionInfo{})
    let thinking = match strings::TrimSpace(session.ThinkingLevel) == "" {
      true => "default",
      false => session.ThinkingLevel,
    }
    let parent = match session.ParentSessionID == "" {
      true => "None",
      false => {
        match session.ParentSessionName == "" {
          true => session.ParentSessionID,
          false => "{session.ParentSessionName} ({session.ParentSessionID})",
        }
      },
    }
    let colors = self.props.themes.current()
    let row = fn(label: Str, value: Str) cui::View {
      cui::box(
        [
          cui::box(
            [line(label, ui::text_style(foreground: colors.muted))],
            styles: ui::style(width: ui::cells(14), flex_shrink: 0.0),
          ),
          line(value, ui::text_style()),
        ],
        styles: ui::style(flex_direction: ui::FlexDirection::row, gap: ui::cells(1)),
      )
    }
    let heading = fn(value: Str) cui::View {
      line(value, ui::text_style(bold: true))
    }
    let body = cui::box(
      [
        heading("Configuration"),
        row("Model", session.Model),
        row("Thinking", thinking),
        row("Context", context),
        row("Parent", parent),
        blank(),
        heading("Cumulative usage"),
        row("Input", format::usage_integer(self.usage.Input)),
        row("Output", format::usage_integer(self.usage.Output)),
        row("Cache read", format::usage_integer(self.usage.CacheRead)),
        row("Cache write", format::usage_integer(self.usage.CacheWrite)),
        row("Reasoning", format::usage_integer(self.usage.Reasoning)),
        row("Total", format::usage_integer(self.usage.TotalTokens)),
        row("Cost", format::usage_cost(self.usage.Cost.Total)),
      ],
      styles: ui::style(
        flex_direction: ui::FlexDirection::column,
        padding: inset(),
        min_width: ui::cells(44),
      ),
    )
    modal::dialog(
      self.props.themes,
      modal::Dialog{
        placement: modal::Placement::centered,
        title: "Session details",
        meta: "",
        header: [],
        body: body,
        footer: Maybe::new<cui::View>(),
        autofocus: true,
        dismiss: dismiss,
        commands: Maybe::new<[keymap::Command]>(),
        bindings: Maybe::new<[keymap::Binding]>(),
      },
    )
  }

  fn mut device_login_modal() cui::View {
    let dismiss = keymap::simple_command("auth.back", "Back", fn() Bool {
      self.dismiss_modal()
    })
    let body = mut List::new<cui::View>()
    if self.auth_error != "" {
      body.push(
        line(self.auth_error, ui::text_style(foreground: self.props.themes.current().danger_text)),
      )
      body.push(blank())
    }
    if self.device_url == "" {
      body.push(spinner::spinner())
      body.push(
        line(
          "Starting device authorization…",
          ui::text_style(foreground: self.props.themes.current().muted),
        ),
      )
    } else {
      body.push(
        line("Open this URL", ui::text_style(foreground: self.props.themes.current().muted)),
      )
      body.push(link_line(self.device_url, self.props.themes.current()))
      body.push(blank())
      body.push(
        line("Enter this code", ui::text_style(foreground: self.props.themes.current().muted)),
      )
      body.push(
        copyable::value(self.props.themes, self.device_code, fn() {
          self.show_toast("Copied to clipboard", "", toast::Variant::info, false)
        }),
      )
      body.push(blank())
      let waiting_style = match self.device_remaining_seconds <= Int64::from(120) {
        true => ui::text_style(foreground: self.props.themes.current().warning_text),
        false => ui::text_style(foreground: self.props.themes.current().muted),
      }
      body.push(
        cui::box(
          [
            spinner::spinner(),
            line(device_waiting_text(self.device_remaining_seconds), waiting_style),
          ],
          styles: ui::style(flex_direction: ui::FlexDirection::row, gap: ui::cells(1)),
        ),
      )
    }
    modal::dialog(
      self.props.themes,
      modal::Dialog{
        placement: modal::Placement::centered,
        title: "Connect OpenAI Codex",
        meta: "",
        header: [],
        body: cui::box(body.@, styles: ui::style(padding: inset(), min_height: ui::cells(8))),
        footer: Maybe::new<cui::View>(),
        autofocus: true,
        dismiss: dismiss,
        commands: Maybe::new<[keymap::Command]>(),
        bindings: Maybe::new<[keymap::Binding]>(),
      },
    )
  }

  fn mut start_device_login() {
    self.cancel_auth_attempt()
    match self.lifetime {
      lifetime => {
        let attempt = contextbridge::WithCancel(lifetime.Context)
        let generation = self.auth_generation
        let ui_context = self.context.expect("mounted auth shell")
        let dispatch = ui_context.dispatch
        let login = self.props.options.Login
        self.active_modal = ActiveModal::device_login
        self.auth_attempt = Maybe::new(attempt)
        self.auth_pending = true
        self.auth_error = ""
        self.device_url = ""
        self.device_code = ""
        self.device_remaining_seconds = Int64::from(0)
        async::start(fn() {
          let result = authbridge::RunDevice(
            attempt.Context,
            login,
            fn(instructions: authbridge::DeviceInstructions) {
              let _ = dispatch(fn() {
                if generation == self.auth_generation {
                  self.device_url = instructions.VerificationURI
                  self.device_code = instructions.UserCode
                  self.device_remaining_seconds = device_remaining_seconds(
                    instructions.ExpiresAtUnixMS,
                  )
                }
              })
              async::start(fn() {
                mut ticking = true
                while ticking {
                  select {
                    attempt.Context.Done().recv() => { ticking = false },
                    time::After(time::Second).recv() => {
                      let remaining = device_remaining_seconds(instructions.ExpiresAtUnixMS)
                      if dispatch(fn() {
                        if generation == self.auth_generation {
                          self.device_remaining_seconds = remaining
                        }
                      }).is_err() {
                        ticking = false
                      }
                    },
                  }
                }
              })
            },
          )
          let _ = dispatch(fn() {
            if generation == self.auth_generation {
              self.auth_attempt = Maybe::new<contextbridge::Cancellation>()
              self.auth_pending = false
              match result {
                ok(_) => {
                  self.active_modal = ActiveModal::none
                  self.phase = Phase::loading
                  self.bootstrap(ui_context, lifetime)
                },
                err(error) => {
                  self.active_modal = ActiveModal::provider_picker
                  self.auth_error = "{error}"
                },
              }
            }
          })
        })
      },
      _ => {
        self.active_modal = ActiveModal::device_login
        self.auth_error = "OpenAI Codex login is unavailable"
      },
    }
  }

  fn mut browser_login_modal() cui::View {
    let dismiss = keymap::simple_command("auth.back", "Back", fn() Bool {
      self.dismiss_modal()
    })
    let body = mut List::new<cui::View>()
    if self.auth_error != "" {
      body.push(
        line(self.auth_error, ui::text_style(foreground: self.props.themes.current().danger_text)),
      )
    }
    if self.browser_url == "" {
      body.push(spinner::spinner())
      body.push(
        line(
          "Starting Claude sign-in…",
          ui::text_style(foreground: self.props.themes.current().muted),
        ),
      )
    } else {
      body.push(
        line(
          "Complete authentication in your browser.",
          ui::text_style(foreground: self.props.themes.current().muted),
        ),
      )
      body.push(blank())
      body.push(link_line(self.browser_url, self.props.themes.current()))
      body.push(blank())
      body.push(
        cui::input(
          self.browser_code,
          key: "auth.browser-code",
          placeholder: "Paste final redirect URL or authorization code…",
          autofocus: true,
          on_input: fn(value: Str, ctx: cui::Context) {
            self.browser_code = value
          },
          on_submit: fn(value: Str, ctx: cui::Context) {
            self.submit_browser_code(value)
          },
        ),
      )
    }
    modal::dialog(
      self.props.themes,
      modal::Dialog{
        placement: modal::Placement::centered,
        title: "Connect Claude",
        meta: "",
        header: [],
        body: cui::box(body.@, styles: ui::style(padding: inset(), min_height: ui::cells(8))),
        footer: Maybe::new<cui::View>(),
        autofocus: false,
        dismiss: dismiss,
        commands: Maybe::new<[keymap::Command]>(),
        bindings: Maybe::new<[keymap::Binding]>(),
      },
    )
  }

  fn mut start_browser_login() {
    self.cancel_auth_attempt()
    match self.lifetime {
      lifetime => {
        let attempt = contextbridge::WithCancel(lifetime.Context)
        let generation = self.auth_generation
        let ui_context = self.context.expect("mounted auth shell")
        let dispatch = ui_context.dispatch
        let login = self.props.options.BrowserLogin
        let manual = Chan::new<Str>(1)
        self.active_modal = ActiveModal::browser_login
        self.auth_attempt = Maybe::new(attempt)
        self.browser_manual = Maybe::new(manual)
        self.browser_url = ""
        self.browser_code = ""
        self.auth_error = ""
        self.auth_pending = true
        async::start(fn() {
          let result = authbridge::RunBrowser(
            attempt.Context,
            login,
            manual.receiver(),
            fn(instructions: authbridge::BrowserInstructions) {
              let _ = dispatch(fn() {
                if generation == self.auth_generation {
                  self.browser_url = instructions.AuthorizationURL
                }
              })
            },
          )
          let _ = dispatch(fn() {
            if generation == self.auth_generation {
              self.auth_attempt = Maybe::new<contextbridge::Cancellation>()
              self.browser_manual = Maybe::new<Chan<Str>>()
              self.auth_pending = false
              match result {
                ok(_) => {
                  self.active_modal = ActiveModal::none
                  self.phase = Phase::loading
                  self.bootstrap(ui_context, lifetime)
                },
                err(error) => { self.auth_error = "{error}" },
              }
            }
          })
        })
      },
      _ => {
        self.active_modal = ActiveModal::browser_login
        self.auth_error = "Claude subscription login is unavailable"
      },
    }
  }

  fn mut submit_browser_code(value: Str) {
    if value != "" and self.auth_pending {
      match self.browser_manual {
        manual => {
          manual.send(value)
          self.browser_code = ""
        },
        _ => (),
      }
    }
  }

  fn mut api_key_modal() cui::View {
    let dismiss = keymap::simple_command("auth.back", "Back", fn() Bool {
      self.dismiss_modal()
    })
    let body = mut List::new<cui::View>()
    body.push(
      cui::input(
        self.auth_api_key,
        key: "auth.api-key",
        styles: ui::style(width: ui::percent(100.0)),
        placeholder: "Paste API key…",
        autofocus: not self.auth_pending,
        on_input: fn(value: Str, ctx: cui::Context) {
          if not self.auth_pending {
            self.auth_api_key = value
            self.auth_error = ""
          }
        },
        on_submit: fn(value: Str, ctx: cui::Context) {
          self.submit_api_key(value)
        },
      ),
    )
    if self.auth_error != "" {
      body.push(blank())
      body.push(
        line(self.auth_error, ui::text_style(foreground: self.props.themes.current().danger_text)),
      )
    }
    match self.auth_pending {
      true => {
        body.push(blank())
        body.push(spinner::spinner())
        body.push(
          line("Saving API key…", ui::text_style(foreground: self.props.themes.current().muted)),
        )
      },
      false => (),
    }
    modal::dialog(
      self.props.themes,
      modal::Dialog{
        placement: modal::Placement::centered,
        title: "Connect {self.auth_provider_label()}",
        meta: "",
        header: [],
        body: cui::box(body.@, styles: ui::style(flex_grow: 1.0, padding: inset())),
        footer: Maybe::new<cui::View>(),
        autofocus: false,
        dismiss: dismiss,
        commands: Maybe::new<[keymap::Command]>(),
        bindings: Maybe::new<[keymap::Binding]>(),
      },
    )
  }

  fn mut submit_api_key(value: Str) {
    if self.auth_pending or value == "" {
      ()
    } else {
      match self.lifetime {
        lifetime => {
          let attempt = contextbridge::WithCancel(lifetime.Context)
          let generation = self.auth_generation
          let ui_context = self.context.expect("mounted auth shell")
          let dispatch = ui_context.dispatch
          let login = self.props.options.APIKeyLogin
          let provider = self.auth_provider_id()
          self.auth_attempt = Maybe::new(attempt)
          self.auth_pending = true
          self.auth_error = ""
          async::start(fn() {
            let result = authbridge::RunAPIKey(attempt.Context, login, provider, value)
            let _ = dispatch(fn() {
              if generation == self.auth_generation {
                self.auth_attempt = Maybe::new<contextbridge::Cancellation>()
                self.auth_pending = false
                match result {
                  ok(_) => {
                    self.auth_api_key = ""
                    self.active_modal = ActiveModal::none
                    self.phase = Phase::loading
                    self.bootstrap(ui_context, lifetime)
                  },
                  err(error) => { self.auth_error = "{error}" },
                }
              }
            })
          })
        },
        _ => { self.auth_error = "Authentication is unavailable" },
      }
    }
  }

  // complete_palette_command turns the current selected catalog row into an
  // invocation buffer. Filtering stays on its command word while arguments are
  // typed, so the selection remains stable until that word is edited.
  fn mut complete_palette_command(catalog: [palette::Item]) Bool {
    mut completed = false
    for item in catalog {
      if item.key == self.command_selection and not completed {
        self.command_query = "{item.label} "
        self.command_hover = ""
        completed = true
      }
    }
    completed
  }

  fn mut command_palette_modal() cui::View {
    let catalog = command_catalog(
      self.run_id != "" or self.start_pending or self.compact_pending,
      self.prompt_commands,
      self.plugin_commands,
    )
    let picker = palette::Props{
      themes: self.props.themes,
      placeholder: "Search commands…",
      catalog: catalog,
      query: self.command_query,
      filter_query: command_word(self.command_query),
      selection: self.command_selection,
      hovered: self.command_hover,
      hidden_above: self.command_hidden_above,
      hidden_below: self.command_hidden_below,
      on_query_change: fn(query: Str) {
        self.command_query = query
        self.command_hover = ""
        let next = palette::first_enabled(
          palette::items(
            palette::Props{
              themes: self.props.themes,
              placeholder: "",
              catalog: catalog,
              query: query,
              filter_query: command_word(query),
              selection: "",
              hovered: "",
              hidden_above: false,
              hidden_below: false,
              on_query_change: fn(value: Str) {},
              on_selection_change: fn(value: Str) {},
              on_hover_change: fn(value: Str) {},
              on_activate: fn(item: palette::Item) {},
            },
          ),
        )
        if next != "" {
          self.command_selection = next
        }
        let selection = self.command_selection
        let _ = self.picker_list.current.map(fn(list) {
          let _ = list.reveal(selection)
        })
      },
      on_selection_change: fn(selection: Str) {
        self.command_selection = selection
        let _ = self.picker_list.current.map(fn(list) {
          let _ = list.reveal(selection)
        })
      },
      on_hover_change: fn(hovered: Str) {
        self.command_hover = hovered
      },
      on_activate: fn(item: palette::Item) {
        if item.disabled_reason != "" {
          self.show_toast("Command unavailable", item.disabled_reason, toast::Variant::warning, false)
        } else if item.key == "login" {
          self.active_modal = ActiveModal::none
          self.open_provider_picker()
        } else if item.key == "quit" {
          self.props.quit()
        } else if item.key == "compact" {
          self.active_modal = ActiveModal::none
          self.compact_session()
        } else if item.key == "debug" {
          self.active_modal = ActiveModal::session_debug
        } else if item.key == "cd" {
          let target = strings::TrimSpace(command_args(self.command_query))
          if target == "" {
            self.show_toast("Usage: /cd <path>", "", toast::Variant::warning, false)
          } else {
            self.active_modal = ActiveModal::none
            self.change_working_directory(target)
          }
        } else {
          for command in self.prompt_commands {
            if item.key == "prompt:{command.Name}" {
              self.active_modal = ActiveModal::none
              self.submit_prompt_command(command.Name, command_args(self.command_query))
            }
          }
          for command in self.plugin_commands {
            if item.key == "plugin:{command.Instance}:{command.ID}" {
              self.active_modal = ActiveModal::none
              self.execute_plugin_command(command, command_args(self.command_query))
            }
          }
        }
      },
    }
    let navigation = palette::navigation(picker)
    let complete = keymap::simple_command("palette.complete", "Complete command", fn() Bool {
      self.complete_palette_command(catalog)
    })
    let dismiss = keymap::simple_command("palette.dismiss", "Close", fn() Bool {
      self.dismiss_modal()
    })
    modal::dialog(
      self.props.themes,
      modal::Dialog{
        placement: modal::Placement::picker,
        title: "",
        meta: "",
        header: palette::header(picker),
        body: palette::body(picker, self.command_picker_viewport()),
        footer: Maybe::new(
          cui::box(
            [
              line(
                "↑↓ move · enter run · esc close",
                ui::text_style(foreground: self.props.themes.current().muted),
              ),
            ],
            styles: ui::style(padding: inset(), flex_shrink: 0.0),
          ),
        ),
        autofocus: false,
        dismiss: dismiss,
        commands: Maybe::new([navigation.up, navigation.down, complete]),
        bindings: Maybe::new(
          [
            keymap::binding(keymap::key("tab"), complete.with()),
            keymap::binding(keymap::key("up"), navigation.up.with()),
            keymap::binding(keymap::key("down"), navigation.down.with()),
          ],
        ),
      },
    )
  }

  fn mut command_picker_viewport() palette::Viewport {
    palette::Viewport{
      list: self.picker_list,
      on_update: fn(update: cui::VirtualListUpdate, ctx: cui::Context) {
        let visible = palette::items(
          palette::Props{
            themes: self.props.themes,
            placeholder: "",
            catalog: command_catalog(
              self.run_id != "" or self.start_pending or self.compact_pending,
              self.prompt_commands,
              self.plugin_commands,
            ),
            query: self.command_query,
            filter_query: command_word(self.command_query),
            selection: "",
            hovered: "",
            hidden_above: false,
            hidden_below: false,
            on_query_change: fn(value: Str) {},
            on_selection_change: fn(value: Str) {},
            on_hover_change: fn(value: Str) {},
            on_activate: fn(item: palette::Item) {},
          },
        )
        self.command_hidden_above = update.state.visible_range.start > 0
        self.command_hidden_below = update.state.visible_range.end < visible.size()
        self.command_viewport = update.state.viewport_height
      },
      on_page: fn(direction: Int) {
        let step = match self.command_viewport > 1 {
          true => self.command_viewport - 1,
          false => 1,
        }
        let _ = self.picker_list.current.map(fn(list) {
          let _ = list.scroll_by(direction * step)
        })
      },
    }
  }

  fn mut provider_picker_modal() cui::View {
    let catalog = provider_catalog()
    let picker = palette::Props{
      themes: self.props.themes,
      placeholder: "Search providers…",
      catalog: catalog,
      query: self.picker_query,
      filter_query: "",
      selection: self.picker_selection,
      hovered: self.picker_hover,
      hidden_above: self.picker_hidden_above,
      hidden_below: self.picker_hidden_below,
      on_query_change: fn(query: Str) {
        self.picker_query = query
        self.picker_hover = ""
        let next = palette::first_enabled(
          palette::items(
            palette::Props{
              themes: self.props.themes,
              placeholder: "",
              catalog: catalog,
              query: query,
              filter_query: "",
              selection: "",
              hovered: "",
              hidden_above: false,
              hidden_below: false,
              on_query_change: fn(value: Str) {},
              on_selection_change: fn(value: Str) {},
              on_hover_change: fn(value: Str) {},
              on_activate: fn(item: palette::Item) {},
            },
          ),
        )
        if next != "" {
          self.picker_selection = next
        }
        let selection = self.picker_selection
        let _ = self.picker_list.current.map(fn(list) {
          let _ = list.reveal(selection)
        })
      },
      on_selection_change: fn(selection: Str) {
        self.picker_selection = selection
        let _ = self.picker_list.current.map(fn(list) {
          let _ = list.reveal(selection)
        })
      },
      on_hover_change: fn(hovered: Str) {
        self.picker_hover = hovered
      },
      on_activate: fn(item: palette::Item) {
        self.select_auth_provider(item.key)
      },
    }
    let navigation = palette::navigation(picker)
    let dismiss = keymap::simple_command("auth.dismiss", "Close", fn() Bool {
      self.dismiss_modal()
    })
    let footer = match self.auth_error != "" {
      true => {
        Maybe::new(
          cui::box(
            [
              line(self.auth_error, ui::text_style(foreground: self.props.themes.current().danger_text)),
            ],
            styles: ui::style(padding: inset(), flex_shrink: 0.0),
          ),
        )
      },
      false => Maybe::new<cui::View>(),
    }
    modal::dialog(
      self.props.themes,
      modal::Dialog{
        // No hint footer: arrows, Enter, and Esc are intuitive primitives and
        // the provider picker has no custom bindings to teach yet.
        placement: modal::Placement::picker,
        title: "Connect a provider",
        meta: "",
        header: palette::header(picker),
        body: palette::body(picker, self.picker_viewport()),
        footer: footer,
        autofocus: false,
        dismiss: dismiss,
        commands: palette::commands(navigation),
        bindings: palette::bindings(navigation),
      },
    )
  }

  // The picker list viewport: the virtual list plus its committed-visibility
  // overflow state and page controls.
  fn mut picker_viewport() palette::Viewport {
    palette::Viewport{
      list: self.picker_list,
      on_update: fn(update: cui::VirtualListUpdate, ctx: cui::Context) {
        let visible = palette::items(
          palette::Props{
            themes: self.props.themes,
            placeholder: "",
            catalog: provider_catalog(),
            query: self.picker_query,
            filter_query: "",
            selection: "",
            hovered: "",
            hidden_above: false,
            hidden_below: false,
            on_query_change: fn(value: Str) {},
            on_selection_change: fn(value: Str) {},
            on_hover_change: fn(value: Str) {},
            on_activate: fn(item: palette::Item) {},
          },
        )
        self.picker_hidden_above = update.state.visible_range.start > 0
        self.picker_hidden_below = update.state.visible_range.end < visible.size()
        self.picker_viewport = update.state.viewport_height
      },
      on_page: fn(direction: Int) {
        self.page_picker(direction)
      },
    }
  }

  fn mut page_picker(direction: Int) {
    let step = match self.picker_viewport > 1 {
      true => self.picker_viewport - 1,
      false => 1,
    }
    let _ = self.picker_list.current.map(fn(list) {
      let _ = list.scroll_by(direction * step)
    })
  }
}

// Session synchronization. Workers only dispatch; every state change runs on
// the UI thread.
impl Shell {
  fn mut attach(attached: bootstrap::Attached, location: Str) {
    self.session = Maybe::new(attached.session)
    self.location = location
    self.phase = Phase::ready
    self.apply_snapshot(attached.snapshot)
    self.watch()
    self.watch_plugin_toasts()
    self.follow_run(attached.snapshot.ActiveTurnID)
  }

  // Streams server-owned plugin notifications. The HTTP stream is fresh-only,
  // so reconnecting never replays a previously displayed toast.
  fn mut watch_plugin_toasts() {
    match self.lifetime {
      lifetime => {
        match self.info {
          info => {
            match self.context {
              context => {
                let ctx = lifetime.Context
                let transport = self.props.options.Transport
                let session_id = info.ID
                let dispatch = context.dispatch
                async::start(fn() {
                  mut watching = true
                  while watching {
                    match httpapi::OpenStream<httpapi::SessionPath, protocol::PluginToast>(
                      ctx,
                      transport,
                      httpapi::StreamPluginToasts,
                      httpapi::SessionPath{SessionID: session_id},
                    ) {
                      ok(body) => {
                        let _ = httpapi::ReadStream<httpapi::SessionPath, protocol::PluginToast>(
                          body,
                          httpapi::StreamPluginToasts,
                          fn(record: httpapi::StreamRecord<protocol::PluginToast>) Void!Error {
                            let notification = record.Payload
                            let _ = dispatch(fn() {
                              let variant = match notification.Variant.to_str() {
                                "warning" => toast::Variant::warning,
                                "error" => toast::Variant::error,
                                _ => toast::Variant::info,
                              }
                              let detail = match notification.Subtitle == "" {
                                true => "",
                                false => "{notification.PluginID} · {notification.Subtitle}",
                              }
                              self.show_toast(
                                notification.Title,
                                detail,
                                variant,
                                notification.Persistent,
                              )
                            })
                            Result::ok(())
                          },
                        )
                        let _ = body.Close()
                      },
                      err(_) => (),
                    }
                    select {
                      ctx.Done().recv() => { watching = false },
                      time::After(time::Second).recv() => (),
                    }
                  }
                })
              },
              _ => (),
            }
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  // Replaces the transcript with a server snapshot unless live events have
  // already moved past it.
  fn mut apply_snapshot(snapshot: protocol::SessionSnapshot) {
    if not self.live.supersedes(snapshot) {
      self.info = Maybe::new(snapshot.Session)
      self.prompt_commands = snapshot.PromptCommands
      self.plugin_commands = snapshot.PluginCommands
      self.follow_ups = snapshot.FollowUps
      self.context_tokens = snapshot.ContextTokens
      self.context_window = snapshot.ContextWindow
      self.usage = snapshot.Usage
      // Watch snapshots can lag the active turn. Keep its complete live tail
      // (including the optimistic user row) until turn settlement; a snapshot
      // that happens to include the user event can still omit later live
      // content and must not replace it.
      if not self.live.blocks_snapshot_replacement() {
        self.messages = transcript::project(snapshot.Messages)
        self.live.reset()
      }
    }
  }

  // Watches the attached session: run starts open the run stream, and run
  // completions reconcile the transcript from a fresh snapshot. The watch
  // reconnects until the client detaches.
  fn mut watch() {
    match self.lifetime {
      lifetime => {
        match self.session {
          session => {
            match self.context {
              context => {
                let ctx = lifetime.Context
                let dispatch = context.dispatch
                async::start(fn() {
                  mut attached = true
                  while attached {
                    match sessionbridge::WatchSession(ctx, session) {
                      ok(watching) => {
                        let baseline = watching.Snapshot
                        let _ = dispatch(fn() {
                          self.apply_snapshot(baseline)
                        })
                        let updates = watching.Stream.Updates()
                        mut open = true
                        while open {
                          match updates.recv() {
                            batch => {
                              for event in batch {
                                let kind = transcript::classify(event.Kind().to_str())
                                if kind == transcript::Event::run_started {
                                  let run_id = event.TurnID
                                  let _ = dispatch(fn() {
                                    self.follow_run(run_id)
                                  })
                                }
                                if kind == transcript::Event::run_finished {
                                  match session.Snapshot(ctx) {
                                    ok(settled) => {
                                      let _ = dispatch(fn() {
                                        self.apply_snapshot(settled)
                                      })
                                    },
                                    err(_) => (),
                                  }
                                }
                              }
                            },
                            _ => { open = false },
                          }
                        }
                      },
                      err(_) => (),
                    }
                    if ctx.Err().is_ok() {
                      time::Sleep(time::Millisecond * 250)
                    }
                  }
                })
              },
              _ => (),
            }
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  // Streams the events of `run_id` into the live transcript.
  fn mut follow_run(run_id: Str) {
    if run_id != "" and run_id != self.run_id {
      self.run_id = run_id
      if self.abort_after_start {
        self.abort_after_start = false
        self.abort_run()
      }
      match self.lifetime {
        lifetime => {
          match self.session {
            session => {
              match self.context {
                context => {
                  let ctx = lifetime.Context
                  let dispatch = context.dispatch
                  async::start(fn() {
                    match session.Stream(ctx, run_id) {
                      ok(stream) => {
                        let updates = stream.Updates()
                        mut open = true
                        while open {
                          match updates.recv() {
                            batch => {
                              let _ = dispatch(fn() {
                                self.apply_events(run_id, batch)
                              })
                            },
                            _ => { open = false },
                          }
                        }
                      },
                      err(_) => (),
                    }
                  })
                },
                _ => (),
              }
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  fn mut apply_events(run_id: Str, batch: [protocol::SessionEvent]) {
    if run_id == self.run_id {
      // A transcript pinned to its end follows new content on its own.
      let _ = self.live.apply(sessionbridge::Events(mut batch))
      if self.live.context_window > 0 {
        self.context_tokens = self.live.context_tokens
        self.context_window = self.live.context_window
      }
      if self.live.activity == "" {
        self.abort_pending = false
      }
    }
  }

  // Whether Escape should target the current active droid turn.
  fn can_abort() Bool {
    (self.run_id != "" or self.start_pending) and self.live.activity != "" and (not self.abort_pending) and (not self.abort_after_start)
  }

  // Requests cancellation without changing the composer or adding transient
  // status UI. The streamed run-finished event remains authoritative.
  fn mut abort_run() Bool {
    if self.can_abort() {
      if self.run_id == "" {
        self.abort_after_start = true
      } else {
        match self.lifetime {
          lifetime => {
            match self.info {
              info => {
                match self.context {
                  context => {
                    let run_id = self.run_id
                    let session_id = info.ID
                    let transport = self.props.options.Transport
                    let dispatch = context.dispatch
                    self.abort_pending = true
                    async::start(fn() {
                      let _ = httpapi::Call<httpapi::TurnPath, httpapi::NoBody, protocol::TurnAbortResult>(
                        lifetime.Context,
                        transport,
                        httpapi::AbortTurn,
                        httpapi::TurnPath{SessionID: session_id, TurnID: run_id},
                        httpapi::NoBody{},
                      )
                      let _ = dispatch(fn() {
                        if self.run_id == run_id {
                          self.abort_pending = false
                        }
                      })
                    })
                  },
                  _ => (),
                }
              },
              _ => (),
            }
          },
          _ => (),
        }
      }
    }
    true
  }

  // Compacts the session through its idempotent API and then refreshes the
  // snapshot. Its local activity is rendered in the reasoning slot, while only
  // failures produce persistent feedback.
  fn mut compact_session() {
    if self.compact_pending {
      ()
    } else {
      match identifier::New("compact_") {
        ok(operation_id) => {
          match self.lifetime {
            lifetime => {
              match self.info {
                info => {
                  match self.context {
                    context => {
                      match self.session {
                        session => {
                          let attempt = contextbridge::WithTimeout(
                            lifetime.Context,
                            Int64::from(120000),
                          )
                          let session_id = info.ID
                          let transport = self.props.options.Transport
                          let dispatch = context.dispatch
                          self.compact_pending = true
                          self.compact_operation_id = operation_id
                          async::start(fn() {
                            let result = httpapi::Call<httpapi::SessionPath, protocol::CompactSessionInput, protocol::CompactSessionResult>(
                              attempt.Context,
                              transport,
                              httpapi::CompactSession,
                              httpapi::SessionPath{SessionID: session_id},
                              protocol::CompactSessionInput{OperationID: operation_id},
                            )
                            match result {
                              ok(_) => {
                                let snapshot = session.Snapshot(attempt.Context)
                                attempt.Cancel()
                                let _ = dispatch(fn() {
                                  if self.compact_operation_id == operation_id {
                                    self.compact_pending = false
                                    self.compact_operation_id = ""
                                    match snapshot {
                                      ok(current) => self.apply_snapshot(current),
                                      err(failure) => {
                                        self.show_toast(
                                          "Session compacted",
                                          "Session context was compacted. {failure}",
                                          toast::Variant::warning,
                                          true,
                                        )
                                      },
                                    }
                                  }
                                })
                              },
                              err(failure) => {
                                attempt.Cancel()
                                let _ = dispatch(fn() {
                                  if self.compact_operation_id == operation_id {
                                    self.compact_pending = false
                                    self.compact_operation_id = ""
                                    self.show_toast(
                                      "Compaction failed",
                                      failure.error(),
                                      toast::Variant::error,
                                      true,
                                    )
                                  }
                                })
                              },
                            }
                          })
                        },
                        _ => (),
                      }
                    },
                    _ => (),
                  }
                },
                _ => (),
              }
            },
            _ => (),
          }
        },
        err(failure) => self.show_toast("Compaction failed", failure.error(), toast::Variant::error, true),
      }
    }
  }

  // Changes the attached session's directory through the canonical session
  // mutation endpoint. The server resolves relative paths from its current cwd.
  fn mut change_working_directory(path: Str) {
    match identifier::New("cwd_") {
      ok(mutation_id) => {
        match self.lifetime {
          lifetime => {
            match self.info {
              info => {
                match self.context {
                  context => {
                    let previous = info.CWD
                    let session_id = info.ID
                    let ctx = lifetime.Context
                    let transport = self.props.options.Transport
                    let resolve_location = self.props.options.ResolveLocation
                    let dispatch = context.dispatch
                    async::start(fn() {
                      let result = httpapi::Call<httpapi::SessionPath, protocol::ChangeCWDInput, protocol::ChangeWorkspaceCWDResult>(
                        ctx,
                        transport,
                        httpapi::ChangeSessionCWD,
                        httpapi::SessionPath{SessionID: session_id},
                        protocol::ChangeCWDInput{MutationID: mutation_id, Path: path},
                      )
                      let _ = dispatch(fn() {
                        match result {
                          ok(changed) => {
                            self.info = Maybe::new(changed.Session)
                            self.location = resolve_location(ctx, changed.Session.CWD)
                            match changed.Session.CWD == previous {
                              true => self.show_toast("Already in directory", changed.Session.CWD, toast::Variant::info, false),
                              false => {
                                self.show_toast(
                                  "Working directory changed",
                                  "Now {changed.Session.CWD} · run /reload to refresh agent context",
                                  toast::Variant::warning,
                                  false,
                                )
                              },
                            }
                          },
                          err(failure) => {
                            self.show_toast(
                              "Failed to change directory",
                              failure.error(),
                              toast::Variant::error,
                              true,
                            )
                          },
                        }
                      })
                    })
                  },
                  _ => (),
                }
              },
              _ => (),
            }
          },
          _ => (),
        }
      },
      err(failure) => {
        self.show_toast("Failed to change directory", failure.error(), toast::Variant::error, true)
      },
    }
  }

  // Submits a discovered prompt command. The server queues it behind active
  // work and retains the /command invocation as the follow-up preview.
  fn mut submit_prompt_command(name: Str, args: Str) {
    if self.phase == Phase::ready {
      match self.lifetime {
        lifetime => {
          match self.info {
            info => {
              match self.context {
                context => {
                  let suffix = match args != "" {
                    true => " {args}",
                    false => "",
                  }
                  let display = "/{name}{suffix}"
                  let optimistic = self.live.activity == "" and not self.start_pending
                  if optimistic {
                    self.notice = ""
                    self.live.submit(display)
                    self.start_pending = true
                    self.request_end()
                  }
                  let ctx = lifetime.Context
                  let session_id = info.ID
                  let transport = self.props.options.Transport
                  let dispatch = context.dispatch
                  async::start(fn() {
                    match httpapi::Call<httpapi::SessionPath, protocol::PromptCommandInput, protocol::PromptSubmission>(
                      ctx,
                      transport,
                      httpapi::SubmitPromptCommand,
                      httpapi::SessionPath{SessionID: session_id},
                      protocol::PromptCommandInput{Name: name, Args: args},
                    ) {
                      ok(submission) => {
                        let _ = dispatch(fn() {
                          self.follow_ups = submission.Queue
                          if submission.Queued {
                            if optimistic {
                              self.live.reset()
                              self.start_pending = false
                            }
                            ()
                          } else if submission.Reservation.TurnID != "" {
                            self.start_pending = false
                            self.follow_run(submission.Reservation.TurnID)
                          } else {
                            self.live.reset()
                            self.start_pending = false
                            self.notice = "Prompt command did not start a turn"
                          }
                        })
                      },
                      err(failure) => {
                        let message = failure.error()
                        let _ = dispatch(fn() {
                          if optimistic {
                            self.live.reset()
                            self.start_pending = false
                            self.abort_after_start = false
                          }
                          self.notice = message
                        })
                      },
                    }
                  })
                },
                _ => (),
              }
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
  }

  // Executes a plugin-owned command without creating an agent turn or
  // changing the composer draft. The server validates the generation-owned
  // instance so stale palette entries cannot run a replacement plugin.
  fn mut execute_plugin_command(command: protocol::PluginCommand, args: Str) {
    match self.lifetime {
      lifetime => {
        match self.info {
          info => {
            match self.context {
              context => {
                let ctx = lifetime.Context
                let session_id = info.ID
                let transport = self.props.options.Transport
                let dispatch = context.dispatch
                async::start(fn() {
                  let result = httpapi::Call<httpapi::SessionPath, protocol::PluginCommandInput, httpapi::NoBody>(
                    ctx,
                    transport,
                    httpapi::ExecutePluginCommand,
                    httpapi::SessionPath{SessionID: session_id},
                    protocol::PluginCommandInput{
                      ID: command.ID,
                      Instance: command.Instance,
                      Args: args,
                    },
                  )
                  let _ = dispatch(fn() {
                    match result {
                      // Plugins own successful user-facing feedback through
                      // their server notification stream. Do not duplicate it
                      // with a client-generated completion toast.
                      ok(_) => (),
                      err(failure) => {
                        self.show_toast(
                          "Plugin command failed",
                          failure.error(),
                          toast::Variant::error,
                          false,
                        )
                      },
                    }
                  })
                })
              },
              _ => (),
            }
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  // Submits the composer as a prompt, queuing it when another turn is active.
  fn mut submit() Bool {
    let text = strings::TrimSpace(self.composer)
    if self.phase == Phase::ready and text != "" {
      match self.lifetime {
        lifetime => {
          match self.info {
            info => {
              match self.context {
                context => {
                  self.composer = ""
                  self.notice = ""
                  let optimistic = self.live.activity == "" and not self.start_pending
                  if optimistic {
                    self.live.submit(text)
                    self.start_pending = true
                    self.request_end()
                  }
                  let ctx = lifetime.Context
                  let session_id = info.ID
                  let transport = self.props.options.Transport
                  let dispatch = context.dispatch
                  async::start(fn() {
                    match httpapi::Call<httpapi::SessionPath, protocol::PromptInput, protocol::PromptSubmission>(
                      ctx,
                      transport,
                      httpapi::SubmitPrompt,
                      httpapi::SessionPath{SessionID: session_id},
                      protocol::PromptInput{Text: text},
                    ) {
                      ok(submission) => {
                        let _ = dispatch(fn() {
                          self.follow_ups = submission.Queue
                          if submission.Queued {
                            if optimistic {
                              self.live.reset()
                              self.start_pending = false
                            }
                          } else if submission.Reservation.TurnID != "" {
                            self.start_pending = false
                            self.follow_run(submission.Reservation.TurnID)
                          } else {
                            self.live.reset()
                            self.start_pending = false
                            self.notice = "Prompt did not start a turn"
                          }
                        })
                      },
                      err(failure) => {
                        let message = failure.error()
                        let _ = dispatch(fn() {
                          if self.composer == "" {
                            self.composer = text
                          }
                          if optimistic {
                            self.live.reset()
                            self.start_pending = false
                            self.abort_after_start = false
                          }
                          self.notice = message
                        })
                      },
                    }
                  })
                },
                _ => (),
              }
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
    true
  }

  // Sending a prompt returns the transcript to its end and resumes following.
  fn request_end() {
    let _ = self.list.current.map(fn(list) {
      let _ = list.scroll_to_edge(cui::ScrollEdge::end, sticky: true)
    })
  }
}
