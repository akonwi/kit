// The detached placeholder never starts work, so its effects are inert.
private fn inert_attachment_host() attached_session::Host {
  attached_session::Host{
    dispatch: fn(action: fn()) Void!event::DispatchError {
      Result::ok(())
    },
    toast: fn(title: Str, detail: Str, variant: toast::Variant, persistent: Bool) {},
    attach: fn(attached: bootstrap::Attached, location: Str) {},
    restore_draft: fn(text: Str) {},
    show_latest: fn() {},
  }
}

struct Props {
  options: cli::TUIOptions,
  themes: theme::Context,
  quit: fn(),
}

struct Shell {
  props: mut Props,
  phase: Phase,
  error: Str,
  context: cui::Context?,
  lifetime: contextbridge::Cancellation?,
  pending_attachment: bootstrap::Attached?,
  pending_attachment_location: Str,
  // Counts client-side attachment scopes. Reattaching the same durable
  // session creates a new scope.
  session_scope_id: Int,
  // The current attachment owns session state and session-scoped operations.
  attached: mut attached_session::Controller,
  rename_initial: Str,
  rename_submit_immediately: Bool,
  composer_mode: Str,
  composer_control: mut composer::Ref,
  // 1 at the start of copy feedback, fading to 0 over 350ms.
  selection_copy_pulse: Float64,
  selection_copy_base: ui::Color,
  model_refresh_pending: Bool,
  theme_name: Str,
  theme_definition: kittheme::Definition,
  displayed_theme_definition: kittheme::Definition,
  terminal_theme: cooper::Theme,
  workspace: WorkspacePane,
  scratchpad_open: Bool,
  scratchpad_control: mut scratchpad::PaneRef,
  active_modal: ActiveModal,
  auth_provider: Str,
  auth_api_key: Str,
  auth_error: Str,
  auth_pending: Bool,
  auth_generation: Int,
  auth_attempt: contextbridge::Cancellation?,
  device_url: Str,
  device_code: Str,
  device_remaining_seconds: Int64,
  browser_code: Str,
  browser_manual: Chan<Str>?,
  browser_url: Str,
  picker_query: Str,
  picker_selection: Str,
  picker_hover: Str,
  picker_hidden_above: Bool,
  picker_hidden_below: Bool,
  picker_viewport: Int,
  command_query: Str,
  command_selection: Str,
  command_hover: Str,
  command_hidden_above: Bool,
  command_hidden_below: Bool,
  command_viewport: Int,
  toasts: [toast::Item],
  toast_next_id: Int,
  picker_list: mut cui::VirtualListRef,
  command_search: mut cui::InputRef,
  connect_button: mut cui::BoxRef,
  // Rebound to each attachment's retained transcript.
  transcript_control: mut transcript_pane::Control,
}

fn new(props: mut Props) mut Shell {
  let phase = match props.options.Authenticated {
    true => Phase::loading,
    false => Phase::auth,
  }
  (mut Shell{
    props: props,
    phase: phase,
    error: "",
    context: Maybe::new<cui::Context>(),
    lifetime: Maybe::new<contextbridge::Cancellation>(),
    pending_attachment: Maybe::new<bootstrap::Attached>(),
    pending_attachment_location: "",
    session_scope_id: 0,
    attached: attached_session::detached(props.options, inert_attachment_host()),
    rename_initial: "",
    rename_submit_immediately: false,
    composer_mode: "",
    composer_control: composer::ref(),
    selection_copy_pulse: 0.0,
    selection_copy_base: ui::rgb(0, 0, 0),
    model_refresh_pending: false,
    theme_name: props.options.ThemeName,
    theme_definition: props.options.ThemeDefinition,
    displayed_theme_definition: props.options.ThemeDefinition,
    terminal_theme: ctheme::default(),
    workspace: WorkspacePane::agent,
    scratchpad_open: false,
    scratchpad_control: scratchpad::pane_ref(),
    active_modal: ActiveModal::none,
    auth_provider: "",
    auth_api_key: "",
    auth_error: "",
    auth_pending: false,
    auth_generation: 0,
    auth_attempt: Maybe::new<contextbridge::Cancellation>(),
    device_url: "",
    device_code: "",
    device_remaining_seconds: Int64::from(0),
    browser_code: "",
    browser_manual: Maybe::new<Chan<Str>>(),
    browser_url: "",
    picker_query: "",
    picker_selection: "codex",
    picker_hover: "",
    picker_hidden_above: false,
    picker_hidden_below: false,
    picker_viewport: 0,
    command_query: "",
    command_selection: "cd",
    command_hover: "",
    command_hidden_above: false,
    command_hidden_below: false,
    command_viewport: 0,
    toasts: [],
    toast_next_id: 0,
    picker_list: cui::virtual_list_ref(),
    command_search: cui::input_ref(),
    connect_button: cui::box_ref(),
    transcript_control: transcript_pane::control(),
  })
}

impl cui::Lifecycle for Shell {
  fn mut mounted(ctx: cui::Context) {
    let lifetime = contextbridge::WithCancel(self.props.options.Context)
    self.lifetime = Maybe::new(lifetime)
    self.context = Maybe::new(ctx)
    self.terminal_theme = (ctx.theme)()
    let dispatch = ctx.dispatch
    let _ = ctx.on_theme_changed(fn(next: cooper::Theme) {
      let _ = dispatch(fn() {
        self.terminal_theme = next
        self.props.themes.replace(theme::resolve(self.displayed_theme_definition, next))
      })
    })
    if self.phase == Phase::loading {
      self.bootstrap(ctx, lifetime)
    }
  }

  fn mut unmounting(ctx: cui::Context) {
    self.attached.dispose()
    match self.lifetime {
      lifetime => lifetime.Cancel(),
      _ => (),
    }
  }
}

impl Shell {
  // Attaches in the background and applies the outcome on the UI thread.
  fn mut bootstrap(ctx: cui::Context, lifetime: contextbridge::Cancellation) {
    let options = self.props.options
    let dispatch = ctx.dispatch
    async::start(fn() {
      let result = bootstrap::attach(lifetime.Context, options)
      let location = match result {
        ok => options.ResolveLocation(lifetime.Context, ok.snapshot.Session.CWD),
        err => options.Location,
      }
      let _ = dispatch(fn() {
        match result {
          ok => self.attach(ok, location),
          err => {
            self.error = err
            self.phase = Phase::failed
          },
        }
      })
    })
  }

  // Ctrl+C clears a non-empty composer; otherwise it detaches.
  fn mut interrupt() Bool {
    if self.phase != Phase::ready or not self.composer_control.clear() {
      (self.props.quit)()
    }
    true
  }
}

// pending_activity renders the latest thinking line as muted inline Markdown
// while preserving the pending slot's fixed one-row geometry.
fn pending_activity(themes: theme::Context, activity: Str) cui::View {
  let colors = themes.current()
  cui::box(
    [
      spinner::spinner(styles: ui::style(foreground: colors.muted, flex_shrink: 0.0)),
      cui::box(
        [
          markdown::inline_view(
            themes,
            "pending-activity",
            activity,
            base: ui::text_style(foreground: colors.muted),
            semantic: false,
          ),
        ],
        styles: ui::style(
          height: ui::cells(1),
          min_width: ui::cells(0),
          flex_grow: 1.0,
          flex_basis: ui::cells(0),
          overflow: ui::Overflow::hidden,
        ),
      ),
    ],
    styles: ui::style(
      height: ui::cells(1),
      flex_direction: ui::FlexDirection::row,
      gap: ui::cells(1),
    ),
  )
}

// Horizontal padding of one cell, as used by the header and footer rows.
fn inset() ui::Edges {
  ui::Edges{
    top: ui::cells(0),
    right: ui::cells(1),
    bottom: ui::cells(0),
    left: ui::cells(1),
  }
}

fn divider(color: ui::Color) cui::View {
  cui::text(
    rule,
    styles: ui::style(height: ui::cells(1), flex_shrink: 0.0),
    text_style: ui::text_style(foreground: color),
    wrap: ui::TextWrap::none,
  )
}

fn link_line(url: Str, colors: theme::Theme) cui::View {
  cui::text(
    ui::styled_text(
      [
        ui::span(url, link: url, style: ui::span_style(foreground: colors.primary_text, underline: true)),
      ],
    ),
    wrap: ui::TextWrap::none,
    overflow: ui::TextOverflow::ellipsis,
    selectable: true,
    selection_style: theme::selection_style(colors),
  )
}

impl Shell {
  // Commands owned by child controls report intent back through Shell's
  // context so only the state owner performs and renders the transition.
  private fn mut command(id: Str, label: Str, transition: fn()) keymap::SimpleCommand {
    keymap::simple_command(id, label, fn() Bool {
      match self.context {
        context => {
          let _ = context.dispatch(fn() {
            transition()
          })
          true
        },
        _ => false,
      }
    })
  }

  fn mut header() cui::View {
    let colors = self.props.themes.current()
    let left = mut List::new<cui::View>()
    let right = mut List::new<cui::View>()
    match self.attached.info {
      session => {
        let rename = self.command("name.open", "Rename session", fn() {
          self.rename_initial = session.Name
          self.rename_submit_immediately = false
          self.active_modal = ActiveModal::rename_session
        })
        left.push(
          controls::button(
            self.props.themes,
            format::session_name(session),
            rename,
            variant: controls::ButtonVariant::secondary,
            compact: true,
            focusable: false,
            styles: ui::style(flex_shrink: 0.0),
          ),
        )
        let open_model = self.command("model.open", "Change session model", fn() {
          self.active_modal = ActiveModal::model_picker
        })
        right.push(
          controls::button(
            self.props.themes,
            format::model_name(session.Model),
            open_model,
            variant: controls::ButtonVariant::secondary,
            compact: true,
            focusable: false,
            styles: ui::style(flex_shrink: 0.0),
          ),
        )
        let thinking_level = strings::TrimSpace(session.ThinkingLevel)
        if thinking_level != "" {
          right.push(cui::text(" ", wrap: ui::TextWrap::none))
          let open_thinking = self.command("thinking.open", "Change thinking level", fn() {
            self.active_modal = ActiveModal::thinking_picker
          })
          right.push(
            controls::button(
              self.props.themes,
              "({thinking_level})",
              open_thinking,
              variant: controls::ButtonVariant::secondary,
              compact: true,
              focusable: false,
              styles: ui::style(flex_shrink: 0.0),
            ),
          )
        }
        match format::context_percentage(self.attached.context_tokens, self.attached.context_window) {
          percentage => {
            let tone = match percentage > 90 {
              true => colors.danger_text,
              false => {
                match percentage >= 80 {
                  true => colors.warning_text,
                  false => colors.muted,
                }
              },
            }
            right.push(cui::text(" · ", text_style: ui::text_style(foreground: colors.muted)))
            let open_debug = self.command("debug.open", "Show session diagnostics", fn() {
              self.active_modal = ActiveModal::session_debug
            })
            right.push(
              controls::button(
                self.props.themes,
                "{percentage}%",
                open_debug,
                variant: controls::ButtonVariant::secondary,
                compact: true,
                focusable: false,
                foreground: tone,
                styles: ui::style(flex_shrink: 0.0),
              ),
            )
          },
          _ => (),
        }
      },
      _ => left.push(layout::line("kit", ui::text_style())),
    }
    cui::box(
      [
        cui::box(left.@, styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0))),
        cui::box(
          right.@,
          styles: ui::style(
            flex_grow: 2.0,
            flex_basis: ui::cells(0),
            flex_direction: ui::FlexDirection::row,
            justify_content: ui::Justify::end,
          ),
        ),
      ],
      styles: ui::style(
        height: ui::cells(1),
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::row,
        padding: inset(),
      ),
    )
  }

  fn footer() cui::View {
    let colors = self.props.themes.current()
    let tone = match self.composer_mode != "" {
      true => colors.success_text,
      false => colors.muted,
    }
    cui::box(
      [
        cui::box(
          [layout::line(self.composer_mode, ui::text_style(foreground: tone))],
          styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0)),
        ),
        cui::box(
          [layout::line(self.attached.location, ui::text_style(foreground: colors.muted))],
          styles: ui::style(
            flex_grow: 2.0,
            flex_basis: ui::cells(0),
            flex_direction: ui::FlexDirection::row,
            justify_content: ui::Justify::end,
          ),
        ),
      ],
      styles: ui::style(
        height: ui::cells(1),
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::row,
        padding: inset(),
      ),
    )
  }
}

impl Shell {
  fn mut body() cui::View {
    let colors = self.props.themes.current()
    match self.phase {
      Phase::loading => layout::empty_state(colors, "Starting Kit…"),
      Phase::auth => {
        let children = mut List::new<cui::View>()
        for view in layout::wordmark(colors) {
          children.push(view)
        }
        children.push(layout::blank())
        children.push(
          layout::line(
            "Connect an AI provider to get started.",
            ui::text_style(foreground: colors.muted),
          ),
        )
        children.push(layout::blank())
        let connect = self.command("auth.connect", "Connect a provider", fn() {
          let _ = self.open_provider_picker()
        })
        children.push(
          controls::button(
            self.props.themes,
            "Connect a provider",
            connect,
            variant: controls::ButtonVariant::primary,
            autofocus: true,
            ref: self.connect_button,
          ),
        )
        layout::centered(children.@)
      },
      Phase::failed => {
        layout::centered(
          [
            layout::line("Kit could not start", ui::text_style(foreground: colors.danger_text, bold: true)),
            layout::blank(),
            cui::text(
              self.error,
              styles: ui::style(max_width: ui::cells(72)),
              text_style: ui::text_style(foreground: colors.muted),
            ),
            layout::blank(),
            layout::line("r retry · ctrl+c quit", ui::text_style(foreground: colors.muted)),
          ],
        )
      },
      Phase::ready => self.conversation(),
    }
  }

  fn mut conversation() cui::View {
    let colors = self.props.themes.current()
    let children = mut List::new<cui::View>()
    if self.scratchpad_open {
      children.push(self.workspace_tabs())
      children.push(divider(colors.border))
    }
    // Keep the transcript retained so workspace switches preserve its virtual
    // list anchor, selection, and already-parsed message surfaces.
    children.push(
      cui::box(
        [self.transcript_view()],
        key: "agent-workspace",
        styles: ui::style(
          flex_grow: 1.0,
          display: match self.workspace == WorkspacePane::agent {
            true => ui::Display::flex,
            false => ui::Display::none,
          },
        ),
      ),
    )
    if self.scratchpad_open and self.workspace == WorkspacePane::scratchpad {
      children.push(
        cui::box(
          [self.scratchpad_view()],
          key: "scratchpad-workspace",
          styles: ui::style(flex_grow: 1.0),
        ),
      )
    }
    // Agent activity can change height as streamed follow-ups arrive. Keep it
    // out of Scratchpad so those updates cannot resize the focused editor and
    // force its cursor back into view.
    if self.workspace == WorkspacePane::agent {
      children.push(self.pending_row())
    }
    children.push(divider(colors.border))
    children.push(self.composer_view())
    cui::box(
      children.@,
      styles: ui::style(flex_grow: 1.0, flex_direction: ui::FlexDirection::column),
    )
  }

  fn mut scratchpad_view() cui::View {
    match self.attached.lifetime {
      lifetime => {
        match self.attached.session {
          session => {
            scratchpad::pane(
              scratchpad::Props{
                themes: self.props.themes,
                record: self.attached.scratchpad_record,
                loading: self.attached.scratchpad_loading,
                failure: self.attached.scratchpad_failure,
                active: self.active_modal == ActiveModal::none,
                update: fn(input: protocol::UpdateScratchpadInput) protocol::Scratchpad!Error {
                  session.UpdateScratchpad(lifetime.Context, input)
                },
                retry_load: fn() Bool {
                  self.request_scratchpad_retry()
                },
                saved: fn(record: protocol::Scratchpad) {
                  self.apply_scratchpad_saved(record)
                },
                closed: fn(close_tab: Bool) {
                  self.apply_scratchpad_closed(close_tab)
                },
                notice: fn(title: Str, detail: Str) {
                  self.apply_scratchpad_notice(title, detail)
                },
                control: self.scratchpad_control,
              },
              self.attached.scope_id,
            )
          },
          _ => cui::box([], styles: ui::style(flex_grow: 1.0)),
        }
      },
      _ => cui::box([], styles: ui::style(flex_grow: 1.0)),
    }
  }

  // The tab strip is host chrome. Pane bodies never repeat their title or
  // close affordance, so future retained panes can share this layout.
  fn mut workspace_tabs() cui::View {
    let agent = self.command("workspace.agent", "Show Agent", fn() {
      self.show_agent_workspace()
    })
    let scratchpad_tab = self.command("workspace.scratchpad", "Show Scratchpad", fn() {
      self.show_scratchpad_workspace()
    })
    let close = self.command("workspace.scratchpad.close", "Close Scratchpad", fn() {
      self.close_scratchpad()
    })
    let scratchpad_active = self.workspace == WorkspacePane::scratchpad
    let scratchpad_variant = match scratchpad_active {
      true => controls::ButtonVariant::primary,
      false => controls::ButtonVariant::secondary,
    }
    cui::box(
      [
        controls::button(
          self.props.themes,
          "Agent",
          agent,
          variant: match self.workspace == WorkspacePane::agent {
            true => controls::ButtonVariant::primary,
            false => controls::ButtonVariant::secondary,
          },
          compact: true,
        ),
        cui::box(
          [
            controls::button(
              self.props.themes,
              "Scratchpad",
              scratchpad_tab,
              variant: scratchpad_variant,
              compact: true,
              trailing_padding: 0,
            ),
            controls::button(
              self.props.themes,
              match scratchpad_active {
                true => "×",
                false => " ",
              },
              close,
              variant: scratchpad_variant,
              compact: true,
              hover_label: "×",
            ),
          ],
          styles: ui::style(flex_direction: ui::FlexDirection::row),
        ),
      ],
      styles: ui::style(
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::row,
        gap: ui::cells(1),
        padding: ui::Edges{
          top: ui::cells(0),
          right: ui::cells(1),
          bottom: ui::cells(0),
          left: ui::cells(1),
        },
      ),
    )
  }

  fn mut transcript_view() cui::View {
    transcript_pane::pane(
      transcript_pane::Props{
        themes: self.props.themes,
        messages: self.attached.transcript_messages(),
        control: self.transcript_control,
      },
      self.attached.scope_id,
    )
  }

  fn pending_row() cui::View {
    let colors = self.props.themes.current()
    let content = match self.attached.notice != "" {
      true => layout::line(self.attached.notice, ui::text_style(foreground: colors.danger_text)),
      false => {
        let activity = self.attached.activity()
        match activity != "" {
          true => pending_activity(self.props.themes, activity),
          false => layout::line("", ui::text_style(foreground: colors.muted)),
        }
      },
    }
    let rows = mut List::new<cui::View>()
    rows.push(content)
    let maximum = match self.attached.follow_ups.Count > 3 {
      true => 2,
      false => 3,
    }
    mut visible = 0
    for preview, index in self.attached.follow_ups.Previews {
      if index < maximum {
        rows.push(
          layout::line(
            "Follow-up {index + 1}: {preview}",
            ui::text_style(foreground: colors.muted),
          ),
        )
        visible = visible + 1
      }
    }
    if self.attached.follow_ups.Count > visible {
      rows.push(
        layout::line(
          "+{self.attached.follow_ups.Count - visible} more follow-ups",
          ui::text_style(foreground: colors.muted),
        ),
      )
    }
    cui::box(
      rows.@,
      styles: ui::style(
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::column,
        padding: inset(),
      ),
    )
  }

  fn mut composer_view() cui::View {
    composer::view(
      composer::Props{
        themes: self.props.themes,
        enabled: self.active_modal == ActiveModal::none,
        focus_eligible: self.active_modal == ActiveModal::none and self.workspace == WorkspacePane::agent,
        control: self.composer_control,
        submit: fn(text: Str) Bool {
          self.request_composer_submit(text)
        },
        open_palette: fn() {
          self.request_composer_palette()
        },
        mode_changed: fn(mode: Str) {
          self.apply_composer_mode(mode)
        },
      },
    )
  }

  // Composer callbacks re-enter Shell through its owning context.
  fn mut request_composer_submit(text: Str) Bool {
    if self.phase != Phase::ready or not self.attached.can_submit() {
      false
    } else {
      match self.context {
        context => {
          let _ = context.dispatch(fn() {
            self.attached.submit(text)
          })
          true
        },
        _ => false,
      }
    }
  }

  fn mut request_composer_palette() {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.open_command_palette()
        })
      },
      _ => (),
    }
  }

  fn mut apply_composer_mode(mode: Str) {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.composer_mode = mode
        })
      },
      _ => (),
    }
  }
}

impl cui::Component for Shell {
  fn mut render() cui::View {
    let colors = self.props.themes.current()
    let interrupt = keymap::simple_command("app.interrupt", "Clear or quit", fn() Bool {
      match self.active_modal {
        ActiveModal::none => self.interrupt(),
        _ => true,
      }
    })
    let commands = mut List::new<keymap::Command>()
    let bindings = mut List::new<keymap::Binding>()
    commands.push(interrupt)
    bindings.push(keymap::binding(keymap::key("c", ctrl: true), interrupt.with()))
    if self.phase == Phase::ready and self.active_modal == ActiveModal::none {
      let open_palette = keymap::simple_command("palette.open", "Open command palette", fn() Bool {
        self.open_command_palette()
      })
      commands.push(open_palette)
      bindings.push(keymap::binding(keymap::key("p", ctrl: true), open_palette.with()))
    }
    if self.phase == Phase::ready and self.active_modal == ActiveModal::none and self.attached.can_abort() {
      let abort = keymap::simple_command("run.abort", "Abort run", fn() Bool {
        self.attached.abort_run()
      })
      commands.push(abort)
      bindings.push(keymap::binding(keymap::key("escape"), abort.with()))
    }
    if self.phase == Phase::auth and self.active_modal == ActiveModal::none {
      let connect = keymap::simple_command("auth.connect", "Connect a provider", fn() Bool {
        self.open_provider_picker()
      })
      commands.push(connect)
      bindings.push(keymap::binding(keymap::key("return"), connect.with()))
      bindings.push(keymap::binding(keymap::key("space"), connect.with()))
    }
    let shell = cui::box(
      // Keep the application key layer attached to a focusable shell owner;
      // terminal key routing otherwise has no initial target before deferred
      // child autofocus settles.
      // Let focused controls handle Cmd+C first. This application fallback
      // copies the active cross-control selection without changing focus.
      [self.header(), divider(colors.border), self.body(), divider(colors.border), self.footer()],
      key: "shell.surface",
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        flex_direction: ui::FlexDirection::column,
        background: colors.background,
        foreground: colors.foreground,
      ),
      commands: commands.@,
      bindings: bindings.@,
      binding_scope: keymap::ScopeMode::application,
      on_key: fn(received: mut event::KeyEvent, ctx: cui::Context) {
        if received.event_type == event::KeyEventType::press and received.modifiers.super and received.name == "c" {
          match (ctx.current_selection)() {
            selection => {
              if selection.selected_text != "" {
                (ctx.copy)(selection.copy_text.or(selection.selected_text))
                if self.selection_copy_pulse == 0.0 {
                  self.selection_copy_base = self.props.themes.current().selection
                }
                self.selection_copy_pulse = 1.0
                self.update_selection_copy_pulse(1.0)
                let _ = ctx.animate(
                  350,
                  fn(frame: animation::Frame) {
                    self.selection_copy_pulse = 1.0 - frame.progress
                    self.update_selection_copy_pulse(self.selection_copy_pulse)
                  },
                  ease: animation::in_out_sine,
                )
                received.prevent_default()
                received.stop_propagation()
              }
            },
            _ => (),
          }
        }
      },
    )
    let layers = mut List::new<cui::View>()
    layers.push(shell)
    match self.active_modal {
      ActiveModal::command_palette => layers.push(self.command_palette_modal()),
      ActiveModal::provider_picker => layers.push(self.provider_picker_modal()),
      ActiveModal::api_key => layers.push(self.api_key_modal()),
      ActiveModal::device_login => layers.push(self.device_login_modal()),
      ActiveModal::browser_login => layers.push(self.browser_login_modal()),
      ActiveModal::session_debug => layers.push(self.session_debug_modal()),
      ActiveModal::mcp_status => layers.push(self.mcp_status_modal()),
      ActiveModal::model_picker => layers.push(self.model_picker_modal()),
      ActiveModal::theme_picker => layers.push(self.theme_picker_modal()),
      ActiveModal::thinking_picker => layers.push(self.thinking_picker_modal()),
      ActiveModal::rename_session => layers.push(self.rename_session_modal()),
      ActiveModal::sessions => layers.push(self.sessions_modal()),
      _ => (),
    }
    if self.toasts.size() > 0 {
      layers.push(
        toast::stack(self.props.themes, self.toasts, fn(id: Int) {
          self.request_toast_dismissal(id)
        }),
      )
    }
    cui::box(
      layers.@,
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        position: ui::Position::relative,
        background: colors.background,
      ),
    )
  }
}

impl Shell {
  // update_selection_copy_pulse updates the shared presentation token so
  // VirtualList rows and other independently retained subtrees repaint too.
  fn mut update_selection_copy_pulse(progress: Float64) {
    let colors = mut self.props.themes.current()
    colors.selection = theme::selection_pulse_color(
      self.selection_copy_base,
      colors.selection_backdrop,
      progress,
    )
    self.props.themes.replace(colors.@)
  }

  // Child-owned controls report toast transitions through Shell's context.
  fn mut request_toast(title: Str, detail: Str, variant: toast::Variant, persistent: Bool) {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.show_toast(title, detail, variant, persistent)
        })
      },
      _ => (),
    }
  }

  fn mut request_toast_dismissal(id: Int) {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.dismiss_toast(id)
        })
      },
      _ => (),
    }
  }

  // show_toast adds a bounded notification. Persistent notices remain until dismissed.
  fn mut show_toast(title: Str, detail: Str, variant: toast::Variant, persistent: Bool) {
    let normalized_title = strings::TrimSpace(title)
    if normalized_title != "" {
      self.toast_next_id = self.toast_next_id + 1
      let id = self.toast_next_id
      self.toasts.push(
        toast::Item{
          id: id,
          title: normalized_title,
          detail: strings::TrimSpace(detail),
          variant: variant,
          persistent: persistent,
        },
      )
      if self.toasts.size() > 5 {
        mut victim = self.toasts.at(0).expect("toast")
        for item in self.toasts {
          if not victim.persistent {
            ()
          } else if not item.persistent {
            victim = item
          }
        }
        self.dismiss_toast(victim.id)
      }
      if not persistent {
        match self.context {
          ctx => {
            let dispatch = ctx.dispatch
            async::start(fn() {
              time::After(time::Second * 10).recv()
              let _ = dispatch(fn() {
                self.dismiss_toast(id)
              })
            })
          },
          _ => (),
        }
      }
    }
  }

  fn mut dismiss_toast(id: Int) {
    let retained = mut List::new<toast::Item>()
    for item in self.toasts {
      if item.id != id {
        retained.push(item)
      }
    }
    self.toasts = retained.@
  }

  fn mut open_command_palette() Bool {
    if self.phase == Phase::ready and self.active_modal == ActiveModal::none {
      self.command_query = ""
      self.command_selection = palette::first_enabled(
        command_catalog(
          self.attached.busy(),
          self.attached.prompt_commands,
          self.attached.plugin_commands,
        ),
      )
      self.command_hover = ""
      self.command_hidden_above = false
      self.command_hidden_below = false
      self.active_modal = ActiveModal::command_palette
      match self.context {
        context => {
          let search = self.command_search
          let _ = search.focus(context)
        },
        _ => (),
      }
    }
    true
  }

  fn mut open_provider_picker() Bool {
    self.auth_error = ""
    self.active_modal = ActiveModal::provider_picker
    true
  }

  fn mut select_auth_provider(key: Str) {
    if self.auth_pending {
      ()
    } else if key == "codex" {
      self.auth_provider = key
      self.start_device_login()
    } else if key == "claude" {
      self.auth_provider = key
      self.start_browser_login()
    } else {
      self.auth_provider = key
      self.auth_api_key = ""
      self.auth_error = ""
      self.active_modal = ActiveModal::api_key
    }
  }

  fn mut dismiss_modal() Bool {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.dismiss_modal_now(context)
        })
        true
      },
      _ => false,
    }
  }

  private fn mut dismiss_modal_now(context: cui::Context) {
    let dismissed = self.active_modal
    self.cancel_auth_attempt()
    match dismissed {
      ActiveModal::api_key => { self.active_modal = ActiveModal::provider_picker },
      ActiveModal::device_login => { self.active_modal = ActiveModal::provider_picker },
      ActiveModal::browser_login => { self.active_modal = ActiveModal::provider_picker },
      _ => self.finish_modal_now(context),
    }
  }

  private fn mut finish_modal() {
    match self.context {
      context => self.finish_modal_now(context),
      _ => (),
    }
  }

  private fn mut finish_modal_now(context: cui::Context) {
    self.active_modal = ActiveModal::none
    if self.phase == Phase::auth {
      let connect = self.connect_button
      (context.internal_commit)(
        fn() {
          connect.focus(context)
        },
      )
    } else if self.phase == Phase::ready {
      match self.workspace {
        WorkspacePane::agent => {
          let _ = self.composer_control.focus()
        },
        WorkspacePane::scratchpad => {
          let _ = self.scratchpad_control.focus()
        },
      }
    }
  }

  fn mut cancel_auth_attempt() {
    self.auth_generation =+ 1
    match self.auth_attempt {
      attempt => attempt.Cancel(),
      _ => (),
    }
    self.auth_attempt = Maybe::new<contextbridge::Cancellation>()
    self.auth_pending = false
  }

  fn auth_provider_label() Str {
    match self.auth_provider {
      "anthropic" => "Anthropic",
      "openai" => "OpenAI",
      "opencode" => "OpenCode Go",
      "codex" => "OpenAI Codex",
      "claude" => "Claude",
      _ => "provider",
    }
  }

  fn auth_provider_id() Str {
    match self.auth_provider {
      "opencode" => "opencode-go",
      _ => self.auth_provider,
    }
  }

  // session_debug_modal presents the server snapshot's configuration and
  // cumulative provider usage without interrupting an active turn.
  fn mut session_debug_modal() cui::View {
    let dismiss = keymap::simple_command("debug.dismiss", "Close", fn() Bool {
      self.dismiss_modal()
    })
    let context = match self.attached.context_window > 0 {
      true => {
        "{format::usage_integer(self.attached.context_tokens)} / {format::usage_integer(self.attached.context_window)} tokens"
      },
      false => "Unavailable",
    }
    let session = self.attached.info.or(protocol::SessionInfo{})
    let thinking = match strings::TrimSpace(session.ThinkingLevel) == "" {
      true => "default",
      false => session.ThinkingLevel,
    }
    let parent = match session.ParentSessionID == "" {
      true => "None",
      false => {
        match session.ParentSessionName == "" {
          true => session.ParentSessionID,
          false => "{session.ParentSessionName} ({session.ParentSessionID})",
        }
      },
    }
    let colors = self.props.themes.current()
    let row = fn(label: Str, value: Str) cui::View {
      cui::box(
        [
          cui::box(
            [layout::line(label, ui::text_style(foreground: colors.muted))],
            styles: ui::style(width: ui::cells(14), flex_shrink: 0.0),
          ),
          layout::line(value, ui::text_style()),
        ],
        styles: ui::style(flex_direction: ui::FlexDirection::row, gap: ui::cells(1)),
      )
    }
    let heading = fn(value: Str) cui::View {
      layout::line(value, ui::text_style(bold: true))
    }
    let body = cui::box(
      [
        heading("Configuration"),
        row("Model", session.Model),
        row("Thinking", thinking),
        row("Context", context),
        row("Parent", parent),
        layout::blank(),
        heading("Cumulative usage"),
        row("Input", format::usage_integer(self.attached.usage.Input)),
        row("Output", format::usage_integer(self.attached.usage.Output)),
        row("Cache read", format::usage_integer(self.attached.usage.CacheRead)),
        row("Cache write", format::usage_integer(self.attached.usage.CacheWrite)),
        row("Reasoning", format::usage_integer(self.attached.usage.Reasoning)),
        row("Total", format::usage_integer(self.attached.usage.TotalTokens)),
        row("Cost", format::usage_cost(self.attached.usage.Cost.Total)),
      ],
      styles: ui::style(
        flex_direction: ui::FlexDirection::column,
        padding: inset(),
        min_width: ui::cells(44),
      ),
    )
    modal::dialog(
      self.props.themes,
      modal::Dialog{
        placement: modal::Placement::centered,
        title: "Session details",
        meta: "",
        header: [],
        body: body,
        footer: Maybe::new<cui::View>(),
        autofocus: true,
        dismiss: dismiss,
        commands: Maybe::new<[keymap::Command]>(),
        bindings: Maybe::new<[keymap::Binding]>(),
      },
    )
  }

  // apply_renamed_session schedules the shell-owned update through Shell's
  // context, so child dialogs never need to invalidate the root.
  fn mut apply_renamed_session(session: protocol::SessionInfo) {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.attached.apply_info(session)
          self.rename_submit_immediately = false
          self.finish_modal_now(context)
        })
      },
      _ => (),
    }
  }

  fn mut refresh_session_configuration(session: protocol::SessionInfo) {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.attached.apply_info(session)
        })
      },
      _ => (),
    }
  }

  fn mut apply_thinking_configuration(session: protocol::SessionInfo) {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.attached.apply_info(session)
          self.finish_modal_now(context)
        })
      },
      _ => (),
    }
  }

  // apply_model_configuration settles the shell state after a configuration
  // picker completes its owned request.
  fn mut apply_model_configuration(applied: protocol::ConfigureSessionResult) {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.attached.apply_info(applied.Session)
          self.finish_modal_now(context)
        })
      },
      _ => (),
    }
  }

  fn mut rename_session_modal() cui::View {
    let dismiss = keymap::simple_command("name.dismiss", "Close", fn() Bool {
      self.dismiss_modal()
    })
    cui::child(
      rename::new,
      rename::Props{
        themes: self.props.themes,
        client: self.props.options.Client,
        lifetime: self.lifetime.expect("mounted rename dialog"),
        session: self.attached.info.or(protocol::SessionInfo{}),
        initial_name: self.rename_initial,
        submit_immediately: self.rename_submit_immediately,
        dismiss: dismiss,
        applied: fn(session: protocol::SessionInfo) {
          self.apply_renamed_session(session)
        },
      },
    )
  }

  fn mut model_picker_modal() cui::View {
    let dismiss = keymap::simple_command("model.dismiss", "Close", fn() Bool {
      self.dismiss_modal()
    })
    cui::child(
      model::new,
      model::Props{
        themes: self.props.themes,
        client: self.props.options.Client,
        lifetime: self.lifetime.expect("mounted model picker"),
        bound: self.attached.session.expect("attached model picker"),
        session: self.attached.info.or(protocol::SessionInfo{}),
        override_service: self.props.options.ModelOverrideService,
        dismiss: dismiss,
        applied: fn(applied: protocol::ConfigureSessionResult) {
          self.apply_model_configuration(applied)
        },
      },
    )
  }

  fn mut thinking_picker_modal() cui::View {
    let dismiss = fn() {
      let _ = self.dismiss_modal()
    }
    cui::child(
      thinking::new,
      thinking::Props{
        themes: self.props.themes,
        client: self.props.options.Client,
        lifetime: self.lifetime.expect("mounted thinking picker"),
        session_client: self.attached.session.expect("attached thinking picker"),
        session: self.attached.info.or(protocol::SessionInfo{}),
        dismiss: dismiss,
        refreshed: fn(session: protocol::SessionInfo) {
          self.refresh_session_configuration(session)
        },
        applied: fn(session: protocol::SessionInfo) {
          self.apply_thinking_configuration(session)
        },
      },
    )
  }

  private fn mut preview_theme(definition: kittheme::Definition) {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.displayed_theme_definition = definition
          self.props.themes.replace(theme::resolve(definition, self.terminal_theme))
        })
      },
      _ => (),
    }
  }

  private fn mut commit_theme(name: Str, definition: kittheme::Definition) {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.theme_name = name
          self.theme_definition = definition
          self.displayed_theme_definition = definition
          self.props.themes.replace(theme::resolve(definition, self.terminal_theme))
          self.finish_modal_now(context)
        })
      },
      _ => (),
    }
  }

  private fn mut cancel_theme_preview() {
    match self.context {
      context => {
        let _ = context.dispatch(fn() {
          self.displayed_theme_definition = self.theme_definition
          self.props.themes.replace(theme::resolve(self.theme_definition, self.terminal_theme))
          self.dismiss_modal_now(context)
        })
      },
      _ => (),
    }
  }

  fn mut theme_picker_modal() cui::View {
    cui::child(
      theme_picker::new,
      theme_picker::Props{
        themes: self.props.themes,
        service: self.props.options.ThemeService,
        committed_name: self.theme_name,
        committed_definition: self.theme_definition,
        dismiss: fn() {
          self.cancel_theme_preview()
        },
        preview: fn(definition: kittheme::Definition) {
          self.preview_theme(definition)
        },
        applied: fn(name: Str, definition: kittheme::Definition) {
          self.commit_theme(name, definition)
        },
      },
    )
  }

  fn mut sessions_modal() cui::View {
    let dismiss = keymap::simple_command("sessions.dismiss", "Close", fn() Bool {
      self.dismiss_modal()
    })
    cui::child(
      sessions::new,
      sessions::Props{
        themes: self.props.themes,
        client: self.props.options.Client,
        lifetime: self.lifetime.expect("mounted session picker"),
        current_session_id: self.attached.info.or(protocol::SessionInfo{}).ID,
        dismiss: dismiss,
        renamed: fn(session: protocol::SessionInfo) {
          match self.context {
            context => {
              let _ = context.dispatch(fn() {
                self.attached.apply_info(session)
              })
            },
            _ => (),
          }
        },
        applied: fn(session: mut api::Session, snapshot: protocol::SessionSnapshot) {
          match self.context {
            context => {
              let _ = context.dispatch(fn() {
                self.finish_modal_now(context)
                self.attach(
                  bootstrap::Attached{
                    info: snapshot.Session,
                    session: session,
                    snapshot: snapshot,
                  },
                  self.props.options.ResolveLocation(
                    self.lifetime.expect("session lifetime").Context,
                    snapshot.Session.CWD,
                  ),
                )
              })
            },
            _ => (),
          }
        },
      },
    )
  }

  fn mut mcp_status_modal() cui::View {
    let dismiss = keymap::simple_command("mcp.dismiss", "Close", fn() Bool {
      self.dismiss_modal()
    })
    cui::child(
      mcp::new,
      mcp::Props{
        themes: self.props.themes,
        servers: self.attached.mcp_servers,
        warnings: self.attached.mcp_warnings,
        dismiss: dismiss,
      },
    )
  }

  fn mut device_login_modal() cui::View {
    let dismiss = keymap::simple_command("auth.back", "Back", fn() Bool {
      self.dismiss_modal()
    })
    let body = mut List::new<cui::View>()
    if self.auth_error != "" {
      body.push(
        layout::line(
          self.auth_error,
          ui::text_style(foreground: self.props.themes.current().danger_text),
        ),
      )
      body.push(layout::blank())
    }
    if self.device_url == "" {
      body.push(spinner::spinner())
      body.push(
        layout::line(
          "Starting device authorization…",
          ui::text_style(foreground: self.props.themes.current().muted),
        ),
      )
    } else {
      body.push(
        layout::line(
          "Open this URL",
          ui::text_style(foreground: self.props.themes.current().muted),
        ),
      )
      body.push(link_line(self.device_url, self.props.themes.current()))
      body.push(layout::blank())
      body.push(
        layout::line(
          "Enter this code",
          ui::text_style(foreground: self.props.themes.current().muted),
        ),
      )
      body.push(
        copyable::value(self.props.themes, self.device_code, fn() {
          self.request_toast("Copied to clipboard", "", toast::Variant::info, false)
        }),
      )
      body.push(layout::blank())
      let waiting_style = match self.device_remaining_seconds <= Int64::from(120) {
        true => ui::text_style(foreground: self.props.themes.current().warning_text),
        false => ui::text_style(foreground: self.props.themes.current().muted),
      }
      body.push(
        cui::box(
          [
            spinner::spinner(),
            layout::line(device_waiting_text(self.device_remaining_seconds), waiting_style),
          ],
          styles: ui::style(flex_direction: ui::FlexDirection::row, gap: ui::cells(1)),
        ),
      )
    }
    modal::dialog(
      self.props.themes,
      modal::Dialog{
        placement: modal::Placement::centered,
        title: "Connect OpenAI Codex",
        meta: "",
        header: [],
        body: cui::box(body.@, styles: ui::style(padding: inset(), min_height: ui::cells(8))),
        footer: Maybe::new<cui::View>(),
        autofocus: true,
        dismiss: dismiss,
        commands: Maybe::new<[keymap::Command]>(),
        bindings: Maybe::new<[keymap::Binding]>(),
      },
    )
  }

  fn mut start_device_login() {
    self.cancel_auth_attempt()
    match self.lifetime {
      lifetime => {
        let attempt = contextbridge::WithCancel(lifetime.Context)
        let generation = self.auth_generation
        let ui_context = self.context.expect("mounted auth shell")
        let dispatch = ui_context.dispatch
        let login = self.props.options.Login
        self.active_modal = ActiveModal::device_login
        self.auth_attempt = Maybe::new(attempt)
        self.auth_pending = true
        self.auth_error = ""
        self.device_url = ""
        self.device_code = ""
        self.device_remaining_seconds = Int64::from(0)
        async::start(fn() {
          let result = authbridge::RunDevice(
            attempt.Context,
            login,
            fn(instructions: authbridge::DeviceInstructions) {
              let _ = dispatch(fn() {
                if generation == self.auth_generation {
                  self.device_url = instructions.VerificationURI
                  self.device_code = instructions.UserCode
                  self.device_remaining_seconds = device_remaining_seconds(
                    instructions.ExpiresAtUnixMS,
                  )
                }
              })
              async::start(fn() {
                mut ticking = true
                while ticking {
                  select {
                    attempt.Context.Done().recv() => { ticking = false },
                    time::After(time::Second).recv() => {
                      let remaining = device_remaining_seconds(instructions.ExpiresAtUnixMS)
                      if dispatch(fn() {
                        if generation == self.auth_generation {
                          self.device_remaining_seconds = remaining
                        }
                      }).is_err() {
                        ticking = false
                      }
                    },
                  }
                }
              })
            },
          )
          let _ = dispatch(fn() {
            if generation == self.auth_generation {
              self.auth_attempt = Maybe::new<contextbridge::Cancellation>()
              self.auth_pending = false
              match result {
                ok(_) => {
                  self.active_modal = ActiveModal::none
                  self.phase = Phase::loading
                  self.bootstrap(ui_context, lifetime)
                },
                err(error) => {
                  self.active_modal = ActiveModal::provider_picker
                  self.auth_error = "{error}"
                },
              }
            }
          })
        })
      },
      _ => {
        self.active_modal = ActiveModal::device_login
        self.auth_error = "OpenAI Codex login is unavailable"
      },
    }
  }

  fn mut browser_login_modal() cui::View {
    let dismiss = keymap::simple_command("auth.back", "Back", fn() Bool {
      self.dismiss_modal()
