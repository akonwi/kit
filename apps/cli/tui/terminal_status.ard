use ard/async
use ard/testing
use ard/unsafe

use go:api/contract as protocol
use cooper/cui
use cooper/program_status
use cooper/terminal_progress
use cooper/ui
use kit/tui/spinner
use go:os
use go:path/filepath
use go:strings
use go:time
use go:unicode

// Reports Kit's status to the hosting terminal: the window or tab title and,
// where the terminal supports them, its progress indicator and the Program
// Status Protocol (OSC 7501). A running turn animates a spinner ahead of the
// title, a turn waiting for an answer shows `?` with paused progress, and idle
// sessions have no marker. The protocol's root record, with `app=kit`, is
// `working` while a turn or compaction runs, `blocked` while Kit waits for the
// user, and reports how the last turn finished: `done` when it completed,
// `error` when it failed or was interrupted, and `idle` when it was aborted.

// Every other spinner frame keeps the title readable while it animates.
let running_frames = [
  spinner::frames.at(0).expect("spinner frame"),
  spinner::frames.at(2).expect("spinner frame"),
  spinner::frames.at(4).expect("spinner frame"),
  spinner::frames.at(6).expect("spinner frame"),
  spinner::frames.at(8).expect("spinner frame"),
]

let title_frame_duration = 160 * time::Millisecond
// Multiplexers redraw their status line for every title change, so the
// animation slows down inside them.
let multiplexer_frame_duration = time::Second

// Terminal is the host capability that publishes status and alerts. Each
// operation reports whether the terminal accepted it.
struct Terminal {
  set_title: fn(Str) Bool,
  progress: fn(terminal_progress::State) Bool,
  bell: fn() Bool,
  // Sends a desktop notification: a message under a title.
  notify: fn(Str, Str) Bool,
  // Reports the root record through the Program Status Protocol.
  program_status: fn(program_status::Report) Bool,
  // Whether the terminal answered the Program Status Protocol's feature
  // query, so it notifies about the records Kit reports.
  program_status_supported: fn() Bool,
  // Whether the terminal reported that it has focus. A terminal that has not
  // reported focus is treated as unfocused.
  focused: fn() Bool,
}

// detached accepts no status, for clients without a hosting terminal.
fn detached() Terminal {
  Terminal{
    set_title: fn(value: Str) Bool {
      false
    },
    progress: fn(state: terminal_progress::State) Bool {
      false
    },
    bell: fn() Bool {
      false
    },
    notify: fn(message: Str, title: Str) Bool {
      false
    },
    program_status: fn(report: program_status::Report) Bool {
      false
    },
    program_status_supported: fn() Bool {
      false
    },
    focused: fn() Bool {
      false
    },
  }
}

// alert draws the user back to Kit: it rings the bell and, unless the user
// is already looking at the terminal, sends a desktop notification. A
// terminal that supports the Program Status Protocol notifies about the
// records Kit reports instead, so Kit sends none of its own.
fn alert(terminal: Terminal, title: Str, message: Str) {
  let _ = (terminal.bell)()
  if not (terminal.focused)() or (terminal.program_status_supported)() {
    let _ = (terminal.notify)(message, title)
  }
}

// A request waiting for the user's answer.
struct Request {
  // Identifies the request; a different request is reported anew.
  id: Str,
  kind: program_status::Kind,
  // One line describing what the request asks.
  message: Str,
}

// The request that interaction makes of the user: a model's confirmation asks
// for permission, and every other model or plugin request asks a question.
fn request(interaction: protocol::InteractionRequest) Request {
  let permission = interaction.Kind == protocol::InteractionConfirm and unsafe::is_nil(interaction.Plugin)
  let title = strings::TrimSpace(interaction.Title)
  Request{
    id: interaction.ID,
    kind: match permission {
      true => program_status::Kind::permission,
      false => program_status::Kind::question,
    },
    message: match title == "" {
      true => "A request is waiting for your answer",
      false => title,
    },
  }
}

// Kit's state as the Program Status Protocol reports it on the root record.
struct Program {
  // Whether Kit is signed out or connecting a provider.
  auth: Bool,
  // The oldest request waiting for the user's answer.
  request: Request?,
  // Whether a turn or compaction runs.
  working: Bool,
  // The last turn seen to finish, and its status: completed, failed,
  // interrupted, or aborted. Empty before any.
  finished_turn: Str,
  finished_status: Str,
}

// Nothing to report but an idle session.
fn idle_program() Program {
  Program{
    auth: false,
    request: Maybe::new<Request>(),
    working: false,
    finished_turn: "",
    finished_status: "",
  }
}

// A report for the root record. `key` identifies it: the terminal treats each
// report as a new event, so one is sent only when its key changes. `busy`
// reports that Kit is working or waiting for the user, which supersedes the
// outcome of the turn that finished before.
struct Planned {
  key: Str,
  busy: Bool,
  report: program_status::Report,
}

private fn kit_report(state: program_status::State, message: Str) program_status::Report {
  program_status::Report{
    state: state,
    app: "kit",
    message: message,
  }
}

private fn blocked(key: Str, kind: program_status::Kind, message: Str) Planned {
  Planned{
    key: key,
    busy: true,
    report: kit_report(program_status::Blocked{kind: kind}, message),
  }
}

// What to report for program. superseded names a finished turn whose outcome
// later work has replaced: it reports idle rather than repeat the outcome.
fn plan(program: Program, superseded: Str) Planned {
  let idle = Planned{
    key: "idle",
    busy: false,
    report: kit_report(program_status::Idle{}, ""),
  }
  let turn = program.finished_turn
  match program.auth {
    true => blocked("auth", program_status::Kind::auth, "Connect an AI provider"),
    false => {
      match program.request {
        waiting => blocked("request:{waiting.id}", waiting.kind, waiting.message),
        _ => {
          match {
            program.working => {
              Planned{
                key: "working",
                busy: true,
                report: kit_report(program_status::Working{}, ""),
              }
            },
            turn == "" or turn == superseded => idle,
            program.finished_status == "completed" => {
              Planned{
                key: "done:{turn}",
                busy: false,
                report: kit_report(program_status::Done{}, "Agent turn complete"),
              }
            },
            program.finished_status == "aborted" => idle,
            _ => {
              Planned{
                key: "error:{turn}",
                busy: false,
                report: kit_report(program_status::Failed{}, "Agent turn failed"),
              }
            },
          }
        },
      }
    },
  }
}

struct Props {
  terminal: Terminal,
  session_name: Str,
  cwd: Str,
  // Whether the session is doing work the user is waiting for.
  running: Bool,
  // Identifies the running work; a new identity restarts the animation.
  work_id: Str,
  // Whether the running work is waiting for an answer from the user.
  feedback: Bool,
  // What the Program Status Protocol reports.
  program: Program,
  // Overrides the animation cadence derived from the environment.
  frame_duration: time::Duration?,
}

enum Status {
  idle,
  running,
  feedback,
}

struct Reporter {
  props: mut Props,
  context: cui::Context?,
  frame_duration: time::Duration,
  frame: Int,
  status: Status,
  work_id: Str,
  // Stops the current animation worker; absent while idle.
  ticker: Chan<Void>?,
  progress: terminal_progress::State?,
  // The key of the last program status report; empty before the first.
  program_key: Str,
  // The finished turn whose outcome later work superseded.
  superseded: Str,
}

// reporter publishes status while mounted and renders nothing.
fn reporter(props: Props) cui::View {
  cui::child(new, props)
}

private fn new(props: mut Props) mut Reporter {
  (mut Reporter{
    props: props,
    context: Maybe::new<cui::Context>(),
    frame_duration: props.frame_duration.or(frame_duration(os::Getenv)),
    frame: 0,
    status: Status::idle,
    work_id: "",
    ticker: Maybe::new<Chan<Void>>(),
    progress: Maybe::new<terminal_progress::State>(),
    program_key: "",
    superseded: "",
  })
}

impl cui::Lifecycle for Reporter {
  fn mut mounted(ctx: cui::Context) {
    self.context = Maybe::new(ctx)
    self.publish()
  }

  fn mut unmounting(ctx: cui::Context) {
    // Leave the terminal with the idle title and no progress.
    self.stop_ticker()
    let _ = (self.props.terminal.set_title)(title(self.props.session_name, self.props.cwd, ""))
    let _ = (self.props.terminal.progress)(terminal_progress::State::remove)
    self.context = Maybe::new<cui::Context>()
  }
}

impl cui::Component for Reporter {
  fn mut render() cui::View {
    // Props arrive with each parent render, so publishing here follows every
    // status change. The terminal ignores repeated titles.
    self.publish()
    cui::box([], styles: ui::style(display: ui::Display::none))
  }
}

impl Reporter {
  private fn mut publish() {
    let status = match {
      not self.props.running => Status::idle,
      self.props.feedback => Status::feedback,
      _ => Status::running,
    }
    let replaced = status != Status::idle and self.props.work_id != self.work_id
    if status != self.status or replaced {
      self.status = status
      self.work_id = self.props.work_id
      self.frame = 0
      self.stop_ticker()
    }
    if self.status == Status::running and self.ticker.is_none() {
      self.start_ticker()
    }
    let marker = match self.status {
      Status::running => running_frames.at(self.frame % running_frames.size()).expect("running frame"),
      Status::feedback => "?",
      Status::idle => "",
    }
    let _ = (self.props.terminal.set_title)(title(self.props.session_name, self.props.cwd, marker))
    let progress = match self.status {
      Status::running => terminal_progress::State::indeterminate,
      Status::feedback => terminal_progress::State::paused,
      Status::idle => terminal_progress::State::remove,
    }
    let reported = match self.progress {
      current => current == progress,
      _ => false,
    }
    if not reported {
      // Unsupported terminals reject progress; remember the request anyway so
      // each frame does not retry it.
      let _ = (self.props.terminal.progress)(progress)
      self.progress = Maybe::new(progress)
    }
    self.publish_program()
  }

  // Reports the root record when it changes. Cooper clears or idles the
  // record when the application is destroyed.
  private fn mut publish_program() {
    let program = self.props.program
    let planned = plan(program, self.superseded)
    if planned.busy {
      self.superseded = program.finished_turn
    }
    if planned.key != self.program_key {
      // A terminal that rejects the report is not asked again until the
      // state changes.
      self.program_key = planned.key
      let _ = (self.props.terminal.program_status)(planned.report)
    }
  }

  // Advances the running marker until stopped or unmounted. Frames dispatch to
  // this component alone, so animation does not re-render the shell.
  private fn mut start_ticker() {
    match self.context {
      ctx => {
        let stop = Chan::new<Void>(1)
        self.ticker = Maybe::new(stop)
        let cancellation = ctx.cancellation
        let dispatch = ctx.dispatch
        let duration = self.frame_duration
        async::start(fn() {
          mut active = true
          while active {
            select {
              cancellation.recv() => { active = false },
              stop.recv() => { active = false },
              time::After(duration).recv() => {
                if dispatch(fn() {
                  if self.status == Status::running {
                    self.frame = self.frame + 1
                  }
                }).is_err() {
                  active = false
                }
              },
            }
          }
        })
      },
      _ => (),
    }
  }

  private fn mut stop_ticker() {
    match self.ticker {
      stop => {
        stop.send(())
        self.ticker = Maybe::new<Chan<Void>>()
      },
      _ => (),
    }
  }
}

// title formats `kit - <session> - <directory>`, omitting unknown parts, with
// an optional status marker in front.
fn title(session_name: Str, cwd: Str, marker: Str) Str {
  let parts = mut List::new<Str>()
  parts.push("kit")
  let name = sanitize(session_name)
  if name != "" {
    parts.push(name)
  }
  if cwd != "" {
    let base = sanitize(filepath::Base(filepath::Clean(cwd)))
    if base != "" and base != "." {
      parts.push(base)
    }
  }
  mut joined = ""
  for part in parts {
    joined = match joined == "" {
      true => part,
      false => "{joined} - {part}",
    }
  }
  match marker == "" {
    true => joined,
    false => "{marker} {joined}",
  }
}

// sanitize drops control and invisible formatting characters, which could
// otherwise end the title sequence or disguise the title.
private fn sanitize(value: Str) Str {
  let output = mut strings::Builder{}
  for character in value {
    let rune = Int32::from(character)
    let hidden = unicode::IsControl(rune) or unicode::Is(unicode::Cf, rune)
    if not hidden {
      output.WriteRune(rune)
      ()
    }
  }
  strings::TrimSpace(output.String())
}

private fn frame_duration(getenv: fn(Str) Str) time::Duration {
  match getenv("TMUX") != "" or getenv("STY") != "" {
    true => multiplexer_frame_duration,
    false => title_frame_duration,
  }
}

test fn titles_show_the_session_and_directory() Void!Str {
  try testing::assert(title("Fix pager", "/work/kit", "") == "kit - Fix pager - kit", "idle")
  try testing::assert(title("Fix pager", "/work/kit", "⠋") == "⠋ kit - Fix pager - kit", "running")
  try testing::assert(title("", "/work/kit", "⠋") == "⠋ kit - kit", "unnamed")
  try testing::assert(title("Setup", "", "") == "kit - Setup", "unknown directory")
  testing::assert(title("", "", "") == "kit", "nothing known")
}

test fn titles_remove_control_characters() Void!Str {
  let got = title("Review\x1b]2;ow\u202ened\a", "/work/ki\nt", "")
  testing::assert(got == "kit - Review]2;owned - kit", "got {got}")
}

test fn multiplexers_slow_the_running_animation() Void!Str {
  try testing::assert(
    frame_duration(fn(name: Str) Str {
      match name == "TMUX" {
        true => "/tmp/tmux-501/default,1,0",
        false => "",
      }
    }) == multiplexer_frame_duration,
    "tmux",
  )
  try testing::assert(
    frame_duration(fn(name: Str) Str {
      match name == "STY" {
        true => "1.pts-0",
        false => "",
      }
    }) == multiplexer_frame_duration,
    "screen",
  )
  testing::assert(
    frame_duration(fn(name: Str) Str {
      ""
    }) == title_frame_duration,
    "direct",
  )
}

private struct Alerts {
  focused: Bool,
  program_status: Bool,
  log: [Str],
}

private fn alert_terminal(alerts: mut Alerts) Terminal {
  Terminal{
    set_title: fn(value: Str) Bool {
      true
    },
    progress: fn(state: terminal_progress::State) Bool {
      true
    },
    bell: fn() Bool {
      alerts.log.push("bell")
      true
    },
    notify: fn(message: Str, title: Str) Bool {
      alerts.log.push("{title}: {message}")
      true
    },
    program_status: fn(report: program_status::Report) Bool {
      true
    },
    program_status_supported: fn() Bool {
      alerts.program_status
    },
    focused: fn() Bool {
      alerts.focused
    },
  }
}

test fn an_alert_rings_and_notifies_only_while_the_terminal_is_unfocused() Void!Str {
  let alerts = mut Alerts{
    focused: false,
    program_status: false,
    log: [],
  }
  alert(alert_terminal(alerts), "Kit", "Agent turn complete")
  try testing::assert(
    alerts.log.size() == 2 and alerts.log.at(0).or("") == "bell" and alerts.log.at(1).or("") == "Kit: Agent turn complete",
    "an unfocused terminal rings and notifies",
  )
  alerts.focused = true
  alert(alert_terminal(alerts), "Kit", "Agent turn complete")
  testing::assert(
    alerts.log.size() == 3 and alerts.log.at(2).or("") == "bell",
    "a focused terminal only rings",
  )
}

test fn a_terminal_with_program_status_notifies_in_place_of_kit() Void!Str {
  let alerts = mut Alerts{
    focused: false,
    program_status: true,
    log: [],
  }
  alert(alert_terminal(alerts), "Kit", "Agent turn complete")
  testing::assert(
    alerts.log.size() == 1 and alerts.log.at(0).or("") == "bell",
    "only the bell rings: {strings::Join(mut alerts.log, " | ")}",
  )
}

test fn a_models_confirmation_asks_permission_and_other_requests_ask_questions() Void!Str {
  let confirmation = request(
    protocol::InteractionRequest{
      ID: "r1",
      Kind: protocol::InteractionConfirm,
      Title: " Run rm -rf build? ",
    },
  )
  try testing::assert(
    confirmation.kind == program_status::Kind::permission and confirmation.message == "Run rm -rf build?",
    "a model's confirmation",
  )
  let plugin = request(
    protocol::InteractionRequest{
      ID: "r2",
      Kind: protocol::InteractionConfirm,
      Title: "Deploy?",
      Plugin: mut protocol::PluginInteractionOwner{PluginID: "deploy", Instance: "owner:1"},
    },
  )
  try testing::assert(plugin.kind == program_status::Kind::question, "a plugin's confirmation")
  let input = request(
    protocol::InteractionRequest{
      ID: "r3",
      Kind: protocol::InteractionInput,
      Title: "",
    },
  )
  testing::assert(
    input.kind == program_status::Kind::question and input.message == "A request is waiting for your answer",
    "an untitled input",
  )
}

private fn planned_key(program: Program, superseded: Str) Str {
  plan(program, superseded).key
}

test fn the_root_record_puts_auth_ahead_of_requests_and_work() Void!Str {
  let waiting = Request{
    id: "r1",
    kind: program_status::Kind::permission,
    message: "Run tests?",
  }
  let program = mut idle_program()
  try testing::assert(planned_key(program.@, "") == "idle", "nothing happened yet")
  program.working = true
  try testing::assert(planned_key(program.@, "") == "working", "a turn runs")
  program.request = Maybe::new(waiting)
  try testing::assert(planned_key(program.@, "") == "request:r1", "a request waits")
  program.auth = true
  testing::assert(planned_key(program.@, "") == "auth", "signed out")
}

test fn the_root_record_reports_how_the_last_turn_finished() Void!Str {
  let program = mut idle_program()
  program.finished_turn = "turn-1"
  program.finished_status = "completed"
  try testing::assert(planned_key(program.@, "") == "done:turn-1", "completed")
  program.finished_status = "failed"
  try testing::assert(planned_key(program.@, "") == "error:turn-1", "failed")
  program.finished_status = "interrupted"
  try testing::assert(planned_key(program.@, "") == "error:turn-1", "interrupted")
  program.finished_status = "aborted"
  try testing::assert(planned_key(program.@, "") == "idle", "aborted")
  program.finished_status = "completed"
  testing::assert(planned_key(program.@, "turn-1") == "idle", "superseded by later work")
}
