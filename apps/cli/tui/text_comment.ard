use cooper/ui

// A comment on selected text, opened from the selection menu's Comment, or
// from its chip to edit it (ADR 0070). Its box opens at the words
// (`comment_box`); saving adds the comment to those waiting for the next
// message, or replaces the one it edits.

// Request is the selected words, where they were selected, and where they
// are on screen.
struct Request {
  quote: Str,
  source: Str,
  // The words' cells, or the chip's when it edits a waiting comment.
  anchor: ui::Rect,
  // The waiting comment it edits, or 0 for a new one.
  editing: Int,
  // The comment the box opens with.
  comment: Str,
}
