use ard/async

use go:context
use cooper/animation
use cooper/cui
use cooper/event
use cooper/ui
use go:kit/ffi/contextbridge
use kit/tui/theme
use go:strings
use go:time

// Variant communicates the severity of a transient application notification.
enum Variant {
  info,
  warning,
  error,
}

// Item is one displayed notification.
struct Item {
  id: Int,
  title: Str,
  detail: Str,
  variant: Variant,
  persistent: Bool,
}

// The host keeps at most this many notifications, evicting the oldest
// transient one first.
let capacity = 5

// Request is a notification or reset awaiting delivery to the host.
struct Request {
  clear: Bool,
  title: Str,
  detail: Str,
  variant: Variant,
  persistent: Bool,
}

// Control is the narrow surface other owners use to raise notifications.
// Requests are delivered through the host's own context; requests made before
// the host mounts are buffered and delivered in order when it does.
struct Control {
  deliver: fn(Request)?,
  pending: [Request],
}

fn control() mut Control {
  (mut Control{deliver: Maybe::new<fn(Request)>(), pending: []})
}

impl Control {
  // show raises a notification. Persistent notifications remain until
  // dismissed; others expire.
  fn mut show(title: Str, detail: Str, variant: Variant, persistent: Bool) {
    self.send(
      Request{
        clear: false,
        title: title,
        detail: detail,
        variant: variant,
        persistent: persistent,
      },
    )
  }

  // clear removes every current notification.
  fn mut clear() {
    self.send(
      Request{
        clear: true,
        title: "",
        detail: "",
        variant: Variant::info,
        persistent: false,
      },
    )
  }

  // pending_count reports requests still awaiting a mounted host.
  fn pending_count() Int {
    self.pending.size()
  }

  private fn mut send(request: Request) {
    match self.deliver {
      deliver => deliver(request),
      _ => {
        if request.clear {
          self.pending = []
        } else {
          self.pending.push(request)
        }
      },
    }
  }
}

struct HostProps {
  themes: theme::Context,
  control: mut Control,
  expiry: time::Duration,
}

// Host owns the application's notifications: their order, bound, expiry, and
// dismissal. It must stay mounted for the application's lifetime.
struct Host {
  props: mut HostProps,
  context: cui::Context?,
  lifetime: contextbridge::Cancellation?,
  items: [Item],
  next_id: Int,
}

// host mounts the notification overlay. expiry defaults to ten seconds.
fn host(themes: theme::Context, control: mut Control, expiry: time::Duration?) cui::View {
  cui::child(
    new_host,
    HostProps{
      themes: themes,
      control: control,
      expiry: expiry.or(time::Second * 10),
    },
    key: "toast.host",
  )
}

private fn new_host(props: mut HostProps) mut Host {
  (mut Host{
    props: props,
    context: Maybe::new<cui::Context>(),
    lifetime: Maybe::new<contextbridge::Cancellation>(),
    items: [],
    next_id: 0,
  })
}

impl cui::Lifecycle for Host {
  fn mut mounted(ctx: cui::Context) {
    self.context = Maybe::new(ctx)
    self.lifetime = Maybe::new(contextbridge::WithCancel(context::Background()))
    let control = self.props.control
    let dispatch = ctx.dispatch
    control.deliver = Maybe::new(fn(request: Request) {
      let _ = dispatch(fn() {
        self.apply(request)
      })
    })
    for request in control.pending {
      self.apply(request)
    }
    control.pending = []
  }

  fn mut unmounting(ctx: cui::Context) {
    // Pending expiry timers end with the host.
    match self.lifetime {
      lifetime => lifetime.Cancel(),
      _ => (),
    }
    self.props.control.deliver = Maybe::new<fn(Request)>()
  }
}

impl Host {
  private fn mut apply(request: Request) {
    match request.clear {
      true => { self.items = [] },
      false => self.show(request),
    }
  }

  private fn mut show(request: Request) {
    let title = strings::TrimSpace(request.title)
    if title != "" {
      self.next_id =+ 1
      let id = self.next_id
      self.items.push(
        Item{
          id: id,
          title: title,
          detail: strings::TrimSpace(request.detail),
          variant: request.variant,
          persistent: request.persistent,
        },
      )
      if self.items.size() > capacity {
        mut victim = self.items.at(0).expect("notification")
        for item in self.items {
          if victim.persistent and not item.persistent {
            victim = item
          }
        }
        self.dismiss(victim.id)
      }
      if not request.persistent {
        self.expire(id)
      }
    }
  }

  private fn mut expire(id: Int) {
    match self.context {
      ctx => {
        match self.lifetime {
          lifetime => {
            let dispatch = ctx.dispatch
            let after = self.props.expiry
            async::start(fn() {
              select {
                lifetime.Context.Done().recv() => (),
                time::After(after).recv() => {
                  let _ = dispatch(fn() {
                    self.dismiss(id)
                  })
                },
              }
            })
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  private fn mut dismiss(id: Int) {
    let retained = mut List::new<Item>()
    for item in self.items {
      if item.id != id {
        retained.push(item)
      }
    }
    self.items = retained.@
  }

  private fn mut request_dismissal(id: Int) {
    match self.context {
      ctx => {
        let _ = ctx.dispatch(fn() {
          self.dismiss(id)
        })
      },
      _ => (),
    }
  }
}

impl cui::Component for Host {
  fn mut render() cui::View {
    stack(self.props.themes, self.items, fn(id: Int) {
      self.request_dismissal(id)
    })
  }
}

// stack renders the application's non-modal notification overlay.
fn stack(themes: theme::Context, items: [Item], dismiss: fn(Int)) cui::View {
  let cards = mut List::new<cui::View>()
  for item in items {
    cards.push(
      cui::child(
        new_toast,
        ToastProps{
          themes: themes,
          item: item,
          dismiss: dismiss,
        },
      ),
    )
  }
  cui::box(
    cards.@,
    key: "toast.stack",
    styles: ui::style(
      position: ui::Position::absolute,
      top: ui::cells(2),
      right: ui::cells(2),
      width: ui::percent(60.0),
      flex_direction: ui::FlexDirection::column,
      gap: ui::cells(1),
      align_items: ui::Align::end,
      z_index: 200,
    ),
  )
}

struct ToastProps {
  themes: theme::Context,
  item: Item,
  dismiss: fn(Int),
}

struct Toast {
  props: mut ToastProps,
  offset: Int,
}

private fn new_toast(props: mut ToastProps) mut Toast {
  (mut Toast{props: props, offset: 20})
}

impl cui::Lifecycle for Toast {
  fn mut mounted(ctx: cui::Context) {
    let _ = ctx.animate(
      300,
      fn(frame: animation::Frame) {
        self.offset = animation::lerp_int(20, 0, frame.progress)
      },
      ease: animation::out_circ,
    )
  }

  fn mut unmounting(ctx: cui::Context) {}
}

impl cui::Component for Toast {
  fn mut render() cui::View {
    cui::box(
      [card(self.props.themes.current(), self.props.item, self.offset, self.props.dismiss)],
      key: "toast.frame.{self.props.item.id}",
      styles: ui::style(position: ui::Position::relative, overflow: ui::Overflow::hidden),
    )
  }
}

private fn card(colors: theme::Theme, item: Item, offset: Int, dismiss: fn(Int)) cui::View {
  let color = match item.variant {
    Variant::info => colors.primary,
    Variant::warning => colors.warning_text,
    Variant::error => colors.danger_text,
  }
  let icon = match item.variant {
    Variant::info => "●",
    Variant::warning => "▲",
    Variant::error => "×",
  }
  let text = mut List::new<cui::View>()
  text.push(cui::text(item.title, text_style: ui::text_style(foreground: color)))
  if item.detail != "" {
    text.push(
      cui::text(
        item.detail,
        text_style: ui::text_style(foreground: colors.muted),
        wrap: ui::TextWrap::word,
      ),
    )
  }
  let content = mut List::new<cui::View>()
  content.push(cui::text(icon, text_style: ui::text_style(foreground: color)))
  let text_box = match item.detail != "" {
    true => cui::box(text.@, styles: ui::style(flex_direction: ui::FlexDirection::column)),
    false => cui::box(text.@, styles: ui::style(flex_direction: ui::FlexDirection::column)),
  }
  content.push(text_box)
  if item.persistent {
    content.push(
      cui::box(
        [cui::text("×", text_style: ui::text_style(foreground: colors.muted))],
        styles: ui::style(
          padding: ui::Edges{
            top: ui::cells(0),
            right: ui::cells(0),
            bottom: ui::cells(0),
            left: ui::cells(1),
          },
        ),
        on_mouse: fn(received: mut event::MouseEvent, ctx: cui::Context) {
          received.prevent_default()
          dismiss(item.id)
        },
      ),
    )
  }
  cui::box(
    content.@,
    key: "toast.{item.id}",
    styles: ui::style(
      position: ui::Position::relative,
      left: ui::cells(offset),
      flex_direction: ui::FlexDirection::row,
      gap: ui::cells(1),
      padding: ui::Edges{
        top: ui::cells(0),
        right: ui::cells(1),
        bottom: ui::cells(0),
        left: ui::cells(1),
      },
      background: colors.background,
      width: ui::fit_content(),
      border: ui::Border::single,
      border_color: color,
    ),
    on_mouse: fn(received: mut event::MouseEvent, ctx: cui::Context) {
      received.prevent_default()
    },
  )
}
