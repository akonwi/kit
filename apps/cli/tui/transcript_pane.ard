use cooper
use cooper/cui
use cooper/keymap
use cooper/ui
use go:github.com/akonwi/vaxis
use go:kit/ffi/pluginmessage
use go:kit/ffi/sessionbridge
use kit/tui/attachments
use kit/tui/controls
use kit/tui/image_preview
use kit/tui/layout
use kit/tui/markdown
use kit/tui/spinner
use kit/tui/theme
use kit/tui/transcript
use go:strings

// The retained conversation transcript. The attached-session owner supplies
// projected messages; this component owns presentation state only: the
// virtual list, its reading position and sticky tail, and whether the latest
// message is out of view.
//
// It opens at, and follows, its latest message until the user scrolls away;
// returning to the end resumes following. Short transcripts rest on the
// composer, as in the vaxis client. An assistant reply taller than the
// viewport opens at its first row instead, both when it arrives while the
// transcript follows its end and when an attachment opens on it, so reading
// starts at the beginning of the answer.
//
// Earlier history loads a page at a time once the view is within
// `history_threshold` rows of the top, which includes a first page too short
// to fill the viewport. A status row above the oldest message reports loading
// and failure; it disappears once the conversation's beginning is shown.

// Control is the host's handle to one attachment's transcript. Its list ref
// binds to the mounted virtual list; replace it with each new attachment.
struct Control {
  list: mut cui::VirtualListRef,
}

fn control() mut Control {
  (mut Control{list: cui::virtual_list_ref()})
}

impl Control {
  // Returns the transcript to its end and resumes following. UI-thread only.
  fn show_latest() Bool {
    match self.list.current {
      list => {
        let _ = list.scroll_to_edge(cui::ScrollEdge::end, sticky: true)
        true
      },
      _ => false,
    }
  }
}

// Rows from the top at which the next earlier page is requested.
let history_threshold = 40
// The history status row and the blank row above it.
let status_rows = 2

// History is the attachment's earlier-transcript paging state.
struct History {
  // Whether earlier messages exist beyond the oldest one shown.
  more: Bool,
  loading: Bool,
  // The last failure; automatic loading pauses until retried.
  failure: Str,
}

// Images attached to user messages. Clicking an image's row toggles its
// preview; at most one is expanded.
struct Images {
  // The attachment ID of the expanded image, if any.
  expanded: Str,
  // The expanded image's preview, once requested.
  preview: fn(Str) image_preview::Preview?,
  // Expands an image, or collapses the expanded one.
  toggle: fn(Str),
  // Opens an image in the system's default application.
  open: fn(Str),
}

// Direct shell runs. A finished run's header folds and unfolds its output.
struct Bash {
  // Execution IDs whose output is folded.
  folded: [Str: Bool],
  toggle: fn(Str),
}

// Plugin-submitted messages. Clicking one's row expands or collapses it.
struct Plugins {
  // Turn IDs whose plugin message is expanded. A plugin message keeps its
  // turn ID from the live event through the persisted transcript.
  expanded: [Str: Bool],
  toggle: fn(Str),
}

// Output lines a bash row shows before summarizing the rest.
let bash_visible_lines = 20

struct Props {
  themes: theme::Context,
  messages: [transcript::Message],
  control: mut Control,
  history: History,
  images: Images,
  bash: Bash,
  plugins: Plugins,
  // Requests the next earlier page. Repeated requests while one is in flight
  // are ignored by the owner.
  load_older: fn(),
}

struct Pane {
  props: mut Props,
  context: cui::Context?,
  // Derived from the VirtualList's committed visibility rather than estimates
  // from its pre-layout rows. It stays false while any portion of a tall
  // latest reply is visible.
  latest_out_of_view: Bool,
  // The last row and whether it is an assistant reply, as last rendered.
  tail_key: Str,
  tail_is_reply: Bool,
  // The last row already considered for opening at its start. Absent until
  // the first committed update, so an attachment's initial reply counts.
  arrived_tail: Str?,
  // A reply aligned to its start whose fit is confirmed by the next update.
  aligning: Str?,
  // The committed scroll position, absent until the list first reports.
  scroll_top: Int?,
  // The oldest message row and whether the history status sat above it, as
  // last rendered.
  head_key: Str,
  head_status: Bool,
}

// One transcript row: a message, or the earlier-history status, and its
// stable virtual-list key.
struct Entry {
  key: Str,
  message: transcript::Message,
  last: Bool,
  status: Bool,
}

let history_status_key = "history:status"

// pane retains one attachment's transcript. `scope_id` remounts it, resetting
// presentation state, when a new attachment replaces the old one.
fn pane(props: Props, scope_id: Int) cui::View {
  cui::child(new, props, key: "transcript:{scope_id}")
}

private fn new(props: mut Props) mut Pane {
  (mut Pane{
    props: props,
    context: Maybe::new<cui::Context>(),
    latest_out_of_view: false,
    tail_key: "",
    tail_is_reply: false,
    arrived_tail: Maybe::new<Str>(),
    aligning: Maybe::new<Str>(),
    scroll_top: Maybe::new<Int>(),
    head_key: "",
    head_status: false,
  })
}

impl cui::Lifecycle for Pane {
  fn mut mounted(context: cui::Context) {
    self.context = Maybe::new(context)
  }

  fn mut unmounting(context: cui::Context) {}
}

impl Pane {
  // Committed list updates report the latest message's visibility. Only
  // changes dispatch, so a settled list does not schedule further renders.
  private fn mut observe(update: cui::VirtualListUpdate) {
    self.scroll_top = Maybe::new(update.state.scroll_top)
    self.open_tall_reply(update)
    self.request_history(update.state.scroll_top)
    let hidden = not update.state.last_item_visible
    if hidden != self.latest_out_of_view {
      match self.context {
        context => {
          let _ = context.dispatch(fn() {
            self.latest_out_of_view = hidden
          })
        },
        _ => (),
      }
    }
  }

  // A reply arriving at the followed end is aligned to its start. Updates
  // are committed after painting, so its tail shows for one frame first.
  // Aligning a reply that fits clamps to the end, where following resumes
  // with no visible change.
  private fn mut open_tall_reply(update: cui::VirtualListUpdate) {
    match self.props.control.list.current {
      list => {
        match self.aligning {
          key => {
            self.aligning = Maybe::new<Str>()
            let fits = update.state.scroll_top >= update.state.maximum_scroll_top
            if fits and update.user_scroll.is_none() and key == self.tail_key {
              let _ = list.scroll_to_edge(cui::ScrollEdge::end, sticky: true)
            }
          },
          _ => (),
        }
        let arrived = match self.arrived_tail {
          previous => previous != self.tail_key,
          _ => true,
        }
        if arrived {
          self.arrived_tail = Maybe::new(self.tail_key)
          let following = match update.state.following_edge {
            edge => edge == cui::ScrollEdge::end,
            _ => false,
          }
          if self.tail_is_reply and following {
            list.stop_following()
            match list.scroll_to_key(self.tail_key, alignment: cui::ScrollAlignment::start) {
              true => { self.aligning = Maybe::new(self.tail_key) },
              false => {
                let _ = list.scroll_to_edge(cui::ScrollEdge::end, sticky: true)
              },
            }
          }
        }
      },
      _ => (),
    }
  }

  // A view resting on the history status anchors to the status itself, so a
  // prepended page would keep the top in view and pull reading back to the
  // start. Instead, the message that was oldest is aligned to the top.
  private fn mut keep_reading_position(head: Str) {
    let previous = self.head_key
    let had_status = self.head_status
    self.head_key = head
    self.head_status = self.props.history.more or self.props.history.loading or self.props.history.failure != ""
    if had_status and previous != "" and previous != head {
      match self.scroll_top {
        top => {
          if top < status_rows {
            match self.props.control.list.current {
              list => {
                if not list.is_following_edge() {
                  let _ = list.scroll_to_key(previous, alignment: cui::ScrollAlignment::start)
                }
              },
              _ => (),
            }
          }
        },
        _ => (),
      }
    }
  }

  // Requests the next earlier page while the view is near the top.
  private fn request_history(scroll_top: Int) {
    let history = self.props.history
    if history.more and (not history.loading) and history.failure == "" and scroll_top <= history_threshold {
      (self.props.load_older)()
    }
  }

  private fn mut list() cui::View {
    let themes = self.props.themes
    let images = self.props.images
    let bash = self.props.bash
    let plugins = self.props.plugins
    let colors = themes.current()
    self.tail_key = ""
    self.tail_is_reply = false
    let shown = mut List::new<transcript::Message>()
    for message in self.props.messages {
      if renders(message) {
        shown.push(message)
      }
    }
    match shown.size() == 0 {
      true => layout::empty_state(colors, "Ask a question or give a task."),
      false => {
        let entries = mut List::new<Entry>()
        let history = self.props.history
        let status = history.more or history.loading or history.failure != ""
        if status {
          entries.push(
            Entry{
              key: history_status_key,
              message: transcript::message("", "", transcript::Role::other),
              last: false,
              status: true,
            },
          )
        }
        mut position = 0
        for message in shown {
          let key = match message.id == "" {
            true => "pending:{position}",
            false => message.id,
          }
          entries.push(
            Entry{
              key: key,
              message: message,
              last: position == shown.size() - 1,
              status: false,
            },
          )
          if position == 0 {
            self.keep_reading_position(key)
          }
          position =+ 1
          self.tail_key = key
          self.tail_is_reply = message.role == transcript::Role::assistant
        }
        cui::virtual_list(
          entries.@,
          item_key: fn(entry: Entry) Str {
            entry.key
          },
          render_item: fn(entry: Entry) cui::View {
            match entry.status {
              true => self.history_row(),
              false => transcript_row(themes, images, bash, plugins, entry),
            }
          },
          estimated_height: 4,
          overscan: 2,
          key: "transcript",
          ref: self.props.control.list,
          sticky_scroll: cui::ScrollEdge::end,
          on_update: fn(update: cui::VirtualListUpdate, ctx: cui::Context) {
            self.observe(update)
          },
          styles: ui::style(flex_grow: 1.0, flex_basis: ui::cells(0)),
        )
      },
    }
  }

  // The status above the oldest message shown: loading, or a failure that
  // can be retried.
  private fn history_row() cui::View {
    let colors = self.props.themes.current()
    let muted = ui::text_style(foreground: colors.muted)
    let history = self.props.history
    let content = match {
      history.loading => {
        cui::box(
          [
            spinner::spinner(styles: ui::style(foreground: colors.muted)),
            layout::line(" Loading earlier messages…", muted),
          ],
          styles: ui::style(flex_direction: ui::FlexDirection::row),
        )
      },
      history.failure != "" => {
        let load_older = self.props.load_older
        let retry = keymap::simple_command(
          "transcript.history.retry",
          "Retry earlier messages",
          fn() Bool {
            load_older()
            true
          },
        )
        cui::box(
          [
            controls::button(
              self.props.themes,
              "Could not load earlier messages · retry",
              retry,
              variant: controls::ButtonVariant::secondary,
              compact: true,
              focusable: false,
            ),
          ],
          styles: ui::style(flex_direction: ui::FlexDirection::row),
        )
      },
      _ => layout::line("↑ Scroll for earlier messages", muted),
    }
    cui::box(
      [content],
      styles: ui::style(
        flex_direction: ui::FlexDirection::column,
        padding: ui::Edges{
          top: ui::cells(1),
          right: ui::cells(1),
          bottom: ui::cells(0),
          left: ui::cells(1),
        },
      ),
    )
  }

  private fn mut latest_button() cui::View {
    let control = self.props.control
    let latest = keymap::simple_command("transcript.latest", "Show latest", fn() Bool {
      control.show_latest()
    })
    controls::button(
      self.props.themes,
      "↓ Latest",
      latest,
      variant: controls::ButtonVariant::secondary,
      compact: true,
      focusable: false,
      styles: ui::style(
        position: ui::Position::absolute,
        right: ui::cells(1),
        bottom: ui::cells(1),
        z_index: 1,
      ),
    )
  }
}

impl cui::Component for Pane {
  fn mut render() cui::View {
    let children = mut List::new<cui::View>()
    children.push(self.list())
    // Paging state changes without a list update, as when a page brings no
    // displayable messages or nothing is shown yet, still continue loading.
    match self.tail_key == "" {
      true => self.request_history(0),
      false => {
        match self.scroll_top {
          top => self.request_history(top),
          _ => (),
        }
      },
    }
    if self.latest_out_of_view {
      children.push(self.latest_button())
    }
    cui::box(
      children.@,
      styles: ui::style(
        flex_grow: 1.0,
        flex_basis: ui::cells(0),
        position: ui::Position::relative,
        overflow: ui::Overflow::visible,
      ),
    )
  }
}

// Each row keeps a blank row above it; the last also keeps one below.
private fn transcript_row(
  themes: theme::Context,
  images: Images,
  bash: Bash,
  plugins: Plugins,
  entry: Entry,
) cui::View {
  let bottom = match entry.last {
    true => 1,
    false => 0,
  }
  cui::box(
    [entry_view(themes, images, bash, plugins, entry.key, entry.message).or(layout::blank())],
    styles: ui::style(
      flex_direction: ui::FlexDirection::column,
      padding: ui::Edges{
        top: ui::cells(1),
        right: ui::cells(1),
        bottom: ui::cells(bottom),
        left: ui::cells(1),
      },
    ),
  )
}

// Whether a message has visible transcript content.
private fn renders(message: transcript::Message) Bool {
  match message.role {
    // Buffer streamed prose in the model, but reveal it only after the
    // assistant message settles so incomplete Markdown never reaches layout.
    transcript::Role::user => message.text != "" or message.attachments.size() > 0,
    transcript::Role::assistant => message.text != "" and not message.pending,
    transcript::Role::tool => true,
    transcript::Role::bash => message.bash.is_some(),
    transcript::Role::plugin => message.text != "",
    transcript::Role::other => false,
  }
}

private fn entry_view(
  themes: theme::Context,
  images: Images,
  bash: Bash,
  plugins: Plugins,
  key: Str,
  message: transcript::Message,
) cui::View? {
  let colors = themes.current()
  match message.role {
    transcript::Role::user => user_entry(themes, images, key, message),
    transcript::Role::assistant => {
      let tone = match {
        message.aborted => colors.muted,
        message.is_error => colors.danger_text,
        _ => colors.foreground,
      }
      match message.text == "" {
        true => Maybe::new<cui::View>(),
        false => {
          Maybe::new(
            markdown::view(
              themes,
              key,
              message.text,
              base: ui::text_style(foreground: tone),
              semantic: (not message.aborted) and not message.is_error,
            ),
          )
        },
      }
    },
    transcript::Role::tool => Maybe::new(tool_entry(colors, message)),
    transcript::Role::bash => {
      match message.bash {
        run => Maybe::new(bash_entry(colors, bash, run)),
        _ => Maybe::new<cui::View>(),
      }
    },
    transcript::Role::plugin => Maybe::new(plugin_entry(themes, plugins, message)),
    transcript::Role::other => Maybe::new<cui::View>(),
  }
}

// A user turn: a tinted wash with half-block edges and two-cell padding.
private fn user_entry(
  themes: theme::Context,
  images: Images,
  key: Str,
  message: transcript::Message,
) cui::View? {
  let colors = themes.current()
  match message.text == "" and message.attachments.size() == 0 {
    true => Maybe::new<cui::View>(),
    false => {
      let body = mut List::new<cui::View>()
      if message.text != "" {
        body.push(
          markdown::view(
            themes,
            key,
            message.text,
            base: ui::text_style(foreground: colors.foreground, background: colors.user_fill),
          ),
        )
      }
      if message.text != "" and message.attachments.size() > 0 {
        body.push(cui::box([], styles: ui::style(height: ui::cells(1), flex_shrink: 0.0)))
      }
      for attachment in message.attachments {
        let expanded = attachment.image and attachment.id != "" and images.expanded == attachment.id
        body.push(attachment_label(colors, images, attachment))
        if expanded {
          let preview = (images.preview)(attachment.id).or(image_preview::loading())
          let open = images.open
          let id = attachment.id
          body.push(
            image_preview::view(themes, id, preview, fn() {
              open(id)
            }),
          )
        }
      }
      let edge = fn(glyph: Str) cui::View {
        cui::text(
          strings::Repeat(glyph, 1024),
          styles: ui::style(height: ui::cells(1), flex_shrink: 0.0),
          text_style: ui::text_style(foreground: colors.user_fill),
          wrap: ui::TextWrap::none,
        )
      }
      Maybe::new(
        cui::box(
          [
            edge("▄"),
            cui::box(
              body.@,
              styles: ui::style(
                flex_direction: ui::FlexDirection::column,
                background: colors.user_fill,
                padding: ui::Edges{
                  top: ui::cells(0),
                  right: ui::cells(2),
                  bottom: ui::cells(0),
                  left: ui::cells(2),
                },
              ),
            ),
            edge("▀"),
          ],
          styles: ui::style(flex_direction: ui::FlexDirection::column, flex_shrink: 0.0),
        ),
      )
    },
  }
}

// One attached file in a user message. An image's row toggles its preview.
private fn attachment_label(
  colors: theme::Theme,
  images: Images,
  attachment: transcript::Attachment,
) cui::View {
  let previewable = attachment.image and attachment.id != ""
  let toggle = images.toggle
  let id = attachment.id
  cui::box(
    [
      layout::line(
        "{attachments::glyph} {attachment.filename}",
        ui::text_style(foreground: colors.primary_text, background: colors.user_fill),
      ),
    ],
    styles: ui::style(
      height: ui::cells(1),
      flex_shrink: 0.0,
      flex_direction: ui::FlexDirection::row,
    ),
    on_mouse: fn(received: mut cooper::MouseEvent, ctx: cui::Context) {
      if previewable and received.event_type == cooper::MouseEventType::up and received.button == cooper::MouseButton::left {
        toggle(id)
        received.prevent_default()
      }
    },
  )
}

// A shell command typed in the composer, as in the vaxis client: a success
// rule on the left, a spinner while it runs and then its outcome, the command,
// and its muted output. Clicking a finished header folds the output.
private fn bash_entry(colors: theme::Theme, bash: Bash, run: sessionbridge::Bash) cui::View {
  let output: [Str] = match run.Output == "" {
    true => [],
    false => strings::Split(run.Output, "\n"),
  }
  let foldable = (not run.Running()) and output.size() > 0
  let folded = bash.folded.get(run.ID).or(false)
  let header = mut List::new<cui::View>()
  if run.Running() {
    header.push(spinner::spinner(styles: ui::style(foreground: colors.success_text)))
  } else {
    let outcome = bash_outcome(colors, run)
    header.push(cui::text(outcome.glyph, text_style: ui::text_style(foreground: outcome.color)))
  }
  header.push(
    cui::text(
      strings::ReplaceAll(run.Command, "\t", "  "),
      styles: ui::style(
        flex_grow: 1.0,
        flex_basis: ui::cells(0),
        min_width: ui::cells(0),
        padding: ui::Edges{
          top: ui::cells(0),
          right: ui::cells(0),
          bottom: ui::cells(0),
          left: ui::cells(1),
        },
      ),
      text_style: ui::text_style(foreground: colors.foreground),
      selectable: true,
      selection_style: theme::selection_style(colors),
    ),
  )
  if foldable {
    header.push(
      cui::text(
        match folded {
          true => " ▸",
          false => " ▾",
        },
        text_style: ui::text_style(foreground: colors.muted),
      ),
    )
  }
  let toggle = bash.toggle
  let id = run.ID
  let body = mut List::new<cui::View>()
  body.push(
    cui::box(
      header.@,
      styles: ui::style(flex_direction: ui::FlexDirection::row, flex_shrink: 0.0),
      on_mouse: fn(received: mut cooper::MouseEvent, ctx: cui::Context) {
        if foldable and received.event_type == cooper::MouseEventType::up and received.button == cooper::MouseButton::left {
          toggle(id)
          received.prevent_default()
        }
      },
    ),
  )
  if foldable and not folded {
    mut shown = output
    if output.size() > bash_visible_lines {
      let kept = mut List::new<Str>()
      for line, index in output {
        if index < bash_visible_lines - 2 {
          kept.push(line)
        }
      }
      kept.push("… ({output.size() - (bash_visible_lines - 2)} more lines)")
      shown = kept.@
    }
    body.push(
      cui::text(
        strings::Join(mut shown, "\n"),
        styles: ui::style(
          padding: ui::Edges{
            top: ui::cells(0),
            right: ui::cells(0),
            bottom: ui::cells(0),
            left: ui::cells(2),
          },
        ),
        text_style: ui::text_style(foreground: colors.muted),
        selectable: true,
        selection_style: theme::selection_style(colors),
      ),
    )
  }
  cui::box(
    [
      // The rule spans the entry without adding to its height.
      cui::text(
        strings::Repeat("│\n", 1023) + "│",
        styles: ui::style(
          position: ui::Position::absolute,
          top: ui::cells(0),
          bottom: ui::cells(0),
          left: ui::cells(0),
          width: ui::cells(1),
          overflow: ui::Overflow::hidden,
        ),
        text_style: ui::text_style(foreground: colors.success_text),
        wrap: ui::TextWrap::none,
      ),
      cui::box(
        body.@,
        styles: ui::style(
          flex_direction: ui::FlexDirection::column,
          padding: ui::Edges{
            top: ui::cells(0),
            right: ui::cells(0),
            bottom: ui::cells(0),
            left: ui::cells(2),
          },
        ),
      ),
    ],
    styles: ui::style(
      position: ui::Position::relative,
      flex_direction: ui::FlexDirection::column,
      flex_shrink: 0.0,
      overflow: ui::Overflow::hidden,
    ),
  )
}

// A plugin-submitted message, as in the vaxis client: one quiet row naming
// the plugin and summarizing the message's first line. A message of several
// lines, or one line too long for the row, expands to show it in full beneath
// a left rule; a single line that fits is shown whole and does not expand.
// The message is context the plugin gave the agent, so it stays subordinate
// to user and assistant messages.
fn plugin_entry(themes: theme::Context, plugins: Plugins, message: transcript::Message) cui::View {
  cui::child(
    new_plugin_row,
    PluginRowProps{
      themes: themes,
      plugins: plugins,
      message: message,
    },
    key: "plugin",
  )
}

private struct PluginRowProps {
  themes: theme::Context,
  plugins: Plugins,
  message: transcript::Message,
}

private struct PluginRow {
  props: mut PluginRowProps,
  header: mut cui::BoxRef,
  // Whether the one-line row cuts the message's summary, as last laid out.
  overflows: Bool,
}

private fn new_plugin_row(props: mut PluginRowProps) mut PluginRow {
  (mut PluginRow{
    props: props,
    header: cui::box_ref(),
    overflows: false,
  })
}

impl cui::Lifecycle for PluginRow {
  fn mut mounted(context: cui::Context) {
    // Measured after each layout and before painting, so a row never paints
    // with a toggle it no longer needs, or without one it now needs.
    let _ = context.internal_layout(fn() Bool {
      self.measure()
    })
  }

  fn mut unmounting(context: cui::Context) {}
}

impl PluginRow {
  // Updates whether the summary overflows the row. Returns whether it changed.
  private fn mut measure() Bool {
    match self.header.current {
      header => {
        let width = header.layout().local.width
        let message = self.props.message
        let summary = pluginmessage::Summary(strings::TrimSpace(message.text))
        let overflows = width > 0 and display_width("◆ {message.plugin_id} · {summary}") > width
        let changed = overflows != self.overflows
        self.overflows = overflows
        changed
      },
      _ => false,
    }
  }
}

private fn display_width(value: Str) Int {
  mut width = 0
  for character in vaxis::Characters(value) {
    width =+ character.Width
  }
  width
}

impl cui::Component for PluginRow {
  fn mut render() cui::View {
    let themes = self.props.themes
    let plugins = self.props.plugins
    let message = self.props.message
    let colors = themes.current()
    let turn_id = message.turn_id
    let text = strings::TrimSpace(message.text)
    let foldable = strings::Contains(text, "\n") or self.overflows
    let expanded = foldable and plugins.expanded.get(turn_id).or(false)
    let identity = ui::text_style(foreground: colors.accent_text)
    let muted = ui::text_style(foreground: colors.muted)
    let fixed = fn(value: Str, style: ui::TextStyle) cui::View {
      cui::text(
        value,
        styles: ui::style(flex_shrink: 0.0),
        text_style: style,
        wrap: ui::TextWrap::none,
      )
    }
    let toggle = plugins.toggle
    let row = mut List::new<cui::View>()
    row.push(fixed("◆ ", identity))
    row.push(fixed(message.plugin_id, identity))
    row.push(fixed(" · ", muted))
    row.push(
      cui::text(
        pluginmessage::Summary(text),
        styles: ui::style(flex_shrink: 1.0, min_width: ui::cells(0)),
        text_style: muted,
        wrap: ui::TextWrap::none,
        overflow: ui::TextOverflow::ellipsis,
      ),
    )
    if foldable {
      row.push(
        fixed(
          match expanded {
            true => " ▾",
            false => " ▸",
          },
          muted,
        ),
      )
    }
    let header = cui::box(
      row.@,
      ref: self.header,
      styles: ui::style(
        height: ui::cells(1),
        flex_direction: ui::FlexDirection::row,
        flex_shrink: 0.0,
      ),
      on_mouse: fn(received: mut cooper::MouseEvent, ctx: cui::Context) {
        if foldable and received.event_type == cooper::MouseEventType::up and received.button == cooper::MouseButton::left {
          toggle(turn_id)
          received.prevent_default()
        }
      },
    )
    match expanded {
      false => header,
      true => {
        cui::box(
          [
            header,
            cui::box(
              [
                // The rule spans the message without adding to its height.
                cui::text(
                  strings::Repeat("│\n", 1023) + "│",
                  styles: ui::style(
                    position: ui::Position::absolute,
                    top: ui::cells(0),
                    bottom: ui::cells(0),
                    left: ui::cells(0),
                    width: ui::cells(1),
                    overflow: ui::Overflow::hidden,
                  ),
                  text_style: ui::text_style(foreground: colors.border),
                  wrap: ui::TextWrap::none,
                ),
                cui::box(
                  [markdown::view(themes, "transcript-plugin:{turn_id}", text, base: muted)],
                  styles: ui::style(
                    flex_direction: ui::FlexDirection::column,
                    padding: ui::Edges{
                      top: ui::cells(0),
                      right: ui::cells(0),
                      bottom: ui::cells(0),
                      left: ui::cells(2),
                    },
                  ),
                ),
              ],
              styles: ui::style(
                position: ui::Position::relative,
                flex_direction: ui::FlexDirection::column,
                flex_shrink: 0.0,
                overflow: ui::Overflow::hidden,
                margin: ui::Edges{
                  top: ui::cells(0),
                  right: ui::cells(0),
                  bottom: ui::cells(0),
                  left: ui::cells(2),
                },
              ),
            ),
          ],
          styles: ui::style(flex_direction: ui::FlexDirection::column, flex_shrink: 0.0),
        )
      },
    }
  }
}

private struct Outcome {
  glyph: Str,
  color: ui::Color,
}

// A finished command's glyph: ✓ for exit code zero, ⊘ when it was stopped,
// and ✗ for any other result.
private fn bash_outcome(colors: theme::Theme, run: sessionbridge::Bash) Outcome {
  match {
    run.Status == "aborted" or run.Status == "interrupted" => Outcome{glyph: "⊘", color: colors.muted},
    run.Succeeded() => Outcome{glyph: "✓", color: colors.success_text},
    _ => Outcome{glyph: "✗", color: colors.danger_text},
  }
}

private fn tool_entry(colors: theme::Theme, message: transcript::Message) cui::View {
  let state = match message.tool_state {
    transcript::ToolState::planned => "planned",
    transcript::ToolState::running => "running…",
    transcript::ToolState::completed => "done",
    transcript::ToolState::failed => "failed",
    transcript::ToolState::not_run => "not run",
    transcript::ToolState::none => "",
  }
  let tone = match message.tool_state == transcript::ToolState::failed {
    true => colors.danger_text,
    false => colors.muted,
  }
  layout::line("• {message.tool_name} {state}", ui::text_style(foreground: tone))
}
